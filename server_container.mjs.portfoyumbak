        severity: 4,
        frequency: Number(row.score_value || 4),
        timeImpact: 4,
        costImpact: 4,
        customerImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "TECH-015") {
      const techRules = [
        ["WhatsApp", "WhatsApp Dependency", ["whatsapp_dependency", "communication_breakdown", "data_silo"]],
        ["Phone", "Phone Dependency", ["phone_dependency", "manual_process", "missing_data"]],
        ["Email", "Email Dependency", ["email_dependency", "communication_breakdown", "data_silo"]],
        ["Paper form", "Paper-Based Process", ["paper_based_process", "manual_process", "missing_data"]],
        ["Spreadsheet", "Spreadsheet Dependency", ["spreadsheet_dependency", "duplicate_activity", "reporting_gap"]]
      ];
      for (const [option, title, problemTypes] of techRules) {
        if (answers.includes(option) || answers.some((answer) => String(answer).includes(option))) {
          pushFinding(row, {
            title,
            description: `${option} is used during field service coordination or reporting, creating traceability and rework risk.`,
            problemTypes,
            triggerRule: `TECH-015:selected:${option}`,
            severity: 4,
            frequency: 4,
            timeImpact: 4,
            customerImpact: 3,
            riskImpact: 3,
            employeeImpact: 4,
            automationPotential: 5
          });
        }
      }
    }

    if (row.question_id === "TECH-016" && Number(row.score_value ?? 0) >= 4) {
      pushFinding(row, {
        title: "Communication Handoff Breakdown",
        description: "Communication problems frequently delay or complicate field service work.",
        problemTypes: ["communication_breakdown", "missing_data", "waiting_time"],
        triggerRule: `TECH-016:communication_delay:${row.answer_text}`,
        severity: 4,
        frequency: Number(row.score_value || 4),
        timeImpact: 4,
        customerImpact: 4,
        employeeImpact: 5,
        automationPotential: 4
      });
    }

    if (row.question_id === "TECH-018" && Number(row.score_value ?? 0) >= 4) {
      pushFinding(row, {
        title: "Manual Service Documentation",
        description: "Technicians spend substantial time documenting completed service work.",
        problemTypes: ["manual_reporting", "paper_based_process", "duplicate_data"],
        triggerRule: `TECH-018:documentation_time:${row.answer_text}`,
        severity: 4,
        frequency: 4,
        timeImpact: 4,
        costImpact: 3,
        employeeImpact: 4,
        automationPotential: 5
      });
    }

    if (row.question_id === "TECH-019" && answers.length && !answers.includes("Nowhere")) {
      pushFinding(row, {
        title: "Duplicate Data Entry",
        description: `Technicians enter the same service information more than once: ${answers.join(", ")}.`,
        problemTypes: ["duplicate_data", "duplicate_activity", "manual_reporting", "missing_integration"],
        triggerRule: "TECH-019:duplicate_entry_points",
        severity: 4,
        frequency: 4,
        timeImpact: 4,
        costImpact: 3,
        employeeImpact: 4,
        automationPotential: 5
      });
    }

    if (row.question_id === "BR-005" && Number(row.score_value ?? 0) <= 2) {
      pushFinding(row, {
        title: "Branch Standardization Gap",
        description: "Operational processes are not consistently followed across branches.",
        problemTypes: ["lack_of_standardization", "process_complexity", "rework"],
        triggerRule: `BR-005:standardization_score:${row.answer_text}`,
        severity: 4,
        frequency: 4,
        timeImpact: 4,
        customerImpact: 4,
        riskImpact: 3,
        employeeImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "BR-007" && answers.length && !answers.includes("No team is overloaded")) {
      pushFinding(row, {
        title: "Branch Workload Imbalance",
        description: `Branch workload pressure is concentrated in: ${answers.join(", ")}.`,
        problemTypes: ["workload_imbalance", "resource_shortage", "capacity_constraint", "manual_process"],
        triggerRule: "BR-007:overloaded_teams_selected",
        severity: 4,
        frequency: 4,
        timeImpact: 4,
        customerImpact: 3,
        employeeImpact: 5,
        automationPotential: 4
      });
    }

    if (row.question_id === "BR-010" && Number(row.score_value ?? 0) >= 4) {
      pushFinding(row, {
        title: "Branch-Level Service Delays",
        description: "Service jobs frequently experience delays at branch level.",
        problemTypes: ["service_delay", "bottleneck", "capacity_constraint"],
        triggerRule: `BR-010:branch_delay:${row.answer_text}`,
        severity: 4,
        frequency: Number(row.score_value || 4),
        timeImpact: 5,
        customerImpact: 5,
        employeeImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "BR-014" && Number(row.score_value ?? 0) >= 4) {
      pushFinding(row, {
        title: "Inventory Availability Problem",
        description: "Required inventory is frequently unavailable when branch teams need it.",
        problemTypes: ["inventory_availability_problem", "stockout", "missing_data", "data_silo"],
        triggerRule: `BR-014:inventory_unavailable:${row.answer_text}`,
        severity: 4,
        frequency: Number(row.score_value || 4),
        timeImpact: 4,
        costImpact: 4,
        customerImpact: 5,
        revenueImpact: 3,
        riskImpact: 3,
        automationPotential: 4
