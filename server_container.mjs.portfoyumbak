// ── TCMB Politika Faizi ─────────────────────────────────────────────────
// GET /api/tcmb/policy-rate — returns stored rate; triggers background refresh if stale
if (request.method === 'GET' && url.pathname === '/api/tcmb/policy-rate') {
  try {
    const _sess = await requireModuleAccess(request, 'intelligence');
    const _rr = (await query(
      'SELECT tcmb_politika_faiz_pct, gecerli_tarih FROM bi_ekonomik_parametreler WHERE tenant_id = $1::uuid ORDER BY gecerli_tarih DESC LIMIT 1',
      [_sess.tenantId]
    )).rows;
    const _stored = _rr[0] || {};
    const _rate   = parseFloat(_stored.tcmb_politika_faiz_pct) || 46.0;
    const _date   = _stored.gecerli_tarih;
    // Background refresh if stale (older than 24 h)
    const _stale  = !_date || (Date.now() - new Date(_date).getTime()) > 24 * 3600 * 1000;
    if (_stale) {
      fetchTcmbPolicyRate().then(async function(_live) {
        if (_live) {
          await query(
            'UPDATE bi_ekonomik_parametreler SET tcmb_politika_faiz_pct = $1 WHERE tenant_id = $2::uuid AND gecerli_tarih = (SELECT MAX(gecerli_tarih) FROM bi_ekonomik_parametreler WHERE tenant_id = $2::uuid)',
            [_live, _sess.tenantId]
          ).catch(() => {});
          console.log('[TCMB-RATE] auto-updated to', _live);
        }
      }).catch(() => {});
    }
    sendJson(response, 200, { rate: _rate, gecerli_tarih: _date || null, source: 'db', stale: _stale });
  } catch(e) {
    if (!response.headersSent) sendJson(response, 200, { rate: 46.0, source: 'error', error: e.message });
  }
  return;
}
// PUT /api/tcmb/policy-rate — manual override
if (request.method === 'PUT' && url.pathname === '/api/tcmb/policy-rate') {
  try {
    const _sess2 = await requireModuleAccess(request, 'intelligence');
    const _b2    = await readBody(request);
    const _nr    = parseFloat(_b2.rate);
    if (isNaN(_nr) || _nr <= 0 || _nr > 200) { sendJson(response, 400, { error: 'rate must be 0-200' }); return; }
    await query(
      'UPDATE bi_ekonomik_parametreler SET tcmb_politika_faiz_pct = $1 WHERE tenant_id = $2::uuid AND gecerli_tarih = (SELECT MAX(gecerli_tarih) FROM bi_ekonomik_parametreler WHERE tenant_id = $2::uuid)',
      [_nr, _sess2.tenantId]
    );
    sendJson(response, 200, { ok: true, rate: _nr });
  } catch(e) {
    if (!response.headersSent) sendJson(response, 500, { error: e.message });
  }
  return;
}
if (request.method === 'GET' && url.pathname === '/api/bi/brand-alerts') {
  try {
    const session   = await requireModuleAccess(request, "intelligence");
    const ref       = (url.searchParams.get('ref') || 'LASSA').trim().toUpperCase();
    const months    = Math.min(Math.max(parseInt(url.searchParams.get('months') || '12'), 1), 60);
    const threshold = Math.min(Math.max(parseInt(url.searchParams.get('threshold') || '10'), 2), 80);
    const result = await query(`
      WITH last_purchase AS (
        SELECT DISTINCT ON (kalem_kodu)
          kalem_kodu, birim_maliyet AS cost
        FROM bi_stok_hareketleri
        WHERE tenant_id = $1::uuid AND giris_miktari > 0 AND birim_maliyet > 0
        ORDER BY kalem_kodu, belge_tarihi DESC
      ),
      sold_cost AS (
        SELECT s.marka, s.ebat, lp.cost, s.miktar
        FROM bi_satis_faturalari s
        JOIN last_purchase lp ON lp.kalem_kodu = s.kalem_kodu
        WHERE s.tenant_id = $1::text
          AND s.grup_adi LIKE 'LASTIK%'   -- LASTIK_FILTRE_V1
          AND s.fatura_tarihi >= CURRENT_DATE - ($2 * INTERVAL '1 month')
          AND s.miktar > 0 AND lp.cost > 0
      ),
      ebat_brand AS (
        SELECT marka, ebat,
          SUM(miktar * cost) / NULLIF(SUM(miktar),0) AS wavg_cost,
          SUM(miktar)::int AS units
        FROM sold_cost
        GROUP BY marka, ebat
        HAVING SUM(miktar) >= 3
      ),
      ref_per_ebat AS (
        SELECT ebat, wavg_cost AS ref_cost FROM ebat_brand WHERE marka = $3
      ),
      brand_global AS (
        SELECT marka,
          SUM(units * wavg_cost) / NULLIF(SUM(units),0) AS global_avg_cost
        FROM ebat_brand
        GROUP BY marka HAVING SUM(units) >= 5
      )
      SELECT eb.marka, eb.ebat, eb.units,
        ROUND(eb.wavg_cost::numeric, 0) AS brand_cost,
        ROUND(rpe.ref_cost::numeric, 0) AS ref_cost,
        ROUND((eb.wavg_cost / rpe.ref_cost * 100)::numeric, 1) AS size_index,
        ROUND((bg.global_avg_cost / rg.global_avg_cost * 100)::numeric, 1) AS global_index,
        ROUND(((eb.wavg_cost / rpe.ref_cost * 100) - (bg.global_avg_cost / rg.global_avg_cost * 100))::numeric, 1) AS deviation
      FROM ebat_brand eb
      JOIN ref_per_ebat rpe ON rpe.ebat = eb.ebat
      JOIN brand_global bg ON bg.marka = eb.marka
      CROSS JOIN (SELECT global_avg_cost FROM brand_global WHERE marka = $3) rg
      WHERE eb.marka != $3
        AND ABS((eb.wavg_cost / rpe.ref_cost * 100) - (bg.global_avg_cost / rg.global_avg_cost * 100)) >= $4
      ORDER BY ABS((eb.wavg_cost / rpe.ref_cost * 100) - (bg.global_avg_cost / rg.global_avg_cost * 100)) DESC
      LIMIT 150
    `, [session.tenantId, months, ref, threshold]);
    sendJson(response, 200, { alerts: result.rows, ref, threshold });
  } catch(err) { sendJson(response, err.statusCode || 500, { error: err.message }); }
  return;
}

if (request.method === 'GET' && url.pathname === '/api/bi/account-health') {
    const session = await requireModuleAccess(request, "intelligence");
    const months = Math.min(Math.max(parseInt(url.searchParams.get('months') || '12'), 1), 60);
    const tenantId = session.tenantId;
    const result = await query(`
      WITH cost_lkp AS (
        SELECT kalem_kodu, AVG(birim_maliyet) FILTER (WHERE birim_maliyet > 0) AS avg_cost
        FROM bi_stok_hareketleri
        GROUP BY kalem_kodu
      ),
      sn AS (
        SELECT
          s.musteri_kodu,
          MAX(s.musteri_adi) AS musteri_adi,
          SUM(s.satir_tutar) AS revenue,
          SUM(s.miktar * COALESCE(c.avg_cost, 0)) AS total_cost,
          SUM(s.satir_tutar - s.miktar * COALESCE(c.avg_cost, 0)) AS gross_profit,
          COUNT(DISTINCT s.fatura_no) AS inv_count,
          COUNT(DISTINCT DATE_TRUNC('month', s.fatura_tarihi)) AS active_months,
          COUNT(DISTINCT COALESCE(NULLIF(s.kategori,''), s.grup_adi)) AS breadth,
          SUM(s.satir_tutar) / NULLIF(COUNT(DISTINCT s.fatura_no), 0) AS aov
        FROM bi_satis_faturalari s
        LEFT JOIN cost_lkp c ON c.kalem_kodu = s.kalem_kodu
        WHERE s.tenant_id = $1::text
          AND s.kategori IN ('TBR', 'OTR')
          AND s.fatura_tarihi >= NOW() - ($2 * INTERVAL '1 month')
        GROUP BY s.musteri_kodu
        HAVING SUM(s.satir_tutar) > 0
      ),
      sp AS (
        SELECT musteri_kodu, SUM(satir_tutar) AS prev_rev
        FROM bi_satis_faturalari
        WHERE tenant_id = $1::text
          AND kategori IN ('TBR', 'OTR')
          AND fatura_tarihi >= NOW() - (($2 * 2) * INTERVAL '1 month')
          AND fatura_tarihi <  NOW() - ($2 * INTERVAL '1 month')
        GROUP BY musteri_kodu
      ),
      ly AS (
        SELECT musteri_kodu,
          EXTRACT(YEAR FROM age(NOW(), MIN(fatura_tarihi))) AS yrs
        FROM bi_satis_faturalari
        WHERE tenant_id = $1::text
          AND kategori IN ('TBR', 'OTR')
        GROUP BY musteri_kodu
      ),
      r AS (
        SELECT sn.*, sp.prev_rev, ly.yrs,
          PERCENT_RANK() OVER (ORDER BY CASE WHEN sn.revenue > 0 THEN sn.gross_profit / sn.revenue ELSE 0 END) * 100 AS gp_rnk,
          PERCENT_RANK() OVER (ORDER BY sn.revenue) * 100 AS rev_rnk,
          LEAST(sn.active_months::float / $2 * 100, 100) AS consist,
          CASE WHEN sp.prev_rev > 0 THEN (sn.revenue - sp.prev_rev) / sp.prev_rev * 100 ELSE 0 END AS growth,
          PERCENT_RANK() OVER (ORDER BY sn.aov) * 100 AS aov_rnk,
          PERCENT_RANK() OVER (ORDER BY sn.breadth) * 100 AS brd_rnk,
          LEAST(COALESCE(ly.yrs, 0) * 20, 100) AS loyal
        FROM sn
        LEFT JOIN sp ON sp.musteri_kodu = sn.musteri_kodu
        LEFT JOIN ly ON ly.musteri_kodu = sn.musteri_kodu
      )
      SELECT
        musteri_kodu,
        musteri_adi,
        ROUND(revenue::numeric, 0) AS revenue,
        CASE WHEN revenue > 0 THEN ROUND((gross_profit / revenue * 100)::numeric, 1) ELSE NULL END AS gp_pct,
        ROUND(consist::numeric, 1) AS consistency_pct,
        ROUND(growth::numeric, 1) AS growth_pct,
        ROUND(aov::numeric, 0) AS avg_order_value,
        breadth AS product_breadth,
        ROUND((
          gp_rnk  * 0.25 +
          rev_rnk * 0.15 +
          consist * 0.20 +
          LEAST(GREATEST(growth + 50, 0), 100) * 0.15 +
          aov_rnk * 0.10 +
          brd_rnk * 0.10 +
          loyal   * 0.05
        )::numeric, 1) AS score
      FROM r
      ORDER BY score DESC
      LIMIT 200
    `, [tenantId, months]);
    const GRADE = function(s) { return s>=90?'A+':s>=80?'A':s>=70?'B+':s>=60?'B':s>=50?'C+':s>=40?'C':'D'; };
    sendJson(response, 200, {
      customers: result.rows.map(function(r) {
        var sc = parseFloat(r.score) || 0;
        return Object.assign({}, r, { score: sc, grade: GRADE(sc) });
      })
    });
    return;
  }
    if (request.method === 'POST' && url.pathname === '/api/platform/feedback') {
  try {
    const session = await getSessionUser(request);
    if (!session) { sendJson(response, 401, { error: 'Authentication required.' }); return; }

    const { message } = await readJson(request);
    if (!message || !message.trim()) {
      sendJson(response, 400, { error: 'Mesaj boş olamaz.' });
      return;
    }

    // Ensure table exists (idempotent)
    await query(`
      CREATE TABLE IF NOT EXISTS platform_feedback (
        id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        user_id uuid NOT NULL,
        user_email text NOT NULL,
        user_name text,
        message text NOT NULL,
        created_at timestamptz NOT NULL DEFAULT now()
      )
    `);

    await query(
      `INSERT INTO platform_feedback (user_id, user_email, user_name, message)
       VALUES ($1, $2, $3, $4)`,
      [session.userId, session.email, session.name || '', message.trim()]
    );

    // Email notification to dev team
    try {
      await sendGraphMail({
        to: 'fatih@deriveglobal.com',
        subject: `[Derive Intelligence] Not: ${session.name || session.email}`,
        body: `
          <div style="font-family:sans-serif;max-width:520px;margin:0 auto;padding:20px">
            <h3 style="color:#1a1a2e;border-bottom:2px solid #667eea;padding-bottom:8px">
              📝 Platform Geri Bildirimi
            </h3>
            <p><b>Kullanıcı:</b> ${session.name || ''} (<a href="mailto:${session.email}">${session.email}</a>)</p>
            <p><b>Not / Talep:</b></p>
            <blockquote style="border-left:3px solid #667eea;padding:8px 14px;margin:8px 0;background:#f5f5ff;border-radius:0 6px 6px 0;color:#333;line-height:1.6">
              ${message.trim().replace(/\n/g, '<br>')}
            </blockquote>
            <p style="color:#888;font-size:11px;margin-top:16px">
              Gönderildi: ${new Date().toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' })}
            </p>
          </div>
        `
      });
    } catch (emailErr) {
      console.warn('Feedback email failed (message saved):', emailErr.message);
    }

    sendJson(response, 200, { ok: true });
    return;
  } catch (err) {
    console.error('POST /api/platform/feedback error:', err);
    sendJson(response, 500, { error: err.message });
    return;
  }
}

// GET /api/platform/feedback — platform_owner reads all feedback
if (request.method === 'GET' && url.pathname === '/api/platform/feedback') {
  try {
    const session = await requireAuth(request, ['platform_owner']);
    await query(`
      CREATE TABLE IF NOT EXISTS platform_feedback (
        id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        user_id uuid NOT NULL,
        user_email text NOT NULL,
        user_name text,
        message text NOT NULL,
        created_at timestamptz NOT NULL DEFAULT now()
      )
    `);
    const result = await query(
      'SELECT * FROM platform_feedback ORDER BY created_at DESC LIMIT 500'
    );
    sendJson(response, 200, { feedback: result.rows });
    return;
  } catch (err) {
    sendJson(response, err.statusCode || 500, { error: err.message });
    return;
  }
}

// GET /api/platform/me — full subscription context for logged-in user
if (request.method === "GET" && url.pathname === "/api/platform/me") {
  try {
    await ensurePlatformSchema();
    const session = await getSessionUser(request);
    if (!session) { sendJson(response, 401, { error: "Authentication required." }); return; }

    if (normalizeRole(session.role) === "platform_owner") {
      let _atName = null;
      if (session.tenantId) {
        const _t = await query("SELECT name, config_json FROM platform_tenants WHERE id=$1 AND status='active'", [session.tenantId]); /* TENANT_ALIAS_V1 */
        _atName = _t.rows[0] ? _t.rows[0].name : null;
        var _atCfg = _t.rows[0] ? _t.rows[0].config_json : null;
      }
      sendJson(response, 200, {
        userId: session.userId, name: session.name, email: session.email, globalRole: "platform_owner",
        tenantId: session.tenantId || null, tenantName: _atName, tenantAlias: ((_atCfg&&_atCfg.alias?String(_atCfg.alias).trim():"")||_atName), tenantRole: "platform_owner",
        activeTenantId: session.tenantId || null, activeTenantName: _atName,
        subscriptions: []
      });
      return;
    }

    const [tenantRow, subRows] = await Promise.all([
      query(`SELECT pt.id, pt.name, tu.tenant_role
             FROM tenant_users tu
             JOIN platform_tenants pt ON pt.id = tu.tenant_id AND pt.status = 'active'
             WHERE tu.user_id = $1 AND tu.active = true LIMIT 1`, [session.userId]),
      query(`SELECT ts.module_id, pm.name AS module_name, mp.plan_key AS plan,
                    ts.status AS sub_status, ts.trial_ends_at,
                    mp.features_json AS plan_features, ts.config_json AS sub_config,
                    pt.config_json AS tenant_config,
                    tum.module_role, tum.permissions_json
             FROM tenant_users tu
             JOIN platform_tenants pt     ON pt.id = tu.tenant_id AND pt.status = 'active'
             JOIN tenant_subscriptions ts ON ts.tenant_id = pt.id AND ts.status IN ('active','trial')
                                         AND (ts.current_period_end IS NULL OR ts.current_period_end > now())
             JOIN platform_modules pm     ON pm.id = ts.module_id AND pm.active = true
             JOIN module_plans mp         ON mp.id = ts.plan_id
             JOIN tenant_user_modules tum ON tum.tenant_id = pt.id AND tum.user_id = tu.user_id
                                         AND tum.module_id = ts.module_id AND tum.active = true
             WHERE tu.user_id = $1 AND tu.active = true`, [session.userId])
    ]);

    if (!tenantRow.rowCount) { sendJson(response, 200, { userId: session.userId, name: session.name, email: session.email, globalRole: session.role, tenantId: null, tenantName: null, tenantRole: null, subscriptions: [] }); return; }

    const tenant = tenantRow.rows[0];
    const subscriptions = subRows.rows.map(r => ({
      moduleId:    r.module_id,
      moduleName:  r.module_name,
      plan:        r.plan,
      subStatus:   r.sub_status,
      trialEndsAt: r.trial_ends_at,
      moduleRole:  r.module_role,
      features:    { ...r.plan_features, ...r.sub_config, ...r.tenant_config },
      permissions: r.permissions_json || {}
    }));

    sendJson(response, 200, {
      userId: session.userId, name: session.name, email: session.email, globalRole: session.role,
      tenantId: tenant.id, tenantName: tenant.name, tenantAlias: ((tenant.tenant_config&&tenant.tenant_config.alias?String(tenant.tenant_config.alias).trim():"")||tenant.name), tenantRole: tenant.tenant_role, /* TENANT_ALIAS_V1 */
      subscriptions
    });
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
  }
  return;
}

if (request.method === "POST" && url.pathname === "/api/platform/enter-tenant") {
  const session = await requirePlatformOwner(request, response);
  if (!session) return;
  try {
    const _b = await readJson(request);
    const _tid = _b && _b.tenantId;
    if (!_tid) { sendJson(response, 400, { error: "tenantId gerekli" }); return; }
    const _t = await query("SELECT id, name FROM platform_tenants WHERE id=$1 AND status='active'", [_tid]);
    if (!_t.rowCount) { sendJson(response, 404, { error: "Tenant bulunamadi." }); return; }
    await query("UPDATE user_sessions SET metadata = jsonb_set(COALESCE(metadata,'{}'::jsonb), '{active_tenant_id}', to_jsonb($1::text)) WHERE id=$2", [_tid, session.sessionId]);
    try { await query("INSERT INTO krb_audit_logs (actor_user_id, actor_email, action, entity_type, entity_id) VALUES ($1,$2,'enter_tenant','tenant',$3)", [session.userId, session.email, _tid]); } catch (e) {}
    sendJson(response, 200, { ok: true, tenant: { id: _t.rows[0].id, name: _t.rows[0].name } });
  } catch (e) { sendJson(response, 500, { error: String((e && e.message) || e) }); }
  return;
}
if (request.method === "POST" && url.pathname === "/api/platform/exit-tenant") {
  const session = await requirePlatformOwner(request, response);
  if (!session) return;
  try {
    await query("UPDATE user_sessions SET metadata = (COALESCE(metadata,'{}'::jsonb) - 'active_tenant_id') WHERE id=$1", [session.sessionId]);
    try { await query("INSERT INTO krb_audit_logs (actor_user_id, actor_email, action, entity_type) VALUES ($1,$2,'exit_tenant','tenant')", [session.userId, session.email]); } catch (e) {}
    sendJson(response, 200, { ok: true });
  } catch (e) { sendJson(response, 500, { error: String((e && e.message) || e) }); }
  return;
}
// GET /api/platform/tenants (platform_owner only)
if (request.method === "GET" && url.pathname === "/api/platform/tenants") {
  try {
    await requireAuth(request, ["platform_owner"]);
    await ensurePlatformSchema();
    const result = await query(`
      SELECT pt.*,
             COUNT(DISTINCT tu.user_id) FILTER (WHERE tu.active) AS user_count,
             COUNT(DISTINCT ts.module_id) FILTER (WHERE ts.status IN ('active','trial')) AS module_count
      FROM platform_tenants pt
      LEFT JOIN tenant_users tu ON tu.tenant_id = pt.id
      LEFT JOIN tenant_subscriptions ts ON ts.tenant_id = pt.id
      GROUP BY pt.id ORDER BY pt.created_at DESC`);
    sendJson(response, 200, result.rows);
  } catch (error) { sendJson(response, error.statusCode || 500, { error: error.message }); }
  return;
}

// POST /api/platform/tenants (platform_owner only)
if (request.method === "POST" && url.pathname === "/api/platform/tenants") {
  try {
    const session = await requireAuth(request, ["platform_owner"]);
    await ensurePlatformSchema();
    const { name, slug, timezone, currency, config_json } = await readJson(request);
    if (!name || !slug) throw Object.assign(new Error("name and slug are required."), { statusCode: 400 });
    const result = await query(
      `INSERT INTO platform_tenants (name, slug, timezone, currency, config_json, created_by)
       VALUES ($1, $2, $3, $4, $5, $6) RETURNING *`,
      [name, slug.toLowerCase(), timezone || "Europe/Istanbul", currency || "TRY",
       config_json || {}, session.userId]
    );
    sendJson(response, 201, result.rows[0]);
  } catch (error) { sendJson(response, error.statusCode || 500, { error: error.message }); }
  return;
}

// POST /api/platform/tenants/:id/subscriptions (platform_owner only)
const tenantSubMatch = url.pathname.match(/^\/api\/platform\/tenants\/([^/]+)\/subscriptions$/);
if (request.method === "POST" && tenantSubMatch) {
  try {
    const session = await requireAuth(request, ["platform_owner"]);
    await ensurePlatformSchema();
    const tenantId = tenantSubMatch[1];
    const { module_id, plan_id, status, current_period_end } = await readJson(request);
    const result = await query(
      `INSERT INTO tenant_subscriptions (tenant_id, module_id, plan_id, status, current_period_end, created_by)
       VALUES ($1, $2, $3, $4, $5, $6)
       ON CONFLICT (tenant_id, module_id) DO UPDATE
         SET plan_id = EXCLUDED.plan_id, status = EXCLUDED.status,
             current_period_end = EXCLUDED.current_period_end
       RETURNING *`,
      [tenantId, module_id, plan_id, status || "active",
       current_period_end || null, session.userId]
    );
    sendJson(response, 201, result.rows[0]);
  } catch (error) { sendJson(response, error.statusCode || 500, { error: error.message }); }
  return;
}

// GET /api/platform/plans (platform_owner only)
if (request.method === "GET" && url.pathname === "/api/platform/plans") {
  try {
    await requireAuth(request, ["platform_owner"]);
