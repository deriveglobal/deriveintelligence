        baz_iskonto1=$6, baz_iskonto2=$7, ds=$8, skala_primi=$9,
        notlar=$10
      WHERE id=$11::uuid AND tenant_id=$12::uuid
    `, [d.sezon, d.arac_tipi,
        d.rim_alt || null, d.rim_ust || null, d.desen_filtre || null,
        d.baz_iskonto1 || 0, d.baz_iskonto2 || 0, d.ds || 0, d.skala_primi || 0,
        d.notlar || null,
        id, session.tenantId]);
