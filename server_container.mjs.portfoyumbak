  }

  if (respondMatch && request.method === "POST" && respondMatch[2] === "submit") {
    try {
      const payload = await readJson(request);
      sendJson(response, 200, await saveRespondentResponses(decodeURIComponent(respondMatch[1]), payload.answers || [], true));
    } catch (error) {
      sendJson(response, error.statusCode || 500, error.payload || { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/executive-report") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "auditor", "owner", "viewer"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      const canIncludeDrafts = ["platform_owner", "consultant"].includes(normalizeRole(session.role));
      const includeDrafts = canIncludeDrafts && url.searchParams.get("includeDrafts") === "true";
      await requireProjectAccess(session, projectId, ["consultant", "auditor", "owner", "viewer"]);
      sendJson(response, 200, await generateExecutiveReport(projectId, { includeDrafts }));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/reports/executive-summary") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "owner"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "owner"]);
      const reportData = await fetchReportData(projectId);
      const pdfBuffer = await generateExecutiveSummaryPDF(reportData);
      const dateSlug = new Date().toISOString().slice(0, 10);
      response.writeHead(200, {
        "Content-Type": "application/pdf",
        "Content-Disposition": `attachment; filename="${safePdfFilename(reportData.organization.name)}-Executive-Summary-${dateSlug}.pdf"`,
        "Content-Length": pdfBuffer.length
      });
      response.end(pdfBuffer);
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/reports/full-report") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "owner"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "owner"]);
      const reportData = await fetchReportData(projectId);
      const pdfBuffer = await generateFullReportPDF(reportData);
      const dateSlug = new Date().toISOString().slice(0, 10);
      response.writeHead(200, {
        "Content-Type": "application/pdf",
        "Content-Disposition": `attachment; filename="${safePdfFilename(reportData.organization.name)}-Intelligence-Report-${dateSlug}.pdf"`,
        "Content-Length": pdfBuffer.length
      });
      response.end(pdfBuffer);
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "POST" && url.pathname === "/api/progress-snapshot") {
    try {
      const session = await requireAuth(request, ["creator", "consultant"]);
      const payload = await readJson(request);
      const projectId = payload.projectId || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant"]);
      const client = await requireDatabase().connect();
      try {
        const assessment = payload.assessmentId ? { id: payload.assessmentId } : await getOrCreateAssessment(client, projectId);
        sendJson(response, 201, {
          progressMemory: await generateCompanyProgressSnapshot(projectId, assessment.id, { regenerate: Boolean(payload.regenerate) })
        });
      } finally {
        client.release();
      }
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/progress-history") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "auditor", "owner", "manager", "viewer"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "auditor", "owner", "manager", "viewer"]);
      const client = await requireDatabase().connect();
      try {
        await ensureAssessmentEngineSchema(client);
        sendJson(response, 200, { progressMemory: await getCompanyProgressMemory(client, projectId) });
      } finally {
        client.release();
      }
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/progress-intelligence") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "owner"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "owner"]);
      const assessmentResult = await query(
        `select a.*
         from assessments a
         where a.company_id = $1
         order by a.created_at desc
         limit 1`,
        [projectId]
      );
      const assessment = assessmentResult.rows[0] || null;
      const snapshots = await query(
        `select *
         from company_progress_snapshots
         where company_id = $1
         order by snapshot_date asc`,
        [projectId]
      );
      const findingHistory = await query(
        `select *
         from finding_history
         where company_id = $1
         order by snapshot_date asc`,
        [projectId]
      );
      const progressInsights = await query(
        `select *
         from progress_insights
         where company_id = $1
         order by created_at asc`,
        [projectId]
      );
      const currentFindings = assessment
        ? await query(
          `select id, title, description, business_domain, severity,
             confidence, status
           from findings
           where assessment_id = $1
             and status = 'Approved'
           order by severity desc nulls last, priority_score desc nulls last`,
          [assessment.id]
        )
        : { rows: [] };
      const profile = await query(
        `select company_name, industry, employee_range
         from company_profiles
         where assessment_project_id = $1
         limit 1`,
        [projectId]
      );
      const project = await query(
        `select id, name, client_display_name, industry_context
         from assessment_projects
         where id = $1
         limit 1`,
        [projectId]
      );
      const profileRow = profile.rows[0] || {};
      const projectRow = project.rows[0] || {};
      sendJson(response, 200, {
        snapshots: snapshots.rows,
        findingHistory: findingHistory.rows,
        progressInsights: progressInsights.rows,
        currentFindings: currentFindings.rows,
        organization: {
          name: profileRow.company_name || projectRow.client_display_name || projectRow.name || "Organization",
          industry: profileRow.industry || projectRow.industry_context || "",
          employeeRange: profileRow.employee_range || ""
        }
      });
