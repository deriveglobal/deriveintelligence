async function getOrCreateDefaultOrganization(client) {
  const existing = await client.query("select id from organizations where name = $1 order by created_at asc limit 1", [defaultOrganizationName]);
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    "insert into organizations (name, industry, default_language) values ($1, $2, $3) returning id",
    [defaultOrganizationName, "Digital Transformation", "tr"]
  );
  return inserted.rows[0].id;
}

async function getOrCreateDefaultMethodologyVersion(client) {
  const existing = await client.query(
    `select mv.id
     from methodology_versions mv
     join methodology_templates mt on mt.id = mv.methodology_template_id
     where mt.name = $1 and mv.status = 'published'
     order by mv.published_at desc nulls last, mv.created_at desc
     limit 1`,
    [defaultMethodologyName]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const template = await client.query(
    "insert into methodology_templates (name, description, is_global, status) values ($1, $2, true, 'active') returning id",
    [defaultMethodologyName, "Reusable methodology for digital transformation discovery."]
  );
  const version = await client.query(
    "insert into methodology_versions (methodology_template_id, version_label, status, published_at) values ($1, 'v1', 'published', now()) returning id",
    [template.rows[0].id]
  );
  return version.rows[0].id;
}

async function getOrCreateDefaultProject(client, organizationId, methodologyVersionId) {
  const existing = await client.query(
    "select id from assessment_projects where organization_id = $1 and name = $2 order by created_at asc limit 1",
    [organizationId, defaultProjectName]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    `insert into assessment_projects
      (organization_id, methodology_version_id, name, client_display_name, industry_context, default_language, status)
     values ($1, $2, $3, $4, $5, 'tr', 'active')
     returning id`,
    [organizationId, methodologyVersionId, defaultProjectName, defaultOrganizationName, "Reusable first project configuration."]
  );
  return inserted.rows[0].id;
}

async function getProjectContext(client, projectId) {
  if (!projectId) return null;
  const result = await client.query(
    `select ap.id as project_id, ap.organization_id, ap.methodology_version_id
     from assessment_projects ap
     where ap.id = $1
     limit 1`,
    [projectId]
  );
  if (!result.rowCount) return null;
  return {
    projectId: result.rows[0].project_id,
    organizationId: result.rows[0].organization_id,
    methodologyVersionId: result.rows[0].methodology_version_id
  };
}

async function getOrCreateDepartment(client, organizationId, projectId, name) {
  const departmentName = name || "General";
  const existing = await client.query(
    "select id from departments where organization_id = $1 and assessment_project_id = $2 and name = $3 limit 1",
    [organizationId, projectId, departmentName]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    "insert into departments (organization_id, assessment_project_id, name) values ($1, $2, $3) returning id",
    [organizationId, projectId, departmentName]
  );
  return inserted.rows[0].id;
}

async function getOrCreateSurveyTemplate(client, methodologyVersionId, code, name, language = "en") {
  const templateCode = code || "general";
  const existing = await client.query(
    "select id from survey_templates where methodology_version_id = $1 and code = $2 limit 1",
    [methodologyVersionId, templateCode]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    `insert into survey_templates
      (methodology_version_id, code, name, description, default_language, status)
     values ($1, $2, $3, $4, $5, 'active')
     returning id`,
    [methodologyVersionId, templateCode, name || templateCode, "Imported from active application template.", language]
  );
  return inserted.rows[0].id;
}

async function getOrCreateQuestionTemplate(client, methodologyVersionId, surveyTemplateId, code, questionText, sortOrder) {
  const existing = await client.query(
    "select id from question_templates where survey_template_id = $1 and code = $2 limit 1",
    [surveyTemplateId, code]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    `insert into question_templates
      (methodology_version_id, survey_template_id, code, question_type, required, scoring_eligible, weight, ai_intent, kpi_extractable, sort_order)
     values ($1, $2, $3, 'open_text', true, true, 1, $4, true, $5)
     returning id`,
    [methodologyVersionId, surveyTemplateId, code, "Capture transformation evidence and classify it into the analysis knowledge map.", sortOrder]
  );

  await client.query(
    `insert into question_translations (question_template_id, language_code, question_text)
     values ($1, 'en', $2)
     on conflict (question_template_id, language_code) do nothing`,
    [inserted.rows[0].id, questionText || code]
  );
  return inserted.rows[0].id;
}

async function getDefaultContext({ projectId, templateId = "general", templateName = "General Survey", language = "en", department = "General" } = {}) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const existingProjectContext = await getProjectContext(client, projectId);
    const organizationId = existingProjectContext?.organizationId || await getOrCreateDefaultOrganization(client);
    const methodologyVersionId = existingProjectContext?.methodologyVersionId || await getOrCreateDefaultMethodologyVersion(client);
    const resolvedProjectId = existingProjectContext?.projectId || await getOrCreateDefaultProject(client, organizationId, methodologyVersionId);
    const departmentId = await getOrCreateDepartment(client, organizationId, resolvedProjectId, department);
    const surveyTemplateId = await getOrCreateSurveyTemplate(client, methodologyVersionId, templateId, templateName, language);
    await client.query("commit");
    return { organizationId, methodologyVersionId, projectId: resolvedProjectId, departmentId, surveyTemplateId };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

function mapProject(row) {
  return {
    id: row.id,
    organizationId: row.organization_id,
    organizationName: row.organization_name,
    classification: row.classification || row.project_classification || row.organization_classification || "production",
    organizationClassification: row.organization_classification || "production",
    projectClassification: row.project_classification || row.classification || "production",
    name: row.name,
    clientDisplayName: row.client_display_name,
    industryContext: row.industry_context,
    defaultLanguage: row.default_language,
    status: row.status,
    createdAt: row.created_at,
    responseCount: Number(row.response_count || 0),
    assignmentCount: Number(row.assignment_count || 0)
  };
}

async function listProjects(session = null) {
  await ensureAccessControlSchema();
  const params = [];
  const membershipJoin = session && normalizeRole(session.role) !== "platform_owner"
    ? `where exists (
         select 1 from project_memberships pm
         where pm.assessment_project_id = ap.id and pm.user_id = $1 and pm.status = 'active'
       )
       or exists (
         select 1 from company_user_assignments cua
         where cua.company_id = ap.id and cua.user_id = $1 and cua.is_active = true
       )
       or exists (
         select 1 from consultant_company_assignments cca
         where cca.company_id = ap.id and cca.consultant_user_id = $1 and cca.is_active = true
       )`
    : "";
  if (membershipJoin) params.push(session.userId);
  const result = await query(
    `select
       ap.*,
       o.name as organization_name,
       coalesce(o.classification, 'production') as organization_classification,
       coalesce(ap.classification, o.classification, 'production') as classification,
       count(distinct srs.id) as response_count,
       count(distinct sa.id) as assignment_count
     from assessment_projects ap
     join organizations o on o.id = ap.organization_id
     left join survey_response_sessions srs on srs.assessment_project_id = ap.id
     left join survey_assignments sa on sa.assessment_project_id = ap.id
     ${membershipJoin}
     group by ap.id, o.name, o.classification
     order by ap.created_at desc`,
    params
  );
  const role = normalizeRole(session?.role);
  let rows = result.rows;
  if (role === "consultant") {
    rows = rows.filter((row) => !["qa", "internal"].includes(row.classification || "production"));
  } else if (role && role !== "platform_owner") {
    rows = rows.filter((row) => (row.classification || "production") === "production");
  }
  if (!result.rowCount && (!session || normalizeRole(session.role) === "platform_owner")) {
    const context = await getDefaultContext({
      templateId: "operations-manager",
      templateName: "Operations Manager",
      language: "tr",
      department: "General"
    });
    const fallback = await query(
      `select
         ap.*,
         o.name as organization_name,
         coalesce(o.classification, 'production') as organization_classification,
         coalesce(ap.classification, o.classification, 'production') as classification,
         0 as response_count,
         0 as assignment_count
       from assessment_projects ap
       join organizations o on o.id = ap.organization_id
       where ap.id = $1`,
      [context.projectId]
    );
    return fallback.rows.map(mapProject);
  }
  return rows.map(mapProject);
}

function consultantLifecycleStatus(row = {}) {
  if (!row.assessment_id || !row.blueprint_id) return "Setup";
  if (Number(row.participants_total || 0) === 0 || Number(row.completed_sessions || 0) === 0) return "Collecting";
  if (Number(row.draft_findings || 0) > 0 || Number(row.draft_recommendations || 0) > 0 || Number(row.proposed_recommendations || 0) > 0) return "Review";
  if (Number(row.approved_findings || 0) > 0 && Number(row.approved_recommendations || 0) > 0) return "Executive Ready";
  return "Review";
}

function consultantAttentionItems(row = {}) {
  const items = [];
  const projectId = row.project_id;
  const assessmentId = row.assessment_id;
  if (!row.blueprint_id) {
    items.push({ type: "setup", label: "Blueprint missing", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.participants_total || 0) === 0) {
    items.push({ type: "missing_participants", label: "Missing participants", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.overdue_participants || 0) > 0) {
    items.push({ type: "overdue_participants", label: `${row.overdue_participants} overdue participant${Number(row.overdue_participants) === 1 ? "" : "s"}`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.completed_sessions || 0) > 0 && Number(row.findings_total || 0) === 0) {
    items.push({ type: "analysis_ready", label: "Analysis ready", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.draft_findings || 0) > 0) {
    items.push({ type: "findings_approval", label: `${row.draft_findings} finding${Number(row.draft_findings) === 1 ? "" : "s"} awaiting approval`, severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "findings" });
  }
  const recommendationReviewCount = Number(row.draft_recommendations || 0) + Number(row.proposed_recommendations || 0);
  if (recommendationReviewCount > 0) {
    items.push({ type: "recommendation_approval", label: `${recommendationReviewCount} recommendation${recommendationReviewCount === 1 ? "" : "s"} awaiting approval`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "opportunities" });
  }
  if (Number(row.report_ready || 0) > 0) {
    items.push({ type: "report_ready", label: "Executive report ready", severity: "low", project_id: projectId, assessment_id: assessmentId, action_view: "executive-report" });
  }
  if (Number(row.open_issues || 0) > 0) {
    items.push({ type: "open_issues", label: `${row.open_issues} open issue${Number(row.open_issues) === 1 ? "" : "s"}`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  return items;
}

async function getConsultantCommandCenter(session) {
  await ensureAccessControlSchema();
  const projects = await listProjects(session);
  if (!projects.length) {
    return {
      generated_at: new Date().toISOString(),
      assigned_organizations: [],
      needs_attention: [],
      my_queue: [],
      lifecycle_pipeline: {
        setup: 0,
        collection: 0,
        review: 0,
        recommendations: 0,
        executive_output: 0
      },
      reports_ready: [],
      open_issues: [],
      next_best_action: null
    };
  }
  const projectIds = projects.map((project) => project.id);
  const result = await query(
    `with latest_assessments as (
       select distinct on (a.company_id) a.*
       from assessments a
       where a.company_id = any($1::uuid[])
       order by a.company_id, a.created_at desc
     ),
     participant_counts as (
       select
         ap.assessment_id,
         count(*) filter (where ap.is_active = true and ap.status <> 'deactivated') as participants_total,
         count(*) filter (where ap.is_active = true and ap.status = 'completed') as completed_participants,
         count(*) filter (
           where ap.is_active = true
             and ap.status not in ('completed', 'deactivated')
             and (
               (ap.status = 'invited' and ap.invite_sent_at is not null and ap.invite_sent_at < now() - interval '3 days')
               or (ap.status = 'started' and ap.started_at is not null and ap.started_at < now() - interval '7 days')
             )
         ) as overdue_participants
       from assessment_participants ap
       group by ap.assessment_id
     ),
     session_counts as (
       select
         s.assessment_id,
         count(*) as sessions_total,
         count(*) filter (where s.status in ('completed', 'analyzed')) as completed_sessions
       from assessment_sessions s
       group by s.assessment_id
     ),
     finding_counts as (
       select
         f.assessment_id,
         count(*) as findings_total,
         count(*) filter (where f.status = 'Draft') as draft_findings,
         count(*) filter (where f.status = 'Approved') as approved_findings,
         count(*) filter (where f.priority_score >= 80 and f.status = 'Approved') as critical_findings
       from findings f
       group by f.assessment_id
     ),
     recommendation_counts as (
       select
         r.assessment_id,
         count(*) as recommendations_total,
         count(*) filter (where r.status = 'Draft') as draft_recommendations,
         count(*) filter (where r.status = 'Proposed') as proposed_recommendations,
         count(*) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')) as approved_recommendations,
         coalesce(sum(r.estimated_business_value) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')), 0) as estimated_value
       from recommendations r
       group by r.assessment_id
     ),
     roadmap_counts as (
       select ri.assessment_id, count(*) as roadmap_items
       from roadmap_items ri
       group by ri.assessment_id
     ),
     issue_counts as (
       select ki.assessment_id, count(*) filter (where ki.status in ('open', 'investigating', 'waiting')) as open_issues
       from krb_issues ki
       where ki.assessment_id is not null
       group by ki.assessment_id
     )
     select
       ap.id as project_id,
       ap.name as project_name,
       ap.client_display_name,
       ap.industry_context,
       ap.status as project_status,
       o.name as organization_name,
       la.id as assessment_id,
       la.title as assessment_name,
       la.status as assessment_status,
       la.created_at as assessment_created_at,
       ab.id as blueprint_id,
       ab.assessment_completeness_score,
       ab.assessment_confidence_score,
       coalesce(pc.participants_total, 0) as participants_total,
       coalesce(pc.completed_participants, 0) as completed_participants,
       coalesce(pc.overdue_participants, 0) as overdue_participants,
       coalesce(sc.sessions_total, 0) as sessions_total,
       coalesce(sc.completed_sessions, 0) as completed_sessions,
       coalesce(fc.findings_total, 0) as findings_total,
       coalesce(fc.draft_findings, 0) as draft_findings,
       coalesce(fc.approved_findings, 0) as approved_findings,
       coalesce(fc.critical_findings, 0) as critical_findings,
       coalesce(rc.recommendations_total, 0) as recommendations_total,
       coalesce(rc.draft_recommendations, 0) as draft_recommendations,
       coalesce(rc.proposed_recommendations, 0) as proposed_recommendations,
       coalesce(rc.approved_recommendations, 0) as approved_recommendations,
       coalesce(rc.estimated_value, 0) as estimated_value,
       coalesce(road.roadmap_items, 0) as roadmap_items,
       coalesce(ic.open_issues, 0) as open_issues
     from assessment_projects ap
     join organizations o on o.id = ap.organization_id
     left join latest_assessments la on la.company_id = ap.id
     left join assessment_blueprints ab on ab.assessment_project_id = ap.id
     left join participant_counts pc on pc.assessment_id = la.id
     left join session_counts sc on sc.assessment_id = la.id
     left join finding_counts fc on fc.assessment_id = la.id
     left join recommendation_counts rc on rc.assessment_id = la.id
     left join roadmap_counts road on road.assessment_id = la.id
     left join issue_counts ic on ic.assessment_id = la.id
     where ap.id = any($1::uuid[])
     order by ap.created_at desc`,
    [projectIds]
  );

  const projectMap = new Map(projects.map((project) => [String(project.id), project]));
  const assignedOrganizations = result.rows.map((row) => {
    const project = projectMap.get(String(row.project_id));
    const lifecycleStatus = consultantLifecycleStatus(row);
    const reportReady = Number(row.approved_findings || 0) > 0
      && Number(row.approved_recommendations || 0) > 0
      && Number(row.roadmap_items || 0) > 0;
    return {
      project_id: row.project_id,
      organization_name: row.client_display_name || row.organization_name || project?.clientDisplayName || "Organization",
      assessment_id: row.assessment_id,
      assessment_name: row.assessment_name || row.project_name || project?.name || "Assessment",
      framework_name: defaultFrameworkDisplayName,
      status: lifecycleStatus,
      project_status: row.project_status,
      completeness_score: Number(row.assessment_completeness_score || 0),
      confidence_score: Number(row.assessment_confidence_score || 0),
      participants_total: Number(row.participants_total || 0),
      completed_participants: Number(row.completed_participants || 0),
      overdue_participants: Number(row.overdue_participants || 0),
      sessions_total: Number(row.sessions_total || 0),
      completed_sessions: Number(row.completed_sessions || 0),
      findings_total: Number(row.findings_total || 0),
      draft_findings: Number(row.draft_findings || 0),
      approved_findings: Number(row.approved_findings || 0),
      critical_findings: Number(row.critical_findings || 0),
      recommendations_total: Number(row.recommendations_total || 0),
      draft_recommendations: Number(row.draft_recommendations || 0),
      proposed_recommendations: Number(row.proposed_recommendations || 0),
      approved_recommendations: Number(row.approved_recommendations || 0),
      estimated_value: Number(row.estimated_value || 0),
      roadmap_items: Number(row.roadmap_items || 0),
      open_issues: Number(row.open_issues || 0),
      report_ready: reportReady ? 1 : 0,
      attention_items: consultantAttentionItems({ ...row, report_ready: reportReady ? 1 : 0 })
    };
  });

  const needsAttention = assignedOrganizations.flatMap((organization) =>
    (organization.attention_items || []).map((item) => ({
      ...item,
      organization_name: organization.organization_name,
      assessment_name: organization.assessment_name
    }))
  );
  const priorityWeight = { high: 3, medium: 2, low: 1 };
  needsAttention.sort((a, b) => (priorityWeight[b.severity] || 0) - (priorityWeight[a.severity] || 0));
  const myQueue = needsAttention
    .filter((item) => ["analysis_ready", "findings_approval", "recommendation_approval", "report_ready", "missing_participants", "overdue_participants"].includes(item.type))
    .slice(0, 10)
    .map((item) => ({
      ...item,
      task: item.type === "analysis_ready" ? "Run analysis"
        : item.type === "findings_approval" ? "Review findings"
        : item.type === "recommendation_approval" ? "Approve recommendations"
        : item.type === "report_ready" ? "Generate or review executive report"
        : item.type === "missing_participants" ? "Follow up with assessment manager"
        : "Send reminder or follow up"
    }));
  const lifecyclePipeline = assignedOrganizations.reduce((totals, organization) => {
    if (organization.status === "Setup") totals.setup += 1;
    else if (organization.status === "Collecting") totals.collection += 1;
    else if (organization.status === "Review") {
      totals.review += organization.draft_findings || organization.findings_total ? 1 : 0;
      totals.recommendations += organization.draft_recommendations || organization.proposed_recommendations || organization.recommendations_total ? 1 : 0;
      if (!organization.draft_findings && !organization.draft_recommendations && !organization.proposed_recommendations) totals.review += 1;
    } else if (organization.status === "Executive Ready") totals.executive_output += 1;
    return totals;
  }, { setup: 0, collection: 0, review: 0, recommendations: 0, executive_output: 0 });

  return {
    generated_at: new Date().toISOString(),
    assigned_organizations: assignedOrganizations,
    needs_attention: needsAttention.slice(0, 12),
    my_queue: myQueue,
    lifecycle_pipeline: lifecyclePipeline,
    reports_ready: assignedOrganizations.filter((organization) => organization.report_ready).slice(0, 8),
    open_issues: needsAttention.filter((item) => item.type === "open_issues").slice(0, 8),
    next_best_action: myQueue[0] || needsAttention[0] || null
  };
}

function platformAttentionLabel(item = {}) {
  const labels = {
    missing_profile: "Organization profile missing",
    missing_blueprint: "Assessment blueprint missing",
    no_participants: "Assessment has no participants",
    overdue_participants: "Participants overdue",
    failed_invitation: "Failed invitation",
    failed_reminder: "Failed reminder",
    session_without_token: "Session without active link",
    analysis_ready: "Analysis ready",
    findings_pending: "Findings pending approval",
    recommendations_pending: "Recommendations pending approval",
    report_ready: "Executive report ready",
    critical_issue: "Critical issue open",
    high_issue: "High-priority issue open"
  };
  return labels[item.type] || "Needs attention";
}

function platformActionForAttention(item = {}) {
  if (item.type === "report_ready") return { label: "Open Report", view: "executive-report" };
  if (["findings_pending", "analysis_ready"].includes(item.type)) return { label: "Open Review", view: "findings" };
  if (item.type === "recommendations_pending") return { label: "Open Recommendations", view: "opportunities" };
  if (["failed_invitation", "failed_reminder", "session_without_token", "critical_issue", "high_issue"].includes(item.type)) return { label: "Open Operations", view: "operations-center" };
  if (["no_participants", "overdue_participants"].includes(item.type)) return { label: "Open Participants", view: "dashboard" };
  if (["missing_profile"].includes(item.type)) return { label: "Open Organization Profile", view: "context" };
  return { label: "Open Assessment", view: "dashboard" };
}

function classifyOperationalDataRecord(...parts) {
  const text = parts
    .filter((part) => part !== undefined && part !== null)
    .map((part) => String(part).toLowerCase())
    .join(" ");
  if (/(demo|sample)/.test(text)) return "demo";
  if (/(qa|test|chaos|validation)/.test(text)) return "qa";
  if (/(internal)/.test(text)) return "internal";
  return "production";
}

function emptyPlatformPipeline() {
  return { setup: 0, collecting: 0, review: 0, recommendations: 0, executive_ready: 0, completed: 0, at_risk: 0 };
}

function buildPlatformPipeline(organizations = [], attention = []) {
  return organizations.reduce((acc, org) => {
    if (org.stage === "Setup") acc.setup += 1;
    else if (org.stage === "Collecting") acc.collecting += 1;
    else if (org.stage === "Review") acc.review += 1;
    else if (org.stage === "Executive Ready") acc.executive_ready += 1;
    if (org.stage === "Executive Ready" && org.report_status === "Ready") acc.recommendations += 1;
    if (org.assessment_status === "completed") acc.completed += 1;
    if (org.completion_percent < 100 && (org.open_issues || attention.some((item) => item.project_id === org.project_id && ["critical", "high"].includes(item.severity)))) acc.at_risk += 1;
    return acc;
  }, emptyPlatformPipeline());
}

function platformClassificationMatch(item = {}, classification = "production") {
  if (classification === "all") return true;
  return (item.classification || "production") === classification;
}

function buildPlatformSnapshot({ classification = "production", organizationCounts = {}, organizations = [], attention = [], reportsReady = [], persistedIssues = [], generatedWarnings = [] } = {}) {
  const scopedOrganizations = organizations.filter((organization) => platformClassificationMatch(organization, classification));
  const scopedAttention = attention.filter((item) => platformClassificationMatch(item, classification));
  const scopedReports = reportsReady.filter((report) => platformClassificationMatch(report, classification));
  const scopedPersistedIssues = persistedIssues.filter((issue) => platformClassificationMatch(issue, classification));
  const scopedWarnings = generatedWarnings.filter((issue) => classification === "all" || !issue.classification || issue.classification === classification);
  const pipeline = buildPlatformPipeline(scopedOrganizations, scopedAttention);
  const counts = organizationCounts[classification] || { total_organizations: 0, active_organizations: 0 };
  return {
    classification,
    total_organizations: Number(counts.total_organizations || 0),
    active_organizations: Number(counts.active_organizations || 0),
    production_organizations: Number(organizationCounts.production?.active_organizations || 0),
    demo_organizations: Number(organizationCounts.demo?.active_organizations || 0),
    qa_organizations: Number(organizationCounts.qa?.active_organizations || 0),
    internal_organizations: Number(organizationCounts.internal?.active_organizations || 0),
    active_workspaces: scopedOrganizations.filter((organization) => organization.project_status === "active").length,
    active_assessments: scopedOrganizations.filter((organization) => ["active", "analysis"].includes(organization.assessment_status)).length,
    collecting_responses: pipeline.collecting,
    analysis_ready: scopedAttention.filter((item) => item.type === "analysis_ready").length,
    reports_ready: scopedReports.length,
    completed_assessments: pipeline.completed,
    overdue_participants: scopedOrganizations.reduce((sum, org) => sum + Number(org.overdue_participants || 0), 0),
    failed_invitations: scopedOrganizations.reduce((sum, org) => sum + Number(org.failed_invitations || 0), 0),
    failed_reminders: scopedOrganizations.reduce((sum, org) => sum + Number(org.failed_reminders || 0), 0),
    participants_without_usable_link: scopedOrganizations.reduce((sum, org) => sum + Number(org.participants_without_usable_link || 0), 0),
    open_issues: scopedPersistedIssues.length,
    generated_warnings: scopedWarnings.length,
    critical_issues: scopedPersistedIssues.filter((issue) => issue.severity === "critical").length,
    estimated_value_identified: scopedOrganizations.reduce((sum, org) => sum + Number(org.estimated_value || 0), 0),
    actual_value_realized: scopedOrganizations.reduce((sum, org) => sum + Number(org.actual_value || 0), 0)
  };
}

async function getPlatformCommandCenter() {
  await ensureAccessControlSchema();
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    const organizationCount = await client.query(`
      select
        classification,
        count(*)::int as total_organizations,
        count(*) filter (where status = 'active')::int as active_organizations
      from organizations
      group by classification
    `);
    const result = await client.query(`
      with latest_assessments as (
        select distinct on (a.company_id) a.*
        from assessments a
        order by a.company_id, a.created_at desc
      ),
      participant_counts as (
        select
          ap.assessment_id,
          count(*) filter (where ap.is_active = true and ap.status <> 'deactivated') as participants_total,
          count(*) filter (where ap.is_active = true and ap.status in ('invited', 'started', 'completed')) as participants_invited,
          count(*) filter (where ap.is_active = true and ap.status = 'started') as participants_started,
          count(*) filter (where ap.is_active = true and ap.status = 'completed') as participants_completed,
          count(*) filter (
            where ap.is_active = true
              and ap.status not in ('completed', 'deactivated')
              and (
                (ap.status = 'invited' and ap.invite_sent_at is not null and ap.invite_sent_at < now() - interval '3 days')
                or (ap.status = 'started' and ap.started_at is not null and ap.started_at < now() - interval '7 days')
              )
          ) as overdue_participants,
          count(*) filter (where ap.is_active = true and ap.email_status = 'failed') as failed_invitations,
          count(*) filter (where ap.is_active = true and ap.reminder_status = 'failed') as failed_reminders,
          max(greatest(coalesce(ap.updated_at, ap.created_at), coalesce(ap.completed_at, ap.created_at), coalesce(ap.last_invite_sent_at, ap.created_at), coalesce(ap.last_reminder_sent_at, ap.created_at))) as participant_last_activity
        from assessment_participants ap
        group by ap.assessment_id
      ),
      session_counts as (
        select
          s.assessment_id,
          count(*) as sessions_total,
          count(*) filter (where s.status in ('completed', 'analyzed')) as completed_sessions
        from assessment_sessions s
        group by s.assessment_id
      ),
      token_counts as (
        select
          p.assessment_id,
          count(*) filter (where t.is_active = true and t.expires_at > now()) as active_tokens,
          count(*) filter (where t.is_active = true and t.expires_at <= now()) as expired_tokens,
          count(*) filter (where p.session_id is not null and p.status not in ('completed', 'deactivated') and tok.participant_id is null) as sessions_without_tokens,
          count(distinct p.participant_id) filter (
            where p.session_id is not null
              and p.status not in ('completed', 'deactivated')
              and tok.participant_id is null
          ) as participants_without_usable_link
        from assessment_participants p
        left join assessment_access_tokens t on t.participant_id = p.participant_id
        left join (
          select distinct participant_id
          from assessment_access_tokens
          where is_active = true and expires_at > now()
        ) tok on tok.participant_id = p.participant_id
        group by p.assessment_id
      ),
      finding_counts as (
        select
          f.assessment_id,
          count(*) as findings_total,
          count(*) filter (where f.status = 'Draft') as draft_findings,
          count(*) filter (where f.status = 'Approved') as approved_findings,
          count(*) filter (where f.status = 'Approved' and f.priority_score >= 80) as critical_findings
        from findings f
        group by f.assessment_id
      ),
      recommendation_counts as (
        select
          r.assessment_id,
          count(*) as recommendations_total,
          count(*) filter (where r.status = 'Draft') as draft_recommendations,
          count(*) filter (where r.status = 'Proposed') as proposed_recommendations,
          count(*) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')) as approved_recommendations,
          coalesce(sum(r.estimated_business_value) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')), 0) as estimated_value,
          coalesce(sum(r.actual_value) filter (where r.status = 'Completed'), 0) as actual_value
        from recommendations r
        group by r.assessment_id
      ),
      roadmap_counts as (
        select assessment_id, count(*) as roadmap_items
        from roadmap_items
        group by assessment_id
      ),
      issue_counts as (
        select
          assessment_id,
          count(*) filter (where status in ('open', 'investigating', 'waiting')) as open_issues,
          count(*) filter (where status in ('open', 'investigating', 'waiting') and severity = 'critical') as critical_issues,
          count(*) filter (where status in ('open', 'investigating', 'waiting') and severity = 'high') as high_issues
        from krb_issues
        group by assessment_id
      ),
      consultants as (
        select
          cca.company_id,
          string_agg(distinct coalesce(u.name, u.full_name, u.email), ', ') as assigned_consultants
        from consultant_company_assignments cca
        join users u on u.id = cca.consultant_user_id
        where cca.is_active = true
        group by cca.company_id
      )
      select
        ap.id as project_id,
        ap.organization_id,
        ap.name as project_name,
        ap.client_display_name,
        ap.industry_context,
        ap.status as project_status,
        ap.created_at as project_created_at,
        o.name as organization_name,
        o.status as organization_status,
        coalesce(o.classification, 'production') as organization_classification,
        coalesce(ap.classification, o.classification, 'production') as project_classification,
        la.id as assessment_id,
        la.title as assessment_name,
        la.status as assessment_status,
        la.created_at as assessment_created_at,
        cp.id as company_profile_id,
        ab.id as blueprint_id,
        ab.assessment_completeness_score,
        ab.assessment_confidence_score,
        coalesce(pc.participants_total, 0) as participants_total,
        coalesce(pc.participants_invited, 0) as participants_invited,
        coalesce(pc.participants_started, 0) as participants_started,
        coalesce(pc.participants_completed, 0) as participants_completed,
        coalesce(pc.overdue_participants, 0) as overdue_participants,
        coalesce(pc.failed_invitations, 0) as failed_invitations,
        coalesce(pc.failed_reminders, 0) as failed_reminders,
        coalesce(sc.sessions_total, 0) as sessions_total,
        coalesce(sc.completed_sessions, 0) as completed_sessions,
        coalesce(tc.active_tokens, 0) as active_tokens,
        coalesce(tc.expired_tokens, 0) as expired_tokens,
        coalesce(tc.sessions_without_tokens, 0) as sessions_without_tokens,
        coalesce(tc.participants_without_usable_link, 0) as participants_without_usable_link,
        coalesce(fc.findings_total, 0) as findings_total,
        coalesce(fc.draft_findings, 0) as draft_findings,
        coalesce(fc.approved_findings, 0) as approved_findings,
        coalesce(fc.critical_findings, 0) as critical_findings,
        coalesce(rc.recommendations_total, 0) as recommendations_total,
        coalesce(rc.draft_recommendations, 0) as draft_recommendations,
        coalesce(rc.proposed_recommendations, 0) as proposed_recommendations,
        coalesce(rc.approved_recommendations, 0) as approved_recommendations,
        coalesce(rc.estimated_value, 0) as estimated_value,
        coalesce(rc.actual_value, 0) as actual_value,
        coalesce(road.roadmap_items, 0) as roadmap_items,
        coalesce(ic.open_issues, 0) as open_issues,
        coalesce(ic.critical_issues, 0) as critical_issues,
        coalesce(ic.high_issues, 0) as high_issues,
        consultants.assigned_consultants,
        greatest(
          coalesce(pc.participant_last_activity, ap.created_at),
          coalesce(la.created_at, ap.created_at),
          ap.updated_at
        ) as last_activity
      from assessment_projects ap
      join organizations o on o.id = ap.organization_id
      left join latest_assessments la on la.company_id = ap.id
      left join company_profiles cp on cp.assessment_project_id = ap.id
      left join assessment_blueprints ab on ab.assessment_project_id = ap.id
      left join participant_counts pc on pc.assessment_id = la.id
      left join session_counts sc on sc.assessment_id = la.id
      left join token_counts tc on tc.assessment_id = la.id
      left join finding_counts fc on fc.assessment_id = la.id
      left join recommendation_counts rc on rc.assessment_id = la.id
      left join roadmap_counts road on road.assessment_id = la.id
      left join issue_counts ic on ic.assessment_id = la.id
      left join consultants on consultants.company_id = ap.id
      where coalesce(ap.status, 'active') <> 'archived'
      order by last_activity desc nulls last, ap.created_at desc
    `);
    const rows = result.rows;
    const reportsReady = [];
    const needsAttention = [];
    const organizations = rows.map((row) => {
      const stage = consultantLifecycleStatus(row);
      const reportReady = Number(row.approved_findings || 0) > 0
        && Number(row.approved_recommendations || 0) > 0
        && Number(row.roadmap_items || 0) > 0;
      const completionPercent = Number(row.participants_total || 0)
        ? Math.round((Number(row.participants_completed || 0) / Number(row.participants_total || 0)) * 100)
        : 0;
      const base = {
        project_id: row.project_id,
        organization_id: row.organization_id,
        classification: row.project_classification || row.organization_classification || "production",
        organization_classification: row.organization_classification || "production",
        project_classification: row.project_classification || "production",
        organization_name: row.client_display_name || row.organization_name || "Organization",
        framework_name: defaultFrameworkDisplayName,
        assessment_id: row.assessment_id,
        assessment_name: row.assessment_name || row.project_name || "Assessment",
        project_status: row.project_status,
        assessment_status: row.assessment_status,
        stage,
        completion_percent: completionPercent,
        confidence_score: Number(row.assessment_confidence_score || 0),
        completeness_score: Number(row.assessment_completeness_score || 0),
        open_issues: Number(row.open_issues || 0),
        critical_issues: Number(row.critical_issues || 0),
        high_issues: Number(row.high_issues || 0),
        report_status: reportReady ? "Ready" : Number(row.approved_findings || 0) || Number(row.approved_recommendations || 0) ? "In Progress" : "Not Ready",
        report_ready: reportReady,
        assigned_consultant: row.assigned_consultants || "",
        estimated_value: Number(row.estimated_value || 0),
        actual_value: Number(row.actual_value || 0),
        overdue_participants: Number(row.overdue_participants || 0),
        failed_invitations: Number(row.failed_invitations || 0),
        failed_reminders: Number(row.failed_reminders || 0),
        participants_without_usable_link: Number(row.participants_without_usable_link || 0),
        last_activity: row.last_activity
      };
      const addAttention = (type, severity, explanation, actionOverride = null) => {
        const action = actionOverride || platformActionForAttention({ type });
        needsAttention.push({
          type,
          severity,
          organization_name: base.organization_name,
          assessment_name: base.assessment_name,
          classification: base.classification,
          project_id: base.project_id,
          assessment_id: base.assessment_id,
          label: platformAttentionLabel({ type }),
          explanation,
          action_label: action.label,
          action_view: action.view
        });
      };
      if (!row.company_profile_id) addAttention("missing_profile", "high", "Organization profile is required before the assessment can be trusted.");
      if (row.assessment_id && !row.blueprint_id) addAttention("missing_blueprint", "high", "Assessment exists but blueprint coverage has not been generated.");
      if (row.assessment_id && Number(row.participants_total || 0) === 0) addAttention("no_participants", "high", "Assessment cannot collect responses without assigned participants.");
      if (Number(row.overdue_participants || 0) > 0) addAttention("overdue_participants", "medium", `${row.overdue_participants} participant(s) are overdue.`);
      if (Number(row.failed_invitations || 0) > 0) addAttention("failed_invitation", "high", `${row.failed_invitations} invitation(s) failed.`);
      if (Number(row.failed_reminders || 0) > 0) addAttention("failed_reminder", "medium", `${row.failed_reminders} reminder(s) failed.`);
      if (Number(row.sessions_without_tokens || 0) > 0 || Number(row.expired_tokens || 0) > 0) addAttention("session_without_token", "high", "One or more incomplete sessions lack a usable assessment link.");
      if (Number(row.completed_sessions || 0) > 0 && Number(row.findings_total || 0) === 0) addAttention("analysis_ready", "high", "Completed sessions are available but findings have not been generated.");
      if (Number(row.draft_findings || 0) > 0) addAttention("findings_pending", "high", `${row.draft_findings} finding(s) are waiting for review.`);
      if (Number(row.draft_recommendations || 0) + Number(row.proposed_recommendations || 0) > 0) addAttention("recommendations_pending", "medium", "Recommendations are waiting for approval.");
      if (reportReady) {
        reportsReady.push({ ...base, last_updated: row.last_activity });
        addAttention("report_ready", "low", "Executive report has approved findings, recommendations, and roadmap items.", { label: "Open Report", view: "executive-report" });
      }
      if (Number(row.critical_issues || 0) > 0) addAttention("critical_issue", "critical", `${row.critical_issues} critical issue(s) are open.`);
      else if (Number(row.high_issues || 0) > 0) addAttention("high_issue", "high", `${row.high_issues} high-priority issue(s) are open.`);
      return {
        ...base,
        next_action: needsAttention.find((item) => item.project_id === base.project_id)?.label || (reportReady ? "Open Report" : "Open Workspace")
      };
    });
    const priorityWeight = { critical: 4, high: 3, medium: 2, low: 1 };
    needsAttention.sort((a, b) => (priorityWeight[b.severity] || 0) - (priorityWeight[a.severity] || 0));
    const productionOrganizations = organizations.filter((org) => org.classification === "production");
    const productionAttention = needsAttention.filter((item) => item.classification === "production");
    const pipeline = buildPlatformPipeline(productionOrganizations, productionAttention);
    const consultantsResult = await client.query(`
      select
        u.id,
        coalesce(u.name, u.full_name, u.email) as consultant_name,
        u.email,
        count(distinct cca.company_id) filter (where cca.is_active = true) as assigned_organizations,
        count(distinct a.id) filter (where a.status in ('active', 'analysis')) as active_assessments,
        count(distinct f.id) filter (where f.status = 'Draft') as findings_pending_review,
        count(distinct a.id) filter (
          where exists (select 1 from findings f2 where f2.assessment_id = a.id and f2.status = 'Approved')
            and exists (select 1 from recommendations r2 where r2.assessment_id = a.id and r2.status in ('Approved', 'Accepted', 'In Progress', 'Completed'))
            and exists (select 1 from roadmap_items ri2 where ri2.assessment_id = a.id)
        ) as reports_ready,
        count(distinct p.participant_id) filter (
          where p.is_active = true
            and p.status not in ('completed', 'deactivated')
            and (
              (p.status = 'invited' and p.invite_sent_at is not null and p.invite_sent_at < now() - interval '3 days')
              or (p.status = 'started' and p.started_at is not null and p.started_at < now() - interval '7 days')
            )
        ) as overdue_collection_items,
        count(distinct i.issue_id) filter (where i.status in ('open', 'investigating', 'waiting')) as open_issues
      from users u
      left join consultant_company_assignments cca on cca.consultant_user_id = u.id and cca.is_active = true
      left join assessments a on a.company_id = cca.company_id
      left join findings f on f.assessment_id = a.id
      left join assessment_participants p on p.assessment_id = a.id
      left join krb_issues i on i.assessment_id = a.id
      where u.role in ('consultant', 'auditor') and u.status = 'active'
      group by u.id, u.name, u.full_name, u.email
      order by assigned_organizations desc, consultant_name
    `);
    const issuesResult = await client.query(`
      select
        i.*,
        a.title as assessment_name,
        ap.client_display_name as organization_name,
        coalesce(ap.classification, o.classification, 'production') as classification
      from krb_issues i
      left join assessments a on a.id = i.assessment_id
      left join assessment_projects ap on ap.id = a.company_id
      left join organizations o on o.id = ap.organization_id
      where i.status in ('open', 'investigating', 'waiting')
      order by case i.severity when 'critical' then 1 when 'high' then 2 when 'medium' then 3 else 4 end, i.created_at desc
      limit 20
    `);
    const recentActivityResult = await client.query(`
      select timestamp as happened_at, action, entity_type, assessment_id, participant_id, actor_email
      from krb_audit_logs
      union all
      select created_at as happened_at, 'organization_created' as action, 'organization' as entity_type, null::uuid as assessment_id, null::uuid as participant_id, '' as actor_email
      from assessment_projects
      union all
      select completed_at as happened_at, 'participant_completed' as action, 'participant' as entity_type, assessment_id, participant_id, email as actor_email
      from assessment_participants
      where completed_at is not null
      order by happened_at desc nulls last
      limit 30
    `);
    const opsData = await getKrbOperationsData();
    const organizationCounts = organizationCount.rows.reduce((acc, row) => {
      const classification = row.classification || "production";
      acc[classification] = {
        total_organizations: Number(row.total_organizations || 0),
        active_organizations: Number(row.active_organizations || 0)
      };
      acc.all.total_organizations += Number(row.total_organizations || 0);
      acc.all.active_organizations += Number(row.active_organizations || 0);
      return acc;
    }, {
      all: { total_organizations: 0, active_organizations: 0 },
      production: { total_organizations: 0, active_organizations: 0 },
      demo: { total_organizations: 0, active_organizations: 0 },
      qa: { total_organizations: 0, active_organizations: 0 },
      internal: { total_organizations: 0, active_organizations: 0 }
    });
    const persistedIssues = issuesResult.rows.map((issue) => ({
      ...issue,
      classification: issue.classification || organizations.find((org) => String(org.assessment_id || "") === String(issue.assessment_id || ""))?.classification || "production"
    }));
    const generatedWarnings = (opsData.generated_issues || []).map((issue) => ({
      ...issue,
      classification: organizations.find((org) => String(org.assessment_id || "") === String(issue.assessment_id || ""))?.classification || issue.classification || "production"
    }));
    const classificationSnapshots = ["production", "demo", "qa", "internal", "all"].reduce((acc, classification) => {
      acc[classification] = buildPlatformSnapshot({
        classification,
        organizationCounts,
        organizations,
        attention: needsAttention,
        reportsReady,
        persistedIssues,
        generatedWarnings
      });
      return acc;
    }, {});
    const platformSnapshot = classificationSnapshots.production;
    const productionReportsReady = reportsReady.filter((report) => report.classification === "production");
    const productionGeneratedWarnings = generatedWarnings.filter((issue) => (issue.classification || "production") === "production");
    const productionPersistedIssues = persistedIssues.filter((issue) => (issue.classification || "production") === "production");
    const productionOpenIssues = [
      ...productionPersistedIssues,
      ...productionGeneratedWarnings.map((issue, index) => ({ ...issue, issue_id: `generated-${index}`, status: "open", organization_name: "", assessment_name: "" }))
    ];
    const productionNextBestAction = productionAttention[0] || (productionReportsReady[0] ? {
      type: "report_ready",
      severity: "low",
      classification: "production",
      organization_name: productionReportsReady[0].organization_name,
      assessment_name: productionReportsReady[0].assessment_name,
      project_id: productionReportsReady[0].project_id,
      label: "Executive report ready",
      explanation: "Review the report before delivery.",
      action_label: "Open Report",
      action_view: "executive-report"
    } : null);
    return {
      generated_at: new Date().toISOString(),
      platform_snapshot: platformSnapshot,
      classification_counts: organizationCounts,
      classification_snapshots: classificationSnapshots,
      needs_attention: needsAttention.filter((item) => item.classification === "production").slice(0, 20),
      needs_attention_all: needsAttention.slice(0, 50),
      organization_portfolio_summary: productionOrganizations,
      organization_portfolio_all: organizations,
      assessment_pipeline: pipeline,
      consultant_workload: consultantsResult.rows.map((row) => ({
        consultant_id: row.id,
        consultant_name: row.consultant_name,
        email: row.email,
        assigned_organizations: Number(row.assigned_organizations || 0),
        active_assessments: Number(row.active_assessments || 0),
        findings_pending_review: Number(row.findings_pending_review || 0),
        reports_ready: Number(row.reports_ready || 0),
        overdue_collection_items: Number(row.overdue_collection_items || 0),
        open_issues: Number(row.open_issues || 0)
      })),
      reports_ready: productionReportsReady.slice(0, 10),
      reports_ready_all: reportsReady.slice(0, 30),
      operations_health: {
        email_provider_status: opsData.system_health?.email_status || "unknown",
        failed_invitations: platformSnapshot.failed_invitations,
        failed_reminders: platformSnapshot.failed_reminders,
        participants_without_usable_link: platformSnapshot.participants_without_usable_link,
        expired_tokens: rows.filter((row) => (row.project_classification || row.organization_classification || "production") === "production").reduce((sum, row) => sum + Number(row.expired_tokens || 0), 0),
        sessions_without_tokens: rows.filter((row) => (row.project_classification || row.organization_classification || "production") === "production").reduce((sum, row) => sum + Number(row.sessions_without_tokens || 0), 0),
        participants_without_sessions: productionGeneratedWarnings.filter((issue) => issue.related_area === "sessions").length,
        completed_sessions_without_findings: productionAttention.filter((item) => item.type === "analysis_ready").length,
        reports_missing_required_sections: opsData.system_health?.report_issues || 0,
        recent_backend_errors: opsData.system_health?.recent_errors || 0,
        generated_warnings: platformSnapshot.generated_warnings,
        status: platformSnapshot.critical_issues ? "critical" : productionAttention.some((item) => ["critical", "high"].includes(item.severity)) ? "warning" : "healthy"
      },
      open_issues: productionOpenIssues.slice(0, 20),
      open_issues_all: [
        ...persistedIssues,
        ...generatedWarnings.map((issue, index) => ({ ...issue, issue_id: `generated-${index}`, status: "open", organization_name: "", assessment_name: "" }))
      ].slice(0, 50),
      next_best_action: productionNextBestAction,
      recent_activity: recentActivityResult.rows.map((row) => ({
        happened_at: row.happened_at,
        action: row.action,
        entity_type: row.entity_type,
        actor_email: row.actor_email,
        assessment_id: row.assessment_id,
        participant_id: row.participant_id
      }))
    };
  } finally {
    client.release();
  }
}

function assessmentManagerNextAction({ participants = [], coverage = {}, activeAssessment = null } = {}) {
  if (!activeAssessment) {
    return { type: "setup", label: "Assessment has not been created yet.", action: "Create Assessment", target: "manager-overview" };
  }
  const requiredRoles = coverage.required_roles || [];
  const missingRequired = requiredRoles.find((role) => role.status === "Missing");
  if (missingRequired) {
    return {
      type: "missing_role",
      label: `Add missing ${missingRequired.name || missingRequired.id} participant.`,
      action: "Add Participant",
      target: "manager-participants",
      role_id: missingRequired.id
    };
  }
  const withoutSessions = participants.filter((participant) => participant.is_active && participant.status !== "deactivated" && !participant.session_id);
  if (withoutSessions.length) {
    return {
      type: "create_sessions",
      label: `Create sessions for ${withoutSessions.length} participant${withoutSessions.length === 1 ? "" : "s"}.`,
      action: "Create Sessions",
      target: "manager-participants"
    };
  }
  const notInvited = participants.filter((participant) => participant.is_active && participant.status === "not_invited");
  if (notInvited.length) {
    return {
      type: "send_invitations",
      label: `Send invitations to ${notInvited.length} participant${notInvited.length === 1 ? "" : "s"}.`,
      action: "Send Invitations",
      target: "manager-communications"
    };
  }
  const overdue = participants.filter((participant) => participant.overdue);
  if (overdue.length) {
    return {
      type: "send_reminders",
      label: `Send reminders to ${overdue.length} overdue participant${overdue.length === 1 ? "" : "s"}.`,
      action: "Send Reminders",
      target: "manager-communications"
    };
  }
  const incomplete = participants.filter((participant) => participant.is_active && !["completed", "deactivated"].includes(participant.status));
  if (incomplete.length) {
    return {
      type: "follow_up",
      label: `Follow up with ${incomplete.length} incomplete participant${incomplete.length === 1 ? "" : "s"}.`,
      action: "View Progress",
      target: "manager-progress"
    };
  }
  return {
    type: "handoff",
    label: "Collection is complete. Consultant review can begin.",
    action: "Handoff Ready",
    target: "manager-overview"
  };
}

async function getAssessmentManagerCommandCenter(session) {
  await ensureAccessControlSchema();
  const projects = await listProjects(session);
  const project = session.projectId
    ? projects.find((item) => String(item.id) === String(session.projectId)) || projects[0]
    : projects[0];
  if (!project) {
    return {
      generated_at: new Date().toISOString(),
      assigned_organization: null,
      active_assessment: null,
      collection_status: { percent_complete: 0, label: "No assigned assessment" },
      participant_summary: {},
      role_coverage: {},
      invitation_summary: {},
      reminder_summary: {},
      overdue_participants: [],
      missing_roles: [],
      stuck_participants: [],
      next_best_action: { type: "no_assignment", label: "No assigned assessment is available.", action: "Contact platform owner", target: "manager-overview" },
      recent_activity: []
    };
  }
  await requireProjectAccess(session, project.id, ["manager"]);
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    const assessmentResult = await client.query(
      `select * from assessments where company_id = $1 order by created_at desc limit 1`,
      [project.id]
    );
    const assessment = assessmentResult.rows[0] || null;
    let participantState = { participants: [], coverage: { required_roles: [], recommended_roles: [], optional_roles: [], summary: {} } };
    if (assessment) {
      const blueprintRow = await client.query("select * from assessment_blueprints where assessment_project_id = $1 limit 1", [project.id]);
      const blueprint = blueprintRow.rowCount ? mapAssessmentBlueprintRow(blueprintRow.rows[0]) : null;
      participantState = await participantCoverageForBlueprint(client, assessment.id, blueprint);
    }
    const participants = participantState.participants || [];
    const activeParticipants = participants.filter((participant) => participant.is_active && participant.status !== "deactivated");
    const grouped = {
      not_invited: activeParticipants.filter((participant) => participant.status === "not_invited"),
      invited: activeParticipants.filter((participant) => participant.status === "invited"),
      started: activeParticipants.filter((participant) => participant.status === "started"),
      completed: activeParticipants.filter((participant) => participant.status === "completed"),
      overdue: activeParticipants.filter((participant) => participant.overdue)
    };
    const requiredRoles = participantState.coverage.required_roles || [];
    const recommendedRoles = participantState.coverage.recommended_roles || [];
    const missingRoles = [...requiredRoles, ...recommendedRoles].filter((role) => role.status === "Missing");
    const stuckParticipants = activeParticipants.filter((participant) => participant.overdue || (participant.session_id && !participant.active_token_expires_at && participant.status !== "completed"));
    const invitationLogs = assessment
      ? await client.query("select status, sent_at, created_at from assessment_invitation_logs where assessment_id = $1 order by created_at desc limit 50", [assessment.id])
      : { rows: [] };
    const reminderLogs = assessment
      ? await client.query("select status, sent_at, created_at from assessment_reminder_logs where assessment_id = $1 order by created_at desc limit 50", [assessment.id])
      : { rows: [] };
    const invitationSummary = {
      sent: activeParticipants.filter((participant) => participant.invite_sent_at || participant.email_status === "sent").length,
      failed: activeParticipants.filter((participant) => participant.email_status === "failed").length,
      not_sent: activeParticipants.filter((participant) => !participant.invite_sent_at && participant.email_status !== "sent").length,
      last_sent_at: activeParticipants.map((participant) => participant.last_invite_sent_at || participant.invite_sent_at).filter(Boolean).sort().at(-1) || null,
      logs: invitationLogs.rows
    };
    const reminderSummary = {
      sent: activeParticipants.reduce((sum, participant) => sum + Number(participant.reminder_count || 0), 0),
      failed: activeParticipants.filter((participant) => participant.reminder_status === "failed").length,
      last_sent_at: activeParticipants.map((participant) => participant.last_reminder_sent_at).filter(Boolean).sort().at(-1) || null,
      logs: reminderLogs.rows
    };
    const percentComplete = activeParticipants.length
      ? Math.round((grouped.completed.length / activeParticipants.length) * 100)
      : 0;
    const collectionComplete = Boolean(activeParticipants.length) && activeParticipants.every((participant) => participant.status === "completed");
    const recentActivity = [
      ...activeParticipants
        .filter((participant) => participant.completed_at || participant.started_at || participant.invite_sent_at)
        .map((participant) => ({
          type: participant.completed_at ? "completed" : participant.started_at ? "started" : "invited",
          title: `${participant.full_name} ${participant.completed_at ? "completed" : participant.started_at ? "started" : "was invited"}`,
          timestamp: participant.completed_at || participant.started_at || participant.invite_sent_at
        })),
      ...reminderLogs.rows
        .filter((row) => row.sent_at)
        .map((row) => ({ type: "reminder", title: `Reminder ${row.status}`, timestamp: row.sent_at }))
    ]
      .filter((item) => item.timestamp)
      .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
      .slice(0, 10);

    return {
      generated_at: new Date().toISOString(),
      assigned_organization: {
        project_id: project.id,
        organization_name: project.clientDisplayName || project.organizationName || project.name,
        industry_context: project.industryContext,
        status: project.status
      },
      active_assessment: assessment ? {
        assessment_id: assessment.id,
        name: assessment.title,
        status: assessment.status,
        created_at: assessment.created_at,
        framework_name: defaultFrameworkDisplayName
      } : null,
      collection_status: {
        percent_complete: percentComplete,
        label: collectionComplete ? "Collection complete" : `Assessment collection is ${percentComplete}% complete.`,
        complete: collectionComplete
      },
      participant_summary: {
        total: activeParticipants.length,
        invited: grouped.invited.length + grouped.started.length + grouped.completed.length,
        started: grouped.started.length,
        completed: grouped.completed.length,
        overdue: grouped.overdue.length,
        not_invited: grouped.not_invited.length,
        missing_required_roles: requiredRoles.filter((role) => role.status === "Missing").length
      },
      role_coverage: participantState.coverage,
      invitation_summary: invitationSummary,
      reminder_summary: reminderSummary,
      overdue_participants: grouped.overdue,
      missing_roles: missingRoles,
      stuck_participants: stuckParticipants,
      participant_groups: grouped,
      participants,
      next_best_action: assessmentManagerNextAction({ participants: activeParticipants, coverage: participantState.coverage, activeAssessment: assessment }),
      recent_activity: recentActivity
    };
  } finally {
    client.release();
  }
}

async function createProject(payload) {
  await ensureAccessControlSchema();
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const organizationName = String(payload.organizationName || payload.clientDisplayName || payload.domain || "New Company").trim();
    const domain = String(payload.domain || "").trim().toLowerCase();
    const classification = payload.classification && ["production", "demo", "qa", "internal"].includes(payload.classification)
      ? payload.classification
      : classifyOperationalDataRecord(organizationName, payload.name, payload.industry, payload.industryContext, domain);
    const existingOrg = await client.query(
      "select id, classification from organizations where lower(name) = lower($1) limit 1",
      [organizationName]
    );
    const organizationId = existingOrg.rowCount
      ? existingOrg.rows[0].id
      : (await client.query(
          "insert into organizations (name, industry, default_language, classification) values ($1, $2, $3, $4) returning id",
          [organizationName, payload.industry || "Digital Transformation", payload.defaultLanguage || "en", classification]
        )).rows[0].id;
    const projectClassification = existingOrg.rowCount ? existingOrg.rows[0].classification || classification : classification;
    const methodologyVersionId = await getOrCreateDefaultMethodologyVersion(client);
    const project = await client.query(
      `insert into assessment_projects
        (organization_id, methodology_version_id, name, client_display_name, industry_context, default_language, status, classification)
       values ($1, $2, $3, $4, $5, $6, 'active', $7)
       returning *`,
      [
        organizationId,
        methodologyVersionId,
        payload.name || "Digital Transformation Assessment",
        organizationName,
        payload.industryContext || (domain ? `Initial discovery can start from ${domain}.` : "Initial reusable assessment project."),
        payload.defaultLanguage || "en",
        projectClassification
      ]
    );
    await client.query("commit");
    return mapProject({
      ...project.rows[0],
      organization_name: organizationName,
      organization_classification: projectClassification,
      classification: projectClassification,
      response_count: 0,
      assignment_count: 0
    });
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

function mapUser(row, tempPassword = null) {
  const role = normalizeRole(row.assignment_role || row.project_role || row.organization_role || row.role);
  return {
    id: row.id,
    name: row.name || row.full_name || "",
    email: row.email,
    role,
    organizationId: row.organization_id,
    projectId: row.company_id || row.assessment_project_id,
    status: row.membership_status || row.status || "active",
    createdAt: row.created_at,
    credentialsSentAt: row.credentials_sent_at || null,
    password: tempPassword || undefined
  };
}

async function ensureCreatorUser() {
  await ensureAccessControlSchema();
  const context = await getDefaultContext({
    templateId: "operations-manager",
    templateName: "Operations Manager",
    language: "tr",
    department: "General"
  });
  const email = "fatih@deriveglobal.com";
  const existing = await query("select id from users where email = $1 limit 1", [email]);
  const userId = existing.rowCount
    ? existing.rows[0].id
    : (await query(
        `insert into users (email, full_name, name, role, auth_provider, password_hash, status)
         values ($1, $2, $2, 'platform_owner', 'local', null, 'active')
         returning id`,
        [email, "Fatih Yildirim"]
      )).rows[0].id;

  await query("update users set role = 'platform_owner', name = coalesce(name, full_name) where id = $1", [userId]);

  await query(
    `insert into organization_memberships (organization_id, user_id, role, status)
     values ($1, $2, 'creator', 'active')
     on conflict (organization_id, user_id) do update set role = 'creator', status = 'active'`,
    [context.organizationId, userId]
  );
  await query(
    `insert into project_memberships (organization_id, assessment_project_id, user_id, role, status)
     values ($1, $2, $3, 'creator', 'active')
     on conflict (assessment_project_id, user_id) do update set role = 'creator', status = 'active', updated_at = now()`,
    [context.organizationId, context.projectId, userId]
  );
  await query(
    `insert into company_user_assignments (user_id, company_id, role, is_active)
     values ($1, $2, 'platform_owner', true)
     on conflict (user_id, company_id, role) do update set is_active = true, updated_at = now()`,
    [userId, context.projectId]
  );
  return { userId, ...context };
}

async function listUsers({ organizationId, projectId } = {}) {
  await ensureAccessControlSchema();
  await ensureCreatorUser();
  const params = [];
  const filters = [];
  if (organizationId) {
    params.push(organizationId);
    filters.push(`om.organization_id = $${params.length}`);
  }
  if (projectId) {
    params.push(projectId);
    filters.push(`pm.assessment_project_id = $${params.length}`);
  }
  const where = filters.length ? `where ${filters.join(" and ")}` : "";
  const result = await query(
    `select
       u.id,
       u.email,
       u.name,
       u.full_name,
       u.role,
       u.status,
       u.credentials_sent_at,
       u.created_at,
       om.organization_id,
       om.role as organization_role,
       om.status as membership_status,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from users u
     left join organization_memberships om on om.user_id = u.id
     left join project_memberships pm on pm.user_id = u.id and (pm.organization_id = om.organization_id or om.organization_id is null)
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     ${where}
     order by u.created_at desc`,
    params
  );
  return result.rows.map((row) => mapUser(row));
}

async function upsertUser(payload) {
  await ensureAccessControlSchema();
  const role = normalizeRole(payload.role);
  const legacyRole = legacyRoleForMembership(role);
  const email = normalizeEmail(payload.email);
  if (!isEmail(email)) throw new Error("Valid email is required.");

  const context = payload.projectId
    ? await getDefaultContext({ projectId: payload.projectId, department: "General" })
    : await getDefaultContext({ department: "General" });

  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const existing = await client.query("select id from users where email = $1 limit 1", [email]);
    const password = payload.password || generateTemporaryPassword();
    const returnedPassword = payload.password || !existing.rowCount ? password : null;
    const user = existing.rowCount
      ? await client.query(
          `update users
           set full_name = coalesce($2, full_name),
               name = coalesce($2, name),
               role = $4,
               password_hash = case when $3::text is null then password_hash else $3 end,
               password_reset_required = case when $3::text is null then password_reset_required else true end,
               status = 'active',
               updated_at = now()
           where id = $1
           returning *`,
          [existing.rows[0].id, payload.name || null, payload.password ? hashPassword(password) : null, role]
        )
      : await client.query(
          `insert into users (email, full_name, name, role, password_hash, password_reset_required, status)
           values ($1, $2, $2, $4, $3, true, 'active')
           returning *`,
          [email, payload.name || "", hashPassword(password), role]
        );
    const userId = user.rows[0].id;
    await client.query(
      `insert into organization_memberships (organization_id, user_id, role, status)
       values ($1, $2, $3, 'active')
       on conflict (organization_id, user_id) do update set role = excluded.role, status = 'active'`,
      [context.organizationId, userId, legacyRole]
    );
    await client.query(
      `insert into project_memberships (organization_id, assessment_project_id, user_id, role, status)
       values ($1, $2, $3, $4, 'active')
       on conflict (assessment_project_id, user_id) do update set role = excluded.role, status = 'active', updated_at = now()`,
      [context.organizationId, context.projectId, userId, legacyRole]
    );
    await client.query(
      `insert into company_user_assignments (user_id, company_id, role, permissions_json, is_active)
       values ($1, $2, $3, $4, true)
       on conflict (user_id, company_id, role) do update set permissions_json = excluded.permissions_json, is_active = true, updated_at = now()`,
      [userId, context.projectId, role, JSON.stringify(payload.permissions || {})]
    );
    if (role === "consultant") {
      await client.query(
        `insert into consultant_company_assignments (consultant_user_id, company_id, assigned_by_user_id, is_active, revoked_at)
         values ($1, $2, $3, true, null)
         on conflict (consultant_user_id, company_id) do update set is_active = true, revoked_at = null`,
        [userId, context.projectId, payload.assignedByUserId || null]
      );
    }
    await client.query("commit");
    return mapUser({
      ...user.rows[0],
      organization_id: context.organizationId,
      company_id: context.projectId,
      assessment_project_id: context.projectId,
      assignment_role: role,
      project_role: legacyRole,
      membership_status: "active"
    }, returnedPassword);
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function updateUserLifecycle(userId, payload = {}) {
  await ensureAccessControlSchema();
  const role = payload.role ? normalizeRole(payload.role) : null;
  const legacyRole = role ? legacyRoleForMembership(role) : null;
  const status = payload.status && ["active", "invited", "disabled"].includes(payload.status) ? payload.status : null;
  const context = payload.projectId
    ? await getDefaultContext({ projectId: payload.projectId, department: "General" })
    : await getDefaultContext({ department: "General" });

  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const existing = await client.query("select * from users where id = $1 limit 1", [userId]);
    if (!existing.rowCount) throw new Error("User not found.");
    const user = await client.query(
      `update users
       set full_name = coalesce($2, full_name),
           name = coalesce($2, name),
           status = coalesce($3, status),
           role = coalesce($4, role),
           updated_at = now()
       where id = $1
       returning *`,
      [userId, payload.name || null, status, role]
    );
    if (role) {
      await client.query(
        `insert into organization_memberships (organization_id, user_id, role, status)
         values ($1, $2, $3, coalesce($4, 'active'))
         on conflict (organization_id, user_id) do update set role = excluded.role, status = excluded.status`,
        [context.organizationId, userId, legacyRole, status]
      );
      await client.query(
        `insert into project_memberships (organization_id, assessment_project_id, user_id, role, status)
         values ($1, $2, $3, $4, coalesce($5, 'active'))
         on conflict (assessment_project_id, user_id) do update
         set role = excluded.role, status = excluded.status, updated_at = now()`,
        [context.organizationId, context.projectId, userId, legacyRole, status]
      );
      await client.query(
        `insert into company_user_assignments (user_id, company_id, role, is_active)
         values ($1, $2, $3, $4)
         on conflict (user_id, company_id, role) do update set is_active = excluded.is_active, updated_at = now()`,
        [userId, context.projectId, role, status !== "disabled"]
      );
      if (role === "consultant") {
        await client.query(
          `insert into consultant_company_assignments (consultant_user_id, company_id, is_active, revoked_at)
           values ($1, $2, $3, case when $3 then null else now() end)
           on conflict (consultant_user_id, company_id) do update
           set is_active = excluded.is_active, revoked_at = excluded.revoked_at`,
          [userId, context.projectId, status !== "disabled"]
        );
      }
    } else if (status) {
      await client.query(
        "update organization_memberships set status = $2 where user_id = $1 and organization_id = $3",
        [userId, status, context.organizationId]
      );
      await client.query(
        "update project_memberships set status = $2, updated_at = now() where user_id = $1 and assessment_project_id = $3",
        [userId, status, context.projectId]
      );
      await client.query(
        "update company_user_assignments set is_active = $3, updated_at = now() where user_id = $1 and company_id = $2",
        [userId, context.projectId, status !== "disabled"]
      );
      await client.query(
        "update consultant_company_assignments set is_active = $3, revoked_at = case when $3 then null else now() end where consultant_user_id = $1 and company_id = $2",
        [userId, context.projectId, status !== "disabled"]
      );
    }
    if (status === "disabled") {
      await client.query("update user_sessions set revoked_at = now() where user_id = $1 and revoked_at is null", [userId]);
    }
    await client.query("commit");
    return mapUser({
      ...user.rows[0],
      organization_id: context.organizationId,
      company_id: context.projectId,
      assessment_project_id: context.projectId,
      assignment_role: role,
      project_role: legacyRole,
      membership_status: status || "active"
    });
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function sendUserCredentials(userId, { origin, projectId } = {}) {
  const context = projectId
    ? await getDefaultContext({ projectId, department: "General" })
    : await getDefaultContext({ department: "General" });
  const result = await query(
    `select
       u.*,
       om.organization_id,
       om.role as organization_role,
       pm.assessment_project_id,
       pm.role as project_role,
       pm.status as membership_status
     from users u
     left join organization_memberships om on om.user_id = u.id and om.organization_id = $2
     left join project_memberships pm on pm.user_id = u.id and pm.assessment_project_id = $3
     where u.id = $1
     limit 1`,
    [userId, context.organizationId, context.projectId]
  );
  if (!result.rowCount) throw new Error("User not found.");
  const tempPassword = generateTemporaryPassword();
  const user = mapUser(result.rows[0], tempPassword);
  await query(
    `update users
     set password_hash = $2,
         password_reset_required = true,
         credentials_sent_at = now(),
         status = 'invited',
         updated_at = now()
     where id = $1`,
    [userId, hashPassword(tempPassword)]
  );
  await query(
    "update organization_memberships set status = 'invited' where user_id = $1 and organization_id = $2",
    [userId, context.organizationId]
  );
  await query(
    "update project_memberships set status = 'invited', updated_at = now() where user_id = $1 and assessment_project_id = $2",
    [userId, context.projectId]
  );
  await sendGraphMail({
    to: user.email,
    subject: "Derive Assessment Platform Access",
    body: `Hello ${user.name || user.email},

Your Derive Assessment Platform access is ready.

URL:
${origin}

Email:
${user.email}

Temporary password:
${tempPassword}

Assigned role:
${user.role}

Please sign in and change your password after access.

Best regards,
Derive Consulting Team`
  });
  return {
    ...user,
    status: "invited",
    credentialsSentAt: new Date().toISOString()
  };
}

async function authenticateUser({ email, password }) {
  await ensureAccessControlSchema();
  await ensureCreatorUser();
  const normalized = normalizeEmail(email);
  let expiresAt = new Date(Date.now() + 1000 * 60 * 60 * 24 * 14); // SESSION_TTL_V1 fallback
  const result = await query(
    `select
       u.*,
       u.name,
       u.role,
       om.organization_id,
       om.role as organization_role,
       om.status as membership_status,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from users u
     left join organization_memberships om on om.user_id = u.id
     left join project_memberships pm on pm.user_id = u.id and pm.organization_id = om.organization_id
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     where u.email = $1
     order by pm.created_at desc nulls last
     limit 1`,
    [normalized]
  );
  if (!result.rowCount || result.rows[0].status === "disabled" || !verifyPassword(password, result.rows[0].password_hash)) {
    throw new Error("Invalid email or password.");
  }
  const user = mapUser(result.rows[0]);
  if (!["active", "invited"].includes(result.rows[0].membership_status || result.rows[0].status || "active")) {
    throw new Error("Invalid email or password.");
  }
  // 2FA check — if enabled, return pending token instead of session
  if (result.rows[0].totp_enabled) {
    const pendingToken = randomBytes(32).toString("base64url");
    _pending2fa.set(pendingToken, { userId: user.id, expiresAt: Date.now() + 5 * 60 * 1000 });
    return { twoFactorRequired: true, pendingToken };
  }
  try { expiresAt = new Date(Date.now() + await _sessionTtlMs(user.id, user.role)); } catch (e) {} // SESSION_TTL_V1
  const token = await createSession(user.id, { userAgent: "password" }, expiresAt);
  await query("update users set last_login_at = now() where id = $1", [user.id]);
  return { user, sessionToken: token, expiresAt };
}

// SESSION_TTL_V1 — rol-bazli oturum omru (guvenlik): yonetici/mudur 24s, saha temsilcisi 7g.
//   Client AUTO_LOGOUT_V1 politikasini SUNUCUDA da uygular; calinan cerez 14 gun yasamaz.
//   Her cagri try/catch ile korunur: hata olursa rep TTL'e duser, giris ASLA kirilmaz.
const SESSION_TTL_STAFF_MS = 24 * 60 * 60 * 1000;
const SESSION_TTL_REP_MS   = 7 * 24 * 60 * 60 * 1000;
async function _sessionTtlMs(userId, platformRole) {
  const pr = String(platformRole || "").toLowerCase();
  if (pr === "platform_owner" || pr === "company_owner" || pr === "admin") return SESSION_TTL_STAFF_MS;
  try {
    const r = await query(
      `SELECT 1 FROM tenant_user_modules
        WHERE user_id = $1 AND active = true AND module_role IN ('admin','manager') LIMIT 1`,
      [userId]);
    return r.rowCount ? SESSION_TTL_STAFF_MS : SESSION_TTL_REP_MS;
  } catch (e) { return SESSION_TTL_REP_MS; }
}
async function createSession(userId, metadata = {}, expiresAt = new Date(Date.now() + 1000 * 60 * 60 * 24 * 14)) {
  if (!userId) throw new Error("User id is required for session creation.");
  const token = randomBytes(32).toString("base64url");
  await query(
    `insert into user_sessions (user_id, token_hash, expires_at, metadata)
     values ($1, $2, $3, $4)`,
    [userId, hashToken(token), expiresAt, metadata]
  );
  return token;
}

async function getSessionUser(request) {
  await ensureAccessControlSchema();
  const token = getBearerToken(request);
  if (!token) return null;
  const result = await query(
    `select
       us.id as session_id,
       us.user_id,
       us.expires_at,
       us.metadata,
       u.email,
       u.name,
       u.full_name,
       u.role,
       u.status,
       om.organization_id,
       om.role as organization_role,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from user_sessions us
     join users u on u.id = us.user_id
     left join organization_memberships om on om.user_id = u.id and om.status = 'active'
     left join project_memberships pm on pm.user_id = u.id and pm.status = 'active' and (pm.organization_id = om.organization_id or om.organization_id is null)
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     where us.token_hash = $1
       and us.revoked_at is null
       and us.expires_at > now()
       and u.status = 'active'
     order by pm.created_at desc nulls last
     limit 1`,
    [hashToken(token)]
  );
  if (!result.rowCount) return null;
  const row = result.rows[0];
  const _role = normalizeRole(row.assignment_role || row.project_role || row.organization_role || row.role);
  const _sess = {
    sessionId: row.session_id,
    userId: row.user_id,
    email: row.email,
    name: row.name || row.full_name || "",
    role: _role,
    organizationId: row.organization_id,
    projectId: row.company_id || row.assessment_project_id
  };
  if (_role === "platform_owner") {
    const _meta = (row.metadata && typeof row.metadata === "object") ? row.metadata : {};
    _sess.tenantId = _meta.active_tenant_id || null;
    _sess.impersonating = !!_meta.active_tenant_id;
  }
  return _sess;
}

async function requireAuth(request, allowedRoles = []) {
  await ensureCreatorUser();
  const session = await getSessionUser(request);
  if (!session) {
    const error = new Error("Authentication required.");
    error.statusCode = 401;
    throw error;
  }
  if (!roleAllowed(session.role, allowedRoles)) {
    const error = new Error("You do not have permission to perform this action.");
    error.statusCode = 403;
    throw error;
  }
  return session;
}

async function requireProjectAccess(session, projectId, allowedRoles = []) {
  await ensureAccessControlSchema();
  if (!projectId || normalizeRole(session.role) === "platform_owner") return;
  const result = await query(
    `select role from (
       select pm.role
       from project_memberships pm
       where pm.user_id = $1 and pm.assessment_project_id = $2 and pm.status = 'active'
       union all
       select cua.role
       from company_user_assignments cua
       where cua.user_id = $1 and cua.company_id = $2 and cua.is_active = true
       union all
       select 'consultant' as role
       from consultant_company_assignments cca
       where cca.consultant_user_id = $1 and cca.company_id = $2 and cca.is_active = true
     ) access_roles
     limit 1`,
    [session.userId, projectId]
  );
  if (!result.rowCount) {
    const error = new Error("Project access denied.");
    error.statusCode = 403;
    throw error;
  }
  const role = normalizeRole(result.rows[0].role);
  if (!roleAllowed(role, allowedRoles)) {
    const error = new Error("Project role does not allow this action.");
    error.statusCode = 403;
    throw error;
  }
}

async function revokeSession(request) {
  const token = getBearerToken(request);
  if (!token) return;
  await query("update user_sessions set revoked_at = now() where token_hash = $1", [hashToken(token)]);
}

async function createPasswordReset({ email, origin }) {
  const normalized = normalizeEmail(email);
  if (!isEmail(normalized)) return;
  const user = await query("select id, full_name, email from users where email = $1 and status <> 'disabled' limit 1", [normalized]);
  if (!user.rowCount) return;
  const token = randomBytes(32).toString("base64url");
  await query(
    `insert into password_reset_tokens (user_id, token_hash, expires_at)
     values ($1, $2, now() + interval '1 hour')`,
    [user.rows[0].id, hashToken(token)]
  );
  const resetUrl = `${origin}/?reset=${encodeURIComponent(token)}`;
  await sendGraphMail({
    to: normalized,
    subject: "Reset your Derive Assessment Platform password",
    body: `Hello ${user.rows[0].full_name || normalized},

Use this secure link to reset your Derive Assessment Platform password:

${resetUrl}

This link expires in 1 hour.`
  });
}

async function resetPassword({ token, password }) {
  if (!token || String(password || "").length < 8) {
    throw new Error("Reset token and an 8+ character password are required.");
  }
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const reset = await client.query(
      `select *
       from password_reset_tokens
       where token_hash = $1 and used_at is null and expires_at > now()
       limit 1
       for update`,
      [hashToken(token)]
    );
    if (!reset.rowCount) throw new Error("Reset link is invalid or expired.");
    await client.query(
      "update users set password_hash = $1, password_reset_required = false, updated_at = now() where id = $2",
      [hashPassword(password), reset.rows[0].user_id]
    );
    await client.query("update password_reset_tokens set used_at = now() where id = $1", [reset.rows[0].id]);
    await client.query("update user_sessions set revoked_at = now() where user_id = $1", [reset.rows[0].user_id]);
    await client.query("commit");
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function changePassword(session, { currentPassword, newPassword }) {
  if (String(newPassword || "").length < 8) {
    throw new Error("New password must be at least 8 characters.");
  }
  const user = await query("select password_hash from users where id = $1 limit 1", [session.userId]);
  if (!user.rowCount || !verifyPassword(currentPassword, user.rows[0].password_hash)) {
    throw new Error("Current password is incorrect.");
  }
  await query(
    "update users set password_hash = $1, password_reset_required = false, updated_at = now() where id = $2",
    [hashPassword(newPassword), session.userId]
  );
  // Revoke all other sessions — stolen session tokens are invalidated immediately
  await query(
    "update user_sessions set revoked_at = now() where user_id = $1 and id != $2 and revoked_at is null",
    [session.userId, session.sessionId]
  );
}

async function getGraphToken() {
  if (!clientSecret) {
    throw new Error("Microsoft backend email is not configured. Add MICROSOFT_CLIENT_SECRET on the server.");
  }
  if (cachedToken && cachedToken.expiresAt > Date.now() + 60000) {
    return cachedToken.accessToken;
  }

  const form = new URLSearchParams({
    client_id: clientId,
    client_secret: clientSecret,
    scope: "https://graph.microsoft.com/.default",
    grant_type: "client_credentials"
  });

  const response = await fetch(`https://login.microsoftonline.com/${tenantId}/oauth2/v2.0/token`, {
    method: "POST",
    headers: {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    body: form
  });
  const payload = await response.json();
  if (!response.ok) {
    throw new Error(payload.error_description || payload.error || `Token request failed with ${response.status}`);
  }

  cachedToken = {
    accessToken: payload.access_token,
    expiresAt: Date.now() + Number(payload.expires_in || 3600) * 1000
  };
  return cachedToken.accessToken;
}

// ── Öneri/Destek bildirimi ────────────────────────────────────────────────
// Never throws into the request path: notification failure must not fail the write.
async function oneriBildirim(tenantId, oneriId, olay, aktorUserId) {
  try {
    const eh = (x) => String(x ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const t = await pool.query(
      `SELECT o.id, o.baslik, o.kategori, o.durum, o.user_id,
              u.email AS sahip_email, COALESCE(u.full_name, u.email) AS sahip_ad
         FROM saha_oneri o LEFT JOIN users u ON u.id = o.user_id
        WHERE o.id = $1 AND o.tenant_id = $2`, [oneriId, tenantId]);
    if (!t.rowCount) return;
    const t0 = t.rows[0];
    const sn = await pool.query(
      `SELECT m.mesaj, COALESCE(u.full_name, u.email, 'Sistem') AS yazar
         FROM saha_oneri_mesaj m LEFT JOIN users u ON u.id = m.user_id
        WHERE m.oneri_id = $1 ORDER BY m.ts DESC LIMIT 1`, [oneriId]);
    const sonMesaj = sn.rowCount ? sn.rows[0].mesaj : "";
    const sonYazar = sn.rowCount ? sn.rows[0].yazar : "";

    let alicilar = [];
    if (olay === "YANIT_SAHIBE" || olay === "DURUM") {
      if (t0.sahip_email && t0.user_id !== aktorUserId) alicilar = [t0.sahip_email];
    } else {
      const a = await pool.query("SELECT bildirim_eposta FROM saha_oneri_ayar WHERE tenant_id = $1", [tenantId]);
      alicilar = (a.rows[0] && a.rows[0].bildirim_eposta) || [];
    }
    alicilar = [...new Set(alicilar.filter(Boolean))];
    if (!alicilar.length) {
      console.log(`[oneriBildirim] SKIP olay=${olay} oneri=${oneriId} — alici yok (sahip=${t0.sahip_email || "-"} aktor=${aktorUserId})`);
      return;
    }

    const KAT = { HATA: "Hata Bildirimi", OZELLIK: "Özellik İsteği", UI: "Arayüz", DIGER: "Diğer" };
    const DUR = { YENI: "Yeni", INCELENIYOR: "İnceleniyor", TAMAMLANDI: "Tamamlandı", REDDEDILDI: "Reddedildi" };
    const ust = olay === "YENI" ? "Yeni destek kaydı"
              : olay === "DURUM" ? "Destek kaydınız güncellendi"
              : "Destek kaydına yanıt";
    const html = `
      <div style="font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#0f172a">
        <h3 style="margin:0 0 12px">${eh(ust)}</h3>
        <table cellpadding="6" style="border-collapse:collapse;font-size:13px">
          <tr><td style="color:#64748b">Başlık</td><td><b>${eh(t0.baslik)}</b></td></tr>
          <tr><td style="color:#64748b">Kategori</td><td>${eh(KAT[t0.kategori] || t0.kategori)}</td></tr>
          <tr><td style="color:#64748b">Durum</td><td>${eh(DUR[t0.durum] || t0.durum)}</td></tr>
          <tr><td style="color:#64748b">Açan</td><td>${eh(t0.sahip_ad || "-")}</td></tr>
          ${sonYazar ? `<tr><td style="color:#64748b">Son yazan</td><td>${eh(sonYazar)}</td></tr>` : ""}
        </table>
        ${sonMesaj ? `<div style="margin-top:12px;padding:10px 12px;background:#f1f5f9;border-radius:8px;white-space:pre-wrap">${eh(sonMesaj)}</div>` : ""}
        <p style="margin-top:14px;color:#64748b;font-size:12px">Saha &rsaquo; Öneriler sekmesinden görüntüleyip yanıtlayabilirsiniz.</p>
      </div>`;
    for (const adr of alicilar) {
      try {
        await sendGraphMail({ to: adr, subject: `[Derive Saha] ${ust}: ${t0.baslik}`, body: html });
        console.log(`[oneriBildirim] SENT olay=${olay} -> ${adr} ("${t0.baslik}")`);
      } catch (me) {
        console.error(`[oneriBildirim] FAILED olay=${olay} -> ${adr} :: ${me && me.message}`);
      }
    }
  } catch (e) {
    console.error("[oneriBildirim]", e && e.message);
  }
}

async function sendGraphMail({ to, subject, body }) {
  const accessToken = await getGraphToken();
  const response = await fetch(`https://graph.microsoft.com/v1.0/users/${encodeURIComponent(sender)}/sendMail`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${accessToken}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      message: {
        subject,
        from: {
          emailAddress: {
            address: sender,
            name: "Derive Assessment"
          }
        },
        body: {
          contentType: "HTML",
          content: body
        },
        toRecipients: [
          {
            emailAddress: {
              address: to
            }
          }
        ]
      },
      saveToSentItems: true
    })
  });

  if (!response.ok) {
    const text = await response.text();
    throw new Error(text || `Microsoft Graph returned ${response.status}`);
  }
}

function mapAssignment(row) {
  const metadata = row.metadata || {};
  return {
    projectId: row.assessment_project_id,
    token: row.token,
    templateId: metadata.templateId || metadata.stakeholder || row.survey_template_code,
    stakeholderName: metadata.stakeholderName || row.survey_template_name,
    department: metadata.department || "General",
    recipient: row.assigned_to_name || metadata.recipient || "Participant",
    email: row.assigned_to_email || "",
    language: row.language_code || "en",
    url: metadata.url || "",
    status: row.status ? row.status[0].toUpperCase() + row.status.slice(1) : "Created",
    createdAt: row.created_at,
    sentAt: row.sent_at,
    respondedAt: row.completed_at
  };
}

