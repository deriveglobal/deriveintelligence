        triggerRule: `DSP-016:systems:${row.answer_text}`,
        severity: row.answer_text === "6+ systems/tools" ? 5 : 4,
        frequency: 4,
        timeImpact: 4,
        customerImpact: 3,
        employeeImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "DSP-017" && answers.length && !answers.includes("Nowhere")) {
      pushFinding(row, {
