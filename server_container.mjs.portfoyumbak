  }

  const projectKpiMatch = url.pathname.match(/^\/api\/projects\/([^/]+)\/kpis$/);
  if (projectKpiMatch && request.method === "GET") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const projectId = decodeURIComponent(projectKpiMatch[1]);
      await requireProjectAccess(session, projectId, ["consultant", "manager"]);
      const profile = await query(
        `SELECT *
         FROM company_profiles
         WHERE assessment_project_id = $1
         LIMIT 1`,
        [projectId]
      );
      const recommended = profile.rowCount
        ? await getLiveRecommendedKpisForProfile(profile.rows[0])
        : [];
      const selected = await query(
        `SELECT *
         FROM company_kpi_selections
         WHERE assessment_project_id = $1
         ORDER BY created_at ASC`,
        [projectId]
      );
      const selectedKeys = new Set(selected.rows.map((row) => row.kpi_key));
      sendJson(response, 200, {
        recommended,
        selected: selected.rows,
        untracked: recommended.filter((kpi) => !selectedKeys.has(kpi.key || kpi.id || kpi.kpi_key))
      });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (projectKpiMatch && request.method === "POST") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const projectId = decodeURIComponent(projectKpiMatch[1]);
      await requireProjectAccess(session, projectId, ["consultant", "manager"]);
      const payload = await readJson(request);
      const kpiKey = frameworkString(payload.kpi_key);
      if (!kpiKey) {
        sendJson(response, 400, { error: "kpi_key is required." });
        return;
      }
      const result = await query(
        `INSERT INTO company_kpi_selections
          (assessment_project_id, kpi_key,
           is_currently_tracked, tracking_method,
           notes)
         VALUES ($1,$2,$3,$4,$5)
         ON CONFLICT (assessment_project_id, kpi_key)
         DO UPDATE SET
           is_currently_tracked = excluded.is_currently_tracked,
           tracking_method = excluded.tracking_method,
           notes = excluded.notes
         RETURNING *`,
        [
          projectId,
          kpiKey,
          Boolean(payload.is_currently_tracked),
          payload.tracking_method || null,
          payload.notes || null
        ]
      );
      sendJson(response, 200, { selection: result.rows[0] });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/consultant-command-center") {
