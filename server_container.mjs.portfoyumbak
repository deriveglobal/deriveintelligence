    await db.query(`
      INSERT INTO framework_scoring_config
        (framework_id, config_key,
         config_value, description)
      SELECT NULL, seed.config_key,
        seed.config_value::jsonb,
        seed.description
      FROM (VALUES
        ('weights', '{
          "breadth": 40,
          "quantity": 20,
          "depth": 20,
          "response_mix": 10,
          "activity_fit": 10
        }',
        'Score component weights. Must sum to 100.'),
        ('breadth_config', '{
          "min_questions_per_domain": 2,
          "expected_domains": [
            "technology_adoption",
            "data_quality",
            "information_flow",
            "operational_execution",
            "communication_channels",
            "financial_visibility",
            "customer_perception",
            "people_capability",
            "process_standardization"
          ]
        }',
        'Breadth calculation config. min_questions_per_domain: minimum questions needed in a domain to count as covered.'),
        ('quantity_config', '{
          "target_per_domain": 5,
          "thresholds": {
            "25": 25,
            "20": 21,
            "15": 17,
            "10": 10,
            "0": 0
          }
        }',
        'Quantity score thresholds. target_per_domain: ideal questions per covered domain.'),
        ('depth_config', '{
