  }

  const respondMatch = url.pathname.match(/^\/api\/respond\/([^/]+)(?:\/([^/]+))?$/);
  if (respondMatch && request.method === "GET" && !respondMatch[2]) {
    try {
      sendJson(response, 200, await getRespondentAssessment(decodeURIComponent(respondMatch[1])));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (respondMatch && request.method === "PATCH" && respondMatch[2] === "responses") {
    try {
      const payload = await readJson(request);
      sendJson(response, 200, await saveRespondentResponses(decodeURIComponent(respondMatch[1]), payload.answers || [], false));
    } catch (error) {
      sendJson(response, error.statusCode || 500, error.payload || { error: error.message });
    }
