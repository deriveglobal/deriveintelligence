        "Content-Disposition": "attachment; filename=\"assessment-participants-template.csv\"",
        "Cache-Control": "no-store"
      });
      response.end(participantUploadTemplateCsv);
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/project-participants") {
