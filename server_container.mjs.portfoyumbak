  dispatcher: "dispatcher_question_bank_v1_revised",
  technician: "technician_question_bank_v1",
  warehouse_manager: "warehouse_inventory_question_bank_v1_revised",
  inventory_coordinator: "warehouse_inventory_question_bank_v1_revised",
  finance_manager: "finance_manager_question_bank_v1_revised",
  sales_manager: "sales_manager_question_bank_v1_revised",
  fleet_customer: "customer_assessment_v1_revised",
  dealer_customer: "customer_assessment_v1_revised",
  retail_customer: "customer_assessment_v1_revised",
  service_partner: "service_partner_assessment_v1",
