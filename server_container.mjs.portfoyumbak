        RETURNING id::text id`, [session.tenantId, key, ad, ikon, JSON.stringify(tpl)]);
    sendJson(response, 201, { ok: true, id: r.rows[0].id, key });
  } catch (e) { sendJson(response, e.statusCode || 500, { error: e.message }); }
  return;
}
