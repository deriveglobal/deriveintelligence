        return;
      }
      await requireProjectAccess(session, payload.projectId || session.projectId, ["creator", "consultant", "manager"]);
      sendJson(response, 201, { assignment: await createSurveyAssignment(payload) });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname.startsWith("/api/survey-assignments/")) {
    try {
      const token = decodeURIComponent(url.pathname.replace("/api/survey-assignments/", ""));
      const assignment = await getSurveyAssignmentByToken(token);
      if (!assignment) {
        sendJson(response, 404, { error: "Survey assignment not found." });
        return;
      }
      sendJson(response, 200, { assignment });
    } catch (error) {
      sendJson(response, 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/responses") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "auditor", "owner", "manager", "viewer"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "auditor", "owner", "manager", "viewer"]);
      sendJson(response, 200, { responses: await listResponses(projectId) });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "POST" && url.pathname === "/api/responses") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "auditor", "owner", "manager", "viewer"]);
      const payload = await readJson(request);
      if (!payload.stakeholder || !payload.answers) {
        sendJson(response, 400, { error: "stakeholder and answers are required." });
        return;
      }
      const projectId = payload.projectId || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "auditor", "owner", "manager", "viewer"]);
      sendJson(response, 201, await createResponse({ ...payload, projectId }));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "GET" && url.pathname === "/api/assessment-engine") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "auditor", "owner", "manager", "viewer"]);
      const projectId = url.searchParams.get("projectId") || session.projectId;
      await requireProjectAccess(session, projectId, ["consultant", "auditor", "owner", "manager", "viewer"]);
      const dashboard = await getAssessmentEngineDashboard(projectId);
      const normalizedRole = normalizeRole(session.role);
      sendJson(
        response,
        200,
        normalizedRole === "assessment_manager"
          ? collectionOnlyAssessmentDashboard(dashboard)
          : normalizedRole === "company_owner"
            ? executiveSafeAssessmentDashboard(dashboard)
            : dashboard
      );
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
