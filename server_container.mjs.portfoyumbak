  }

  if (request.method === "PATCH" && url.pathname === "/api/assessment-blueprint/not-applicable") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const payload = await readJson(request);
      const projectId = payload.projectId || session.projectId;
      await requireProjectAccess(session, projectId, ["creator", "consultant", "manager"]);
      if (!payload.roleId) {
        sendJson(response, 400, { error: "roleId is required." });
        return;
      }
      sendJson(response, 200, { blueprint: await markBlueprintRoleNotApplicable(projectId, payload.roleId, payload.reason || "") });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  const assessmentParticipantsMatch = url.pathname.match(/^\/api\/assessments\/([^/]+)\/participants$/);
  if (assessmentParticipantsMatch && request.method === "GET") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const assessmentId = decodeURIComponent(assessmentParticipantsMatch[1]);
      const assessmentRow = await query("select company_id from assessments where id = $1 limit 1", [assessmentId]);
      if (!assessmentRow.rowCount) {
        sendJson(response, 404, { error: "Assessment not found." });
        return;
      }
      await requireProjectAccess(session, assessmentRow.rows[0].company_id, ["consultant", "manager"]);
      sendJson(response, 200, await listAssessmentParticipants(assessmentId));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (assessmentParticipantsMatch && request.method === "POST") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const assessmentId = decodeURIComponent(assessmentParticipantsMatch[1]);
      const assessmentRow = await query("select company_id from assessments where id = $1 limit 1", [assessmentId]);
      if (!assessmentRow.rowCount) {
        sendJson(response, 404, { error: "Assessment not found." });
        return;
      }
      await requireProjectAccess(session, assessmentRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      const payload = await readJson(request);
      sendJson(response, 201, await createAssessmentParticipant(assessmentId, payload));
    } catch (error) {
      sendJson(response, error.statusCode || 500, {
        error: error.code || error.message,
        message: error.message,
        existingName: error.existingName,
        newName: error.newName,
        email: error.email,
        role: error.role,
        allowDuplicate: error.allowDuplicate
      });
    }
    return;
  }

  const assessmentParticipantUploadMatch = url.pathname.match(/^\/api\/assessments\/([^/]+)\/participants\/(upload-preview|import|create-sessions-bulk|send-invitations)$/);
  if (assessmentParticipantUploadMatch && request.method === "POST") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const assessmentId = decodeURIComponent(assessmentParticipantUploadMatch[1]);
      const action = assessmentParticipantUploadMatch[2];
      const assessmentRow = await query("select company_id from assessments where id = $1 limit 1", [assessmentId]);
      if (!assessmentRow.rowCount) {
        sendJson(response, 404, { error: "Assessment not found." });
        return;
      }
      await requireProjectAccess(session, assessmentRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      if (action === "upload-preview") {
        sendJson(response, 200, await previewAssessmentParticipantUpload(assessmentId, await readJson(request), session));
        return;
      }
      if (action === "import") {
        sendJson(response, 200, await importAssessmentParticipantBatch(assessmentId, await readJson(request)));
        return;
      }
      if (action === "send-invitations") {
        sendJson(response, 200, await sendAssessmentInvitationsBulk(assessmentId, await readJson(request), publicOriginFromRequest(request)));
        return;
      }
      sendJson(response, 200, await createAssessmentParticipantSessionsBulk(assessmentId));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  const assessmentReminderMatch = url.pathname.match(/^\/api\/assessments\/([^/]+)\/reminders\/(bulk-send|summary)$/);
  if (assessmentReminderMatch) {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const assessmentId = decodeURIComponent(assessmentReminderMatch[1]);
      const action = assessmentReminderMatch[2];
      const assessmentRow = await query("select company_id from assessments where id = $1 limit 1", [assessmentId]);
      if (!assessmentRow.rowCount) {
        sendJson(response, 404, { error: "Assessment not found." });
        return;
      }
      await requireProjectAccess(session, assessmentRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      if (request.method === "GET" && action === "summary") {
        sendJson(response, 200, await getAssessmentReminderSummary(assessmentId));
        return;
      }
      if (request.method === "POST" && action === "bulk-send") {
        sendJson(response, 200, await sendAssessmentRemindersBulk(assessmentId, await readJson(request), publicOriginFromRequest(request)));
        return;
      }
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  const participantActionMatch = url.pathname.match(/^\/api\/participants\/([^/]+)(?:\/([^/]+))?$/);
  if (participantActionMatch && request.method === "GET" && !participantActionMatch[2]) {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const participantId = decodeURIComponent(participantActionMatch[1]);
      const participantRow = await query(
        `select p.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name,
                s.status as session_status,
                coalesce(resp.response_count, 0) as response_count
         from assessment_participants p
         left join stakeholder_groups sg on sg.id = p.stakeholder_group_id
         left join stakeholder_roles sr on sr.id = p.stakeholder_role_id
         left join assessment_sessions s on s.id = p.session_id
         left join (
           select assessment_session_id, count(*)::int as response_count
           from responses
           group by assessment_session_id
         ) resp on resp.assessment_session_id = p.session_id
         where p.participant_id = $1
         limit 1`,
        [participantId]
      );
      if (!participantRow.rowCount) {
        sendJson(response, 404, { error: "Participant not found." });
        return;
      }
      await requireProjectAccess(session, participantRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      sendJson(response, 200, { participant: mapAssessmentParticipant(participantRow.rows[0]) });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (participantActionMatch && request.method === "PATCH" && !participantActionMatch[2]) {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const participantId = decodeURIComponent(participantActionMatch[1]);
      const participantRow = await query("select company_id from assessment_participants where participant_id = $1 limit 1", [participantId]);
      if (!participantRow.rowCount) {
        sendJson(response, 404, { error: "Participant not found." });
        return;
      }
      await requireProjectAccess(session, participantRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      sendJson(response, 200, await updateAssessmentParticipant(participantId, await readJson(request)));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (participantActionMatch && request.method === "POST" && participantActionMatch[2] === "create-session") {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const participantId = decodeURIComponent(participantActionMatch[1]);
      const participantRow = await query("select company_id from assessment_participants where participant_id = $1 limit 1", [participantId]);
      if (!participantRow.rowCount) {
        sendJson(response, 404, { error: "Participant not found." });
        return;
      }
      await requireProjectAccess(session, participantRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      sendJson(response, 201, await createParticipantAssessmentSession(participantId));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (participantActionMatch && request.method === "POST" && ["generate-link", "regenerate-link"].includes(participantActionMatch[2])) {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "manager"]);
      const participantId = decodeURIComponent(participantActionMatch[1]);
      const participantRow = await query("select company_id from assessment_participants where participant_id = $1 limit 1", [participantId]);
      if (!participantRow.rowCount) {
        sendJson(response, 404, { error: "Participant not found." });
        return;
      }
      await requireProjectAccess(session, participantRow.rows[0].company_id, ["creator", "consultant", "manager"]);
      sendJson(response, 201, await generateParticipantAccessLink(participantId, publicOriginFromRequest(request)));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
