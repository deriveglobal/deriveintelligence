function normalizeStakeholderCode(value) {
  const normalized = String(value || "").trim().toLowerCase().replace(/_/g, "-").replace(/\s+/g, "-");
  const aliases = {
    ceo: "owner",
    executive: "owner",
    owner: "owner",
    "managing-director": "owner",
    "general-manager": "general-manager",
    gm: "general-manager",
    coo: "general-manager",
    "operations-director": "operations-manager",
    operations: "operations-manager",
    "operations-manager": "operations-manager",
    branch: "branch-managers",
    "branch-manager": "branch-managers",
    "service-manager": "operations-manager",
    "dispatch-manager": "dispatch",
    dispatch: "dispatch",
    dispatcher: "dispatch",
    "customer-service": "customer-service",
    "customer-service-rep": "customer-service",
    technician: "technician",
    technicians: "technician",
    "field-service-technician": "technician",
    inspector: "technician",
    warehouse: "warehouse",
    "warehouse-manager": "warehouse",
    "inventory-coordinator": "warehouse",
    "logistics-coordinator": "warehouse",
    finance: "finance-manager",
    "finance-manager": "finance-manager",
    accountant: "finance-manager",
    sales: "sales-manager",
    "sales-manager": "sales-manager",
    "sales-representative": "sales-manager",
    "account-manager": "sales-manager",
    "it-manager": "it-manager",
    "systems-administrator": "it-manager",
    "hr-manager": "hr-manager",
    "hr-workforce-manager": "hr-manager",
    "workforce-manager": "hr-manager",
    customer: "fleet-customers",
    "fleet-customer": "fleet-customers",
    "fleet-customers": "fleet-customers",
    "dealer-customer": "fleet-customers",
    "retail-customer": "fleet-customers",
    partner: "service-partners",
    "service-partner": "service-partners",
    "service-partners": "service-partners",
    "dealer-partner": "service-partners",
    supplier: "supplier"
  };
  return aliases[normalized] || normalized || "owner";
}

function mapParticipant(row) {
  return {
    id: row.id,
    projectId: row.assessment_project_id,
    stakeholder: row.stakeholder_code,
    name: row.full_name,
    email: row.email || "",
    company: row.company || "",
    department: row.department || "",
    title: row.title || "",
    language: row.language_code || "tr",
    notes: row.notes || "",
    status: row.status || "active",
    source: row.source || "manual",
    createdAt: row.created_at,
    updatedAt: row.updated_at
  };
}

function mapProjectContextIntake(row, origin = "") {
  const token = row.token;
  return {
    id: row.id,
    projectId: row.assessment_project_id,
    token,
    url: origin && token ? `${origin}/?context=${encodeURIComponent(token)}` : "",
    recipientName: row.recipient_name || "",
    recipientEmail: row.recipient_email || "",
    language: row.language_code || "tr",
    status: row.status || "draft",
    contextData: row.context_data || {},
    sentAt: row.sent_at,
    openedAt: row.opened_at,
    submittedAt: row.submitted_at,
    createdAt: row.created_at,
    updatedAt: row.updated_at
  };
}

function asArray(value) {
  if (Array.isArray(value)) return value.map((item) => String(item).trim()).filter(Boolean);
  if (value === null || value === undefined || value === "") return [];
  return [String(value).trim()].filter(Boolean);
}

function uniqueStrings(values = []) {
  return [...new Set(values.map((value) => String(value || "").trim()).filter(Boolean))];
}

function numberOrNull(value) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : null;
}

function recommendedRoleObjects(roleIds = []) {
  return uniqueStrings(roleIds).map((roleId) => {
    const role = stakeholderRolesSeed.find((item) => item.id === roleId);
    return {
      id: roleId,
      name: role?.name || roleId,
      stakeholder_group_id: role?.stakeholder_group_id || stakeholderGroupForRole(roleId),
      stakeholder_group_name: stakeholderGroupName(role?.stakeholder_group_id || stakeholderGroupForRole(roleId))
    };
  });
}

function mapFrameworkKpi(row = {}) {
  return {
    id: row.id,
    key: row.key,
    name: row.name || row.kpi_name,
    name_tr: row.name_tr,
    description: row.description || row.kpi_description,
    description_tr: row.description_tr,
    why_it_matters: row.why_it_matters,
    why_it_matters_tr: row.why_it_matters_tr,
    industry: row.industry,
    applicable_activities: row.applicable_activities || [],
    unit: row.unit || row.target_unit,
    target_direction: row.target_direction,
    is_default: row.is_default !== false,
    is_active: row.is_active !== false,
    sort_order: Number(row.sort_order || 0),
    question_count: Number(row.question_count || 0)
  };
}

async function getKpisForActivities(activities, industry, client) {
  const db = client || requireDatabase();
  const activityList = uniqueStrings(asArray(activities));
  if (!activityList.length) return [];

  const result = await db.query(
    `SELECT DISTINCT
       key, name, name_tr,
       description, description_tr,
       why_it_matters, why_it_matters_tr,
       unit, target_direction,
       applicable_activities,
       industry, is_default, is_active,
       sort_order
     FROM framework_kpis
     WHERE industry = $1
       AND is_active = true
       AND is_default = true
       AND key IS NOT NULL
       AND (
         applicable_activities = '[]'::jsonb
         OR applicable_activities @>
           ANY(ARRAY(
             SELECT jsonb_build_array(a)
             FROM unnest($2::text[]) a
           ))
       )
     ORDER BY sort_order ASC`,
    [industry || "tire_fleet_service", activityList]
  );

  return result.rows.map(mapFrameworkKpi);
}

async function getLiveRecommendedKpisForProfile(profileRow = {}, client) {
  const db = client || requireDatabase();
  const activities = asArray(profileRow.business_activities);
  const industry = normalizeIndustry(profileRow.industry || "tire_fleet_service");
  const liveKpis = activities.length > 0
    ? await getKpisForActivities(activities, industry, db)
    : await db.query(
      `SELECT key, name, name_tr,
         description, why_it_matters,
         unit, target_direction,
         applicable_activities
       FROM framework_kpis
       WHERE industry = $1
         AND is_active = true
         AND is_default = true
         AND key IS NOT NULL
       ORDER BY sort_order ASC`,
      [industry]
    ).then((result) => result.rows.map(mapFrameworkKpi));

  return liveKpis.map((kpi) => ({
    id: kpi.key,
    key: kpi.key,
    name: kpi.name,
    name_tr: kpi.name_tr,
    description: kpi.description,
    why_it_matters: kpi.why_it_matters,
    unit: kpi.unit,
    target_direction: kpi.target_direction,
    applicable_activities: kpi.applicable_activities
  }));
}

function normalizeCompanyProfile(contextData = {}) {
  const businessActivities = asArray(contextData.tireIndustryActivities || contextData.business_activities);
  const tireSegmentsServed = asArray(contextData.tireSegmentsServed || contextData.tire_segments_served);
  const operationalCharacteristics = asArray(contextData.operationalCharacteristics || contextData.operational_characteristics);
  const strategicPriorities = asArray(contextData.topPriorities || contextData.strategicPriorities || contextData.strategic_priorities);
  const signals = uniqueStrings([...businessActivities, ...operationalCharacteristics, ...strategicPriorities]);
  const recommendedRoleIds = new Set();
  const recommendedQuestionRoleIds = new Set();

  for (const signal of signals) {
    (profileSignalToStakeholderRoles[signal] || []).forEach((roleId) => recommendedRoleIds.add(roleId));
    (profileSignalToQuestionRoles[signal] || []).forEach((roleId) => recommendedQuestionRoleIds.add(roleId));
  }

  if (!recommendedRoleIds.size) {
    ["operations_manager", "branch_manager", "finance_manager"].forEach((roleId) => recommendedRoleIds.add(roleId));
  }
  if (!recommendedQuestionRoleIds.size) {
    ["operations_manager"].forEach((roleId) => recommendedQuestionRoleIds.add(roleId));
  }

  const workforceStructure = {
    departments: asArray(contextData.departments),
    managerCount: numberOrNull(contextData.managerCount),
    fieldEmployeeCount: numberOrNull(contextData.fieldEmployeeCount),
    operatingModel: asArray(contextData.operatingModel),
    employeeRange: contextData.employeeRange || ""
  };
  const currentSystems = {
    erpSystem: contextData.erpSystem || "",
    crmSystem: contextData.crmSystem || "",
    accountingSystem: contextData.accountingSystem || "",
    communicationTools: asArray(contextData.communicationTools),
    dailySystemCount: contextData.dailySystemCount || ""
  };

  return {
    industry: contextData.industry || "tire_industry",
    companyName: contextData.companyName || "",
    employeeRange: contextData.employeeRange || "",
    locationCount: numberOrNull(contextData.locationCount),
    customerRange: contextData.customerRange || "",
    revenueRange: contextData.revenueRange || "",
    businessActivities,
    tireSegmentsServed,
    operationalCharacteristics,
    strategicPriorities,
    workforceStructure,
    currentSystems,
    recommendedStakeholderRoles: recommendedRoleObjects([...recommendedRoleIds]),
    recommendedQuestionRoles: recommendedRoleObjects([...recommendedQuestionRoleIds]),
    recommendedKpis: [],
    signals
  };
}

function humanizeKpiId(kpiId = "") {
  const labels = {
    emergency_response_time: "Emergency Response Time",
    sla_compliance_rate: "SLA Compliance Rate",
    average_time_to_assignment: "Average Time to Assignment",
    average_time_to_arrival: "Average Time to Arrival",
    customer_downtime: "Customer Downtime",
    average_dispatch_time: "Average Dispatch Time",
    technician_utilization_rate: "Technician Utilization Rate",
    jobs_completed_per_technician: "Jobs Completed Per Technician",
    travel_time_per_job: "Travel Time Per Job",
    tire_cost_per_kilometer: "Tire Cost Per Kilometer",
    tire_failure_rate: "Tire Failure Rate",
    fleet_contract_renewal_rate: "Fleet Contract Renewal Rate",
    tire_lifecycle_visibility_score: "Tire Lifecycle Visibility Score",
    casing_acceptance_rate: "Casing Acceptance Rate",
    retread_yield_rate: "Retread Yield Rate",
    retread_success_rate: "Retread Success Rate",
    retread_profitability: "Retread Profitability",
    inventory_accuracy: "Inventory Accuracy",
    stockout_rate: "Stockout Rate",
    inventory_turnover: "Inventory Turnover",
    warehouse_productivity: "Warehouse Productivity"
  };
  return labels[kpiId] || String(kpiId || "").replace(/_/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function kpiLabel(kpiId = "") {
  return humanizeKpiId(kpiId);
}

