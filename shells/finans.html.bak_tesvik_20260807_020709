// ---- marka ekonomisi (canlıdan) ----
function renderBrands(list){const bx=document.getElementById('brands');if(!bx)return;
 const rows=(list||[]).filter(b=>b&&b.marj!=null&&isFinite(b.marj)).sort((a,b)=>b.marj-a.marj).slice(0,10);
 if(!rows.length){bx.innerHTML='<div style="color:var(--ink3);padding:8px 0">— canlı marka verisi yok</div>';return;}
 const mx=Math.max(1,...rows.map(b=>Math.abs(b.marj)));
 bx.innerHTML=rows.map(b=>{const w=Math.max(3,Math.abs(b.marj)/mx*100),neg=b.marj<0;
   const col=neg?'#ff8b8b':(b.marj<12?'var(--warn)':'#4fd44f'),cls=neg?'r':(b.marj<12?'a':'g');
   return `<div class="brow"><span class="bn">${esc(b.marka)}</span>
     <div class="btrack"><div class="bbar ${cls}" style="width:${w}%"></div></div>
     <span class="bp" style="color:${col}">${neg?'−':''}${pct(Math.abs(b.marj))}</span></div>`;}).join('');}

// ---- konsantrasyon (net gecikmiş kimde — canlıdan) ----
function cardsByH3(prefix){return [].slice.call(document.querySelectorAll('.card')).filter(c=>{const h=c.querySelector('h3');return h&&h.textContent.trim().indexOf(prefix)===0;});}
function wireConc(card,top,netTotal){
 if(!card)return;const hb=card.querySelector('.hb'),sub=card.querySelector('.sub'),note=card.querySelector('.hnote');
 if(!top||!top.length){if(hb)hb.innerHTML='<div style="color:var(--ink3);padding:10px 0">— canlı kaynak yok</div>';if(sub)sub.textContent='—';if(note)note.textContent='';return;}
 const pal=['rr','r','a','n','g','oth'];
 if(hb)hb.innerHTML=top.map((t,i)=>`<div class="hs ${pal[i%pal.length]}" style="flex:${Math.max(Number(t.net)||0,0.1)}">${esc(String(t.ad||'').split(' ')[0])}<small>${fmtM(t.net)}M</small></div>`).join('');
 if(sub)sub.textContent=fmtM(netTotal)+'M ₺ net · anlık';
 if(note){const two=top.slice(0,2).reduce((a,b)=>a+(Number(b.net)||0),0),sh=netTotal?Math.round(two/netTotal*100):null;
   note.innerHTML='<b>'+top.slice(0,2).map(t=>esc(String(t.ad||'').split(' ')[0])).join(' + ')+'</b> net gecikmenin '+(sh!=null?'~%'+sh:'—')+'’ı.';}}

// ================= CANLI VERİ UYGULA =================
function _set(id,txt){const e=document.getElementById(id);if(e)e.textContent=txt;}
function _setSmall(id,main,unit){const e=document.getElementById(id);if(e)e.innerHTML=main+(unit?` <small>${esc(unit)}</small>`:'');}
/* FINANS_SYNC_REAL_V1 — kokpitle aynı gerçek ERP senkron zamanı (/api/bi/yukle/durum en yeni ingested_at) */
function _syncFin(){
  var el=document.getElementById('finAsOf');if(!el)return;
  el.textContent='ERP senkron';
  fetch('/api/bi/yukle/durum',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){
    if(!d||!d.dosyalar||!d.dosyalar.length)return;
    var en=null;d.dosyalar.forEach(function(x){if(x&&x.son&&(!en||new Date(x.son)>new Date(en.son)))en=x;});
    if(!en||!en.son)return;
    var opt={timeZone:'Asia/Istanbul',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'};
    el.textContent='ERP senkron '+new Date(en.son).toLocaleString('tr-TR',opt);
  }).catch(function(){});
}
function applyFin(d){
  if(d&&typeof d==='object'){for(const k in FIN){const v=d[k];
    if(v!==null&&v!==undefined&&!(typeof v==='number'&&Number.isNaN(v)))FIN[k]=v;}}
  M.forEach(m=>{const f=GRIDMAP[m.k];if(f)m.v=f(FIN);});
  renderGrid();
  const dio=fmt0(FIN.dio),dso=fmt0(FIN.dso),dpo=fmt0(FIN.dpo),ccc=fmt0(FIN.ccc);
  _set('jDioG',dio+'g');_set('jDsoG',dso+'g');
  const jc=document.getElementById('jCcc');if(jc)jc.textContent=ccc;
  _set('jVerdict',(FIN.ccc!=null&&FIN.ccc<60)?'✓ Sağlıklı · 60 gün altı':(FIN.ccc!=null?'⚠ '+ccc+' gün · 60 gün üstü':'—'));
  const mbDio=document.getElementById('mbDio');if(mbDio){mbDio.style.flex=FIN.dio||0;mbDio.innerHTML=dio+'<small>stok (DIO)</small>';}
  const mbDso=document.getElementById('mbDso');if(mbDso){mbDso.style.flex=FIN.dso||0;mbDso.innerHTML=dso+'<small>alacak (DSO)</small>';}
  const mbDpo=document.getElementById('mbDpo');if(mbDpo){mbDpo.style.flex=FIN.dpo||0;mbDpo.innerHTML='−'+dpo+'<small>ödeme vaden (DPO) finanse eder</small>';}
  _set('eqDio','DIO '+dio);_set('eqDso','DSO '+dso);_set('eqDpo','DPO '+dpo);_set('eqCcc','CCC '+ccc+' gün');
  _set('eqDonem','· dönem: '+(FIN.donem||'—'));
  _set('jCap','Neden yalnız '+ccc+' gün? — brüt bağ '+fmt0((FIN.dio||0)+(FIN.dso||0))+' gün (stok '+dio+' + alacak '+dso+'), ama tedarikçiye '+dpo+' gün sonra ödediğin için döngü kısa kalıyor:');
  // her 100 ₺
  const maliyet=(FIN.brut_marj_pct==null)?null:Math.round((100-FIN.brut_marj_pct)*10)/10;
  const finPer=(FIN.finansman_yillik==null||FIN.net_satis_lastik==null||!FIN.net_satis_lastik)?null:Math.round((FIN.finansman_yillik/FIN.net_satis_lastik*100)*10)/10;
  const kalan=(FIN.brut_marj_pct==null||finPer==null)?null:Math.round((FIN.brut_marj_pct-finPer)*10)/10;
  const hb=document.getElementById('hb100');
  if(hb){if(maliyet==null){hb.innerHTML='<div style="color:var(--ink3);padding:10px 0">— canlı veri bekleniyor</div>';}
    else hb.innerHTML='<div class="hs smm" style="flex:'+maliyet+'">'+fmtM(maliyet)+'<small>maliyet</small></div>'+
      '<div class="hs fin" style="flex:'+(finPer||0.1)+'">'+fmtM(finPer)+'<small>finansman</small></div>'+
      '<div class="hs net" style="flex:'+(kalan||0.1)+'">'+fmtM(kalan)+'<small>kalan</small></div>';}
  const hn=document.getElementById('hnote100');
  if(hn){if(maliyet==null)hn.textContent='Canlı veri gelince her 100 ₺’nin dağılımı burada.';
    else hn.innerHTML='Her <b>100 ₺</b> satışın <b>'+fmtM(maliyet)+" ₺'si maliyet</b>. Kalan brüt kârın ("+fmtM(FIN.brut_marj_pct)+') da <b>'+fmtM(finPer)+" ₺'sini finansman</b> yiyor → cebinde <span class=\"accent\">≈"+fmtM(kalan)+' ₺</span>.';}
  // kârlılık grid
  _setSmall('g2NetSatis',fmtM(FIN.net_satis_lastik),'M ₺');
  _setSmall('g2Smm',fmtM(FIN.smm),'M ₺');
  _setSmall('g2BrutKar',fmtM(FIN.brut_kar),'M ₺');
  _set('g2BrutMarj',pct(FIN.brut_marj_pct));
  // alacak grid
  _setSmall('g3Alacak',fmtM(FIN.ticari_alacaklar),'M ₺');
  _setSmall('g3Gecikmis',fmtM(FIN.gecikmis),'M ₺');
  _setSmall('g3NetGecikmis',fmtM(FIN.net_gecikmis),'M ₺');
  _setSmall('g3FinYuk',fmtM(FIN.finansman_yillik),'M ₺');
  _setSmall('g3Dso',fmt0(FIN.dso),'gün');
  // stok grid
  _setSmall('g4Stok',fmtM(FIN.stok_lastik),'M ₺');
  _setSmall('g4Dio',fmt0(FIN.dio),'gün');
  _setSmall('g4Devir',(FIN.devir==null?'—':'≈'+fmtM(FIN.devir)),'×/yıl');
  _setSmall('g4Smm',fmtM(FIN.smm),'M ₺');
  try{_syncFin();}catch(e){}
