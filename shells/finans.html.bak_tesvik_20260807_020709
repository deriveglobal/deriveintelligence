}
function setLive(ok){
  const dot=document.getElementById('finLiveDot'),lv=document.getElementById('finLive'),fr=document.getElementById('finFresh');
  if(ok){if(lv)lv.textContent='canlı';if(dot)dot.style.background='var(--up)';}
  else{if(lv)lv.textContent='ulaşılamadı';if(dot)dot.style.background='var(--warn)';
    if(fr)fr.innerHTML='⚠ <span class="s" style="color:var(--warn)">canlı veriye ulaşılamadı</span>';}
}
// canlı kaynağı olmayan / anlatı bloklarını DOM’dan kaldır (hardcoded sayı bırakmamak için)
function _stripNarrative(){
  ['.econ','.converse','#drawer','.heartbeat','.card.laws','.card.discover'].forEach(sel=>{
    document.querySelectorAll(sel).forEach(n=>n.remove());});
  // canlı kaynağı olmayan görsel kartlar
  ['Alacak yaşlandırması','Lastik stoğu hangi markada?','Stok ne kadar hızlı dönüyor?'].forEach(h=>{
    cardsByH3(h).forEach(c=>c.remove());});
  // konsantrasyon kartlarını canlı gelene kadar boşalt (statik ROTA/YEDİ sayıları FLASH etmesin)
  cardsByH3('Net gecikmiş').forEach(c=>{const hb=c.querySelector('.hb'),sub=c.querySelector('.sub'),note=c.querySelector('.hnote');
    if(hb)hb.innerHTML='<div style="color:var(--ink3);padding:10px 0">…</div>';if(sub)sub.textContent='—';if(note)note.textContent='';});
  // boşalan "Görsel okuma / İzliyor" bölümlerini temizle
  document.querySelectorAll('.learn').forEach(l=>{if(!l.querySelector('.card')){const prev=l.previousElementSibling;if(prev&&prev.classList.contains('sec'))prev.remove();l.remove();}});
}
function _rich(oda){
  _stripNarrative();
  // trend — brüt marj 12 ay
  if(oda&&oda.trend&&oda.trend.length){
    TREND=oda.trend.map(x=>x&&x.marj!=null?Number(x.marj):null);
    MO=oda.trend.map(x=>monLabel(x&&x.ay));
    const tc=cardsByH3('Nakit döngüsü')[0]||document.querySelector('.card.trend');
    if(tc){const h=tc.querySelector('h3'),s=tc.querySelector('.sub');if(h)h.textContent='Brüt marj — 12 ay trendi';if(s)s.textContent='% · yüksek iyi';}
    drawTrend();
  }else{TREND=[];MO=[];drawTrend();}
  // marka
  renderBrands(oda&&oda.marka);
  // konsantrasyon (iki kart)
  const netTotal=oda&&oda.gecikmis?oda.gecikmis.net:null,top=oda&&oda.gecikmis?oda.gecikmis.top:null;
  cardsByH3('Net gecikmiş').forEach(c=>wireConc(c,top,netTotal));
  // zaman özeti — aktif çipe göre (varsayılan 12 ay)
  const _act=document.querySelector('#tchips button.on');
  setWin(_act?_act.dataset.w:'12');
}
function loadFin(win){win=win||'12';
  fetch('/api/bi/finans/oda?win='+encodeURIComponent(win),{headers:{'Accept':'application/json'},credentials:'same-origin'})
   .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
   .then(j=>{const oda=(j&&j.data&&typeof j.data==='object')?j.data:j;window.ODA=oda;
     const c=oda.core||{},g=oda.gecikmis||{},st=oda.stok||{};
     const mapped={
       as_of:oda.as_of,
       net_satis_lastik:c.net_satis_lastik,ciro_sirket:c.ciro_sirket,smm:c.smm,brut_kar:c.brut_kar,
       brut_marj_pct:c.marj_pct,ticari_alacaklar:c.ticari_alacaklar,ticari_borclar:c.ticari_borclar,
       net_gecikmis:g.net,gecikmis:g.brut,finansman_yillik:c.finansman_yil,
       dso:c.dso,dio:c.dio,dpo:c.dpo,ccc:c.ccc,twc:c.twc,bagli_sermaye_pct:c.bagli_sermaye_pct,
       devir:c.devir,stok_lastik:st.toplam};
     applyFin(mapped);_rich(oda);setLive(true);
     try{ /* FINANS_WIN_CLIENT_V1 */
       const sz=oda.sizinti||{},ot=(oda.gecikmis||{}).olculen||{},ol=(oda.stok||{}).olu||{},sp=(oda.stok||{}).siparis||{};
       _setSmall('gSizinti',(sz.tutar==null?'—':fmtM(sz.tutar)),'M ₺');
       _setSmall('gOlculen',(ot.gun==null?'—':fmt0(ot.gun)),'gün');
       _setSmall('gOluStok',(ol.deger==null?'—':fmtM(ol.deger)),'M ₺');
       const _lbl=_WLBL[win]||win;
       ['g2NetSatis','g2Smm','g2BrutKar','g2BrutMarj','gSizinti'].forEach(id=>{const c=document.getElementById(id);if(!c)return;const card=c.closest('.m');if(!card)return;card.querySelectorAll('.meta .r').forEach(r=>{const t=r.querySelector('.t');if(t&&t.textContent.trim()==='Dönem'){const x=r.querySelector('.x');if(x)x.textContent=_lbl;}});});
       setWin(win);
     }catch(e){}
   })
   .catch(()=>{setLive(false);});
}
applyFin(FIN);
_stripNarrative();
loadFin();
