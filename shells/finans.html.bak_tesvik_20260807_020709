function monLabel(s){if(!s)return'';const m=+String(s).split('-')[1];return['','Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'][m]||s;}
function drawTrend(){const svg=document.getElementById('trendsvg');if(!svg)return;
  const pts=[];TREND.forEach((v,i)=>{if(v!==null&&v!==undefined&&isFinite(v))pts.push({i:i,v:Number(v)});});
  if(pts.length<2){svg.innerHTML='<text x="12" y="90" fill="var(--ink3)" font-size="12">— canlı trend yok</text>';return;}
  const n=TREND.length,W=560,H=172,pl=8,pr=8,pt=14,pb=24;
  let mn=Math.min(...pts.map(p=>p.v)),mx=Math.max(...pts.map(p=>p.v));
  if(mn===mx){mn-=1;mx+=1;}const pad=(mx-mn)*0.15;mn-=pad;mx+=pad;
  const iw=W-pl-pr,ih=H-pt-pb,X=i=>pl+i*(iw/((n-1)||1)),Y=v=>pt+ih-((v-mn)/((mx-mn)||1))*ih;
  let lab='';for(let i=0;i<n;i++)lab+=`<text x="${X(i)}" y="${H-6}" fill="var(--ink2)" font-size="10" text-anchor="middle">${esc(MO[i]||'')}</text>`;
  const path=pts.map((p,k)=>`${k?'L':'M'}${X(p.i)},${Y(p.v)}`).join(' ');
  const area=`M${X(pts[0].i)},${H-pb} `+pts.map(p=>`L${X(p.i)},${Y(p.v)}`).join(' ')+` L${X(pts[pts.length-1].i)},${H-pb}Z`;
  const dots=pts.map(p=>`<circle cx="${X(p.i)}" cy="${Y(p.v)}" r="3" fill="var(--page)" stroke="var(--accent)" stroke-width="2"/>`).join('');
  svg.innerHTML=`<defs><linearGradient id="ag" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".22"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
    <line class="cross" id="cx" x1="0" y1="${pt}" x2="0" y2="${H-pb}"></line><path d="${area}" fill="url(#ag)"/><path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2"/>${dots}${lab}<rect x="0" y="0" width="${W}" height="${H}" fill="transparent" id="hit"/>`;
  const hit=svg.querySelector('#hit'),cx=svg.querySelector('#cx'),tip=document.getElementById('trendtip');
  if(hit)hit.onmousemove=e=>{const r=svg.getBoundingClientRect();let i=Math.round(((e.clientX-r.left)/r.width*W-pl)/(iw/((n-1)||1)));
    i=Math.max(0,Math.min(n-1,i));const v=TREND[i];if(v==null||!isFinite(v))return;
    cx.setAttribute('x1',X(i));cx.setAttribute('x2',X(i));cx.style.opacity=1;
    if(tip){tip.style.opacity=1;tip.style.left=(X(i)/W*r.width)+'px';tip.style.top=(Y(v)/H*r.height)+'px';tip.innerHTML=`${esc(MO[i]||'')} · <b>${pct(v)}</b>`;}};
  if(hit)hit.onmouseleave=()=>{if(cx)cx.style.opacity=0;if(tip)tip.style.opacity=0;};}

// ---- impact simulator (canlı · FIN-güdümlü) ----
let _simUpd=null;
function initSim(){
 const $=id=>document.getElementById(id),sDio=$('sDio'),sDso=$('sDso'),sDpo=$('sDpo');
 if(!sDio||!sDso||!sDpo)return;
 if(FIN.smm==null||FIN.net_satis_lastik==null||FIN.dio==null||FIN.dso==null||FIN.dpo==null){
   ['vDio','vDso','vDpo','cccOut','twcOut','finOut','freedV'].forEach(id=>{const e=$(id);if(e)e.textContent='—';});
   const t=$('tang');if(t)t.textContent='canlı veri bekleniyor…';return;}
 const D_SMM=FIN.smm*1e6/365,D_SALES=FIN.net_satis_lastik*1e6/365,RATE=FIN.finansman_orani_pct/100,
       B={dio:FIN.dio,dso:FIN.dso,dpo:FIN.dpo};
 const twcOf=d=>d.dso*D_SALES+d.dio*D_SMM-d.dpo*D_SMM,baseTwc=twcOf(B),baseCcc=B.dio+B.dso-B.dpo;
 const MM=x=>Math.round(x/1e6).toLocaleString('tr-TR');
 sDio.value=B.dio;sDso.value=B.dso;sDpo.value=B.dpo;
 function dlt(el,d,u,low){if(!el)return;if(Math.abs(d)<0.5){el.textContent='';el.className='dlt';return;}
   const good=low?d<0:d>0;el.textContent=(d>0?'▲ +':'▼ ')+Math.abs(Math.round(d))+u;el.className='dlt '+(good?'good':'bad');}
 function upd(){const dio=+sDio.value,dso=+sDso.value,dpo=+sDpo.value;
   $('vDio').textContent=dio;$('vDso').textContent=dso;$('vDpo').textContent=dpo;
   const ccc=dio+dso-dpo,twc=twcOf({dio,dso,dpo}),freed=baseTwc-twc,saving=freed*RATE;
   $('cccOut').textContent=ccc;$('twcOut').textContent=MM(twc);
   $('finOut').textContent=(saving>=0?'+':'−')+MM(Math.abs(saving));
   $('freedV').textContent=(freed>=0?'+':'−')+MM(Math.abs(freed));
   dlt($('cccD'),ccc-baseCcc,'g',true);dlt($('twcD'),(twc-baseTwc)/1e6,'M',true);
   const t=$('tang');
   if(freed>30e6)t.innerHTML=`≈ <b style="color:var(--accent)">${MM(freed)}M ₺</b> serbest kalır`;
   else if(freed>1e6)t.innerHTML=`≈ ${MM(freed)}M ₺ serbest · yıllık ~${MM(saving)}M finansman tasarrufu`;
   else if(freed<-1e6)t.innerHTML=`⚠ ${MM(-freed)}M ₺ daha fazla sermaye bağlanır`;
   else t.textContent='bugünkü durum';
   const mx=baseTwc*1.35;$('vfill').style.width=Math.min(100,twc/mx*100)+'%';
   $('vfree').style.width=(freed>0?freed/mx*100:0)+'%';}
 _simUpd=upd;
 if(!initSim._bound){
   [sDio,sDso,sDpo].forEach(s=>s.addEventListener('input',()=>_simUpd&&_simUpd()));
   const rst=$('simReset');if(rst)rst.addEventListener('click',()=>{sDio.value=FIN.dio;sDso.value=FIN.dso;sDpo.value=FIN.dpo;_simUpd&&_simUpd();});
   initSim._bound=true;
 }
 upd();
}

