      <div style="font-weight:600;font-size:13px;margin-bottom:6px;color:#475569;border-bottom:1px solid #e2e8f0;padding-bottom:6px">Teklif Kalemleri</div>
      <div id="tf-kalemler-satirlar"></div>
    </div>

    <!-- Ürün arama typeahead -->
