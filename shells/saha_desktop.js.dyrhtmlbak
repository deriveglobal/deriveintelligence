/* TZ_ISTANBUL_V1 */
// shells/saha_desktop.js — Derive Saha (MASAÜSTÜ) · ayrı modül
// ─────────────────────────────────────────────────────────────────────────────
// Mobil shells/saha.js'e HİÇ dokunulmaz. Bu modül yalnız masaüstünde yüklenir
// (app.js: !_nativeMobil → import("/shells/saha_desktop.js")).
// Export: initSahaDesktop(container, me, sub, { authHeaders, onExit, onSwitchModule })
//
// Yetkilendirme mobil ile AYNI:
//   role  = (platform_owner || moduleRole==='admin') ? 'admin' : moduleRole==='manager' ? 'manager' : 'rep'
//   isOwner = tenantRole==='platform_owner'  (yalnız Sistem/telemetri)
//   araçlar = /api/saha/araclarim grant  (Ebat/Müşteri Kartı)
//   veri kapsamı = sunucu-tarafı, Bearer token (rep kendi verisi). Tek istemci
//   kaldıracı: semsiye → tipQS() (&tip=TUKETICI|TICARI).
// ─────────────────────────────────────────────────────────────────────────────

let S = null;

export function initSahaDesktop(container, me, sub, opts = {}) {
  sub = sub || {};
  const headers = opts.authHeaders || (() => {
    const t = localStorage.getItem("platformSessionToken") || "";
    return t ? { Authorization: "Bearer " + t } : {};
  });
  const role = (me.tenantRole === "platform_owner" || sub.moduleRole === "admin") ? "admin"
    : (sub.moduleRole === "manager" ? "manager" : "rep");
  const isOwner = me.tenantRole === "platform_owner";
  const isYonetim = String(me.email || "").toLowerCase() === "yonetim@krb.com.tr"; /* REP_AKTIVITE_UI_V1 */

  S = {
    container, me, sub, role, isOwner, isYonetim, headers,
    onExit: typeof opts.onExit === "function" ? opts.onExit : () => {},
    canExit: opts.canExit !== false,      // BI'sı olmayan (rep/saha-only) kullanıcıda "‹ Kokpit" gizlenir
    onSwitchModule: typeof opts.onSwitchModule === "function" ? opts.onSwitchModule : null,
    semsiye: "",           // "" | TUKETICI | TICARI
    view: null,
    araclar: [],
    q: ""                  // arama metni (müşteriler)
  };
  if (role === "rep" && sub.permissions && sub.permissions.saha_tip) {
    S.semsiye = String(sub.permissions.saha_tip).toUpperCase();
  }

  injectStyles();
  container.innerHTML = layout();
  wire();
  loadAraclar();

  // BI hub derin bağlantısı (app.js kuyruğu): ilgili sekmeye git
  window.__sahaGit = function (tip) {
    const v = tip === "ZIYARET" ? "ziyaretler" : (tip === "TEKLIF" || tip === "ISKONTO") ? "iskonto" : "bugun";
    go(v);
  };

  go("bugun");
}

// ── yardımcılar ──────────────────────────────────────────────────────────────
function esc(s) {
  return String(s == null ? "" : s).replace(/[&<>"']/g, c =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}
function money(n) { return new Intl.NumberFormat("tr-TR").format(Math.round(Number(n) || 0)) + " ₺"; }
function kisa(n) {
  n = Number(n) || 0;
  return n >= 1e6 ? (n / 1e6).toFixed(1).replace(".", ",") + "M"
    : n >= 1e3 ? Math.round(n / 1e3) + "K" : String(Math.round(n));
}
function tipQS() { return S.semsiye ? "&tip=" + S.semsiye : ""; }
function main() { return S.container.querySelector("#dk-main"); }

async function api(path, options = {}) {
  const res = await fetch(path, {
    ...options,
    headers: { "Content-Type": "application/json", ...S.headers(), ...(options.headers || {}) }
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || ("İstek başarısız (" + res.status + ")"));
  return data;
}

async function loadAraclar() {
  try {
    const { araclar = [] } = await api("/api/saha/araclarim");
    S.araclar = araclar;
    renderNav(); // araç grubu görünürlüğü güncellensin
  } catch { /* sessiz */ }
}

// ── navigasyon modeli (rol-kapılı) ───────────────────────────────────────────
function navGroups() {
  const mgmt = ["manager", "admin"].includes(S.role);
  const g = [
    ["Günlük İş", [
      ["bugun", "🏠", "Bugün"], ["ziyaretler", "📋", "Ziyaretler"], ["plan", "🗓️", "Plan"],
      ["musteriler", "🏪", "Müşteriler"], ["iskonto", "💰", "Teklif"],
      ["notlarim", "📝", "Notlarım"], ["asistan", "🤖", "Rep-Brain"]
    ]],
    ["Pazar", [["piyasa", "🏷️", "Piyasa"], ["rakip", "📡", "Rakip Radar"]]],
    ["İletişim", [["duyurular", "📢", "Duyurular"], ["mesajlar", "💬", "Mesajlar"], ["oneriler", "💡", "Öneriler"]]]
  ];
  if (mgmt) g.push(["Analiz", [["rapor", "📊", "Rapor"], ["harita", "🗺️", "Harita"], ["kokpit", "📈", "Kokpit"], ["ceo", "🧠", "CEO Asistan"]]]);
  const yon = [];
  /* EKIP_TAB_KALDIR_V1 — Ekip, Yönetim konsoluna tasindi; saha nav girisi kaldirildi */
  /* EKIP_DENETIM_TASI_V1 — Aktivite + Sistem, Yönetim konsoluna tasindi (saha nav girisi kaldirildi) */
  if (yon.length) g.push(["Yönetim", yon]);
  const arac = [];
  if (S.araclar.includes("ebat_kart")) arac.push(["ebatkart", "📐", "Ebat Kartı"]);
  if (S.araclar.includes("musteri_kart")) arac.push(["musterikart", "🧾", "Müşteri Kartı"]);
  if (arac.length) g.push(["Araçlar", arac]);
  /* EKIP_DEPT_GATE_V1 — nav departments[] ile additive kisilir; bos ise role fallback; ebat/musteri araclar */
  const _dept = (S.sub && S.sub.permissions && Array.isArray(S.sub.permissions.departments)) ? S.sub.permissions.departments : [];
  const _dmap = { asistan: "rep-brain", iskonto: "teklif" };
  const _dok = (id) => (id === "ebatkart" || id === "musterikart") ? true : (!_dept.length ? true : _dept.includes(_dmap[id] || id));
  return g.map(gr => [gr[0], gr[1].filter(it => _dok(it[0]))]).filter(gr => gr[1].length);
}
const TITLE = {
  bugun: "Bugün", ziyaretler: "Ziyaretler", plan: "Plan", musteriler: "Müşteriler",
  iskonto: "Teklif", notlarim: "Notlarım", asistan: "Rep-Brain Asistan",
  piyasa: "Piyasa Dosyaları", rakip: "Rakip Radar", duyurular: "Duyurular",
  mesajlar: "Mesajlar", oneriler: "Öneriler", rapor: "Rapor", harita: "Harita",
  kokpit: "Kokpit", ceo: "CEO Asistan", temsilciler: "Ekip", sistem: "Sistem",
  ebatkart: "Ebat Kartı", musterikart: "Müşteri Kartı",
  "rep-aktivite": "Temsilci Aktivite"
};
const SEG_VIEW = new Set(["bugun", "ziyaretler", "plan", "musteriler", "rapor", "harita", "kokpit"]);
const KAYIP_NEDEN = { FIYAT: "Fiyat", VADE: "Vade", STOK: "Stok", ILISKI: "İlişki", DIGER: "Diğer", BELIRTILMEDI: "Belirtilmedi" };
const KAYNAK_ETK = { ZIYARET: "🚶 Ziyaret", TELEFON: "📞 Telefon", WHATSAPP: "💬 WhatsApp", EMAIL: "✉️ E-posta", DIGER: "Diğer" };
function teklifPill(durum) {
  return ({
    TASLAK: ["Taslak", "p-mut"], ONAY_BEKLIYOR: ["Onay Bekliyor", "p-warn"], ONAYLANDI: ["Onaylandı", "p-info"],
    SUNULDU: ["Sunuldu", "p-viol"], KAZANILDI: ["Kazanıldı ✓", "p-ok"], KAYBEDILDI: ["Kaybedildi", "p-crit"], IPTAL: ["İptal", "p-mut"]
  })[durum] || [durum, "p-mut"];
}
const SEARCH_VIEW = new Set(["musteriler", "ziyaretler"]);
// müşteri/ziyaret durum kodu → [etiket, pill sınıfı] (mobil DURUM_ETIKET ile aynı anlam)
const DURUM = {
  AKTIF_MUSTERI: ["Aktif", "p-ok"], PASIF_NOKTA: ["Pasif", "p-mut"], RISKLI_NOKTA: ["Riskli", "p-crit"]
};

// ── iskelet ──────────────────────────────────────────────────────────────────
function layout() {
  const rolEt = S.role === "admin" ? "GM" : S.role === "manager" ? "Müdür" : "Saha";
  const ad = S.me.name || S.me.email || "";
  const bas = (ad.split(" ").map(x => x[0]).join("").slice(0, 2) || "S").toUpperCase();
  return `
  <div class="dk-app">
    <aside class="dk-side">
      <div class="dk-brand"><span class="dk-logo">D</span><div><b>Derive</b><small>Saha · Intelligence</small></div></div>
      <nav class="dk-nav" id="dk-nav"></nav>
      <div class="dk-user">
        <span class="dk-avatar">${esc(bas)}</span>
        <div class="dk-nm"><b>${esc(ad)}</b><small>${rolEt}</small></div>
        <button class="dk-out" id="dk-cikis" title="Çıkış">⏏</button>
      </div>
    </aside>
    <div class="dk-col">
      <header class="dk-top">
        <button class="dk-back" id="dk-bi">‹ Kokpit</button>
        <h1 id="dk-title">Bugün</h1>
        <div class="dk-seg" id="dk-seg">
          <button data-s="" class="on">Tümü</button>
          <button data-s="TUKETICI">Tüketici</button>
          <button data-s="TICARI">Ticari</button>
        </div>
        <div class="dk-sp"></div>
      </header>
      <div class="dk-content"><main id="dk-main"><div class="dk-load">Yükleniyor…</div></main></div>
    </div>
    <div id="dk-modal"></div>
  </div>`;
}

function wire() {
  const biBtn = S.container.querySelector("#dk-bi");
  if (S.canExit) biBtn.addEventListener("click", () => S.onExit());
  else biBtn.style.display = "none";
  S.container.querySelector("#dk-cikis").addEventListener("click", async () => {
    try { await fetch("/api/auth/logout", { method: "POST", headers: S.headers() }); } catch {}
    ["krbCurrentUserEmail", "krbSession", "currentPlatformUser", "platformSessionToken"].forEach(k => localStorage.removeItem(k));
    window.location.href = "/?app=1";
  });
  S.container.querySelectorAll("#dk-seg button").forEach(b => b.addEventListener("click", () => {
    S.container.querySelectorAll("#dk-seg button").forEach(x => x.classList.toggle("on", x === b));
    S.semsiye = b.dataset.s;
    // Harita'da tam re-render yerine yerinde yenileme (drawer açık kalsın, tarih/preset sıfırlanmasın)
    if (S.view === "rapor" && typeof S._raporSeg === "function") { S._raporSeg(); return; }  /* RAPOR_KONTROL_DK_V1 */
    if (S.view === "harita" && typeof S._haritaSeg === "function") { S._haritaSeg(); return; }
    if (S.view) go(S.view);
  }));
  if (!["manager","admin"].includes(S.role)) { const _sg0 = S.container.querySelector("#dk-seg"); if (_sg0) _sg0.style.display = "none"; }  /* RAPOR_KONTROL_DK_V2 */
  renderNav();
}

function renderNav() {
  const el = S.container.querySelector("#dk-nav");
  if (!el) return;
  el.innerHTML = "";
  navGroups().forEach(([gname, items]) => {
    const g = document.createElement("div"); g.className = "dk-grp";
    g.innerHTML = `<div class="dk-grp-h">${esc(gname)}</div>`;
    items.forEach(([id, ico, lbl]) => {
      const b = document.createElement("button");
      b.className = "dk-item" + (id === S.view ? " on" : "");
      b.dataset.dest = id;
      b.innerHTML = `<span class="ic">${ico}</span><span class="lbl">${esc(lbl)}</span>`;
      b.addEventListener("click", () => go(id));
      g.appendChild(b);
    });
    el.appendChild(g);
  });
}

function go(dest) {
  S.view = dest;
  { const _sg = S.container.querySelector("#dk-seg"); if (_sg) _sg.style.display = ["manager","admin"].includes(S.role) ? "" : "none"; }  /* RAPOR_KONTROL_DK_V2 */
  if (dest !== "rapor") S._raporSeg = null;
  S.q = "";                 // arama kutuları görünüm-içi; geçişte sıfırla
  if (dest !== "harita") S._haritaSeg = null; // Harita'dan çıkınca segment-yenileyiciyi bırak
  S.container.querySelectorAll(".dk-item").forEach(b => b.classList.toggle("on", b.dataset.dest === dest));
  const t = S.container.querySelector("#dk-title"); if (t) t.textContent = TITLE[dest] || dest;
  S.container.querySelector("#dk-seg").style.display = SEG_VIEW.has(dest) ? "" : "none";
  const m = main(); m.scrollTop = 0; m.style.padding = ""; m.innerHTML = `<div class="dk-load">Yükleniyor…</div>`;
  const fn = VIEWS[dest] || VIEWS._todo;
  Promise.resolve().then(() => fn(m, dest)).catch(err => {
    m.innerHTML = `<div class="dk-card"><div class="dk-empty"><div class="ic">⚠</div><h3>Yüklenemedi</h3><p>${esc(err.message || err)}</p></div></div>`;
  });
}

// ── görünümler ───────────────────────────────────────────────────────────────
const VIEWS = {};

VIEWS.temsilciler = async (m) => {  /* EKIP_MATRIS_V1 — Ekip erisim matrisi (okuma; duzenleme S2) */
  const canManage = S.isOwner || S.isYonetim || (S.me && S.me.tenantRole === "tenant_admin");
  if (!canManage) { m.innerHTML = `<div class="dk-card"><div class="dk-empty"><div class="ic">🔒</div><h3>Erişim yok</h3><p>Ekip yönetimi yalnız tenant yöneticisine açıktır.</p></div></div>`; return; }

  const CATALOG = [
    ["Saha", [["bugun","Bugün"],["ziyaretler","Ziyaretler"],["plan","Plan"],["musteriler","Müşteriler"],["musterikart","Müşteri Kartı"],["ebatkart","Ebat Kartı"],["iskonto","Teklif"],["notlarim","Notlarım"],["rep-brain","Rep-Brain"]]],
    ["Zeka & Pazar", [["harita","Harita"],["piyasa","Piyasa"],["rakip","Rakip"],["oneriler","Öneriler"]]],
    ["Yönetim & Analiz", [["rapor","Rapor"],["kokpit","Kokpit"],["ceo","CEO"],["rep-aktivite","Aktivite"]]],
    ["İletişim", [["duyurular","Duyurular"],["mesajlar","Mesajlar"]]],
    ["Sistem & Erişim", [["temsilciler","Ekip"],["sistem","Sistem"]]]
  ];
  const TOOLS = CATALOG.flatMap(g => g[1].map(t => t[0]));

  let users;
  try { users = await api("/api/tenant/users"); }
  catch (e) { m.innerHTML = `<div class="dk-card"><div class="dk-empty"><div class="ic">⚠</div><h3>Yüklenemedi</h3><p>${esc(e.message || e)}</p></div></div>`; return; }
  if (!Array.isArray(users)) users = [];

  const sahaOf = (u) => (u.module_access || []).find(x => x && x.module_id === "saha") || null;
  const rolPill = (r) => { const map = { admin:["Admin","p-info"], manager:["Müdür","p-viol"], rep:["Saha","p-mut"] }; const v = map[r] || ["—","p-mut"]; return `<span class="pill ${v[1]}">${esc(v[0])}</span>`; };
  const segLbl = (t) => ({ TUKETICI:"Tüketici", TICARI:"Ticari", KARMA:"Karma" }[String(t || "").toUpperCase()] || "Oto");
  const tRole = (tr) => tr === "tenant_admin" ? `<span class="pill p-ok" title="Tenant yöneticisi" style="margin-left:6px">👑</span>` : (tr === "platform_owner" ? `<span class="pill p-info" style="margin-left:6px">Platform</span>` : "");
  const dt = (ts) => ts ? new Date(ts).toLocaleDateString("tr-TR", { day:"2-digit", month:"2-digit", year:"2-digit" }) : "—";

  const STICKY = "position:sticky;left:0;z-index:1;box-shadow:1px 0 0 var(--cizgi)";
  const TH_TOOL = "padding:8px 5px;text-align:center;min-width:60px;white-space:normal;line-height:1.15";
  const grpTh = CATALOG.map(g => `<th colspan="${g[1].length}" style="text-align:center;background:var(--zemin-2)">${esc(g[0])}</th>`).join("");
  const toolTh = CATALOG.flatMap(g => g[1].map(t => `<th style="${TH_TOOL}" title="${esc(t[1])}">${esc(t[1])}</th>`)).join("");

  const row = (u) => {
    const sm = sahaOf(u);
    const perms = (sm && sm.permissions) || {};
    const has = new Set(Array.isArray(perms.departments) ? perms.departments : []);
    const active = sm ? sm.active !== false : false;
    const nm = u.full_name || u.name || u.email || "—";
    const cells = TOOLS.map(id => `<td style="text-align:center;padding:8px 5px">${has.has(id) ? `<span style="color:var(--yesil,#16a34a);font-weight:700">✓</span>` : `<span style="color:var(--tx-3)">·</span>`}</td>`).join("");
    return `<tr>
      <td style="${STICKY};background:var(--zemin-1);font-weight:600">${esc(nm)}${tRole(u.tenant_role)}<div style="font-size:11px;color:var(--tx-2);font-weight:400">${esc(u.email || "")}</div></td>
      <td>${sm ? rolPill(sm.module_role) : `<span class="pill p-mut">yok</span>`}</td>
      <td style="white-space:nowrap">${sm ? esc(segLbl(perms.saha_tip)) : "—"}</td>
      <td style="text-align:center">${active ? `<span style="color:var(--yesil,#16a34a)">●</span>` : `<span style="color:var(--tx-3)">○</span>`}</td>
      ${cells}
      <td style="white-space:nowrap;color:var(--tx-1)">${dt(u.last_login_at)}</td>
    </tr>`;
  };

  m.innerHTML = `
    <div class="dk-card" style="padding:0;overflow:hidden">
      <div class="dk-card-h" style="padding:16px 20px 10px"><h3>👥 Ekip — Erişim Matrisi</h3><span class="sub">${users.length} kullanıcı · saha modülü</span></div>
      <div style="overflow-x:auto">
        <table class="dk-t" style="min-width:100%">
          <thead>
            <tr>
              <th rowspan="2" style="${STICKY};background:var(--zemin-2)">Kullanıcı</th>
              <th rowspan="2">Rol</th>
              <th rowspan="2">Segment</th>
              <th rowspan="2" style="text-align:center">Aktif</th>
              ${grpTh}
              <th rowspan="2">Son giriş</th>
            </tr>
            <tr>${toolTh}</tr>
          </thead>
          <tbody>${users.length ? users.map(row).join("") : `<tr><td colspan="99"><div class="dk-empty-s">Kullanıcı yok</div></td></tr>`}</tbody>
        </table>
      </div>
      <div style="padding:10px 20px;color:var(--tx-2);font-size:12px;border-top:1px solid var(--cizgi)">Okuma görünümü · düzenleme sonraki adımda. <span style="color:var(--yesil,#16a34a);font-weight:700">✓</span> = erişimli alt-araç.</div>
    </div>`;
};


VIEWS.sistem = async (m) => { /* HATA_YONETIM_V1 — hata raporu (yonetim + platform_owner) */
  if (!S.isOwner && !S.isYonetim) { m.innerHTML = `<div class="dk-card"><div class="dk-empty"><div class="ic">🔒</div><h3>Erişim yok</h3><p>Bu bölüm yalnız yönetime özeldir.</p></div></div>`; return; }
  const gun = S._sisGun || 7;
  const d = await api("/api/saha/hata-raporu?gun=" + gun);
  const renk = { API_HATA:"#ef4444", JS_HATA:"#f97316", AG_HATA:"#8b5cf6", YAVAS_API:"#f59e0b", SESSIZ_HATA:"#6b7280" };
  const tipRow = (t) => `<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--cizgi)"><span style="background:${renk[t.tip]||"#64748b"};color:#fff;border-radius:4px;padding:2px 9px;font-size:11px;font-weight:700">${esc(t.tip)}</span><b style="font-size:18px">${t.sayi}</b></div>`;
  const epRow = (e) => `<div style="padding:7px 0;border-bottom:1px solid var(--cizgi);font-size:12px"><div style="font-family:monospace;color:var(--tx-1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(e.endpoint||"-")}</div><div style="display:flex;gap:14px;margin-top:2px"><span style="color:#f87171">${e.sayi} hata</span>${e.ort_ms?`<span style="color:#94a3b8">ort ${e.ort_ms}ms</span>`:""}</div></div>`;
  const uRow = (u) => `<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--cizgi);font-size:12px"><span>${esc(u.kullanici||"-")}</span><span style="color:#f87171;font-weight:600">${u.sayi}</span></div>`;
  const sRow = (h) => `<div style="padding:9px 0;border-bottom:1px solid var(--cizgi);font-size:12px"><div style="display:flex;justify-content:space-between;margin-bottom:3px"><span style="background:${renk[h.tip]||"#64748b"};color:#fff;border-radius:3px;padding:1px 7px;font-size:10px">${esc(h.tip)}</span><span style="color:#94a3b8">${new Date(h.ts).toLocaleString("tr-TR")}</span></div><div style="color:var(--tx-0);margin-bottom:2px">${esc(h.hata_mesaji||"-")}</div><div style="color:#94a3b8;font-family:monospace">${esc(h.endpoint||h.view_adi||"")}</div></div>`;
  const gbtn = (g,l) => `<button class="sis-g" data-g="${g}" style="border:1px solid var(--cizgi);background:${g===gun?"#2563eb":"transparent"};color:${g===gun?"#fff":"var(--tx-1)"};border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;margin-right:6px">${l}</button>`;
  m.innerHTML = `
    <div style="margin:2px 0 14px">${gbtn(1,"Bugün")}${gbtn(7,"7 gün")}${gbtn(30,"30 gün")}</div>
    <div class="dk-card"><div class="dk-card-h"><h3>🐛 Hata Özeti</h3><span class="sub">son ${gun} gün</span></div>${(d.ozet&&d.ozet.length)?d.ozet.map(tipRow).join(""):`<div class="dk-empty-s">Hata kaydı yok 🎉</div>`}</div>
    ${(d.endpoint_ozet&&d.endpoint_ozet.length)?`<div class="dk-card" style="margin-top:14px"><div class="dk-card-h"><h3>En Çok Hata Veren Endpoint</h3></div>${d.endpoint_ozet.slice(0,15).map(epRow).join("")}</div>`:""}
    ${(d.user_ozet&&d.user_ozet.length)?`<div class="dk-card" style="margin-top:14px"><div class="dk-card-h"><h3>Kullanıcı Bazlı</h3></div>${d.user_ozet.slice(0,15).map(uRow).join("")}</div>`:""}
    <div class="dk-card" style="margin-top:14px"><div class="dk-card-h"><h3>Son Hatalar</h3><span class="sub">${(d.son_hatalar||[]).length}</span></div>${(d.son_hatalar&&d.son_hatalar.length)?d.son_hatalar.slice(0,50).map(sRow).join(""):`<div class="dk-empty-s">Kayıt yok</div>`}</div>`;
  m.querySelectorAll(".sis-g").forEach(b => b.addEventListener("click", () => { S._sisGun = parseInt(b.dataset.g,10); go("sistem"); }));
};

VIEWS["rep-aktivite"] = async (m) => { /* REP_AKTIVITE_UI_V1 */
  if (!S.isYonetim) { m.innerHTML = `<div class="dk-card"><div class="dk-empty"><div class="ic">🔒</div><h3>Erisim yok</h3><p>Bu bolum yalniz yonetime ozeldir.</p></div></div>`; return; }
  const gun = S._aktGun || 7;
  const d = await api("/api/saha/rep-aktivite?gun=" + gun);
  const reps = d.repler || [];
  const online = reps.filter(r => r.online).length;
  const rel = (ts) => { if (!ts) return "—"; const s = Math.floor((Date.now() - new Date(ts).getTime())/1000); if (s<60) return "az once"; if (s<3600) return Math.floor(s/60)+" dk once"; if (s<86400) return Math.floor(s/3600)+" sa once"; return Math.floor(s/86400)+" gun once"; };
  const dt = (ts) => ts ? new Date(ts).toLocaleString("tr-TR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}) : "—";
  const odaAd = { bugun:"Bugun", ziyaretler:"Ziyaretler", musteriler:"Musteri", iskonto:"Teklif", rapor:"Rapor", plan:"Plan", "rep-brain":"Asistan", asistan:"Asistan", piyasa:"Piyasa", rakip:"Rakip", saha:"Saha", kokpit:"Kokpit", ceo:"CEO" };
  const gbtn = (g,l) => `<button class="ak-g" data-g="${g}" style="border:1px solid var(--cizgi);background:${g===gun?"#2563eb":"transparent"};color:${g===gun?"#fff":"var(--tx-1)"};border-radius:8px;padding:6px 14px;font-size:13px;font-weight:600;cursor:pointer;margin-right:6px">${l}</button>`;
  const row = (r) => `<tr style="border-bottom:1px solid var(--cizgi)">
    <td style="padding:10px 8px;white-space:nowrap"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${r.online?"#22c55e":"#94a3b8"};margin-right:8px"></span><b>${esc(r.ad)}</b></td>
    <td style="padding:10px 8px;color:var(--tx-1);white-space:nowrap">${dt(r.son_giris)}</td>
    <td style="padding:10px 8px;color:${r.online?"#16a34a":"var(--tx-1)"};white-space:nowrap">${r.online?"cevrimici":rel(r.son_aktivite)}</td>
    <td style="padding:10px 8px;text-align:center">${r.dk_bugun} dk</td>
    <td style="padding:10px 8px;text-align:center">${r.dk_hafta} dk</td>
    <td style="padding:10px 8px;text-align:center">${r.ziyaret}</td>
    <td style="padding:10px 8px;text-align:center;color:${r.hata>0?"#dc2626":"inherit"};font-weight:${r.hata>0?"700":"400"}">${r.hata}</td>
    <td style="padding:10px 8px;color:var(--tx-1);white-space:nowrap">${r.en_cok_oda?esc(odaAd[r.en_cok_oda]||r.en_cok_oda):"—"}</td>
  </tr>`;
  m.innerHTML = `
    <div class="dk-card">
      <div class="dk-card-h"><h3>📡 Temsilci Aktivite</h3><span class="sub">${online}/${reps.length} cevrimici</span></div>
      <div style="margin:6px 0 14px">${gbtn(1,"Bugun")}${gbtn(7,"7 gun")}${gbtn(30,"30 gun")}<span style="color:#94a3b8;font-size:12px;margin-left:8px">ziyaret/hata penceresi</span></div>
      ${reps.length ? `<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead><tr style="border-bottom:2px solid var(--cizgi);text-align:left;color:#94a3b8;font-size:12px">
          <th style="padding:8px">Temsilci</th><th style="padding:8px">Son giris</th><th style="padding:8px">Son islem</th>
          <th style="padding:8px;text-align:center">Bugun</th><th style="padding:8px;text-align:center">7 gun</th>
          <th style="padding:8px;text-align:center">Ziyaret</th><th style="padding:8px;text-align:center">Hata</th><th style="padding:8px">En cok</th>
        </tr></thead><tbody>${reps.map(row).join("")}</tbody></table></div>` : `<div class="dk-empty-s">Kayit yok</div>`}
    </div>`;
  m.querySelectorAll(".ak-g").forEach(b => b.addEventListener("click", () => { S._aktGun = parseInt(b.dataset.g, 10); go("rep-aktivite"); }));
};

// BUGÜN — canlı /api/saha/bugun (mobil ile birebir sözleşme)
VIEWS.bugun = async (m) => {
  const d = await api("/api/saha/bugun");
  const ziyaretler = d.ziyaretler || [];
  const duyurular = d.duyurular_okunmamis || [];
  const teklifler = d.teklifler || [];
  const hatirlatmalar = d.hatirlatmalar || [];
  const repSay = d.rep_sayisi || 0;
  const tarih = d.bugun
    ? new Date(d.bugun + "T12:00:00").toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul", weekday: "long", day: "numeric", month: "long" })
    : "";
  const teklifTop = teklifler.reduce((a, t) => a + (Number(t.toplam_tutar) || 0), 0);
  const onemPill = { ACIL: "p-crit", YUKSEK: "p-warn", NORMAL: "p-info" };
  const onemEt = { ACIL: "🚨 ACİL", YUKSEK: "⚠️ Önemli", NORMAL: "📢 Duyuru" };

  const gorulmemis = ziyaretler.filter(z => !z.gordum);  /* BUGUN_INBOX_V1: gorulmus ziyaretler Bugun'den dusr, Ziyaretler'de kalir */
  const ziyBody = gorulmemis.length
    ? gorulmemis.map(z => `<div class="dk-row" data-zid="${esc(z.id)}" style="cursor:pointer">
        <div style="flex:1;min-width:0"><div class="firm">${esc(z.musteri_adi || "")}</div>
        ${z.adres ? `<div class="sub2">📍 ${esc(z.adres)}</div>` : ""}</div>
        ${z.rep_adi ? `<span class="sub2">👤 ${esc(z.rep_adi)}</span>` : `<span class="pill p-info">Check-in</span>`}</div>`).join("")
    : `<div class="dk-empty-s">Tüm bugünkü ziyaretler görüldü ✓</div>`;

  const teklifBody = teklifler.length
    ? teklifler.slice(0, 6).map(t => `<div class="dk-row">
        <div style="flex:1;min-width:0"><div class="firm">${esc(t.musteri_adi || "")}</div>
        ${t.rep_adi ? `<div class="sub2">👤 ${esc(t.rep_adi)}</div>` : ""}</div>
        <b class="num" style="color:var(--turuncu)">${money(t.toplam_tutar)}</b></div>`).join("")
    : `<div class="dk-empty-s">Bekleyen teklif yok</div>`;

  const duyBody = duyurular.length
    ? duyurular.map(x => `<div class="dk-row" data-did="${esc(x.id)}" style="cursor:pointer">
        <span class="pill ${x.tip === "PIYASA" ? "p-info" : (onemPill[x.onem] || "p-info")}">${x.tip === "PIYASA" ? "📊 Piyasa" : (onemEt[x.onem] || "📢")}</span>
        <div style="flex:1;min-width:0"><div class="firm">${esc(x.baslik)}</div>
        <div class="sub2">${esc(x.yazan_adi || "")} · 👁 ${x.okuyan_sayisi || 0}${repSay ? "/" + repSay : ""}</div></div>
        ${!x.okundu ? `<span class="pill p-mut">● Yeni</span>` : ""}</div>`).join("")
    : `<div class="dk-empty-s">Okunmamış duyuru yok ✓</div>`;

  const hatBlock = hatirlatmalar.length ? `
    <div class="dk-card" style="margin-bottom:16px">
      <div class="dk-card-h"><h3>⏰ Hatırlatmalar</h3><span class="sub">${hatirlatmalar.length}</span></div>
      ${hatirlatmalar.map(n => `<div class="dk-row">
        <div style="flex:1;min-width:0"><div>${esc((n.icerik || "").slice(0, 90))}</div>
        <div class="sub2">${n.musteri ? "🏢 " + esc(n.musteri) : ""}${n.hatirlatma_tarihi ? " · ⏰ " + esc(n.hatirlatma_tarihi) : ""}</div></div></div>`).join("")}
    </div>` : "";

  m.innerHTML = `
    <div class="dk-wrap">
      ${tarih ? `<div class="dk-datehead">${esc(tarih)}</div>` : ""}
      <div class="dk-grid dk-g4" style="margin-bottom:16px">
        ${stat("Bugünkü Ziyaret", String(ziyaretler.length), gorulmemis.length ? gorulmemis.length + " görülmemiş" : "hepsi görüldü ✓")}
        ${stat("Açık Teklif", String(teklifler.length), money(teklifTop) + " pipeline")}
        ${stat("Okunmamış Duyuru", String(duyurular.length), duyurular.length ? "yeni" : "güncel ✓")}
        ${stat("Mesaj", String(d.mesaj_okunmamis || 0), (d.mesaj_okunmamis ? "yeni" : "güncel ✓"))}
      </div>
      ${hatBlock}
      <div class="dk-grid dk-g2">
        <div class="dk-card"><div class="dk-card-h"><h3>Bugünün Ziyaretleri</h3><span class="sub">${gorulmemis.length}</span></div>${ziyBody}</div>
        <div class="dk-card"><div class="dk-card-h"><h3>Bekleyen Teklifler</h3><span class="sub">${teklifler.length}</span></div>${teklifBody}</div>
      </div>
      <div class="dk-card" style="margin-top:16px"><div class="dk-card-h"><h3>Okunmamış Duyurular</h3><span class="sub">${duyurular.length}</span></div>${duyBody}</div>
    </div>`;

  m.querySelectorAll("[data-zid]").forEach(el => el.addEventListener("click", async () => {  /* BUGUN_ZIYARET_TIKLA_V1 */
    const zid = el.dataset.zid;
    let z = (S.ziyaretler || []).find(x => String(x.id) === String(zid));
    if (!z) {
      try {
        const { ziyaretler: full = [] } = await api(`/api/saha/ziyaretler?durum=TAMAMLANDI${tipQS()}`);
        S.ziyaretler = full;
        z = full.find(x => String(x.id) === String(zid));
      } catch { /* sessiz */ }
    }
    if (!z) {
      const b = ziyaretler.find(x => String(x.id) === String(zid));
      if (b) z = { id: b.id, firma: b.musteri_adi, ziyaret_tarihi: b.ziyaret_tarihi, rep_adi: b.rep_adi };
    }
    if (z) { const _card = el.closest(".dk-card"); ziyaretDetay(z); el.remove(); if (_card) { const _kalan = _card.querySelectorAll("[data-zid]").length; const _sub = _card.querySelector(".dk-card-h .sub"); if (_sub) _sub.textContent = String(_kalan); if (!_kalan && !_card.querySelector(".dk-empty-s")) { const _e = document.createElement("div"); _e.className = "dk-empty-s"; _e.textContent = "Tüm bugünkü ziyaretler görüldü ✓"; _card.appendChild(_e); } } } else go("ziyaretler");  /* BUGUN_INBOX_V1 */
  }));
  m.querySelectorAll("[data-did]").forEach(el => el.addEventListener("click", () => go("duyurular")));
};

// MÜŞTERİLER — canlı /api/saha/musteriler (sayfalı, q + tip; veri kapsamı token ile)
VIEWS.musteriler = async (m) => {
  const PAGE = 100;
  let offset = 0, items = [], hasMore = false;
  const url = (o) => `/api/saha/musteriler?q=${encodeURIComponent(S.q || "")}${tipQS()}&limit=${PAGE}&offset=${o}`;

  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-card" style="padding:0;overflow:hidden">
      <div class="dk-card-h" style="padding:14px 18px;margin:0;border-bottom:1px solid var(--cizgi);gap:12px">
        <h3>Müşteriler <span class="sub2" id="mus-say"></span></h3>
        <input class="dk-tsearch" id="mus-q" placeholder="🔍 firma, şehir, ilçe, ERP kodu, vergi no" value="${esc(S.q || "")}">
      </div>
      <div style="overflow-x:auto"><table class="dk-t">
        <thead><tr><th>Firma</th><th>Konum</th><th>ERP Kodu</th><th>Durum</th><th class="num">Ziyaret</th><th>Son Ziyaret</th><th>Teklif</th></tr></thead>
        <tbody id="mus-tb"><tr><td colspan="7" class="dk-empty-s">Yükleniyor…</td></tr></tbody></table></div>
      <div id="mus-more" style="padding:12px 18px"></div>
    </div>
    <div id="mus-erp"></div>
    <div class="dk-note">${S.role !== "rep" ? "👁 Yönetici tüm ekibi görür" : "👤 Kendi portföyünüz"} · veri kapsamı sunucu-tarafı (token)</div>
  </div>`;

  const tb = () => m.querySelector("#mus-tb");
  const say = () => { const e = m.querySelector("#mus-say"); if (e) e.textContent = "(" + items.length + (hasMore ? "+" : "") + ")"; };
  const wireMus = () => tb().querySelectorAll("tr[data-mid]:not([data-w])").forEach(tr => {
    tr.dataset.w = "1";
    tr.addEventListener("click", () => { const x = items.find(o => String(o.id) === tr.dataset.mid); if (x) musteriDetay(x); });
  });
  const renderMore = () => {
    const box = m.querySelector("#mus-more");
    box.innerHTML = hasMore ? `<button class="dk-btn" id="mus-daha">↓ Daha fazla yükle (${items.length} yüklendi)</button>` : (items.length ? `<span class="sub2">Tümü yüklendi · ${items.length} müşteri</span>` : "");
    const b = m.querySelector("#mus-daha");
    if (b) b.addEventListener("click", async () => {
      b.disabled = true; b.textContent = "Yükleniyor…";
      offset += PAGE;
      const r = await api(url(offset));
      const more = r.musteriler || []; hasMore = !!r.hasMore;
      items = items.concat(more);
      tb().insertAdjacentHTML("beforeend", more.map(rowMus).join(""));
      wireMus(); say(); renderMore();
    });
  };
  // Aramada saha rosterinde OLMAYAN ERP carilerini de göster (sahaya ekle/bağla)
  const erpEkle = async () => {
    const box = m.querySelector("#mus-erp"); if (!box) return;
    if (!S.q || S.q.length < 2) { box.innerHTML = ""; return; }
    try {
      const { sonuclar = [] } = await api(`/api/saha/musteri-ara?q=${encodeURIComponent(S.q)}`);
      const kodSet = new Set(items.map(x => x.musteri_kodu).filter(Boolean));
      const vknSet = new Set(items.map(x => x.kimlik_vergi_no || x.vergi_no).filter(Boolean));
      const erp = sonuclar.filter(r => r.kaynak === "ERP" && !(r.musteri_kodu && kodSet.has(r.musteri_kodu)) && !(r.vergi_no && vknSet.has(r.vergi_no)));
      box.innerHTML = erp.length ? `<div class="dk-card" style="margin-top:16px"><div class="dk-card-h"><h3>ERP Carileri <span class="sub2">· sahaya eklenmemiş (${erp.length})</span></h3></div>${erp.map((r, i) => `<div class="dk-row"><div style="flex:1;min-width:0"><div class="firm">${esc(r.firma)}</div><div class="sub2">${esc(r.musteri_kodu || "")}${r.vergi_no ? " · VKN " + esc(r.vergi_no) : ""}${r.toplam_ciro != null ? " · ciro " + kisa(r.toplam_ciro) + "₺" : ""}</div></div><button class="dk-btn dk-btn-sm" data-erp="${i}">Sahaya Ekle</button></div>`).join("")}</div>` : "";
      box.querySelectorAll("[data-erp]").forEach(b => b.addEventListener("click", () => { const r = erp[Number(b.dataset.erp)]; yeniMus({ firma: r.firma, musteri_kodu: r.musteri_kodu, vergi_no: r.vergi_no, tc_no: r.tc_no }, () => go("musteriler")); }));
    } catch { box.innerHTML = ""; }
  };
  const load = async () => {
    offset = 0;
    const r = await api(url(0));
    items = r.musteriler || []; hasMore = !!r.hasMore;
    tb().innerHTML = items.length ? items.map(rowMus).join("") : `<tr><td colspan="7" class="dk-empty-s">Saha rosterinde eşleşme yok — ERP carileri aşağıda.</td></tr>`;
    wireMus(); say(); renderMore();
    erpEkle();
  };
  const qi = m.querySelector("#mus-q");
  let qt = null;
  qi.addEventListener("input", () => { S.q = qi.value.trim(); clearTimeout(qt); qt = setTimeout(load, 260); });
  await load();
};
function rowMus(x) {
  const [dl, dc] = DURUM[x.durum] || ["", ""];
  const konum = [x.il, x.ilce].filter(Boolean).join(" / ");
  const son = x.son_ziyaret ? new Date(x.son_ziyaret).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—";
  return `<tr data-mid="${esc(x.id)}">
    <td class="firm">${esc(x.firma)}</td>
    <td class="sub2">${esc(konum || "—")}</td>
    <td class="num sub2">${x.musteri_kodu ? esc(x.musteri_kodu) : "—"}</td>
    <td>${dl ? `<span class="pill ${dc}">${dl}</span>` : "—"}</td>
    <td class="num">${x.ziyaret_sayisi || 0}</td>
    <td class="sub2">${son}</td>
    <td>${Number(x.aktif_teklif) > 0 ? `<span class="pill p-info">📋 ${x.aktif_teklif}</span>` : "—"}</td>
  </tr>`;
}

// ZİYARETLER — canlı /api/saha/ziyaretler?durum=TAMAMLANDI (tip; rep filtresi mgmt)
VIEWS.ziyaretler = async (m) => {
  const { ziyaretler = [] } = await api(`/api/saha/ziyaretler?durum=TAMAMLANDI${tipQS()}`);
  S.ziyaretler = ziyaretler;
  let reps = [];
  if (S.role !== "rep") { try { reps = (await api("/api/saha/reps")).reps || []; } catch { /* filtre gösterilmez */ } }
  const now = new Date();
  const ym = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0");
  const buAy = ziyaretler.filter(z => String(z.ziyaret_tarihi || "").slice(0, 7) === ym).length;
  const cols = S.role !== "rep" ? 7 : 6;

  const filtre = () => {
    let liste = ziyaretler;
    const rf = m.querySelector("#ziy-rep") ? m.querySelector("#ziy-rep").value : "";
    if (rf) liste = liste.filter(z => (z.rep_full_name || z.rep_adi || "") === rf);
    if (S.q) {
      const a = S.q.toLocaleLowerCase("tr");
      liste = liste.filter(z => [z.firma, z.il, z.ilce, z.lokasyon_adi, z.notlar, z.rep_full_name, z.rep_adi]
        .some(v => String(v || "").toLocaleLowerCase("tr").includes(a)));
    }
    return liste;
  };
  const rowsHtml = (arr) => arr.length ? arr.map(rowZiy).join("") : `<tr><td colspan="${cols}" class="dk-empty-s">Ziyaret bulunamadı.</td></tr>`;

  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-grid dk-g4" style="margin-bottom:16px">
      ${stat("Tamamlanan Ziyaret", String(ziyaretler.length), "")}
      ${stat("Bu Ay", String(buAy), "")}
      ${stat("Fotoğraflı", String(ziyaretler.filter(z => Number(z.foto_sayisi)).length), "")}
      ${stat("Check-in'li", String(ziyaretler.filter(z => z.checkin_at).length), "")}
    </div>
    <div class="dk-card" style="padding:0;overflow:hidden">
      <div class="dk-card-h" style="padding:14px 18px;margin:0;border-bottom:1px solid var(--cizgi);gap:10px">
        <h3>Tamamlanan Ziyaretler</h3>
        <div style="display:flex;gap:8px;align-items:center;margin-left:auto">
          <button class="dk-btn dk-btn-sm" id="ziy-yeni" style="background:#0ea5e9;color:#fff;border-color:#0ea5e9">＋ Yeni Ziyaret</button>
          <input class="dk-tsearch" id="ziy-q" placeholder="🔍 firma, şehir, not…" value="${esc(S.q || "")}">
          ${reps.length ? `<select id="ziy-rep" class="dk-select"><option value="">Tüm temsilciler</option>${reps.map(r => `<option value="${esc(r.full_name)}">${esc(r.full_name)}</option>`).join("")}</select>` : ""}
        </div>
      </div>
      <div style="overflow-x:auto"><table class="dk-t">
        <thead><tr><th>Firma</th><th>Tip</th><th>Konum</th><th>Tarih</th>${S.role !== "rep" ? "<th>Temsilci</th>" : ""}<th>Not</th><th>Ek</th></tr></thead>
        <tbody id="ziy-tb">${rowsHtml(filtre())}</tbody></table></div>
    </div>
  </div>`;

  const wireRows = () => m.querySelectorAll("#ziy-tb tr[data-zid]").forEach(tr =>
    tr.addEventListener("click", () => {
      const z = ziyaretler.find(x => String(x.id) === tr.dataset.zid);
      if (z) ziyaretDetay(z);
    }));
  const refresh = () => { const t = m.querySelector("#ziy-tb"); if (t) { t.innerHTML = rowsHtml(filtre()); wireRows(); } };
  const rs = m.querySelector("#ziy-rep"); if (rs) rs.addEventListener("change", refresh);
  const qi = m.querySelector("#ziy-q");
  let qt = null;
  qi.addEventListener("input", () => { S.q = qi.value.trim(); clearTimeout(qt); qt = setTimeout(refresh, 200); });
  const _yzb = m.querySelector("#ziy-yeni"); if (_yzb) _yzb.addEventListener("click", () => musteriSec(mus => ziyaretYeniDesktop(mus)));  /* YENI_ZIYARET_DESKTOP_V1 */
  wireRows();
};
async function ziyaretYeniDesktop(mus) {  /* YENI_ZIYARET_DESKTOP_V1 */
  if (!mus || !mus.id) { alert("M\u00fc\u015fteri se\u00e7ilmedi."); return; }
  const bugun = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  dkModal(`<div class="dk-det-head"><h3>Yeni Ziyaret \u2014 ${esc(mus.firma || "")}</h3><button class="dk-x" data-kapat>\u2715</button></div>
    <div class="dk-form2">
      <label>Ziyaret Tarihi *<input id="zy-tarih" type="date" value="${bugun}" max="${bugun}"></label>
      <label>Kat\u0131l\u0131mc\u0131<input id="zy-kat" placeholder="G\u00f6r\u00fc\u015f\u00fclen ki\u015fi (ops.)"></label>
    </div>
    <label class="dk-form-full" style="display:block;margin-top:6px">Ziyaret Notu<textarea id="zy-not" rows="5" placeholder="Ne konu\u015fuldu, ne sat\u0131ld\u0131, sonraki ad\u0131m..." style="width:100%;box-sizing:border-box;font:inherit"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazge\u00e7</button><button class="dk-btn" id="zy-kaydet" style="background:#0ea5e9;color:#fff">Ziyareti Kaydet</button></div>`);
  const $ = id => S.container.querySelector("#" + id);
  $("zy-kaydet").addEventListener("click", async () => {
    const tarih = ($("zy-tarih").value || "").trim();
    if (!tarih) { alert("Ziyaret tarihi zorunlu."); return; }
    const btn = $("zy-kaydet"); const _t = btn.textContent; btn.disabled = true; btn.textContent = "Kaydediliyor...";
    try {
      const r = await api("/api/saha/ziyaretler", { method: "POST", body: JSON.stringify({ musteri_id: mus.id, tamamla: true, ziyaret_tarihi: tarih, katilimci: ($("zy-kat").value || "").trim() || null, notlar: ($("zy-not").value || "").trim() || null }) });
      dkKapat();
      if (r && r.mukerrer_engellendi) alert("Bu m\u00fc\u015fteriye az \u00f6nce ayn\u0131 g\u00fcn ziyaret kaydedilmi\u015f \u2014 tekrar a\u00e7\u0131lmad\u0131.");
      go("ziyaretler");
    } catch (e) { alert(e.message); btn.disabled = false; btn.textContent = _t; }
  });
}
function rowZiy(z) {
  const tarih = z.ziyaret_tarihi ? new Date(z.ziyaret_tarihi).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—";
  const konum = z.lokasyon_adi || [z.il, z.ilce].filter(Boolean).join(" / ");
  const meta = [];
  if (Number(z.foto_sayisi)) meta.push("📷" + z.foto_sayisi);
  if (Number(z.gorulme_sayisi)) meta.push("👁" + z.gorulme_sayisi);
  if (z.checkin_at) meta.push("📍");
  return `<tr data-zid="${esc(z.id)}">
    <td class="firm">${esc(z.firma)}</td>
    <td><span class="pill ${z.tip === "TUKETICI" ? "p-info" : "p-mut"}">${z.tip === "TUKETICI" ? "Tüketici" : "Ticari"}</span></td>
    <td class="sub2">${esc(konum || "—")}</td>
    <td class="sub2">${tarih}</td>
    ${S.role !== "rep" ? `<td class="sub2">${esc(z.rep_full_name || z.rep_adi || "—")}</td>` : ""}
    <td class="sub2">${z.notlar ? esc(z.notlar.slice(0, 90)) : "—"}</td>
    <td class="sub2">${meta.join(" ")}</td>
  </tr>`;
}

// PLAN — planlı ziyaretler + hatırlatmalar (takvim + seçili gün paneli)
VIEWS.plan = async (m) => {
  const [{ ziyaretler = [] }, notResp] = await Promise.all([
    api(`/api/saha/ziyaretler?durum=PLANLANDI${tipQS()}`),
    api("/api/saha/notlar").catch(() => ({ notlar: [] }))
  ]);
  const hatir = (notResp.notlar || []).filter(n => n.hatirlatma_tarihi && !n.tamamlandi);
  const bugun = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  let takvimAy = new Date();
  let seciliGun = bugun;

  const gunOf = z => (z.planlanan_tarih || "").slice(0, 10);
  const hgunOf = n => (n.hatirlatma_tarihi || "").slice(0, 10);

  // hafta aralığı (Pzt–Paz)
  const bd = new Date(bugun + "T12:00:00");
  const wStart = new Date(bd); wStart.setDate(bd.getDate() - ((bd.getDay() + 6) % 7));
  const wEnd = new Date(wStart); wEnd.setDate(wStart.getDate() + 6);
  const wsISO = wStart.toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" }), weISO = wEnd.toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  const buHafta = ziyaretler.filter(z => { const g = gunOf(z); return g >= wsISO && g <= weISO; }).length;
  const bugunPlanli = ziyaretler.filter(z => gunOf(z) === bugun).length;

  function calHtml() {
    const gz = {}, gh = {};
    ziyaretler.forEach(z => { const g = gunOf(z); if (g) gz[g] = (gz[g] || 0) + 1; });
    hatir.forEach(n => { const g = hgunOf(n); if (g) gh[g] = (gh[g] || 0) + 1; });
    const yil = takvimAy.getFullYear(), ay = takvimAy.getMonth();
    const ayAdi = takvimAy.toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul", month: "long", year: "numeric" });
    const ilk = ((new Date(yil, ay, 1).getDay() + 6) % 7);
    const son = new Date(yil, ay + 1, 0).getDate();
    const satir = Math.ceil((ilk + son) / 7);
    let cells = "", gun = 1;
    for (let s = 0; s < satir; s++) for (let g = 0; g < 7; g++) {
      const pos = s * 7 + g;
      if (pos < ilk || gun > son) { cells += `<div class="dk-cal-d bos"></div>`; continue; }
      const tarih = `${yil}-${String(ay + 1).padStart(2, "0")}-${String(gun).padStart(2, "0")}`;
      const zc = gz[tarih] || 0, hc = gh[tarih] || 0;
      cells += `<div class="dk-cal-d${tarih === bugun ? " bugun" : ""}${tarih === seciliGun ? " secili" : ""}${tarih < bugun ? " gecmis" : ""}" data-tarih="${tarih}">
        <span class="dk-cal-n">${gun}</span>
        <span class="dk-cal-badges">${zc ? `<span class="dk-cal-b">${zc}</span>` : ""}${hc ? `<span class="dk-cal-b hat">⏰${hc}</span>` : ""}</span></div>`;
      gun++;
    }
    return `<div class="dk-cal-h"><button class="dk-cal-nav" id="cal-prev">‹</button><b>${ayAdi}</b><button class="dk-cal-nav" id="cal-next">›</button></div>
      <div class="dk-cal-wd">${["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"].map(h => `<div>${h}</div>`).join("")}</div>
      <div class="dk-cal">${cells}</div>`;
  }

  function panelHtml() {
    const gz = ziyaretler.filter(z => gunOf(z) === seciliGun);
    const gh = hatir.filter(n => hgunOf(n) === seciliGun);
    const bas = new Date(seciliGun + "T12:00:00").toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul", weekday: "long", day: "numeric", month: "long" });
    const zHtml = gz.map(z => `<div class="dk-pl${gunOf(z) < bugun ? " gecmis" : ""}">
      <div class="dk-pl-top"><b class="firm">${esc(z.firma)}</b>${S.role !== "rep" && z.rep_full_name ? `<span class="sub2" style="margin-left:auto">👤 ${esc(z.rep_full_name)}</span>` : ""}</div>
      <div class="sub2">${esc([z.il, z.ilce].filter(Boolean).join(" / ") || "—")}</div>
      <div class="dk-pl-actions"><button class="dk-btn dk-btn-sm" data-iptal="${esc(z.id)}">İptal</button></div></div>`).join("");
    const hHtml = gh.length ? `<div class="dk-pl-sec">⏰ Hatırlatmalar</div>` + gh.map(n => `<div class="dk-pl hat">
      <div>${esc(n.icerik || "")}</div>
      <div class="dk-pl-top" style="margin-top:6px">${n.musteri ? `<span class="sub2">🏢 ${esc(n.musteri)}</span>` : ""}${hgunOf(n) < bugun ? `<span class="pill p-crit" style="margin-left:6px">gecikti</span>` : ""}
      <button class="dk-btn dk-btn-sm" data-htamam="${esc(n.id)}" style="margin-left:auto">✓ Tamamla</button></div></div>`).join("") : "";
    const bos = (!gz.length && !gh.length) ? `<div class="dk-empty-s">Bu gün için plan veya hatırlatma yok.</div>` : "";
    return `<div class="dk-card-h" style="margin-bottom:12px"><h3 style="text-transform:capitalize">${esc(bas)}</h3><span class="sub">${gz.length} ziyaret · ${gh.length} hatırlatma</span></div>${zHtml}${hHtml}${bos}`;
  }

  function render() {
    m.innerHTML = `<div class="dk-wrap">
      <div class="dk-grid dk-g4" style="margin-bottom:16px">
        ${stat("Bugün Planlı", String(bugunPlanli), "")}
        ${stat("Bu Hafta", String(buHafta), "")}
        ${stat("Toplam Planlı Ziyaret", String(ziyaretler.length), "")}
        ${stat("Aktif Hatırlatma", String(hatir.length), "")}
      </div>
      <div class="dk-plan-grid">
        <div class="dk-card" id="plan-cal">${calHtml()}</div>
        <div class="dk-card" id="plan-panel">${panelHtml()}</div>
      </div></div>`;
    wire();
  }
  function repanel() { const p = m.querySelector("#plan-panel"); if (p) { p.innerHTML = panelHtml(); wirePanel(); } m.querySelectorAll(".dk-cal-d[data-tarih]").forEach(el => el.classList.toggle("secili", el.dataset.tarih === seciliGun)); }
  function wirePanel() {
    m.querySelectorAll("[data-iptal]").forEach(b => b.addEventListener("click", async () => {
      if (!window.confirm("Ziyaret planı iptal edilsin mi?")) return;
      try {
        await api(`/api/saha/ziyaretler/${b.dataset.iptal}`, { method: "PUT", body: JSON.stringify({ action: "iptal" }) });
        const i = ziyaretler.findIndex(x => String(x.id) === b.dataset.iptal); if (i !== -1) ziyaretler.splice(i, 1);
        render();
      } catch (e) { b.textContent = e.message; }
    }));
    m.querySelectorAll("[data-htamam]").forEach(b => b.addEventListener("click", async () => {
      try {
        await api(`/api/saha/notlar/${b.dataset.htamam}`, { method: "PUT", body: JSON.stringify({ tamamlandi: true }) });
        const i = hatir.findIndex(x => String(x.id) === b.dataset.htamam); if (i !== -1) hatir.splice(i, 1);
        render();
      } catch (e) { b.textContent = e.message; }
    }));
  }
  function wire() {
    m.querySelector("#cal-prev").addEventListener("click", () => { takvimAy = new Date(takvimAy.getFullYear(), takvimAy.getMonth() - 1, 1); render(); });
    m.querySelector("#cal-next").addEventListener("click", () => { takvimAy = new Date(takvimAy.getFullYear(), takvimAy.getMonth() + 1, 1); render(); });
    m.querySelectorAll(".dk-cal-d[data-tarih]").forEach(el => el.addEventListener("click", () => { seciliGun = el.dataset.tarih; repanel(); }));
    wirePanel();
  }
  render();
};

// TEKLİF & İSKONTO — teklif hattı (taslak→onay→sunuldu→kazan/kayıp) + onay akışı
VIEWS.iskonto = async (m) => {
  const [{ teklifler = [] }, ayarResp] = await Promise.all([
    api("/api/saha/teklifler"),
    api("/api/saha/ayarlar").catch(() => ({ ayarlar: null }))
  ]);
  S.teklifler = teklifler;
  const ayarlar = ayarResp.ayarlar;
  const yon = S.role !== "rep";
  const by = d => teklifler.filter(t => t.durum === d);
  const taslak = by("TASLAK"), bekle = by("ONAY_BEKLIYOR"), onayli = by("ONAYLANDI"), sunulan = by("SUNULDU");
  const aktif = [...bekle, ...taslak, ...onayli, ...sunulan];
  const gecmis = teklifler.filter(t => ["KAZANILDI", "KAYBEDILDI", "IPTAL"].includes(t.durum));
  const pipeline = aktif.reduce((a, t) => a + (Number(t.toplam_tutar) || 0), 0);
  const kazan = teklifler.filter(t => t.durum === "KAZANILDI").length;

  const urun = t => Number(t.kalem_sayisi) > 1 ? `${t.kalem_sayisi} kalem`
    : [t.marka, t.model, t.ebat].filter(Boolean).join(" ") || "—";
  const aksiyon = t => {
    if (t.durum === "TASLAK") return `<button class="dk-btn dk-btn-sm" data-gonder="${esc(t.id)}">▶ Gönder</button>`;
    if (t.durum === "ONAY_BEKLIYOR") return yon
      ? `<button class="dk-btn dk-btn-sm" data-onayla="${esc(t.id)}">✓ Onayla</button> <button class="dk-btn dk-btn-sm dk-btn-red" data-reddet="${esc(t.id)}">✕</button>`
      : `<span class="sub2">yönetici onayında</span>`;
    if (t.durum === "ONAYLANDI") return `<button class="dk-btn dk-btn-sm" data-sun="${esc(t.id)}">📋 Sun</button>`;
    if (t.durum === "SUNULDU") return `<button class="dk-btn dk-btn-sm" data-sonuc="${esc(t.id)}" data-tip="KAZANILDI">✓ Kazandık</button> <button class="dk-btn dk-btn-sm dk-btn-red" data-sonuc="${esc(t.id)}" data-tip="KAYBEDILDI">✕</button>`;
    return "—";
  };
  const row = t => `<tr data-tid="${esc(t.id)}">
    <td class="firm">${esc(t.firma)}</td>
    <td class="sub2">${esc(urun(t))}</td>
    <td class="num">${t.kalem_sayisi > 1 ? "" : (t.adet || "")}</td>
    <td class="num">${t.toplam_tutar != null ? money(t.toplam_tutar) : "—"}</td>
    ${yon ? `<td class="sub2">${esc(t.rep_full_name || "—")}</td>` : ""}
    <td class="sub2">${t.created_at ? new Date(t.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</td>
    <td><span class="pill ${teklifPill(t.durum)[1]}">${teklifPill(t.durum)[0]}</span></td>
    <td onclick="event.stopPropagation()">${aksiyon(t)}</td></tr>`;

  const cols = yon ? 8 : 7;
  const tbl = (rows, bos) => `<div style="overflow-x:auto"><table class="dk-t">
    <thead><tr><th>Firma</th><th>Ürün</th><th class="num">Adet</th><th class="num">Tutar</th>${yon ? "<th>Temsilci</th>" : ""}<th>Tarih</th><th>Durum</th><th>Aksiyon</th></tr></thead>
    <tbody>${rows.length ? rows.map(row).join("") : `<tr><td colspan="${cols}" class="dk-empty-s">${bos}</td></tr>`}</tbody></table></div>`;

  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-grid dk-g4" style="margin-bottom:16px">
      ${stat("Onay Bekleyen", String(bekle.length), yon ? "senin onayında" : "yönetici onayında")}
      ${stat("Aktif Pipeline", money(pipeline), aktif.length + " teklif")}
      ${stat("Onaylı + Sunulan", String(onayli.length + sunulan.length), "")}
      ${stat("Kazanılan", String(kazan), "")}
    </div>
    ${yon && ayarlar ? `<div class="dk-esik">Genel eşik: ≤%${ayarlar.oto_onay_max} otomatik · %${ayarlar.oto_onay_max}–${ayarlar.mudur_max} müdür · >%${ayarlar.mudur_max} GM onayı</div>` : ""}
    <div class="dk-card" style="padding:0;overflow:hidden;margin-top:16px">
      <div class="dk-card-h" style="padding:14px 18px;margin:0;border-bottom:1px solid var(--cizgi)"><h3>Aktif Teklifler <span class="sub2">(${aktif.length})</span></h3>
        <div style="display:flex;gap:8px">${S.role === "admin" ? `<button class="dk-btn dk-btn-sm" id="isk-esik">⚙ Eşik & Kural</button>` : ""}<button class="dk-btn dk-btn-sm" id="isk-yeni">＋ Teklif</button></div></div>
      ${tbl(aktif, "Aktif teklif yok.")}
    </div>
    <div class="dk-card" style="padding:0;overflow:hidden;margin-top:16px">
      <div class="dk-card-h" style="padding:14px 18px;margin:0;border-bottom:1px solid var(--cizgi)"><h3>Teklif Geçmişi <span class="sub2">(${gecmis.length})</span></h3></div>
      ${tbl(gecmis, "Sonuçlanmış teklif yok.")}
    </div>
  </div>`;

  m.querySelector(".dk-wrap").addEventListener("click", async ev => {
    const act = async (id, body, ok) => { try { await api(`/api/saha/teklifler/${id}`, { method: "PUT", body: JSON.stringify(body) }); if (ok) alert(ok); go("iskonto"); } catch (e) { alert(e.message); } };
    const g = ev.target.closest("[data-gonder]"); if (g) { return act(g.dataset.gonder, { action: "gonder" }, "✓ Teklif gönderildi."); }
    const s = ev.target.closest("[data-sun]"); if (s) { return act(s.dataset.sun, { action: "sun" }, "✓ Müşteriye sunuldu."); }
    const o = ev.target.closest("[data-onayla]"); if (o) { return act(o.dataset.onayla, { action: "onayla" }, "✓ Teklif onaylandı."); }
    const r = ev.target.closest("[data-reddet]"); if (r) { const not = prompt("Red gerekçesi (opsiyonel):"); return act(r.dataset.reddet, { action: "reddet", not: not || null }, "Teklif reddedildi — taslağa döndü."); }
    const sn = ev.target.closest("[data-sonuc]"); if (sn) { const t = teklifler.find(x => String(x.id) === sn.dataset.sonuc); if (t) teklifSonuc(t, sn.dataset.tip); return; }
    const tr = ev.target.closest("tr[data-tid]"); if (tr) { const t = teklifler.find(x => String(x.id) === tr.dataset.tid); if (t) teklifDetay(t); }
  });
  m.querySelector("#isk-yeni")?.addEventListener("click", () => musteriSec(mus => teklifForm(mus)));
  m.querySelector("#isk-esik")?.addEventListener("click", () => esikAyar(ayarlar));
};

// ── seçenekler + müşteri seçici (teklif/plan/ziyaret formları için ortak) ──
async function secenekler() {
  if (!S.secenekler) {
    try { S.secenekler = await api("/api/saha/iskonto-secenekler"); }
    catch {
      S.secenekler = { markalar: [], kategoriler: [["BINEK", "Binek"], ["TICARI", "Ticari"]], sezonlar: [["YAZ", "Yaz"], ["KIS", "Kış"], ["4MEV", "4 Mevsim"]], jant_gruplari: [], alt_gruplar: [["UZUN_YOL", "Uzun Yol"], ["HAFRIYAT", "Hafriyat"], ["YOL_DISI", "Yol Dışı"]], vadeler: [] };
    }
  }
  return S.secenekler;
}
function secOpts(liste, bos = "Seçin…") { return `<option value="">${esc(bos)}</option>` + (liste || []).map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join(""); }
const KURAL_ET = { kategori: { BINEK: "Binek", TICARI: "Ticari" }, sezon: { YAZ: "Yaz", KIS: "Kış", "4MEV": "4 Mevsim" }, alt_grup: { UZUN_YOL: "Uzun Yol", HAFRIYAT: "Hafriyat", YOL_DISI: "Yol Dışı" } };
function kuralOzet(k) { const p = [k.marka, KURAL_ET.kategori[k.kategori], KURAL_ET.sezon[k.sezon], k.jant_grubu, KURAL_ET.alt_grup[k.alt_grup]].filter(Boolean); return p.length ? p.join(" · ") : "Genel (tüm ürünler)"; }

function musteriSec(cb) {
  dkModal(`<div class="dk-det-head"><h3>Müşteri Seç</h3><button class="dk-x" data-kapat>✕</button></div>
    <input class="dk-tsearch" id="ms-q" placeholder="🔍 firma adı veya VKN (en az 2 harf)" style="width:100%;max-width:100%">
    <div id="ms-liste" style="margin-top:10px;max-height:380px;overflow-y:auto"><div class="sub2">En az 2 harf yazın… (saha kayıtları + ERP carileri birlikte aranır)</div></div>`);
  const inp = S.container.querySelector("#ms-q"), box = S.container.querySelector("#ms-liste");
  let t = null;
  const run = async () => {
    const q = inp.value.trim();
    if (q.length < 2) { box.innerHTML = `<div class="sub2">En az 2 harf yazın…</div>`; return; }
    try {
      const { sonuclar = [] } = await api(`/api/saha/musteri-ara?q=${encodeURIComponent(q)}`);
      // Akıllı: VKN'si zaten bir saha kaydında olan ERP carilerini gizle (mükerrer önle)
      const sahaVkn = new Set(sonuclar.filter(r => r.kaynak === "SAHA" && r.vergi_no).map(r => r.vergi_no));
      const liste = sonuclar.filter(r => r.kaynak === "SAHA" || !(r.vergi_no && sahaVkn.has(r.vergi_no)));
      box.innerHTML = liste.map((r, i) => `<button class="dk-fo-pick" data-i="${i}"><span>${esc(r.firma)} <span class="pill ${r.kaynak === "SAHA" ? "p-ok" : "p-mut"}">${r.kaynak === "SAHA" ? "Kayıtlı" : "ERP Cari"}</span></span><span class="sub2">${esc([r.il, r.ilce].filter(Boolean).join("/") || r.musteri_kodu || "")}</span></button>`).join("")
        + `<button class="dk-fo-pick" data-yeni="1"><span>＋ "${esc(q)}" yeni müşteri olarak ekle</span></button>`;
      box.querySelectorAll("[data-i],[data-yeni]").forEach(b => b.addEventListener("click", () => {
        if (b.dataset.yeni) { yeniMus({ firma: q }, cb); return; }
        const r = liste[Number(b.dataset.i)];
        if (r.kaynak === "SAHA") { dkKapat(); cb(r); }
        else yeniMus({ firma: r.firma, musteri_kodu: r.musteri_kodu, vergi_no: r.vergi_no, tc_no: r.tc_no }, cb);
      }));
    } catch (e) { box.innerHTML = `<div class="sub2">${esc(e.message)}</div>`; }
  };
  inp.addEventListener("input", () => { clearTimeout(t); t = setTimeout(run, 240); });
  inp.focus();
}

// ERP carisini / yeni firmayı sahaya ekle → kaydedince teklif formuna devam
// Tüketici tabela markaları (fallback) + Ticari filo segmentleri — mobil ile aynı liste
const TABELA_FALLBACK = ["Lassa", "Pirelli", "Michelin", "Bridgestone", "Goodyear", "Continental", "Petlas", "Hankook", "Kumho", "Nokian", "Sailun", "Goodride"];
const TABELA_ZINCIR = ["Lastiğim", "LastikEvi", "Bosch Car Service", "Oto Pratik", "LastikPark", "HerLastik", "LastikVs", "Starmaxx"];
const FILO_SEGMENT = ["Otobüs", "Maden", "Uzun Yol", "Şehir İçi Dağıtım", "İnşaat / Hafriyat", "Tarım", "Lojistik / Filo", "Kargo / Nakliye", "Yol Dışı (OTR)", "Akaryakıt / Tanker", "Diğer"];

function yeniMus(pre, cb) {
  (async () => {
    const iller = window.TR_ILLER_RESMI || [];
    const ililce = window.TR_IL_ILCE || {};
    const sec = await secenekler().catch(() => ({}));
    const markalar = (sec.markalar && sec.markalar.length ? sec.markalar : TABELA_FALLBACK);
    const konum = { lat: null, lng: null };
    dkModal(`<div class="dk-det-head"><h3>${pre.musteri_kodu ? "ERP Cariyi Sahaya Ekle" : "Yeni Müşteri"}</h3><button class="dk-ac" id="ym-nedir" type="button" title="Bu nedir?">ⓘ Bu nedir?</button><button class="dk-x" data-kapat>✕</button></div>
      <div id="ym-aciklama" class="dk-aciklama" style="display:none">Bu firma ERP'de (muhasebe) kayıtlı ama saha ekibinin listesinde yok. Sahaya eklediğinizde ziyaret/teklif girebilir, haritada görebilir, temsilci atayabilirsiniz; ERP bakiye ve satış geçmişi otomatik bağlanır. Tabela, segment, yetkili ve konum gibi bilgiler ERP'de bulunmadığı için burada toplanır.</div>
      ${pre.musteri_kodu ? `<div class="dk-note" style="margin-bottom:10px;width:100%">ERP kodu <b>${esc(pre.musteri_kodu)}</b> bağlanacak — bakiye ve satış geçmişi otomatik görünür.</div>` : ""}
      <div class="dk-form2">
        <label>Firma *<input id="ym-firma" value="${esc(pre.firma || "")}"></label>
        <label>Tip *<select id="ym-tip"><option value="">Seçin…</option><option value="TUKETICI">Tüketici (PSR bayi)</option><option value="TICARI">Ticari (TBR/OTR filo)</option></select></label>
        <label>İl *${iller.length ? `<select id="ym-il"><option value="">Seçin…</option>${iller.map(i => `<option>${esc(i)}</option>`).join("")}</select>` : `<input id="ym-il">`}</label>
        <label>İlçe${iller.length ? `<select id="ym-ilce"><option value="">Önce il…</option></select>` : `<input id="ym-ilce">`}</label>
        <label>Yetkili Kişi *<input id="ym-yetkili" placeholder="Ad Soyad / Ünvan"></label>
        <label>Telefon *<input id="ym-tel" placeholder="+90 5xx xxx xx xx"></label>
      </div>
      <div id="ym-dyn" style="display:none;margin-bottom:10px"></div>
      <div class="dk-form2">
        <label>Kayıt Kaynağı *<select id="ym-kaynak"><option value="SAHA_ZIYARETI">📍 Saha Ziyareti</option><option value="TELEFON">📞 Telefon</option><option value="REFERANS">🤝 Referans</option><option value="DIGER">Diğer</option></select></label>
        <label>VKN ${pre.vergi_no ? `<span class="dk-erpden">✓ ERP'den</span>` : ""}<input id="ym-vkn" value="${esc(pre.vergi_no || "")}" placeholder="10 hane"></label>
        <label>TC Kimlik No<input id="ym-tcno" value="${esc(pre.tc_no || "")}" placeholder="11 hane"></label>
      </div>
      <button class="dk-btn" id="ym-konum" type="button" style="width:100%;margin-bottom:4px">📍 GPS ile Konumu Pinle</button>
      <div id="ym-konum-durum" class="sub2" style="margin-bottom:6px">Konum isteğe bağlı — sahadaysanız pinleyin, ofisten boş bırakın.</div>
      <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="ym-kaydet">Kaydet ve Devam</button></div>`);
    const $ = id => S.container.querySelector("#" + id);
    $("ym-nedir").addEventListener("click", () => { const a = $("ym-aciklama"); a.style.display = a.style.display === "none" ? "block" : "none"; });
    $("ym-tip").addEventListener("change", () => {
      const t = $("ym-tip").value, dyn = $("ym-dyn");
      if (t === "TUKETICI") { dyn.style.display = ""; const og = (l, a) => `<optgroup label="${l}">${a.map(m => `<option>${esc(m)}</option>`).join("")}</optgroup>`; dyn.innerHTML = `<label class="dk-form-full" style="margin:0">Tabela (mağazadaki lastik/servis markası)<select id="ym-segment"><option value="">Seçin…</option>${og("Zincir / Servis", TABELA_ZINCIR)}${og("Üretici markası", markalar)}<option>Bağımsız / Tabelasız</option><option>Diğer</option></select></label>`; }
      else if (t === "TICARI") { dyn.style.display = ""; dyn.innerHTML = `<label class="dk-form-full" style="margin:0">Segment (filo tipi)<select id="ym-segment"><option value="">Seçin…</option>${FILO_SEGMENT.map(m => `<option>${esc(m)}</option>`).join("")}</select></label>`; }
      else { dyn.style.display = "none"; dyn.innerHTML = ""; }
    });
    if (iller.length) { const ilEl = $("ym-il"), ilceEl = $("ym-ilce"); const doldur = () => { const liste = ililce[ilEl.value] || []; ilceEl.innerHTML = `<option value="">${ilEl.value ? "İlçe seçin…" : "Önce il…"}</option>` + liste.map(x => `<option>${esc(x)}</option>`).join(""); }; ilEl.addEventListener("change", doldur); doldur(); }
    $("ym-konum").addEventListener("click", () => {
      const st = $("ym-konum-durum"); st.textContent = "Konum alınıyor…";
      if (!navigator.geolocation) { st.textContent = "Tarayıcı konumu desteklemiyor."; return; }
      navigator.geolocation.getCurrentPosition(p => { konum.lat = p.coords.latitude; konum.lng = p.coords.longitude; st.textContent = `✓ Konum alındı (±${Math.round(p.coords.accuracy)}m)`; }, () => { st.textContent = "⚠ Konum alınamadı — izinleri kontrol edin."; }, { enableHighAccuracy: true, timeout: 10000 });
    });
    $("ym-kaydet").addEventListener("click", async () => {
      const g = id => { const el = $(id); return el ? (el.value || "").trim() : ""; };
      if (!g("ym-firma")) { alert("Firma zorunlu."); return; }
      if (!g("ym-tip")) { alert("Tip zorunlu."); return; }
      if (!g("ym-il")) { alert("İl zorunlu."); return; }
      if (!g("ym-yetkili")) { alert("Yetkili kişi zorunlu."); return; }
      if (!g("ym-tel")) { alert("Telefon zorunlu."); return; }
      try {
        const { musteri } = await api("/api/saha/musteriler", { method: "POST", body: JSON.stringify({ firma: g("ym-firma"), tip: g("ym-tip"), il: g("ym-il"), ilce: g("ym-ilce") || null, yetkili: g("ym-yetkili"), telefon: g("ym-tel"), segment: g("ym-segment") || null, vergi_no: g("ym-vkn") || null, tc_no: g("ym-tcno") || null, musteri_kodu: pre.musteri_kodu || null, kayit_kaynagi: g("ym-kaynak") || "SAHA_ZIYARETI", lat: konum.lat, lng: konum.lng }) });
        dkKapat(); cb(musteri);
      } catch (e) { alert(e.message); }
    });
  })();
}

async function esikAyar(ayarlar) {
  const sec = await secenekler();
  dkModal(`<div class="dk-det-head"><h3>İskonto Eşikleri & Kuralları</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="dk-det-yh">Genel eşikler (kural eşleşmezse)</div>
    <div class="dk-form2"><label>Oto-onay ≤ (%)<input id="es-oto" type="number" step="0.5" min="0" value="${ayarlar ? ayarlar.oto_onay_max : ""}"></label><label>Müdür ≤ (%)<input id="es-mudur" type="number" step="0.5" min="0" value="${ayarlar ? ayarlar.mudur_max : ""}"></label></div>
    <button class="dk-btn dk-btn-sm" id="es-kaydet" style="margin-top:8px">Genel Eşikleri Kaydet</button>
    <div class="dk-det-yh" style="margin-top:16px">Kategori kuralları (en spesifik kazanır)</div>
    <div id="kural-liste" class="sub2">Yükleniyor…</div>
    <div class="dk-det-yh" style="margin-top:16px">Yeni kural</div>
    <div class="dk-form2">
      <label>Marka<input id="kr-marka" list="kr-markalar" placeholder="Hepsi"><datalist id="kr-markalar">${(sec.markalar || []).map(m => `<option>${esc(m)}</option>`).join("")}</datalist></label>
      <label>Kategori<select id="kr-kategori">${secOpts(sec.kategoriler, "Hepsi")}</select></label>
      <label>Sezon<select id="kr-sezon">${secOpts(sec.sezonlar, "Hepsi")}</select></label>
      <label>Jant<select id="kr-jant">${secOpts(sec.jant_gruplari, "Hepsi")}</select></label>
      <label>Ticari grup<select id="kr-altgrup">${secOpts(sec.alt_gruplar, "Hepsi")}</select></label>
      <label>Oto-onay ≤ (%)<input id="kr-oto" type="number" step="0.5" min="0"></label>
      <label>Müdür ≤ (%)<input id="kr-mudur" type="number" step="0.5" min="0"></label>
    </div>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button><button class="dk-btn" id="kr-ekle">Kural Ekle</button></div>`);
  const $ = id => S.container.querySelector("#" + id);
  const load = async () => {
    try {
      const { kurallar = [] } = await api("/api/saha/iskonto-kurallar");
      const el = $("kural-liste"); el.classList.remove("sub2");
      el.innerHTML = kurallar.length ? kurallar.map(k => `<div class="dk-pl" style="display:flex;justify-content:space-between;align-items:center;gap:8px"><span><b>${esc(kuralOzet(k))}</b> <span class="pill p-info">≤%${Number(k.oto_onay_max)} oto · ≤%${Number(k.mudur_max)} müdür</span></span><button class="dk-btn dk-btn-sm dk-btn-red" data-ksil="${esc(k.id)}">Sil</button></div>`).join("") : `<div class="sub2">Henüz kural yok — genel eşikler geçerli.</div>`;
      el.querySelectorAll("[data-ksil]").forEach(b => b.addEventListener("click", async () => { if (!confirm("Kural silinsin mi?")) return; try { await api(`/api/saha/iskonto-kurallar/${b.dataset.ksil}`, { method: "DELETE" }); load(); } catch (e) { alert(e.message); } }));
    } catch { $("kural-liste").textContent = "Kurallar yüklenemedi."; }
  };
  load();
  $("es-kaydet").addEventListener("click", async () => { try { const { ayarlar: a } = await api("/api/saha/ayarlar", { method: "PUT", body: JSON.stringify({ oto_onay_max: Number($("es-oto").value), mudur_max: Number($("es-mudur").value) }) }); S.ayarlar = a; alert("✓ Genel eşikler kaydedildi."); } catch (e) { alert(e.message); } });
  $("kr-ekle").addEventListener("click", async () => { const g = id => ($(id).value || "").trim(); if (!g("kr-oto") || !g("kr-mudur")) { alert("Kural eşikleri zorunlu."); return; } try { await api("/api/saha/iskonto-kurallar", { method: "POST", body: JSON.stringify({ marka: g("kr-marka") || null, kategori: g("kr-kategori") || null, sezon: g("kr-sezon") || null, jant_grubu: g("kr-jant") || null, alt_grup: g("kr-altgrup") || null, oto_onay_max: Number(g("kr-oto")), mudur_max: Number(g("kr-mudur")) }) }); ["kr-marka", "kr-oto", "kr-mudur"].forEach(id => $(id).value = ""); alert("✓ Kural eklendi."); load(); } catch (e) { alert(e.message); } });
}

async function teklifForm(mus) {
  const sec = await secenekler();
  const SEAS = ["BINEK", "TICARI", ""];
  let kalemler = [];
  dkModal(`
    <div class="dk-det-head"><h3>Yeni Teklif — ${esc(mus.firma)}</h3><button class="dk-x" data-kapat>✕</button></div>
    <div id="tf-liste" style="display:none;margin-bottom:10px"></div>
    <label class="dk-form-full">Ürün Ara<div style="position:relative"><input id="tf-ara" placeholder="Kod, marka veya ürün adı…" autocomplete="off"><div id="tf-sonuc" class="dk-ara-sonuc" style="display:none"></div></div></label>
    <div id="tf-secili" class="dk-note" style="display:none;width:100%;justify-content:space-between"></div>
    <input type="hidden" id="tf-kod"><input type="hidden" id="tf-liste-h"><input type="hidden" id="tf-stok-h">
    <input type="hidden" id="tf-tesvik-g"><input type="hidden" id="tf-tesvik-m">
    <input type="hidden" id="tf-kampanya-id"><input type="hidden" id="tf-kampanya-turu"><input type="hidden" id="tf-kampanya-deger">
    <div class="dk-form2">
      <label>Marka *<input id="tf-marka" list="tf-markalar"><datalist id="tf-markalar">${(sec.markalar || []).map(m => `<option>${esc(m)}</option>`).join("")}</datalist></label>
      <label>Model / Desen<input id="tf-model"></label>
      <label>Ebat<input id="tf-ebat" placeholder="205/55R16"></label>
      <label>Adet<input id="tf-adet" type="number" value="4" min="1"></label>
      <label>Kategori<input id="tf-kategori" list="tf-kat" placeholder="BINEK, TICARI…"><datalist id="tf-kat">${(sec.kategoriler || []).map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join("")}</datalist></label>
      <label id="tf-sezon-l">Sezon<select id="tf-sezon">${secOpts(sec.sezonlar)}</select></label>
    </div>
    <label id="tf-altgrup-l" class="dk-form-full" style="display:none">Ticari grup<select id="tf-altgrup">${secOpts(sec.alt_gruplar)}</select></label>
    <div class="dk-det-yh" style="margin-top:8px">Fiyat & Teşvik</div>
    <div class="dk-form2">
      <label>Talep Fiyat (₺/adet) *<input id="tf-talep" type="number" min="0" step="0.01"></label>
      <label>Mevcut Stok<div id="tf-stok" class="dk-ro">—</div></label>
      <label>Liste Fiyatı<div id="tf-liste-f" class="dk-ro">—</div></label>
      <label>Ek İskonto (%)<input id="tf-ek" type="number" min="0" max="100" step="0.1"></label>
      <label>Tedarikçi Destek (%)<input id="tf-destek" type="number" min="0" max="100" step="0.1"></label>
      <label>Satış Vadesi<input id="tf-vade" value="${esc(mus.erp_odeme_kosulu || "")}"></label>
    </div>
    <div id="tf-hesap" class="dk-note" style="display:none;margin:2px 0 8px"></div>
    <div id="tf-tesvik" style="display:none;margin-bottom:8px"></div>
    <div id="tf-kampanya" style="display:none;margin-bottom:8px"></div>
    <label class="dk-form-full">Satır Notu<textarea id="tf-not" rows="2"></textarea></label>
    <label class="dk-form-full">Genel Not<textarea id="tf-gnot" rows="2"></textarea></label>
    <label class="dk-form-full">Kaynak *<select id="tf-kaynak"><option value="">— Nereden geldi? —</option><option value="TELEFON">📞 Telefon</option><option value="WHATSAPP">💬 WhatsApp</option><option value="EMAIL">✉️ E-posta</option><option value="DIGER">Diğer</option></select></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="tf-add">＋ Satıra Ekle</button><button class="dk-btn" id="tf-save">Teklifi Kaydet</button></div>`);
  const $ = id => S.container.querySelector("#" + id);
  const hesap = () => { const talep = parseFloat($("tf-talep").value); const liste = parseFloat($("tf-liste-h").value); const ek = parseFloat($("tf-ek").value) || 0; const adet = parseInt($("tf-adet").value) || 1; const birim = !isNaN(talep) ? talep : (!isNaN(liste) ? Math.round(liste * (1 - ek / 100) * 100) / 100 : null); const h = $("tf-hesap"); if (birim != null) { h.style.display = ""; h.textContent = `Birim ₺${birim.toLocaleString("tr-TR")} × ${adet} = ₺${Math.round(birim * adet).toLocaleString("tr-TR")}`; } else h.style.display = "none"; };
  ["tf-talep", "tf-ek", "tf-adet"].forEach(id => $(id).addEventListener("input", hesap));
  const sezonVis = kat => { const s = !kat || SEAS.includes(kat.toUpperCase()); $("tf-sezon-l").style.display = s ? "" : "none"; if (!s) $("tf-sezon").value = ""; };
  $("tf-kategori").addEventListener("change", e => { const kat = e.target.value; $("tf-altgrup-l").style.display = kat === "TICARI" ? "" : "none"; sezonVis(kat); const marka = $("tf-marka").value.trim(); if (marka) fetchPricing(marka, kat, $("tf-kod").value, $("tf-ebat").value); });

  async function fetchPricing(marka, kategori, kod, ebat) {
    if (!marka) return;
    const jant = ebat ? (ebat.match(/R(\d{2})/i) || [])[1] : null;
    const [tv, dk, kv] = await Promise.allSettled([
      api(`/api/saha/tesvik-bilgi?marka=${encodeURIComponent(marka)}&kategori=${encodeURIComponent(kategori || "")}`),
      api(`/api/saha/musteri-destek?musteri_id=${encodeURIComponent(mus.id)}&marka=${encodeURIComponent(marka)}`),
      api(`/api/saha/kampanya-ara?marka=${encodeURIComponent(marka)}&kalem_kodu=${encodeURIComponent(kod || "")}&kategori=${encodeURIComponent(kategori || "")}&jant_capi=${encodeURIComponent(jant || "")}`)
    ]);
    const tk = $("tf-tesvik");
    if (tv.status === "fulfilled" && tv.value.tesvik) { const t = tv.value.tesvik; $("tf-tesvik-g").value = t.garantili_pct ?? ""; $("tf-tesvik-m").value = t.maksimum_pct ?? ""; tk.style.display = ""; tk.className = "dk-pl"; tk.style.borderLeft = "3px solid var(--yesil-p)"; tk.innerHTML = `<b>Teşvik</b> — ${t.garantili_pct != null ? `Garantili %${t.garantili_pct}` : ""}${t.maksimum_pct != null ? ` · Maks %${t.maksimum_pct}` : ""}${t.notlar ? `<div class="sub2">${esc(t.notlar)}</div>` : ""}`; } else { $("tf-tesvik-g").value = ""; $("tf-tesvik-m").value = ""; tk.style.display = "none"; }
    if (dk.status === "fulfilled" && dk.value.destek) { $("tf-destek").value = dk.value.destek.destek_pct ?? ""; }
    const kk = $("tf-kampanya");
    if (kv.status === "fulfilled" && kv.value.kampanyalar && kv.value.kampanyalar.length) { const b = kv.value.kampanyalar[0]; $("tf-kampanya-id").value = b.id; $("tf-kampanya-turu").value = b.indirim_turu; $("tf-kampanya-deger").value = b.indirim_deger; kk.style.display = ""; kk.className = "dk-pl"; kk.style.borderLeft = "3px solid #eab308"; kk.innerHTML = `<b>Kampanya:</b> ${esc(b.kampanya_adi)} · ${b.indirim_turu === "PCT" ? `%${b.indirim_deger} indirim` : `₺${Number(b.indirim_deger).toLocaleString("tr-TR")} destek`}`; } else { $("tf-kampanya-id").value = ""; $("tf-kampanya-turu").value = ""; $("tf-kampanya-deger").value = ""; kk.style.display = "none"; }
  }
  function urunSec(u) {
    $("tf-kod").value = u.kalem_kodu || ""; $("tf-marka").value = u.marka || ""; $("tf-model").value = u.kalem_tanimi || ""; $("tf-ebat").value = u.ebat_norm || "";
    if (u.liste_fiyati) { $("tf-liste-f").textContent = `₺${Number(u.liste_fiyati).toLocaleString("tr-TR")}`; $("tf-liste-h").value = u.liste_fiyati; } else { $("tf-liste-f").textContent = "—"; $("tf-liste-h").value = ""; }
    if (u.kategori) { $("tf-kategori").value = u.kategori; $("tf-altgrup-l").style.display = u.kategori === "TICARI" ? "" : "none"; sezonVis(u.kategori); }
    const nm = (u.kalem_tanimi || "").toLowerCase();
    if (!u.kategori || SEAS.includes((u.kategori || "").toUpperCase())) { if (/kı[sş]|winter/.test(nm)) $("tf-sezon").value = "KIS"; else if (/\byaz\b|summer/.test(nm)) $("tf-sezon").value = "YAZ"; else if (/mevsim|season|4s\b/.test(nm)) $("tf-sezon").value = "4MEV"; }
    const sc = $("tf-secili"); sc.style.display = "flex"; sc.innerHTML = `<span>${esc(u.kalem_kodu)} · ${esc(u.marka || "")} ${esc(u.ebat_norm || "")} ${esc(u.kalem_tanimi || "")}</span><b data-clr style="cursor:pointer">✕</b>`;
    sc.querySelector("[data-clr]").addEventListener("click", () => { sc.style.display = "none"; $("tf-kod").value = ""; $("tf-liste-h").value = ""; $("tf-liste-f").textContent = "—"; $("tf-stok").textContent = "—"; $("tf-stok-h").value = ""; $("tf-tesvik").style.display = "none"; $("tf-kampanya").style.display = "none"; });
    hesap();
    fetchPricing(u.marka, u.kategori, u.kalem_kodu, u.ebat_norm).catch(() => {});
    if (u.kalem_kodu) { $("tf-stok").textContent = "…"; api("/api/saha/stok-durumu?kalem_kodu=" + encodeURIComponent(u.kalem_kodu)).then(r => { const a = r && r.eldeki_miktar != null ? Number(r.eldeki_miktar) : null; if (a != null) { $("tf-stok").textContent = a.toLocaleString("tr-TR") + " adet"; $("tf-stok-h").value = a; } else $("tf-stok").textContent = "Stok yok"; }).catch(() => { $("tf-stok").textContent = "—"; }); }
  }
  let at = null;
  $("tf-ara").addEventListener("input", () => {
    clearTimeout(at); const q = $("tf-ara").value.trim(); const box = $("tf-sonuc");
    if (q.length < 2) { box.style.display = "none"; return; }
    at = setTimeout(async () => {
      try {
        const { urunler = [] } = await api(`/api/saha/urun-ara?q=${encodeURIComponent(q)}`);
        box.style.display = "";
        box.innerHTML = urunler.length ? urunler.map(u => `<div class="dk-ara-item" data-kod="${esc(u.kalem_kodu)}"><div><b>${esc(u.marka || "")}</b> — ${esc(u.kalem_tanimi || "")}</div><div class="sub2">${u.ebat_norm ? `<b>${esc(u.ebat_norm)}</b> · ` : ""}${u.liste_fiyati ? `₺${Number(u.liste_fiyati).toLocaleString("tr-TR")} · ` : ""}${esc(u.kalem_kodu)}</div></div>`).join("") : `<div class="dk-ara-item sub2">Ürün bulunamadı.</div>`;
        box.querySelectorAll("[data-kod]").forEach(el => el.addEventListener("mousedown", ev => { ev.preventDefault(); const u = urunler.find(x => x.kalem_kodu === el.dataset.kod); box.style.display = "none"; $("tf-ara").value = ""; if (u) urunSec(u); }));
      } catch { box.style.display = "none"; }
    }, 220);
  });
  $("tf-ara").addEventListener("blur", () => setTimeout(() => { const b = $("tf-sonuc"); if (b) b.style.display = "none"; }, 200));

  const oku = () => { const g = id => ($(id).value || "").trim(); const gn = id => { const v = g(id); return v ? Number(v) : null; }; const marka = g("tf-marka"); if (!marka) return null; const talep = gn("tf-talep"), liste = gn("tf-liste-h"), ek = gn("tf-ek") || 0, adet = Number(g("tf-adet")) || 1; const birim = talep != null ? talep : (liste != null ? Math.round(liste * (1 - ek / 100) * 100) / 100 : null); return { kalem_kodu: g("tf-kod") || null, marka, model: g("tf-model") || null, ebat: g("tf-ebat") || null, kategori: g("tf-kategori") || null, sezon: g("tf-sezon") || null, alt_grup: g("tf-kategori") === "TICARI" ? (g("tf-altgrup") || null) : null, adet, liste_fiyati: liste, talep_fiyat: talep, mevcut_stok: gn("tf-stok-h"), birim_fiyat: birim, toplam_tutar: birim != null ? Math.round(birim * adet * 100) / 100 : null, musteri_ek_iskonto_pct: ek > 0 ? ek : null, tesvik_garantili_pct: gn("tf-tesvik-g"), tesvik_maksimum_pct: gn("tf-tesvik-m"), tedarikci_destek_pct: gn("tf-destek"), kampanya_id: gn("tf-kampanya-id"), kampanya_indirim_turu: g("tf-kampanya-turu") || null, kampanya_indirim_deger: gn("tf-kampanya-deger"), notlar: g("tf-not") || null }; };
  const clearForm = () => { ["tf-kod", "tf-marka", "tf-model", "tf-ebat", "tf-talep", "tf-liste-h", "tf-stok-h", "tf-ek", "tf-tesvik-g", "tf-tesvik-m", "tf-destek", "tf-kampanya-id", "tf-kampanya-turu", "tf-kampanya-deger", "tf-not"].forEach(id => $(id).value = ""); $("tf-adet").value = "4"; $("tf-liste-f").textContent = "—"; $("tf-stok").textContent = "—"; $("tf-tesvik").style.display = "none"; $("tf-kampanya").style.display = "none"; $("tf-hesap").style.display = "none"; $("tf-secili").style.display = "none"; $("tf-ara").focus(); };
  const renderKalemler = () => { const box = $("tf-liste"); if (!kalemler.length) { box.style.display = "none"; return; } box.style.display = ""; box.innerHTML = `<div class="dk-det-yh">Teklif Kalemleri (${kalemler.length})</div>` + kalemler.map((k, i) => `<div class="dk-pl" style="display:flex;justify-content:space-between;align-items:center;gap:8px"><span>${esc(k.marka)} ${esc(k.ebat || "")} ${esc(k.model || "")} · <b>${k.adet} ad</b>${k.toplam_tutar ? ` · <b>₺${Number(k.toplam_tutar).toLocaleString("tr-TR")}</b>` : ""}</span><button class="dk-not-sil" data-ki="${i}">✕</button></div>`).join(""); box.querySelectorAll("[data-ki]").forEach(b => b.addEventListener("click", () => { kalemler.splice(Number(b.dataset.ki), 1); renderKalemler(); })); };
  $("tf-add").addEventListener("click", () => { const k = oku(); if (!k) { alert("Marka zorunlu."); return; } kalemler.push(k); renderKalemler(); clearForm(); });
  $("tf-save").addEventListener("click", async () => { const fk = oku(); const all = fk ? [...kalemler, fk] : [...kalemler]; if (!all.length) { alert("En az bir ürün ekleyin."); return; } const kaynak = $("tf-kaynak").value; if (!kaynak) { alert("Teklif kaynağını seçin (Telefon/WhatsApp/E-posta)."); return; } try { await api("/api/saha/teklifler", { method: "POST", body: JSON.stringify({ musteri_id: mus.id, ziyaret_id: null, kaynak, notlar: $("tf-gnot").value.trim() || null, vade_turu: $("tf-vade").value.trim() || null, kalemler: all }) }); dkKapat(); alert("✓ Teklif kaydedildi."); go("iskonto"); } catch (e) { alert(e.message); } });
}

async function teklifDetay(t) {
  const fiyat = v => v != null ? `₺${Number(v).toLocaleString("tr-TR", { minimumFractionDigits: 2 })}` : "—";
  const [dl, cls] = teklifPill(t.durum);
  let kalemler = [];
  if (Array.isArray(t.kalemler) && t.kalemler.length) kalemler = t.kalemler;
  else if (typeof t.kalemler === "string") { try { const p = JSON.parse(t.kalemler); if (Array.isArray(p)) kalemler = p; } catch { } }
  if (!kalemler.length && t.marka) kalemler = [{ marka: t.marka, model: t.model, ebat: t.ebat, adet: t.adet, birim_fiyat: t.birim_fiyat, toplam_tutar: t.toplam_tutar, tesvik_garantili_pct: t.tesvik_garantili_pct, musteri_ek_iskonto_pct: t.musteri_ek_iskonto_pct }];

  const kalemHtml = kalemler.length ? `<div style="overflow-x:auto;border:1px solid var(--cizgi);border-radius:10px;margin-top:6px"><table class="dk-t dk-kalem">
    <thead><tr><th>#</th><th>Marka / Model / Ebat</th><th class="num">Adet</th><th class="num">İst. İsk.</th><th class="num">Birim</th><th class="num">Toplam</th><th class="num">Teşvik</th></tr></thead>
    <tbody>${kalemler.map((k, i) => `<tr><td class="sub2">${i + 1}</td>
      <td><b>${esc(k.marka || "")}</b> ${esc(k.model || "")}${k.ebat ? `<div class="sub2">${esc(k.ebat)}${k.kategori ? " · " + esc(k.kategori) : ""}</div>` : ""}</td>
      <td class="num">${k.adet || 1}</td>
      <td class="num" style="${Number(k.musteri_ek_iskonto_pct) > 0 ? "color:var(--kirmizi-p);font-weight:700" : "color:var(--tx-3)"}">${Number(k.musteri_ek_iskonto_pct) > 0 ? "%" + Number(k.musteri_ek_iskonto_pct) : "—"}</td>
      <td class="num">${k.birim_fiyat != null ? fiyat(k.birim_fiyat) : "—"}</td>
      <td class="num" style="font-weight:600">${k.toplam_tutar != null ? fiyat(k.toplam_tutar) : "—"}</td>
      <td class="num" style="color:var(--mavi)">${k.tesvik_garantili_pct != null ? "%" + Number(k.tesvik_garantili_pct) : "—"}</td></tr>`).join("")}
      <tr><td colspan="5" class="num sub2" style="text-align:right">Genel Toplam</td><td class="num" style="font-weight:800">${fiyat(t.toplam_tutar)}</td><td></td></tr>
    </tbody></table></div>` : "";

  const foot = [];
  if (t.durum === "TASLAK") foot.push(`<button class="dk-btn" data-td="gonder">▶ Onaya Gönder</button>`);
  if (t.durum === "ONAY_BEKLIYOR" && S.role !== "rep") foot.push(`<button class="dk-btn dk-btn-red" data-td="reddet">✕ Reddet</button>`, `<button class="dk-btn" data-td="onayla">✓ Onayla</button>`);
  if (t.durum === "ONAYLANDI") foot.push(`<button class="dk-btn" data-td="sun">📋 Müşteriye Sun</button>`);
  if (t.durum === "SUNULDU") foot.push(`<button class="dk-btn dk-btn-red" data-td="kaybet">✕ Kaybettik</button>`, `<button class="dk-btn" data-td="kazan">✓ Kazandık</button>`);

  dkModal(`
    <div class="dk-det-head"><h3>${esc(t.firma)}</h3><span class="pill ${cls}">${dl}</span><button class="dk-x" data-kapat>✕</button></div>
    ${kalemHtml}
    ${(t.durum === "ONAY_BEKLIYOR" && S.role !== "rep") ? `<div class="dk-det-yh" style="margin-top:14px">🧭 Sistem Önerisi — Rep vs Sistem</div><div id="td-oneri" class="sub2">Yükleniyor…</div>` : ""}<!-- TEKLIF_KARAR_V1 -->
    ${t.durum === "ONAY_BEKLIYOR" ? `<div class="dk-esik" style="margin-top:12px;color:var(--sari)"><b>⚠️ Onay Bekleniyor</b> — ${t.onay_seviyesi === "GM" ? "GM" : "Müdür"} onayı gerekli${t.musteri_ek_iskonto_pct != null ? ` · İstenen ek iskonto: <b style="color:var(--kirmizi-p)">%${Number(t.musteri_ek_iskonto_pct)}</b>` : ""}</div>` : ""}
    <div class="dk-det-grid" style="margin-top:12px">
      <div class="dk-det-row"><span>Oluşturan</span><b>${esc(t.rep_full_name || "—")}</b></div>
      <div class="dk-det-row"><span>Tarih</span><b>${t.created_at ? new Date(t.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</b></div>
      ${t.kaynak ? `<div class="dk-det-row"><span>Kaynak</span><b>${esc(KAYNAK_ETK[t.kaynak] || t.kaynak)}</b></div>` : ""}
    </div>
    ${t.notlar ? `<div class="dk-det-not">${esc(t.notlar)}</div>` : ""}
    ${t.durum === "KAYBEDILDI" ? `<div class="dk-det-not" style="border-color:#f3c9c0;background:var(--kirmizi-z)">Rakip: <b>${esc(t.rakip_marka || "?")}${t.rakip_model ? " " + esc(t.rakip_model) : ""}</b>${t.rakip_fiyat ? " · " + fiyat(t.rakip_fiyat) : ""}${t.kayip_nedeni ? " · " + (KAYIP_NEDEN[t.kayip_nedeni] || t.kayip_nedeni) : ""}</div>` : ""}
    <div class="dk-det-yh" style="margin-top:16px">Değişiklik Geçmişi</div>
    <div id="td-log" class="sub2">Yükleniyor…</div>
    <div class="dk-det-alt">${S.role !== "rep" ? `<button class="dk-btn" id="td-mesaj" data-rep="${esc(t.rep_id || "")}" data-firma="${esc(t.firma || "")}" data-tid="${esc(t.id)}" style="border-color:#0284c7;color:#0284c7">💬 Mesaj</button>` : ""}${foot.join("")}<button class="dk-btn" data-kapat>Kapat</button></div>`);  /* BAGLAM_MSG_DK_V1 */

  S.container.querySelector("#td-mesaj")?.addEventListener("click", (ev) => { const b = ev.currentTarget; baglamMesajDesktop(b.dataset.rep, (b.dataset.firma || "") + " teklifi", "teklif", b.dataset.tid); });  /* BAGLAM_MSG_DK_V1 */
  // TEKLIF_KARAR_V1 — owner: rep fiyati vs sistem onerisi + saglik isigi
  if (t.durum === "ONAY_BEKLIYOR" && S.role !== "rep") (async () => {
    const box = S.container.querySelector("#td-oneri"); if (!box) return;
    const mid = t.musteri_id || t.musteri || null;
    const tl = v => `₺${Number(v).toLocaleString("tr-TR")}`;
    const out = [];
    for (const k of kalemler) {
      const marka = (k.marka || "").trim(), ebat = (k.ebat || "").trim();
      if (!marka || !ebat) continue;
      try {
        const q = new URLSearchParams({ marka, ebat });
        if (k.birim_fiyat != null) q.set("fiyat", String(k.birim_fiyat));
        if (mid) q.set("musteri_id", mid);
        const r = await api(`/api/bi/teklif-oneri?${q.toString()}`);
        if (!r || !r.veri) { out.push(`<div class="dk-log"><b>${esc(marka)} ${esc(ebat)}</b> · <span class="sub2">öneri yok</span></div>`); continue; }
        const dot = r.saglik === "kirmizi" ? "🔴" : r.saglik === "amber" ? "🟡" : r.saglik === "yesil" ? "🟢" : "⚪";
        const rep = k.birim_fiyat != null ? tl(k.birim_fiyat) : "—";
        const sis = r.oneri != null ? tl(r.oneri) : "—";
        const marj = r.rep_marj != null ? ` · rep marj <b>%${r.rep_marj}</b>` : "";
        const rakip = r.rakip && r.rakip.fiyat ? ` · ⚔ ${esc(r.rakip.marka || "rakip")} ${tl(r.rakip.fiyat)}` : "";
        const pz = (r.piyasa && r.piyasa.med != null) ? ` · piyasa ${tl(r.piyasa.med)}` : "";
        out.push(`<div class="dk-log">${dot} <b>${esc(marka)} ${esc(ebat)}</b> · rep <b>${rep}</b> vs sistem <b style="color:var(--mavi)">${sis}</b>${marj}${rakip}${pz}</div>`);
      } catch (e) { out.push(`<div class="dk-log sub2">${esc(marka)} ${esc(ebat)} · okunamadı</div>`); }
    }
    box.classList.remove("sub2");
    box.innerHTML = out.length ? out.join("") : `<div class="sub2">Fiyatlanacak kalem eşleşmedi.</div>`;
  })();
  (async () => {
    try {
      const { log = [] } = await api(`/api/saha/teklifler/${t.id}/log`);
      const el = S.container.querySelector("#td-log"); if (!el) return;
      el.classList.remove("sub2");
      el.innerHTML = log.length ? log.map(l => `<div class="dk-log"><b>${esc(l.alan)}</b>: ${l.eski_deger != null ? `<s style="opacity:.6">${esc(l.eski_deger)}</s> → ` : ""}<span style="color:var(--mavi)">${esc(l.yeni_deger)}</span><span class="sub2" style="float:right">${l.degisim_tarihi ? new Date(l.degisim_tarihi).toLocaleString("tr-TR", { dateStyle: "short", timeStyle: "short" }) : ""}${l.degistiren_ad ? " · " + esc(l.degistiren_ad) : ""}</span></div>`).join("") : `<div class="sub2">Değişiklik kaydı yok.</div>`;
    } catch { const el = S.container.querySelector("#td-log"); if (el) el.textContent = "Geçmiş yüklenemedi."; }
  })();

  const act = async (body, ok) => { try { await api(`/api/saha/teklifler/${t.id}`, { method: "PUT", body: JSON.stringify(body) }); dkKapat(); if (ok) alert(ok); go("iskonto"); } catch (e) { alert(e.message); } };
  S.container.querySelectorAll("[data-td]").forEach(b => b.addEventListener("click", () => {
    const a = b.dataset.td;
    if (a === "gonder") return act({ action: "gonder" }, "✓ Teklif gönderildi.");
    if (a === "sun") return act({ action: "sun" }, "✓ Müşteriye sunuldu.");
    if (a === "onayla") return act({ action: "onayla" }, "✓ Teklif onaylandı.");
    if (a === "reddet") { if (!confirm("Teklif reddedilsin mi? Taslağa döner.")) return; const not = prompt("Red gerekçesi (opsiyonel):"); return act({ action: "reddet", not: not || null }, "Teklif reddedildi."); }
    if (a === "kazan") { dkKapat(); teklifSonuc(t, "KAZANILDI"); }
    if (a === "kaybet") { dkKapat(); teklifSonuc(t, "KAYBEDILDI"); }
  }));
}

async function teklifSonuc(t, tip) {
  if (tip === "KAZANILDI") {
    const ozet = Number(t.kalem_sayisi) > 1 ? `${t.kalem_sayisi} kalem` : (t.marka || "");
    if (!confirm(`"${t.firma}${ozet ? " — " + ozet : ""}" teklifi KAZANILDI olarak işaretlensin mi?`)) return;
    try { await api(`/api/saha/teklifler/${t.id}`, { method: "PUT", body: JSON.stringify({ action: "sonuc", durum: "KAZANILDI" }) }); alert("✓ Tebrikler — kazanıldı olarak kaydedildi."); go("iskonto"); }
    catch (e) { alert(e.message); }
    return;
  }
  dkModal(`
    <div class="dk-det-head"><h3>Kaybedilen Teklif — ${esc(t.firma)}</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin-bottom:10px">${esc(t.marka || "")}${t.model ? " " + esc(t.model) : ""}${t.adet ? " · " + t.adet + " adet" : ""} — hangi rakibe kaybedildi?</div>
    <div class="dk-form2">
      <label>Rakip marka *<input id="ts-rmarka"></label>
      <label>Rakip model<input id="ts-rmodel"></label>
      <label>Rakip fiyat (₺)<input id="ts-rfiyat" type="number" min="0" step="0.01"></label>
      <label>Kayıp nedeni<select id="ts-neden"><option value="FIYAT">Fiyat</option><option value="VADE">Vade</option><option value="STOK">Stok</option><option value="ILISKI">İlişki</option><option value="DIGER">Diğer</option></select></label>
    </div>
    <label class="dk-form-full">Not<textarea id="ts-not" rows="2"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn dk-btn-red" id="ts-kaydet">Kaybedildi Olarak Kaydet</button></div>`);
  S.container.querySelector("#ts-kaydet").addEventListener("click", async () => {
    const g = id => (S.container.querySelector("#" + id).value || "").trim();
    if (!g("ts-rmarka")) { alert("Rakip marka zorunlu."); return; }
    try {
      await api(`/api/saha/teklifler/${t.id}`, {
        method: "PUT", body: JSON.stringify({
          action: "sonuc", durum: "KAYBEDILDI", rakip_marka: g("ts-rmarka"), rakip_model: g("ts-rmodel") || null,
          rakip_fiyat: g("ts-rfiyat") ? Number(g("ts-rfiyat")) : null, kayip_nedeni: g("ts-neden"), notlar: g("ts-not") || null
        })
      });
      dkKapat(); alert("Kayıp kaydedildi — rakip analizine eklendi."); go("iskonto");
    } catch (e) { alert(e.message); }
  });
}

// NOTLARIM — kişisel notlar/hatırlatmalar (token ile kapsamlı: her zaman "benim")
VIEWS.notlarim = async (m) => {
  const today = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  const render = async () => {
    const { notlar = [] } = await api("/api/saha/notlar");
    const bekle = notlar.filter(n => !n.tamamlandi);
    const tamam = notlar.filter(n => n.tamamlandi);
    const acil = bekle.filter(n => n.hatirlatma_tarihi && n.hatirlatma_tarihi <= today);
    m.innerHTML = `<div class="dk-wrap">
      <div class="dk-grid dk-g4" style="margin-bottom:16px">
        ${stat("Bekleyen", String(bekle.length), "")}
        ${stat("Bugün / Gecikmiş", String(acil.length), "hatırlatma")}
        ${stat("Tamamlanan", String(tamam.length), "")}
        ${stat("Toplam", String(notlar.length), "")}
      </div>
      <div class="dk-card">
        <div class="dk-card-h"><h3>Notlarım</h3><button class="dk-btn dk-btn-sm" id="not-yeni">＋ Not Ekle</button></div>
        <div id="not-liste">
          ${(bekle.length || tamam.length) ? "" : `<div class="dk-empty-s">Henüz not yok. Ziyaretlerdeki hatırlatmaları veya yapılacakları buraya ekleyin.</div>`}
          ${bekle.map(n => notKart(n, today)).join("")}
          ${tamam.length ? `<div class="dk-pl-sec" style="color:var(--tx-2)">Tamamlananlar (${tamam.length})</div>${tamam.map(n => notKart(n, today)).join("")}` : ""}
        </div>
      </div></div>`;
    m.querySelector("#not-yeni").addEventListener("click", () => notEkle(render));
    m.querySelectorAll("[data-not-id]").forEach(el => el.addEventListener("click", async ev => {
      const id = el.dataset.notId; const n = notlar.find(x => String(x.id) === id); if (!n) return;
      if (ev.target.closest("[data-toggle]")) { ev.stopPropagation(); try { await api(`/api/saha/notlar/${id}`, { method: "PUT", body: JSON.stringify({ tamamlandi: !n.tamamlandi }) }); render(); } catch (e) { alert(e.message); } return; }
      if (ev.target.closest("[data-sil]")) { ev.stopPropagation(); if (!confirm("Bu notu silmek istiyor musunuz?")) return; try { await api(`/api/saha/notlar/${id}`, { method: "DELETE" }); render(); } catch (e) { alert(e.message); } return; }
      notDuzenle(n, render);
    }));
  };
  await render();
};
function notKart(n, today) {
  const tarih = n.created_at ? new Date(n.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul", day: "numeric", month: "short" }) : "";
  const gecti = n.hatirlatma_tarihi && !n.tamamlandi && n.hatirlatma_tarihi < today;
  const bugun = n.hatirlatma_tarihi && !n.tamamlandi && n.hatirlatma_tarihi === today;
  const hstr = n.hatirlatma_tarihi ? new Date(n.hatirlatma_tarihi + "T00:00:00").toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul", day: "numeric", month: "short" }) : null;
  const hcls = gecti ? "p-crit" : bugun ? "p-warn" : "p-info";
  return `<div class="dk-not${n.tamamlandi ? " done" : ""}" data-not-id="${esc(n.id)}">
    <button class="dk-not-chk${n.tamamlandi ? " on" : ""}" data-toggle title="Tamamla">✓</button>
    <div class="dk-not-body"><div class="dk-not-txt">${esc(n.icerik)}</div>
      <div class="dk-not-meta"><span class="sub2">${tarih}</span>${n.musteri ? `<span class="dk-not-mus">🏢 ${esc(n.musteri)}</span>` : ""}${hstr ? `<span class="pill ${hcls}">⏰ ${hstr}${gecti ? " · gecikti" : bugun ? " · bugün" : ""}</span>` : ""}</div></div>
    <button class="dk-not-sil" data-sil title="Sil">🗑</button></div>`;
}
function notEkle(onSave) {
  const minT = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  dkModal(`<div class="dk-det-head"><h3>Not Ekle</h3><button class="dk-x" data-kapat>✕</button></div>
    <label class="dk-form-full">Not<textarea id="nm-icerik" rows="4" placeholder="Ne yapmam gerekiyor?"></textarea></label>
    <label class="dk-form-full">Hatırlatma Tarihi (opsiyonel)<input type="date" id="nm-tarih" min="${minT}"></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="nm-kaydet">Ekle</button></div>`);
  S.container.querySelector("#nm-kaydet").addEventListener("click", async () => {
    const icerik = (S.container.querySelector("#nm-icerik").value || "").trim(); if (!icerik) { alert("Not boş olamaz."); return; }
    const tarih = S.container.querySelector("#nm-tarih").value || null;
    try { await api("/api/saha/notlar", { method: "POST", body: JSON.stringify({ icerik, hatirlatma_tarihi: tarih, musteri_id: null }) }); dkKapat(); onSave(); } catch (e) { alert(e.message); }
  });
}
function notDuzenle(n, onSave) {
  dkModal(`<div class="dk-det-head"><h3>Notu Düzenle</h3><button class="dk-x" data-kapat>✕</button></div>
    <label class="dk-form-full">Not<textarea id="nd-icerik" rows="4">${esc(n.icerik)}</textarea></label>
    <label class="dk-form-full">Hatırlatma Tarihi<input type="date" id="nd-tarih" value="${esc(n.hatirlatma_tarihi || "")}"></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="nd-kaydet">Kaydet</button></div>`);
  S.container.querySelector("#nd-kaydet").addEventListener("click", async () => {
    const icerik = (S.container.querySelector("#nd-icerik").value || "").trim(); if (!icerik) { alert("Not boş olamaz."); return; }
    const tarih = S.container.querySelector("#nd-tarih").value || null;
    try { await api(`/api/saha/notlar/${n.id}`, { method: "PUT", body: JSON.stringify({ icerik, hatirlatma_tarihi: tarih }) }); dkKapat(); onSave(); } catch (e) { alert(e.message); }
  });
}

// REP-BRAIN — kişisel asistan & koç (canlı SSE stream + geçmiş + rota/geolokasyon)
VIEWS.asistan = async (m) => {
  m.style.padding = "0";
  let prof = {};
  try { prof = await api("/api/saha/rep-profil"); } catch { }
  const chips = [
    ["🏆 Bu haftam nasıl?", "Bu haftam nasıl gidiyor?"],
    ["🎯 Gelişim alanlarım", "Gelişim alanlarım neler? Dürüstçe analiz et."],
    ["😴 Kimi ihmal ediyorum?", "Hangi müşterileri ihmal ediyorum?"],
    ["📉 Kayıplarımı analiz et", "Son kayıplarımı analiz et, tekrarlayan neden var mı?"],
    ["💡 Bugün ne yapmalıyım?", "Bugün öncelikli olarak ne yapmalıyım?"],
    ["📍 Rota öner", "Bugün hangi müşterileri hangi sırayla ziyaret etmeliyim? Rota öner."]
  ];
  m.innerHTML = `<div class="dk-chat">
    <div class="dk-chat-head"><span style="font-size:22px">🤖</span><div style="flex:1"><div style="font-weight:700;font-size:14px">Asistan & Koç</div><div class="sub2">Kişisel asistan + gelişim koçun</div></div><button class="dk-btn dk-btn-sm" id="rb-profil">⚙️ Merkez</button></div>
    ${!prof.base_adres ? `<div class="dk-chat-banner"><span>📍 Rota önerisi için merkez konumunu ayarla.</span><button class="dk-btn dk-btn-sm" id="rb-banner">Ayarla</button></div>` : ""}
    <div class="dk-chat-msgs" id="rb-msgs"></div>
    <div class="dk-chat-chips">${chips.map(([l, mm]) => `<button class="dk-chip" data-msg="${esc(mm)}">${l}</button>`).join("")}</div>
    <div class="dk-chat-input"><textarea id="rb-input" rows="1" placeholder="Sorunuzu yazın…"></textarea><button class="dk-btn" id="rb-gonder">Gönder</button></div>
  </div>`;
  const msgsEl = m.querySelector("#rb-msgs");
  let hist = [];
  try { const d = await api("/api/saha/rep-brain?action=history"); hist = d.messages || []; } catch { }
  hist.forEach(x => rbMsg(msgsEl, x.role, x.content));
  if (!hist.length) { const t = rbThink(msgsEl); rbStreamDesk({ message: "Merhaba! Bugünkü ziyaret planımı ve son notlarımı kısaca özetle.", is_greeting: true }, t, msgsEl); }
  const send = () => {
    const inp = m.querySelector("#rb-input"); const text = (inp.value || "").trim(); if (!text) return;
    inp.value = ""; rbMsg(msgsEl, "user", text); const t = rbThink(msgsEl);
    if (/rota|güzergah|güzergâh|yol plan|ziyaret sırala|öncelik|hangisine önce|nereye|nereden başla|sırası nasıl/i.test(text) && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        p => rbStreamDesk({ message: text, is_greeting: false, current_lat: p.coords.latitude, current_lng: p.coords.longitude }, t, msgsEl),
        () => rbStreamDesk({ message: text, is_greeting: false }, t, msgsEl), { timeout: 4000, maximumAge: 60000 });
    } else rbStreamDesk({ message: text, is_greeting: false }, t, msgsEl);
  };
  m.querySelector("#rb-gonder").addEventListener("click", send);
  m.querySelector("#rb-input").addEventListener("keydown", ev => { if (ev.key === "Enter" && !ev.shiftKey) { ev.preventDefault(); send(); } });
  m.querySelectorAll(".dk-chip").forEach(c => c.addEventListener("click", () => { m.querySelector("#rb-input").value = c.dataset.msg; send(); }));
  m.querySelector("#rb-profil")?.addEventListener("click", () => repProfil(() => go("asistan")));
  m.querySelector("#rb-banner")?.addEventListener("click", () => repProfil(() => go("asistan")));
};
function rbMsg(el, role, text) { const d = document.createElement("div"); d.className = "dk-msg " + (role === "user" ? "me" : "ai"); d.textContent = text; el.appendChild(d); el.scrollTop = el.scrollHeight; return d; }
function rbThink(el) { const d = document.createElement("div"); d.className = "dk-msg ai think"; d.textContent = "Yazıyor…"; el.appendChild(d); el.scrollTop = el.scrollHeight; return d; }
async function rbStreamDesk(body, thinkEl, msgsEl) {
  try {
    const res = await fetch("/api/saha/rep-brain", { method: "POST", headers: { "Content-Type": "application/json", ...S.headers() }, body: JSON.stringify(body) });
    if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || `Hata (${res.status})`); }
    const reader = res.body.getReader(); const dec = new TextDecoder(); let full = "", buf = "";
    thinkEl.classList.remove("think");
    while (true) {
      const { done, value } = await reader.read(); if (done) break;
      buf += dec.decode(value, { stream: true }); const lines = buf.split("\n"); buf = lines.pop();
      for (const line of lines) {
        if (!line.startsWith("data: ")) continue; const raw = line.slice(6).trim(); if (raw === "[DONE]") break;
        try { const p = JSON.parse(raw); const delta = (p && p.delta && p.delta.text) || (p && p.choices && p.choices[0] && p.choices[0].delta && p.choices[0].delta.content) || (p && p.text) || ""; full += delta; thinkEl.textContent = full; msgsEl.scrollTop = msgsEl.scrollHeight; } catch { }
      }
    }
    if (!full) thinkEl.textContent = "(Yanıt alınamadı)";
  } catch (e) { thinkEl.classList.remove("think"); thinkEl.style.color = "var(--kirmizi-p)"; thinkEl.textContent = "Hata: " + e.message; }
}
function repProfil(onSave) {
  (async () => {
    let cur = {}; try { cur = await api("/api/saha/rep-profil"); } catch { }
    dkModal(`<div class="dk-det-head"><h3>📍 Merkez / Ev Konumu</h3><button class="dk-x" data-kapat>✕</button></div>
      <div class="sub2" style="margin-bottom:10px">Rota önerisi için başlangıç noktanı belirle.</div>
      <label class="dk-form-full">Adres / Şehir<input id="rp-adres" value="${esc(cur.base_adres || "")}" placeholder="örn: Ankara, Çankaya"></label>
      <div class="dk-form2"><label>Enlem<input id="rp-lat" type="number" step="0.000001" value="${cur.base_lat || ""}"></label><label>Boylam<input id="rp-lng" type="number" step="0.000001" value="${cur.base_lng || ""}"></label></div>
      <button class="dk-btn" id="rp-gps" style="width:100%;margin:6px 0">📡 GPS ile Konumumu Al</button>
      <div class="dk-det-alt"><button class="dk-btn" data-kapat>İptal</button><button class="dk-btn" id="rp-kaydet">Kaydet</button></div>`);
    const $ = id => S.container.querySelector("#" + id);
    $("rp-gps").addEventListener("click", function () { if (!navigator.geolocation) { alert("Tarayıcı konum desteklemiyor."); return; } this.textContent = "⏳ Konum alınıyor…"; navigator.geolocation.getCurrentPosition(p => { $("rp-lat").value = p.coords.latitude.toFixed(6); $("rp-lng").value = p.coords.longitude.toFixed(6); $("rp-gps").textContent = "✓ Konum alındı"; }, () => { $("rp-gps").textContent = "📡 GPS ile Konumumu Al"; alert("Konum alınamadı."); }, { timeout: 8000 }); });
    $("rp-kaydet").addEventListener("click", async () => { const adres = ($("rp-adres").value || "").trim(); const lat = parseFloat($("rp-lat").value) || null; const lng = parseFloat($("rp-lng").value) || null; if (!adres && (lat === null || lng === null)) { alert("Adres veya koordinat girilmeli."); return; } try { await api("/api/saha/rep-profil", { method: "PUT", body: JSON.stringify({ base_adres: adres, base_lat: lat, base_lng: lng }) }); dkKapat(); if (onSave) onSave(); } catch (e) { alert(e.message); } });
  })();
}

// RAKİP RADAR — internet piyasası fiyat ara / trend / eski üretim (/api/rakip/*)
// Ebat serbest yazımı kanonik forma çevir (sunucu _ebatCoz ile aynı mantık): "205 55 16" → "205/55R16"
function _ebatNorm(t) {
  if (!t) return null;
  const x = String(t).toLowerCase().replace(",", ".").trim();
  let m = x.match(/(\d{3})\D{0,3}(\d{2,3})\D{0,3}(\d{2}(?:\.5)?)/);
  if (m) { const g = +m[1], p = +m[2], c = parseFloat(m[3]); if (g >= 100 && g <= 400 && p >= 20 && p <= 90 && c >= 10 && c <= 26) return g + "/" + p + "R" + c; }
  m = x.match(/(\d{3})\s*[rc]?\s*(\d{2})\s*c?\b/);
  if (m) { const g = +m[1], c = +m[2]; if (g >= 100 && g <= 400 && c >= 10 && c <= 24) return g + "R" + c; }
  return null;
}
function rkTazelik(ts) {
  if (!ts) return '<span style="color:#9ca3af">tarih yok</span>';
  const t = new Date(ts).getTime(); if (isNaN(t)) return '<span style="color:#9ca3af">tarih yok</span>';
  const dk = Math.floor((Date.now() - t) / 60000); let metin, renk;
  if (dk < 60) { metin = dk + " dk önce"; renk = "#059669"; }
  else if (dk < 1440) { metin = Math.floor(dk / 60) + " saat önce"; renk = "#059669"; }
  else { const g = Math.floor(dk / 1440); metin = g + " gün önce"; renk = g <= 1 ? "#059669" : (g <= 3 ? "#d97706" : "#dc2626"); }
  return '<span style="color:' + renk + ';font-weight:600">🕐 ' + metin + (dk > 4320 ? " ⚠" : "") + '</span>';
}
VIEWS.rakip = (m) => {
  const tl = n => Number(n).toLocaleString("tr-TR", { maximumFractionDigits: 0 }) + " ₺";
  const bilgiler = {
    ara: "<b>İnternet piyasası.</b> Müşterinin telefonunda gördüğü fiyat. Marka veya ebat girin.",
    trend: "<b>Fiyat trendi.</b> Son 30 günde yükseliyor mu, düşüyor mu? <b>Ebat girin.</b>",
    dot: "<b>Eski üretim.</b> Rakip 2023 ve öncesi stoğu indirimle boşaltıyor mu? Marka/ebat opsiyonel."
  };
  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-seg2" id="rk-tabs"><button class="on" data-t="ara">🔍 Fiyat Ara</button><button data-t="trend">📈 Trend</button><button data-t="dot">📅 Eski Üretim</button></div>
    <div class="dk-note" id="rk-bilgi" style="margin:12px 0;display:block">${bilgiler.ara}</div>
    <div class="dk-rk-form"><input id="rk-marka" placeholder="Marka (Lassa…)"><input id="rk-ebat" placeholder="Ebat — 205 55 16 · 205/55R16 · 20555R16"><select id="rk-seg"><option value="">Tümü</option><option value="TUKETICI">🚗 Binek</option><option value="TICARI">🚚 Ticari (kamyon/van)</option></select><button class="dk-btn" id="rk-ara">Ara</button></div>
    <div id="rk-ebat-hint" class="sub2" style="margin-top:6px;min-height:16px"></div>
    <div id="rk-sonuc" style="margin-top:8px"></div>
  </div>`;
  const $ = id => m.querySelector("#" + id);
  let mod = "ara";
  const ebatVal = () => _ebatNorm($("rk-ebat").value) || $("rk-ebat").value.trim();
  const ara = async () => {
    const marka = $("rk-marka").value.trim(), ebat = ebatVal(), seg = $("rk-seg").value, box = $("rk-sonuc");
    if (!marka && !ebat) { box.innerHTML = `<div class="dk-empty-s">Marka veya ebat girin.</div>`; return; }
    box.innerHTML = `<div class="dk-load">Aranıyor…</div>`;
    try {
      const qs = new URLSearchParams({ limit: "300" });
      if (marka) qs.set("marka", marka); if (ebat) qs.set("ebat", ebat); if (seg) qs.set("segment", seg);
      const d = await api("/api/rakip/piyasa?" + qs.toString());
      const rows = (d && d.rows) || [];
      if (!rows.length) { box.innerHTML = `<div class="dk-empty-s">İnternette ilan bulunamadı.<br><span class="sub2">Veri yok = rakip yok DEĞİL. Taramamız bu üründe dar olabilir.</span></div>`; return; }
      const grup = {};
      rows.forEach(r => { const eb = r.genislik ? (r.profil == null ? r.genislik + "R" + r.cap : r.genislik + "/" + r.profil + "R" + r.cap) : "—"; const k = (r.marka || "?") + "|" + (r.desen || "") + "|" + eb; if (!grup[k]) grup[k] = { marka: r.marka, ebat: eb, model: r.model, segment: r.segment, ilan: [] }; grup[k].ilan.push(r); });
      const son = g => Math.max.apply(null, (g.ilan.map(x => x.scraped_at ? new Date(x.scraped_at).getTime() : 0)).concat([0]));
      const liste = Object.values(grup).sort((a, b) => (son(b) - son(a)) || (b.ilan.length - a.ilan.length)).slice(0, 25);
      box.innerHTML = liste.map(g => {
        const fs = g.ilan.map(x => parseFloat(x.fiyat)).filter(x => !isNaN(x)).sort((a, b) => a - b);
        if (!fs.length) return "";
        const enUcuz = fs[0], enPahali = fs[fs.length - 1], medyan = fs[Math.floor(fs.length / 2)];
        const kaynak = Object.keys(g.ilan.reduce((a, x) => (a[x.kaynak] = 1, a), {}));
        const zaman = g.ilan.map(x => x.scraped_at).filter(Boolean).map(z => new Date(z).getTime()).filter(z => !isNaN(z)).sort((a, b) => b - a);
        const enTaze = zaman[0] || null, enEski = zaman[zaman.length - 1] || null, bayat = enTaze && (Date.now() - enTaze) > 3 * 864e5;
        const eski = g.ilan.filter(x => x.uretim_yili && x.uretim_yili <= 2023);
        const ucuz = g.ilan.filter(x => parseFloat(x.fiyat) === enUcuz)[0] || {};
        return `<div class="dk-rk-card"><div style="display:flex;justify-content:space-between;gap:8px">
          <div style="min-width:0"><div style="font-weight:700;font-size:14px">${esc(g.marka)} <span style="color:#6b7280;font-weight:500">${esc((g.model || "").slice(0, 32))}</span></div><div class="num" style="font-size:12px;color:#6b7280;margin-top:2px">${esc(g.ebat)}${g.segment && g.segment !== "BINEK" ? ` <span style="background:#fef3c7;color:#92400e;border-radius:4px;padding:1px 5px;font-size:10px">🚚 Ticari</span>` : ""}</div></div>
          <div style="text-align:right;flex-shrink:0"><div style="font-size:18px;font-weight:800;color:#059669">${tl(enUcuz)}</div><div style="font-size:10px;color:#9ca3af">en ucuz</div></div></div>
          <div style="display:flex;gap:10px;margin-top:8px;font-size:11px;color:#6b7280;flex-wrap:wrap"><span>medyan <b style="color:#374151">${tl(medyan)}</b></span><span>en yüksek <b style="color:#374151">${tl(enPahali)}</b></span><span>${fs.length} ilan · ${kaynak.length} pazaryeri</span></div>
          <div style="margin-top:6px;padding-top:6px;border-top:1px dashed #e5e7eb;font-size:11px;display:flex;justify-content:space-between;gap:6px;flex-wrap:wrap"><span>${rkTazelik(enTaze ? new Date(enTaze).toISOString() : null)}</span>${enEski && enTaze && (enTaze - enEski) > 864e5 ? `<span style="color:#9ca3af">en eski ilan: ${rkTazelik(new Date(enEski).toISOString())}</span>` : ""}</div>
          ${bayat ? `<div style="margin-top:6px;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:5px 8px;font-size:11px;color:#b91c1c">⚠ <b>Bu fiyat 3 günden eski.</b> Müşteriye söylemeden önce ilanı açıp doğrulayın.</div>` : ""}
          ${eski.length ? `<div style="margin-top:6px;background:#fef2f2;border-radius:6px;padding:5px 8px;font-size:11px;color:#b91c1c">⚠ ${eski.length} ilan <b>${Math.min.apply(null, eski.map(x => x.uretim_yili))} üretim</b> — ucuzsa sebebi bu olabilir. Müşteriye söyleyin.</div>` : ""}
          ${fs.length < 5 ? `<div style="margin-top:6px;font-size:11px;color:#92400e">⚠ Az ilan (${fs.length}) — kesin yorum yapmayın.</div>` : ""}
          ${ucuz.url ? `<a href="${esc(ucuz.url)}" target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:8px;font-size:11px;color:#2563eb;text-decoration:none">En ucuz ilanı aç ↗ (${esc(ucuz.kaynak || "")})</a>` : ""}</div>`;
      }).join("");
    } catch (e) { box.innerHTML = `<div class="dk-empty-s" style="color:var(--kirmizi-p)">Hata: ${esc(e.message || "?")}</div>`; }
  };
  const trend = async () => {
    const ebat = ebatVal(), marka = $("rk-marka").value.trim(), box = $("rk-sonuc");
    if (!ebat) { box.innerHTML = `<div class="dk-empty-s">Trend için EBAT girin (örn 205/55R16).</div>`; return; }
    box.innerHTML = `<div class="dk-load">Trend çıkarılıyor…</div>`;
    try {
      const qs = new URLSearchParams({ ebat, gun: "30", grup: "piyasa" }); if (marka) qs.set("marka", marka);
      const d = await api("/api/rakip/trend?" + qs.toString());
      const seri = (d && (d.seri || d.noktalar || d.rows)) || [];
      if (seri.length < 3) { box.innerHTML = `<div class="dk-empty-s">Bu ebatta trend için yeterli gün yok.<br><span class="sub2">Az veri = fiyat sabit DEĞİL. Yorum yapmayın.</span></div>`; return; }
      const val = x => Number(x.medyan != null ? x.medyan : (x.p50 != null ? x.p50 : x.fiyat));
      const ilk = val(seri[0]), sonv = val(seri[seri.length - 1]), pct = Math.round((sonv - ilk) / ilk * 100);
      const yon = pct > 3 ? { t: "YÜKSELİYOR", c: "#dc2626", i: "↗" } : pct < -3 ? { t: "DÜŞÜYOR", c: "#059669", i: "↘" } : { t: "YATAY", c: "#6b7280", i: "→" };
      const fs = seri.map(val).filter(x => !isNaN(x)), mn = Math.min.apply(null, fs), mx = Math.max.apply(null, fs), W = 560, H = 90;
      const pts = fs.map((v, i) => ((i / Math.max(fs.length - 1, 1)) * W).toFixed(0) + "," + (H - ((v - mn) / Math.max(mx - mn, 1)) * H).toFixed(0)).join(" ");
      box.innerHTML = `<div class="dk-rk-card"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><div style="font-weight:700;font-size:15px">${esc(ebat)}${marka ? " · " + esc(marka) : ""}</div><div style="font-size:16px;font-weight:800;color:${yon.c}">${yon.i} %${Math.abs(pct)}</div></div>
        <div style="font-size:12.5px;color:${yon.c};font-weight:600;margin-bottom:10px">Son 30 gün: fiyat ${yon.t}</div>
        <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:90px"><polyline points="${pts}" fill="none" stroke="${yon.c}" stroke-width="2"/></svg>
        <div style="display:flex;justify-content:space-between;font-size:11.5px;color:#6b7280;margin-top:6px"><span>${tl(ilk)} <span style="color:#9ca3af">(30 gün önce)</span></span><span><b style="color:var(--tx-0)">${tl(sonv)}</b> bugün</span></div>
        <div style="margin-top:10px;font-size:12px;color:#6b7280;background:var(--zemin-2);border-radius:8px;padding:9px 11px">${pct > 3 ? 'Fiyat yükseliyor — müşteriye "şimdi alın" demek için gerçek bir gerekçeniz var.' : pct < -3 ? "Fiyat düşüyor — müşteri beklemek isteyebilir. Buna hazır olun." : "Fiyat yatay — acele ettirecek bir hareket yok."}</div></div>`;
    } catch (e) { box.innerHTML = `<div class="dk-empty-s" style="color:var(--kirmizi-p)">Hata: ${esc(e.message || "?")}</div>`; }
  };
  const dot = async () => {
    const marka = $("rk-marka").value.trim(), ebat = ebatVal(), box = $("rk-sonuc");
    box.innerHTML = `<div class="dk-load">Eski üretim taranıyor…</div>`;
    try {
      const qs = new URLSearchParams({ min_indirim: "20" }); if (marka) qs.set("marka", marka); if (ebat) qs.set("ebat", ebat);
      const d = await api("/api/rakip/dot?" + qs.toString());
      const f = (d && d.firsatlar) || [];
      if (!f.length) { box.innerHTML = `<div class="dk-empty-s">Bu aramada eski üretim indirimi bulunamadı.</div>`; return; }
      box.innerHTML = `<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:9px 11px;margin-bottom:10px;font-size:12px;color:#92400e"><b>Rakip eski üretim stoğunu indirimle boşaltıyor.</b> Müşteri bu fiyatı görüp size gelebilir. Fark üretim yılından — bunu <b>anlatın</b>, bizim lastiğimiz yeniyse bu bir <b>avantaj</b>.</div>` + f.slice(0, 20).map(r => `<div class="dk-rk-card"><div style="font-weight:700;font-size:13.5px">${esc(r.marka)} <span style="color:#6b7280;font-weight:500">${esc(r.desen || "")}</span></div><div class="num" style="font-size:12px;color:#6b7280;margin:2px 0 8px">${esc(r.ebat)}</div><div style="display:flex;align-items:center;gap:8px;font-size:12px;flex-wrap:wrap"><span style="background:#fee2e2;color:#b91c1c;border-radius:5px;padding:2px 7px;font-weight:700">${r.eski_yil}</span><b style="color:#b91c1c">${tl(r.eski_fiyat)}</b><span style="color:#9ca3af">→</span><span style="background:#dcfce7;color:#166534;border-radius:5px;padding:2px 7px;font-weight:700">${r.yeni_yil}</span><b style="color:#166534">${tl(r.yeni_fiyat)}</b><span style="margin-left:auto;font-weight:800;color:#dc2626">−%${r.indirim}</span></div><div style="margin-top:6px;font-size:11px;color:#6b7280">${esc(r.eski_kaynak || "")} üzerinde${r.eski_url ? ` · <a href="${esc(r.eski_url)}" target="_blank" rel="noopener noreferrer" style="color:#2563eb;text-decoration:none">ilanı aç ↗</a>` : ""}</div><div style="margin-top:4px;font-size:11px">${rkTazelik(r.scraped_at || r.son_gorulme)}</div></div>`).join("");
    } catch (e) { box.innerHTML = `<div class="dk-empty-s" style="color:var(--kirmizi-p)">Hata: ${esc(e.message || "?")}</div>`; }
  };
  const calistir = () => mod === "trend" ? trend() : mod === "dot" ? dot() : ara();
  $("rk-tabs").querySelectorAll("button").forEach(b => b.addEventListener("click", () => { mod = b.dataset.t; $("rk-tabs").querySelectorAll("button").forEach(x => x.classList.toggle("on", x === b)); $("rk-bilgi").innerHTML = bilgiler[mod]; $("rk-sonuc").innerHTML = ""; if (mod === "dot") calistir(); }));
  $("rk-ara").addEventListener("click", calistir);
  $("rk-ebat").addEventListener("input", () => {
    const n = _ebatNorm($("rk-ebat").value), raw = $("rk-ebat").value.trim();
    $("rk-ebat-hint").innerHTML = n ? `🔎 Ebat anlaşıldı: <b style="color:var(--yesil-p)">${esc(n)}</b>` : (raw ? `<span style="color:var(--sari)">Ebat formatı okunamadı — yine de aranır</span>` : "");
  });
  ["rk-marka", "rk-ebat"].forEach(id => $(id).addEventListener("keydown", ev => { if (ev.key === "Enter") calistir(); }));
};

// PİYASA — dosyalar/broşürler + rakip fiyat kayıtları + piyasa notu
VIEWS.piyasa = async (m) => {
  const [df, rf] = await Promise.all([
    api("/api/saha/piyasa-dosya").catch(() => ({ dosyalar: [] })),
    api("/api/saha/rakip-teklif?limit=30").catch(() => ({ kayitlar: [] }))
  ]);
  const dosyalar = df.dosyalar || [], kayitlar = rf.kayitlar || [];
  const TIP = { FIYAT_LISTESI: "📋 Fiyat Listesi", KAMPANYA: "🎯 Kampanya", RAKIP_TEKLIF: "🏁 Rakip Teklif", DIGER: "📎 Diğer" };
  const KYN = { ZIYARET: "🚶 Ziyaret", TELEFON: "📞 Telefon", MANUEL: "✍️ Manuel" };
  const dosyaHtml = dosyalar.length ? dosyalar.map(d => `<div class="dk-pl" data-dosya="${esc(d.id)}" style="cursor:pointer">
    <div class="dk-pl-top"><b class="firm">${esc(d.baslik || TIP[d.tip] || "Dosya")}</b><span class="pill p-info" style="margin-left:auto">${esc(TIP[d.tip] || d.tip)}</span></div>
    <div class="sub2" style="margin-top:4px">${d.rakip_marka ? esc(d.rakip_marka) + " · " : ""}${d.musteri ? esc(d.musteri) + " · " : ""}👤 ${esc(d.rep || "")} · ${d.created_at ? new Date(d.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : ""}</div>
    ${d.notlar ? `<div class="sub2" style="margin-top:3px">${esc(d.notlar)}</div>` : ""}
    <div style="text-align:right;margin-top:4px"><button class="dk-not-sil" data-sil="${esc(d.id)}">🗑 Sil</button></div></div>`).join("") : `<div class="dk-empty-s">Henüz dosya yok.</div>`;
  const priceHtml = kayitlar.length ? `<div style="overflow-x:auto"><table class="dk-t"><thead><tr><th>Rakip</th><th>Ebat</th><th class="num">Fiyat</th><th>Kaynak</th><th>Müşteri / İl</th><th>Tarih</th></tr></thead><tbody>${kayitlar.map(r => `<tr><td class="firm">${esc(r.rakip_marka || "")}${r.rakip_model ? " " + esc(r.rakip_model) : ""}</td><td class="sub2">${esc(r.ebat || "")}</td><td class="num">${r.rakip_fiyat != null ? Number(r.rakip_fiyat).toLocaleString("tr-TR") + " ₺" : "—"}</td><td class="sub2">${KYN[r.kaynak] || r.kaynak || ""}</td><td class="sub2">${esc([r.musteri, r.il].filter(Boolean).join(" / "))}</td><td class="sub2">${r.teklif_tarihi ? new Date(r.teklif_tarihi).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : ""}</td></tr>`).join("")}</tbody></table></div>` : `<div class="dk-empty-s">Henüz rakip fiyat kaydı yok.</div>`;
  m.innerHTML = `<div class="dk-wrap">
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px"><button class="dk-btn" id="pi-fiyat">🏁 Rakip Fiyat</button><button class="dk-btn" id="pi-dosya">📎 Dosya Yükle</button><button class="dk-btn" id="pi-not">📝 Piyasa Notu</button></div>
    <div class="dk-card" style="padding:0;overflow:hidden">
      <button class="dk-collapse-h" id="pi-dosya-tog"><span>📎 Dosyalar & Broşürler <span class="sub2">(${dosyalar.length})</span></span><span class="dk-chev">▾</span></button>
      <div id="pi-dosya-body" style="padding:2px 20px 16px">${dosyaHtml}</div>
    </div>
    <div class="dk-card" style="margin-top:16px;padding:0;overflow:hidden"><div class="dk-card-h" style="padding:16px 18px;margin:0;border-bottom:1px solid var(--cizgi)"><h3>🏁 Son Rakip Fiyatlar</h3><span class="sub2">${kayitlar.length}</span></div>${priceHtml}</div>
  </div>`;
  const dtog = m.querySelector("#pi-dosya-tog");
  dtog.addEventListener("click", () => { const b = m.querySelector("#pi-dosya-body"); const open = b.style.display !== "none"; b.style.display = open ? "none" : ""; dtog.querySelector(".dk-chev").style.transform = open ? "rotate(-90deg)" : ""; });
  m.querySelector("#pi-fiyat").addEventListener("click", () => rakipFiyatModal(() => go("piyasa")));
  m.querySelector("#pi-dosya").addEventListener("click", () => dosyaYukleModal(() => go("piyasa")));
  m.querySelector("#pi-not").addEventListener("click", () => piyasaNotuModal(() => go("piyasa")));
  m.querySelectorAll("[data-dosya]").forEach(el => el.addEventListener("click", async ev => {
    if (ev.target.closest("[data-sil]")) return;
    try { const res = await fetch(`/api/saha/piyasa-dosya/${el.dataset.dosya}`, { headers: S.headers() }); window.open(URL.createObjectURL(await res.blob()), "_blank"); }
    catch { alert("Dosya açılamadı."); }
  }));
  m.querySelectorAll("[data-sil]").forEach(el => el.addEventListener("click", async ev => {
    ev.stopPropagation(); if (!confirm("Bu dosya silinsin mi?")) return;
    try { await api(`/api/saha/piyasa-dosya/${el.dataset.sil}`, { method: "DELETE" }); go("piyasa"); } catch (e) { alert(e.message); }
  }));
};
function rakipFiyatModal(onSave) {
  dkModal(`<div class="dk-det-head"><h3>🏁 Rakip Fiyat Ekle</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="dk-form2"><label>Rakip Marka *<input id="rf-marka" placeholder="Michelin, Pirelli…"></label><label>Model<input id="rf-model" placeholder="opsiyonel"></label><label>Ebat *<input id="rf-ebat" placeholder="385/65R22.5"></label><label>Fiyat (₺) *<input id="rf-fiyat" type="number" min="0" step="0.01"></label><label>Kaynak<select id="rf-kaynak"><option value="ZIYARET">🚶 Ziyaret</option><option value="TELEFON">📞 Telefon</option><option value="MANUEL">✍️ Manuel</option></select></label></div>
    <label class="dk-form-full">Not<textarea id="rf-not" rows="2"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="rf-kaydet">Kaydet</button></div>`);
  const $ = id => S.container.querySelector("#" + id), g = id => ($(id).value || "").trim();
  $("rf-kaydet").addEventListener("click", async () => {
    if (!g("rf-marka") || !g("rf-ebat") || !g("rf-fiyat")) { alert("Marka, ebat ve fiyat zorunlu."); return; }
    try { await api("/api/saha/rakip-teklif", { method: "POST", body: JSON.stringify({ rakip_marka: g("rf-marka"), rakip_model: g("rf-model") || null, ebat: g("rf-ebat"), rakip_fiyat: Number(g("rf-fiyat")), kaynak: $("rf-kaynak").value, notlar: g("rf-not") || null }) }); dkKapat(); onSave(); } catch (e) { alert(e.message); }
  });
}
function dosyaYukleModal(onSave) {
  dkModal(`<div class="dk-det-head"><h3>📎 Dosya / Foto Yükle</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="dk-form2"><label>Tür<select id="dy-tip"><option value="FIYAT_LISTESI">📋 Fiyat Listesi</option><option value="KAMPANYA">🎯 Kampanya Broşürü</option><option value="RAKIP_TEKLIF">🏁 Rakip Teklif</option><option value="DIGER">📎 Diğer</option></select></label><label>Başlık<input id="dy-baslik" placeholder="ör. Michelin 2026 fiyat listesi"></label><label>Rakip Marka<input id="dy-marka" placeholder="opsiyonel"></label></div>
    <label class="dk-form-full">Not<textarea id="dy-not" rows="2"></textarea></label>
    <label class="dk-btn" style="display:inline-block;cursor:pointer;margin-bottom:8px">📎 Dosya / Foto Seç<input type="file" id="dy-file" accept="image/*,application/pdf,.xlsx,.xlsm,.xls,.csv,.doc,.docx,.txt" hidden></label>
    <div id="dy-secili" class="sub2" style="margin-bottom:6px"></div>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="dy-yukle">Yükle</button></div>`);
  const $ = id => S.container.querySelector("#" + id), g = id => ($(id).value || "").trim();
  let _data = null, _mime = null, _ad = null;
  $("dy-file").addEventListener("change", ev => {
    const f = ev.target.files[0]; if (!f) return;
    if (f.size > 8 * 1024 * 1024) { alert("Dosya 8MB'ı aşamaz."); ev.target.value = ""; return; }
    _mime = f.type; _ad = f.name; const rd = new FileReader();
    rd.onload = () => { _data = rd.result; $("dy-secili").textContent = "✓ " + f.name + " (" + Math.round(f.size / 1024) + " KB)"; };
    rd.readAsDataURL(f);
  });
  $("dy-yukle").addEventListener("click", async () => {
    if (!_data) { alert("Bir dosya seçin."); return; }
    const b = $("dy-yukle"); b.disabled = true; b.textContent = "Yükleniyor…";
    try { await api("/api/saha/piyasa-dosya", { method: "POST", body: JSON.stringify({ tip: $("dy-tip").value, baslik: g("dy-baslik") || null, rakip_marka: g("dy-marka") || null, mime: _mime, dosya_adi: _ad, data: _data, notlar: g("dy-not") || null }) }); dkKapat(); onSave(); }
    catch (e) { b.disabled = false; b.textContent = "Yükle"; alert(e.message); }
  });
}
function piyasaNotuModal(onSave) {
  dkModal(`<div class="dk-det-head"><h3>📝 Piyasa Notu Paylaş</h3><button class="dk-x" data-kapat>✕</button></div>
    <label class="dk-form-full">Başlık *<input id="pn-baslik" placeholder="ör. Michelin zam yaptı"></label>
    <label class="dk-form-full">Not *<textarea id="pn-icerik" rows="4" placeholder="Sahada duyduğun/gördüğün piyasa bilgisi…"></textarea></label>
    <div class="sub2" style="margin-bottom:8px">Bu not Duyurular › Piyasa Bilgisi olarak herkesle paylaşılır.</div>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="pn-kaydet">Paylaş</button></div>`);
  const $ = id => S.container.querySelector("#" + id), g = id => ($(id).value || "").trim();
  $("pn-kaydet").addEventListener("click", async () => {
    if (!g("pn-baslik") || !g("pn-icerik")) { alert("Başlık ve not zorunlu."); return; }
    try { await api("/api/saha/duyurular", { method: "POST", body: JSON.stringify({ baslik: g("pn-baslik"), icerik: g("pn-icerik"), tip: "PIYASA", onem: "NORMAL" }) }); dkKapat(); onSave(); } catch (e) { alert(e.message); }
  });
}

// ═══ İLETİŞİM: Duyurular · Mesajlar · Öneriler ═══
const ONERI_DURUM_RENK = { YENI: "#6b7280", INCELENIYOR: "#f59e0b", TAMAMLANDI: "#16a34a", REDDEDILDI: "#ef4444" };
const ONERI_DURUM_ETIKET = { YENI: "Yeni", INCELENIYOR: "İnceleniyor", TAMAMLANDI: "Tamamlandı", REDDEDILDI: "Reddedildi" };
const ONERI_KAT = { HATA: "🐛 Hata", OZELLIK: "✨ Özellik", UI: "🎨 Arayüz", DIGER: "💬 Diğer" };

// DUYURULAR
VIEWS.duyurular = async (m) => {
  const { duyurular = [], rep_sayisi } = await api("/api/saha/duyurular");
  const yon = S.role !== "rep";
  const onemPill = { ACIL: ["🚨 Acil", "p-crit"], YUKSEK: ["⚠️ Önemli", "p-warn"] };
  m.innerHTML = `<div class="dk-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><h3 style="margin:0">📢 Duyurular</h3><button class="dk-btn" id="dy-yeni">📢 Yeni Paylaşım</button></div>
    ${duyurular.length ? duyurular.map(d => { const unread = !d.okundu && !yon; const [pl, pc] = onemPill[d.onem] || []; return `<div class="dk-pl" data-did="${esc(d.id)}" style="cursor:pointer${unread ? ";border-left:3px solid var(--mavi)" : ""}"><div class="dk-pl-top"><b class="firm">${unread ? "● " : ""}${esc(d.baslik)}</b><span style="margin-left:auto;display:flex;gap:6px">${d.tip === "PIYASA" ? `<span class="pill p-info">📊 Piyasa</span>` : ""}${pl ? `<span class="pill ${pc}">${pl}</span>` : ""}${unread ? `<span class="pill p-info">Yeni</span>` : ""}</span></div><div class="sub2" style="margin-top:4px">${esc(d.yazan_adi)} · ${new Date(d.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" })}${Number(d.yorum_sayisi) ? " · 💬 " + d.yorum_sayisi : ""}${yon ? ` · 👁 ${d.okuyan_sayisi}/${rep_sayisi}` : ""}</div></div>`; }).join("") : `<div class="dk-empty-s">Henüz duyuru yok.</div>`}
  </div>`;
  m.querySelector("#dy-yeni").addEventListener("click", yeniDuyuru);
  m.querySelectorAll("[data-did]").forEach(el => el.addEventListener("click", () => duyuruDetay(el.dataset.did)));
};
function yeniDuyuru() {
  dkModal(`<div class="dk-det-head"><h3>Yeni Paylaşım</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="dk-form2"><label>Tür<select id="dy-tip"><option value="DUYURU">📢 Duyuru</option><option value="PIYASA">📊 Piyasa Bilgisi</option></select></label><label>Önem<select id="dy-onem"><option value="NORMAL">Normal</option><option value="YUKSEK">⚠️ Önemli</option><option value="ACIL">🚨 Acil</option></select></label></div>
    <label class="dk-form-full">Başlık *<input id="dy-baslik" placeholder="Duyuru başlığı…"></label>
    <label class="dk-form-full">İçerik *<textarea id="dy-icerik" rows="5" placeholder="Duyuru metni…"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>İptal</button><button class="dk-btn" id="dy-kaydet">Yayınla</button></div>`);
  const $ = id => S.container.querySelector("#" + id), g = id => ($(id).value || "").trim();
  $("dy-kaydet").addEventListener("click", async () => { if (!g("dy-baslik") || !g("dy-icerik")) { alert("Başlık ve içerik zorunludur."); return; } try { await api("/api/saha/duyurular", { method: "POST", body: JSON.stringify({ baslik: g("dy-baslik"), icerik: g("dy-icerik"), onem: $("dy-onem").value, tip: $("dy-tip").value }) }); dkKapat(); go("duyurular"); } catch (e) { alert(e.message); } });
}
async function duyuruDetay(did) {
  api(`/api/saha/duyurular/${did}/oku`, { method: "PUT", body: "{}" }).catch(() => {});
  let r; try { r = await api(`/api/saha/duyurular/${did}`); } catch (e) { alert(e.message); return; }
  const { duyuru: d, yorumlar = [], okuyanlar = [] } = r;
  const ROL = { admin: "GM", manager: "Müdür", rep: "Temsilci" }, onemPill = { ACIL: ["🚨 Acil", "p-crit"], YUKSEK: ["⚠️ Önemli", "p-warn"] };
  const yorumH = y => `<div style="margin-bottom:10px"><div class="dk-yorum-b"><span class="pill p-mut">${esc(ROL[y.rol] || y.rol || "")}</span> <b>${esc(y.user_adi || "")}</b> <span class="sub2" style="margin-left:auto">${y.created_at ? new Date(y.created_at).toLocaleString("tr-TR", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : ""}</span></div><div class="dk-yorum-t">${esc(y.icerik || "")}</div></div>`;
  const [pl, pc] = onemPill[d.onem] || [];
  dkModal(`<div class="dk-det-head"><h3>${esc(d.baslik)}</h3>${d.tip === "PIYASA" ? `<span class="pill p-info">📊 Piyasa</span>` : ""}${pl ? `<span class="pill ${pc}">${pl}</span>` : ""}<button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin-bottom:10px">${esc(d.yazan_adi)} · ${new Date(d.created_at).toLocaleString("tr-TR")}</div>
    <div class="dk-det-not">${esc(d.icerik)}</div>
    ${okuyanlar.length ? `<div class="sub2" style="margin-top:10px">👁 <b>${okuyanlar.length}</b> kişi okudu: ${okuyanlar.map(o => esc(o.full_name)).join(", ")}</div>` : ""}
    <div class="dk-det-yh" style="margin-top:16px">Yorumlar</div>
    <div id="dy-yorumlar">${yorumlar.length ? yorumlar.map(yorumH).join("") : `<div class="sub2">Henüz yorum yok.</div>`}</div>
    <div class="dk-yorum-yaz" style="margin-top:8px"><textarea id="dy-inp" rows="2" placeholder="Yorum yaz…"></textarea><button class="dk-btn" id="dy-gonder">Gönder</button></div>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button>${S.role !== "rep" ? `<button class="dk-btn dk-btn-red" id="dy-sil">Sil</button>` : ""}</div>`);
  const $ = id => S.container.querySelector("#" + id);
  $("dy-gonder").addEventListener("click", async () => { const inp = $("dy-inp"); const t = (inp.value || "").trim(); if (!t) return; inp.disabled = true; try { const { yorumlar: yeni = [] } = await api(`/api/saha/duyurular/${did}/yorum`, { method: "POST", body: JSON.stringify({ icerik: t }) }); inp.value = ""; $("dy-yorumlar").innerHTML = yeni.length ? yeni.map(yorumH).join("") : `<div class="sub2">Henüz yorum yok.</div>`; } catch (e) { alert(e.message); } finally { inp.disabled = false; } });
  $("dy-sil") && $("dy-sil").addEventListener("click", async () => { if (!confirm("Bu duyuruyu silmek istediğinize emin misiniz?")) return; try { await api(`/api/saha/duyurular/${did}`, { method: "DELETE" }); dkKapat(); go("duyurular"); } catch (e) { alert(e.message); } });
}

// MESAJLAR
function _dkAvatar(ad) {  /* MSG_POLISH_DK_V1 */
  const s = String(ad || "?").trim();
  const parts = s.split(/\s+/).filter(Boolean);
  const ini = (((parts[0] || "?")[0] || "?") + (parts.length > 1 ? (parts[parts.length - 1][0] || "") : "")).toLocaleUpperCase("tr");
  let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360;
  return `<span style="flex-shrink:0;width:36px;height:36px;border-radius:50%;background:hsl(${h},52%,45%);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:14px;font-weight:700">${esc(ini)}</span>`;
}
function _dkKisaTs(iso) {  /* MSG_POLISH_DK_V1 */
  try { return new Date(iso).toLocaleString("tr-TR", { timeZone: "Europe/Istanbul", day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }); } catch (e) { return ""; }
}
VIEWS.mesajlar = async (m) => {
  const data = await api("/api/saha/konusmalar");
  if (S.role === "rep") { mesajThread(m, data.konusma_id, data.mesajlar || [], data.yayimlar || [], null, data.karsi_okundu_at); return; }  /* MSG_TIK_DK_V1 */
  const { konusmalar = [], yayimlar = [], rep_toplam = 0 } = data;  /* YAYIM_OKUNDU_V1 */
  m.innerHTML = `<div class="dk-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><h3 style="margin:0">💬 Mesajlar</h3><button class="dk-btn" id="msg-yayim">📣 Hızlı Duyuru</button><!--KANAL_LABEL_DK_V1--></div>
    ${yayimlar.length ? `<div class="dk-card" style="margin-bottom:14px;background:var(--sari-z);border-color:#f0d9a8"><div class="dk-det-yh" style="color:var(--sari)">Son Hızlı Duyurular</div>${yayimlar.map((y,yi) => `<div data-yidx="${yi}" class="sub2" style="padding:4px 0;cursor:pointer">${esc(y.icerik.slice(0, 90))}${y.icerik.length > 90 ? "…" : ""} · ${_dkKisaTs(y.created_at)}${y.okuyan!=null?` · 👁 ${y.okuyan}${rep_toplam?"/"+rep_toplam:""}`:""} ›</div>`).join("")}</div>` : ""}
    <div class="dk-det-yh">Bireysel Konuşmalar</div>
    <input id="dk-msg-ara" placeholder="🔍 Temsilci ara…" style="width:100%;box-sizing:border-box;border:1px solid var(--cizgi);border-radius:9px;padding:9px 11px;font:inherit;margin-bottom:10px">
    <div id="dk-msg-liste">${konusmalar.map(k => `<div class="dk-pl dk-msg-satir" data-rep="${esc(k.rep_id)}" data-ad="${esc(k.rep_adi)}" data-ara="${esc((k.rep_adi||"").toLocaleLowerCase("tr"))}" style="display:flex;align-items:center;gap:10px;cursor:pointer${k.okunmamis ? ";border-left:3px solid var(--mavi)" : ""}${!k.son_mesaj ? ";opacity:.55" : ""}">${_dkAvatar(k.rep_adi)}<div style="flex:1;min-width:0"><div class="dk-pl-top"><b class="firm">${esc(k.rep_adi)}</b>${k.okunmamis ? `<span class="pill p-info" style="margin-left:auto">${k.okunmamis} yeni</span>` : ""}</div>${k.son_mesaj ? `<div class="sub2" style="margin-top:3px">${k.son_mesaj.gonderen_rol === "rep" ? "↩ " : ""}${esc(k.son_mesaj.icerik.slice(0, 70))}${k.son_mesaj.icerik.length > 70 ? "…" : ""} · ${_dkKisaTs(k.son_mesaj.created_at)}</div>` : `<div class="sub2" style="margin-top:3px">Henüz mesaj yok</div>`}</div></div>`).join("")}</div>
  </div>`;
  m.querySelector("#msg-yayim").addEventListener("click", yayimMesaj);
  m.querySelectorAll("[data-yidx]").forEach(el => el.addEventListener("click", () => {  /* YAYIM_CLICK_DK_V1 */
    const y = yayimlar[+el.dataset.yidx]; if (!y) return;
    dkModal(`<div class="dk-det-head"><h3>📣 Hızlı Duyuru</h3><button class="dk-x" data-kapat>✕</button></div>
      <div class="sub2" style="margin:2px 0 8px">${_dkKisaTs(y.created_at)}${y.gonderen_adi ? " · " + esc(y.gonderen_adi) : ""}${y.okuyan!=null?` · 👁 ${y.okuyan}${rep_toplam?"/"+rep_toplam:""} gördü`:""}</div>
      <div style="white-space:pre-wrap;font-size:14px;line-height:1.6">${esc(y.icerik)}</div>
      <div id="yyd-okuyan" class="sub2" style="margin-top:12px;background:var(--gri-z,#f8fafc);border-radius:8px;padding:9px 11px;line-height:1.7">Kim gördü yükleniyor…</div>
      <div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button></div>`);
    (async () => {  /* YAYIM_OKUYAN_DK_V1 */
      try {
        const r = await api("/api/saha/yayim-okuyanlar", { method: "POST", body: JSON.stringify({ icerik: y.icerik }) });
        const box = S.container.querySelector("#yyd-okuyan"); if (!box) return;
        const ok = (r.okuyanlar || []).map(x => esc(x.ad) + (x.okundu_at ? ` <span style="color:#94a3b8">(${_dkKisaTs(x.okundu_at)})</span>` : "")).join("<br>");
        const no = (r.okumayanlar || []).map(x => esc(x)).join(", ");
        box.innerHTML = `<div style="margin-bottom:6px"><b style="color:var(--mavi)">✓ Gördü (${(r.okuyanlar || []).length}):</b><br>${ok || "—"}</div><div><b style="color:#94a3b8">Görmedi (${(r.okumayanlar || []).length}):</b> ${no || "—"}</div>`;
      } catch (e) { const box = S.container.querySelector("#yyd-okuyan"); if (box) box.textContent = ""; }
    })();
  }));
  const _dkAra = m.querySelector("#dk-msg-ara");  /* MSG_POLISH_DK_V1 */
  if (_dkAra) _dkAra.addEventListener("input", () => { const q = _dkAra.value.trim().toLocaleLowerCase("tr"); m.querySelectorAll(".dk-msg-satir").forEach(r => { r.style.display = (!q || (r.dataset.ara || "").includes(q)) ? "" : "none"; }); });
  m.querySelectorAll("[data-rep]").forEach(el => el.addEventListener("click", async () => {
    m.style.padding = "0"; m.innerHTML = `<div class="dk-load" style="padding:24px">Yükleniyor…</div>`;
    try { const { konusma_id, mesajlar, karsi_okundu_at } = await api(`/api/saha/konusmalar/${el.dataset.rep}`); mesajThread(m, konusma_id, mesajlar || [], [], el.dataset.ad, karsi_okundu_at); }  /* MSG_TIK_DK_V1 */
    catch (e) { m.innerHTML = `<div class="dk-empty-s" style="padding:24px">${esc(e.message)}</div>`; }
  }));
};
function mesajThread(m, konusmaId, mesajlar, yayimlar, repAdi, karsiOkunduAt) {  /* MSG_TIK_DK_V1 */
  m.style.padding = "0";
  const all = [...mesajlar.map(x => ({ ...x, _y: false })), ...yayimlar.map(x => ({ ...x, gonderen_id: null, _y: true }))].sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
  const _sonBenim = [...all].reverse().find(x => x.gonderen_id === S.me.id && !x._y);  /* MSG_TIK_DK_V1 */
  const _goruldu = _sonBenim ? (karsiOkunduAt && new Date(karsiOkunduAt) >= new Date(_sonBenim.created_at)) : false;
  const _tikHtml = _sonBenim ? `<div style="text-align:right;font-size:11px;color:${_goruldu ? "var(--mavi)" : "#94a3b8"};margin:2px 4px 4px">${_goruldu ? "✓✓ Görüldü" : "✓ Gönderildi"}</div>` : "";
  const bubble = x => { const benim = x.gonderen_id === S.me.id; const ts = new Date(x.created_at).toLocaleString("tr-TR", { timeZone: "Europe/Istanbul", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });  /* MSG_POLISH_DK_V1 */ return `<div class="dk-mrow ${benim ? "me" : ""}"><div class="sub2" style="margin-bottom:2px">${esc(x.gonderen_adi || "")} · ${ts}${x._y ? " · 📣 Yayım" : ""}</div><div class="dk-msg ${benim ? "me" : x._y ? "yayim" : "ai"}"><!--CONTEXT_MSG_DK_V1-->${x.baglam_etiket ? `<div style="font-size:10px;opacity:.8;margin-bottom:3px">🔗 ${esc(x.baglam_etiket)}</div>` : ""}${esc(x.icerik)}</div></div>`; };
  m.innerHTML = `<div class="dk-chat">
    <div class="dk-chat-head">${repAdi ? `<button class="dk-btn dk-btn-sm" id="msg-geri">‹ Geri</button>` : ""}<div style="font-weight:700;font-size:14px">💬 ${repAdi ? esc(repAdi) : "Yönetici ile Konuşma"}</div></div>
    <div class="dk-chat-msgs" id="msg-thread">${all.length ? all.map(bubble).join("") : `<div class="dk-empty-s">Henüz mesaj yok.</div>`}${_tikHtml}</div>
    <div class="dk-chat-input"><textarea id="msg-inp" rows="1" placeholder="Mesaj yaz…"></textarea><button class="dk-btn" id="msg-gonder">Gönder</button></div>
  </div>`;
  const th = m.querySelector("#msg-thread"); th.scrollTop = th.scrollHeight;
  m.querySelector("#msg-geri") && m.querySelector("#msg-geri").addEventListener("click", () => go("mesajlar"));
  const send = async () => { const inp = m.querySelector("#msg-inp"); const text = (inp.value || "").trim(); if (!text) return; inp.disabled = true; try { await api(`/api/saha/konusmalar/${konusmaId}`, { method: "POST", body: JSON.stringify({ icerik: text }) }); th.insertAdjacentHTML("beforeend", bubble({ gonderen_id: S.me.id, gonderen_adi: S.me.name, icerik: text, created_at: new Date().toISOString(), _y: false })); th.scrollTop = th.scrollHeight; inp.value = ""; } catch (e) { alert(e.message); } finally { inp.disabled = false; } };
  m.querySelector("#msg-gonder").addEventListener("click", send);
  m.querySelector("#msg-inp").addEventListener("keydown", ev => { if (ev.key === "Enter" && !ev.shiftKey) { ev.preventDefault(); send(); } });
}
async function yayimMesaj() {
  let reps = []; try { ({ reps = [] } = await api("/api/saha/reps")); } catch { }
  dkModal(`<div class="dk-det-head"><h3>📣 Hızlı Duyuru Gönder</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin:2px 0 8px">Kısa/anlık bilgi için. Resmi & kalıcı duyuru → <b>Duyurular</b> sekmesi.</div>
    <div class="dk-det-yh">Alıcılar</div>
    <div style="border:1px solid var(--cizgi);border-radius:8px;padding:8px 10px;margin-bottom:10px;max-height:200px;overflow-y:auto">
      <label style="display:flex;align-items:center;gap:8px;font-weight:600;padding-bottom:6px;border-bottom:1px solid var(--cizgi);margin-bottom:6px;cursor:pointer"><input type="checkbox" id="yy-tum"> Tüm temsilciler</label>
      ${reps.map(r => `<label style="display:flex;align-items:center;gap:8px;padding:3px 0;cursor:pointer;font-size:13px"><input type="checkbox" class="yy-rep" data-id="${esc(r.id)}"> ${esc(r.full_name)}</label>`).join("")}
    </div>
    <label class="dk-form-full">Mesaj *<textarea id="yy-inp" rows="4" placeholder="Mesaj metni…"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>İptal</button><button class="dk-btn" id="yy-gonder">Gönder</button></div>`);
  const $ = id => S.container.querySelector("#" + id);
  $("yy-tum").addEventListener("change", function () { S.container.querySelectorAll(".yy-rep").forEach(cb => cb.checked = this.checked); });
  S.container.querySelectorAll(".yy-rep").forEach(cb => cb.addEventListener("change", () => { $("yy-tum").checked = [...S.container.querySelectorAll(".yy-rep")].every(c => c.checked); }));
  $("yy-gonder").addEventListener("click", async () => { const t = ($("yy-inp").value || "").trim(); if (!t) { alert("Mesaj boş olamaz."); return; } const tum = $("yy-tum").checked; const sec = [...S.container.querySelectorAll(".yy-rep:checked")].map(c => c.dataset.id); if (!tum && !sec.length) { alert("En az bir temsilci seçin."); return; } try { if (tum) await api("/api/saha/konusmalar/yayim", { method: "POST", body: JSON.stringify({ icerik: t }) }); else await api("/api/saha/konusmalar/coklu", { method: "POST", body: JSON.stringify({ rep_ids: sec, icerik: t }) }); dkKapat(); go("mesajlar"); } catch (e) { alert(e.message); } });
}

// ÖNERİLER
VIEWS.oneriler = async (m) => {
  const { oneriler = [], staff } = await api("/api/saha/oneriler");
  const kart = o => `<div class="dk-pl" data-oid="${esc(o.id)}" style="cursor:pointer${o.okunmamis ? ";border-left:3px solid var(--kirmizi-p)" : ""}"><div class="dk-pl-top"><b class="firm">${o.okunmamis ? "🔴 " : ""}${esc(o.baslik)}</b><span class="pill" style="margin-left:auto;background:${ONERI_DURUM_RENK[o.durum]};color:#fff">${ONERI_DURUM_ETIKET[o.durum] || o.durum}</span></div><div class="sub2" style="margin-top:3px">${esc(ONERI_KAT[o.kategori] || o.kategori)}${staff ? " · " + esc(o.kullanici || "-") : ""} · ${o.mesaj_sayisi || 1} mesaj · ${new Date(o.son_mesaj_at || o.ts).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" })}${staff && o.sahip_gordu === true && (o.mesaj_sayisi || 1) > 1 ? ` · <span style="color:var(--mavi)">✓✓ görüldü</span>` : staff && o.sahip_gordu === false ? ` · <span style="color:var(--sari)">✓ görülmedi</span>` : ""}</div></div>`;
  const acik = oneriler.filter(o => ["YENI", "INCELENIYOR"].includes(o.durum)), kapali = oneriler.filter(o => !["YENI", "INCELENIYOR"].includes(o.durum));
  m.innerHTML = `<div class="dk-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><h3 style="margin:0">💡 ${staff ? "Öneriler & Destek" : "Kayıtlarım"}</h3><button class="dk-btn" id="on-yeni">＋ Yeni</button></div>
    ${!oneriler.length ? `<div class="dk-empty-s">Henüz kayıt yok.</div>` : ""}
    ${acik.length ? `<div class="dk-det-yh">Açık (${acik.length})</div>${acik.map(kart).join("")}` : ""}
    ${kapali.length ? `<div class="dk-det-yh" style="margin-top:14px">Kapanmış (${kapali.length})</div>${kapali.map(kart).join("")}` : ""}
  </div>`;
  m.querySelector("#on-yeni").addEventListener("click", () => oneriModal(() => go("oneriler")));
  m.querySelectorAll("[data-oid]").forEach(el => el.addEventListener("click", () => oneriThread(el.dataset.oid, () => go("oneriler"))));
};
async function oneriThread(id, onSave) {
  let d; try { d = await api(`/api/saha/oneriler/${id}`); } catch (e) { alert(e.message); return; }
  const { oneri: o, mesajlar = [], staff, ben } = d;
  const satir = mm => mm.tip === "DURUM" ? `<div style="text-align:center;margin:8px 0"><span class="pill p-mut">${esc(mm.mesaj)} · ${esc(mm.yazar)}</span></div>` : `<div class="dk-mrow ${mm.user_id === ben ? "me" : ""}"><div class="dk-msg ${mm.user_id === ben ? "me" : "ai"}">${esc(mm.mesaj)}</div><div class="sub2" style="margin-top:2px">${esc(mm.yazar)} · ${new Date(mm.ts).toLocaleString("tr-TR")}</div></div>`;
  dkModal(`<div class="dk-det-head"><h3>${esc(o.baslik)}</h3><span class="pill" style="background:${ONERI_DURUM_RENK[o.durum]};color:#fff">${ONERI_DURUM_ETIKET[o.durum] || o.durum}</span><button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin-bottom:10px">${esc(ONERI_KAT[o.kategori] || o.kategori)} · ${esc(o.kullanici || "-")} · ${new Date(o.ts).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" })}</div>
    <div id="ot-thread" style="max-height:340px;overflow-y:auto;padding:10px;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:10px;display:flex;flex-direction:column;gap:4px">${mesajlar.map(satir).join("")}</div>
    ${staff ? `<label class="dk-form-full" style="margin-top:10px">Durum<select id="ot-durum">${Object.entries(ONERI_DURUM_ETIKET).map(([k, l]) => `<option value="${k}" ${o.durum === k ? "selected" : ""}>${l}</option>`).join("")}</select></label>` : ""}
    <label class="dk-form-full">${staff ? "Yanıt" : "Yeni mesaj"}<textarea id="ot-mesaj" rows="3" placeholder="${staff ? "Yanıtınızı yazın…" : "Eklemek istediğiniz bir şey var mı?"}"></textarea></label>
    <div class="dk-det-alt">${staff ? `<button class="dk-btn dk-btn-red" id="ot-sil" style="margin-right:auto">🗑 Sil</button>` : ""}<button class="dk-btn" data-kapat>Kapat</button><button class="dk-btn" id="ot-gonder">Gönder</button></div>`);
  const $ = id => S.container.querySelector("#" + id);
  const th = $("ot-thread"); th.scrollTop = th.scrollHeight;
  $("ot-sil") && $("ot-sil").addEventListener("click", async () => { if (!confirm(`"${o.baslik}" kaydı ve tüm mesajları kalıcı olarak silinecek. Devam edilsin mi?`)) return; try { await api(`/api/saha/oneriler/${id}`, { method: "DELETE" }); dkKapat(); onSave(); } catch (e) { alert(e.message); } });
  $("ot-gonder").addEventListener("click", async () => { const mesaj = ($("ot-mesaj").value || "").trim(); const yeni = staff ? $("ot-durum").value : null; const deg = staff && yeni && yeni !== o.durum; if (!mesaj && !deg) { alert("Bir mesaj yazın veya durumu değiştirin."); return; } const b = $("ot-gonder"); b.disabled = true; try { if (staff && (deg || mesaj)) await api(`/api/saha/oneriler/${id}`, { method: "PUT", body: JSON.stringify({ durum: deg ? yeni : null, yonetici_notu: mesaj || null }) }); else if (mesaj) await api(`/api/saha/oneriler/${id}/mesaj`, { method: "POST", body: JSON.stringify({ mesaj }) }); dkKapat(); onSave(); } catch (e) { b.disabled = false; alert(e.message); } });
}
async function oneriModal(onSave) {
  const KAT = { HATA: "🐛 Hata Bildirimi", OZELLIK: "✨ Özellik İsteği", UI: "🎨 Arayüz", DIGER: "💬 Diğer" };
  dkModal(`<div class="dk-det-head"><h3>💡 Öneri & Geri Bildirim</h3><button class="dk-x" data-kapat>✕</button></div>
    <label class="dk-form-full">Kategori<select id="om-kat">${Object.entries(KAT).map(([v, l]) => `<option value="${v}">${l}</option>`).join("")}</select></label>
    <label class="dk-form-full">Başlık *<input id="om-baslik" maxlength="120" placeholder="Kısa bir özet…"></label>
    <label class="dk-form-full">Açıklama *<textarea id="om-mesaj" rows="4" placeholder="Ne olmasını istiyorsunuz? Neden?"></textarea></label>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="om-gonder">Gönder</button></div>`);
  const $ = id => S.container.querySelector("#" + id), g = id => ($(id).value || "").trim();
  $("om-gonder").addEventListener("click", async () => { if (!g("om-baslik") || !g("om-mesaj")) { alert("Başlık ve açıklama zorunludur."); return; } const b = $("om-gonder"); b.disabled = true; try { await api("/api/saha/oneri", { method: "POST", body: JSON.stringify({ kategori: $("om-kat").value, baslik: g("om-baslik"), mesaj: g("om-mesaj") }) }); dkKapat(); alert("✓ Öneriniz iletildi, teşekkürler!"); if (onSave) onSave(); } catch (e) { b.disabled = false; alert(e.message); } });
}

// ── Leaflet yükleyici (harita + kokpit paylaşır) ─────────────────────────────
let _leafletP = null;
function ensureLeaflet() {
  if (window.L) return Promise.resolve();
  if (_leafletP) return _leafletP;
  _leafletP = new Promise((resolve, reject) => {
    const css = document.createElement("link");
    css.rel = "stylesheet"; css.href = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css";
    document.head.appendChild(css);
    const sc = document.createElement("script");
    sc.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js";
    sc.onload = () => resolve();
    sc.onerror = () => { _leafletP = null; reject(new Error("Leaflet yüklenemedi (ağ/CSP)")); };
    document.head.appendChild(sc);
  });
  return _leafletP;
}
function yolTarifi(lat, lng) {
  window.open(`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`, "_blank");
}
// 81 il — dropdown'a hepsini koyarız (ziyaret kaydı olmasa da her ilin ERP/finansal verisi görülebilsin)
const TR_ILLER = ["Adana", "Adıyaman", "Afyonkarahisar", "Ağrı", "Amasya", "Ankara", "Antalya", "Artvin", "Aydın", "Balıkesir", "Bilecik", "Bingöl", "Bitlis", "Bolu", "Burdur", "Bursa", "Çanakkale", "Çankırı", "Çorum", "Denizli", "Diyarbakır", "Edirne", "Elazığ", "Erzincan", "Erzurum", "Eskişehir", "Gaziantep", "Giresun", "Gümüşhane", "Hakkari", "Hatay", "Isparta", "Mersin", "İstanbul", "İzmir", "Kars", "Kastamonu", "Kayseri", "Kırklareli", "Kırşehir", "Kocaeli", "Konya", "Kütahya", "Malatya", "Manisa", "Kahramanmaraş", "Mardin", "Muğla", "Muş", "Nevşehir", "Niğde", "Ordu", "Rize", "Sakarya", "Samsun", "Siirt", "Sinop", "Sivas", "Tekirdağ", "Tokat", "Trabzon", "Tunceli", "Şanlıurfa", "Uşak", "Van", "Yozgat", "Zonguldak", "Aksaray", "Bayburt", "Karaman", "Kırıkkale", "Batman", "Şırnak", "Bartın", "Ardahan", "Iğdır", "Yalova", "Karabük", "Kilis", "Osmaniye", "Düzce"];

// ── RAPOR (Analiz) — dönemsel saha performansı; mgr-only nav ──────────────────
// Alt sekmeler: Özet · Temsilciler(mgr) · Pipeline · Pazar. Harita ayrı nav öğesi.
VIEWS.rapor = (m) => {
  const isMgr = ["manager", "admin"].includes(S.role);
  const simdi = new Date();
  const ayBasi = new Date(simdi.getFullYear(), simdi.getMonth(), 1).toISOString().slice(0, 10);
  const bugun = simdi.toISOString().slice(0, 10);

  const _rd = (S.sub && S.sub.permissions && Array.isArray(S.sub.permissions.departments)) ? S.sub.permissions.departments : [];  /* IZIN_YENIMODUL_DK_V1 */
  const _rNEW = ["ciro", "risk", "rotam", "etki", "portfoy", "pipeline", "pazar"], _rHASNEW = ["ciro", "risk", "rotam"], _rHasNew = _rd.some(d => _rHASNEW.includes(d));  /* SEKME_CAP_DK_V1 — flip anahtari orijinal set */
  const _rTabOk = (id) => (S.role === "admin") ? true : (!_rNEW.includes(id) ? true : (_rd.length ? _rd.includes(id) : (["etki", "portfoy", "pipeline", "pazar"].includes(id) ? true : (S.role === "rep" ? id === "rotam" : true))));  /* SEKME_CAP_FIX_V1 — deny-by-default */  /* SEKME_CAP_DK_V1 */  /* IZIN_ROLDEF_SH_V1 */
  const tabs = [
    ["ozet", "📊 Özet"],
    ["ciro", "💰 Ciro"],  /* CIRO_UI2_DK_V1 */
    ["risk", "🚨 Risk"],  /* RISK_SAHA_DK_V1 */
    ["etki", "📈 Saha ROI"],  /* ZIYARET_ETKI_DK_V1 */
    ["portfoy", "🩺 Portföy"],  /* PORTFOY_DK_V1 */
    ["rotam", (S.role !== "rep") ? "🌅 Bugün Sahada" : "🌅 Rotam"],  /* SABAH_ROTAM_DK_V1 DK_V3 RAPOR_KONTROL_DK_V1 RAPOR_KONTROL_DK_V2 */
    ...(isMgr ? [["kapsam", "📍 Kapsam"], ["temsilciler", "👥 Temsilciler"]] : []),  /* KAPSAM_DK_V1 */
    ["pipeline", "💼 Pipeline"],
    ["pazar", "🎯 Pazar"]
  ].filter(([id]) => _rTabOk(id));  /* IZIN_YENIMODUL_DK_V1 */
  let aktif = "ozet";

  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-card rp-bar">
      <div class="rp-presets">
        ${[["7 gün", 7], ["30 gün", 30], ["3 ay", 90], ["1 yıl", 365]].map(([l, d]) =>
    `<button class="rp-preset" data-days="${d}">${l}</button>`).join("")}
      </div>
      <div class="rp-range">
        <button class="dk-icobtn" id="rp-prev" title="Önceki dönem">‹</button>
        <input type="date" class="rp-date" id="rp-from" value="${new Date(simdi.getTime() - 29 * 864e5).toISOString().slice(0, 10)}"><!--RAPOR_DEF30_DK_V1-->
        <span class="rp-arrow">→</span>
        <input type="date" class="rp-date" id="rp-to" value="${bugun}">
        <button class="dk-icobtn" id="rp-next" title="Sonraki dönem">›</button>
      </div>
    </div>
    <div class="dk-seg2 rp-tabs" id="rp-tabs" style="margin:16px 0 4px">
      ${tabs.map(([id, l], i) => `<button class="${i === 0 ? "on" : ""}" data-t="${id}">${l}</button>`).join("")}
    </div>
    <div id="rp-icerik"></div>
  </div>`;

  const $ = id => m.querySelector("#" + id);
  const rpFrom = () => $("rp-from")?.value || new Date(simdi.getTime() - 29 * 864e5).toISOString().slice(0, 10);  /* RAPOR_DEF30_DK_V1 */
  const rpTo = () => $("rp-to")?.value || bugun;
  const icerik = () => $("rp-icerik");
  const sech = (txt, clr, tip) =>
    `<div class="dk-sech" style="border-left-color:${clr}">${esc(txt)}${tip ? `<span class="dk-i" title="${esc(tip)}">i</span>` : ""}</div>`;
  const load = () => `<div class="dk-load">Yükleniyor…</div>`;
  const hataH = e => `<div class="dk-empty-s" style="color:var(--kirmizi-p)">${esc(e.message || e || "Yüklenemedi")}</div>`;

  async function rpEtki() {  /* ZIYARET_ETKI_DK_V1 */
    const el = icerik(); if (!el) return; el.innerHTML = load();
    let d; try { d = await api(`/api/saha/rapor/ziyaret-etki?_=1${tipQS()}`); } catch (e) { const b0 = icerik(); if (b0) b0.innerHTML = hataH(e); return; }
    const box = icerik(); if (!box) return;
    const o = d.ozet || {}, dn = d.donem || {}, kp = d.kapsam || {}, gr = (d.gruplar || []);
    const rep = d.rol === "rep";
    const AZ = 12;
    const pctR = (n) => n == null ? "—" : Math.round(n) + "%";
    const kTL = (n) => { n = Math.round(Number(n) || 0); const a = Math.abs(n); if (a >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (a >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + n; };
    const term = (t, tip) => `<span class="term" title="${esc(tip)}">${t}</span>`;
    const withT = gr.filter((g) => g.taban > 0);
    const g0 = gr[0], gHi = withT.length ? withT[withT.length - 1] : null;
    const CSS = `<style>
      .se{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--cizgi-g:rgba(0,0,0,.16);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mavi:#2a78d6;--mavi-z:#EAF2FC;--sh:0 1px 2px rgba(16,16,26,.05),0 6px 22px rgba(16,16,26,.045);color-scheme:light;color:var(--tx-0);font-family:var(--sans,system-ui,-apple-system,'Segoe UI',sans-serif);-webkit-font-smoothing:antialiased}
      .se *{box-sizing:border-box}
      .term{border-bottom:1px dotted var(--tx-3);cursor:help}
      .tech{font-size:10.5px;font-weight:600;color:var(--tx-3);font-style:italic;margin-left:7px}
      .se-kick{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:2px 2px 12px}
      .se-kick .t{font-size:11px;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:var(--tx-2)}
      .se-kick .p{font-size:11px;font-weight:700;color:var(--tx-2);background:var(--zemin-2);padding:5px 12px;border-radius:999px}
      .ctx{display:flex;gap:10px;background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:12px;padding:12px 15px;margin-bottom:13px;font-size:12px;line-height:1.55;color:var(--tx-1)}
      .ctx .ic{flex:0 0 auto;font-size:15px}.ctx b{color:var(--tx-0)}
      .se-hero{background:linear-gradient(180deg,#fff,#FCFEFD);border:1px solid var(--cizgi);border-radius:20px;padding:22px 24px;box-shadow:var(--sh);margin-bottom:13px}
      .hq{font-size:12.5px;font-weight:600;color:var(--tx-2);margin-bottom:9px}
      .verdict{font-size:19px;font-weight:750;line-height:1.42;color:var(--tx-0);letter-spacing:-.01em}
      .verdict b{color:var(--yesil)}
      .rt{display:flex;flex-direction:column;gap:13px;margin-top:22px}
      .rt-row{display:grid;grid-template-columns:230px 1fr;gap:18px;align-items:center}
      .rt-lab .nm{font-size:13.5px;font-weight:700;color:var(--tx-0)}
      .rt-lab .nm .frq{color:var(--tx-2);font-weight:600;font-size:11.5px;margin-left:5px}
      .rt-lab .sub{font-size:11px;color:var(--tx-2);margin-top:2px;font-variant-numeric:tabular-nums}
      .rt-bar{position:relative;height:32px}
      .rt-tk{position:absolute;inset:0;background:var(--zemin-2);border-radius:9px}
      .rt-fl{position:absolute;top:0;bottom:0;left:0;border-radius:9px;background:linear-gradient(90deg,#1a936a,var(--yesil));min-width:4px;box-shadow:inset 0 1px 0 rgba(255,255,255,.12)}
      .rt-fl.lo{background:linear-gradient(90deg,#d68a3a,var(--sari))}
      .rt-v{position:absolute;top:50%;transform:translateY(-50%);font-size:15px;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
      .rt-axis{display:grid;grid-template-columns:230px 1fr;gap:18px;margin-top:4px}
      .rt-axis .ax{position:relative;height:14px;font-size:10px;color:var(--tx-3);font-variant-numeric:tabular-nums}
      .rt-axis .ax span{position:absolute;transform:translateX(-50%)}
      .card{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:18px;padding:20px 22px;box-shadow:var(--sh);margin-bottom:13px}
      .se-h{display:flex;align-items:baseline;gap:2px;margin-bottom:3px;flex-wrap:wrap}
      .se-h .tick{width:4px;height:15px;border-radius:2px;background:var(--yesil);transform:translateY(2px);margin-right:9px}
      .se-h h4{margin:0;font-size:15px;font-weight:800;color:var(--tx-0)}
      .se-sub{font-size:12px;color:var(--tx-1);line-height:1.55;margin:7px 0 4px 13px}.se-sub b{color:var(--tx-0)}
      .ihmal{display:flex;gap:13px;align-items:center;background:var(--kirmizi-z);border:1px solid rgba(196,61,40,.2);border-radius:14px;padding:15px 17px;margin-bottom:13px}
      .ihmal .big{font-size:30px;font-weight:820;color:var(--kirmizi);line-height:1;font-variant-numeric:tabular-nums;flex:0 0 auto}
      .ihmal .tx{font-size:12.5px;line-height:1.5;color:#7a2a1a}.ihmal .tx b{color:#5c1f13}
      .baz{background:var(--mavi-z);border-radius:12px;padding:13px 15px;margin-bottom:13px;font-size:12px;line-height:1.55;color:#1c4f8f}.baz b{color:#123563}
      .baz .row{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px}
      .baz .chip{font-size:11px;background:#fff;border:1px solid rgba(37,99,235,.18);border-radius:999px;padding:3px 10px;color:#1c4f8f;font-weight:600;font-variant-numeric:tabular-nums}
      .how{background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:14px;padding:16px 18px;margin-bottom:13px}
      .how h4{margin:0 0 9px;font-size:13px;font-weight:800;color:var(--tx-1)}
      .how div{font-size:12px;color:var(--tx-1);line-height:1.6;margin-bottom:6px}.how b{color:var(--tx-0)}.how code{background:var(--zemin-2);padding:1px 6px;border-radius:5px;font-size:10.5px}
      .se-foot{padding:13px 15px;background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:12px;font-size:11px;line-height:1.65;color:var(--tx-2)}.se-foot b{color:var(--tx-1)}.se-foot .dot{color:var(--tx-3);margin:0 6px}
      .se-empty{color:var(--tx-2);text-align:center;padding:22px;font-size:13px}
    </style>`;
    const KICK = `<div class="se-kick"><span class="t">📈 Saha ROI · ziyaret sıklığı → tekrar-alım</span><span class="p">son 12 ay</span></div>`;
    const CTX = rep
      ? `<div class="ctx"><span class="ic">📍</span><div>Senin defterinde <b>${kp.matched || 0}</b> aktif müşteri; son 12 ayda <b>${kp.ziyaret_edilmis || 0}'ine</b> (%${Math.round(kp.pct || 0)}) uğramışsın. Aşağıda <b>ne kadar sık ziyaret ettiğin</b> ile müşterinin ${term("geri gelmesi", "H1'de (önceki 6 ay) alan müşterinin H2'de (son 6 ay) de alması. Tutara duyarsız.")} arasındaki ilişki. Az müşterili gruplarda sayı oynak — 'az örnek' etiketine dikkat.</div></div>`
      : `<div class="ctx"><span class="ic">📍</span><div>Saha ekibi <b>${kp.matched || 0}</b> aktif müşterinin <b>${kp.ziyaret_edilmis || 0}'ine</b> (%${Math.round(kp.pct || 0)}) uğramış. Kapsam neredeyse tam olduğundan "ziyaret edilen vs edilmeyen" kıyası kurulamaz (karşı-grup yok) — bunun yerine <b>ziyaret sıklığının</b> ${term("tekrar-alımla", "H1'de (önceki 6 ay) alan müşterinin H2'de (son 6 ay) de alması. Tutara duyarsız, sağlam ölçüt.")} ilişkisine bakıyoruz.</div></div>`;
    const verdict = (g0 && gHi && g0.retention != null && gHi.retention != null)
      ? `Daha sık ziyaret edilen müşteri daha çok geri geliyor: yılda <b>hiç uğranmayanın %${Math.round(g0.retention)}'ı</b> tekrar alırken, <b>${esc(gHi.aralik)} ziyaret edilenin %${Math.round(gHi.retention)}'ı</b> tekrar alıyor.`
      : `Ziyaret sıklığı ile tekrar-alım ilişkisi (aşağıda).`;
    const maxAx = 100;
    const rtRows = gr.map((g) => {
      const az = (g.taban || 0) < AZ;
      const w = g.retention == null ? 0 : Math.max(4, g.retention / maxAx * 100);
      const inside = (g.retention || 0) > 16;
      const vst = inside ? `right:calc(${100 - w}% + 10px);color:#fff` : `left:calc(${w}% + 10px);color:var(--tx-0)`;
      const lo = (g.retention != null && g.retention < 65);
      return `<div class="rt-row">
        <div class="rt-lab"><div class="nm">${esc(g.etiket)}<span class="frq">${esc(g.aralik)} ziyaret/yıl</span></div><div class="sub">${g.taban || 0} müşteri${az ? " · az örnek" : ""}</div></div>
        <div class="rt-bar"><div class="rt-tk"></div><div class="rt-fl ${lo ? "lo" : ""}" style="width:${w}%"></div><span class="rt-v" style="${vst}">${pctR(g.retention)}</span></div></div>`;
    }).join("");
    const AXIS = `<div class="rt-axis"><div></div><div class="ax"><span style="left:0">0%</span><span style="left:50%">50%</span><span style="left:100%">100%</span></div></div>`;
    const HERO = `<div class="se-hero"><div class="hq">Daha çok ziyaret, müşteriyi elde tutuyor mu?</div>
      <div class="verdict">${verdict}</div>
      <div class="rt">${rtRows || `<div class="se-empty">Veri yok</div>`}</div>${gr.length ? AXIS : ""}</div>`;
    const IHMAL = (o.ihmal_n) ? `<div class="ihmal"><div class="big">${o.ihmal_n}</div><div class="tx"><b>${rep ? "müşterine son 12 ayda hiç uğramamışsın." : "müşteri son 12 ayda hiç ziyaret edilmemiş."}</b> Ortalama yıllık cirosu <b>${kTL(o.ihmal_ort_ciro)}</b>, tekrar-alımı yalnız <b>%${Math.round(o.ihmal_retention || 0)}</b> — en riskli cep. ${rep ? "Sabah Rotam ve Kapsam'da tek tek görünür." : "(Kapsam raporunda tek tek görünür.)"}</div></div>` : "";
    const bazChips = withT.map((g) => `<span class="chip">${esc(g.aralik)}: ${kTL(g.ort_ciro)}</span>`).join("");
    const BAZ = `<div class="baz"><b>⚖️ Kıyas adil mi?</b> Bu bir <b>korelasyondur</b>, nedensellik değil — sık ziyaret edilen müşteriler zaten daha büyük/bağlı olabilir. Grupların öncesi ortalama cirosu (aşağıda) farklıysa etkiyi tek başına ziyarete yıkma.<div class="row">${bazChips}</div></div>`;
    const HOW = `<div class="how"><h4>Nasıl hesaplanıyor?</h4>
      <div><b>Ziyaret sıklığı</b> = son 12 ayda tamamlanmış ziyaret sayısı; müşteriler 0 / 1-3 / 4-8 / 9+ gruplarına ayrılır.</div>
      <div><b>Tekrar-alım</b> = önceki 6 ayda (H1) alan müşterilerin, son 6 ayda (H2) da alma oranı. Ciro <b>tutarına duyarsız</b> — bir kişi bir kez bile alsa "geri geldi" sayılır; bu yüzden birkaç dev müşteri ya da düzensiz alım sonucu bozmaz.</div>
      <div>Eşleşme müşteri koduyla (<code>musteri_kodu</code>); yalnız H1'de alan müşteriler paydaya girer. Ciro <b>büyümesi</b> KRB'de birkaç büyük müşteri + düzensiz alımla çok dağınık olduğundan manşet yapılmadı.</div></div>`;
    const FOOT = `<div class="se-foot"><b>Genel tekrar-alım %${Math.round(o.genel_retention || 0)}</b> (${o.taban_toplam || 0} müşteri paydada)<span class="dot">·</span>Sıklık dönemi ${dn.yil ? dn.yil.join(" → ") : "—"}<span class="dot">·</span>H1 ${dn.h1 ? dn.h1.join(" → ") : "—"}<span class="dot">·</span>H2 ${dn.h2 ? dn.h2.join(" → ") : "—"}. Veri sonu ${dn.veri_sonu || "—"}.</div>`;
    box.innerHTML = CSS + `<div class="se">${KICK}${CTX}${HERO}${IHMAL}${BAZ}${HOW}${FOOT}</div>`;
  }
  async function rpPortfoy() {  /* PORTFOY_DK_V1 */
    const el = icerik(); if (!el) return; el.innerHTML = load();
    let d; try { d = await api(`/api/saha/rapor/portfoy?_=1${tipQS()}`); } catch (e) { const b0 = icerik(); if (b0) b0.innerHTML = hataH(e); return; }
    const box = icerik(); if (!box) return;
    const o = d.ozet || {}, ban = (d.bantlar || []), lst = (d.liste || []), tem = (d.temsilci || []);
    const rep = d.rol === "rep";
    const kTL = (n) => { n = Math.round(Number(n) || 0); const a = Math.abs(n); if (a >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (a >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + n; };
    const durTxt = { aktif: "🟢 Aktif", soguyor: "🟡 Soğuyor", pasif: "🔴 Pasif" };
    const recTxt = (r) => r == null ? "—" : (r <= 0 ? "bu ay" : r + " ay önce");
    const term = (t, tip) => `<span class="term" title="${esc(tip)}">${t}</span>`;
    const riskN = (Number(o.soguyor) || 0) + (Number(o.pasif) || 0);
    const maxBand = Math.max(1, ...ban.map(b => Number(b.ciro) || 0));
    const CSS = `<style>
      .pf{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--cizgi-g:rgba(0,0,0,.16);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mavi:#2a78d6;--mavi-z:#EAF2FC;--sh:0 1px 2px rgba(16,16,26,.05),0 6px 22px rgba(16,16,26,.045);color-scheme:light;color:var(--tx-0);font-family:var(--sans,system-ui,-apple-system,'Segoe UI',sans-serif);-webkit-font-smoothing:antialiased}
      .pf *{box-sizing:border-box}
      .pf .term{border-bottom:1px dotted var(--tx-3);cursor:help}
      .pf-kick{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:2px 2px 12px}
      .pf-kick .t{font-size:11px;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:var(--tx-2)}
      .pf-kick .p{font-size:11px;font-weight:700;color:var(--tx-2);background:var(--zemin-2);padding:5px 12px;border-radius:999px}
      .pf-ctx{display:flex;gap:10px;background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:12px;padding:12px 15px;margin-bottom:13px;font-size:12px;line-height:1.55;color:var(--tx-1)}
      .pf-ctx .ic{flex:0 0 auto;font-size:15px}.pf-ctx b{color:var(--tx-0)}
      .pf-hero{background:linear-gradient(180deg,#fff,#FEFCFB);border:1px solid var(--cizgi);border-radius:20px;padding:22px 24px;box-shadow:var(--sh);margin-bottom:13px}
      .pf-hq{font-size:12.5px;font-weight:600;color:var(--tx-2);margin-bottom:7px}
      .pf-big{font-size:34px;font-weight:820;letter-spacing:-.02em;line-height:1;color:var(--kirmizi);font-variant-numeric:tabular-nums}
      .pf-hs{font-size:13.5px;color:var(--tx-1);margin-top:9px;line-height:1.5}.pf-hs b{color:var(--tx-0)}
      .pf-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:16px 0 13px}
      .pf-tile{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:14px 15px;position:relative;overflow:hidden}
      .pf-tile:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
      .pf-tile.ak:before{background:var(--yesil)}.pf-tile.so:before{background:var(--sari)}.pf-tile.pa:before{background:var(--kirmizi)}
      .pf-tile .n{font-size:25px;font-weight:800;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
      .pf-tile.so .n{color:var(--sari)}.pf-tile.pa .n{color:var(--kirmizi)}.pf-tile.ak .n{color:var(--yesil)}
      .pf-tile .l{font-size:12px;color:var(--tx-1);margin-top:6px;font-weight:700}
      .pf-tile .sx{font-size:10.5px;color:var(--tx-2);margin-top:2px;font-variant-numeric:tabular-nums}
      .pf-card{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:16px;padding:18px 20px;box-shadow:var(--sh);margin-bottom:13px}
      .pf-ch{display:flex;align-items:baseline;gap:9px;margin-bottom:12px}
      .pf-ch .tick{width:4px;height:15px;border-radius:2px;background:var(--tx-3);transform:translateY(2px)}
      .pf-ch h4{margin:0;font-size:15px;font-weight:800;color:var(--tx-0)}.pf-ch .sub{font-size:11px;color:var(--tx-2)}
      .pf-bd{display:flex;flex-direction:column;gap:10px}
      .pf-brow{display:grid;grid-template-columns:96px 1fr auto;gap:12px;align-items:center}
      .pf-blab{font-size:12.5px;font-weight:700;color:var(--tx-1);font-variant-numeric:tabular-nums}
      .pf-bbar{position:relative;height:22px;background:var(--zemin-2);border-radius:7px;overflow:hidden}
      .pf-bfl{position:absolute;left:0;top:0;bottom:0;border-radius:7px;background:linear-gradient(90deg,#d68a3a,var(--sari));min-width:3px}
      .pf-bv{font-size:12.5px;font-weight:700;color:var(--tx-0);font-variant-numeric:tabular-nums;white-space:nowrap;min-width:120px;text-align:right}
      .pf table{width:100%;border-collapse:collapse;background:var(--zemin-1)}
      .pf th{font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--tx-2);font-weight:700;text-align:left;padding:0 8px 9px}
      .pf th.r,.pf td.r{text-align:right}
      .pf td{padding:9px 8px;border-top:1px solid var(--cizgi);font-size:12.5px;vertical-align:middle}
      .pf-fm{font-weight:600;color:var(--tx-0)}.pf-sub{font-size:10px;color:var(--tx-2);margin-top:2px}
      .pf-bg{font-weight:700;font-size:10px;white-space:nowrap;padding:2px 8px;border-radius:999px}
      .pf-bg.soguyor{color:var(--sari);background:var(--sari-z)}.pf-bg.pasif{color:var(--kirmizi);background:var(--kirmizi-z)}
      .pf-money{font-variant-numeric:tabular-nums;font-weight:700}.pf-mut{color:var(--tx-2)}
      .pf-dim{font-size:10px;color:var(--tx-3);font-style:italic}
      .pf-yok{display:flex;gap:12px;align-items:center;background:var(--zemin-0);border:1px dashed var(--cizgi-g);border-radius:14px;padding:14px 16px;margin-bottom:13px}
      .pf-yok .big{font-size:26px;font-weight:800;color:var(--tx-2);line-height:1;flex:0 0 auto;font-variant-numeric:tabular-nums}
      .pf-yok .tx{font-size:12px;line-height:1.5;color:var(--tx-1)}.pf-yok .tx b{color:var(--tx-0)}
      .pf-how{background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:14px;padding:16px 18px;margin-bottom:13px}
      .pf-how h4{margin:0 0 9px;font-size:13px;font-weight:800;color:var(--tx-1)}
      .pf-how div{font-size:12px;color:var(--tx-1);line-height:1.6;margin-bottom:6px}.pf-how b{color:var(--tx-0)}
      .pf-how .lg{display:inline-flex;gap:5px;align-items:center;margin-right:12px}
      .pf-foot{padding:13px 15px;background:var(--zemin-0);border:1px solid var(--cizgi);border-radius:12px;font-size:11px;line-height:1.65;color:var(--tx-2)}.pf-foot b{color:var(--tx-1)}.pf-foot .dot{color:var(--tx-3);margin:0 6px}
      .pf-empty{color:var(--tx-2);text-align:center;padding:22px;font-size:13px}
    </style>`;
    const KICK = `<div class="pf-kick"><span class="t">🩺 Portföy Sağlığı · alım ritmine göre</span><span class="p">son 18 ay</span></div>`;
    const CTX = rep
      ? `<div class="pf-ctx"><span class="ic">🩺</span><div>Kendi defterinde <b>${o.alimli || 0}</b> müşterinin alım geçmişi var. Aşağıda her birinin <b>kendi alım temposuna göre</b> ${term("sağlık durumu", "aktif = kendi ritminde alıyor · soğuyor = ritmine göre gecikti · pasif = ritmini çok aştı ya da 12+ ay sessiz")}. Amaç: <b>soğuyanı pasife düşmeden yakalamak.</b></div></div>`
      : `<div class="pf-ctx"><span class="ic">🩺</span><div>Ekipte <b>${o.alimli || 0}</b> müşterinin alım geçmişi var. Her müşteri <b>kendi alım temposuna göre</b> ${term("sınıflanıyor", "aktif = kendi ritminde · soğuyor = gecikti · pasif = ritmini çok aştı / 12+ ay sessiz")} — sabit bir eşik değil. Aşağıda risk altındaki ciro ve hangi temsilcinin defteri kayıyor.</div></div>`;
    const HERO = `<div class="pf-hero"><div class="pf-hq">${rep ? "Defterinde risk altındaki ciro" : "Risk altındaki ciro (soğuyor + pasif)"}</div>
      <div class="pf-big">${kTL(o.risk_ciro)}</div>
      <div class="pf-hs"><b>${riskN}</b> müşteri ritminden çıkmış — <b>${o.soguyor || 0}</b> soğuyor, <b>${o.pasif || 0}</b> pasif. ${rep ? "Soğuyanı önce ara; pasif olan çoktan kaymış." : ""}</div>
      <div class="pf-tiles">
        <div class="pf-tile ak"><div class="n">${o.aktif || 0}</div><div class="l">🟢 Aktif</div><div class="sx">${kTL(o.aktif_ciro)} ciro</div></div>
        <div class="pf-tile so"><div class="n">${o.soguyor || 0}</div><div class="l">🟡 Soğuyor</div><div class="sx">ritmine göre gecikti</div></div>
        <div class="pf-tile pa"><div class="n">${o.pasif || 0}</div><div class="l">🔴 Pasif</div><div class="sx">ritmini çok aştı / 12+ ay</div></div>
      </div></div>`;
    const bandRows = ban.map((b) => {
      const w = Math.max(3, (Number(b.ciro) || 0) / maxBand * 100);
      return `<div class="pf-brow"><div class="pf-blab">${esc(b.etiket)}</div><div class="pf-bbar"><div class="pf-bfl" style="width:${w}%"></div></div><div class="pf-bv">${b.n || 0} müşteri · ${kTL(b.ciro)}</div></div>`;
    }).join("");
    const BANDS = `<div class="pf-card"><div class="pf-ch"><span class="tick"></span><h4>Yaşlanma — son alımdan bu yana</h4><span class="sub">alım geçmişi olan müşteriler</span></div><div class="pf-bd">${bandRows || `<div class="pf-empty">Veri yok</div>`}</div></div>`;
    const yon = !rep;
    const listRows = lst.map((x) => `<tr>
      <td><div class="pf-fm">${esc(x.firma)}</div><div class="pf-sub">${esc(x.il || "—")}${x.tip ? " · " + (x.tip === "TUKETICI" ? "Toptan" : x.tip === "TICARI" ? "Filo" : esc(x.tip)) : ""}${x.segment ? " · " + esc(x.segment) : ""}</div></td>
      <td><span class="pf-bg ${x.durum}">${durTxt[x.durum] || x.durum}</span>${x.guven === "dusuk" ? ` <span class="pf-dim" title="3'ten az alım ayı — tempo belirsiz, sade recency">ritim belirsiz</span>` : ""}</td>
      <td class="pf-mut">${recTxt(x.recency)}${x.ritim != null ? ` <span class="pf-dim">(ritim ~${x.ritim} ay)</span>` : ""}</td>
      <td class="r pf-money">${x.ciro > 0 ? kTL(x.ciro) : "<span class='pf-mut'>—</span>"}</td>
      ${yon ? `<td class="pf-mut">${esc(x.rep || "—")}</td>` : ""}</tr>`).join("");
    const LIST = `<div class="pf-card"><div class="pf-ch"><span class="tick" style="background:var(--kirmizi)"></span><h4>Risk listesi — soğuyor + pasif</h4><span class="sub">risk altındaki ciroya göre · ${lst.length}${d.liste_toplam > lst.length ? " / " + d.liste_toplam : ""}</span></div>
      <table><thead><tr><th>Müşteri</th><th>Durum</th><th>Son alım</th><th class="r">12a ciro</th>${yon ? "<th>Sorumlu</th>" : ""}</tr></thead><tbody>${listRows || `<tr><td colspan="${yon ? 5 : 4}" class="pf-empty">Risk altında müşteri yok 🎉</td></tr>`}</tbody></table></div>`;
    const REP = (yon && tem.length) ? `<div class="pf-card"><div class="pf-ch"><span class="tick"></span><h4>Temsilci bazında risk</h4><span class="sub">defterinde ne kadar ciro kayıyor</span></div>
      <table><thead><tr><th>Temsilci</th><th class="r">Soğuyor</th><th class="r">Pasif</th><th class="r">Risk ₺</th></tr></thead><tbody>${tem.map(t => `<tr><td class="pf-fm">${esc(t.rep)}</td><td class="r">${t.soguyor || 0}</td><td class="r">${t.pasif || 0}</td><td class="r pf-money">${kTL(t.risk_ciro)}</td></tr>`).join("")}</tbody></table></div>` : "";
    const YOK = (o.alim_yok) ? `<div class="pf-yok"><div class="big">${o.alim_yok}</div><div class="tx"><b>müşterinin ERP'de alım eşleşmesi yok</b> (kodsuz ya da hiç almamış). Bunlar <b>churn değil</b> — sinyal yok. Kör nokta olarak <b>Kapsam</b> raporunda eşleştir/ata.</div></div>` : "";
    const HOW = `<div class="pf-how"><h4>Durum nasıl belirleniyor?</h4>
      <div><b>Ritim</b> = müşterinin son 18 ayda alım yaptığı aylar arası tipik boşluk (kendi temposu).</div>
      <div><span class="lg">🟢 <b>Aktif</b></span> kendi ritminde alıyor · <span class="lg">🟡 <b>Soğuyor</b></span> ritmine göre gecikti (yakalanabilir) · <span class="lg">🔴 <b>Pasif</b></span> ritmini çok aştı ya da 12+ ay sessiz.</div>
      <div>Sabit bir "6 ay" eşiği değil — aylık alan için 3 ay geç kalmak farklı, 6 ayda bir alan için farklıdır. Kapsam listesindeki rozet de <b>aynı tanımı</b> kullanır (tek kaynak).</div></div>`;
    const FOOT = `<div class="pf-foot"><b>${o.toplam || 0}</b> aktif müşteri<span class="dot">·</span><b>${o.alimli || 0}</b> alım geçmişli (sınıflanan)<span class="dot">·</span><b>${o.alim_yok || 0}</b> ERP eşleşmesi yok. Alım = <code>bi_satis_faturalari</code> (musteri_kodu). Korelasyon/betimsel — tahmin değil.</div>`;
    const INTRO = `<div class="pf-how" style="margin-bottom:13px">  <!-- PORTFOY_INTRO_DK_V1 -->
      <h4>🩺 Portföy Sağlığı — ne işe yarar?</h4>
      <div>Bir temsilcinin (ya da tüm ekibin) müşteri defterinde <b>kimlerin alımdan kesildiğini</b> ve <b>ne kadar cironun risk altında</b> olduğunu gösterir. Amaç: düzenli alan bir müşteri yavaşlamaya başladığında, <b>tamamen kaybedilmeden önce yakalamak.</b></div>
      <div><b>Ritim</b> = müşterinin son 18 ayda alım yaptığı aylar arası tipik boşluk (kendi alım temposu). <b>Durum</b>, son alımın bu ritme göre neresinde olduğudur — sabit bir "6 ay" eşiği DEĞİL (aylık alan için 3 ay geç kalmak, 6 ayda bir alandan farklıdır).</div>
      <div><span class="lg">🟢 <b>Aktif</b></span> ritminde alıyor · <span class="lg">🟡 <b>Soğuyor</b></span> ritmini geçti, hâlâ yakalanabilir · <span class="lg">🔴 <b>Pasif</b></span> ritmini çok aştı ya da 12+ ay sessiz.</div>
      <div><b>Risk altındaki ciro</b> = soğuyor + pasif müşterilerin son 12 ay cirosu. <b>alım_yok</b> = ERP'de hiç alım eşleşmesi olmayan müşteri (kodsuz / hiç almamış) — <b>churn değil</b>, Kapsam'da kör nokta.</div>
      <div>Eşleşme müşteri koduyla (bi_satis_faturalari); <b>Kapsam listesindeki rozet de aynı tanımı</b> kullanır — tek kaynak.</div></div>`;
    box.innerHTML = CSS + `<div class="pf">${KICK}${INTRO}${HERO}${BANDS}${LIST}${REP}${YOK}${FOOT}</div>`;
  }
  async function rpKapsam() {  /* KAPSAM_DK_V1 */
    const el = icerik(); if (!el) return;
    el.innerHTML = load();
    let d; try { d = await api(`/api/saha/rapor/kapsam?gun=90${tipQS()}`); } catch (e) { el.innerHTML = hataH(e); return; }
    const yon = d.rol === "yonetici", o = d.ozet || {};
    const CSS = `<style>
      .kap{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--cizgi-g:rgba(0,0,0,.18);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--kirmizi-p:#C43D28;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--yesil-p:#106B4A;--mavi:#2563eb;/*KAPSAM_DK_TEMA_V1*/--z0:#FBFBFA;--z1:#FFF;--z2:#F4F4F2;--cz:rgba(0,0,0,.09);--t0:#16161A;--t1:#5F5F66;--t2:#85858C;--t3:#A8A8AE;--kr:#C43D28;--krz:#FDF0ED;--sr:#8A5D06;--srz:#FEF6E7;--ys:#106B4A;--ysz:#EAF7F1;--mv:#2563eb;--mvz:#EEF3FE;--mo:#6D5AE0;--moz:#F0EDFB;color-scheme:light;color:var(--t0)}
      .kap *{box-sizing:border-box}
      .kap-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin:2px 0 16px}
      .kap-kpi{background:var(--z1);border:1px solid var(--cz);border-radius:14px;padding:13px 14px;position:relative;overflow:hidden}
      .kap-kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
      .kap-kpi.a:before{background:var(--mv)}.kap-kpi.b:before{background:var(--ys)}.kap-kpi.c:before{background:var(--kr)}.kap-kpi.d:before{background:var(--sr)}
      .kap-kpi .n{font-size:23px;font-weight:800;letter-spacing:-.02em;line-height:1}.kap-kpi.c .n{color:var(--kr)}.kap-kpi.d .n{color:var(--sr)}
      .kap-kpi .l{font-size:11px;color:var(--t1);margin-top:6px;font-weight:600}.kap-kpi .sx{font-size:10px;color:var(--t2);margin-top:2px}
      .kap-card{background:var(--z1);border:1px solid var(--cz);border-radius:14px;padding:14px 15px;margin-bottom:14px}
      .kap-h{font-size:13px;font-weight:800;display:flex;align-items:center;gap:7px;margin-bottom:3px}
      .kap-cd{font-size:11px;color:var(--t2);margin-bottom:11px}
      .kap-intro .kap-ip{font-size:12.5px;color:var(--t1);line-height:1.6;margin-top:2px}  /* KAPSAM_DK_INTRO_V1 */
      .kap-intro .kap-idiv{height:1px;background:var(--cz);margin:12px 0 11px}
      .kap-intro .kap-il{font-size:12px;color:var(--t1);line-height:1.55;margin-bottom:6px}.kap-intro .kap-il b{color:var(--t0)}.kap-intro code{background:var(--z2);padding:1px 5px;border-radius:5px;font-size:11px}
      .kap table{width:100%;border-collapse:collapse;background:var(--z1)}
      .kap th{font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--t2);font-weight:700;text-align:left;padding:0 8px 8px;background:var(--z1)}
      .kap th.kap-r,.kap td.kap-r{text-align:right}
      .kap td{padding:9px 8px;border-top:1px solid var(--cz);font-size:12.5px;vertical-align:middle;background:var(--z1)}
      .kap-firma{font-weight:600}.kap-tk{font-weight:700;font-size:9.5px;white-space:nowrap}.kap-tk.pasif{color:#C43D28}.kap-tk.soguyor{color:#8A5D06}.kap-tk.aktif{color:#106B4A}/* KAPSAM_SAGLIK_DK_V1 */.kap-sub{font-size:10px;color:var(--t2);margin-top:2px}.kap-mut{color:var(--t2)}.kap-money{font-variant-numeric:tabular-nums;font-weight:700}
      .kap-num{color:var(--t3);font-weight:700;width:26px}
      .kap thead,.kap tbody,.kap tr{background:var(--z1)}  /*KAPSAM_DK_TEMA_V1*/
      .kap-bar{height:8px;background:var(--z2);border-radius:99px;overflow:hidden;min-width:64px;display:inline-block;width:120px;vertical-align:middle}
      .kap-bar>i{display:block;height:100%;border-radius:99px}.kap-bar>i.g{background:var(--ys)}.kap-bar>i.a{background:var(--sr)}.kap-bar>i.r{background:var(--kr)}.kap-bar>i.b{background:var(--mv)}
      .kap-pct{font-weight:800;font-variant-numeric:tabular-nums;margin-left:8px;font-size:12px}
      .kap-c{font-size:10px;font-weight:700;padding:1px 7px;border-radius:99px}.kap-c.hic{color:var(--kr);background:var(--krz)}.kap-c.eski{color:var(--sr);background:var(--srz)}
      .kap-d{font-size:9.5px}.kap-d.beyaz{color:var(--kr)}.kap-d.eslesmemis{color:var(--mo)}.kap-d.ulasildi{color:var(--ys)}.kap-d.susturuldu{color:var(--t2)}
      .kap-acts{display:flex;gap:5px;justify-content:flex-end;flex-wrap:wrap}
      .kap-act{font-size:11px;font-weight:700;padding:5px 8px;border-radius:7px;cursor:pointer;border:1px solid var(--cz);background:var(--z1);color:var(--t1)}
      .kap-act.pri{background:var(--t0);color:#fff;border-color:var(--t0)}.kap-act.esles{background:var(--moz);color:var(--mo);border-color:rgba(109,90,224,.25)}.kap-act.dis{background:var(--krz);color:var(--kr);border-color:rgba(196,61,40,.2)}
      .kap-seg2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
      .kap-sb{border:1px solid var(--cz);border-radius:11px;padding:12px 13px}.kap-sb .t{font-size:11px;font-weight:700;color:var(--t1);display:flex;justify-content:space-between}.kap-sb .big{font-size:21px;font-weight:800;margin:5px 0 8px}
      .kap-tool{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
      .kap-tg{display:inline-flex;background:var(--z2);border:1px solid var(--cz);border-radius:8px;padding:2px}
      .kap-tg span{font-size:11px;font-weight:700;padding:5px 10px;border-radius:6px;color:var(--t2);cursor:pointer}.kap-tg span.on{background:var(--z1);color:var(--t0);box-shadow:0 1px 2px rgba(0,0,0,.05)}
      .kap-learn{display:flex;gap:9px;background:var(--mvz);border:1px solid rgba(37,99,235,.16);border-radius:11px;padding:10px 12px;margin-top:11px;font-size:11.5px;color:var(--t1);line-height:1.5}.kap-learn b{color:var(--t0)}
      .kap-reason{margin:8px 0;padding:10px 11px;background:var(--z2);border:1px dashed var(--cz);border-radius:9px}.kap-reason .q{font-size:11px;font-weight:700;color:var(--t1);margin-bottom:7px}
      .kap-opts{display:flex;gap:5px;flex-wrap:wrap}.kap-ropt{font-size:11px;font-weight:700;padding:4px 9px;border-radius:99px;border:1px solid var(--cz);background:var(--z1);color:var(--t1);cursor:pointer}.kap-ropt.sel{background:var(--kr);color:#fff;border-color:var(--kr)}
      .kap-in{margin-top:7px;width:100%;font-size:12px;padding:7px 9px;border:1px solid var(--cz);border-radius:7px;background:var(--z1);color:var(--t0)}
      .kap-sel{font-size:12px;padding:6px 9px;border:1px solid var(--cz);border-radius:7px;background:var(--z1);color:var(--t0)}
      .kap i.ib{cursor:help;color:var(--t3);font-style:normal}
      .kap details{border:1px solid var(--cz);border-radius:11px;background:var(--z1);margin-top:12px;overflow:hidden}
      .kap summary{cursor:pointer;list-style:none;padding:11px 13px;font-size:12.5px;font-weight:800;display:flex;gap:7px;align-items:center}.kap summary::-webkit-details-marker{display:none}.kap summary:after{content:'▾';margin-left:auto;color:var(--t2)}.kap details[open] summary:after{content:'▴'}
      .kap-db{padding:2px 14px 13px;font-size:11.5px;color:var(--t1);line-height:1.6}.kap-db p{margin:0 0 7px}.kap-db b{color:var(--t0)}
      .kap-empty{padding:26px;text-align:center;color:var(--t2);font-size:12.5px}
    </style>`;
    const kisa = (n) => { n = Number(n) || 0; const a = Math.abs(n); if (a >= 1e9) return (n / 1e9).toFixed(1).replace(".", ",") + " Mr ₺"; if (a >= 1e6) return (n / 1e6).toFixed(1).replace(".", ",") + " M ₺"; if (a >= 1e3) return Math.round(n / 1e3) + " B ₺"; return Math.round(n) + " ₺"; };
    const sonTxt = (g) => g == null ? `<span class="kap-c hic">hiç</span>` : g > 45 ? `<span class="kap-c eski">${g} gün</span>` : `${g} gün`;
    const tier = (p) => p >= 60 ? "g" : p >= 35 ? "a" : "r";
    const bar = (pct, cls) => `<span class="kap-bar"><i class="${cls}" style="width:${Math.min(100, pct)}%"></i></span><span class="kap-pct">${pct}%</span>`;
    const reps = (d.temsilci || []).map(t => [t.rep_id, t.rep]);
    const segEt = (t) => t === "TICARI" ? "Ticari" : t === "TUKETICI" ? "Tüketici" : (t || "");
    const list = S._kapAll ? (d.hepsi || []) : (d.beyaz || []);
    const durEt = { ulasildi: "ulaşıldı", beyaz: "beyaz alan", eslesmemis: "eşleşmemiş", susturuldu: "susturuldu" };
    const rowActs = (x) => yon
      ? `<button class="kap-act pri" data-aks="ILET" data-mid="${esc(x.id)}">📌 İlet</button><button class="kap-act" data-aks="ATA" data-mid="${esc(x.id)}">👤 Ata</button><button class="kap-act dis" data-aks="SUSTUR" data-mid="${esc(x.id)}">🔇</button>`
      : `<button class="kap-act pri" data-aks="GITTIM" data-mid="${esc(x.id)}">✔️ Gittim</button><button class="kap-act" data-aks="PLANLA" data-mid="${esc(x.id)}">📅 Planla</button><button class="kap-act dis" data-aks="SUSTUR" data-mid="${esc(x.id)}">🔇</button>`;
    const listRows = list.map((x, i) => `<tr data-row="${esc(x.id)}"><td class="kap-num">${i + 1}</td><td class="kap-firma">${esc(x.firma)}<div class="kap-sub">${esc(x.il || "—")}${x.tip ? " · " + segEt(x.tip) : ""}${x.tk && x.tk.durum ? ` · <span class="kap-tk ${x.tk.durum}" title="son 12 ay ${x.tk.vc} ziyaret · alım ritmine göre">${x.tk.durum === "pasif" ? "🔴 pasif" : x.tk.durum === "soguyor" ? "🟡 soğuyor" : "🟢 aktif"}</span>` : ""}${(S._kapAll && x.durum) ? ` · <b class="kap-d ${x.durum}">${durEt[x.durum] || x.durum}</b>` : ""}</div></td><td class="kap-r kap-money">${x.ciro > 0 ? money(x.ciro) : "<span class='kap-mut'>—</span>"}</td><td>${sonTxt(x.gun)}</td>${yon ? `<td class="kap-mut">${esc(x.rep || "—")}</td>` : ""}<td class="kap-r"><div class="kap-acts">${rowActs(x)}</div></td></tr>`).join("");
    const sehirRows = (d.sehir || []).map(c => `<tr><td class="kap-firma">${esc(c.il)}</td><td class="kap-r">${c.portfoy}</td><td class="kap-r">${c.ulasilan}</td><td>${bar(c.kapsam, tier(c.kapsam))}</td><td class="kap-r kap-money" style="color:${c.beyaz_ciro > 0 ? "var(--kr)" : "var(--t2)"}">${kisa(c.beyaz_ciro)}</td></tr>`).join("");
    const repRows = (d.temsilci || []).map(t => `<tr><td class="kap-firma">${esc(t.rep)}</td><td class="kap-r">${t.portfoy}</td><td>${bar(t.kapsam, tier(t.kapsam))}</td><td class="kap-r">${t.beyaz_sayi}</td><td class="kap-r kap-money">${kisa(t.beyaz_ciro)}</td></tr>`).join("");
    const seg = d.segment || [];
    const segBox = (key, ico, ad) => { const g = seg.find(x => x.seg === key) || { portfoy: 0, ulasilan: 0, kapsam: 0, beyaz_ciro: 0 }; return `<div class="kap-sb"><div class="t"><span>${ico} ${ad}</span><span class="kap-mut">${g.portfoy} müşteri</span></div><div class="big">${g.kapsam}%</div>${bar(g.kapsam, tier(g.kapsam)).split('<span class="kap-pct"')[0]}<div class="kap-sub" style="margin-top:7px">${g.ulasilan} ulaşıldı · beyaz alan ${kisa(g.beyaz_ciro)}</div></div>`; };
    const esizRows = (d.eslesmemis || []).map(x => `<tr data-row="${esc(x.id)}"><td class="kap-firma">${esc(x.firma)}<div class="kap-sub">${esc(x.il || "—")}</div></td><td>${sonTxt(x.gun)}</td>${yon ? `<td class="kap-mut">${esc(x.rep || "—")}</td>` : ""}<td class="kap-r"><div class="kap-acts"><button class="kap-act esles" data-esles="${esc(x.id)}">🔗 Eşleştir</button>${yon ? `<button class="kap-act" data-aks="ATA" data-mid="${esc(x.id)}">👤 Ata</button>` : ""}<button class="kap-act dis" data-aks="SUSTUR" data-mid="${esc(x.id)}">🔇</button></div></td></tr>`).join("");
    const susList = (d.susturulan || []);
    const susRows = susList.map(x => `<tr data-row="${esc(x.id)}"><td class="kap-firma">${esc(x.firma)}</td><td class="kap-mut">${esc(x.mute_by || "—")}</td><td>${({ KAPANDI: "Kapandı", RAKIP: "Rakibe geçti", SEZON: "Sezon dışı", PAS: "Bilinçli pas", YANLIS: "Yanlış kayıt", DIGER: "Diğer" })[x.gerekce] || x.gerekce || "—"}${x.gerekce_metin ? ` <span class="kap-mut">"${esc(x.gerekce_metin)}"</span>` : ""}</td><td class="kap-r"><button class="kap-act" data-geri="${esc(x.id)}">geri al</button></td></tr>`).join("");

    el.innerHTML = CSS + `<div class="kap">
      <div class="kap-card kap-intro">  <!-- KAPSAM_DK_INTRO_V1 -->
        <div class="kap-h">📍 Kapsam & Beyaz Alan — ne işe yarar?</div>
        <p class="kap-ip">Saha eforunun <b>hücum tarafı</b>: nereye gidilmiyor ve ne kadar değerli müşteri masada kalıyor — Risk Radarı'nın (savunma) aynası. Amaç: kapsamı genişletmek ve ERP'ye bağlı olmayan değerli müşterileri görünür kılıp eşleştirmeye itmek.</p>
        <div class="kap-idiv"></div>
        <div class="kap-il"><b>Kapsam</b> = son 90 günde ≥1 TAMAMLANDI ziyaretli <b>farklı müşteri</b> ÷ aktif portföy (genişlik ölçer; yalnız uygulamada kayıtlı ziyaret sayılır).</div>
        <div class="kap-il"><b>Beyaz alan</b> = son 12 ay cirosu&gt;0, eşleşmiş ama 90 gündür ziyaret yok — dokunulmayan değerli müşteriler.</div>
        <div class="kap-il"><b>Eşleşmemiş</b> = <code>musteri_kodu</code> yok → cirosu görünmez; ayrı "kör nokta" bloğu, eşleştirmeye iter.</div>
        <div class="kap-il"><b>İki pencere</b>: kapsam <b>son 90 gün</b> · ciro/değer <b>son 12 ay</b> (YTD değil). Her aksiyon loglanır; susturulanları yönetici gerekçesiyle görür.</div>
      </div>
      <div class="kap-kpis">
        <div class="kap-kpi a" title="Son 90 günde ≥1 TAMAMLANDI ziyaret alan farklı müşteri ÷ aktif portföy."><div class="n">${o.kapsam || 0}%</div><div class="l">Portföy kapsamı ⓘ</div><div class="sx">${o.ulasilan || 0} / ${o.portfoy || 0} · son 90 gün</div></div>
        <div class="kap-kpi b" title="Son 90 günde en az bir tamamlanan ziyaret alan farklı müşteri."><div class="n">${o.ulasilan || 0}</div><div class="l">Ulaşılan müşteri ⓘ</div><div class="sx">son 90 günde ≥1 ziyaret</div></div>
        <div class="kap-kpi c" title="Son 12 ay cirosu>0 olan ve son 90 günde hiç ziyaret edilmeyen eşleşmiş müşteriler."><div class="n">${o.beyaz_sayi || 0}</div><div class="l">Beyaz alan (değerli) ⓘ</div><div class="sx">cirosu var, 90 günde ziyaret yok</div></div>
        <div class="kap-kpi d" title="Yukarıdaki müşterilerin son 12 ay (yuvarlanan) toplam cirosu."><div class="n">${kisa(o.beyaz_ciro || 0)}</div><div class="l">Beyaz alandaki ciro (12 ay) ⓘ</div><div class="sx">dokunulmayan gelir</div></div>
      </div>
      ${yon ? `<div class="kap-card"><div class="kap-h">🗺️ Şehir bazında kapsam</div><div class="kap-cd">En çok dokunulmayan cirosu olan şehir üstte.</div><table><thead><tr><th>Şehir</th><th class="kap-r">Portföy</th><th class="kap-r">Ulaşılan</th><th>Kapsam</th><th class="kap-r">Beyaz alan ₺</th></tr></thead><tbody>${sehirRows || `<tr><td colspan="5" class="kap-empty">—</td></tr>`}</tbody></table></div>` : ""}
      <div class="kap-card"><div class="kap-h">🏷️ Segment kapsamı</div><div class="kap-seg2">${segBox("TICARI", "🔧", "Ticari")}${segBox("TUKETICI", "🚗", "Tüketici")}</div></div>
      ${yon ? `<div class="kap-card"><div class="kap-h">👥 Temsilci bazında kapsam</div><div class="kap-cd">Her temsilci kendi kitabının ne kadarını tarıyor, arkasında ne kadar beyaz alan bırakıyor.</div><table><thead><tr><th>Temsilci</th><th class="kap-r">Portföy</th><th>Kapsam</th><th class="kap-r">Beyaz alan</th><th class="kap-r">Beyaz alan ₺</th></tr></thead><tbody>${repRows || `<tr><td colspan="5" class="kap-empty">—</td></tr>`}</tbody></table></div>` : ""}
      <div class="kap-card">
        <div class="kap-tool"><div class="kap-h" style="margin:0">💰 ${S._kapAll ? "Tüm müşteriler" : "Beyaz alan — dokunulmayan değerli müşteriler"}</div>
          <div style="display:flex;gap:7px;align-items:center"><div class="kap-tg"><span class="${S._kapAll ? "" : "on"}" data-kaptg="beyaz">Beyaz alan</span><span class="${S._kapAll ? "on" : ""}" data-kaptg="tum">Tüm müşteriler</span></div><button class="kap-act" data-xls="1">⬇ Excel</button></div>
        </div>
        <div class="kap-cd"><b>Uygulamada kayıtlı</b> ziyareti olmayan değerli müşteriler; yıllık ciroya (son 12 ay) göre sıralı. Her satırda aksiyon al — <b>loglanır ve öğrenilir</b>.</div>
        <table><thead><tr><th class="kap-num">#</th><th>Müşteri</th><th class="kap-r">Yıllık ciro <i class="ib" title="Son 12 ay yuvarlanan — ERP satış faturaları, musteri_kodu eşleşmeli. YTD DEĞİL.">ⓘ</i></th><th>Son ziyaret <i class="ib" title="En son TAMAMLANDI ziyaret (tüm zamanlar).">ⓘ</i></th>${yon ? "<th>Sorumlu</th>" : ""}<th class="kap-r">Aksiyon</th></tr></thead><tbody id="kap-list">${listRows || `<tr><td colspan="${yon ? 6 : 5}" class="kap-empty">🎉 Bu kırılımda beyaz alan yok.</td></tr>`}</tbody></table>
        <div class="kap-learn">🧠 <div><b>Her aksiyon loglanır — hiçbiri boşa gitmez.</b> ${yon ? "<b>📌 İlet</b> → sorumlu temsilcinin Sabah Rotam'ına düşer. <b>👤 Ata</b> → sorumluyu değiştirir. " : "<b>✔️ Gittim</b> → ziyaret geri-yazılır (kayıtsız temas kapanır). <b>📅 Planla</b> → Sabah Rotam'ına düşer. "}<b>🔇 Sustur</b> → gerekçesiyle listeden çıkar${yon ? "" : ", yönetici görür"}; gerekçeler <b>beyaz alan neden kapanıyor</b> sinyaline döner.</div></div>
        ${(!S._kapAll && d.beyaz_toplam > (d.beyaz || []).length) ? `<div class="kap-sub" style="margin-top:9px">+ ${d.beyaz_toplam - d.beyaz.length} müşteri daha · Excel ile tümü</div>` : ""}
      </div>
      <div class="kap-card" style="border-color:rgba(196,61,40,.3)"><div class="kap-h">⚠️ Eşleşmemiş beyaz alan — kör nokta</div><div class="kap-cd">ERP'ye (<code>musteri_kodu</code>) bağlı değil → cirosu görünmüyor. <b>${o.eslesmemis_sayi || 0}</b> müşteri; önce eşleştir, sonra değerini gör.</div><table><thead><tr><th>Müşteri</th><th>Son ziyaret</th>${yon ? "<th>Sorumlu</th>" : ""}<th class="kap-r">Aksiyon</th></tr></thead><tbody id="kap-esiz">${esizRows || `<tr><td colspan="${yon ? 4 : 3}" class="kap-empty">Eşleşmemiş kör nokta yok.</td></tr>`}</tbody></table>${(d.eslesmemis_toplam > (d.eslesmemis || []).length) ? `<div class="kap-sub" style="margin-top:9px">+ ${d.eslesmemis_toplam - d.eslesmemis.length} müşteri daha</div>` : ""}</div>
      ${yon && susRows ? `<div class="kap-card"><div class="kap-h">🔇 Susturulanlar — gerekçeli</div><div class="kap-cd">Ekibin "hedef değil" dediği müşteriler; gerekçesiyle. Geri alabilirsin.</div><table><thead><tr><th>Müşteri</th><th>Susturan</th><th>Gerekçe</th><th class="kap-r"></th></tr></thead><tbody id="kap-sus">${susRows}</tbody></table></div>` : ""}
    </div>`;

    // ── wiring ──
    const reload = () => rpKapsam();
    const post = async (mid, tur, extra) => { try { await api(`/api/saha/musteri-aksiyon`, { method: "POST", body: JSON.stringify({ musteri_id: mid, tur, ...(extra || {}) }) }); reload(); } catch (e) { alert("Olmadı: " + (e.message || e)); } };
    // toggle
    el.querySelectorAll("[data-kaptg]").forEach(b => b.addEventListener("click", () => { S._kapAll = b.dataset.kaptg === "tum"; reload(); }));
    // Excel
    const xls = el.querySelector("[data-xls]"); if (xls) xls.addEventListener("click", async () => { xls.textContent = "…"; try { const res = await fetch(`/api/saha/rapor/kapsam-export?gun=90${tipQS()}`, { headers: S.headers() }); const blob = await res.blob(); const a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "kapsam-beyaz-alan.csv"; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); } catch (e) { alert("İndirilemedi: " + (e.message || e)); } finally { xls.textContent = "⬇ Excel"; } });
    // direkt aksiyonlar + inline picker
    el.querySelectorAll("[data-aks]").forEach(b => b.addEventListener("click", () => {
      const mid = b.dataset.mid, tur = b.dataset.aks, tr = b.closest("tr"); if (!tr) return;
      if (tur === "ILET" || tur === "GITTIM" || tur === "PLANLA") { post(mid, tur); return; }
      if (el.querySelector(".kap-picker")) el.querySelectorAll(".kap-picker").forEach(p => p.remove());
      const holder = document.createElement("tr"); holder.className = "kap-picker";
      const span = tr.querySelectorAll("td").length;
      if (tur === "SUSTUR") {
        holder.innerHTML = `<td colspan="${span}"><div class="kap-reason"><div class="q">🔇 Neden susturuluyor? — listeden düşer, ${yon ? "loglanır" : "yönetici görür"}</div><div class="kap-opts">${[["KAPANDI", "Kapandı"], ["RAKIP", "Rakibe geçti"], ["SEZON", "Sezon dışı"], ["PAS", "Bilinçli pas"], ["YANLIS", "Yanlış kayıt"], ["DIGER", "Diğer…"]].map(([v, l]) => `<span class="kap-ropt" data-g="${v}">${l}</span>`).join("")}</div><input class="kap-in" placeholder="Diğer / ek açıklama (opsiyonel) — yönetici görür"><div style="display:flex;gap:6px;margin-top:8px"><button class="kap-act dis" data-ok="1">🔇 Sustur</button><button class="kap-act" data-cancel="1">Vazgeç</button></div></div></td>`;
        tr.after(holder);
        let g = null; holder.querySelectorAll(".kap-ropt").forEach(r => r.addEventListener("click", () => { holder.querySelectorAll(".kap-ropt").forEach(x => x.classList.remove("sel")); r.classList.add("sel"); g = r.dataset.g; }));
        holder.querySelector("[data-cancel]").addEventListener("click", () => holder.remove());
        holder.querySelector("[data-ok]").addEventListener("click", () => { const txt = holder.querySelector(".kap-in").value.trim(); if (!g && !txt) { alert("Gerekçe seç ya da yaz."); return; } post(mid, "SUSTUR", { gerekce: g || "DIGER", gerekce_metin: txt || null }); });
      } else if (tur === "ATA") {
        const opts = reps.map(([id, ad]) => `<option value="${esc(id)}">${esc(ad)}</option>`).join("");
        holder.innerHTML = `<td colspan="${span}"><div class="kap-reason"><div class="q">👤 Sorumlu temsilci ata</div><select class="kap-sel" data-rep>${opts || `<option value="">— temsilci yok —</option>`}</select> <button class="kap-act pri" data-ok="1">Ata</button> <button class="kap-act" data-cancel="1">Vazgeç</button></div></td>`;
        tr.after(holder);
        holder.querySelector("[data-cancel]").addEventListener("click", () => holder.remove());
        holder.querySelector("[data-ok]").addEventListener("click", () => { const rep = holder.querySelector("[data-rep]").value; if (!rep) { alert("Temsilci seç."); return; } post(mid, "ATA", { hedef_rep: rep }); });
      }
    }));
    // Eşleştir → müşteriler
    el.querySelectorAll("[data-esles]").forEach(b => b.addEventListener("click", () => { try { go("musteriler"); } catch (e) {} }));
    // geri al
    el.querySelectorAll("[data-geri]").forEach(b => b.addEventListener("click", () => post(b.dataset.geri, "GERI_AL")));
  }

  const RENDER = { ozet: rpOzet, ciro: rpCiro, risk: rpRisk, rotam: rpRotam, etki: rpEtki, portfoy: rpPortfoy, kapsam: rpKapsam, temsilciler: rpTemsilciler, pipeline: rpPipeline, pazar: rpPazar };  /* PORTFOY_DK_V1 */
  const ciz = () => { const fn = RENDER[aktif] || rpOzet; Promise.resolve().then(() => fn()).catch(e => { const el = icerik(); if (el) el.innerHTML = hataH(e); }); };

  // önceki eşit dönem [from,to] — delta karşılaştırması için
  const _priorRange = (from, to) => {
    const f = new Date(from + "T12:00:00"), t = new Date(to + "T12:00:00");
    const span = Math.round((t - f) / 86400000) + 1;
    const pt = new Date(f); pt.setDate(pt.getDate() - 1);
    const pf = new Date(pt); pf.setDate(pf.getDate() - span + 1);
    return [pf.toISOString().slice(0, 10), pt.toISOString().slice(0, 10)];
  };
  const _delta = (cur, prev) => {
    cur = Number(cur || 0); prev = Number(prev || 0);
    if (prev === 0) return cur > 0 ? { txt: "🆕 yeni", dir: "up" } : null;
    const pct = Math.round((cur - prev) / prev * 100);
    if (pct === 0) return { txt: "±0%", dir: "neu" };
    return { txt: (pct > 0 ? "▲ %" : "▼ %") + Math.abs(pct), dir: pct > 0 ? "up" : "dn" };
  };
  // dir + inv(artış kötü mü) → good/bad renk sınıfı
  const _dcls = (d, inv) => !d ? "" : d.dir === "neu" ? "neu" : ((d.dir === "up") !== !!inv ? "up" : "dn");
  const _rpSpark = (arr) => {
    const w = 520, h = 60, pad = 3;
    if (!arr || arr.length < 2) return "";
    const mx = Math.max(...arr), mn = Math.min(...arr), iw = w - pad * 2, ih = h - pad * 2;
    const pts = arr.map((v, i) => [pad + (i / (arr.length - 1)) * iw, pad + ih - ((v - mn) / ((mx - mn) || 1)) * ih]);
    const d = pts.map((p, i) => (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
    const area = d + " L " + (w - pad) + " " + (h - pad) + " L " + pad + " " + (h - pad) + " Z";
    const lp = pts[pts.length - 1];
    return `<svg width="100%" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="display:block"><defs><linearGradient id="rpcgd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2563eb" stop-opacity=".18"/><stop offset="1" stop-color="#2563eb" stop-opacity="0"/></linearGradient></defs><path d="${area}" fill="url(#rpcgd)"/><path d="${d}" fill="none" stroke="#2563eb" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="${lp[0].toFixed(1)}" cy="${lp[1].toFixed(1)}" r="3.4" fill="#2563eb" stroke="#fff" stroke-width="1.6"/></svg>`;
  };
  const _rpTips = (root) => {
    let tp = document.getElementById("rpc-tip");
    if (!tp) { tp = document.createElement("div"); tp.id = "rpc-tip"; tp.className = "rpc-tip"; document.body.appendChild(tp); document.addEventListener("click", () => tp.classList.remove("show")); }
    const place = (t) => { const r = t.getBoundingClientRect(); tp.style.left = Math.max(8, Math.min(window.innerWidth - tp.offsetWidth - 8, r.left)) + "px"; let top = r.bottom + 8; if (top + tp.offsetHeight > window.innerHeight - 8) top = r.top - tp.offsetHeight - 8; tp.style.top = top + "px"; };
    root.querySelectorAll("[data-tip]").forEach((elx) => {
      let q = elx.querySelector(".rpc-qi");
      if (!q) { q = document.createElement("span"); q.className = "rpc-qi"; q.textContent = "i"; elx.appendChild(q); }
      const show = () => { tp.innerHTML = elx.getAttribute("data-tip"); tp.classList.add("show"); place(q); };
      q.addEventListener("mouseenter", show);
      q.addEventListener("mouseleave", () => tp.classList.remove("show"));
      q.addEventListener("click", (ev) => { ev.stopPropagation(); if (tp.classList.contains("show")) tp.classList.remove("show"); else show(); });
    });
  };
  const _dtile = (id, val, label, tip, d, inv, clk) =>
    `<div class="rpc-tile${clk ? " tik" : ""}"${id ? ` id="${id}"` : ""}${tip ? ` data-tip="${esc(tip)}"` : ""}${clk ? ` title="${esc(clk)}"` : ""}><div class="rpc-num">${val == null ? "—" : val}</div><div class="rpc-lbl">${esc(label)}</div>${d ? `<div class="rpc-chip ${_dcls(d, inv)}">${esc(d.txt)}</div>` : ""}</div>`;

  // ── Özet ────────────────────────────────────────────────────────────────────
  async function rpOzet() {
    const el = icerik(); if (!el) return; el.innerHTML = load();
    const [pfr, ptr] = _priorRange(rpFrom(), rpTo());
    const reqs = [
      api(`/api/saha/rapor/ozet?from=${rpFrom()}&to=${rpTo()}${tipQS()}`),
      api(`/api/saha/rapor/teklif?from=${rpFrom()}&to=${rpTo()}${tipQS()}`),
      api(`/api/saha/rapor/ozet?from=${pfr}&to=${ptr}${tipQS()}`).catch(() => null),
      api(`/api/saha/rapor/teklif?from=${pfr}&to=${ptr}${tipQS()}`).catch(() => null)
    ];
    if (isMgr) reqs.push(api(`/api/saha/admin/yeni-musteriler?from=${rpFrom()}&to=${rpTo()}${tipQS()}`).catch(() => null));
    const [ozet, teklif, pOzet, pTeklif, yeniMus] = await Promise.all(reqs);
    const el2 = icerik(); if (!el2) return;
    const o = ozet.ozet || {}, t = teklif.ozet || {};
    const po = (pOzet && pOzet.ozet) || {}, ptk = (pTeklif && pTeklif.ozet) || {};
    const sonuclanan = Number(t.kazanilan || 0) + Number(t.kaybedilen || 0);
    const winRate = sonuclanan ? Math.round(1000 * t.kazanilan / sonuclanan) / 10 : null;
    const pSonuc = Number(ptk.kazanilan || 0) + Number(ptk.kaybedilen || 0);
    const pWin = pSonuc ? Math.round(1000 * ptk.kazanilan / pSonuc) / 10 : null;
    const kazTutar = Number(t.kazanilan_tutar || 0);
    const wrCol = winRate != null && winRate >= 50 ? "var(--yesil-p)" : "var(--sari-p)";

    const kpi = (id, val, label, col, clk, delta, inv) =>
      `<div class="dk-stat${clk ? " tik" : ""}"${id ? ` id="${id}"` : ""}${clk ? ` title="${esc(clk)}"` : ""}><div class="k">${esc(label)}</div><div class="v num" style="${col ? "color:" + col : ""}">${val == null ? "—" : val}</div>${delta ? `<div class="dk-delta ${_dcls(delta, inv)}">${esc(delta.txt)}</div>` : ""}</div>`;

    const _rpSparkWire = (root) => {  /* RAPOR_SPARK_HOVER_DK_V1 */
      let tp = document.getElementById("rpc-tip");
      if (!tp) { tp = document.createElement("div"); tp.id = "rpc-tip"; tp.className = "rpc-tip"; document.body.appendChild(tp); document.addEventListener("click", () => tp.classList.remove("show")); }
      root.querySelectorAll(".rpc-spark[data-g]").forEach((box) => {
        let g; try { g = JSON.parse(box.getAttribute("data-g")); } catch (e) { return; }
        if (!g || g.length < 2) return;
        const xl = box.querySelector(".rpc-xline");
        const at = (clientX) => {
          const r = box.getBoundingClientRect(); if (!r.width) return;
          let ratio = (clientX - r.left) / r.width; ratio = Math.max(0, Math.min(1, ratio));
          const idx = Math.round(ratio * (g.length - 1)), it = g[idx], p = String(it.t).split("-");
          if (xl) { xl.style.left = (idx / (g.length - 1) * 100) + "%"; xl.style.opacity = ".55"; }
          tp.innerHTML = "<b>" + (p.length === 3 ? p[2] + "." + p[1] + "." + p[0] : it.t) + "</b> · " + it.v + " ziyaret";
          tp.classList.add("show");
          const px = r.left + (idx / (g.length - 1)) * r.width;
          tp.style.left = Math.max(8, Math.min(window.innerWidth - tp.offsetWidth - 8, px - tp.offsetWidth / 2)) + "px";
          let top = r.top - tp.offsetHeight - 8; if (top < 8) top = r.bottom + 8;
          tp.style.top = top + "px";
        };
        const off = () => { if (xl) xl.style.opacity = "0"; tp.classList.remove("show"); };
        box.addEventListener("mousemove", (e) => at(e.clientX));
        box.addEventListener("mouseleave", off);
        box.addEventListener("touchstart", (e) => { if (e.touches[0]) at(e.touches[0].clientX); }, { passive: true });
        box.addEventListener("touchmove", (e) => { if (e.touches[0]) at(e.touches[0].clientX); }, { passive: true });
        box.addEventListener("touchend", off);
      });
    };
    el2.innerHTML = `<!--RAPOR_UI_DK_V1-->
      <style>
      .rpc-dwrap{padding:2px 0}
      .rpc-drow{display:grid;grid-template-columns:1.4fr 1fr;gap:14px;align-items:stretch}
      @media(max-width:820px){.rpc-drow{grid-template-columns:1fr}}
      .rpc-hero{position:relative;background:#fff;border:1px solid #e8edf3;border-radius:16px;padding:18px;box-shadow:0 1px 3px rgba(15,23,42,.06)}
      .rpc-hero.tik{cursor:pointer}.rpc-hero.tik:hover{border-color:#cfdcf5}
      .rpc-hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
      .rpc-hero-lbl{font-size:12px;font-weight:600;color:#475569}
      .rpc-hero-num{font-size:40px;font-weight:800;letter-spacing:-.02em;line-height:1.05;margin-top:2px;color:#0f172a}
      .rpc-hero-num small{font-size:15px;font-weight:600;color:#94a3b8;margin-left:5px}
      .rpc-delta{display:inline-flex;align-items:center;gap:3px;font-size:12px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
      .rpc-delta.up{color:#16a34a;background:#ecfdf3}.rpc-delta.dn{color:#dc2626;background:#fef2f2}.rpc-delta.neu{color:#64748b;background:#f1f5f9}
      .rpc-spark{margin-top:12px;position:relative;cursor:crosshair}
      .rpc-xline{position:absolute;top:2px;bottom:2px;width:1px;background:#2563eb;opacity:0;pointer-events:none;transition:opacity .1s}/*RAPOR_SPARK_HOVER_DK_V1*/
      .rpc-sec{position:relative;font-size:11px;font-weight:800;color:#475569;text-transform:uppercase;letter-spacing:.06em;margin:18px 2px 9px;display:flex;align-items:center;gap:7px}
      .rpc-sec::before{content:"";width:3px;height:13px;border-radius:2px;background:#2563eb}
      .rpc-sec .rpc-qi{position:static;margin-left:2px}
      .rpc-grid{display:grid;gap:10px}.rpc-grid.g4{grid-template-columns:repeat(4,1fr)}.rpc-grid.g3{grid-template-columns:repeat(3,1fr)}
      @media(max-width:820px){.rpc-grid.g4{grid-template-columns:repeat(2,1fr)}}
      .rpc-tile{position:relative;background:#fff;border:1px solid #e8edf3;border-radius:13px;padding:12px 13px;box-shadow:0 1px 3px rgba(15,23,42,.05)}
      .rpc-tile.tik{cursor:pointer;transition:border-color .12s,transform .12s}.rpc-tile.tik:hover{border-color:#cfdcf5;transform:translateY(-1px)}
      .rpc-num{font-size:24px;font-weight:800;color:#0f172a;line-height:1}
      .rpc-lbl{font-size:11.5px;color:#475569;margin-top:6px;font-weight:500}
      .rpc-chip{display:inline-block;margin-top:7px;font-size:11px;font-weight:700;padding:2px 7px;border-radius:999px}
      .rpc-chip.up{color:#16a34a;background:#ecfdf3}.rpc-chip.dn{color:#dc2626;background:#fef2f2}.rpc-chip.neu{color:#64748b;background:#f1f5f9}
      .rpc-meter{position:relative;background:#fff;border:1px solid #e8edf3;border-radius:16px;padding:16px;box-shadow:0 1px 3px rgba(15,23,42,.05);display:flex;flex-direction:column;justify-content:center}
      .rpc-mtop{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px}
      .rpc-mtop .t{font-size:13px;font-weight:700;color:#0f172a}.rpc-mtop .v{font-size:12px;color:#475569;font-weight:600}
      .rpc-track{height:12px;background:#f1f5f9;border-radius:7px;overflow:hidden}.rpc-fill{height:100%;border-radius:7px}
      .rpc-note{font-size:12px;color:#475569;margin-top:9px;line-height:1.5}
      .rpc-pill{position:relative;display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;padding:5px 12px;border-radius:999px}
      .rpc-pill.good{color:#16a34a;background:#ecfdf3}.rpc-pill.warn{color:#d97706;background:#fff7ed}
      .rpc-rev{position:relative;background:linear-gradient(180deg,#f6faf7,#eefaf1);border:1px solid #cdeede;border-radius:13px;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;gap:12px}
      .rpc-rev .l{font-size:12px;color:#16a34a;font-weight:700}.rpc-rev .n{font-size:20px;font-weight:800;color:#15803d}
      .rpc-qi{position:absolute;top:9px;right:9px;width:16px;height:16px;border-radius:50%;background:#eef2f7;color:#94a3b8;font-size:10px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;cursor:help;z-index:2;line-height:1}
      .rpc-pill .rpc-qi{position:static;width:13px;height:13px;margin-left:2px;background:transparent;color:currentColor;opacity:.7}
      .rpc-tip{position:fixed;max-width:260px;background:#0f172a;color:#f8fafc;font-size:12px;font-weight:500;line-height:1.5;padding:9px 11px;border-radius:9px;box-shadow:0 8px 28px rgba(15,23,42,.32);z-index:9999;opacity:0;pointer-events:none;transition:opacity .12s}
      .rpc-tip.show{opacity:1}.rpc-tip b{color:#93c5fd}
      </style>
      <div class="rpc-dwrap">
        <div class="rpc-drow">
          <div class="rpc-hero tik" id="rp-oz-ziyaret" data-tip="Tamamlanan Ziyaret: dönemde durumu TAMAMLANDI olan ziyaret. Aynı müşteriye 2 ziyaret = 2 sayılır." title="Ziyaretleri listele">
            <div class="rpc-hero-top">
              <div><div class="rpc-hero-lbl">Tamamlanan Ziyaret · dönem</div><div class="rpc-hero-num">${o.toplam_ziyaret || 0}<small>ziyaret</small></div></div>
              ${(() => { const dz = _delta(o.toplam_ziyaret, po.toplam_ziyaret); return dz ? `<span class="rpc-delta ${_dcls(dz)}">${esc(dz.txt)}</span>` : ""; })()}
            </div>
            ${(ozet.gunluk && ozet.gunluk.length > 1) ? `<div class="rpc-spark" data-g="${esc(JSON.stringify(ozet.gunluk.map(g => ({ t: String(g.tarih || "").slice(0,10), v: Number(g.ziyaret) || 0 }))))}">${_rpSpark(ozet.gunluk.map(g => Number(g.ziyaret) || 0))}<div class="rpc-xline"></div></div>` : ""}
          </div>
          ${(() => { const pf = Number(o.portfoy || 0), ul = Number(o.benzersiz_nokta || 0), pct = pf ? Math.min(100, Math.round(100 * ul / pf)) : 0, cc = pct >= 60 ? "#16a34a" : pct >= 30 ? "#2563eb" : "#d97706"; return `<div class="rpc-meter" data-tip="Portföy Kapsamı: Ulaşılan Müşteri ÷ Portföy. Yeşil ≥%60, mavi ≥%30, amber <%30.">
            <div class="rpc-mtop"><span class="t">📍 Portföy Kapsamı</span><span class="v">${ul} / ${pf} müşteri</span></div>
            <div class="rpc-track"><div class="rpc-fill" style="width:${pct}%;background:${cc}"></div></div>
            <div class="rpc-note">Dönemde portföyün <b style="color:${cc}">%${pct}</b>'ine ulaşıldı${pf && ul < pf ? ` · <b>${pf - ul}</b> müşteri hiç ziyaret edilmedi` : ""}.</div>
          </div>`; })()}
        </div>

        <div class="rpc-sec" data-tip="Oklar önceki eşit döneme göre değişimi gösterir.">Genel Bakış</div>
        <div class="rpc-grid g4">
          ${_dtile(null, o.planlanan, "Planlanan", "Planlanan: planlanmış ama henüz tamamlanmamış ziyaret (durum = PLANLANDI).")}
          ${_dtile("rp-oz-benzersiz", o.benzersiz_nokta, "Ulaşılan Müşteri", "Ulaşılan Müşteri: dönemde en az 1 ziyaret yapılan FARKLI müşteri.", _delta(o.benzersiz_nokta, po.benzersiz_nokta), false, "Ulaşılan müşterileri listele")}
          ${_dtile("rp-oz-yeni", o.yeni_nokta, "Yeni Müşteri Ziyareti", "Yeni Müşteri Ziyareti: durumu 'Yeni Nokta' müşterilere ziyaret (edinim değil).", _delta(o.yeni_nokta, po.yeni_nokta), false, "Yeni müşteri ziyaretlerini listele")}
          ${_dtile("rp-oz-pasif", o.pasif_riskli, "Yeniden Kazanım", "Yeniden Kazanım: durumu Pasif/Eski/Riskli müşterilere ziyaret.", _delta(o.pasif_riskli, po.pasif_riskli), true, "Yeniden kazanım ziyaretlerini listele")}
        </div>

        <div class="rpc-sec">Teklif Özeti</div>
        <div class="rpc-grid g4">
          ${_dtile("rp-tk-toplam", t.toplam, "Toplam", "Toplam Teklif: dönemde oluşturulan tüm teklifler.", _delta(t.toplam, ptk.toplam), false, "Tüm teklifleri listele")}
          ${_dtile("rp-tk-kaz", t.kazanilan, "Kazanılan", "Kazanılan: KAZANILDI teklif adedi.", _delta(t.kazanilan, ptk.kazanilan), false, "Kazanılan teklifleri listele")}
          ${_dtile("rp-tk-kayb", t.kaybedilen, "Kaybedilen", "Kaybedilen: KAYBEDILDI teklif adedi.", _delta(t.kaybedilen, ptk.kaybedilen), true, "Kaybedilen teklifleri listele")}
          ${_dtile("rp-tk-acik", t.bekleyen, "Açık", "Açık: henüz sonuçlanmamış teklifler.", null, false, "Açık teklifleri listele")}
        </div>
        <div style="display:flex;align-items:center;gap:14px;justify-content:flex-end;margin-top:10px;flex-wrap:wrap">
          <span class="rpc-pill ${winRate != null && winRate >= 50 ? "good" : "warn"}" data-tip="Win Rate: Kazanılan ÷ (Kazanılan + Kaybedilen). Açık teklifler paydaya girmez.">● Win ${winRate != null ? "%" + winRate : "—"}</span>
          ${kazTutar ? `<div class="rpc-rev" data-tip="Kazanılan Ciro: durumu KAZANILDI tekliflerin toplam ₺ tutarı."><span class="l">Kazanılan Ciro</span><span class="n">${money(kazTutar)}</span></div>` : ""}
        </div>

        ${isMgr && yeniMus && yeniMus.ozet ? (() => { const oz = yeniMus.ozet; return `
        <div class="rpc-sec">Yeni Müşteri</div>
        <div class="rpc-grid g3">
          <div class="rpc-tile tik" id="rp-yeni-mus" data-tip="Yeni Müşteri: ilk ziyareti UYGULAMADAN girilen ve Excel yüklemesinde OLMAYAN gerçek yeni saha müşterisi (dönemde). Toplu yüklenen müşteriler sayılmaz." title="Yeni müşterileri listele"><div class="rpc-num" style="color:#16a34a">${oz.toplam}</div><div class="rpc-lbl">Yeni Müşteri</div></div>
          ${_dtile(null, oz.konumlu, "GPS Pinli", "GPS Pinli: konumu kaydedilmiş yeni müşteri.")}
          ${_dtile(null, oz.vkn_var, "VKN Girilen", "VKN Girilen: vergi kimlik numarası girilmiş yeni müşteri.")}
        </div>`; })() : ""}

        <div class="rpc-tanim" style="margin-top:16px;background:#fff;border:1px solid #e8edf3;border-radius:13px;padding:2px 14px">
          <details><summary style="cursor:pointer;font-size:13px;font-weight:700;padding:11px 0;color:#374151">ⓘ Tüm tanımlar</summary>
          <div style="font-size:12.5px;color:#475569;line-height:1.8;padding-bottom:12px">
            <div><b>Tamamlanan Ziyaret:</b> durumu TAMAMLANDI ziyaret (aynı müşteriye 2 = 2).</div>
            <div><b>Planlanan:</b> planlanmış ama tamamlanmamış ziyaret.</div>
            <div><b>Ulaşılan Müşteri:</b> dönemde ≥1 ziyaret yapılan farklı müşteri.</div>
            <div><b>Yeni Müşteri Ziyareti:</b> 'Yeni Nokta' müşterilere ziyaret.</div>
            <div><b>Yeniden Kazanım:</b> Pasif/Eski/Riskli müşterilere ziyaret.</div>
            <div><b>Yeni Müşteri:</b> ilk ziyareti uygulamadan girilen, Excel'de olmayan gerçek yeni müşteri.</div>
            <div><b>Win Rate:</b> Kazanılan ÷ (Kazanılan + Kaybedilen).</div>
            <div style="margin-top:7px;padding-top:7px;border-top:1px dashed #e8edf3"><b>Durum</b> (Yeni/Aktif/Pasif/Eski/Riskli) ERP satışından otomatik türetilir; kartın arşiv durumundan farklıdır.</div>
          </div></details>
        </div>
      </div>`;
      _rpTips(el2);
      _rpSparkWire(el2);

    // KPI tık → modal
    const ziyFetch = () => api(`/api/saha/ziyaretler?durum=TAMAMLANDI&from=${rpFrom()}&to=${rpTo()}${tipQS()}`);
    const tekFetch = async durum => (await api(`/api/saha/teklifler?from=${rpFrom()}&to=${rpTo()}${tipQS()}${durum ? "&durum=" + durum : ""}`)).teklifler || [];
    const bindZ = (id, baslik, filt) => el2.querySelector("#" + id)?.addEventListener("click", async () => {
      dkModal(load());
      try { let { ziyaretler = [] } = await ziyFetch(); if (filt) ziyaretler = filt(ziyaretler); rpZiyModal(baslik, ziyaretler); } catch (e) { dkKapat(); }
    });
    bindZ("rp-oz-ziyaret", "Ziyaretler", null);
    bindZ("rp-oz-benzersiz", "Ulaşılan Müşteri", zs => { const s = new Set(); return zs.filter(z => { if (s.has(z.musteri_id)) return false; s.add(z.musteri_id); return true; }); });
    bindZ("rp-oz-yeni", "Yeni Müşteri Ziyareti", zs => zs.filter(z => z.musteri_durum === "YENI_NOKTA"));
    bindZ("rp-oz-pasif", "Yeniden Kazanım", zs => zs.filter(z => ["PASIF_NOKTA", "ESKI_NOKTA", "RISKLI_NOKTA"].includes(z.musteri_durum)));  /* RAPOR_R1B — kutu=liste (ESKI_NOKTA) */
    const bindT = (id, baslik, durum, filt) => el2.querySelector("#" + id)?.addEventListener("click", async () => {
      dkModal(load());
      try { let rows = await tekFetch(durum); if (filt) rows = filt(rows); rpTekModal(baslik, rows); } catch (e) { dkKapat(); }
    });
    bindT("rp-tk-toplam", "Tüm Teklifler", null, null);
    bindT("rp-tk-kaz", "Kazanılan Teklifler", "KAZANILDI", null);
    bindT("rp-tk-kayb", "Kaybedilen Teklifler", "KAYBEDILDI", null);
    bindT("rp-tk-acik", "Açık Teklifler", null, rows => rows.filter(x => !["KAZANILDI", "KAYBEDILDI", "IPTAL"].includes(x.durum)));
    if (isMgr && yeniMus) el2.querySelector("#rp-yeni-mus")?.addEventListener("click", () => rpYeniMusModal(yeniMus.musteriler || []));
  }

  // ── Temsilciler ─────────────────────────────────────────────────────────────
  function _rpSegDk(r){  /* RAPOR_SEGMENT_DK_V1 — admin saha_tip -> yoksa ziyaret cogunlugundan turet */
    const a = String(r.saha_tip || "").toUpperCase();
    let t, solid = false;
    if (a === "TUKETICI") { t = "Tüketici"; solid = true; }
    else if (a === "TICARI") { t = "Ticari"; solid = true; }
    else {
      const tk = Number(r.tuketici_z) || 0, tc = Number(r.ticari_z) || 0, tot = tk + tc;
      if (!tot) return `<span style="color:var(--tx-3,#cbd5e1)">—</span>`;
      const sh = Math.max(tk, tc) / tot;
      t = sh < 0.65 ? "Karma" : (tk >= tc ? "Tüketici" : "Ticari");
    }
    const col = t === "Tüketici" ? "#0ea5e9" : t === "Ticari" ? "#f59e0b" : "#8b5cf6";
    const st = solid ? `background:${col};color:#fff;` : `background:${col}1a;color:${col};border:1px solid ${col}55;`;
    const tip = solid ? "Yönetici atadı" : "Ziyaretlerden türetildi";
    return `<span title="${tip}" style="display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:700;white-space:nowrap;${st}">${t}${solid ? "" : " ~"}</span>`;
  }
  function rpRotamEkip(d, box) {  /* SABAH_ROTAM_DK_V2 */
    const kisa = (n) => { n = Number(n) || 0; if (n >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (n >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + Math.round(n); };
    const ALAN = { TICARI: { ad: "Ticari", c: "#f59e0b" }, TUKETICI: { ad: "Tüketici", c: "#0ea5e9" } };
    const alanOf = (t) => { const a = String(t || "").toUpperCase(); return a === "TUKETICI" ? "TUKETICI" : a === "TICARI" ? "TICARI" : null; };
    const T = d.toplam || {}, ekip = d.ekip || [], kritik = d.kritik || [];
    const CSS = `<style>
      .rt{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mor:#6d5ae0;--mor-z:#f0edfd;--mavi:#2563eb;--mavi-z:#EEF3FE;color-scheme:light;color:var(--tx-0);font-family:var(--sans,-apple-system,'Segoe UI',system-ui,sans-serif)}
      .rt *{box-sizing:border-box}
      .rt-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 2px 4px}.rt-hd .t{font-size:20px;font-weight:800;letter-spacing:-.02em}
      .rt-live{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--yesil)}.rt-live .dot{width:8px;height:8px;border-radius:50%;background:var(--yesil);animation:rtp2 1.8s infinite}
      @keyframes rtp2{0%{box-shadow:0 0 0 0 rgba(16,107,74,.45)}70%{box-shadow:0 0 0 7px rgba(16,107,74,0)}100%{box-shadow:0 0 0 0 rgba(16,107,74,0)}}
      .rt-sub{font-size:12.5px;color:var(--tx-2);font-weight:600;margin:0 2px 12px}
      .rt-intro{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:14px 16px;margin-bottom:14px}
      .rt-intro h3{margin:0 0 6px;font-size:13.5px;font-weight:800}.rt-intro p{margin:0;font-size:12.5px;line-height:1.6;color:var(--tx-1)}
      .rt-intro .calc{display:flex;flex-direction:column;gap:5px;margin-top:9px;padding-top:10px;border-top:1px solid var(--cizgi)}.rt-intro .calc div{font-size:12px;color:var(--tx-1);line-height:1.5}.rt-intro .calc b{color:var(--tx-0)}
      .rt-grid{display:grid;gap:10px;grid-template-columns:repeat(4,1fr)}
      .rt-tile{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:13px 14px}.rt-tile .n{font-size:24px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.rt-tile .l{font-size:11px;color:var(--tx-1);margin-top:6px;font-weight:500}
      .rt-tile.al{border-color:rgba(196,61,40,.3);background:linear-gradient(180deg,#fff,#fdf6f4)}.rt-tile.al .n{color:var(--kirmizi)}
      .rt-sech{font-size:11px;font-weight:800;color:var(--tx-1);text-transform:uppercase;letter-spacing:.06em;margin:20px 2px 10px}
      .rt-rep{display:flex;flex-direction:column;gap:9px}
      .rt-rrow{display:grid;grid-template-columns:1fr 130px 210px;gap:16px;align-items:center;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:13px 15px}
      .rt-rnm{font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:8px}.rt-seg{font-size:9.5px;font-weight:800;padding:1px 7px;border-radius:999px}
      .rt-rsub{font-size:11.5px;color:var(--tx-2);margin-top:4px}.rt-rsub b{color:var(--tx-1);font-variant-numeric:tabular-nums}
      .rt-prog .pl{display:flex;justify-content:space-between;font-size:10.5px;color:var(--tx-2);font-weight:600;margin-bottom:4px}.rt-prog .pl b{color:var(--tx-0);font-variant-numeric:tabular-nums}
      .rt-track{height:7px;border-radius:999px;background:var(--zemin-2);overflow:hidden}.rt-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#106B4A,#12b981)}.rt-fill.low{background:linear-gradient(90deg,#C43D28,#e5734f)}
      .rt-skip{background:var(--kirmizi-z);border:1px solid rgba(196,61,40,.18);border-radius:10px;padding:8px 10px;cursor:pointer}.rt-skip .k{font-size:9.5px;font-weight:800;color:var(--kirmizi);text-transform:uppercase;letter-spacing:.04em}.rt-skip .v{font-size:12px;font-weight:700;color:var(--tx-0);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .rt-skip.none{background:var(--yesil-z);border-color:rgba(16,107,74,.18);cursor:default}.rt-skip.none .k{color:var(--yesil)}
      .rt-crit{display:flex;flex-direction:column;gap:8px}
      .rt-crow{display:grid;grid-template-columns:34px 1fr 160px 120px;gap:12px;align-items:center;background:var(--zemin-1);border:1px solid rgba(196,61,40,.22);border-radius:13px;padding:11px 14px}
      .rt-cs{font-size:18px;font-weight:800;color:var(--kirmizi);text-align:center;font-variant-numeric:tabular-nums}
      .rt-cfirm{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rt-cmeta{font-size:11px;color:var(--tx-2);margin-top:2px}
      .rt-cwhy{display:flex;gap:5px;flex-wrap:wrap}.rt-chip{font-size:10px;font-weight:700;padding:2px 7px;border-radius:999px}.rt-chip.r{color:var(--kirmizi);background:var(--kirmizi-z)}.rt-chip.c{color:var(--sari);background:var(--sari-z)}
      .rt-cbtn{width:100%;font-size:11.5px;font-weight:700;padding:7px 10px;border-radius:9px;border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);cursor:pointer}
      .rt-empty{color:var(--tx-2);text-align:center;padding:22px;font-size:13px}
      .rt-how{border:1px solid var(--cizgi);border-radius:14px;background:var(--zemin-1);margin-bottom:14px;overflow:hidden}.rt-how>summary{cursor:pointer;list-style:none;padding:13px 16px;font-size:13px;font-weight:800;color:var(--tx-0);display:flex;align-items:center;gap:8px;user-select:none}.rt-how>summary::-webkit-details-marker{display:none}.rt-how>summary:after{content:'▾';margin-left:auto;color:var(--tx-2);transition:transform .2s}.rt-how[open]>summary:after{transform:rotate(180deg)}.rt-how-b{padding:2px 16px 15px;font-size:12.5px;color:var(--tx-1);line-height:1.6}.rt-how-b p{margin:0 0 10px}.rt-how-b b{color:var(--tx-0)}.rt-how-b table{width:100%;border-collapse:collapse;margin:10px 0;font-size:11.5px}.rt-how-b th{text-align:left;color:var(--tx-2);font-weight:700;padding:6px 8px;border-bottom:1px solid var(--cizgi);font-size:10px;text-transform:uppercase;letter-spacing:.03em}.rt-how-b td{padding:6px 8px;border-bottom:1px solid var(--cizgi);color:var(--tx-0);vertical-align:top}.rt-how-b td:first-child{font-weight:700;white-space:nowrap}.rt-how-b code{background:var(--zemin-2);padding:1px 5px;border-radius:4px;font-size:11px}.rt-how-defs{display:flex;flex-direction:column;gap:7px;margin:10px 0;padding:11px 13px;background:var(--zemin-2);border-radius:10px}.rt-how-defs div{font-size:12px;line-height:1.5}.rt-how-note{font-size:11.5px;color:var(--tx-2);font-style:italic;margin-top:8px}
    </style>`;
    const bugunTarih = new Date().toLocaleDateString("tr-TR", { day: "numeric", month: "long", weekday: "long" });
    const repRows = ekip.map((r) => { const meta = alanOf(r.saha_tip) ? ALAN[alanOf(r.saha_tip)] : { ad: "—", c: "#85858C" }; const pct = r.plan ? Math.round(r.yapilan / r.plan * 100) : 0;
      return `<div class="rt-rrow"><div><div class="rt-rnm">${esc(r.rep)}<span class="rt-seg" style="color:${meta.c};background:${meta.c}1f">${meta.ad}</span></div>
        <div class="rt-rsub"><b>${r.plan}</b> planlı · <b>${r.oneri}</b> öncelikli öneri</div></div>
        <div class="rt-prog"><div class="pl"><span>Bugün yapılan</span><b>${r.yapilan}/${r.plan}</b></div><div class="rt-track"><div class="rt-fill${pct < 50 ? " low" : ""}" style="width:${Math.max(4, pct)}%"></div></div></div>
        ${r.skip ? `<div class="rt-skip" data-kart="${esc(r.skip.id)}"><div class="k">⚠ Atladığı en yüksek</div><div class="v">${esc(r.skip.f)} · skor ${r.skip.s}</div></div>` : `<div class="rt-skip none"><div class="k">✓ Öncelikler kapsanıyor</div><div class="v">atlanan yüksek yok</div></div>`}</div>`; }).join("");
    const critRows = kritik.map((c) => `<div class="rt-crow"><div class="rt-cs">${c.skor}</div>
      <div style="min-width:0"><div class="rt-cfirm">${esc(c.firma)}</div><div class="rt-cmeta">${esc(c.il || "")}${c.ilce ? " · " + esc(c.ilce) : ""}${c.rep ? " · sorumlu: " + esc(c.rep) : ` · <b style="color:var(--kirmizi)">sorumlu atanmamış</b>`}</div></div>
      <div class="rt-cwhy">${c.overdue > 0 ? `<span class="rt-chip r">${kisa(c.overdue)} gecikmiş</span>` : ""}${c.gun === null ? `<span class="rt-chip c">hiç ziyaret</span>` : c.gun > 30 ? `<span class="rt-chip c">${c.gun} gün</span>` : ""}</div>
      <div><button class="rt-cbtn" data-kart="${esc(c.id)}">👤 Müşteri kartı</button></div></div>`).join("");
    box.innerHTML = CSS + `<div class="rt">
      <div class="rt-hd"><div class="t">🌅 Bugün Sahada — Ekip</div><div class="rt-live"><span class="dot"></span>CANLI</div></div>
      <div class="rt-sub">${bugunTarih} · ${ekip.length} temsilci</div>
      <div class="rt-intro"><h3>🌅 Bugün Sahada — yönetici için ne anlatır?</h3>
        <p>Temsilci rotası kişiseldir; bu onun <b>ekip görünümü</b>. Tek soru: <b>bugün ekip doğru müşterilere mi yönelmiş?</b> Kimin planı dolu/boş, hangi temsilci kolay durakları yaparken yüksek-öncelikli hesabı atlıyor, ve <b>hangi kritik hesap kimsenin planında değil.</b></p>
        <div class="calc">
          <div><b>Planlı</b> = bugüne PLANLANDI ziyaret. <b>Öncelikli öneri</b> = motorun o rep için ürettiği skor≥40 durak. <b>Yapılan</b> = bugün TAMAMLANDI (canlı).</div>
          <div><b>Atladığı en yüksek</b> = rep'in bugün planlamadığı en yüksek skorlu müşterisi. <b>Sahipsiz kritik</b> = skor≥55 ama bugün kimsenin planında olmayan hesaplar.</div>
        </div></div>
      <div class="rt-grid">
        <div class="rt-tile"><div class="n">${T.plan || 0}</div><div class="l">Bugün planlı durak (ekip)</div></div>
        <div class="rt-tile"><div class="n">${T.oneri || 0}</div><div class="l">Öncelikli öneri</div></div>
        <div class="rt-tile"><div class="n" style="color:var(--yesil)">${T.yapilan || 0}</div><div class="l">Bugün yapılan (canlı)</div></div>
        <div class="rt-tile al"><div class="n">${T.kritik || 0}</div><div class="l">Kritik hesap · ${T.sahipsiz || 0} sahipsiz</div></div>
      </div>
      <details class="rt-how"><summary>🔍 Nasıl çalışıyor? — öneri sayıları ve skor nasıl hesaplanıyor</summary><div class="rt-how-b"><p>Motor her müşteriyi <b>0–100 arası bir öncelik skoruyla</b> puanlar; bu skor hem bu yönetici panosunu hem de temsilcinin kişisel rotasını besler (birebir aynı hesap). Skor dört bileşenin toplamıdır:</p><table><tr><th>Bileşen</th><th>Neyi ölçer</th><th>Formül (tavan)</th><th>Kaynak</th></tr><tr><td>🔴 Risk</td><td>vadesi geçmiş alacak</td><td>min(35, gecikmiş₺ / 1M × 1.6)</td><td><code>bi_musteri_risk.vadesi_gecmis</code></td></tr><tr><td>🥶 İhmal</td><td>son ziyaretten bu yana gün</td><td>min(28, gün / 2.2)</td><td><code>saha_ziyaret</code> son TAMAMLANDI</td></tr><tr><td>💰 Değer</td><td>yıllık ERP cirosu</td><td>min(22, ciro₺ / 1M × 0.28)</td><td><code>bi_satis_faturalari</code> (12 ay)</td></tr><tr><td>📋 Fırsat</td><td>açık teklif sayısı</td><td>min(15, teklif × 6)</td><td><code>saha_teklif</code> (açık)</td></tr></table><p><b>Örnek:</b> ₺16M gecikmiş → 35 (tavan) &nbsp;+&nbsp; 48 gün ihmal → 22 &nbsp;+&nbsp; ₺54M ciro → 22 (tavan) &nbsp;+&nbsp; 0 teklif → 0 &nbsp;=&nbsp; <b>skor 79</b>.</p><div class="rt-how-defs"><div><b>Öncelikli öneri</b> (her rep için sayı) = o temsilcinin kitabında <b>skor ≥ 40</b> olan müşteri sayısı — "bugün ilgilenilmeye değer" eşiği.</div><div><b>Atladığı en yüksek</b> = temsilcinin bugün <code>PLANLANDI</code>'ya almadığı <b>en yüksek skorlu</b> müşterisi (kolay durak yapıp riskliyi atlıyor mu?).</div><div><b>Sahipsiz / atlanan kritik</b> = <b>skor ≥ 55</b> olup bugün <b>kimsenin</b> planında olmayan hesaplar; "sahipsiz" = sorumlu temsilci atanmamış.</div><div><b>Planlı</b> = bugüne PLANLANDI ziyaret &nbsp;·&nbsp; <b>Yapılan</b> = bugün TAMAMLANDI (canlı) — ikisi de <code>saha_ziyaret</code>'ten.</div><div><b>Neden ERP eşleşmesi önemli:</b> Risk ve Değer yalnız ERP'ye bağlı (<code>musteri_kodu</code>'lu) müşteride görünür → eşleşmemiş müşteri düşük skorlanır, bu da eşleştirmeyi teşvik eder.</div></div><p style="font-size:13px;font-weight:800;color:var(--tx-0);margin:14px 0 6px">📈 Nasıl öğreniyor & nereye gidiyor?</p><div class="rt-how-defs" style="background:var(--yesil-z,#EAF7F1)"><div><b>1) Kayıt (✅ canlı).</b> Her sabah üretilen öneriler <code>saha_rota_log</code> tablosuna yazılır — bugün başladı. Böylece "ne önerdik" ile "ne yapıldı" kıyaslanabilir hale gelir.</div><div><b>2) Gece uzlaştırma (⏳ sıradaki adım).</b> Her akşam o günün önerileri gerçekleşen ziyaretlerle (<code>TAMAMLANDI</code>) karşılaştırılır ve her temsilci için şunlar öğrenilir: gerçek <b>gün-kapasitesi</b> (kaç durak yapıyor), ort. <b>görüşme süresi</b>, hangi <b>nedenlere</b> (risk/ihmal/değer/fırsat) gidip hangilerini atlıyor, ve <b>öneri→gerçekleşme oranı (%)</b>.</div><div><b>3) Kendini ayarlama.</b> Öğrenilenlerle skor <b>ağırlıkları temsilciye göre kayar</b> (ör. hep riske gidip değeri atlayan repte risk ağırlığı artar), günlük durak sayısı sabit 10 değil <b>o repin gerçek temposuna</b> oturur.</div><div><b>4) Tahmin — nereye gidiyor (🔮 hedef).</b> Yeterli veri birikince: her rep için <b>gerçekçi günlük rota + bitiş saati tahmini</b>; başlangıç noktasına göre <b>yakınlık-optimize sıralama</b>; ve en önemlisi bir hesabın <b>Aktif→Pasif kayacağını önceden</b> işaretleyip "geç kalmadan git" uyarısı (reaktif değil <b>proaktif</b>).</div></div><p class="rt-how-note">Bugün skor <b>deterministik ve şeffaf</b> (ağırlıklar 35/28/22/15 sabit başlangıç). Öğrenme + tahmin katmanı üstüne gelecek; kayıt bugün başladığı için ilk uzlaştırmalar birkaç gün veri sonrası anlam kazanır.</p></div></details>
      <div class="rt-sech">Ekip · bugünkü dağılım & öncelik uyumu</div>
      ${ekip.length ? `<div class="rt-rep">${repRows}</div>` : `<div class="rt-empty">Temsilci yok.</div>`}
      <div class="rt-sech">🚨 Sahipsiz / atlanan kritik hesaplar</div>
      ${kritik.length ? `<div class="rt-crit">${critRows}</div>` : `<div class="rt-empty">Kritik açık hesap yok. 👍</div>`}
    </div>`;
    box.querySelectorAll("[data-kart]").forEach(b => b.addEventListener("click", async () => {
      const id = b.dataset.kart; if (!id) return; let c = (S.musteriler || []).find(x => x.id === id);
      if (!c) { try { const res = await api(`/api/saha/musteriler/${id}`); c = res.musteri || res; } catch (e) {} }
      if (c) musteriDetay(c);
    }));
  }
  async function rpRotam() {  /* SABAH_ROTAM_DK_V1 */
    const el = icerik(); if (!el) return; el.innerHTML = load();
    let d;
    try { d = await api(`/api/saha/rapor/sabah-rotam`); }
    catch (e) { const b = icerik(); if (b) b.innerHTML = hataH(e); return; }
    const box = icerik(); if (!box) return;
    if (d && d.rol === "yonetici") { return rpRotamEkip(d, box); }  /* SABAH_ROTAM_DK_V2 */
    const kisa = (n) => { n = Number(n) || 0; if (n >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (n >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + Math.round(n); };
    const hhmm = (m) => String(Math.floor(m / 60)).padStart(2, "0") + ":" + String(Math.round(m % 60)).padStart(2, "0");
    const hav = (a, b) => { if (!a || !b || a.lat == null || b.lat == null) return null; const R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180, dLng = (b.lng - a.lng) * Math.PI / 180, la1 = a.lat * Math.PI / 180, la2 = b.lat * Math.PI / 180; const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLng / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
    const CSS = `<style>
      .rt{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mor:#6d5ae0;--mor-z:#f0edfd;--mavi:#2563eb;--mavi-z:#EEF3FE;color-scheme:light;color:var(--tx-0);font-family:var(--sans,-apple-system,'Segoe UI',system-ui,sans-serif)}
      .rt *{box-sizing:border-box}
      .rt-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 2px 4px}.rt-hd .t{font-size:20px;font-weight:800;letter-spacing:-.02em}
      .rt-live{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--yesil)}.rt-live .dot{width:8px;height:8px;border-radius:50%;background:var(--yesil);animation:rtp 1.8s infinite}
      @keyframes rtp{0%{box-shadow:0 0 0 0 rgba(16,107,74,.45)}70%{box-shadow:0 0 0 7px rgba(16,107,74,0)}100%{box-shadow:0 0 0 0 rgba(16,107,74,0)}}
      .rt-sub{font-size:12.5px;color:var(--tx-2);font-weight:600;margin:0 2px 12px}
      .rt-ai{background:linear-gradient(135deg,#eef3fe,#fff);border:1px solid rgba(37,99,235,.2);border-radius:15px;padding:14px 16px;margin-bottom:12px;display:flex;gap:11px;align-items:flex-start}.rt-ai .ico{font-size:18px}.rt-ai .tx{font-size:13.5px;line-height:1.55}.rt-ai .tx b{font-weight:800}
      .rt-setp{background:linear-gradient(135deg,#f0edfd,#fff);border:1px solid rgba(109,90,224,.28);border-radius:15px;padding:15px 16px;margin-bottom:12px}
      .rt-setp .t{font-size:14px;font-weight:800;color:var(--mor)}.rt-setp .p{font-size:12.5px;color:var(--tx-1);line-height:1.55;margin:6px 0 0}
      .rt-setp .sug{font-size:12.5px;font-weight:700;background:var(--zemin-1);border:1px solid rgba(109,90,224,.22);border-radius:11px;padding:10px 12px;margin-top:11px}
      .rt-setp .btns{display:flex;gap:8px;margin-top:11px}.rt-setp .btn{flex:1;text-align:center;font-size:12.5px;font-weight:700;padding:9px;border-radius:10px;cursor:pointer;border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1)}.rt-setp .btn.pri{background:var(--mor);color:#fff;border-color:var(--mor)}
      .rt-cap{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:13px 15px;margin-bottom:12px}.rt-cap .row{display:flex;justify-content:space-between;align-items:baseline;font-size:12.5px}.rt-cap .row .l{color:var(--tx-1);font-weight:600}.rt-cap .row .r{font-weight:800;font-variant-numeric:tabular-nums}
      .rt-cap .bar{height:9px;border-radius:999px;background:var(--zemin-2);overflow:hidden;margin:9px 0 6px;display:flex}.rt-cap .s1{background:linear-gradient(90deg,#6d5ae0,#8b7bec)}.rt-cap .s2{background:linear-gradient(90deg,#2563eb,#3b82f6)}.rt-cap .s3{background:repeating-linear-gradient(45deg,#e4e4e2,#e4e4e2 5px,#efefee 5px,#efefee 10px)}
      .rt-cap .lgn{display:flex;gap:14px;font-size:10.5px;color:var(--tx-2);font-weight:600}.rt-cap .lgn i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:middle}
      .rt-start{display:flex;align-items:center;gap:10px;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:10px 14px;margin-bottom:12px;flex-wrap:wrap}.rt-start .o{font-size:12.5px;font-weight:700;flex:1;min-width:150px}.rt-start .o span{color:var(--tx-2);font-weight:600}.rt-start .chg{font-size:11px;font-weight:700;color:var(--mavi);cursor:pointer}
      .rt-sech{font-size:11px;font-weight:800;color:var(--tx-1);text-transform:uppercase;letter-spacing:.06em;margin:18px 2px 9px;display:flex;align-items:center;gap:8px}.rt-sech .cnt{color:var(--tx-2)}
      .rt-route{display:flex;flex-direction:column;gap:10px}
      .rt-stop{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:15px;padding:13px 15px;position:relative;overflow:hidden}.rt-stop:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
      .rt-stop.commit:before{background:var(--mor)}.rt-stop.hot:before{background:var(--kirmizi)}.rt-stop.warm:before{background:var(--sari)}.rt-stop.ok:before{background:var(--yesil)}.rt-stop.over{opacity:.72}
      .rt-top{display:flex;align-items:center;gap:12px}
      .rt-rank{width:30px;height:30px;border-radius:50%;background:var(--tx-0);color:#fff;font-size:14px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-variant-numeric:tabular-nums}.rt-stop.commit .rt-rank{background:var(--mor)}.rt-stop.hot .rt-rank{background:var(--kirmizi)}
      .rt-firm{flex:1;min-width:0;font-size:15px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .rt-skor{text-align:right;flex-shrink:0}.rt-skor .n{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}.rt-stop.hot .rt-skor .n{color:var(--kirmizi)}.rt-stop.warm .rt-skor .n{color:var(--sari)}.rt-stop.ok .rt-skor .n{color:var(--yesil)}.rt-stop.commit .rt-skor .n{color:var(--mor)}.rt-skor .l{font-size:9px;color:var(--tx-2);font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-top:2px}
      .rt-loc{font-size:11.5px;color:var(--tx-2);margin-top:3px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}.rt-loc .eta{color:var(--tx-0);font-weight:800;background:var(--zemin-2);padding:1px 7px;border-radius:999px}.rt-loc .dist{color:var(--tx-1);font-weight:700}
      .rt-nopin{color:var(--sari);font-weight:700;background:var(--sari-z);padding:1px 7px;border-radius:999px;font-size:10.5px;cursor:pointer}
      .rt-why{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}
      .rt-chip{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}.rt-chip.commit{color:var(--mor);background:var(--mor-z)}.rt-chip.r{color:var(--kirmizi);background:var(--kirmizi-z)}.rt-chip.c{color:var(--sari);background:var(--sari-z)}.rt-chip.v{color:var(--yesil);background:var(--yesil-z)}.rt-chip.o{color:var(--mavi);background:var(--mavi-z)}
      .rt-acts{display:flex;gap:7px;margin-top:12px;flex-wrap:wrap}.rt-act{flex:1;min-width:78px;text-align:center;border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);font-size:12px;font-weight:700;padding:8px 6px;border-radius:9px;cursor:pointer;text-decoration:none;display:inline-block}.rt-act.pri{background:var(--tx-0);color:#fff;border-color:var(--tx-0)}.rt-act.off{opacity:.4;cursor:not-allowed;pointer-events:none}
      .rt-over{font-size:12px;font-weight:800;color:var(--tx-2);margin:16px 2px 8px}
      .rt-empty{color:var(--tx-2);text-align:center;padding:26px;font-size:13px}
    </style>`;
    const durak = d.duraklar || [];
    const commits = durak.filter(x => x.plan_bugun);
    const rest = durak.filter(x => !x.plan_bugun).sort((a, b) => (b.skor || 0) - (a.skor || 0));
    const tier = (s) => s >= 65 ? "hot" : s >= 40 ? "warm" : "ok";
    const chips = (c) => { const o = [];
      if (c.plan_bugun) o.push(`<span class="rt-chip commit">📅 Bugün planlı</span>`);
      if (c.overdue > 0) o.push(`<span class="rt-chip r">🔴 ${kisa(c.overdue)} gecikmiş</span>`);
      if (c.gun === null) o.push(`<span class="rt-chip c">🥶 Hiç ziyaret</span>`); else if (c.gun > 30) o.push(`<span class="rt-chip c">🥶 ${c.gun} gün ihmal</span>`);
      if (c.ciro >= 30e6) o.push(`<span class="rt-chip v">💰 Yüksek ciro (${kisa(c.ciro)}/yıl)</span>`);
      if (c.teklif > 0) o.push(`<span class="rt-chip o">📋 ${c.teklif} açık teklif</span>`);
      return o.join(""); };
    const acts = (c) => { const yol = (c.lat != null) ? `https://www.google.com/maps/dir/?api=1&destination=${c.lat},${c.lng}` : null;
      return `<div class="rt-acts">
        <button class="rt-act pri" data-kart="${esc(c.id)}">👤 Müşteri kartı</button>
        ${c.telefon ? `<a class="rt-act" href="tel:${esc(String(c.telefon).replace(/[^0-9+]/g, ""))}">📞 Ara</a>` : `<span class="rt-act off">📞 Ara</span>`}
        ${yol ? `<a class="rt-act" href="${yol}" target="_blank" rel="noopener">🧭 Yol tarifi</a>` : `<span class="rt-act off">🧭 Yol tarifi</span>`}
      </div>`; };
    const bugunTarih = new Date().toLocaleDateString("tr-TR", { day: "numeric", month: "long", weekday: "long" });

    // ── başlangıç yoksa: öner-onayla / check-in ──
    if (!d.baslangic) {
      const ob = d.oneri_baslangic;
      const rows = [...commits, ...rest].map((c, i) => rotamCard(c, i + 1, c.plan_bugun ? "commit" : tier(c.skor), null));
      box.innerHTML = CSS + `<div class="rt">
        <div class="rt-hd"><div class="t">🌅 Sabah Rotam</div><div class="rt-live"><span class="dot"></span>CANLI</div></div>
        <div class="rt-sub">${bugunTarih} · ${durak.length} durak</div>
        <div class="rt-setp"><div class="t">🏁 Başlangıç noktanı belirle</div>
          <div class="p">Rotanı mesafeye göre sıralayıp güne kaç durak sığdığını hesaplayabilmem için güne <b>nereden başladığını</b> bilmem gerek.</div>
          ${ob ? `<div class="sug">📍 Öneri: son check-in konumun (${Number(ob.lat).toFixed(3)}, ${Number(ob.lng).toFixed(3)}) — burayı başlangıç yapayım mı?</div>` : `<div class="sug">📍 Henüz check-in konumun yok. Şu an neredeysen oradan başla.</div>`}
          <div class="btns">${ob ? `<button class="btn pri" id="rt-kabul">✓ Evet, burayı kullan</button>` : ""}<button class="btn${ob ? "" : " pri"}" id="rt-checkin">📍 Buradan başla (check-in)</button></div>
        </div>
        <div class="rt-sech">Bugünkü duraklar <span class="cnt">· öncelik sırası</span></div>
        ${durak.length ? `<div class="rt-route">${rows.join("")}</div>` : `<div class="rt-empty">Portföyünde durak yok.</div>`}
      </div>`;
      const kaydet = async (lat, lng, ad, kaynak) => { try { await api(`/api/saha/rep-baslangic`, { method: "POST", body: JSON.stringify({ lat, lng, ad, kaynak }) }); rpRotam(); } catch (e) { alert("Kaydedilemedi: " + (e.message || e)); } };
      const kb = box.querySelector("#rt-kabul"); if (kb && ob) kb.addEventListener("click", () => kaydet(Number(ob.lat), Number(ob.lng), "Son check-in", "oneri_kabul"));
      const ci = box.querySelector("#rt-checkin"); if (ci) ci.addEventListener("click", () => {
        if (!navigator.geolocation) { alert("Konum desteklenmiyor"); return; }
        ci.textContent = "📍 Konum alınıyor…";
        navigator.geolocation.getCurrentPosition(p => kaydet(p.coords.latitude, p.coords.longitude, "Check-in", "checkin"), err => { ci.textContent = "📍 Buradan başla (check-in)"; alert("Konum alınamadı: " + err.message); });
      });
      bindKart(box);
      return;
    }

    // ── başlangıç var: mesafe + güne sığdır ──
    const bas = { lat: Number(d.baslangic.lat), lng: Number(d.baslangic.lng) };
    const WSTART = 9 * 60, WEND = 17 * 60, VISIT = 34, SPEED = 40; // km/h şehir
    const legDk = (from, to) => { const km = hav(from, to); return km == null ? 30 : Math.max(6, Math.round(km / SPEED * 60)); };
    const ordered = [...commits, ...rest];
    let clk = WSTART, prev = bas, capIdx = ordered.length, yolTop = 0;
    const sched = ordered.map((c, i) => { const from = (c.lat != null ? { lat: c.lat, lng: c.lng } : null); const leg = legDk(prev, from); let arr = clk + leg; const dep = arr + VISIT; const fits = dep <= WEND; if (fits) { clk = dep; prev = from || prev; yolTop += leg; } else if (capIdx === ordered.length) capIdx = i; return { c, leg, arr, dep, fits, km: hav(bas, from) }; });
    const bugun = sched.slice(0, capIdx), yarin = sched.slice(capIdx);
    const bitis = bugun.length ? bugun[bugun.length - 1].dep : WSTART;
    const gorTop = bugun.length * VISIT, span = WEND - WSTART;
    const pG = Math.round(gorTop / span * 100), pY = Math.round(yolTop / span * 100), pB = Math.max(0, 100 - pG - pY);
    const card = (sc, rank) => rotamCard(sc.c, rank, sc.c.plan_bugun ? "commit" : tier(sc.c.skor), sc);
    const komut = commits.length ? `${commits.length} planın` : "planın yok";
    const enUst = rest[0];
    box.innerHTML = CSS + `<div class="rt">
      <div class="rt-hd"><div class="t">🌅 Sabah Rotam</div><div class="rt-live"><span class="dot"></span>CANLI</div></div>
      <div class="rt-sub">${bugunTarih}</div>
      <div class="rt-ai"><div class="ico">✨</div><div class="tx"><b>Bugün ${komut}.</b> ${commits.length ? "Önce onlar. " : ""}${enUst ? `En öncelikli öneri: <b>${esc(enUst.firma)}</b> (skor ${enUst.skor}). ` : ""}Güne <b>${bugun.length} durak</b> sığıyor${yarin.length ? `, ${yarin.length} uzak durak yarına daha uygun` : ""}.</div></div>
      <div class="rt-cap">
        <div class="row"><span class="l">Bugünün kapasitesi</span><span class="r">${bugun.length} durak · tahmini bitiş ~${hhmm(bitis)}</span></div>
        <div class="bar"><div class="s1" style="width:${pG}%"></div><div class="s2" style="width:${pY}%"></div><div class="s3" style="width:${pB}%"></div></div>
        <div class="lgn"><span><i style="background:#6d5ae0"></i>Görüşme ~${Math.round(gorTop / 60 * 10) / 10} sa</span><span><i style="background:#2563eb"></i>Yol ~${Math.round(yolTop / 60 * 10) / 10} sa</span><span><i style="background:#e4e4e2"></i>Boş</span></div>
      </div>
      <div class="rt-start"><div class="o">🏁 Başlangıç: <span>${esc(d.baslangic.ad || "Belirlenmiş konum")} · 09:00</span></div><span class="chg" id="rt-degis">değiştir</span></div>
      <div class="rt-sech">🚗 Bugünün rotası <span class="cnt">· ${bugun.length} durak</span></div>
      ${bugun.length ? `<div class="rt-route">${bugun.map((sc, i) => card(sc, i + 1)).join("")}</div>` : `<div class="rt-empty">Bugün için durak yok.</div>`}
      ${yarin.length ? `<div class="rt-over">⏭ Bugüne sığmadı — yarına (${yarin.length})</div><div class="rt-route">${yarin.map((sc, i) => card(sc, bugun.length + i + 1)).join("")}</div>` : ""}
    </div>`;
    const dg = box.querySelector("#rt-degis"); if (dg) dg.addEventListener("click", () => {
      if (!navigator.geolocation) { alert("Konum desteklenmiyor"); return; }
      dg.textContent = "konum alınıyor…";
      navigator.geolocation.getCurrentPosition(async p => { try { await api(`/api/saha/rep-baslangic`, { method: "POST", body: JSON.stringify({ lat: p.coords.latitude, lng: p.coords.longitude, ad: "Check-in", kaynak: "checkin" }) }); rpRotam(); } catch (e) { alert(e.message || e); } }, err => { dg.textContent = "değiştir"; alert("Konum alınamadı: " + err.message); });
    });
    bindKart(box);

    function rotamCard(c, rank, cls, sc) {
      const eta = sc && sc.arr != null ? `<span class="eta">~${hhmm(sc.arr)}</span>` : "";
      const dist = (c.lat != null) ? (sc ? `<span class="dist">${sc.leg} dk yol</span>` : (d.baslangic ? `<span class="dist">${Math.round((hav(bas, { lat: c.lat, lng: c.lng }) || 0))} km</span>` : "")) : `<span class="rt-nopin" data-nopin="1">📍 Konum sabitlenmemiş · pinle</span>`;
      const son = (c.gun != null && !c.plan_bugun) ? `son ${c.gun} gün önce` : "";
      return `<div class="rt-stop ${cls}${sc && !sc.fits ? " over" : ""}"><div class="rt-top"><div class="rt-rank">${rank}</div>
        <div style="flex:1;min-width:0"><div class="rt-firm">${esc(c.firma)}</div><div class="rt-loc">${eta}<span>${esc(c.il || "")}${c.ilce ? " · " + esc(c.ilce) : ""}</span>${dist}${son ? `<span>${son}</span>` : ""}</div></div>
        <div class="rt-skor"><div class="n">${c.plan_bugun ? "📌" : c.skor}</div><div class="l">${c.plan_bugun ? "plan" : "öncelik"}</div></div></div>
        <div class="rt-why">${chips(c)}</div>${acts(c)}</div>`;
    }
    function bindKart(root) {
      root.querySelectorAll("[data-kart]").forEach(b => b.addEventListener("click", async () => {
        const id = b.dataset.kart; let c = (S.musteriler || []).find(x => x.id === id);
        if (!c) { try { const res = await api(`/api/saha/musteriler/${id}`); c = res.musteri || res; } catch (e) {} }
        if (c) musteriDetay(c);
      }));
    }
  }
  async function rpRisk() {  /* RISK_SAHA_DK_V1 */
    const el = icerik(); if (!el) return; el.innerHTML = load();
    try {
      const d = await api(`/api/saha/rapor/risk-saha?_=1${tipQS()}`);
      const box = icerik(); if (!box) return;
      const kisa = (n) => { n = Number(n) || 0; if (n >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (n >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + Math.round(n); };
      const ALAN = { TICARI: { ad: "Ticari" }, TUKETICI: { ad: "Tüketici" } };
      const repAlan = (t) => { const a = String(t || "").toUpperCase(); return a === "TUKETICI" ? "TUKETICI" : a === "TICARI" ? "TICARI" : null; };
      const sev = (g) => (g === null || g > 30) ? "hot" : (g > 14 ? "warm" : "ok");
      const visLbl = (g) => g === null ? ["Hiç ziyaret", "cold"] : g > 30 ? [g + " gün önce", "cold"] : g > 14 ? [g + " gün önce", "warm"] : [g + " gün önce", "fresh"];
      const CSS = `<style>
        .rk{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mavi:#2563eb;color-scheme:light;color:var(--tx-0);font-family:var(--sans,-apple-system,'Segoe UI',system-ui,sans-serif)}
        .rk *{box-sizing:border-box}
        .rk-intro{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:15px 17px;margin-bottom:14px}
        .rk-intro h3{margin:0 0 6px;font-size:14px;font-weight:800;color:var(--tx-0)}
        .rk-intro p{margin:0;font-size:12.5px;line-height:1.6;color:var(--tx-1)}
        .rk-intro .calc{display:flex;flex-direction:column;gap:5px;margin-top:9px;padding-top:10px;border-top:1px solid var(--cizgi)}
        .rk-intro .calc div{font-size:12px;color:var(--tx-1);line-height:1.5}.rk-intro .calc b{color:var(--tx-0)}
        .rk-intro code{background:var(--zemin-2);padding:1px 6px;border-radius:5px;font-size:11px}
        .rk-grid{display:grid;gap:10px;grid-template-columns:repeat(4,1fr)}
        .rk-hero{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:16px;padding:18px}
        .rk-hero.al{border-color:rgba(196,61,40,.3);background:linear-gradient(180deg,#fff,#fdf6f4)}
        .rk-hero .l{font-size:12px;font-weight:600;color:var(--tx-1)}.rk-hero .n{font-size:34px;font-weight:800;letter-spacing:-.02em;color:var(--tx-0);margin-top:2px;font-variant-numeric:tabular-nums}.rk-hero.al .n{color:var(--kirmizi)}
        .rk-tile{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:12px 13px}
        .rk-tile .n{font-size:22px;font-weight:800;color:var(--tx-0);line-height:1;font-variant-numeric:tabular-nums}.rk-tile .l{font-size:11px;color:var(--tx-1);margin-top:6px;font-weight:500}
        .rk-sec{font-size:11px;font-weight:800;color:var(--tx-1);text-transform:uppercase;letter-spacing:.06em;margin:20px 2px 10px;display:flex;justify-content:space-between;align-items:center}
        .rk-fil{display:flex;gap:4px}
        .rk-fil button{border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);font-family:inherit;font-size:11px;font-weight:700;padding:4px 11px;border-radius:999px;cursor:pointer;text-transform:none;letter-spacing:0}
        .rk-fil button.on{background:var(--tx-0);color:#fff;border-color:var(--tx-0)}
        .rl{display:flex;flex-direction:column;gap:8px}
        .rl-row{display:grid;grid-template-columns:1fr 150px 130px;gap:14px;align-items:center;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:12px 15px 12px 14px;position:relative;overflow:hidden;cursor:pointer}
        .rl-row:hover{box-shadow:0 4px 14px rgba(0,0,0,.05)}
        .rl-sev{position:absolute;left:0;top:0;bottom:0;width:4px}.rl-sev.hot{background:var(--kirmizi)}.rl-sev.warm{background:var(--sari)}.rl-sev.ok{background:var(--yesil)}
        .rl-firm{font-size:14px;font-weight:700;color:var(--tx-0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .rl-meta{font-size:11.5px;color:var(--tx-2);margin-top:3px;display:flex;gap:9px;flex-wrap:wrap;align-items:center}.rl-rep{color:var(--tx-1);font-weight:600}
        .rl-lim{font-size:9.5px;font-weight:800;color:var(--kirmizi);background:var(--kirmizi-z);padding:1px 6px;border-radius:999px}
        .rl-visit .v{font-size:12.5px;font-weight:700;font-variant-numeric:tabular-nums}.rl-visit .v.cold{color:var(--kirmizi)}.rl-visit .v.warm{color:var(--sari)}.rl-visit .v.fresh{color:var(--yesil)}.rl-visit .k{font-size:10px;color:var(--tx-2)}
        .rl-amt{text-align:right}.rl-amt .v{font-size:19px;font-weight:800;color:var(--tx-0);font-variant-numeric:tabular-nums;line-height:1}.rl-amt .k{font-size:10px;color:var(--tx-2);margin-top:3px}
        .rr{display:flex;flex-direction:column;gap:9px}
        .rr-row{display:grid;grid-template-columns:1fr 170px 120px;gap:16px;align-items:center;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:13px 15px}
        .rr-nm{font-size:14px;font-weight:700;color:var(--tx-0)}.rr-sub{font-size:11.5px;color:var(--tx-2);margin-top:4px}.rr-sub b{color:var(--tx-1)}
        .rr-bar .bl{display:flex;justify-content:space-between;font-size:10px;color:var(--tx-2);font-weight:600;margin-bottom:3px}.rr-bar .bl b{color:var(--kirmizi);font-variant-numeric:tabular-nums}
        .rr-track{height:7px;border-radius:999px;background:var(--zemin-2);overflow:hidden}.rr-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#C43D28,#e5734f)}
        .rr-amt{text-align:right;font-size:17px;font-weight:800;color:var(--tx-0);font-variant-numeric:tabular-nums}
        .rk-lgnd{display:flex;gap:14px;font-size:11px;color:var(--tx-2);font-weight:600}.rk-lgnd i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:middle}
        .rk-empty{color:var(--tx-2);text-align:center;padding:22px;font-size:13px}
      </style>`;
      const INTRO = `<div class="rk-intro"><h3>🚨 Risk Radarı — ne işe yarar?</h3>
        <p>Vadesi geçmiş alacağı olan müşterileri <b>ziyaret güncelliğiyle</b> çaprazlar. Asıl tehlike: <b>parası gecikmiş ama kimsenin uğramadığı "soğuk" müşteriler</b>. Liste yukarıdan aşağı kapatılır — önce en çok gecikmiş + en uzun ihmal. (Yalnız ERP'ye bağlı müşteride gecikmiş görünür → eşleştirmeyi de teşvik eder.)</p>
        <div class="calc">
          <div><b>Gecikmiş</b> = <code>bi_musteri_risk.vadesi_gecmis</code> (FIFO; SAP alacak yaşlandırma). Eşleşme <code>musteri_kodu</code> ile.</div>
          <div><b>Son ziyaret</b> = en son tamamlanmış ziyaret (paylaşımlı havuz).</div>
          <div><b>🥶 Soğuk gecikmiş</b> = gecikmiş + 30+ gündür ya da hiç ziyaret edilmemiş — en acil kova.</div>
          <div><b>Öncelik</b> = önce soğuk, sonra tutara göre azalan. <b>Limit aşımı</b> = <code>limit_asimi &gt; 0</code>.</div>
        </div></div>`;
      const ms = d.musteriler || [];
      const rows = (arr) => arr.slice().sort((a, b) => { const sa = sev(a.gun) === "hot" ? 1 : 0, sb = sev(b.gun) === "hot" ? 1 : 0; if (sa !== sb) return sb - sa; return (b.overdue || 0) - (a.overdue || 0); })
        .map(m => { const sv = sev(m.gun), [vl, vc] = visLbl(m.gun), al = repAlan(m.saha_tip);
          return `<div class="rl-row" data-mid="${esc(m.id)}"><div class="rl-sev ${sv}"></div>
            <div style="min-width:0"><div class="rl-firm">${esc(m.firma)}</div><div class="rl-meta"><span class="rl-rep">${esc(m.rep || "—")}</span><span>· ${al ? ALAN[al].ad : "—"}</span>${m.limit ? `<span class="rl-lim">Limit aşımı</span>` : ""}</div></div>
            <div class="rl-visit"><span class="v ${vc}">${vl}</span><span class="k">son ziyaret</span></div>
            <div class="rl-amt"><div class="v">${kisa(m.overdue)}</div><div class="k">gecikmiş</div></div></div>`; }).join("");
      const tiles = (arr, etiket) => { const tp = arr.reduce((s, m) => s + (m.overdue || 0), 0), sg = arr.filter(m => m.gun === null || m.gun > 30).reduce((s, m) => s + (m.overdue || 0), 0), lm = arr.filter(m => m.limit).length;
        return `<div class="rk-grid">
          <div class="rk-hero al"><div class="l">Toplam gecikmiş · ${etiket}</div><div class="n">${kisa(tp)}</div></div>
          <div class="rk-tile"><div class="n" style="color:var(--kirmizi)">${kisa(sg)}</div><div class="l">🥶 Soğuk gecikmiş (ziyaretsiz / +30g)</div></div>
          <div class="rk-tile"><div class="n">${arr.length}</div><div class="l">Riskli müşteri</div></div>
          <div class="rk-tile"><div class="n">${lm}</div><div class="l">Limit aşan</div></div></div>`; };
      const lgnd = `<span class="rk-lgnd"><span><i style="background:#C43D28"></i>Soğuk</span><span><i style="background:#8A5D06"></i>İzle</span><span><i style="background:#106B4A"></i>Taze</span></span>`;

      const bindRows = () => box.querySelectorAll(".rl-row[data-mid]").forEach(rw => rw.addEventListener("click", async () => {
        const id = rw.dataset.mid; let c = (S.musteriler || []).find(x => x.id === id);
        if (!c) { try { const res = await api(`/api/saha/musteriler/${id}`); c = res.musteri || res; } catch (e) {} }
        if (c) musteriDetay(c);
      }));
      if (d.rol === "rep") {
        box.innerHTML = CSS + `<div class="rk">${INTRO}${tiles(ms, "portföyün")}
          <div class="rk-sec"><span>🚨 Kritik müşterilerin · gecikmiş × ihmal</span>${lgnd}</div>
          ${ms.length ? `<div class="rl">${rows(ms)}</div>` : `<div class="rk-empty">Gecikmiş alacaklı müşterin yok. 👍</div>`}</div>`;
        bindRows();
      } else {
        const render = (field) => {
          const F = ms.filter(m => !field || repAlan(m.saha_tip) === field);
          const RR = {}; F.forEach(m => { const r = RR[m.rep_id] || (RR[m.rep_id] = { rep: m.rep, alan: repAlan(m.saha_tip), overdue: 0, cold: 0, n: 0 }); r.overdue += m.overdue || 0; r.n++; if (m.gun === null || m.gun > 30) r.cold += m.overdue || 0; });
          const rrArr = Object.values(RR).sort((a, b) => b.cold - a.cold); const maxCold = Math.max(...rrArr.map(r => r.cold), 1);
          const rrRows = rrArr.map(r => `<div class="rr-row"><div><div class="rr-nm">${esc(r.rep || "—")} <span style="font-size:10px;font-weight:700;color:var(--tx-2)">· ${r.alan ? ALAN[r.alan].ad : "—"}</span></div><div class="rr-sub"><b>${r.n}</b> riskli müşteri</div></div>
            <div class="rr-bar"><div class="bl"><span>Soğuk (ziyaretsiz) gecikmiş</span><b>${kisa(r.cold)}</b></div><div class="rr-track"><div class="rr-fill" style="width:${Math.max(3, Math.round(r.cold / maxCold * 100))}%"></div></div></div>
            <div class="rr-amt">${kisa(r.overdue)}<div style="font-size:10px;color:var(--tx-2);font-weight:600;margin-top:3px">toplam gecikmiş</div></div></div>`).join("") || `<div class="rk-empty">Bu sahada riskli müşteri yok.</div>`;
          const fb = (f, l) => `<button data-f="${f}" class="${field === f ? "on" : ""}">${l}</button>`;
          box.innerHTML = CSS + `<div class="rk">${INTRO}${tiles(F, field ? ALAN[field].ad + " saha" : "portföy")}
            <div class="rk-sec"><span>🚨 Kritik müşteriler · gecikmiş × ihmal</span><div class="rk-fil" id="rk-fil">${fb("", "Tümü")}${fb("TICARI", "Ticari")}${fb("TUKETICI", "Tüketici")}</div></div>
            <div style="margin:-4px 2px 8px">${lgnd}</div>
            ${F.length ? `<div class="rl">${rows(F)}</div>` : `<div class="rk-empty">Bu sahada gecikmiş alacaklı müşteri yok.</div>`}
            <div class="rk-sec"><span>Temsilci bazında risk · soğuk paraya göre</span></div>
            <div class="rr">${rrRows}</div></div>`;
          const fil = box.querySelector("#rk-fil"); if (fil) fil.querySelectorAll("button").forEach(b => b.addEventListener("click", () => render(b.dataset.f)));
          bindRows();
        };
        render("");
      }
    } catch (e) { const box = icerik(); if (box) box.innerHTML = hataH(e); }
  }
  async function rpCiro() {  /* CIRO_UI6_DK_V1 */
    const el = icerik(); if (!el) return; el.innerHTML = load();
    try {
      const d = await api(`/api/saha/rapor/ziyaret-ciro?from=${rpFrom()}&to=${rpTo()}${tipQS()}`);
      const el2 = icerik(); if (!el2) return;
      const kisa = (n) => { n = Number(n) || 0; if (n >= 1e6) return "₺" + (Math.round(n / 1e5) / 10) + "M"; if (n >= 1e3) return "₺" + Math.round(n / 1e3) + "K"; return "₺" + Math.round(n); };
      const CSS = `<style>
        .zc{--zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;--cizgi:rgba(0,0,0,.09);--cizgi-g:rgba(0,0,0,.18);--tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;--kirmizi:#C43D28;--kirmizi-z:#FDF0ED;--sari:#8A5D06;--sari-z:#FEF6E7;--yesil:#106B4A;--yesil-z:#EAF7F1;--mavi:#2563eb;color-scheme:light;color:var(--tx-0);font-family:var(--sans,-apple-system,'Segoe UI',system-ui,sans-serif)}
        .zc *{box-sizing:border-box}
        .zc-hero{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:16px;padding:18px}
        .zc-hero .l{font-size:12px;font-weight:600;color:var(--tx-1)}
        .zc-hero .n{font-size:38px;font-weight:800;letter-spacing:-.02em;color:var(--tx-0);margin-top:2px;font-variant-numeric:tabular-nums}
        .zc-hero .n small{font-size:14px;color:var(--tx-2);font-weight:600}
        .zc-grid{display:grid;gap:10px;margin-top:12px;grid-template-columns:repeat(5,1fr)}
        .zc-tile{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:13px;padding:12px 13px}
        .zc-tile .n{font-size:22px;font-weight:800;color:var(--tx-0);line-height:1;font-variant-numeric:tabular-nums}
        .zc-tile .l{font-size:11px;color:var(--tx-1);margin-top:6px;font-weight:500}
        .zc-match{background:var(--sari-z);border:1px solid rgba(138,93,6,.25);border-radius:13px;padding:13px 15px;margin-top:12px}
        .zc-match .t{font-size:14px;font-weight:800;color:var(--sari)}
        .zc-match .s{font-size:12.5px;color:var(--sari);margin-top:4px;line-height:1.5}
        .zc-sec{font-size:11px;font-weight:800;color:var(--tx-1);text-transform:uppercase;letter-spacing:.06em;margin:18px 2px 10px;display:flex;justify-content:space-between;align-items:center}
        .zc-fil{display:flex;gap:4px}
        .zc-fil button{border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);font-family:inherit;font-size:11px;font-weight:700;padding:4px 11px;border-radius:999px;cursor:pointer;letter-spacing:0;text-transform:none}
        .zc-fil button:hover{border-color:var(--tx-3)}
        .zc-fil button.on{background:var(--tx-0);color:#fff;border-color:var(--tx-0)}
        .zc-card{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;overflow:hidden}
        table.zc-t{width:100%;border-collapse:collapse;font-size:13px}
        table.zc-t th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--tx-2);font-weight:700;padding:9px 12px;border-bottom:1px solid var(--cizgi)}
        table.zc-t td{padding:9px 12px;border-bottom:1px solid var(--cizgi);color:var(--tx-0)}
        table.zc-t tr:last-child td{border-bottom:0}
        table.zc-t td.num,table.zc-t th.num{text-align:right;font-variant-numeric:tabular-nums}
        table.zc-t tr.tik{cursor:pointer}table.zc-t tr.tik:hover td{background:var(--zemin-2)}
        .zc-go{color:var(--mavi);font-weight:700}
        .zc-daha{width:100%;border:0;background:var(--zemin-2);color:var(--tx-1);font-family:inherit;font-size:12px;font-weight:700;padding:11px;cursor:pointer}
        .zc-empty{color:var(--tx-2);text-align:center;padding:22px;font-size:13px}
        .zc-intro{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:15px 17px;margin-bottom:14px}/*CIRO_INTRO_DK_V1*/.zc-intro h3{margin:0 0 6px;font-size:14px;font-weight:800;color:var(--tx-0)}.zc-intro p{margin:0;font-size:12.5px;line-height:1.6;color:var(--tx-1)}.zc-intro .calc{display:flex;flex-direction:column;gap:5px;margin-top:9px;padding-top:10px;border-top:1px solid var(--cizgi)}.zc-intro .calc div{font-size:12px;color:var(--tx-1);line-height:1.5}.zc-intro .calc b{color:var(--tx-0)}.zc-intro code{background:var(--zemin-2);padding:1px 6px;border-radius:5px;font-size:11px}
        .zc-split{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .zc-fcard{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:15px 16px;position:relative;overflow:hidden}
        .zc-fcard:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--fc)}
        .zc-fhead{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:800;color:var(--tx-0);margin-bottom:13px}
        .zc-fdot{width:10px;height:10px;border-radius:3px;background:var(--fc)}
        .zc-fhead .c{margin-left:auto;font-size:11px;font-weight:700;color:var(--tx-2)}
        .zc-fmini{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
        .zc-fmini .n{font-size:19px;font-weight:800;color:var(--tx-0);line-height:1;font-variant-numeric:tabular-nums}
        .zc-fmini .l{font-size:10px;color:var(--tx-1);margin-top:5px;font-weight:500}
        .lb{display:flex;flex-direction:column;gap:10px}
        .lb-row{display:grid;grid-template-columns:34px 1fr 150px;gap:16px;align-items:center;background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:14px;padding:14px 16px;transition:box-shadow .15s,transform .15s}
        .lb-row:hover{box-shadow:0 4px 16px rgba(0,0,0,.06);transform:translateY(-1px)}
        .lb-rank{font-size:15px;font-weight:800;color:var(--tx-3);text-align:center;font-variant-numeric:tabular-nums}
        .lb-row.top1 .lb-rank{color:#B8860B}.lb-row.top2 .lb-rank{color:#8a8a95}.lb-row.top3 .lb-rank{color:#a9744f}
        .lb-row.top1{border-color:rgba(184,134,11,.35);box-shadow:0 1px 0 rgba(184,134,11,.12)}
        .lb-main{min-width:0}
        .lb-name{font-size:15px;font-weight:700;color:var(--tx-0);letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
        .lb-seg{font-size:10px;font-weight:800;padding:1px 7px;border-radius:999px}
        .lb-sub{display:flex;gap:14px;flex-wrap:wrap;margin-top:7px;font-size:12px;color:var(--tx-1);align-items:center}
        .lb-sub b{color:var(--tx-0);font-weight:700;font-variant-numeric:tabular-nums}
        .lb-cmp{font-size:11px;font-weight:800;padding:1px 6px;border-radius:999px;margin-left:5px;font-variant-numeric:tabular-nums}
        .lb-cmp.up{color:var(--yesil);background:var(--yesil-z)}
        .lb-cmp.down{color:var(--kirmizi);background:var(--kirmizi-z)}
        .lb-bars{margin-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px 18px}
        .lb-bar .bl{display:flex;justify-content:space-between;font-size:10.5px;color:var(--tx-2);font-weight:600;margin-bottom:3px}
        .lb-bar .bl b{color:var(--tx-1);font-variant-numeric:tabular-nums}
        .lb-track{height:6px;border-radius:999px;background:var(--zemin-2);overflow:hidden}
        .lb-fill{height:100%;border-radius:999px}
        .lb-fill.ciro{background:linear-gradient(90deg,#2563eb,#3b82f6)}
        .lb-fill.kaps{background:linear-gradient(90deg,#106B4A,#12b981)}
        .lb-fill.kaps.dus{background:linear-gradient(90deg,#C43D28,#e5734f)}
        .lb-amt{text-align:right}
        .lb-amt .v{font-size:23px;font-weight:800;color:var(--tx-0);letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1}
        .lb-amt .k{font-size:11px;color:var(--tx-2);margin-top:4px;font-variant-numeric:tabular-nums}
        .lb-lock{margin-top:9px;display:inline-flex;align-items:center;gap:6px;background:var(--sari-z);border:1px solid rgba(138,93,6,.22);color:var(--sari);font-size:11.5px;font-weight:700;padding:5px 9px;border-radius:999px;cursor:default}
      </style>`;
      const repAlan = (r) => {
        const a = String(r.saha_tip || "").toUpperCase();
        if (a === "TUKETICI") return "TUKETICI";
        if (a === "TICARI") return "TICARI";
        const tk = Number(r.tuketici_z) || 0, tc = Number(r.ticari_z) || 0;
        if (!tk && !tc) return null;
        return tk >= tc ? "TUKETICI" : "TICARI";
      };
      const ALAN = { TICARI: { ad: "Ticari", c: "#f59e0b" }, TUKETICI: { ad: "Tüketici", c: "#0ea5e9" } };
      if (d.rol === "rep") {
        const o = d.ozet || {}, ms = d.musteriler || [];
        const cirolu = ms.filter(m => m.musteri_kodu);
        const esl = ms.filter(m => !m.musteri_kodu).sort((a, b) => (b.ziyaret || 0) - (a.ziyaret || 0));
        const tbl = (arr, tik) => `<table class="zc-t"><tbody>${arr.map((m, i) => `<tr class="${tik ? "tik" : ""}" ${tik ? `data-mid="${esc(m.id)}"` : ""} ${i >= 12 ? `data-extra="1" style="display:none"` : ""}><td>${esc(m.firma)}</td><td class="num" style="color:var(--tx-2)">${m.ziyaret} ziyaret</td><td class="num">${tik ? `<span class="zc-go">eşleştir ›</span>` : kisa(m.ciro)}</td></tr>`).join("")}</tbody></table>`;
        const sec = (b, sag, arr, tik, k) => arr.length ? `<div class="zc-sec"><span>${b}</span><span style="color:var(--tx-2)">${sag}</span></div><div class="zc-card" id="zc-${k}">${tbl(arr, tik)}${arr.length > 12 ? `<button class="zc-daha" data-k="${k}">+ ${arr.length - 12} tane daha</button>` : ""}</div>` : "";
        el2.innerHTML = CSS + `<!--CIRO_UI6_DK_V1--><div class="zc">
          <div style="display:grid;grid-template-columns:1fr 2fr;gap:14px">
            <div class="zc-hero"><div class="l">Ziyaret başına ciro · dönem</div><div class="n">${kisa(o.ciro_ziyaret)}<small>/ziyaret</small></div></div>
            <div class="zc-grid" style="grid-template-columns:repeat(2,1fr);margin-top:0">
              <div class="zc-tile"><div class="n">${o.ziyaret || 0}</div><div class="l">Ziyaret</div></div>
              <div class="zc-tile"><div class="n">${o.benzersiz || 0}</div><div class="l">Ulaşılan</div></div>
              <div class="zc-tile"><div class="n">${kisa(o.ciro)}</div><div class="l">Toplam ERP ciro</div></div>
              <div class="zc-tile"><div class="n">${o.eslesen || 0}<span style="font-size:12px;color:var(--tx-3)"> / ${o.benzersiz || 0}</span></div><div class="l">ERP'ye bağlı</div></div>
            </div>
          </div>
          ${o.eslesmemis > 0 ? `<div class="zc-match"><div class="t">🔗 ${o.eslesmemis} müşterin ERP'ye bağlı değil</div><div class="s">Aşağıda müşteriye <b>tıkla → eşleştir</b>. Bağladıkça gerçek ciron görünür.</div></div>` : ""}
          ${sec("💰 Cirolu müşteriler", cirolu.length + "", cirolu, false, "cir")}
          ${sec("🔗 Eşleştir — tıkla", esl.length + " müşteri", esl, true, "esl")}
          ${!ms.length ? `<div class="zc-empty">Bu dönemde ziyaret yok.</div>` : ""}
        </div>`;
      } else {
        const R = (d.repler || []).slice().sort((a, b) => (Number(b.ciro) || 0) - (Number(a.ciro) || 0));
        const toplamCiro = R.reduce((s, r) => s + (Number(r.ciro) || 0), 0);
        const toplamZiy = R.reduce((s, r) => s + (Number(r.ziyaret) || 0), 0);
        const maxCiro = R.reduce((m, r) => Math.max(m, Number(r.ciro) || 0), 0) || 1;
        const toplamEsl = R.reduce((s, r) => s + (Number(r.eslesen) || 0), 0);
        const toplamBenz = R.reduce((s, r) => s + (Number(r.benzersiz) || 0), 0);
        const ortKapsam = toplamBenz ? Math.round(toplamEsl / toplamBenz * 100) : null;
        const ekipCiroZiy = toplamZiy ? toplamCiro / toplamZiy : 0;
        const acikRep = R.filter(r => (r.eslesen != null && r.benzersiz != null && r.eslesen < r.benzersiz)).length;
        const G = { TICARI: { ciro: 0, ziy: 0, esl: 0, benz: 0, n: 0 }, TUKETICI: { ciro: 0, ziy: 0, esl: 0, benz: 0, n: 0 } };
        R.forEach(r => { const f = repAlan(r); if (!f || !G[f]) return; const g = G[f]; g.ciro += Number(r.ciro) || 0; g.ziy += Number(r.ziyaret) || 0; g.esl += Number(r.eslesen) || 0; g.benz += Number(r.benzersiz) || 0; g.n++; });
        const fBench = (f) => (f && G[f] && G[f].ziy) ? G[f].ciro / G[f].ziy : 0;
        const splitHtml = ["TICARI", "TUKETICI"].map(k => {
          const g = G[k], meta = ALAN[k];
          const cz = g.ziy ? g.ciro / g.ziy : 0, kp = g.benz ? Math.round(g.esl / g.benz * 100) : null;
          return `<div class="zc-fcard" style="--fc:${meta.c}">
            <div class="zc-fhead"><span class="zc-fdot"></span>${meta.ad} saha<span class="c">${g.n} temsilci</span></div>
            <div class="zc-fmini">
              <div><div class="n">${kisa(g.ciro)}</div><div class="l">Etki ciro</div></div>
              <div><div class="n">${kisa(cz)}</div><div class="l">₺ / ziyaret</div></div>
              <div><div class="n">${kp != null ? "%" + kp : "—"}</div><div class="l">ERP kapsamı</div></div>
              <div><div class="n">${g.n}</div><div class="l">Temsilci</div></div>
            </div></div>`;
        }).join("");
        const rows = R.map((r, i) => {
          const ciro = Number(r.ciro) || 0;
          const pay = Math.max(2, Math.round(ciro / maxCiro * 100));
          const kaps = (r.benzersiz && Number(r.benzersiz) > 0) ? Math.round((Number(r.eslesen) || 0) / Number(r.benzersiz) * 100) : null;
          const acik = (r.eslesen != null && r.benzersiz != null) ? (r.benzersiz - r.eslesen) : 0;
          const f = repAlan(r), meta = f ? ALAN[f] : null;
          const seg = meta ? `<span class="lb-seg" style="color:${meta.c};background:${meta.c}1f">${meta.ad}</span>` : "";
          const rz = Number(r.ciro_ziyaret) || 0, bench = fBench(f);
          let cmp = "";
          if (bench > 0 && rz > 0) { const dp = Math.round((rz - bench) / bench * 100); cmp = `<span class="lb-cmp ${dp >= 0 ? "up" : "down"}" title="${meta ? meta.ad : "Saha"} ort. ${kisa(bench)}/ziyaret">${dp >= 0 ? "▲" : "▼"} %${Math.abs(dp)}</span>`; }
          return `<div class="lb-row" data-field="${f || ""}">
            <div class="lb-rank">${i + 1}</div>
            <div class="lb-main">
              <div class="lb-name">${esc(r.rep)}${seg}</div>
              <div class="lb-sub"><span>Ziyaret <b>${r.ziyaret || 0}</b></span><span>Ulaşılan <b>${r.benzersiz || 0}</b></span><span>Dönüşüm <b>${r.donusum != null ? "%" + r.donusum : "—"}</b></span><span>₺/ziyaret <b>${kisa(r.ciro_ziyaret)}</b>${cmp}</span></div>
              <div class="lb-bars">
                <div class="lb-bar"><div class="bl"><span>Ciro payı</span><b>${toplamCiro ? Math.round(ciro / toplamCiro * 100) : 0}%</b></div><div class="lb-track"><div class="lb-fill ciro" style="width:${pay}%"></div></div></div>
                <div class="lb-bar"><div class="bl"><span>ERP kapsamı</span><b>${kaps != null ? "%" + kaps : "—"}</b></div><div class="lb-track"><div class="lb-fill kaps${kaps != null && kaps < 60 ? " dus" : ""}" style="width:${kaps != null ? Math.max(2, kaps) : 0}%"></div></div></div>
              </div>
              ${acik > 0 ? `<div class="lb-lock">🔒 ${acik} müşteri ERP'ye bağlanınca gerçek ciro açılır</div>` : ""}
            </div>
            <div class="lb-amt"><div class="v">${kisa(ciro)}</div><div class="k">etki ciro</div></div>
          </div>`;
        }).join("");
        el2.innerHTML = CSS + `<!--CIRO_UI6_DK_V1--><div class="zc"><div class="zc-intro"><h3>💰 Ciro — ne işe yarar?</h3><p>Saha eforunu (ziyaret) ERP sonucuyla (ciro) bağlar: her temsilcinin <b>ziyaret başına getirdiği gerçek ciroyu</b> ve ekipteki payını gösterir. Amaç eforu sonuca çevirmek ve ERP'ye bağlı olmayan müşterileri görünür kılıp eşleştirmeye itmektir.</p><div class="calc"><div><b>Etki ciro</b> = ziyaret edilen müşterilerin <code>musteri_kodu</code> → <code>bi_satis_faturalari</code> (dönem cirosu).</div><div><b>₺ / ziyaret</b> = etki ciro ÷ ziyaret. <b>ERP kapsamı</b> = eşleşen ÷ ulaşılan (ziyaret edilenin ERP'ye bağlı oranı).</div><div><b>Saha kırılımı & ▲/▼</b> = temsilci alanı (Ticari/Tüketici, Yönetim etiketi); ₺/ziyaret kendi sahasının ortalamasıyla kıyaslanır.</div></div></div>
          <div class="zc-grid" style="grid-template-columns:repeat(4,1fr)">
            <div class="zc-hero" style="grid-column:span 1"><div class="l">Toplam etki ciro · dönem</div><div class="n">${kisa((d && d.toplam_etki_ciro != null) ? d.toplam_etki_ciro : toplamCiro)}</div></div>
            <div class="zc-tile"><div class="n">${kisa(ekipCiroZiy)}</div><div class="l">Ekip ₺ / ziyaret</div></div>
            <div class="zc-tile"><div class="n">${ortKapsam != null ? "%" + ortKapsam : "—"}</div><div class="l">Ortalama ERP kapsamı</div></div>
            <div class="zc-tile"><div class="n">${R.length}</div><div class="l">Temsilci</div></div>
          </div>
          <div class="zc-sec"><span>Saha kırılımı · ticari / tüketici</span></div>
          <div class="zc-split">${splitHtml}</div>
          <div class="zc-sec"><span>Ekip sıralaması · ciro etkisine göre <span id="zc-say" style="color:var(--tx-2);font-weight:700">· ${R.length} temsilci</span></span>
            <div class="zc-fil" id="zc-fil"><button data-f="" class="on">Tümü</button><button data-f="TICARI">Ticari</button><button data-f="TUKETICI">Tüketici</button></div>
          </div>
          ${R.length ? `<div class="lb">${rows}</div>` : `<div class="zc-empty">Bu dönemde ziyaret yok.</div>`}
          ${acikRep > 0 ? `<div class="zc-match" style="margin-top:14px"><div class="t">🔒 ${acikRep} temsilcide kilitli ciro var</div><div class="s">Bazı ziyaret edilen müşteriler ERP'ye bağlı değil — o cironun tamamı burada görünmüyor. Eşleştirme tamamlandıkça sıralama ve gerçek rakamlar netleşir.</div></div>` : ""}
        </div>`;
        // rep-alanı seçicisi: filtrele + filtrelenen küme içinde yeniden sırala
        const fil = el2.querySelector("#zc-fil"), say = el2.querySelector("#zc-say");
        if (fil) fil.querySelectorAll("button").forEach(b => b.addEventListener("click", () => {
          const f = b.dataset.f;
          fil.querySelectorAll("button").forEach(x => x.classList.toggle("on", x === b));
          let rank = 0;
          el2.querySelectorAll(".lb-row").forEach(row => {
            const show = !f || row.dataset.field === f;
            row.style.display = show ? "" : "none";
            row.classList.remove("top1", "top2", "top3");
            if (show) { rank++; const rk = row.querySelector(".lb-rank"); if (rk) rk.textContent = rank; if (rank <= 3) row.classList.add("top" + rank); }
          });
          if (say) say.textContent = "· " + rank + " temsilci";
        }));
      }
      el2.querySelectorAll(".zc-daha").forEach(b => b.addEventListener("click", () => {
        const card = document.getElementById("zc-" + b.dataset.k); if (!card) return;
        card.querySelectorAll("[data-extra]").forEach(x => x.style.display = "table-row"); b.style.display = "none";
      }));
      el2.querySelectorAll("tr.tik[data-mid]").forEach(r => r.addEventListener("click", async () => {
        const id = r.dataset.mid;
        let c = (S.musteriler || []).find(x => x.id === id);
        if (!c) { try { const res = await api(`/api/saha/musteriler/${id}`); c = res.musteri || res; } catch (e) {} }
        if (c) musteriDetay(c);
      }));
    } catch (e) { const el2 = icerik(); if (el2) el2.innerHTML = hataH(e); }
  }
  async function rpTemsilciler() {
    const el = icerik(); if (!el) return; el.innerHTML = load();
    const { repler = [] } = await api(`/api/saha/rapor/rep-performans?from=${rpFrom()}&to=${rpTo()}`);
    const el2 = icerik(); if (!el2) return;
    if (!repler.length) { el2.innerHTML = `<div class="dk-empty-s">Bu dönemde ziyaret kaydı yok.</div>`; return; }
    const maxZ = Math.max(...repler.map(r => Number(r.ziyaret) || 0), 1);
    el2.innerHTML = `
      ${sech("Temsilci Performansı", "var(--mavi)", "Her temsilcinin dönem içindeki ziyaret adedi, benzersiz müşteri sayısı, oluşturduğu teklif adedi ve kazanma oranı.")}
      <div class="dk-card" style="padding:0;overflow:hidden">
        <div style="overflow-x:auto"><table class="dk-t">
          <thead><tr><th>Temsilci</th><th>Segment</th><th>Ziyaret</th><th class="num">Müşteri</th><th class="num">Teklif</th><th class="num">Win %</th></tr></thead>
          <tbody>${repler.map(r => {
      const z = Number(r.ziyaret) || 0, pct = Math.round(100 * z / maxZ);
      const tek = Number(r.teklif || 0), kaz = Number(r.kazanilan || 0);
      const wr = tek > 0 ? Math.round(100 * kaz / tek) : null;
      const wrCol = wr != null ? (wr >= 50 ? "var(--yesil-p)" : "var(--sari-p)") : "var(--tx-2)";
      return `<tr>
              <td class="firm">${esc(r.rep)}</td>
              <td>${_rpSegDk(r)}</td>
              <td><div class="dk-barrow"><div class="dk-bar"><i style="width:${pct}%;background:var(--mavi)"></i></div><span class="num" style="font-weight:700;color:var(--mavi-koyu)">${z}</span></div></td>
              <td class="num">${r.benzersiz_musteri || 0}</td>
              <td class="num">${tek > 0 ? tek : "—"}</td>
              <td class="num" style="color:${wrCol};font-weight:700">${wr != null ? "%" + wr : "—"}</td>
            </tr>`;
    }).join("")}</tbody>
        </table></div>
      </div>`;
  }

  // ── Pipeline ────────────────────────────────────────────────────────────────
  async function rpPipeline() {
    const el = icerik(); if (!el) return; el.innerHTML = load();
    const teklif = await api(`/api/saha/rapor/teklif?from=${rpFrom()}&to=${rpTo()}${tipQS()}`);
    const el2 = icerik(); if (!el2) return;
    const t = teklif.ozet || {};
    const sonuclanan = Number(t.kazanilan || 0) + Number(t.kaybedilen || 0);
    const winRate = sonuclanan ? Math.round(1000 * t.kazanilan / sonuclanan) / 10 : null;
    const kazTutar = Number(t.kazanilan_tutar || 0), kayTutar = Number(t.kaybedilen_tutar || 0);
    const wrCol = winRate != null && winRate >= 50 ? "var(--yesil-p)" : "var(--sari-p)";
    const tekFetch = async durum => (await api(`/api/saha/teklifler?from=${rpFrom()}&to=${rpTo()}${tipQS()}${durum ? "&durum=" + durum : ""}`)).teklifler || [];

    el2.innerHTML = `
      ${sech("Teklif Performansı", "var(--mavi)", "Dönemdeki tekliflerin huni görünümü; toplam, kazanılan, kaybedilen adet, açık teklif ve kazanma oranı.")}
      <div class="dk-kpis">
        <div class="dk-stat"><div class="k">Toplam</div><div class="v num">${t.toplam || 0}</div></div>
        <div class="dk-stat tik" id="rp-pp-kaz" title="Kazanılan teklifleri listele"><div class="k">Kazanılan</div><div class="v num" style="color:var(--yesil-p)">${t.kazanilan || 0}</div></div>
        <div class="dk-stat tik" id="rp-pp-kayb" title="Kaybedilen teklifleri listele"><div class="k">Kaybedilen</div><div class="v num" style="color:var(--kirmizi-p)">${t.kaybedilen || 0}</div></div>
        <div class="dk-stat"><div class="k">Açık</div><div class="v num">${t.bekleyen || 0}</div></div>
        <div class="dk-stat"><div class="k">Win Rate</div><div class="v num" style="color:${wrCol}">${winRate != null ? "%" + winRate : "—"}</div></div>
      </div>
      ${(kazTutar || kayTutar) ? `<div class="dk-ciro-2">
        ${kazTutar ? `<div class="dk-ciro-cell ok" id="rp-pp-kaz2"><span>Kazanılan Ciro</span><b>${money(kazTutar)}</b></div>` : ""}
        ${kayTutar ? `<div class="dk-ciro-cell bad" id="rp-pp-kayb2"><span>Kaybedilen Ciro</span><b>${money(kayTutar)}</b></div>` : ""}
      </div>` : ""}

      ${teklif.marka_bazli?.length ? `
      ${sech("Marka Bazlı Win Rate", "#6d4bd6", "Marka bazında kazanılan teklif oranı. Düşük oran, o markada rekabet zorluğuna işaret eder.")}
      <div class="dk-card" style="padding:0;overflow:hidden"><div style="overflow-x:auto"><table class="dk-t">
        <thead><tr><th>Marka</th><th class="num">Teklif</th><th class="num">Kazanç</th><th class="num">Kayıp</th><th class="num">Win %</th></tr></thead>
        <tbody>${teklif.marka_bazli.map(r => {
      const wr = r.win_rate != null ? Number(r.win_rate) : null;
      const c = wr != null ? (wr >= 50 ? "var(--yesil-p)" : "var(--sari-p)") : "var(--tx-2)";
      return `<tr><td class="firm">${esc(r.marka)}</td><td class="num">${r.teklif}</td><td class="num">${r.kazanilan}</td><td class="num">${r.kaybedilen}</td><td class="num" style="color:${c};font-weight:700">${wr != null ? "%" + wr : "—"}</td></tr>`;
    }).join("")}</tbody>
      </table></div></div>` : ""}

      ${teklif.rakip_kayiplari?.length ? `
      ${sech("Kime Kaybediyoruz?", "var(--kirmizi-p)", "Kaybedilen tekliflerde müşterilerin tercih ettiği rakip markalar ve bu kayıpların ciro etkisi.")}
      <div class="dk-card" style="padding:0;overflow:hidden"><div style="overflow-x:auto"><table class="dk-t">
        <thead><tr><th>Rakip</th><th>Model</th><th class="num">Kayıp</th><th class="num">Tutar</th><th class="num">Ort. Fiyat</th></tr></thead>
        <tbody>${teklif.rakip_kayiplari.map(r => `<tr><td class="firm">${esc(r.rakip_marka)}</td><td class="sub2">${esc(r.rakip_model) || "—"}</td><td class="num">${r.kayip}</td><td class="num">${money(r.kayip_tutar)}</td><td class="num">${r.ort_rakip_fiyat ? money(r.ort_rakip_fiyat) : "—"}</td></tr>`).join("")}</tbody>
      </table></div></div>` : ""}

      ${teklif.kayip_nedenleri?.length ? `
      ${sech("Kayıp Nedenleri", "var(--sari-p)", "Kaybedilen tekliflerde kaydedilen başlıca nedenler. Tekrarlayan nedenler yapısal soruna işaret eder.")}
      <div class="dk-neden">${teklif.kayip_nedenleri.map(n => `<span class="dk-neden-p"><b>${esc(KAYIP_NEDEN[n.neden] || n.neden)}</b> · ${n.adet}</span>`).join("")}</div>` : ""}`;

    const bindK = (id, baslik, durum) => el2.querySelector("#" + id)?.addEventListener("click", async () => {
      dkModal(load()); try { rpTekModal(baslik, await tekFetch(durum)); } catch { dkKapat(); }
    });
    bindK("rp-pp-kaz", "Kazanılan Teklifler", "KAZANILDI");
    bindK("rp-pp-kaz2", "Kazanılan Teklifler", "KAZANILDI");
    bindK("rp-pp-kayb", "Kaybedilen Teklifler", "KAYBEDILDI");
    bindK("rp-pp-kayb2", "Kaybedilen Teklifler", "KAYBEDILDI");
  }

  // ── Pazar ───────────────────────────────────────────────────────────────────
  async function rpPazar() {
    const el = icerik(); if (!el) return; el.innerHTML = load();
    const [rakip, bolge] = await Promise.all([
      api(`/api/saha/rapor/rakip?from=${rpFrom()}&to=${rpTo()}`),
      api(`/api/saha/rapor/bolge-marka?from=${rpFrom()}&to=${rpTo()}`)
    ]);
    const el2 = icerik(); if (!el2) return;
    const rakipler = rakip.rakipler || [];
    const bolgeler = {};
    for (const s of (bolge.satirlar || [])) (bolgeler[s.bolge] = bolgeler[s.bolge] || []).push(s);
    const maxG = Math.max(...rakipler.map(r => Number(r.gorulme) || 0), 1);
    el2.innerHTML = `
      ${rakipler.length ? `
      ${sech("Rakip Görülme Analizi", "var(--mavi)", "Ziyaret sırasında müşteri rafında görülen rakip markaların kaç ziyarette kayda geçtiği. Oran, toplam tamamlanan ziyarete göredir.")}
      <div class="dk-card" style="padding:0;overflow:hidden"><div style="overflow-x:auto"><table class="dk-t">
        <thead><tr><th>Rakip</th><th>Görülme</th><th class="num">Oran</th></tr></thead>
        <tbody>${rakipler.map(r => {
      const g = Number(r.gorulme) || 0, pct = Math.round(100 * g / maxG), oran = Number(r.oran);
      const flag = oran >= 20 ? " 🔴" : oran >= 10 ? " 🟡" : "";
      return `<tr><td class="firm">${esc(r.rakip)}</td><td><div class="dk-barrow"><div class="dk-bar"><i style="width:${pct}%;background:var(--kirmizi-p)"></i></div><span class="num" style="font-weight:700">${g}</span></div></td><td class="num">%${r.oran}${flag}</td></tr>`;
    }).join("")}</tbody>
      </table></div></div>` : `<div class="dk-empty-s">Bu dönemde rakip kaydı yok.</div>`}

      ${Object.keys(bolgeler).length ? `
      ${sech("Bölge × Marka", "var(--mavi)", "Ziyaret sırasında müşteri rafında görülen markaların ile göre dağılımı. Temsilci ziyaret notlarından derlenir.")}
      <div class="dk-grid" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
        ${Object.entries(bolgeler).map(([b, satirlar]) => `
        <div class="dk-card">
          <div class="dk-card-h" style="margin-bottom:8px"><h3>${esc(b)}</h3></div>
          <div class="dk-taglar">${satirlar.slice(0, 12).map(s => `<span class="dk-tag">${esc(s.marka)} · <b>${s.gorulme}</b></span>`).join("")}</div>
        </div>`).join("")}
      </div>` : ""}`;
  }

  // ── modallar (sayfalı) ──────────────────────────────────────────────────────
  function rpZiyModal(baslik, rows) {
    const TUR = { TUKETICI: "Tüketici", TICARI: "Ticari" };
    const PG = 25; let pg = 0; const total = Math.ceil(rows.length / PG) || 1;
    const render = () => {
      const el = S.container.querySelector("#rp-zl"); if (!el) return;
      const slice = rows.slice(pg * PG, (pg + 1) * PG);
      el.innerHTML = !rows.length ? `<div class="dk-empty-s">Kayıt yok.</div>`
        : `<div style="max-height:52vh;overflow:auto"><table class="dk-t">
            <thead><tr><th>Firma</th><th>İl</th><th>Tip</th>${isMgr ? "<th>Temsilci</th>" : ""}<th>Tarih</th></tr></thead>
            <tbody>${slice.map(z => `<tr><td class="firm">${esc(z.firma || "—")}</td><td class="sub2">${esc(z.il || "—")}</td><td class="sub2">${TUR[z.tip] || z.tip || "—"}</td>${isMgr ? `<td class="sub2">${esc(z.rep_full_name || z.rep_adi || "—")}</td>` : ""}<td class="sub2">${z.ziyaret_tarihi ? new Date(z.ziyaret_tarihi).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</td></tr>`).join("")}</tbody>
          </table></div>${pager()}`;
      wirePager();
    };
    const pager = () => total > 1 ? `<div class="dk-pager"><button class="dk-btn dk-btn-sm" data-pp="prev" ${pg === 0 ? "disabled" : ""}>‹ Önceki</button><span class="sub2">${pg + 1} / ${total}</span><button class="dk-btn dk-btn-sm" data-pp="next" ${pg === total - 1 ? "disabled" : ""}>Sonraki ›</button></div>` : "";
    const wirePager = () => { const el = S.container.querySelector("#rp-zl"); el?.querySelector('[data-pp="prev"]')?.addEventListener("click", () => { pg--; render(); }); el?.querySelector('[data-pp="next"]')?.addEventListener("click", () => { pg++; render(); }); };
    dkModal(`<div class="dk-det-head"><h3>📍 ${esc(baslik)} <span class="sub2">(${rows.length})</span></h3><button class="dk-x" data-kapat>✕</button></div><div id="rp-zl"></div><div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button></div>`);
    render();
  }
  function rpTekModal(baslik, rows) {
    const DUR = { KAZANILDI: ["Kazanıldı", "p-ok"], KAYBEDILDI: ["Kaybedildi", "p-crit"], TASLAK: ["Taslak", "p-mut"], ONAY_BEKLIYOR: ["Onay Bekliyor", "p-warn"], ONAYLANDI: ["Onaylandı", "p-info"], SUNULDU: ["Sunuldu", "p-viol"], IPTAL: ["İptal", "p-mut"] };
    const PG = 20; let pg = 0; const total = Math.ceil(rows.length / PG) || 1;
    const render = () => {
      const el = S.container.querySelector("#rp-tl"); if (!el) return;
      const slice = rows.slice(pg * PG, (pg + 1) * PG);
      el.innerHTML = !rows.length ? `<div class="dk-empty-s">Kayıt yok.</div>`
        : `<div style="max-height:52vh;overflow:auto"><table class="dk-t">
            <thead><tr><th>Firma</th><th>Marka</th><th class="num">Tutar</th><th>Durum</th>${isMgr ? "<th>Temsilci</th>" : ""}<th>Tarih</th></tr></thead>
            <tbody>${slice.map(x => { const [dl, dc] = DUR[x.durum] || [x.durum, "p-mut"]; return `<tr><td class="firm">${esc(x.firma || "—")}</td><td class="sub2">${esc(x.marka || "—")}</td><td class="num">${x.toplam_tutar ? money(x.toplam_tutar) : "—"}</td><td><span class="pill ${dc}">${dl}</span></td>${isMgr ? `<td class="sub2">${esc(x.rep_full_name || "—")}</td>` : ""}<td class="sub2">${x.created_at ? new Date(x.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</td></tr>`; }).join("")}</tbody>
          </table></div>${pager()}`;
      wirePager();
    };
    const pager = () => total > 1 ? `<div class="dk-pager"><button class="dk-btn dk-btn-sm" data-pp="prev" ${pg === 0 ? "disabled" : ""}>‹ Önceki</button><span class="sub2">${pg + 1} / ${total}</span><button class="dk-btn dk-btn-sm" data-pp="next" ${pg === total - 1 ? "disabled" : ""}>Sonraki ›</button></div>` : "";
    const wirePager = () => { const el = S.container.querySelector("#rp-tl"); el?.querySelector('[data-pp="prev"]')?.addEventListener("click", () => { pg--; render(); }); el?.querySelector('[data-pp="next"]')?.addEventListener("click", () => { pg++; render(); }); };
    dkModal(`<div class="dk-det-head"><h3>💼 ${esc(baslik)} <span class="sub2">(${rows.length})</span></h3><button class="dk-x" data-kapat>✕</button></div><div id="rp-tl"></div><div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button></div>`);
    render();
  }
  function rpYeniMusModal(rows) {
    const KAYNAK = { SAHA_ZIYARETI: "📍 Saha", TELEFON: "📞 Telefon", REFERANS: "🤝 Referans", DIGER: "Diğer" };
    const PG = 20; let pg = 0; const total = Math.ceil(rows.length / PG) || 1;
    const render = () => {
      const el = S.container.querySelector("#rp-ym"); if (!el) return;
      const slice = rows.slice(pg * PG, (pg + 1) * PG);
      el.innerHTML = !rows.length ? `<div class="dk-empty-s">Kayıt yok.</div>`
        : `<div style="max-height:52vh;overflow:auto"><table class="dk-t">
            <thead><tr><th>Firma</th><th>İl</th><th>Kaynak</th><th>VKN</th><th>GPS</th><th>Rep</th><th>Tarih</th></tr></thead>
            <tbody>${slice.map(c => `<tr><td class="firm">${esc(c.firma)}</td><td class="sub2">${esc(c.il || "—")}</td><td class="sub2">${KAYNAK[c.kayit_kaynagi] || c.kayit_kaynagi || "—"}</td><td>${c.vergi_no ? `<span style="color:var(--yesil-p)">✓</span>` : `<span style="color:var(--sari-p)">—</span>`}</td><td>${c.lat != null ? `<span style="color:var(--yesil-p)">✓</span>` : `<span class="sub2">—</span>`}</td><td class="sub2">${esc(c.rep_adi || "—")}</td><td class="sub2">${c.created_at ? new Date(c.created_at).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</td></tr>`).join("")}</tbody>
          </table></div>${pager()}`;
      wirePager();
    };
    const pager = () => total > 1 ? `<div class="dk-pager"><button class="dk-btn dk-btn-sm" data-pp="prev" ${pg === 0 ? "disabled" : ""}>‹ Önceki</button><span class="sub2">${pg + 1} / ${total}</span><button class="dk-btn dk-btn-sm" data-pp="next" ${pg === total - 1 ? "disabled" : ""}>Sonraki ›</button></div>` : "";
    const wirePager = () => { const el = S.container.querySelector("#rp-ym"); el?.querySelector('[data-pp="prev"]')?.addEventListener("click", () => { pg--; render(); }); el?.querySelector('[data-pp="next"]')?.addEventListener("click", () => { pg++; render(); }); };
    dkModal(`<div class="dk-det-head"><h3>📋 Yeni Müşteri Kayıtları <span class="sub2">(${rows.length})</span></h3><button class="dk-x" data-kapat>✕</button></div><div id="rp-ym"></div><div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button></div>`);
    render();
  }

  // ── wiring: sekmeler + tarih kontrolleri ────────────────────────────────────
  const rpKontrol = () => { const bar = m.querySelector(".rp-bar"); if (bar) bar.style.display = (aktif === "risk" || aktif === "rotam" || aktif === "kapsam" || aktif === "etki" || aktif === "portfoy") ? "none" : "";  /* KAPSAM_DK_V1 */ const seg = S.container.querySelector("#dk-seg"); if (seg) seg.style.display = (["manager","admin"].includes(S.role) && aktif !== "rotam") ? "" : "none"; };  /* RAPOR_KONTROL_DK_V2 */
  m.querySelectorAll("#rp-tabs button").forEach(b => b.addEventListener("click", () => {
    aktif = b.dataset.t;
    m.querySelectorAll("#rp-tabs button").forEach(x => x.classList.toggle("on", x === b));
    rpKontrol();
    ciz();
  }));
  rpKontrol();
  S._raporSeg = () => { rpKontrol(); ciz(); };  /* RAPOR_KONTROL_DK_V1 — segment değişince yalnız aktif sekme */
  $("rp-from").addEventListener("change", ciz);
  $("rp-to").addEventListener("change", ciz);
  m.querySelectorAll(".rp-preset").forEach(b => b.addEventListener("click", () => {
    const gun = Number(b.dataset.days);
    const to = new Date(); const from = new Date(); from.setDate(from.getDate() - gun + 1);  /* RAPOR_DATEFIX_DK_V1 */
    $("rp-to").value = to.toISOString().slice(0, 10);
    $("rp-from").value = from.toISOString().slice(0, 10);
    m.querySelectorAll(".rp-preset").forEach(x => x.classList.toggle("on", x === b));
    ciz();
  }));
  m.querySelector('.rp-preset[data-days="30"]')?.classList.add("on");  /* RAPOR_DEF30_DK_V1 */
  const kaydir = ileri => {
    const f = new Date(rpFrom()), t = new Date(rpTo());
    const span = Math.max(Math.round((t - f) / 86400000), 1) + 1;
    const nf = new Date(f), nt = new Date(t);
    const d = ileri ? span : -span;
    nf.setDate(nf.getDate() + d); nt.setDate(nt.getDate() + d);
    $("rp-from").value = nf.toISOString().slice(0, 10);
    $("rp-to").value = nt.toISOString().slice(0, 10);
    m.querySelectorAll(".rp-preset").forEach(x => x.classList.remove("on"));
    ciz();
  };
  $("rp-prev").addEventListener("click", () => kaydir(false));
  $("rp-next").addEventListener("click", () => kaydir(true));

  ciz();
};

// ── HARİTA (Saha Sesi) — Leaflet müşteri pinleri + il choropleth + AI analiz ──
// mgr-only nav. Canlı: /harita-musteriler, /tr-geo, /harita-il-metrikler,
//   /harita-il-ozet, /harita-musteri-ozet, /harita-musteri-brief, /ai/saha-sesi
VIEWS.harita = (m) => {
  const isMgr = ["manager", "admin"].includes(S.role);
  const simdi = new Date();
  const ayBasi = new Date(simdi.getFullYear(), simdi.getMonth(), 1).toISOString().slice(0, 10);
  const bugun = simdi.toISOString().slice(0, 10);

  m.innerHTML = `<div class="dk-wrap">
    <div class="dk-card rp-bar">
      <div class="rp-presets">
        ${[["30 gün", 30], ["3 ay", 90], ["1 yıl", 365]].map(([l, d]) => `<button class="rp-preset" data-days="${d}">${l}</button>`).join("")}
      </div>
      <div class="rp-range">
        <button class="dk-icobtn" id="hr-prev" title="Önceki dönem">‹</button>
        <input type="date" class="rp-date" id="hr-from" value="${S.harFrom || ayBasi}">
        <span class="rp-arrow">→</span>
        <input type="date" class="rp-date" id="hr-to" value="${S.harTo || bugun}">
        <button class="dk-icobtn" id="hr-next" title="Sonraki dönem">›</button>
      </div>
    </div>

    <div class="dk-sech" style="border-left-color:var(--mavi)">🗺️ Saha Haritası</div>
    <div class="dk-card" style="padding:14px">
      <div class="hr-legend">
        <span><i style="background:#0ea5e9"></i>Tüketici</span>
        <span><i style="background:var(--sari-p)"></i>Ticari</span>
        <span><i class="puls" style="background:#94a3b8"></i>Sorunlu (yanıp söner)</span>
      </div>
      <div class="hr-ctrls">
        <select class="rp-date hr-sel" id="hr-il"><option value="">İl seç — şehir analizi…</option></select>
        <select class="rp-date hr-sel" id="hr-choro">
          <option value="">🎨 Renklendir: kapalı</option>
          <option value="ciro">Ciro (dönem) · üst segmente göre</option>
          <option value="adet">Adet (dönem)</option>
          <option value="net_gecikmis">Net gecikmiş alacak</option>
          <option value="net_risk">Net risk (güncel)</option>
          <option value="cari_bakiye">Cari bakiye (güncel)</option>
        </select>
      </div>
      <div id="hr-choro-legend" class="hr-choro-legend" style="display:none"></div>
      <div class="hr-stage">
        <div id="hr-map" class="hr-map"><div class="dk-load">Harita yükleniyor…</div></div>
        <aside id="hr-sehir" class="hr-drawer" style="display:none"></aside>
      </div>
    </div>

    <div class="dk-sech" style="border-left-color:#6d4bd6">🤖 Saha Sesi — AI Analiz</div>
    <div class="dk-card">
      <div class="sub2" style="margin-bottom:6px">Kapsam seçin:</div>
      <div class="dk-seg2" id="hr-kapsam" style="margin-bottom:12px">
        ${[["tum", "🏢 Tüm KRB"], ["temsilci", "👤 Temsilci"], ["durum", "⚠ Pasif/Riskli"], ["musteri", "🏬 Müşteri"]].map(([v, l]) => `<button data-k="${v}">${l}</button>`).join("")}
      </div>
      <div id="hr-filtre" style="margin-bottom:10px"></div>
      <div class="sub2" style="margin-bottom:12px">Dönem: <b>üstteki tarih aralığı</b> · önceki eşit dönemle karşılaştırır</div>
      <button id="hr-analiz" class="dk-btn dk-btn-mor" style="width:100%">🤖 Saha Sesini Analiz Et</button>
      <div id="hr-sonuc" style="display:none;margin-top:12px"></div>
    </div>
  </div>
  <div id="hr-tt" class="hr-tt" style="display:none"></div>`;

  const $ = id => m.querySelector("#" + id);
  const hrFrom = () => $("hr-from")?.value || ayBasi;
  const hrTo = () => $("hr-to")?.value || bugun;

  // ── choropleth durumu ───────────────────────────────────────────────────────
  let _map = null, _choroLayer = null, _choroGeo = null, _ilMetrik = null, _ilMetrikDonem = null, _choroMetrik = S.harChoro || "";
  let mapSehir = null, _allMus = [], _openCust = null;
  // üst segment (Tümü/Tüketici/Ticari) ciro alanını sürer — tek yetkili
  const _segEt = () => S.semsiye === "TUKETICI" ? "Tüketici" : S.semsiye === "TICARI" ? "Ticari" : "";
  const _ciroFld = () => S.semsiye === "TUKETICI" ? "ciro_tuketici" : S.semsiye === "TICARI" ? "ciro_ticari" : "ciro";
  const CHORO = {
    ciro: { lbl: "Ciro (dönem)", fld: "ciro", fmt: v => money(v) },
    adet: { lbl: "Adet (dönem)", fld: "adet", fmt: v => Math.round(v).toLocaleString("tr-TR") + " ad" },
    net_gecikmis: { lbl: "Net gecikmiş alacak", fld: "net_gecikmis", fmt: v => money(v) },
    net_risk: { lbl: "Net risk (güncel)", fld: "net_risk", fmt: v => money(v) },
    cari_bakiye: { lbl: "Cari bakiye (güncel)", fld: "bakiye", fmt: v => money(v) }
  };
  const _normIl = x => {
    if (!x) return "";
    let n = String(x).trim().toLocaleUpperCase("tr-TR").replace(/\s+/g, " ");
    n = n.replace(/İ/g, "I").replace(/Ş/g, "S").replace(/Ç/g, "C").replace(/Ğ/g, "G").replace(/Ü/g, "U").replace(/Ö/g, "O");
    const alias = { "ICEL": "MERSIN", "AFYONKARAHISAR": "AFYON", "K.MARAS": "KAHRAMANMARAS", "KAHRAMAN MARAS": "KAHRAMANMARAS", "URFA": "SANLIURFA" };
    return alias[n] || n;
  };
  const _ciroColor = (v, max) => {
    if (!v || max <= 0) return "#eef2f7";
    // taban ton (0.20) — en küçük değerler bile gri zeminde görünür; koyu uca doğru derin lacivert
    const t = 0.20 + 0.80 * Math.min(1, v / max), L = (a, b) => Math.round(a + (b - a) * t);
    return `rgb(${L(224, 13)},${L(235, 48)},${L(250, 112)})`;
  };
  async function _ensureGeo() { if (_choroGeo) return _choroGeo; _choroGeo = await api("/api/saha/tr-geo"); return _choroGeo; }
  async function _ensureIlMetrik() {
    const donem = hrFrom() + ":" + hrTo();
    if (_ilMetrik && _ilMetrikDonem === donem) return _ilMetrik;
    _ilMetrik = await api(`/api/saha/harita-il-metrikler?from=${hrFrom()}&to=${hrTo()}`);
    _ilMetrikDonem = donem;
    return _ilMetrik;
  }
  // metriğe göre alan + etiket (ciro üst segmenti izler)
  const _choroFld = metrik => metrik === "ciro" ? _ciroFld() : (CHORO[metrik] || CHORO.ciro).fld;
  const _choroLbl = metrik => {
    const base = (CHORO[metrik] || CHORO.ciro).lbl;
    return metrik === "ciro" && _segEt() ? `${base} · ${_segEt()}` : base;
  };
  function choroLegend(metrik) {
    const lg = $("hr-choro-legend"); if (!lg) return;
    if (!metrik) { lg.style.display = "none"; lg.innerHTML = ""; return; }
    lg.style.display = "block";
    lg.innerHTML = `<b>${esc(_choroLbl(metrik))}</b> — <span class="hr-ramp"></span> açık = düşük · koyu = yüksek`;
  }
  async function renklendir(metrik) {
    _choroMetrik = metrik || "";
    if (!_map || !window.L) return;
    if (_choroLayer) { try { _map.removeLayer(_choroLayer); } catch { } _choroLayer = null; }
    const mapEl = $("hr-map");
    if (!metrik) { if (mapEl) mapEl.classList.remove("hr-choro-on"); choroLegend(""); return; }
    if (mapEl) mapEl.classList.add("hr-choro-on"); // renklendirme açıkken taban haritayı koyulaştır
    try {
      const geo = await _ensureGeo();
      const data = await _ensureIlMetrik();
      const byIl = {}; (data.iller || []).forEach(x => { byIl[_normIl(x.il)] = x; });
      const fld = _choroFld(metrik);
      const meta = CHORO[metrik] || CHORO.ciro;
      // sıra (yüzdelik) bazlı renk — ciro/adet gibi birkaç ilin domine ettiği (skew) metriklerde
      // doğrusal ölçek her yeri soluk/"sisli" bırakıyordu; sıra bazlı gradyan tüm illere yayılır
      const vals = (data.iller || []).map(x => Number(x[fld] || 0)).filter(v => v > 0).sort((a, b) => a - b);
      const _tColor = t => { const tt = 0.18 + 0.82 * Math.max(0, Math.min(1, t)); const L = (a, b) => Math.round(a + (b - a) * tt); return `rgb(${L(224, 13)},${L(235, 48)},${L(250, 112)})`; };
      const rankColor = v => {
        if (!(v > 0) || !vals.length) return null;
        let lo = 0, hi = vals.length; while (lo < hi) { const mid = (lo + hi) >> 1; if (vals[mid] <= v) lo = mid + 1; else hi = mid; }
        return _tColor(vals.length > 1 ? (lo - 1) / (vals.length - 1) : 1);
      };
      _choroLayer = L.geoJSON(geo, {
        pane: "choroPane",
        style: f => {
          const d = byIl[_normIl(f.properties && (f.properties.name || f.properties.NAME))];
          const col = rankColor(d ? Number(d[fld] || 0) : 0);
          return col
            ? { fillColor: col, fillOpacity: 0.85, color: "#ffffff", weight: 1 }
            : { fillColor: "#b9c4d4", fillOpacity: 0.12, color: "#ffffff", weight: 0.6 };
        },
        onEachFeature: (f, layer) => {
          const nm = (f.properties && (f.properties.name || f.properties.NAME)) || "";
          const d = byIl[_normIl(nm)];
          const t = d ? meta.fmt(Number(d[fld] || 0)) : "veri yok";
          layer.bindTooltip(`${nm} — ${t}`, { sticky: true });
          layer.on("click", () => ilSec(nm));
        }
      }).addTo(_map);
      choroLegend(metrik);
    } catch { choroLegend(""); }
  }

  // ── şehir kartı ─────────────────────────────────────────────────────────────
  const _tile = (l, v, d, dir) => `<div class="hr-tile"><div class="l">${esc(l)}</div><div class="v">${v == null ? "—" : esc(String(v))}</div>${d ? `<div class="d ${dir || "neu"}">${dir === "up" ? "▲ " : dir === "dn" ? "▼ " : ""}${esc(d)}</div>` : ""}</div>`;
  const _tileBar = (l, v, pct, col) => `<div class="hr-tile"><div class="l">${esc(l)}</div><div class="v">${esc(v)}<span style="font-size:11px;color:var(--tx-2);font-weight:600"> %</span></div><div class="hr-tbar"><i style="width:${Math.max(0, Math.min(100, pct))}%;background:${col}"></i></div></div>`;
  const _tileDrill = (l, v, metrik) => `<div class="hr-tile hr-drill" data-drill="${metrik}" title="Cari kırılımını gör — hangi müşteriler, ne kadar"><div class="l">${esc(l)}</div><div class="v">${esc(v)}</div><div class="d" style="color:var(--mavi-koyu)">↗ cari listesi</div></div>`;
  const _gunFark = ds => { if (!ds) return null; const d = new Date(String(ds).length <= 10 ? ds + "T12:00:00" : ds); return isNaN(d) ? null : Math.max(0, Math.round((Date.now() - d.getTime()) / 86400000)); };
  const SORUN_META = {
    RISKLI_NOKTA: { et: "⚠ Riskli nokta", ac: "Tahsilat / ödeme riski", cls: "riskli" },
    PASIF_NOKTA: { et: "⏸ Pasif nokta", ac: "Aktif alım durmuş", cls: "pasif" },
    ESKI_NOKTA: { et: "🗄 Eski / atıl nokta", ac: "Uzun süredir hareketsiz", cls: "pasif" }
  };
  function _sorunBanner(durum, d, fin) {
    const meta = SORUN_META[durum]; if (!meta) return "";
    const bits = [];
    const vg = fin ? Number(fin.vadesi_gecmis || 0) : 0;
    if (vg > 0) bits.push(`vadesi geçmiş ${money(vg)}`);
    const gun = _gunFark(d && d.son_ziyaret);
    if (gun == null) bits.push("tamamlanmış ziyaret yok");
    else if (gun >= 30) bits.push(`son ziyaret ${gun} gün önce`);
    if (d && Number(d.satis_ciro) === 0) bits.push("dönemde satış yok");
    return `<div class="hr-neden ${meta.cls}"><div class="hr-neden-b">${meta.et}</div><div class="hr-neden-t">${esc(bits.length ? bits.join(" · ") : meta.ac)}</div><div class="hr-neden-s">⟳ Durum, ERP alım & ziyaret verisinden otomatik belirlenir (kişi atamaz)</div></div>`;
  }
  const _drawerHead = (ey, title, sub) => `<div class="hr-dh"><button class="hr-dx" data-drawerx title="Kapat">✕</button><div class="hr-ey">${esc(ey)}</div><h2>${esc(title)}</h2><div class="hr-dsub">${sub}</div></div>`;
  function _wireDrawerX() { $("hr-sehir")?.querySelector("[data-drawerx]")?.addEventListener("click", ilKapat); }
  function ilKapat() {
    mapSehir = null; _openCust = null;
    const kart = $("hr-sehir"); if (kart) { kart.style.display = "none"; kart.innerHTML = ""; }
    const sel = $("hr-il"); if (sel) sel.value = "";
  }

  // ── il tile drill-down: hangi müşteriler, ne kadar ──────────────────────────
  async function ilCariModal(il, metrik) {
    const BAS = { net_gecikmis: "Net Gecikmiş Alacak", bakiye: "Cari Bakiye", net_risk: "Net Risk" };
    dkModal(`<div class="ilc-wrap">
      <div class="dk-det-head"><h3>${esc(BAS[metrik] || metrik)} <span class="sub2">· ${esc(il)}</span></h3><button class="dk-x" data-kapat>✕</button></div>
      <div id="ilc-body" class="ilc-body"><div class="dk-load">Yükleniyor…</div></div>
      <div class="dk-det-alt"><button class="dk-btn" data-kapat>Kapat</button></div>
    </div>`);
    try {
      const { cariler = [], toplam = 0 } = await api(`/api/saha/harita-il-cariler?il=${encodeURIComponent(il)}&metrik=${metrik}`);
      const body = S.container.querySelector("#ilc-body"); if (!body) return;
      body.innerHTML = !cariler.length ? `<div class="dk-empty-s">Bu ilde ${esc((BAS[metrik] || metrik).toLowerCase())} kaydı yok.</div>`
        : `<div class="ilc-meta sub2">${cariler.length} cari · toplam <b style="color:var(--tx-0)">${money(toplam)}</b></div>
          <div class="ilc-head"><span>Firma</span><span>${esc(BAS[metrik] || metrik)}</span></div>
          <div class="ilc-list">${cariler.map(c => `<div class="ilc-row"><div class="ilc-firma"><b>${esc(c.firma || "—")}</b><span class="ilc-kod">${esc(c.musteri_kodu || "")}</span></div><div class="ilc-tutar">${money(c[metrik])}</div></div>`).join("")}</div>`;
    } catch (e) {
      const body = S.container.querySelector("#ilc-body"); if (body) body.innerHTML = `<div class="dk-empty-s" style="color:var(--kirmizi-p)">Alınamadı — ${esc(e.message || e)}</div>`;
    }
  }

  // ── şehir drawer'ı ──────────────────────────────────────────────────────────
  async function ilSec(il) {
    if (!il) return;
    mapSehir = il; _openCust = null;
    const kart = $("hr-sehir"); if (!kart) return;
    const sel = $("hr-il"); if (sel && sel.value !== il) sel.value = il;
    const yerel = _allMus.filter(x => _normIl(x.il) === _normIl(il)); // il yazımı (Kocaeli/KOCAELİ) normalize
    const yTuk = yerel.filter(x => x.tip === "TUKETICI").length, yTic = yerel.filter(x => x.tip === "TICARI").length;
    const yBad = yerel.filter(x => SORUNLU.has(x.durum)).length;
    const sub = `${yerel.length} müşteri · ${yTuk} tüketici / ${yTic} ticari${yBad ? ` · ${yBad} sorunlu` : ""}`;
    kart.style.display = "flex";
    kart.innerHTML = _drawerHead("Şehir analizi", il, esc(sub)) + `<div class="hr-db">
      <div id="hr-sehir-stat"><div class="hr-tiles">${_tile("Haritadaki müşteri", yerel.length)}${_tile("Tüketici / Ticari", `${yTuk} / ${yTic}`)}</div><div class="sub2" style="margin-top:8px">dönemsel metrikler yükleniyor…</div></div>
      <div id="hr-sehir-mus"></div>
      <div class="hr-dsec">🤖 Saha Sesi · AI</div>
      <button id="hr-sehir-ai" class="dk-btn dk-btn-mor" style="width:100%">🤖 Bu şehri analiz et</button>
      <div id="hr-sehir-sonuc" style="display:none;margin-top:10px"></div></div>`;
    _wireDrawerX();
    $("hr-sehir-ai").addEventListener("click", sehirAnaliz);
    // il müşteri listesi
    const musEl = $("hr-sehir-mus");
    if (musEl) {
      const top = yerel.slice(0, 8);
      musEl.innerHTML = `<div class="hr-dsec">🏬 Bu ildeki müşteriler${yerel.length > 8 ? ` <span class="sub2" style="text-transform:none;letter-spacing:0">· ilk 8 / ${yerel.length}</span>` : ""}</div>` +
        (top.length ? top.map(c => `<div class="hr-cust" data-mid="${esc(c.id || "")}"><span class="hr-cav">${esc((c.firma || "?").replace(/[^\p{L}\p{N}]/gu, "").slice(0, 2).toUpperCase() || "?")}</span><div class="hr-cnm"><b>${esc(c.firma || "—")}</b><span>${esc(c.ilce || (SORUNLU.has(c.durum) ? (DURUM_ET[c.durum] || "") : ""))}</span></div><span class="chipmini ${c.tip === "TUKETICI" ? "c-tuk" : "c-tic"}">${c.tip === "TUKETICI" ? "Tüketici" : "Ticari"}</span></div>`).join("") : `<div class="sub2">Bu ilde pinli müşteri yok.</div>`);
      musEl.querySelectorAll(".hr-cust[data-mid]").forEach(row => row.addEventListener("click", () => { const c = yerel.find(x => String(x.id) === row.dataset.mid); if (c) musDrawer(c); }));
    }
    const stat = $("hr-sehir-stat");
    try {
      const [d, mtk] = await Promise.all([
        api(`/api/saha/harita-il-ozet?il=${encodeURIComponent(il)}&from=${hrFrom()}&to=${hrTo()}${S.semsiye ? "&tip=" + S.semsiye : ""}`),
        _ensureIlMetrik().catch(() => null)
      ]);
      if (mapSehir !== il) return; // kullanıcı bu arada başka yere geçtiyse yazma
      const row = mtk ? (mtk.iller || []).find(x => _normIl(x.il) === _normIl(il)) : null;
      const win = d.teklif > 0 ? Math.round(100 * d.kazan / d.teklif) : null;
      const seg = _segEt(); // "" | Tüketici | Ticari
      const tuk = row ? Number(row.ciro_tuketici || 0) : 0, tic = row ? Number(row.ciro_ticari || 0) : 0, tot = tuk + tic;
      const ticPct = tot ? Math.round(100 * tic / tot) : 0;
      // d.* artık tip-filtreli (sunucu üst segmenti uyguluyor) — ziyaret/teklif/satış/ciro hepsi segmente göre
      const ciroDeger = Number(d.satis_ciro || 0);
      const el = $("hr-sehir-stat"); if (el) { el.innerHTML = `<div class="hr-tiles">
        ${_tile("Ciro (dönem)" + (seg ? " · " + seg : ""), money(ciroDeger))}
        ${_tile("Ziyaret (dönem)", d.ziyaret, `${d.musteri} müşteri`)}
        ${_tile("Lastik satışı (dönem)", Math.round(Number(d.satis_adet || 0)).toLocaleString("tr-TR") + " ad")}
        ${_tile("Teklif", `${d.kazan}✓ / ${d.kayip}✗`, win != null ? `%${win} kazanma` : null, win != null ? (win >= 50 ? "up" : "dn") : null)}
        ${!seg && tot ? _tileBar("Ticari / Tüketici", `${ticPct} / ${100 - ticPct}`, ticPct, "var(--sari-p)") : ""}
        ${row && Number(row.net_gecikmis) > 0 ? _tileDrill("Net gecikmiş", money(row.net_gecikmis), "net_gecikmis") : ""}
        ${row && Number(row.bakiye) > 0 ? _tileDrill("Cari bakiye", money(row.bakiye), "bakiye") : ""}</div>`;
        const drillIl = row && row.il ? row.il : il; // il-metrikler'in birebir sehir string'i (DB yazımı)
        el.querySelectorAll("[data-drill]").forEach(tl => tl.addEventListener("click", () => ilCariModal(drillIl, tl.dataset.drill))); }
    } catch (e) {
      console.error("[harita-il-ozet]", e && e.message);
      const el = $("hr-sehir-stat"); if (el) el.innerHTML = `<div class="hr-tiles">${_tile("Haritadaki müşteri", yerel.length)}${_tile("Tüketici / Ticari", `${yTuk} / ${yTic}`)}${yBad ? _tile("Pasif / Riskli", yBad, null, "dn") : ""}</div><div class="sub2" style="margin-top:8px;color:var(--kirmizi-p)">Dönemsel metrikler alınamadı — ${esc(e.message || e)}</div>`;
    }
  }

  // ── müşteri drawer'ı (pin tıklaması) ────────────────────────────────────────
  async function musDrawer(c) {
    const kart = $("hr-sehir"); if (!kart || !c) return;
    mapSehir = null; _openCust = c;
    const tuk = c.tip === "TUKETICI";
    const yer = [c.il, c.ilce].filter(Boolean).join(" / ");
    const sub = `${tuk ? "Tüketici" : "Ticari"}${c.durum ? " · " + (DURUM_ET[c.durum] || c.durum) : ""}${yer ? " · " + yer : ""}`;
    const hasGps = c.lat != null && c.lng != null;
    kart.style.display = "flex";
    kart.innerHTML = _drawerHead("Müşteri", c.firma || "—", esc(sub)) + `<div class="hr-db">
      <div id="hr-mus-neden"></div>
      <div id="hr-mus-stat"><div class="sub2">metrikler yükleniyor…</div></div>
      ${(c.il || hasGps) ? `<div class="hr-dact">${c.il ? `<button class="dk-btn dk-btn-sm" id="hr-mus-il">🗺 İl analizi</button>` : ""}${hasGps ? `<button class="dk-btn dk-btn-sm" id="hr-mus-yol">🧭 Yol Tarifi</button>` : ""}</div>` : ""}
      <div class="hr-dsec">🤖 AI Özet</div>
      <button id="hr-mus-ai" class="dk-btn dk-btn-mor" style="width:100%">🤖 Ziyaret notlarından özet</button>
      <div id="hr-mus-ai-sonuc" style="display:none;margin-top:10px"></div></div>`;
    _wireDrawerX();
    $("hr-mus-il")?.addEventListener("click", () => { if (c.il) ilSec(c.il); });
    $("hr-mus-yol")?.addEventListener("click", () => yolTarifi(Number(c.lat), Number(c.lng)));
    const aiBtn = $("hr-mus-ai"), aiOut = $("hr-mus-ai-sonuc");
    aiBtn.addEventListener("click", async () => {
      if (aiOut.dataset.y) { aiOut.style.display = aiOut.style.display === "none" ? "block" : "none"; return; }
      aiBtn.disabled = true; aiBtn.textContent = "… özet çıkarılıyor";
      aiOut.style.display = "block"; aiOut.innerHTML = `<span class="sub2">yapay zeka ziyaret notlarını okuyor…</span>`;
      try {
        const r = await api("/api/saha/harita-musteri-brief?id=" + encodeURIComponent(c.id));
        aiOut.dataset.y = "1";
        let h = `<div class="hr-brief">${esc(r.brief || "Özet yok")}</div>`;
        if (r.aksiyonlar && r.aksiyonlar.length) h += `<div class="hr-brief-a">${r.aksiyonlar.map(a => `<div>• ${esc(a)}</div>`).join("")}</div>`;
        aiOut.innerHTML = h;
      } catch { aiOut.innerHTML = `<span style="color:var(--kirmizi-p)">AI özeti alınamadı</span>`; }
      finally { aiBtn.disabled = false; aiBtn.innerHTML = "🤖 Ziyaret notlarından özet"; }
    });
    const sorunlu = SORUNLU.has(c.durum);
    try {
      const [d, fin] = await Promise.all([
        api(`/api/saha/harita-musteri-ozet?id=${encodeURIComponent(c.id)}&from=${hrFrom()}&to=${hrTo()}`),
        sorunlu && c.id ? api(`/api/saha/musteriler/${encodeURIComponent(c.id)}/finansal`).then(r => r.finansal).catch(() => null) : Promise.resolve(null)
      ]);
      const nEl = $("hr-mus-neden"); if (nEl) nEl.innerHTML = _sorunBanner(c.durum, d, fin);
      let skorTxt = "";
      if (d.musteri_kodu) { try { const sk = await api("/api/bi/musteri-skor?musteri=" + encodeURIComponent(d.musteri_kodu)); if (sk && sk.skor != null) skorTxt = String(sk.skor); } catch { } }
      const win = d.teklif > 0 ? Math.round(100 * d.kazan / d.teklif) : null;
      const ciroZero = Number(d.satis_ciro) === 0;
      const gun = _gunFark(d.son_ziyaret);
      const t = [];
      t.push(_tile("Ciro (dönem)", money(d.satis_ciro), ciroZero ? "satış yok" : null, ciroZero ? "dn" : null));
      t.push(_tile("Ziyaret", d.ziyaret, gun != null ? `son ${gun}g önce` : "kayıt yok", (gun == null || gun >= 30) ? "dn" : null));
      t.push(_tile("Lastik satışı (dönem)", Math.round(Number(d.satis_adet || 0)).toLocaleString("tr-TR") + " ad"));
      t.push(_tile("Teklif", `${d.kazan}✓ / ${d.kayip}✗`, win != null ? `%${win} kazanma` : null, win != null ? (win >= 50 ? "up" : "dn") : null));
      if (fin && Number(fin.vadesi_gecmis) > 0) t.push(_tile("Vadesi geçmiş", money(fin.vadesi_gecmis), null, "dn"));
      if (skorTxt !== "") t.push(_tile("Puan", skorTxt + "/100"));
      const el = $("hr-mus-stat"); if (el) el.innerHTML = `<div class="hr-tiles">${t.join("")}</div>`;
    } catch (e) {
      const el = $("hr-mus-stat"); if (el) el.innerHTML = `<div class="sub2" style="color:var(--kirmizi-p)">Metrik alınamadı — ${esc(e.message || e)}</div>`;
    }
  }

  // ── harita yükle ────────────────────────────────────────────────────────────
  const DURUM_ET = { AKTIF_MUSTERI: "Aktif", PASIF_NOKTA: "Pasif", RISKLI_NOKTA: "Riskli", ESKI_NOKTA: "Eski", YENI_NOKTA: "Yeni" };
  const SORUNLU = new Set(["PASIF_NOKTA", "ESKI_NOKTA", "RISKLI_NOKTA"]);
  let _markers = null;
  // Harita bir KEZ kurulur; pinler her tip/segment değişiminde yeniden çizilir (map yeniden init EDİLMEZ → "already initialized" yok, zoom korunur)
  async function ensureMap() {
    const el = $("hr-map"); if (!el) return null;
    if (_map) return _map;
    el.innerHTML = "";
    const map = L.map(el, { zoomControl: true, scrollWheelZoom: true }).setView([39.0, 35.0], 5);
    _map = map; _choroLayer = null;
    try { map.createPane("borderPane"); map.getPane("borderPane").style.zIndex = 340; } catch { }
    try { map.createPane("choroPane"); map.getPane("choroPane").style.zIndex = 350; } catch { }
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(map);
    _ensureGeo().then(geo => { if (_map === map) { try { L.geoJSON(geo, { pane: "borderPane", interactive: false, style: { fill: true, fillColor: "#5b6b80", fillOpacity: 0.04, color: "#556376", weight: 1.2, opacity: 0.9 } }).addTo(map); } catch { } } }).catch(() => { });
    const FsCtl = L.Control.extend({
      options: { position: "bottomleft" },
      onAdd() {
        const b = L.DomUtil.create("button", "");
        b.innerHTML = "⛶"; b.title = "Tam ekran";
        b.style.cssText = "width:34px;height:34px;background:#fff;border:2px solid rgba(0,0,0,.2);border-radius:6px;font-size:16px;line-height:1;cursor:pointer;color:#334155";
        L.DomEvent.disableClickPropagation(b);
        b.onclick = () => { const on = el.classList.toggle("hr-tam"); b.innerHTML = on ? "✕" : "⛶"; setTimeout(() => { try { map.invalidateSize(); } catch { } }, 60); };
        return b;
      }
    });
    map.addControl(new FsCtl());
    _markers = L.layerGroup().addTo(map);
    setTimeout(() => { try { map.invalidateSize(); } catch { } }, 140);
    return map;
  }
  async function loadHarita(fit = true) {
    const el = $("hr-map"); if (!el) return;
    try {
      await ensureLeaflet();
      const map = await ensureMap(); if (!map) return;
      const qs = S.semsiye ? "?tip=" + encodeURIComponent(S.semsiye) : "";
      const { musteriler = [] } = await api("/api/saha/harita-musteriler" + qs);
      _allMus = musteriler;
      _markers.clearLayers();
      const pts = [];
      for (const c of musteriler) {
        if (c.lat == null || c.lng == null) continue;
        const lat = Number(c.lat), lng = Number(c.lng);
        if (isNaN(lat) || isNaN(lng)) continue;
        const tuk = c.tip === "TUKETICI";
        const mk = L.circleMarker([lat, lng], { radius: 7, color: "#fff", weight: 2, fillColor: tuk ? "#0ea5e9" : "#fab219", fillOpacity: .95, className: SORUNLU.has(c.durum) ? "hr-pin-sorunlu" : "" }).addTo(_markers);
        mk.on("click", () => { try { map.panTo([lat, lng], { animate: true }); } catch { } musDrawer(c); });
        const _bad = SORUNLU.has(c.durum);
        mk.on("mouseover", () => { const tt = $("hr-tt"); if (!tt) return; tt.innerHTML = `<b>${esc(c.firma || "")}</b>${c.durum ? ` · <span style="color:${_bad ? "#fca5a5" : "#cbd5e1"}">${_bad ? "⚠ " : ""}${esc(DURUM_ET[c.durum] || c.durum)}</span>` : ""}${c.il ? ` · ${esc(c.il)}` : ""}`; tt.style.display = "block"; });
        mk.on("mousemove", e => { const tt = $("hr-tt"); if (!tt || !e.originalEvent) return; tt.style.left = (e.originalEvent.clientX + 14) + "px"; tt.style.top = (e.originalEvent.clientY - 34) + "px"; });
        mk.on("mouseout", () => { const tt = $("hr-tt"); if (tt) tt.style.display = "none"; });
        pts.push([lat, lng]);
      }
      // 81 il + pinli iller (normalize ile tekrarsız) — her şehir seçilebilsin
      const _ilMap = new Map();
      TR_ILLER.forEach(i => _ilMap.set(_normIl(i), i));
      musteriler.forEach(x => { if (x.il) { const n = _normIl(x.il); if (!_ilMap.has(n)) _ilMap.set(n, x.il); } });
      const iller = [..._ilMap.values()].sort((a, b) => String(a).localeCompare(String(b), "tr"));
      const sel = $("hr-il");
      if (sel) { const cur = sel.value; sel.innerHTML = `<option value="">İl seç — şehir analizi…</option>` + iller.map(i => `<option value="${esc(i)}">${esc(i)}</option>`).join(""); if (cur) sel.value = cur; }
      if (fit && pts.length) map.fitBounds(pts, { padding: [30, 30], maxZoom: 12 });
      if (_choroMetrik) setTimeout(() => renklendir(_choroMetrik), 200);
    } catch (err) {
      if (!_map) el.innerHTML = `<div class="dk-empty-s" style="color:var(--kirmizi-p)">Harita yüklenemedi: ${esc(err.message || "")}</div>`;
      else console.error("[loadHarita]", err && err.message);
    }
  }

  // ── Saha Sesi AI ────────────────────────────────────────────────────────────
  let ssKapsam = "";
  const _today = () => new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Istanbul" });
  const aiCacheGet = k => { try { const c = JSON.parse(localStorage.getItem("saha-ai-cache") || "{}"); return c[k]?.date === _today() ? c[k].data : null; } catch { return null; } };
  const aiCacheSet = (k, data) => { try { const c = JSON.parse(localStorage.getItem("saha-ai-cache") || "{}"); c[k] = { date: _today(), data }; for (const kk of Object.keys(c)) if (c[kk].date !== _today()) delete c[kk]; localStorage.setItem("saha-ai-cache", JSON.stringify(c)); } catch { } };

  async function renderSsFiltre() {
    const el = $("hr-filtre"); if (!el) return;
    if (ssKapsam === "tum" || ssKapsam === "durum") { el.innerHTML = ""; return; }
    if (ssKapsam === "temsilci") {
      el.innerHTML = `<div class="sub2">Yükleniyor…</div>`;
      try {
        const { repler = [] } = await api("/api/saha/admin/reps");
        el.innerHTML = `<select class="rp-date" id="hr-rep" style="width:100%"><option value="">— Temsilci seçin —</option>${repler.filter(r => r.module_role === "rep").map(r => `<option value="${esc(r.id)}">${esc(r.full_name)}</option>`).join("")}</select>`;
      } catch { el.innerHTML = ""; }
      return;
    }
    if (ssKapsam === "musteri") {
      el.innerHTML = `<input class="rp-date" id="hr-mus-ara" placeholder="Müşteri adı ara…" style="width:100%"><div id="hr-mus-sonuc" class="sub2" style="margin-top:4px"></div><input type="hidden" id="hr-mus-id">`;
      let tmr = null;
      $("hr-mus-ara")?.addEventListener("input", () => {
        clearTimeout(tmr);
        const q = $("hr-mus-ara").value.trim(); const res = $("hr-mus-sonuc"); if (!res) return;
        if (q.length < 2) { res.innerHTML = ""; return; }
        tmr = setTimeout(async () => {
          try {
            const { sonuclar = [] } = await api("/api/saha/musteri-ara?q=" + encodeURIComponent(q));
            const liste = sonuclar.filter(x => x.kaynak === "SAHA" && x.id).slice(0, 8);
            res.innerHTML = liste.map(x => `<div class="hr-mus-op" data-mid="${esc(x.id)}" data-madi="${esc(x.firma)}">${esc(x.firma)}${x.il ? ` <span class="sub2">· ${esc(x.il)}</span>` : ""}</div>`).join("") || `<div class="sub2">Sahada kayıtlı sonuç yok. (Saha Sesi yalnızca sahaya eklenmiş müşterileri analiz eder.)</div>`;
            res.querySelectorAll(".hr-mus-op").forEach(d => d.addEventListener("click", () => {
              if (!d.dataset.mid) { res.innerHTML = `<span style="color:var(--sari-p)">Bu kayıt henüz sahada değil.</span>`; return; }
              $("hr-mus-id").value = d.dataset.mid; $("hr-mus-ara").value = d.dataset.madi;
              res.innerHTML = `<span style="color:var(--yesil-p)">✓ ${esc(d.dataset.madi)} seçildi</span>`;
            }));
          } catch { res.innerHTML = ""; }
        }, 300);
      });
    }
  }

  function renderSsJson(host, data) {
    const { json, analiz, not_sayisi, prior_sayisi, aciklama, karsilastirma } = data;
    if (!json) {
      host.innerHTML = `<div class="ss-box"><div class="ss-meta">📊 ${not_sayisi} not · ${esc(aciklama)}</div><div style="white-space:pre-wrap;font-size:13px;line-height:1.6">${esc(analiz || "").replace(/\*\*(.*?)\*\*/g, "<b>$1</b>")}</div></div>`;
      return;
    }
    const trendBadge = t => { if (!t || t === "stabil") return ""; const map = { yeni: ["🆕", "#6d4bd6"], artiyor: ["↑", "#d03b3b"], azaliyor: ["↓", "#0ca30c"] }; const [ic, clr] = map[t] || ["", "#6b7280"]; return `<span style="font-size:10px;font-weight:700;color:${clr};margin-left:5px">${ic}</span>`; };
    const siklikRenk = s => s === "yüksek" ? "#d03b3b" : s === "orta" ? "#fab219" : "#6b7280";
    const blok = (bg, bd, ttl, tc, body) => `<div class="ss-blk" style="background:${bg};border-color:${bd}"><div class="ss-blk-h" style="color:${tc}">${ttl}</div>${body}</div>`;
    host.innerHTML = `<div class="ss-box">
      <div class="ss-head">
        <div class="ss-meta">📊 ${not_sayisi} not · ${esc(aciklama)}</div>
        ${karsilastirma ? `<div class="ss-cmp">↔ ${prior_sayisi} not önceki dönem</div>` : ""}
      </div>
      ${json.ozet_cumlesi ? `<div class="ss-ozet">"${esc(json.ozet_cumlesi)}"</div>` : ""}
      ${(json.saha_nabzi || json.nabiz) ? `<div class="ss-nabiz">${esc(json.saha_nabzi || json.nabiz)}</div>` : ""}
      ${json.kritik_konular?.length ? `<div class="ss-sec-h">🔔 Kritik Konular</div>${json.kritik_konular.map(k => `
        <div class="ss-krit"><span class="ss-sik" style="color:${siklikRenk(k.siklik)};border-color:${siklikRenk(k.siklik)}">${(k.siklik || "?").toUpperCase()}</span>
        <div><div class="ss-krit-t">${esc(k.konu)}${trendBadge(k.trend)}${k.kaynak === "her_ikisi" ? `<span class="ss-tag mor">✦ sayı+saha</span>` : k.kaynak === "sadece_sayi" ? `<span class="ss-tag mavi">📊 sayı</span>` : ""}</div><div class="ss-krit-d">${esc(k.detay)}</div></div></div>`).join("")}` : ""}
      ${json.kör_noktalar?.length ? blok("var(--sari-z)", "#f0dca8", `<span style="color:var(--sari)">🔍 Kör Noktalar</span>`, "var(--sari)", json.kör_noktalar.map(k => `<div class="ss-item"><b>${esc(k.konu)}</b><div>${esc(k.detay)}</div></div>`).join("")) : ""}
      ${json.riskli_musteriler?.length ? blok("var(--kirmizi-z)", "#f0ccc4", `<span style="color:var(--kirmizi)">⚠ Riskli Müşteriler</span>`, "var(--kirmizi)", json.riskli_musteriler.map(r => `<div class="ss-item"><b>${esc(r.musteri)}</b> — ${esc(r.neden)}</div>`).join("")) : ""}
      ${json.firsatlar?.length ? blok("var(--yesil-z)", "#bfe6d4", `<span style="color:var(--yesil)">✨ Fırsatlar</span>`, "var(--yesil)", json.firsatlar.map(f => `<div class="ss-item"><b>${esc(f.firsat)}</b><div>${esc(f.detay)}</div></div>`).join("")) : ""}
      ${json.temsilci_gozlem ? blok("var(--zemin-2)", "var(--cizgi)", `<span style="color:var(--tx-1)">👁 Temsilci Gözlemi</span>`, "var(--tx-1)", `<div class="ss-item">${esc(json.temsilci_gozlem)}</div>`) : ""}
      ${json.aksiyonlar?.length ? blok("var(--mavi-z)", "#bcd6f5", `<span style="color:var(--mavi-koyu)">✅ Önerilen Aksiyonlar</span>`, "var(--mavi-koyu)", json.aksiyonlar.map((a, i) => `<div class="ss-aksiyon">${i + 1}. ${esc(a)}</div>`).join("")) : ""}
      <button id="hr-ss-kopya" class="dk-btn" style="width:100%;margin-top:4px;border-color:#6d4bd6;color:#6d4bd6">📋 Analizi Kopyala</button>
    </div>`;
    $("hr-ss-kopya")?.addEventListener("click", () => {
      const nabiz = json.saha_nabzi || json.nabiz || "";
      const text = [
        `SAHA SESİ — ${aciklama}`,
        `${not_sayisi} not analiz edildi${karsilastirma ? ` (önceki dönem: ${prior_sayisi} not)` : ""}`,
        json.ozet_cumlesi ? `\n"${json.ozet_cumlesi}"` : "",
        nabiz ? `\n${nabiz}` : "",
        json.kritik_konular?.length ? `\nKRİTİK KONULAR:\n${json.kritik_konular.map(k => `• ${k.konu}: ${k.detay}`).join("\n")}` : "",
        json.kör_noktalar?.length ? `\nKÖR NOKTALAR:\n${json.kör_noktalar.map(k => `• ${k.konu}: ${k.detay}`).join("\n")}` : "",
        json.riskli_musteriler?.length ? `\nRİSKLİ MÜŞTERİLER:\n${json.riskli_musteriler.map(r => `• ${r.musteri}: ${r.neden}`).join("\n")}` : "",
        json.firsatlar?.length ? `\nFIRSATLAR:\n${json.firsatlar.map(f => `• ${f.firsat}: ${f.detay}`).join("\n")}` : "",
        json.temsilci_gozlem ? `\nTEMSİLCİ GÖZLEMİ:\n${json.temsilci_gozlem}` : "",
        json.aksiyonlar?.length ? `\nÖNERİLEN AKSİYONLAR:\n${json.aksiyonlar.map((a, i) => `${i + 1}. ${a}`).join("\n")}` : ""
      ].filter(Boolean).join("\n");
      navigator.clipboard?.writeText(text).catch(() => { });
      const b = $("hr-ss-kopya"); if (b) { b.textContent = "✓ Panoya kopyalandı"; setTimeout(() => { b.textContent = "📋 Analizi Kopyala"; }, 1800); }
    });
  }

  async function sehirAnaliz() {
    if (!mapSehir) return;
    const btn = $("hr-sehir-ai"), sonuc = $("hr-sehir-sonuc"); if (!btn || !sonuc) return;
    const key = `sehir:${mapSehir}:${hrFrom()}:${hrTo()}`;
    if (btn.dataset.force !== "1") { const c = aiCacheGet(key); if (c) { sonuc.style.display = "block"; renderSsJson(sonuc, c); btn.textContent = "✓ Bugün analiz edildi · 🔄 Yenile"; btn.dataset.force = "1"; return; } }
    btn.dataset.force = "0"; btn.textContent = "⏳ Analiz ediliyor…"; btn.disabled = true;
    sonuc.style.display = "block"; sonuc.innerHTML = `<div class="sub2" style="color:#6d4bd6;padding:8px">Ziyaret notları analiz ediliyor…</div>`;
    try {
      const p = new URLSearchParams({ kapsam: "sehir", sehir: mapSehir, from: hrFrom(), to: hrTo() });
      const r = await api("/api/saha/ai/saha-sesi?" + p);
      aiCacheSet(key, r); renderSsJson(sonuc, r);
      btn.textContent = "✓ Analiz edildi · 🔄 Yenile"; btn.dataset.force = "1";
    } catch (e) { sonuc.innerHTML = `<div style="color:var(--kirmizi-p);padding:8px">Hata: ${esc(e.message)}</div>`; btn.textContent = "🤖 Bu şehri analiz et"; btn.dataset.force = "0"; }
    btn.disabled = false;
  }

  async function sahaSesiAnaliz() {
    const btn = $("hr-analiz"), sonuc = $("hr-sonuc"); if (!btn || !sonuc) return;
    if (!ssKapsam) { alert("Önce bir kapsam seçin (Tüm KRB, Temsilci, vb.)"); return; }
    const p = new URLSearchParams({ kapsam: ssKapsam });
    if (ssKapsam === "durum") p.set("durum", "PASIF,RISKLI");
    let subId = "";
    if (ssKapsam === "temsilci") { const v = $("hr-rep")?.value; if (!v) { alert("Lütfen bir temsilci seçin."); return; } p.set("rep_id", v); subId = v; }
    if (ssKapsam === "musteri") { const v = $("hr-mus-id")?.value; if (!v) { alert("Lütfen bir müşteri seçin."); return; } p.set("musteri_id", v); subId = v; }
    p.set("from", hrFrom()); p.set("to", hrTo()); // üst tarih aralığını kullan
    const key = `ss:${ssKapsam}:${subId}:${hrFrom()}:${hrTo()}`;
    if (btn.dataset.force !== "1") { const c = aiCacheGet(key); if (c) { sonuc.style.display = "block"; renderSsJson(sonuc, c); btn.textContent = "✓ Bugün analiz edildi · 🔄 Yenile"; btn.dataset.force = "1"; return; } }
    btn.dataset.force = "0"; btn.textContent = "⏳ Analiz ediliyor…"; btn.disabled = true;
    sonuc.style.display = "block"; sonuc.innerHTML = `<div class="sub2" style="color:#6d4bd6;padding:10px">Notlar toplanıyor ve karşılaştırmalı analiz yapılıyor…</div>`;
    try {
      const r = await api("/api/saha/ai/saha-sesi?" + p);
      aiCacheSet(key, r); renderSsJson(sonuc, r);
      btn.textContent = "✓ Analiz edildi · 🔄 Yenile"; btn.dataset.force = "1";
    } catch (e) { sonuc.innerHTML = `<div style="color:var(--kirmizi-p);padding:10px">Hata: ${esc(e.message)}</div>`; btn.textContent = "🤖 Saha Sesini Analiz Et"; btn.dataset.force = "0"; }
    btn.disabled = false;
  }

  // ── wiring ──────────────────────────────────────────────────────────────────
  $("hr-il").addEventListener("change", () => { const v = $("hr-il").value; if (v) ilSec(v); else ilKapat(); });
  $("hr-choro").addEventListener("change", () => { S.harChoro = $("hr-choro").value; renklendir(S.harChoro); });
  if (S.harChoro) $("hr-choro").value = S.harChoro; // segment değişip yeniden çizildiğinde seçimi geri yükle
  $("hr-analiz").addEventListener("click", sahaSesiAnaliz);
  m.querySelectorAll("#hr-kapsam button").forEach(b => b.addEventListener("click", () => {
    ssKapsam = b.dataset.k;
    m.querySelectorAll("#hr-kapsam button").forEach(x => x.classList.toggle("on", x === b));
    renderSsFiltre();
  }));
  // tarih aralığı + preset S'te kalıcı — segment değişip yeniden çizilse de korunur
  const persistDates = () => { S.harFrom = $("hr-from").value; S.harTo = $("hr-to").value; };
  const donemHook = () => { persistDates(); if (mapSehir) ilSec(mapSehir); else if (_openCust) musDrawer(_openCust); if (_choroMetrik) { _ilMetrik = null; renklendir(_choroMetrik); } };
  // üst segment değişince: tam re-render YOK — pinleri/renklendirmeyi yenile, açık drawer'ı koru & tazele
  S._haritaSeg = async () => { await loadHarita(false); if (mapSehir) ilSec(mapSehir); else if (_openCust) musDrawer(_openCust); };
  $("hr-from").addEventListener("change", () => { S.harPreset = null; m.querySelectorAll(".rp-preset").forEach(x => x.classList.remove("on")); donemHook(); });
  $("hr-to").addEventListener("change", () => { S.harPreset = null; m.querySelectorAll(".rp-preset").forEach(x => x.classList.remove("on")); donemHook(); });
  m.querySelectorAll(".rp-preset").forEach(b => b.addEventListener("click", () => {
    const g = Number(b.dataset.days), t = new Date(), f = new Date(); f.setDate(f.getDate() - g + 1);
    $("hr-to").value = t.toISOString().slice(0, 10); $("hr-from").value = f.toISOString().slice(0, 10);
    S.harPreset = g;
    m.querySelectorAll(".rp-preset").forEach(x => x.classList.toggle("on", x === b));
    donemHook();
  }));
  if (S.harPreset) m.querySelectorAll(".rp-preset").forEach(x => x.classList.toggle("on", Number(x.dataset.days) === S.harPreset)); // yeniden çizimde preset vurgusunu geri yükle
  const kaydir = ileri => {
    const f = new Date(hrFrom() + "T12:00:00"), t = new Date(hrTo() + "T12:00:00");
    const span = Math.round((t - f) / 86400000) + 1, d = ileri ? span : -span;
    f.setDate(f.getDate() + d); t.setDate(t.getDate() + d);
    $("hr-from").value = f.toISOString().slice(0, 10); $("hr-to").value = t.toISOString().slice(0, 10);
    S.harPreset = null;
    m.querySelectorAll(".rp-preset").forEach(x => x.classList.remove("on"));
    donemHook();
  };
  $("hr-prev").addEventListener("click", () => kaydir(false));
  $("hr-next").addEventListener("click", () => kaydir(true));

  loadHarita();
};

VIEWS.musterikart = async (m) => {  /* MUSTERI_KART_DK_V1 — musteriSec + musteriDetay yeniden kullanim */
  const ac = () => musteriSec(async (r) => {
    let c = r;
    if (r && r.id) { try { const res = await api(`/api/saha/musteriler/${r.id}`); c = res.musteri || res; } catch (e) {} }
    musteriDetay(c);
  });
  m.innerHTML = `<div class="dk-wrap"><div class="dk-card"><div class="dk-empty">
    <div class="ic">🧾</div><h3>Müşteri Kartı</h3>
    <p>Bir müşteri seçin — firma bilgileri, ERP finansalları, son alımlar, açık teklifler, ziyaret geçmişi ve AI özeti tek kartta.</p>
    <button class="dk-btn" id="mk-sec" style="margin-top:14px">🔍 Müşteri Seç</button>
  </div></div></div>`;
  m.querySelector("#mk-sec")?.addEventListener("click", ac);
  ac();
};

// diğer modüller — kabuk hazır, canlı bağlanma sırada
VIEWS._todo = (m, dest) => {
  m.innerHTML = `<div class="dk-wrap"><div class="dk-card"><div class="dk-empty">
    <div class="ic">🧱</div><h3>${esc(TITLE[dest] || dest)} — masaüstü tasarımı sırada</h3>
    <p>Bu modül canlı <code>/api/saha</code> uçlarına bağlanarak yeniden inşa ediliyor.<br>
    Kabuk, yetkilendirme ve navigasyon hazır; içerik modül modül geliyor.</p></div></div></div>`;
};

// ── küçük bileşenler ─────────────────────────────────────────────────────────
function stat(k, v, d) {
  return `<div class="dk-stat"><div class="k">${esc(k)}</div><div class="v num">${esc(v)}</div>${d ? `<div class="d">${esc(d)}</div>` : ""}</div>`;
}

// ── modal + foto ─────────────────────────────────────────────────────────────
function dkModal(html) {
  const host = S.container.querySelector("#dk-modal");
  host.innerHTML = `<div class="dk-fon"><div class="dk-kutu">${html}</div></div>`;
  host.querySelector(".dk-fon").addEventListener("click", e => { if (e.target.classList.contains("dk-fon")) dkKapat(); });
  host.querySelectorAll("[data-kapat]").forEach(b => b.addEventListener("click", dkKapat));
  document.addEventListener("keydown", _escKapat);
}
function dkKapat() {
  const host = S.container.querySelector("#dk-modal");
  if (host) host.innerHTML = "";
  document.removeEventListener("keydown", _escKapat);
}
function _escKapat(e) { if (e.key === "Escape") dkKapat(); }

function fotoBuyut(src) {  /* FOTO_BUYUT_V1 — fotoğrafa tıkla → tam ekran */
  if (!src) return;
  const ov = document.createElement("div");
  ov.style.cssText = "position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.92);display:flex;align-items:center;justify-content:center;padding:16px;cursor:zoom-out";
  ov.innerHTML = `<img src="${src}" alt="" style="max-width:100%;max-height:100%;object-fit:contain;border-radius:6px"><div style="position:absolute;top:16px;right:20px;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.18);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;cursor:pointer">✕</div>`;
  ov.addEventListener("click", () => ov.remove());
  const _im = ov.querySelector("img"); if (_im) _im.addEventListener("click", e => e.stopPropagation());
  document.body.appendChild(ov);
}

async function fotoUrl(id) {
  S._foto = S._foto || new Map();
  if (S._foto.has(id)) return S._foto.get(id);
  try {
    const r = await fetch("/api/saha/foto/" + id, { headers: S.headers() });
    if (!r.ok) return "";
    const u = URL.createObjectURL(await r.blob());
    S._foto.set(id, u); return u;
  } catch { return ""; }
}

// ZİYARET DETAYI — mobil ziyaretDetayModal ile aynı sözleşme (foto + görüldü + yorum)
function baglamMesajDesktop(repId, etiket, baglamTip, baglamId) {  /* BAGLAM_MSG_DK_V1 */
  if (!repId) { alert("Bu kaydın sorumlu temsilcisi bulunamadı."); return; }
  dkModal(`<div class="dk-det-head"><h3>💬 Rep'e Mesaj</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin:2px 0 8px">🔗 <b>${esc(etiket)}</b> hakkında</div>
    <textarea id="bmd-icerik" rows="4" placeholder="Mesajınız…" style="width:100%;box-sizing:border-box;font:inherit;border:1px solid var(--cizgi);border-radius:8px;padding:9px"></textarea>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="bmd-gonder" style="background:#0284c7;color:#fff">Gönder</button></div>`);
  S.container.querySelector("#bmd-gonder")?.addEventListener("click", async () => {
    const t = (S.container.querySelector("#bmd-icerik")?.value || "").trim(); if (!t) return;
    const btn = S.container.querySelector("#bmd-gonder"); if (btn) { btn.disabled = true; btn.textContent = "Gönderiliyor…"; }
    try { await api(`/api/saha/baglamli-mesaj`, { method: "POST", body: JSON.stringify({ rep_id: repId, icerik: t, baglam_tip: baglamTip, baglam_id: baglamId, baglam_etiket: etiket }) }); dkKapat(); alert("✓ Mesaj temsilciye gönderildi."); }
    catch (e) { alert(e.message); if (btn) { btn.disabled = false; btn.textContent = "Gönder"; } }
  });
}
async function ziyaretDetay(z) {
  z = z || {};
  const d = z.detay || {};
  const satir = (l, v) => v ? `<div class="dk-det-row"><span>${esc(l)}</span><b>${esc(String(v))}</b></div>` : "";
  const dizi = (l, a) => Array.isArray(a) && a.length ? satir(l, a.join(", ")) : "";
  const konum = [z.il, z.ilce].filter(Boolean).join(" / ");
  dkModal(`
    <div class="dk-det-head">
      <h3>${esc(z.firma || "")}</h3>
      <span class="pill ${z.tip === "TUKETICI" ? "p-info" : "p-mut"}">${z.tip === "TUKETICI" ? "Tüketici" : "Ticari"}</span>
      <button class="dk-x" data-kapat title="Kapat">✕</button>
    </div>
    ${S.role !== "rep" && z.rep_id ? `<div style="margin:8px 0"><button class="dk-btn dk-btn-sm" id="zd-mesaj" data-rep="${esc(z.rep_id)}" data-firma="${esc(z.firma || "")}" data-zid="${esc(z.id)}" style="border-color:#0284c7;color:#0284c7">💬 Rep'e Mesaj</button></div>` : ""}
    <div class="dk-det-grid">
      ${satir("Tarih", z.ziyaret_tarihi ? new Date(z.ziyaret_tarihi).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "")}
      ${satir("Temsilci", z.rep_full_name || z.rep_adi)}
      ${satir("Konum", konum)}
      ${satir("Katılımcı", z.katilimci)}
      ${z.checkin_at ? satir("Check-in", new Date(z.checkin_at).toLocaleString("tr-TR")) : ""}
      ${dizi("Raf markaları", d.raf_markalari)}${dizi("Bayilikler", d.bayilikler)}${dizi("Rakipler", d.rakipler)}
      ${satir("Kış stok", d.kis_stok)}${satir("Yaz stok", d.yaz_stok)}
      ${dizi("Sektörler", d.sektorler)}${dizi("Kullanılan markalar", d.kullanilan_markalar)}${satir("Yıllık potansiyel", d.yillik_potansiyel)}
    </div>
    ${z.notlar ? `<div class="dk-det-not">${esc(z.notlar)}</div>` : ""}
    <div id="dk-det-foto" class="dk-foto-grid"></div>
    ${S.role !== "rep" && Number(z.foto_sayisi) ? `<button class="dk-btn dk-btn-sm" id="dk-rakip-oku" style="margin-top:8px">🔍 Fotoğraftan rakip fiyat oku</button><span id="dk-rakip-oku-durum" class="sub2" style="margin-left:8px"></span>` : ""}<!-- RAKIP_OCR_BACKFILL_V1 -->
    <div id="dk-det-goren" class="sub2" style="margin-top:10px"></div>
    <div class="dk-det-yorum">
      <div class="dk-det-yh">Yorumlar</div>
      <div id="dk-yorum-liste"><div class="sub2">Yükleniyor…</div></div>
      <div class="dk-yorum-yaz"><textarea id="dk-yorum-input" rows="2" placeholder="Yorum yaz…"></textarea><button class="dk-btn" id="dk-yorum-gonder">Gönder</button></div>
    </div>`);

  S.container.querySelector("#zd-mesaj")?.addEventListener("click", (ev) => { const b = ev.currentTarget; baglamMesajDesktop(b.dataset.rep, (b.dataset.firma || "") + " ziyareti", "ziyaret", b.dataset.zid); });  /* BAGLAM_MSG_DK_V1 */
  // otomatik "görüldüm" + görenler
  (async () => {
    try {
      const r = await api(`/api/saha/ziyaretler/${z.id}/gordum`, { method: "POST" });
      const el = S.container.querySelector("#dk-det-goren");
      if (el) {
        const adlar = (r.gorenler || []).map(x => esc(x.ad || "")).filter(Boolean);
        el.innerHTML = `👁 <b>${r.sayi || 0}</b> kişi gördü${adlar.length ? " · " + adlar.join(", ") : ""}`;
      }
    } catch { /* sessiz */ }
  })();

  // fotoğraflar
  if (Number(z.foto_sayisi)) {
    try {
      const { fotolar = [] } = await api(`/api/saha/ziyaretler/${z.id}/fotolar`);
      const g = S.container.querySelector("#dk-det-foto");
      for (const f of fotolar) { const u = await fotoUrl(f.id); if (u && g) g.insertAdjacentHTML("beforeend", `<img src="${u}" alt="" style="cursor:zoom-in">`); }
      if (g && !g._buyutBound) { g._buyutBound = true; g.addEventListener("click", ev => { const im = ev.target.closest("img"); if (im) fotoBuyut(im.src); }); }  /* FOTO_BUYUT_V1 */
    } catch { /* sessiz */ }
  }

  // RAKIP_OCR_BACKFILL_V1 — fotoğraftaki rakip fiyat listesini oku
  S.container.querySelector("#dk-rakip-oku")?.addEventListener("click", async () => {
    const b = S.container.querySelector("#dk-rakip-oku"), st = S.container.querySelector("#dk-rakip-oku-durum");
    if (b) b.disabled = true;
    if (st) st.textContent = "Okunuyor… (birkaç saniye)";
    try {
      const r = await api(`/api/saha/ziyaretler/${z.id}/foto-oku`, { method: "POST" });
      if (st) st.textContent = r.cikarilan_kalem
        ? `✓ ${r.cikarilan_kalem} rakip fiyat kalemi çıkarıldı (${r.islenen_foto} foto)`
        : `Fiyat listesi bulunamadı — ${r.islenen_foto} foto tarandı`;
    } catch (e) { if (st) st.textContent = e.message; }
    if (b) b.disabled = false;
  });
  // yorumlar (oku + yaz)
  const ROL = { admin: "GM", manager: "Müdür", rep: "Temsilci" };
  const yEl = S.container.querySelector("#dk-yorum-liste");
  async function loadY() {
    try {
      const { yorumlar = [] } = await api(`/api/saha/ziyaretler/${z.id}/yorumlar`);
      yEl.innerHTML = yorumlar.length ? yorumlar.map(y => {
        const ts = y.created_at ? new Date(y.created_at).toLocaleString("tr-TR", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";
        return `<div class="dk-yorum"><div class="dk-yorum-b"><span class="pill p-mut">${esc(ROL[y.rol] || y.rol || "")}</span> <b>${esc(y.user_adi || "")}</b> <span class="sub2" style="margin-left:auto">${ts}</span></div><div class="dk-yorum-t">${esc(y.icerik || "")}</div></div>`;
      }).join("") : `<div class="sub2">Henüz yorum yok.</div>`;
    } catch { yEl.innerHTML = `<div class="sub2">Yorumlar yüklenemedi.</div>`; }
  }
  loadY();
  const gonder = async () => {
    const inp = S.container.querySelector("#dk-yorum-input");
    const t = (inp.value || "").trim(); if (!t) return;
    inp.disabled = true;
    try { await api(`/api/saha/ziyaretler/${z.id}/yorumlar`, { method: "POST", body: JSON.stringify({ icerik: t }) }); inp.value = ""; await loadY(); }
    catch (e) { inp.placeholder = e.message; }
    finally { inp.disabled = false; }
  };
  S.container.querySelector("#dk-yorum-gonder").addEventListener("click", gonder);
  S.container.querySelector("#dk-yorum-input").addEventListener("keydown", ev => {
    if (ev.key === "Enter" && !ev.shiftKey) { ev.preventDefault(); gonder(); }
  });
}

function _dt(v) { return v ? new Date(v).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"; }

// MÜŞTERİ DETAYI — /finansal (bakiye, vadesi geçmiş, ciro, limit, trend, alımlar, teklifler) + ziyaret geçmişi
function _skorGrade(x) {
  if (x == null) return ["—", "var(--tx-2)"];
  if (x >= 80) return ["A · Güçlü", "var(--yesil-p)"];
  if (x >= 65) return ["B · İyi", "var(--yesil-p)"];
  if (x >= 50) return ["C · Orta", "var(--sari-p)"];
  if (x >= 35) return ["D · Zayıf", "var(--kirmizi-p)"];
  return ["E · Riskli", "var(--kirmizi-p)"];
}
function _skorBar(l, w, v, col) {
  const n = Number(v); const pc = isFinite(n) ? Math.max(0, Math.min(100, n)) : 0;
  return `<div class="dk-sbar"><span class="dk-sbar-l">${esc(l)} <span class="sub2">${w}</span></span><span class="dk-sbar-bg"><span class="dk-sbar-f" style="width:${pc}%;background:${col}"></span></span><span class="dk-sbar-v num">${isFinite(n) ? Math.round(n) : "—"}</span></div>`;
}
// son alımların yanına önerilen fiyat (toplu sorgu, sadece yönetim)
async function _foRecent(m) {
  if (!m.musteri_kodu || !["manager", "admin"].includes(S.role)) return;
  const cells = Array.from(S.container.querySelectorAll("#md-fin [data-fo-oneri]"));
  const kalems = [];
  cells.forEach(c => { const k = c.getAttribute("data-fo-oneri"); if (k && kalems.indexOf(k) < 0) kalems.push(k); });
  if (!kalems.length) return;
  try {
    const d = await api("/api/bi/musteri-fiyat-liste?musteri=" + encodeURIComponent(m.musteri_kodu) + "&kalemler=" + encodeURIComponent(kalems.join(",")));
    const DURc = { LIFT: "var(--yesil-p)", WATCH: "var(--sari-p)", UYGUN: "var(--mavi)", YENI: "#7c5cff", RAKIP: "var(--kirmizi-p)", RAKIP_MALIYET: "var(--sari-p)" };
    cells.forEach(c => {
      const k = c.getAttribute("data-fo-oneri"); const r = d.kalemler && d.kalemler[k];
      if (r && r.oneri != null) c.innerHTML = ` <b style="color:${DURc[r.durum] || "var(--tx-0)"}" title="${esc(r.durum || "")}">→ ${Number(r.oneri).toLocaleString("tr-TR")} ₺</b>`;
      else c.textContent = "";
    });
  } catch { /* öneri yüklenemedi */ }
}

// akıllı fiyat kartı: ödediği → önerilen + pazar bandı + vade menüsü + rakip
async function _foKart(m, kalem) {
  const kart = S.container.querySelector("#md-fo-kart"); if (!kart) return;
  kart.innerHTML = `<div class="sub2" style="padding:6px">Hesaplanıyor…</div>`;
  try {
    const d = await api("/api/bi/musteri-fiyat-liste?musteri=" + encodeURIComponent(m.musteri_kodu) + "&kalemler=" + encodeURIComponent(kalem));
    const r = d.kalemler && d.kalemler[kalem];
    if (!r || r.oneri == null) { kart.innerHTML = `<div class="sub2" style="padding:6px">Bu ürün için veri yok.</div>`; return; }
    const DUR = { LIFT: ["⬆ Yükselt", "var(--yesil-p)"], WATCH: ["👁 İzle", "var(--sari-p)"], UYGUN: ["✓ Uygun", "var(--mavi)"], YENI: ["✦ Yeni", "#7c5cff"], RAKIP: ["⚔ Rakip savun", "var(--kirmizi-p)"], RAKIP_MALIYET: ["⚔ Maliyet sınırı", "var(--sari-p)"] };
    const dd = DUR[r.durum] || ["—", "var(--tx-2)"]; const g = r.gercek;
    const vm = (r.vade_menu || []).map(x => `<div class="dk-vade"><div class="sub2">${x.vade === 0 ? "Peşin" : x.vade + " gün"}</div><div class="num" style="font-weight:700">${Number(x.fiyat).toLocaleString("tr-TR")}</div></div>`).join("");
    kart.innerHTML = `<div class="dk-fo-kart">
      <div class="dk-fo-ad">${esc(r.ad || ((r.marka || "") + " " + (r.ebat || "")))}</div>
      <div class="dk-fo-pair">
        <div class="dk-fo-cell"><div class="k">Şu an ödediği</div><div class="v num">${g != null ? money(g) : "—"}</div></div>
        <div class="dk-fo-cell oner" style="border-color:${dd[1]}"><div class="k" style="color:${dd[1]}">Önerilen · ${dd[0]}</div><div class="v num" style="color:${dd[1]}">${money(r.oneri)}</div>${r.marj_oneri != null ? `<div class="sub2">marj %${r.marj_oneri}</div>` : ""}</div>
      </div>
      <div class="sub2" style="margin-top:7px">Pazar bandı: ${money(r.lo)} – <b>${money(r.med)}</b> – ${money(r.hi)} · maliyet ${money(r.repl_cost != null ? r.repl_cost : r.maliyet)}</div>
      ${vm ? `<div class="dk-det-yh" style="margin-top:9px">Vade–fiyat menüsü</div><div class="dk-vade-row">${vm}</div>` : ""}
      ${r.rakip ? `<div class="dk-fo-rakip">⚔ Rakip: <b>${esc(r.rakip.marka || "?")}</b> ${Number(r.rakip.fiyat).toLocaleString("tr-TR")} ₺${r.rakip.neden ? " · " + esc(r.rakip.neden) : ""}${r.rakip.tarih ? " · " + esc(r.rakip.tarih) : ""}</div>` : ""}
    </div>`;
  } catch { kart.innerHTML = `<div class="sub2" style="padding:6px;color:var(--kirmizi-p)">Öneri yüklenemedi.</div>`; }
}

function musteriMesajDesktop(m) {  /* CONTEXT_MSG_DK2_V1 */
  dkModal(`<div class="dk-det-head"><h3>💬 Rep'e Mesaj</h3><button class="dk-x" data-kapat>✕</button></div>
    <div class="sub2" style="margin:2px 0 8px">🔗 <b>${esc(m.firma)}</b> hakkında, sorumlu temsilciye</div>
    <textarea id="cmd-icerik" rows="4" placeholder="Mesajınız…" style="width:100%;box-sizing:border-box;font:inherit;border:1px solid var(--cizgi);border-radius:8px;padding:9px"></textarea>
    <div class="dk-det-alt"><button class="dk-btn" data-kapat>Vazgeç</button><button class="dk-btn" id="cmd-gonder" style="background:#0284c7;color:#fff">Gönder</button></div>`);
  S.container.querySelector("#cmd-gonder")?.addEventListener("click", async () => {
    const t = (S.container.querySelector("#cmd-icerik")?.value || "").trim();
    if (!t) return;
    const btn = S.container.querySelector("#cmd-gonder"); if (btn) { btn.disabled = true; btn.textContent = "Gönderiliyor…"; }
    try { await api(`/api/saha/musteri/${m.id}/mesaj`, { method: "POST", body: JSON.stringify({ icerik: t }) }); dkKapat(); alert("✓ Mesaj sorumlu temsilciye gönderildi."); }
    catch (e) { alert(e.message); if (btn) { btn.disabled = false; btn.textContent = "Gönder"; } }
  });
}
async function musteriDetay(m) {
  const isMgmt = ["manager", "admin"].includes(S.role);
  const hasKod = !!m.musteri_kodu;
  const yol = (m.lat != null && m.lng != null);
  const [dl, dc] = DURUM[m.durum] || ["", ""];
  const satir = (l, v) => v ? `<div class="dk-det-row"><span>${esc(l)}</span><b>${esc(String(v))}</b></div>` : "";
  dkModal(`
    <div class="dk-det-head">
      <h3>${esc(m.firma)}</h3>
      <span class="pill ${m.tip === "TUKETICI" ? "p-info" : "p-mut"}">${m.tip === "TUKETICI" ? "Tüketici" : "Ticari"}</span>
      ${dl ? `<span class="pill ${dc}">${dl}</span>` : ""}
      <button class="dk-x" data-kapat title="Kapat">✕</button>
    </div>
    <style>/* MUSTERI_KART_DK2_V1 */ #dk-modal .dk-kutu:has(#md-fin){max-width:1060px;padding:22px 26px} .mk-dk-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:0 30px;align-items:start} @media(max-width:900px){.mk-dk-grid{grid-template-columns:1fr}} .mk-dk-col{min-width:0}</style>
    <div class="mk-dk-grid"><div class="mk-dk-col">
    <div class="dk-det-grid">
      ${satir("ERP Kodu", m.musteri_kodu)}
      ${satir("VKN", m.kimlik_vergi_no || m.vergi_no)}
      ${satir("Konum", [m.il, m.ilce].filter(Boolean).join(" / "))}
      ${satir("Yetkili", m.yetkili)}
      ${satir("Telefon", m.telefon)}
      ${satir("Ziyaret", (m.ziyaret_sayisi || 0) + " kez" + (m.son_ziyaret ? " — son " + new Date(m.son_ziyaret).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : ""))}
    </div>
    ${isMgmt && hasKod ? `<div id="md-skor" style="margin-top:14px"></div><div id="md-kiyas" style="margin-top:10px"></div>` : ""}
    <div class="dk-det-yh" style="margin-top:16px">💰 Finansal & Alımlar</div>
    <div id="md-fin" class="sub2">Yükleniyor…</div>
    </div><div class="mk-dk-col">
    ${isMgmt && hasKod ? `
    <div class="dk-det-yh" style="margin-top:16px">🎯 Akıllı Fiyat Önerisi <span class="sub2" style="text-transform:none;letter-spacing:0">· ödediği → önerilen</span></div>
    <input class="dk-tsearch" id="md-fo-q" placeholder="Ebat ara: 385 65 22.5" style="width:100%;max-width:100%;margin-top:4px">
    <div id="md-fo-sonuc" style="margin-top:6px"></div>
    <div id="md-fo-kart" style="margin-top:10px"></div>` : ""}
    <div class="dk-det-yh" style="margin-top:16px">Ziyaret Geçmişi</div>
    <div id="md-gecmis" class="sub2">Yükleniyor…</div>
    ${isMgmt ? `<div style="margin-top:14px"><button class="dk-btn" id="md-ai">🤖 AI Özeti</button><div id="md-ai-kutu" style="display:none;margin-top:10px"></div></div>` : ""}
    <div class="dk-det-yh" style="margin-top:16px">📝 Aksiyon</div>
    <div id="md-aks-form"></div>
    <div id="md-aks" class="sub2">Yükleniyor…</div>
    <div class="dk-det-yh" style="margin-top:16px">Lokasyonlar</div>
    <div id="md-lok" class="sub2">Yükleniyor…</div>
    </div></div>
    <div class="dk-det-alt">${isMgmt ? `<button class="dk-btn" id="md-mesaj" style="border-color:#0284c7;color:#0284c7">💬 Mesaj</button>` : ""}${yol ? `<button class="dk-btn" id="md-yol">🧭 Yol Tarifi</button>` : ""}<button class="dk-btn" data-kapat>Kapat</button></div>`);  /* CONTEXT_MSG_DK2_V1 */

  if (yol) S.container.querySelector("#md-yol").addEventListener("click", () => window.open(`https://www.google.com/maps/dir/?api=1&destination=${m.lat},${m.lng}`, "_blank"));
  S.container.querySelector("#md-mesaj")?.addEventListener("click", () => musteriMesajDesktop(m));  /* CONTEXT_MSG_DK2_V1 */

  // müşteri skoru (yönetim + ERP kodu)
  if (isMgmt && hasKod) (async () => {
    const el = S.container.querySelector("#md-skor"); if (!el) return;
    el.innerHTML = `<div class="sub2">Skor hesaplanıyor…</div>`;
    try {
      const d = await api("/api/bi/musteri-skor?musteri=" + encodeURIComponent(m.musteri_kodu));
      if (d.error || d.skor == null) { el.innerHTML = `<div class="sub2" style="font-style:italic">Skor için yeterli ERP geçmişi yok.</div>`; return; }
      const gg = _skorGrade(d.skor), b = d.bilesenler || {};
      el.innerHTML = `<div class="dk-skor">
        <div class="dk-skor-num" style="color:${gg[1]}">${d.skor != null ? d.skor : "—"}<small>MÜŞTERİ SKORU</small></div>
        <div class="dk-skor-bars"><div class="dk-skor-grade" style="color:${gg[1]}">${gg[0]}</div>
          ${_skorBar("Ödeme", "%35", b.odeme, gg[1])}${_skorBar("Hacim", "%25", b.hacim, gg[1])}${_skorBar("Sadakat", "%20", b.sadakat, gg[1])}${_skorBar("Risk", "%20", b.risk, gg[1])}</div>
      </div>${d.vade_oneri ? `<div class="dk-skor-vade">💡 Vade önerisi: <b>${esc(d.vade_oneri)}</b></div>` : ""}`;
    } catch { el.innerHTML = `<div class="sub2">Skor yüklenemedi.</div>`; }
  })();

  // KRB kıyas (yönetim + ERP kodu)
  if (isMgmt && hasKod) (async () => {
    const el = S.container.querySelector("#md-kiyas"); if (!el) return;
    try {
      const d = await api("/api/bi/musteri-kiyas?musteri=" + encodeURIComponent(m.musteri_kodu));
      if (d.yok || !d.metrikler || !d.metrikler.length) { el.innerHTML = ""; return; }
      const drag = d.drag_sayisi > 0;
      el.innerHTML = `<div class="dk-kiyas ${drag ? "kotu" : "iyi"}"><div class="dk-kiyas-h">📊 ${esc(d.headline || "KRB kıyas")}</div>${d.metrikler.map(x => {
        const cls = x.durum === "kotu" ? "kotu" : x.durum === "iyi" ? "iyi" : "notr";
        const ic = x.durum === "kotu" ? "⚠" : x.durum === "iyi" ? "✓" : "·";
        return `<div class="dk-kiyas-row"><span class="dk-kiyas-ic ${cls}">${ic}</span><div><div><b>${esc(x.ad)}:</b> ${esc(x.deger)} <span class="sub2">· KRB ${esc(x.krb)}</span></div>${x.aksiyon ? `<div class="dk-kiyas-ak ${cls}">→ ${esc(x.aksiyon)}</div>` : ""}</div></div>`;
      }).join("")}</div>`;
    } catch { el.innerHTML = ""; }
  })();

  // finansal
  (async () => {
    try {
      const d = await api(`/api/saha/musteriler/${m.id}/finansal`);
      const el = S.container.querySelector("#md-fin"); if (!el) return;
      el.classList.remove("sub2"); el.innerHTML = _finHtml(d);
      _foRecent(m);
    } catch { const el = S.container.querySelector("#md-fin"); if (el) el.textContent = "Finansal yüklenemedi."; }
  })();

  // akıllı fiyat önerisi (yönetim + ERP kodu)
  if (isMgmt && hasKod) {
    const inp = S.container.querySelector("#md-fo-q");
    let _t = null;
    const run = async () => {
      const q = inp.value.trim(); const box = S.container.querySelector("#md-fo-sonuc"); if (!box) return;
      if (q.replace(/[^0-9]/g, "").length < 2) { box.innerHTML = ""; return; }
      try {
        const res = await api("/api/bi/ebat-ara?q=" + encodeURIComponent(q)); const s = res.sonuclar || [];
        box.innerHTML = s.length ? s.map(x => `<button class="dk-fo-pick" data-kalem="${esc(x.kalem_kodu || "")}" data-ad="${esc(x.ad || "")}"><span>${esc(x.ad || "")}</span><span class="sub2">${x.adet != null ? Number(x.adet).toLocaleString("tr-TR") + " ad" : ""}</span></button>`).join("") : `<div class="sub2" style="padding:6px">Sonuç yok.</div>`;
        box.querySelectorAll(".dk-fo-pick").forEach(b => b.addEventListener("click", () => { inp.value = b.dataset.ad; box.innerHTML = ""; _foKart(m, b.dataset.kalem); }));
      } catch { box.innerHTML = `<div class="sub2" style="padding:6px;color:var(--kirmizi-p)">Arama hatası.</div>`; }
    };
    inp.addEventListener("input", () => { clearTimeout(_t); _t = setTimeout(run, 220); });
  }

  // ziyaret geçmişi
  (async () => {
    try {
      const { ziyaretler = [] } = await api(`/api/saha/ziyaretler?musteri_id=${m.id}&durum=TAMAMLANDI`);
      const el = S.container.querySelector("#md-gecmis"); if (!el) return;
      if (!ziyaretler.length) { el.textContent = "Tamamlanmış ziyaret yok."; return; }
      el.classList.remove("sub2");
      el.innerHTML = ziyaretler.slice(0, 15).map(z => `<div class="dk-gecmis" data-zid="${esc(z.id)}">
        <div><b>${z.ziyaret_tarihi ? new Date(z.ziyaret_tarihi).toLocaleDateString("tr-TR", { timeZone: "Europe/Istanbul" }) : "—"}</b> <span class="sub2">· ${esc(z.rep_full_name || z.rep_adi || "")}${Number(z.foto_sayisi) ? " · 📷" + z.foto_sayisi : ""}</span></div>
        ${z.notlar ? `<div class="sub2">${esc(z.notlar.slice(0, 140))}${z.notlar.length > 140 ? "…" : ""}</div>` : ""}</div>`).join("")
        + (ziyaretler.length > 15 ? `<div class="sub2" style="margin-top:6px">+ ${ziyaretler.length - 15} eski ziyaret (Ziyaretler sekmesinde)</div>` : "");
      el.querySelectorAll("[data-zid]").forEach(g => g.addEventListener("click", () => {
        S.ziyaretler = ziyaretler;
        const z = ziyaretler.find(x => String(x.id) === g.dataset.zid); if (z) ziyaretDetay(z);
      }));
    } catch { const el = S.container.querySelector("#md-gecmis"); if (el) el.textContent = "Geçmiş yüklenemedi."; }
  })();

  // AI özeti (yönetim, talep üzerine)
  if (isMgmt) {
    const btn = S.container.querySelector("#md-ai"), kutu = S.container.querySelector("#md-ai-kutu");
    btn.addEventListener("click", async () => {
      if (kutu.style.display !== "none") { kutu.style.display = "none"; btn.textContent = "🤖 AI Özeti"; return; }
      btn.textContent = "⏳ Analiz ediliyor…"; btn.disabled = true; kutu.style.display = "block";
      kutu.innerHTML = `<div class="sub2">Ziyaret notları ve teklif geçmişi analiz ediliyor…</div>`;
      try {
        const { json, not_sayisi, teklif_sayisi, tarih_araligi, trend } = await api(`/api/saha/ai/musteri-ozeti/${m.id}`);
        if (json) {
          const tc = trend === "artıyor" ? "var(--yesil-p)" : trend === "azalıyor" ? "var(--kirmizi-p)" : "var(--tx-2)";
          const ti = trend === "artıyor" ? "↑" : trend === "azalıyor" ? "↓" : "→";
          kutu.innerHTML = `<div class="dk-ai">
            <div class="dk-ai-meta">${not_sayisi ? `<span>📊 ${not_sayisi} not</span>` : ""}${teklif_sayisi ? `<span>💼 ${teklif_sayisi} teklif</span>` : ""}${tarih_araligi ? `<span>📅 ${esc(tarih_araligi)}</span>` : ""}${trend ? `<span style="color:${tc}">${ti} Ziyaret ${esc(trend)}</span>` : ""}</div>
            <div class="dk-ai-genel">${esc(json.genel_durum || "")}</div>
            ${json.one_cikan_konular && json.one_cikan_konular.length ? `<div class="dk-ai-blok"><div class="dk-ai-bh">Öne Çıkan Konular</div>${json.one_cikan_konular.map(k => `<div class="sub2">• ${esc(k)}</div>`).join("")}</div>` : ""}
            ${json.risk ? `<div class="dk-ai-card crit"><b>⚠ RİSK</b><div>${esc(json.risk)}</div></div>` : ""}
            ${json.firsat ? `<div class="dk-ai-card ok"><b>✨ FIRSAT</b><div>${esc(json.firsat)}</div></div>` : ""}
            ${json.aksiyon ? `<div class="dk-ai-card info"><b>→ ÖNERİLEN AKSİYON</b><div>${esc(json.aksiyon)}</div></div>` : ""}
          </div>`;
        } else { kutu.innerHTML = `<div class="sub2">Özet üretilemedi.</div>`; }
      } catch (e) { kutu.innerHTML = `<div class="sub2">AI özeti yüklenemedi: ${esc(e.message)}</div>`; }
      finally { btn.textContent = "🤖 AI Özeti"; btn.disabled = false; }
    });
  }

  // lokasyonlar
  (async () => {
    const el = S.container.querySelector("#md-lok"); if (!el) return;
    try {
      const { lokasyonlar = [] } = await api(`/api/saha/musteriler/${m.id}/lokasyonlar`);
      el.classList.remove("sub2");
      el.innerHTML = lokasyonlar.length ? lokasyonlar.map(l => `<span class="dk-lok">📍 ${esc(l.ad)}${l.il ? " · " + esc([l.il, l.ilce].filter(Boolean).join("/")) : ""}${(l.lat != null && l.lng != null) ? ` <b data-lyol="${esc(l.id)}" title="Yol">🧭</b>` : ""}</span>`).join("") : `<span class="sub2">Lokasyon yok — tek adresli müşteri.</span>`;
      el.querySelectorAll("[data-lyol]").forEach(b => b.addEventListener("click", () => { const l = lokasyonlar.find(x => String(x.id) === b.dataset.lyol); if (l) window.open(`https://www.google.com/maps/dir/?api=1&destination=${l.lat},${l.lng}`, "_blank"); }));
    } catch { el.textContent = "Lokasyonlar yüklenemedi."; }
  })();

  /* MUSTERI_AKSIYON_DK_V1 — kart aksiyon (serbest not) + gecmis */
  (function(){
    const NED=[["rakip","Rakip fiyatı"],["fiyat","Fiyat"],["stok","Stok"],["tahsilat","Tahsilat"],["iliski","İlişki"],["mevsim","Mevsim"]];
    const load=async()=>{
      const el=S.container.querySelector("#md-aks"); if(!el) return;
      try{
        const d=await api(`/api/saha/musteriler/${m.id}/olaylar`);
        const AKST=["aksiyon","not","takip","rakip","firsat","risk","teklif_talep"];
        const list=(d.olaylar||[]).filter(o=>AKST.includes(o.tip)).slice(0,30);
        el.classList.remove("sub2");
        el.innerHTML=list.length?list.map(o=>`<div class="dk-gecmis"><div><b>${esc(String(o.baslik||""))}</b></div>${(o.alt||o.kim)?`<div class="sub2">${[o.alt,o.kim].filter(Boolean).map(x=>esc(String(x))).join(" · ")}</div>`:""}<div class="sub2" style="font-size:10px">${o.ts?new Date(o.ts).toLocaleDateString("tr-TR",{timeZone:"Europe/Istanbul"}):""}</div></div>`).join(""):`<span class="sub2">Henüz aksiyon yok — ilk notu yukarıdan ekle.</span>`;
      }catch{ el.textContent="Aksiyonlar yüklenemedi."; }
    };
    const fw=S.container.querySelector("#md-aks-form");
    if(fw){
      let neden="";
      fw.innerHTML=`<textarea id="md-aks-t" placeholder="Aksiyon: müşteriyle ne konuşuldu, neden yavaşlıyor, plan…" style="width:100%;box-sizing:border-box;min-height:54px;border:1px solid rgba(0,0,0,.16);border-radius:9px;padding:9px;font-size:14px;background:#fff;color:#16161A"></textarea><div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0">${NED.map(n=>`<span class="dk-ned" data-n="${n[0]}" style="border:1px solid rgba(0,0,0,.09);border-radius:999px;padding:4px 11px;font-size:12px;color:#5F5F66;cursor:pointer">${n[1]}</span>`).join("")}</div><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><label style="font-size:12px;color:#85858C"><input type="checkbox" id="md-aks-tk"> Takip: tekrar bak</label><input type="date" id="md-aks-tkd" style="display:none;border:1px solid rgba(0,0,0,.16);border-radius:8px;padding:5px 8px"><button class="dk-btn" id="md-aks-kaydet" style="margin-left:auto">Kaydet</button></div>`;
      fw.querySelectorAll(".dk-ned").forEach(b=>b.addEventListener("click",()=>{neden=(neden===b.dataset.n)?"":b.dataset.n;fw.querySelectorAll(".dk-ned").forEach(x=>{const on=x.dataset.n===neden;x.style.background=on?"#16161A":"";x.style.color=on?"#fff":"#5F5F66";x.style.borderColor=on?"#16161A":"rgba(0,0,0,.09)";});}));
      fw.querySelector("#md-aks-tk").addEventListener("change",e=>{fw.querySelector("#md-aks-tkd").style.display=e.target.checked?"inline-block":"none";});
      fw.querySelector("#md-aks-kaydet").addEventListener("click",async()=>{
        const t=(fw.querySelector("#md-aks-t").value||"").trim(); if(!t){alert("Aksiyon metni girin.");return;}
        const tk=fw.querySelector("#md-aks-tk").checked, tkd=fw.querySelector("#md-aks-tkd").value||"";
        const btn=fw.querySelector("#md-aks-kaydet"); btn.disabled=true; btn.textContent="…";
        try{ await api(`/api/saha/musteriler/${m.id}/not`,{method:"POST",body:JSON.stringify({metin:t,neden:neden||null,takip_tarihi:(tk&&tkd)?tkd:null})});
          fw.querySelector("#md-aks-t").value=""; neden=""; fw.querySelectorAll(".dk-ned").forEach(x=>{x.style.background="";x.style.color="#5F5F66";x.style.borderColor="rgba(0,0,0,.09)";}); load();
        }catch(e){alert(e.message||e);} finally{btn.disabled=false; btn.textContent="Kaydet";}
      });
    }
    load();
  })();
}
function _finHtml(d) {
  const isMgmt = ["manager", "admin"].includes(S.role);
  const f = d.finansal;
  const cell = (l, v, c) => `<div class="dk-fin-cell"><div class="k">${esc(l)}</div><div class="v" style="${c ? "color:" + c : ""}">${v}</div></div>`;
  if (!d.erp) return `<div class="sub2" style="font-style:italic">ERP'ye bağlı değil — cari/ciro verisi yok.</div>`;
  let h = "";
  if (f) {
    const vg = Number(f.vadesi_gecmis || 0);
    h += `<div class="dk-fin-grid">
      ${cell("Cari Bakiye", money(f.son_bakiye), Number(f.son_bakiye || 0) > 0 ? "var(--sari)" : "")}
      ${cell("Vadesi Geçmiş", money(f.vadesi_gecmis), vg > 0 ? "var(--kirmizi-p)" : "var(--yesil-p)")}
      ${cell("Toplam Ciro", money(f.toplam_ciro))}
      ${f.kredi_limiti != null ? cell("Kredi Limiti", money(f.kredi_limiti)) : ""}
      ${f.net_pozisyon != null ? cell("Net Pozisyon", money(f.net_pozisyon)) : ""}
      ${cell("Ödeme Koşulu", f.odeme_kosulu ? esc(f.odeme_kosulu) : "—")}
    </div>
    <div class="sub2" style="margin-top:6px">${f.fatura_sayisi || 0} fatura · ilk ${_dt(f.ilk_fatura)} · son ${_dt(f.son_fatura)}${f.satis_kanali ? " · " + esc(f.satis_kanali) : ""}</div>`;
    if (d.ciro_trend && d.ciro_trend.length) {
      const mx = Math.max(...d.ciro_trend.map(t => Number(t.ciro) || 0), 1);
      h += `<div style="margin-top:10px"><div class="dk-det-yh">Aylık Ciro (son 12 ay)</div>
        <div class="dk-spark">${d.ciro_trend.map(t => `<div title="${esc(t.ay)}: ${money(t.ciro)}" style="height:${Math.max(Math.round((Number(t.ciro) || 0) / mx * 100), 3)}%"></div>`).join("")}</div></div>`;
    }
  }
  if (d.son_alimlar && d.son_alimlar.length) {
    h += `<div class="dk-det-yh" style="margin-top:12px">Son ${d.son_alimlar.length} Alım${isMgmt ? ` <span class="sub2" style="text-transform:none;letter-spacing:0">· ödediği → önerilen</span>` : ""}</div>` + d.son_alimlar.map(a =>
      `<div class="dk-det-row"><span>${esc([a.marka, a.ebat].filter(Boolean).join(" ") || "—")} <span class="sub2">${_dt(a.fatura_tarihi)}${a.miktar != null ? " · " + Number(a.miktar).toLocaleString("tr-TR") + " ad" : ""}</span></span><span style="text-align:right;white-space:nowrap"><b>${a.birim_fiyat != null ? money(a.birim_fiyat) : "—"}</b>${isMgmt && a.kalem_kodu ? ` <span class="dk-oner" data-fo-oneri="${esc(a.kalem_kodu)}"></span>` : ""}</span></div>`).join("");
  }
  if (d.acik_teklifler && d.acik_teklifler.length) {
    h += `<div class="dk-det-yh" style="margin-top:12px">Açık Teklifler (${d.acik_teklifler.length})</div>` + d.acik_teklifler.slice(0, 8).map(t =>
      `<div class="dk-det-row"><span>${esc([t.marka, t.ebat].filter(Boolean).join(" ") || "Teklif")}${t.adet ? " ×" + t.adet : ""}</span><b>${t.toplam_tutar != null ? money(t.toplam_tutar) : ""} <span class="sub2">${esc(t.durum || "")}</span></b></div>`).join("");
  }
  if (!h) h = `<div class="sub2" style="font-style:italic">Finansal veri veya açık teklif yok.</div>`;
  return h;
}

// ── stiller ──────────────────────────────────────────────────────────────────
function injectStyles() {
  if (document.getElementById("saha-desktop-css")) return;
  const css = document.createElement("style");
  css.id = "saha-desktop-css";
  css.textContent = `
.dk-app{
  --sans:-apple-system,BlinkMacSystemFont,"Inter","Segoe UI",system-ui,sans-serif;
  --mono:ui-monospace,"SF Mono","JetBrains Mono",Menlo,monospace;
  --zemin-0:#FBFBFA;--zemin-1:#FFFFFF;--zemin-2:#F4F4F2;
  --cizgi:rgba(0,0,0,.09);--cizgi-g:rgba(0,0,0,.16);
  --tx-0:#16161A;--tx-1:#5F5F66;--tx-2:#85858C;--tx-3:#A8A8AE;
  --yan:#0E0E10;--yan-2:#161619;--yan-cizgi:rgba(255,255,255,.07);--yan-tx:#C7C7CC;--yan-tx-2:#7A7A80;
  --mavi:#2a78d6;--mavi-koyu:#1c5cab;--turuncu:#eb6834;
  --kirmizi:#C43D28;--kirmizi-p:#d03b3b;--sari:#8A5D06;--sari-p:#fab219;--yesil:#106B4A;--yesil-p:#0ca30c;
  --kirmizi-z:#FDF0ED;--sari-z:#FEF6E7;--yesil-z:#EAF7F1;--mavi-z:#EAF2FC;
  --r-md:10px;--r-lg:14px;
  position:fixed;inset:0;display:grid;grid-template-columns:250px 1fr;height:100%;
  font-family:var(--sans);background:var(--zemin-0);color:var(--tx-0);font-size:14px;-webkit-font-smoothing:antialiased;
  color-scheme:light;   /* BI kabuğu koyu tema; saha-surface'e sızmasın */
}
.dk-app,.dk-app *{color-scheme:light}
.dk-app *{box-sizing:border-box}
/* DS_TEMA_V1 — koyu-tema sızıntı önleyici (app.js html[data-tema=koyu] eleman kuralları saha içeriğine sızmasın) */
.dk-app table,.dk-app thead,.dk-app tbody,.dk-app tr,.dk-app th,.dk-app td{background-color:transparent;color:inherit}
.dk-app input:not([type=checkbox]):not([type=radio]),.dk-app select,.dk-app textarea{background-color:var(--zemin-1);color:var(--tx-0)}
.dk-app ::placeholder{color:var(--tx-3)}
.dk-app .num{font-family:var(--mono);font-variant-numeric:tabular-nums}
/* sidebar */
.dk-side{background:var(--yan);color:var(--yan-tx);display:flex;flex-direction:column;border-right:1px solid var(--yan-cizgi);min-height:0}
.dk-brand{padding:16px 18px 12px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.dk-logo{width:26px;height:26px;border-radius:7px;background:var(--mavi);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:15px}
.dk-brand b{color:#fff;font-weight:700;font-size:15px}.dk-brand small{display:block;color:var(--yan-tx-2);font-size:10.5px;margin-top:1px}
.dk-nav{flex:1;overflow-y:auto;padding:4px 10px 16px;min-height:0}
.dk-nav::-webkit-scrollbar{width:8px}.dk-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:8px}
.dk-grp{margin-top:12px}
.dk-grp-h{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--yan-tx-2);padding:6px 10px 4px;font-weight:700}
.dk-item{display:flex;align-items:center;gap:11px;width:100%;padding:8px 10px;border-radius:8px;border:0;background:none;color:var(--yan-tx);font-size:13.5px;font-weight:500;cursor:pointer;text-align:left;position:relative;transition:background .12s,color .12s}
.dk-item .ic{font-size:15px;width:20px;text-align:center;flex-shrink:0}
.dk-item .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dk-item:hover{background:rgba(255,255,255,.05);color:#fff}
.dk-item.on{background:rgba(42,120,214,.18);color:#fff}
.dk-item.on::before{content:"";position:absolute;left:0;top:7px;bottom:7px;width:3px;border-radius:0 2px 2px 0;background:var(--mavi)}
.dk-user{border-top:1px solid var(--yan-cizgi);padding:11px 14px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.dk-avatar{width:32px;height:32px;border-radius:50%;background:var(--mavi-koyu);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px;flex-shrink:0}
.dk-nm{flex:1;min-width:0}.dk-nm b{display:block;color:#fff;font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dk-nm small{color:var(--yan-tx-2);font-size:11px}
.dk-out{background:none;border:0;color:var(--yan-tx-2);font-size:15px;cursor:pointer;padding:4px}
/* main col */
.dk-col{display:flex;flex-direction:column;min-width:0;min-height:0;height:100%;overflow:hidden}
.dk-top{height:56px;flex-shrink:0;display:flex;align-items:center;gap:16px;padding:0 22px;border-bottom:1px solid var(--cizgi);background:var(--zemin-1)}
.dk-back{border:1px solid var(--cizgi);background:var(--zemin-1);border-radius:9px;padding:6px 12px;font-size:12.5px;font-weight:600;color:var(--tx-1);cursor:pointer}
.dk-back:hover{border-color:var(--cizgi-g);color:var(--tx-0)}
.dk-app h1,.dk-app h2,.dk-app h3,.dk-app h4{color:var(--tx-0)}   /* BI koyu-tema beyaz başlıkları sızmasın */
.dk-top h1{font-size:16px;font-weight:700;margin:0;white-space:nowrap;color:var(--tx-0)}
.dk-seg{display:flex;background:var(--zemin-2);border-radius:9px;padding:3px}
.dk-seg button{border:0;background:none;padding:5px 13px;border-radius:7px;font-size:12.5px;font-weight:600;color:var(--tx-1);cursor:pointer}
.dk-seg button.on{background:var(--zemin-1);color:var(--tx-0);box-shadow:0 0 0 1px var(--cizgi)}
.dk-sp{flex:1}
.dk-search{display:flex;align-items:center;gap:7px;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:9px;padding:6px 11px;width:250px}
.dk-search input{border:0;background:none;outline:none;font-size:13px;color:var(--tx-0);width:100%}
.dk-content{flex:1;min-height:0;display:flex;flex-direction:column;overflow:hidden}
#dk-main{flex:1;min-height:0;overflow-y:auto;padding:24px}
.dk-wrap{max-width:1180px;margin:0 auto}
.dk-load,.dk-empty-s{color:var(--tx-2);font-size:13px;padding:14px 0;text-align:center}
.dk-datehead{font-size:17px;font-weight:700;margin:0 0 14px;text-transform:capitalize}
/* primitives */
.dk-card{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:var(--r-lg);padding:18px 20px;box-shadow:0 1px 2px rgba(16,16,26,.03),0 6px 20px -12px rgba(16,16,26,.14)}
.dk-card-h{display:flex;align-items:center;justify-content:space-between;margin:0 0 12px}
.dk-card-h h3{margin:0;font-size:14px;font-weight:700}.dk-card-h .sub{font-size:12px;color:var(--tx-2)}
.dk-grid{display:grid;gap:16px}.dk-g4{grid-template-columns:repeat(4,1fr)}.dk-g2{grid-template-columns:1fr 1fr}
@media(max-width:1080px){.dk-g4{grid-template-columns:repeat(2,1fr)}.dk-g2{grid-template-columns:1fr}}
.dk-stat{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:var(--r-lg);padding:16px 18px;box-shadow:0 1px 2px rgba(16,16,26,.03),0 6px 20px -12px rgba(16,16,26,.13)}
.dk-stat .k{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--tx-2);font-weight:700}
.dk-stat .v{font-size:28px;font-weight:700;margin-top:6px;line-height:1.1}
.dk-stat .d{font-size:12px;margin-top:5px;color:var(--tx-2)}
.dk-delta{font-size:11.5px;font-weight:700;margin-top:5px;letter-spacing:.01em}
.dk-delta.up{color:var(--yesil-p)}.dk-delta.dn{color:var(--kirmizi-p)}.dk-delta.neu{color:var(--tx-2)}
.dk-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--cizgi)}
.dk-row:first-of-type{border-top:0}
.firm{font-weight:600}.sub2{font-size:11.5px;color:var(--tx-2)}
.pill{font-size:11px;font-weight:700;padding:2px 9px;border-radius:20px;white-space:nowrap;flex-shrink:0}
.p-crit{background:var(--kirmizi-z);color:var(--kirmizi)}.p-warn{background:var(--sari-z);color:var(--sari)}
.p-ok{background:var(--yesil-z);color:var(--yesil)}.p-info{background:var(--mavi-z);color:var(--mavi-koyu)}.p-mut{background:var(--zemin-2);color:var(--tx-2)}
.p-viol{background:#efe9ff;color:#6d4bd6}
.dk-empty{padding:52px 20px;text-align:center;color:var(--tx-2)}.dk-empty .ic{font-size:34px;opacity:.5}
.dk-empty h3{color:var(--tx-1);margin:12px 0 4px;font-size:15px}.dk-empty code{font-family:var(--mono);background:var(--zemin-2);padding:1px 5px;border-radius:5px}
.dk-t{width:100%;border-collapse:collapse;font-size:13px;background:var(--zemin-1)}
.dk-t th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--tx-2);font-weight:700;padding:9px 14px;border-bottom:1px solid var(--cizgi);white-space:nowrap;background:var(--zemin-2)}
.dk-t td{padding:11px 14px;border-bottom:1px solid var(--cizgi);vertical-align:middle;background:var(--zemin-1);color:var(--tx-0)}
.dk-t tbody tr:last-child td{border-bottom:0}
.dk-t tbody tr:hover td{background:var(--zemin-2)}
.dk-t tbody tr[data-zid],.dk-t tbody tr[data-mid]{cursor:pointer}
.dk-t td.num,.dk-t th.num{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums}
.dk-btn{border:1px solid var(--cizgi);background:var(--zemin-1);border-radius:9px;padding:8px 14px;font-size:13px;font-weight:600;color:var(--tx-1);cursor:pointer}
.dk-btn:hover{border-color:var(--cizgi-g);color:var(--tx-0)}
.dk-select{border:1px solid var(--cizgi);background:var(--zemin-1);border-radius:8px;padding:6px 10px;font-size:12.5px;color:var(--tx-0)}
.dk-tsearch{border:1px solid var(--cizgi);background:var(--zemin-2);border-radius:9px;padding:7px 12px;font-size:13px;color:var(--tx-0);width:300px;max-width:44vw;outline:none}
.dk-tsearch::placeholder{color:var(--tx-3)}
.dk-tsearch:focus{border-color:var(--cizgi-g);background:var(--zemin-1)}
.dk-note{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:var(--tx-2);background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:20px;padding:4px 12px;margin-top:14px}
/* modal */
#dk-modal .dk-fon{position:fixed;inset:0;z-index:600;background:rgba(0,0,0,.42);display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto}
#dk-modal .dk-kutu{background:var(--zemin-1);color:var(--tx-0);border:1px solid var(--cizgi-g);border-radius:16px;max-width:640px;width:100%;padding:22px 24px}
/* cari drill modal — flex satırlar: firma esner, tutar sabit sağda (taşma/kesilme YOK) */
#dk-modal .dk-kutu:has(.ilc-wrap){max-width:760px}
.ilc-meta{margin-bottom:10px}
.ilc-head{display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:var(--tx-2);text-transform:uppercase;letter-spacing:.04em;padding:0 12px 7px}
.ilc-list{max-height:62vh;overflow-y:auto;border:1px solid var(--cizgi);border-radius:10px}
.ilc-row{display:flex;align-items:center;gap:14px;padding:9px 12px;border-bottom:1px solid var(--cizgi)}
.ilc-row:last-child{border-bottom:0}
.ilc-row:hover{background:var(--zemin-2)}
.ilc-firma{flex:1;min-width:0}
.ilc-firma b{display:block;font-size:13px;font-weight:600;color:var(--tx-0);word-break:break-word;line-height:1.35}
.ilc-kod{font-size:11px;color:var(--tx-2);font-family:var(--mono)}
.ilc-tutar{flex-shrink:0;width:120px;text-align:right;font-family:var(--mono);font-weight:700;font-variant-numeric:tabular-nums;color:var(--tx-0)}
.dk-det-head{display:flex;align-items:center;gap:10px;margin:0 0 14px}
.dk-det-head h3{margin:0;font-size:17px;font-weight:700;flex:1;min-width:0}
.dk-x{border:0;background:var(--zemin-2);color:var(--tx-1);width:28px;height:28px;border-radius:8px;cursor:pointer;font-size:13px}
.dk-det-grid{display:grid;gap:0}
.dk-det-row{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid var(--cizgi);font-size:13px}
.dk-det-row span{color:var(--tx-2)}.dk-det-row b{text-align:right;font-weight:600}
.dk-det-not{margin-top:12px;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:10px;padding:12px 14px;font-size:13px;white-space:pre-wrap;line-height:1.5}
.dk-foto-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px;margin-top:12px}
.dk-foto-grid img{width:100%;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--cizgi)}
.dk-det-yorum{margin-top:16px;border-top:1px solid var(--cizgi);padding-top:14px}
.dk-det-yh{font-size:11px;font-weight:700;color:var(--tx-2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px}
.dk-yorum{margin-bottom:10px}
.dk-yorum-b{display:flex;align-items:center;gap:6px;font-size:12px;margin-bottom:3px}
.dk-yorum-t{background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:9px;padding:8px 10px;font-size:13px;white-space:pre-wrap}
.dk-yorum-yaz{display:flex;gap:8px;align-items:flex-end;margin-top:8px}
.dk-yorum-yaz textarea{flex:1;resize:none;border:1px solid var(--cizgi);border-radius:9px;padding:8px 10px;font-family:inherit;font-size:13px;color:var(--tx-0);background:var(--zemin-1)}
.dk-det-alt{margin-top:18px;display:flex;justify-content:flex-end;gap:8px}
.dk-fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
@media(max-width:540px){.dk-fin-grid{grid-template-columns:repeat(2,1fr)}}
.dk-fin-cell{background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:9px;padding:9px 11px}
.dk-fin-cell .k{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:var(--tx-2);font-weight:700}
.dk-fin-cell .v{font-size:14px;font-weight:700;margin-top:3px;font-family:var(--mono);font-variant-numeric:tabular-nums;color:var(--tx-0)}
.dk-spark{display:flex;align-items:flex-end;gap:2px;height:44px;margin-top:4px}
.dk-spark div{flex:1;min-width:4px;background:var(--mavi);border-radius:2px 2px 0 0}
.dk-gecmis{padding:8px 4px;border-bottom:1px solid var(--cizgi);cursor:pointer;border-radius:6px}
.dk-gecmis:hover{background:var(--zemin-2)}
/* skor kartı */
.dk-skor{display:flex;align-items:center;gap:16px;border:1px solid var(--cizgi);border-radius:12px;padding:12px 14px;background:var(--zemin-1)}
.dk-skor-num{flex:0 0 auto;text-align:center;font-family:var(--mono);font-size:30px;font-weight:800;line-height:1}
.dk-skor-num small{display:block;font-size:9px;color:var(--tx-2);font-weight:700;letter-spacing:.03em;margin-top:3px}
.dk-skor-bars{flex:1;min-width:0}
.dk-skor-grade{font-weight:700;font-size:13px;margin-bottom:5px}
.dk-sbar{display:grid;grid-template-columns:96px 1fr 30px;align-items:center;gap:8px;margin:3px 0}
.dk-sbar-l{font-size:11px;color:var(--tx-1)}
.dk-sbar-bg{height:7px;background:var(--zemin-2);border-radius:5px;overflow:hidden}
.dk-sbar-f{display:block;height:100%;border-radius:5px}
.dk-sbar-v{font-size:11px;text-align:right;color:var(--tx-1)}
.dk-skor-vade{font-size:11.5px;color:var(--mavi-koyu);margin-top:8px;background:var(--mavi-z);border-radius:8px;padding:7px 10px}
/* kıyas */
.dk-kiyas{border:1px solid var(--cizgi);border-radius:12px;padding:11px 13px}
.dk-kiyas.kotu{border-color:#f3c9c0;background:var(--kirmizi-z)}
.dk-kiyas.iyi{border-color:#bfe6d3;background:var(--yesil-z)}
.dk-kiyas-h{font-weight:700;font-size:12.5px;margin-bottom:6px}
.dk-kiyas-row{display:flex;gap:9px;padding:5px 0;border-top:1px solid var(--cizgi);align-items:flex-start}
.dk-kiyas-row:first-of-type{border-top:0}
.dk-kiyas-ic{font-weight:700;flex:0 0 auto}
.dk-kiyas-ic.kotu{color:var(--kirmizi-p)}.dk-kiyas-ic.iyi{color:var(--yesil-p)}.dk-kiyas-ic.notr{color:var(--tx-2)}
.dk-kiyas-ak{font-size:11px;margin-top:1px}
.dk-kiyas-ak.kotu{color:var(--kirmizi-p)}.dk-kiyas-ak.iyi{color:var(--yesil-p)}.dk-kiyas-ak.notr{color:var(--tx-2)}
/* akıllı fiyat */
.dk-fo-pick{display:flex;justify-content:space-between;gap:8px;width:100%;text-align:left;padding:9px 11px;margin-bottom:4px;border:1px solid var(--cizgi);border-radius:8px;background:var(--zemin-1);color:var(--tx-0);cursor:pointer;font-size:13px}
.dk-fo-pick:hover{border-color:var(--cizgi-g);background:var(--zemin-2)}
.dk-fo-pick span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dk-fo-kart{border:1px solid var(--cizgi);border-radius:12px;padding:13px;background:var(--zemin-1)}
.dk-fo-ad{font-weight:700;font-size:13px;margin-bottom:9px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dk-fo-pair{display:flex;gap:8px}
.dk-fo-cell{flex:1;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:9px;padding:9px 11px}
.dk-fo-cell.oner{background:var(--zemin-1);border-width:1.5px}
.dk-fo-cell .k{font-size:10px;text-transform:uppercase;letter-spacing:.02em;color:var(--tx-2);font-weight:700}
.dk-fo-cell .v{font-size:17px;font-weight:800;margin-top:3px}
.dk-vade-row{display:flex;gap:5px;margin-top:4px}
.dk-vade{flex:1;text-align:center;background:var(--zemin-2);border-radius:7px;padding:5px 3px}
.dk-fo-rakip{font-size:11.5px;color:var(--kirmizi-p);margin-top:8px;border-top:1px solid var(--cizgi);padding-top:7px}
/* AI özet */
.dk-ai{background:#f7f4ff;border:1px solid #e4dbff;border-radius:12px;padding:12px 14px}
.dk-ai-meta{display:flex;gap:10px;flex-wrap:wrap;font-size:11px;color:#6d4bd6;font-weight:600;margin-bottom:9px}
.dk-ai-genel{font-size:13px;color:var(--tx-0);line-height:1.6;margin-bottom:10px}
.dk-ai-blok{margin-bottom:10px}
.dk-ai-bh{font-size:10px;font-weight:700;color:var(--tx-1);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.dk-ai-card{border-radius:8px;padding:9px 11px;margin-bottom:8px;font-size:12px;line-height:1.5}
.dk-ai-card b{display:block;font-size:10px;margin-bottom:3px}
.dk-ai-card.crit{background:var(--kirmizi-z);border:1px solid #f3c9c0}.dk-ai-card.crit b{color:var(--kirmizi-p)}
.dk-ai-card.ok{background:var(--yesil-z);border:1px solid #bfe6d3}.dk-ai-card.ok b{color:var(--yesil-p)}
.dk-ai-card.info{background:var(--mavi-z);border:1px solid #cfe0f7}.dk-ai-card.info b{color:var(--mavi-koyu)}
/* lokasyon */
.dk-lok{display:inline-flex;align-items:center;gap:6px;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:20px;padding:4px 11px;margin:0 6px 6px 0;font-size:12px}
.dk-lok b{cursor:pointer}
/* rep-brain sohbet */
.dk-chat{display:flex;flex-direction:column;height:100%;background:var(--zemin-0)}
.dk-chat-head{display:flex;align-items:center;gap:10px;padding:12px 20px;border-bottom:1px solid var(--cizgi);background:var(--zemin-1);flex-shrink:0}
.dk-chat-banner{display:flex;align-items:center;gap:10px;margin:12px 20px 0;padding:9px 12px;background:var(--sari-z);border:1px solid #f0d9a8;border-radius:10px;font-size:12.5px;color:var(--sari);flex-shrink:0}
.dk-chat-banner span{flex:1}
.dk-chat-msgs{flex:1;min-height:0;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:10px}
.dk-msg{max-width:74%;padding:10px 14px;border-radius:14px;font-size:13.5px;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.dk-msg.me{align-self:flex-end;background:var(--mavi);color:#fff;border-bottom-right-radius:4px}
.dk-msg.ai{align-self:flex-start;background:var(--zemin-1);color:var(--tx-0);border:1px solid var(--cizgi);border-bottom-left-radius:4px}
.dk-msg.think{color:var(--tx-2)}
.dk-msg.yayim{background:var(--sari-z);border:1px solid #f0d9a8;color:var(--sari)}
.dk-mrow{display:flex;flex-direction:column;gap:2px;margin-bottom:8px;align-items:flex-start}
.dk-mrow.me{align-items:flex-end}
.dk-chat-chips{display:flex;gap:8px;overflow-x:auto;padding:9px 20px;border-top:1px solid var(--cizgi);background:var(--zemin-1);flex-shrink:0}
.dk-chat-chips::-webkit-scrollbar{display:none}
.dk-chip{white-space:nowrap;padding:6px 13px;border:1px solid var(--cizgi);border-radius:20px;background:var(--zemin-1);font-size:12px;font-weight:600;color:var(--tx-1);cursor:pointer;flex-shrink:0}
.dk-chip:hover{border-color:var(--mavi);color:var(--mavi-koyu)}
.dk-chat-input{display:flex;gap:8px;align-items:flex-end;padding:12px 20px;border-top:1px solid var(--cizgi);background:var(--zemin-1);flex-shrink:0}
.dk-chat-input textarea{flex:1;resize:none;border:1px solid var(--cizgi);border-radius:10px;padding:10px 12px;font-family:inherit;font-size:14px;color:var(--tx-0);background:var(--zemin-1);max-height:140px}
/* rakip radar */
.dk-seg2{display:inline-flex;gap:6px;flex-wrap:wrap}
.dk-seg2 button{padding:7px 14px;border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);border-radius:9px;font-size:13px;font-weight:600;cursor:pointer}
.dk-seg2 button.on{background:var(--mavi);color:#fff;border-color:var(--mavi)}
.dk-rk-form{display:flex;gap:8px;flex-wrap:wrap}
.dk-rk-form input,.dk-rk-form select{border:1px solid var(--cizgi);border-radius:9px;padding:9px 12px;font-size:14px;color:var(--tx-0);background:var(--zemin-1)}
.dk-rk-form input{flex:1;min-width:170px}.dk-rk-form select{min-width:160px}
.dk-rk-card{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:12px;padding:12px 14px;margin-bottom:10px}
.dk-collapse-h{display:flex;align-items:center;justify-content:space-between;width:100%;padding:15px 18px;border:0;background:none;cursor:pointer;font-size:14px;font-weight:700;color:var(--tx-0)}
.dk-collapse-h:hover{background:var(--zemin-2)}
.dk-chev{color:var(--tx-2);font-size:13px;transition:transform .15s}
/* plan / takvim */
.dk-plan-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:16px;align-items:start}
@media(max-width:980px){.dk-plan-grid{grid-template-columns:1fr}}
.dk-cal-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.dk-cal-h b{font-size:14px;font-weight:700;text-transform:capitalize}
.dk-cal-nav{border:1px solid var(--cizgi);background:var(--zemin-1);border-radius:8px;width:30px;height:30px;cursor:pointer;color:var(--tx-1);font-size:16px;line-height:1}
.dk-cal-nav:hover{border-color:var(--cizgi-g);color:var(--tx-0)}
.dk-cal-wd{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:5px}
.dk-cal-wd div{text-align:center;font-size:10px;font-weight:700;color:var(--tx-2);text-transform:uppercase;letter-spacing:.03em}
.dk-cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.dk-cal-d{min-height:56px;border:1px solid var(--cizgi);border-radius:9px;padding:6px;display:flex;flex-direction:column;gap:3px;cursor:pointer;background:var(--zemin-1)}
.dk-cal-d.bos{border:0;background:none;cursor:default}
.dk-cal-d:not(.bos):hover{border-color:var(--cizgi-g)}
.dk-cal-d.secili{border-color:var(--mavi);box-shadow:inset 0 0 0 1px var(--mavi)}
.dk-cal-d.gecmis{opacity:.5}
.dk-cal-n{font-size:12px;font-weight:600;font-family:var(--mono);color:var(--tx-1)}
.dk-cal-d.bugun .dk-cal-n{color:var(--mavi);font-weight:800}
.dk-cal-badges{display:flex;gap:3px;flex-wrap:wrap;margin-top:auto}
.dk-cal-b{font-size:10px;font-weight:700;color:#fff;background:var(--mavi);border-radius:6px;padding:0 5px;line-height:1.7}
.dk-cal-b.hat{background:#7c5cff}
.dk-pl{border:1px solid var(--cizgi);border-radius:10px;padding:11px 13px;margin-bottom:8px}
.dk-pl.hat{border-left:3px solid #7c5cff}
.dk-pl.gecmis{opacity:.6}
.dk-pl-top{display:flex;align-items:center;gap:8px}
.dk-pl-actions{display:flex;gap:6px;margin-top:9px}
.dk-pl-sec{font-size:10.5px;font-weight:700;color:#7c5cff;text-transform:uppercase;letter-spacing:.05em;margin:14px 0 8px}
.dk-btn-sm{padding:5px 11px;font-size:12px}
.dk-btn-red{border-color:#f0c8c0;color:var(--kirmizi-p)}
.dk-btn-red:hover{border-color:var(--kirmizi-p);background:var(--kirmizi-z)}
/* teklif & iskonto */
.dk-esik{background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:10px;padding:10px 14px;font-size:12.5px;color:var(--tx-1)}
.dk-kalem th,.dk-kalem td{padding:8px 10px;font-size:12px}
.dk-log{font-size:12px;border-left:2px solid var(--cizgi);padding:4px 10px;margin-bottom:5px;color:var(--tx-1);overflow:hidden}
.dk-form2{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px;margin-bottom:10px}
.dk-form2 label,.dk-form-full{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--tx-1);font-weight:600}
.dk-form2 input,.dk-form2 select,.dk-form-full input,.dk-form-full select,.dk-form-full textarea{border:1px solid var(--cizgi);border-radius:8px;padding:8px 10px;font-family:inherit;font-size:13px;color:var(--tx-0);background:var(--zemin-1);font-weight:400}
.dk-ac{border:1px solid var(--cizgi);background:var(--zemin-2);color:var(--tx-1);padding:4px 10px;border-radius:8px;cursor:pointer;font-size:11.5px;font-weight:600;white-space:nowrap}
.dk-ac:hover{border-color:var(--cizgi-g);color:var(--tx-0)}
.dk-aciklama{background:var(--mavi-z);border:1px solid #cfe0f7;border-radius:10px;padding:11px 13px;font-size:12.5px;line-height:1.55;color:var(--tx-1);margin-bottom:10px}
.dk-erpden{color:var(--yesil-p);font-size:10px;font-weight:700;margin-left:4px}
.dk-form-full{margin-bottom:10px}
.dk-ara-sonuc{position:absolute;z-index:50;background:var(--zemin-1);border:1px solid var(--cizgi-g);border-radius:8px;max-height:240px;overflow-y:auto;width:100%;top:calc(100% + 2px)}
.dk-ara-item{padding:9px 12px;cursor:pointer;border-bottom:1px solid var(--cizgi);font-size:13px}
.dk-ara-item:last-child{border-bottom:0}
.dk-ara-item:hover{background:var(--zemin-2)}
.dk-ro{padding:8px 10px;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:8px;font-size:13px;min-height:36px;display:flex;align-items:center;color:var(--tx-0)}
/* notlarım */
.dk-not{display:flex;align-items:flex-start;gap:11px;padding:11px 4px;border-bottom:1px solid var(--cizgi);cursor:pointer;border-radius:6px}
.dk-not:hover{background:var(--zemin-2)}
.dk-not.done{opacity:.55}
.dk-not-chk{flex-shrink:0;background:none;border:2px solid var(--cizgi-g);border-radius:50%;width:22px;height:22px;cursor:pointer;color:transparent;font-size:12px;padding:0;margin-top:1px;display:flex;align-items:center;justify-content:center}
.dk-not-chk.on{border-color:var(--yesil-p);color:var(--yesil-p)}
.dk-not-body{flex:1;min-width:0}
.dk-not-txt{font-size:14px;line-height:1.45}
.dk-not.done .dk-not-txt{text-decoration:line-through;color:var(--tx-2)}
.dk-not-meta{display:flex;gap:10px;align-items:center;margin-top:5px;flex-wrap:wrap}
.dk-not-mus{color:var(--yesil);font-weight:600;font-size:12px}
.dk-not-sil{flex-shrink:0;background:none;border:0;color:var(--tx-3);font-size:15px;cursor:pointer;padding:2px}
.dk-not-sil:hover{color:var(--kirmizi-p)}
/* rapor */
.rp-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:12px 16px}
.rp-presets{display:flex;gap:6px}
.rp-preset{padding:6px 13px;border:1px solid var(--cizgi);background:var(--zemin-1);color:var(--tx-1);border-radius:8px;font-size:12.5px;font-weight:600;cursor:pointer}
.rp-preset:hover{border-color:var(--mavi);color:var(--mavi-koyu)}
.rp-preset.on{background:var(--mavi);color:#fff;border-color:var(--mavi)}
.rp-range{display:flex;align-items:center;gap:8px}
.rp-date{border:1px solid var(--cizgi-g);border-radius:8px;padding:6px 10px;font-size:13px;font-family:var(--sans);color:var(--tx-0);background:var(--zemin-1)}
.rp-arrow{color:var(--tx-3);font-size:13px}
.dk-icobtn{border:1px solid var(--cizgi-g);background:var(--zemin-1);border-radius:8px;width:32px;height:32px;font-size:17px;line-height:1;color:var(--tx-1);cursor:pointer;flex-shrink:0}
.dk-icobtn:hover{border-color:var(--mavi);color:var(--mavi-koyu)}
.dk-sech{font-size:11px;font-weight:800;color:var(--tx-1);margin:22px 0 11px;padding-left:11px;border-left:3px solid var(--mavi);text-transform:uppercase;letter-spacing:.06em;display:flex;align-items:center;gap:7px}
.dk-sech:first-child{margin-top:4px}
.dk-i{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:var(--zemin-2);color:var(--tx-2);font-size:10px;font-weight:700;cursor:help;text-transform:none;letter-spacing:0;border:1px solid var(--cizgi)}
.dk-kpis{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(158px,1fr))}
.dk-stat.tik{cursor:pointer;transition:border-color .12s,transform .06s}
.dk-stat.tik:hover{border-color:var(--mavi);transform:translateY(-1px)}
.dk-stat.tik:active{transform:translateY(0)}
.dk-ciro-banner{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--yesil-z);border:1px solid #bfe6d4;border-radius:var(--r-md);padding:12px 18px;margin-top:12px}
.dk-ciro-banner span{font-size:12px;font-weight:700;color:var(--yesil);text-transform:uppercase;letter-spacing:.04em}
.dk-ciro-banner b{font-size:19px;color:var(--yesil);font-family:var(--mono)}
.dk-ciro-2{display:flex;gap:12px;margin-top:12px;flex-wrap:wrap}
.dk-ciro-cell{flex:1;min-width:180px;border-radius:var(--r-md);padding:11px 16px;display:flex;flex-direction:column;gap:2px;cursor:pointer}
.dk-ciro-cell span{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.dk-ciro-cell b{font-size:17px;font-family:var(--mono)}
.dk-ciro-cell.ok{background:var(--yesil-z);border:1px solid #bfe6d4}.dk-ciro-cell.ok span,.dk-ciro-cell.ok b{color:var(--yesil)}
.dk-ciro-cell.bad{background:var(--kirmizi-z);border:1px solid #f0ccc4}.dk-ciro-cell.bad span,.dk-ciro-cell.bad b{color:var(--kirmizi)}
.dk-barrow{display:flex;align-items:center;gap:9px}
.dk-bar{flex:1;max-width:120px;min-width:44px;height:7px;background:var(--zemin-2);border-radius:5px;overflow:hidden}
.dk-bar i{display:block;height:100%;border-radius:5px;min-width:2px}
.dk-neden{display:flex;gap:8px;flex-wrap:wrap}
.dk-neden-p{background:var(--sari-z);border:1px solid #f0dca8;border-radius:8px;padding:7px 12px;font-size:12.5px;color:var(--sari)}
.dk-neden-p b{color:var(--tx-0)}
.dk-taglar{display:flex;gap:6px;flex-wrap:wrap}
.dk-tag{background:var(--zemin-2);border-radius:7px;padding:3px 9px;font-size:12px;color:var(--tx-1)}.dk-tag b{color:var(--tx-0)}
.dk-pager{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:12px}
/* harita */
.dk-btn-mor{background:linear-gradient(180deg,#7b57e0,#6d4bd6);border-color:#6d4bd6;color:#fff;box-shadow:0 4px 14px -5px rgba(109,75,214,.7)}.dk-btn-mor:hover{filter:brightness(1.06)}
/* harita drawer + tiles */
.hr-stage{position:relative}
.hr-drawer{position:absolute;top:12px;right:12px;bottom:12px;width:344px;max-width:calc(100% - 24px);background:rgba(255,255,255,.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--cizgi);border-radius:14px;box-shadow:0 16px 48px -12px rgba(16,16,26,.34);display:flex;flex-direction:column;overflow:hidden;z-index:1100}
.hr-dact{display:flex;gap:8px;margin-top:12px}.hr-dact .dk-btn{flex:1}
.hr-neden{border-radius:10px;padding:10px 12px;margin-bottom:12px;border:1px solid}
.hr-neden.riskli{background:var(--kirmizi-z);border-color:#f0ccc4}
.hr-neden.pasif{background:var(--sari-z);border-color:#f0dca8}
.hr-neden-b{font-size:12.5px;font-weight:700}
.hr-neden.riskli .hr-neden-b{color:var(--kirmizi)}.hr-neden.pasif .hr-neden-b{color:var(--sari)}
.hr-neden-t{font-size:12px;color:var(--tx-0);margin-top:3px;font-weight:600}
.hr-neden-s{font-size:10.5px;color:var(--tx-2);margin-top:5px}
.hr-brief{font-size:12.5px;line-height:1.55;color:var(--tx-0);background:#faf7ff;border:1px solid #e6dcfa;border-radius:10px;padding:11px 13px}
.hr-brief-a{margin-top:8px;display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--tx-1)}
.hr-cust[data-mid]{cursor:pointer;border-radius:8px;margin:0 -6px;padding-left:6px;padding-right:6px}
.hr-cust[data-mid]:hover{background:var(--zemin-2)}
.hr-dh{padding:15px 18px 13px;border-bottom:1px solid var(--cizgi);background:linear-gradient(180deg,var(--mavi-z),transparent);position:relative}
.hr-dx{position:absolute;top:11px;right:13px;background:none;border:0;font-size:15px;line-height:1;color:var(--tx-2);cursor:pointer}
.hr-ey{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--mavi-koyu);font-weight:700}
.hr-dh h2{font-size:22px;font-weight:700;letter-spacing:-.02em;margin:3px 0 0;color:var(--tx-0)}
.hr-dsub{font-size:12px;color:var(--tx-1);margin-top:5px}
.hr-db{flex:1;overflow-y:auto;padding:14px 16px 18px}
.hr-db::-webkit-scrollbar{width:8px}.hr-db::-webkit-scrollbar-thumb{background:var(--cizgi-g);border-radius:8px}
.hr-tiles{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.hr-tile{background:var(--zemin-1);border:1px solid var(--cizgi);border-radius:10px;padding:11px 12px}
.hr-tile .l{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--tx-2);font-weight:700}
.hr-tile .v{font-size:18px;font-weight:700;margin-top:3px;color:var(--tx-0);font-variant-numeric:tabular-nums;line-height:1.15}
.hr-tile .d{font-size:11px;margin-top:2px;font-weight:600}
.hr-tile .d.up{color:var(--yesil-p)}.hr-tile .d.dn{color:var(--kirmizi-p)}.hr-tile .d.neu{color:var(--tx-2)}
.hr-tbar{height:6px;border-radius:4px;background:var(--zemin-2);margin-top:8px;overflow:hidden}.hr-tbar i{display:block;height:100%;border-radius:4px}
.hr-tile.hr-drill{cursor:pointer;transition:border-color .12s,transform .06s}
.hr-tile.hr-drill:hover{border-color:var(--mavi);transform:translateY(-1px)}
.hr-tile.hr-drill .d{font-size:10.5px;font-weight:700}
.hr-dsec{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--tx-2);font-weight:700;margin:18px 0 10px}
.hr-cust{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--cizgi)}
.hr-cust:last-child{border:0}
.hr-cav{width:30px;height:30px;border-radius:9px;background:var(--zemin-2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--tx-1);flex-shrink:0}
.hr-cnm{flex:1;min-width:0}.hr-cnm b{font-size:12.5px;font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hr-cnm span{font-size:11px;color:var(--tx-2)}
.chipmini{font-size:9.5px;font-weight:700;padding:2px 6px;border-radius:5px;flex-shrink:0}
.c-tic{background:var(--sari-z);color:var(--sari)}.c-tuk{background:var(--mavi-z);color:var(--mavi-koyu)}
@media(max-width:820px){.hr-drawer{position:static;width:auto;margin-top:12px;bottom:auto;max-height:none;backdrop-filter:none}}
.hr-legend{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:10px;font-size:11.5px;color:var(--tx-1)}
.hr-legend span{display:inline-flex;align-items:center;gap:6px}
.hr-legend i{width:11px;height:11px;border-radius:50%;box-shadow:0 0 0 1px var(--cizgi-g)}
.hr-legend i.puls{animation:hrPulseDot 1.1s ease-in-out infinite}
@keyframes hrPulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.35)}}
/* harita pin'i Leaflet'in kendi transform'uyla konumlanır — SADECE opacity animasyonu, transform YOK (yoksa marker sıçrar) */
@keyframes hrPulseFade{0%,100%{opacity:.95}50%{opacity:.2}}
.hr-ctrls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.hr-sel{flex:1;min-width:220px}
.hr-choro-legend{font-size:11.5px;color:var(--tx-1);margin:0 0 8px;padding:6px 10px;background:var(--zemin-2);border:1px solid var(--cizgi);border-radius:8px}
.hr-ramp{display:inline-block;width:72px;height:9px;vertical-align:middle;background:linear-gradient(90deg,rgb(186,205,240),rgb(13,48,112));border-radius:2px}
.hr-map{position:relative;height:520px;background:#eef2f7;border:1px solid var(--cizgi);border-radius:10px;overflow:hidden}
.hr-map.hr-tam{position:fixed;inset:0;height:auto;z-index:2000;border-radius:0}
.hr-map .leaflet-container{height:100%;width:100%;background:#eef2f7;font-family:var(--sans)}
/* OSM tile'larını sade açık gri tabana çevir (Positron benzeri) — pinler öne çıksın */
.hr-map .leaflet-tile-pane{filter:grayscale(.92) contrast(.9) brightness(1.07)}
/* renklendirme açıkken taban daha nötr/koyu — mavi iller net öne çıksın, "sisli" görünüm gitsin */
.hr-map.hr-choro-on .leaflet-tile-pane{filter:grayscale(1) contrast(.82) brightness(.99)}
.hr-pin-sorunlu{animation:hrPulseFade 1.1s ease-in-out infinite}
.hr-sehir{position:relative;margin-top:12px;background:var(--mavi-z);border:1px solid #bcd6f5;border-radius:10px;padding:14px 16px}
.hr-sehir-x{position:absolute;top:8px;right:11px;background:none;border:0;font-size:16px;line-height:1;color:var(--tx-2);cursor:pointer}
.hr-sehir-bas{font-size:14px;font-weight:700;color:var(--mavi-koyu);margin-bottom:8px}
.hr-kv{display:grid;grid-template-columns:auto 1fr;gap:3px 14px;font-size:12.5px;color:var(--tx-1)}
.hr-kv b{text-align:right;color:var(--tx-0)}
.hr-mus-op{padding:6px 9px;cursor:pointer;border-radius:7px;margin:2px 0;background:var(--zemin-2)}
.hr-mus-op:hover{background:var(--mavi-z)}
.hr-tt{position:fixed;display:none;background:rgba(17,24,39,.9);color:#fff;font-size:11px;font-weight:600;padding:5px 10px;border-radius:7px;pointer-events:none;z-index:9999;white-space:nowrap}
/* saha sesi sonuç */
.ss-box{background:#faf7ff;border:1px solid #e6dcfa;border-radius:12px;padding:16px}
.ss-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:6px}
.ss-meta{font-size:11.5px;color:#6d4bd6;font-weight:700}
.ss-cmp{font-size:10.5px;color:#8a6fd8;font-weight:600}
.ss-ozet{font-size:14.5px;font-weight:700;color:#1e1b4b;line-height:1.4;font-style:italic;border-bottom:1px solid #e6dcfa;padding-bottom:10px;margin-bottom:12px}
.ss-nabiz{font-size:13px;color:var(--tx-0);line-height:1.65;margin-bottom:14px}
.ss-sec-h{font-size:11px;font-weight:800;color:var(--tx-1);margin:0 0 8px;text-transform:uppercase;letter-spacing:.04em}
.ss-krit{display:flex;gap:9px;align-items:flex-start;margin-bottom:9px}
.ss-sik{font-size:10px;font-weight:700;padding:2px 7px;border:1px solid;border-radius:11px;white-space:nowrap;margin-top:1px;flex-shrink:0}
.ss-krit-t{font-size:12.5px;font-weight:600;color:var(--tx-0)}
.ss-krit-d{font-size:12.5px;color:var(--tx-1);margin-top:1px}
.ss-tag{font-size:10px;padding:1px 6px;border-radius:8px;margin-left:5px}
.ss-tag.mor{background:#ede9fe;color:#6d28d9}.ss-tag.mavi{background:var(--mavi-z);color:var(--mavi-koyu)}
.ss-blk{border:1px solid;border-radius:10px;padding:12px;margin-bottom:12px}
.ss-blk-h{font-size:11px;font-weight:800;margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em}
.ss-item{font-size:12.5px;color:var(--tx-1);margin-bottom:6px;line-height:1.5}.ss-item b{color:var(--tx-0)}
.ss-aksiyon{font-size:13px;color:var(--mavi-koyu);margin-bottom:5px;font-weight:500}
`;
  document.head.appendChild(css);
}
