  `;

  // Tab switcher
  window.rfTab = function(tab) {
    ['piyasa','izleme','alarmlar'].forEach(t => {
      const pane = document.getElementById('rf-pane-' + t);
      const btn  = document.getElementById('rf-tab-'  + t);
      if (!pane || !btn) return;
      const active = t === tab;
      pane.style.display = active ? 'block' : 'none';
      btn.style.borderBottomColor = active ? '#3182ce' : 'transparent';
      btn.style.color = active ? '#3182ce' : '#888';
    });
    if (tab === 'izleme')  rfYukleIzle();
    if (tab === 'alarmlar') rfYukleAlarm();
  };

  // Load özet (badge)
  rfYukleOzet();

  // ── Piyasa Tab ──────────────────────────────────────────────────────────────
  window.rfPiyasaAra = async function() {
    const marka = document.getElementById('rf-marka').value.trim();
    const ebat  = document.getElementById('rf-ebat').value.trim();
    if (!marka && !ebat) return alert('Lütfen marka veya ebat girin.');
    const res  = document.getElementById('rf-piyasa-result');
    res.innerHTML = '<div style="color:#888;padding:20px">Yükleniyor...</div>';
    const qs = new URLSearchParams();
    if (marka) qs.set('marka', marka);
    if (ebat)  qs.set('ebat', ebat);
    qs.set('limit', '300');
    try {
      const data = await callApi('/api/rakip/piyasa?' + qs.toString());
      if (!data.rows?.length) {
        res.innerHTML = '<div style="color:#888;padding:20px">Sonuç bulunamadı.</div>';
        return;
      }
      // Group by marka+ebat
      const groups = {};
      const kaynakSet = new Set();
      for (const r of data.rows) {
        const key = r.marka + ' | ' + r.ebat;
        if (!groups[key]) groups[key] = { marka: r.marka, ebat: r.ebat, fiyatlar: {}, demand: {} };
        groups[key].fiyatlar[r.kaynak] = parseFloat(r.fiyat);
        kaynakSet.add(r.kaynak);
        if (r.satici_sayisi) groups[key].demand.satici_sayisi = r.satici_sayisi;
        if (r.yorum_sayisi)  groups[key].demand.yorum_sayisi  = r.yorum_sayisi;
        if (r.puan)          groups[key].demand.puan          = r.puan;
      }
      const kaynaklar = [...kaynakSet].sort();
      const rows = Object.values(groups);
      rows.sort((a,b) => (a.marka + a.ebat).localeCompare(b.marka + b.ebat));

      let html = `<div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
          <thead>
            <tr style="background:#f7fafc;font-weight:600;text-align:left">
              <th style="padding:10px 12px;border-bottom:2px solid #e2e8f0">Marka</th>
              <th style="padding:10px 12px;border-bottom:2px solid #e2e8f0">Ebat</th>
              ${kaynaklar.map(k => `<th style="padding:10px 12px;border-bottom:2px solid #e2e8f0;text-align:right">${k}</th>`).join('')}
              <th style="padding:10px 12px;border-bottom:2px solid #e2e8f0;text-align:right">Min</th>
              <th style="padding:10px 12px;border-bottom:2px solid #e2e8f0">Talep</th>
              <th style="padding:10px 12px;border-bottom:2px solid #e2e8f0"></th>
            </tr>
          </thead><tbody>`;

      for (const g of rows) {
        const prices = Object.values(g.fiyatlar).filter(Boolean);
        const min = prices.length ? Math.min(...prices) : null;
        const demand = [];
        if (g.demand.satici_sayisi) demand.push(`🏪${g.demand.satici_sayisi}`);
        if (g.demand.yorum_sayisi)  demand.push(`🛒${g.demand.yorum_sayisi}`);
        if (g.demand.puan)          demand.push(`⭐${g.demand.puan}`);
        const key = encodeURIComponent(g.marka) + '|' + encodeURIComponent(g.ebat);
        html += `<tr style="border-bottom:1px solid #f0f4f8;transition:background .15s" onmouseover="this.style.background='#f7fafc'" onmouseout="this.style.background=''">
          <td style="padding:9px 12px;font-weight:600">${g.marka}</td>
          <td style="padding:9px 12px;color:#555">${g.ebat}</td>
          ${kaynaklar.map(k => {
            const f = g.fiyatlar[k];
            const isMin = f && f === min;
            return `<td style="padding:9px 12px;text-align:right;${isMin ? 'color:#38a169;font-weight:700' : 'color:#4a5568'}">
              ${f ? f.toLocaleString('tr-TR', {minimumFractionDigits:0}) + ' ₺' : '<span style="color:#ccc">—</span>'}
            </td>`;
          }).join('')}
          <td style="padding:9px 12px;text-align:right;font-weight:700;color:#2d3748">
            ${min ? min.toLocaleString('tr-TR', {minimumFractionDigits:0}) + ' ₺' : '—'}
          </td>
          <td style="padding:9px 12px;font-size:12px;color:#718096">${demand.join(' ')}</td>
          <td style="padding:9px 12px">
            <button onclick="rfHizliIzleEkle('${g.marka}','${g.ebat}')"
              title="İzlemeye ekle"
              style="padding:3px 8px;background:#ebf8ff;color:#2b6cb0;border:1px solid #bee3f8;
                     border-radius:4px;font-size:11px;cursor:pointer">⭐</button>
          </td>
        </tr>`;
      }
      html += '</tbody></table></div>';
      html += `<div style="margin-top:10px;font-size:12px;color:#999;text-align:right">${rows.length} SKU, ${data.rows.length} fiyat kaydı</div>`;
      res.innerHTML = html;
    } catch(e) {
      res.innerHTML = `<div style="color:#e53e3e;padding:20px">Hata: ${e.message}</div>`;
    }
  };

  window.rfPiyasaIzleEkle = function() {
    const m = document.getElementById('rf-marka').value.trim();
    const e = document.getElementById('rf-ebat').value.trim();
    if (!m || !e) { alert('Marka ve ebat giriniz.'); return; }
    rfTab('izleme');
    setTimeout(() => {
      document.getElementById('rf-yeni-marka').value = m;
      document.getElementById('rf-yeni-ebat').value  = e;
    }, 100);
  };

  window.rfHizliIzleEkle = async function(marka, ebat) {
    try {
      const data = await callApi('/api/rakip/izle', 'POST', { marka, ebat, gunluk_cekim: 3 });
      if (data.error) { alert(data.error); return; }
      alert(`"${marka} ${ebat}" izlemeye eklendi (VIP 3x/gün).`);
      rfYukleOzet();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  // ── İzleme Tab ──────────────────────────────────────────────────────────────
  async function rfYukleIzle() {
    const cont = document.getElementById('rf-izle-table');
    const info = document.getElementById('rf-izle-limit-info');
    if (!cont) return;
    cont.innerHTML = '<div style="color:#888">Yükleniyor...</div>';
    try {
      const [listData, ozetData, ayarData] = await Promise.all([
        callApi('/api/rakip/izle'),
        callApi('/api/rakip/ozet'),
        callApi('/api/rakip/ayar'),
      ]);
      const max   = ozetData.max_izle || 50;
      const count = listData.rows?.length || 0;
      info.innerHTML = `<span style="font-weight:600">${count}/${max}</span> SKU izleniyor`;

      // Populate settings
      const esikInput = document.getElementById('rf-esik-ayar');
      if (esikInput) esikInput.value = ayarData.ayar?.alarm_esigi_varsayilan || '10';

      if (!listData.rows?.length) {
        cont.innerHTML = '<div style="color:#888;padding:20px">İzleme listesi boş. Aşağıdan SKU ekleyin.</div>';
        return;
      }

      let html = `<table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead><tr style="background:#f7fafc;font-weight:600">
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:left">Marka</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:left">Ebat</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">Frekans</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">Alarm %</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">Durum</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">Alarm</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">İşlem</th>
        </tr></thead><tbody>`;

      for (const r of listData.rows) {
        const freqLabel = r.gunluk_cekim === 3 ? '<span style="color:#3182ce;font-weight:600">3x VIP</span>' : '1x';
        const durum = r.aktif
          ? '<span style="color:#38a169">● Aktif</span>'
          : '<span style="color:#999">● Pasif</span>';
        const alarmBadge = r.alarm_sayisi
          ? `<span style="background:#e53e3e;color:#fff;border-radius:10px;padding:1px 7px;font-size:11px">${r.alarm_sayisi}</span>`
          : '<span style="color:#ccc">—</span>';
        html += `<tr style="border-bottom:1px solid #f0f4f8" id="izle-row-${r.id}">
          <td style="padding:9px 12px;font-weight:600">${r.marka}</td>
          <td style="padding:9px 12px;color:#555">${r.ebat}</td>
          <td style="padding:9px 12px;text-align:center">
            <select onchange="rfGuncelle(${r.id},'gunluk_cekim',parseInt(this.value))"
              style="padding:3px 6px;border:1px solid #cbd5e0;border-radius:4px;font-size:12px">
              <option value="3" ${r.gunluk_cekim===3?'selected':''}>3x VIP</option>
              <option value="1" ${r.gunluk_cekim===1?'selected':''}>1x Günlük</option>
            </select>
          </td>
          <td style="padding:9px 12px;text-align:center">
            <input type="number" value="${r.alarm_esigi}" min="1" max="100" step="0.5"
              onchange="rfGuncelle(${r.id},'alarm_esigi',parseFloat(this.value))"
              style="width:55px;padding:3px 6px;border:1px solid #cbd5e0;border-radius:4px;
                     font-size:12px;text-align:center">
            <span style="font-size:11px;color:#888">%</span>
          </td>
          <td style="padding:9px 12px;text-align:center">${durum}</td>
          <td style="padding:9px 12px;text-align:center">${alarmBadge}</td>
          <td style="padding:9px 12px;text-align:center">
            <button onclick="rfToggle(${r.id},${!r.aktif})"
              style="padding:3px 8px;background:#edf2f7;border:1px solid #e2e8f0;border-radius:4px;
                     font-size:11px;cursor:pointer;margin-right:4px">
              ${r.aktif ? 'Duraklat' : 'Aktifleştir'}
            </button>
            <button onclick="rfSil(${r.id},'${r.marka}','${r.ebat}')"
              style="padding:3px 8px;background:#fff5f5;border:1px solid #fed7d7;border-radius:4px;
                     font-size:11px;cursor:pointer;color:#c53030">Sil</button>
          </td>
        </tr>`;
      }
      html += '</tbody></table>';
      cont.innerHTML = html;
    } catch(e) {
      cont.innerHTML = `<div style="color:#e53e3e">Hata: ${e.message}</div>`;
    }
  }

  window.rfIzleEkle = async function() {
    const marka    = document.getElementById('rf-yeni-marka').value.trim();
    const ebat     = document.getElementById('rf-yeni-ebat').value.trim();
    const cekim    = parseInt(document.getElementById('rf-yeni-cekim').value, 10);
    const esik     = parseFloat(document.getElementById('rf-yeni-esik').value) || undefined;
    const aciklama = document.getElementById('rf-yeni-aciklama').value.trim();
    if (!marka || !ebat) { alert('Marka ve ebat zorunlu.'); return; }
    try {
      const data = await callApi('/api/rakip/izle', 'POST',
        { marka, ebat, gunluk_cekim: cekim, alarm_esigi: esik, aciklama: aciklama || undefined });
      if (data.error) { alert(data.error); return; }
      ['rf-yeni-marka','rf-yeni-ebat','rf-yeni-esik','rf-yeni-aciklama'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
      });
      rfYukleIzle();
      rfYukleOzet();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  window.rfGuncelle = async function(id, alan, deger) {
    try {
      await callApi(`/api/rakip/izle/${id}`, 'PUT', { [alan]: deger });
    } catch(e) { alert('Güncelleme hatası: ' + e.message); }
  };

  window.rfToggle = async function(id, aktif) {
    try {
      await callApi(`/api/rakip/izle/${id}`, 'PUT', { aktif });
      rfYukleIzle();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  window.rfSil = async function(id, marka, ebat) {
    if (!confirm(`"${marka} ${ebat}" izleme listesinden silinsin mi?`)) return;
    try {
      await callApi(`/api/rakip/izle/${id}`, 'DELETE');
      rfYukleIzle();
      rfYukleOzet();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  window.rfKaydetAyar = async function() {
    const esik = parseFloat(document.getElementById('rf-esik-ayar').value);
    if (isNaN(esik) || esik <= 0) { alert('Geçerli bir eşik girin.'); return; }
    try {
      await callApi('/api/rakip/ayar', 'PUT', { alarm_esigi_varsayilan: esik });
      alert('Ayar kaydedildi. Yeni SKU eklemelerinde varsayılan eşik %' + esik + ' olacak.');
    } catch(e) { alert('Hata: ' + e.message); }
  };

  // ── Alarmlar Tab ────────────────────────────────────────────────────────────
  async function rfYukleAlarm() {
    const cont = document.getElementById('rf-alarm-table');
    const info = document.getElementById('rf-alarm-info');
    if (!cont) return;
    cont.innerHTML = '<div style="color:#888">Yükleniyor...</div>';
    try {
      const data = await callApi('/api/rakip/alarm?limit=100');
      if (info) info.textContent = data.unread
        ? `${data.unread} okunmamış alarm`
        : 'Tüm alarmlar okundu';

      if (!data.rows?.length) {
        cont.innerHTML = '<div style="color:#888;padding:20px">Henüz alarm yok.</div>';
        return;
      }

      let html = `<table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead><tr style="background:#f7fafc;font-weight:600">
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0">Tarih</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0">SKU</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0">Kaynak</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:right">Önceki</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:right">Yeni</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center">Değişim</th>
          <th style="padding:9px 12px;border-bottom:2px solid #e2e8f0;text-align:center"></th>
        </tr></thead><tbody>`;

      for (const a of data.rows) {
        const yon = a.yon === 'YUKARI'
          ? '<span style="color:#e53e3e;font-weight:700">▲</span>'
          : '<span style="color:#38a169;font-weight:700">▼</span>';
        const bg = a.goruldu ? '' : 'background:#fffbeb;';
        const tarih = new Date(a.alarm_at).toLocaleString('tr-TR',
          { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
        html += `<tr style="border-bottom:1px solid #f0f4f8;${bg}">
          <td style="padding:9px 12px;color:#718096;font-size:12px">${tarih}</td>
          <td style="padding:9px 12px;font-weight:600">${a.marka} ${a.ebat}</td>
          <td style="padding:9px 12px;color:#555">${a.kaynak}</td>
          <td style="padding:9px 12px;text-align:right;color:#718096">
            ${a.eski_fiyat ? parseFloat(a.eski_fiyat).toLocaleString('tr-TR') + ' ₺' : '—'}
          </td>
          <td style="padding:9px 12px;text-align:right;font-weight:600">
            ${a.yeni_fiyat ? parseFloat(a.yeni_fiyat).toLocaleString('tr-TR') + ' ₺' : '—'}
          </td>
          <td style="padding:9px 12px;text-align:center">
            ${yon} %${parseFloat(a.degisim_pct).toFixed(1)}
          </td>
          <td style="padding:9px 12px;text-align:center">
            ${!a.goruldu ? `<button onclick="rfOkundu(${a.id})"
              style="padding:2px 8px;background:#f0fff4;border:1px solid #c6f6d5;border-radius:4px;
                     font-size:11px;cursor:pointer;color:#276749">Okundu</button>` : ''}
          </td>
        </tr>`;
      }
      html += '</tbody></table>';
      cont.innerHTML = html;
    } catch(e) {
      cont.innerHTML = `<div style="color:#e53e3e">Hata: ${e.message}</div>`;
    }
  }

  window.rfOkundu = async function(id) {
    try {
      await callApi(`/api/rakip/alarm/${id}/goruldu`, 'POST');
      rfYukleAlarm();
      rfYukleOzet();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  window.rfHepsiniOku = async function() {
    try {
      await callApi('/api/rakip/alarm/goruldu-hepsi', 'POST');
      rfYukleAlarm();
      rfYukleOzet();
    } catch(e) { alert('Hata: ' + e.message); }
  };

  // ── Özet / Badge ─────────────────────────────────────────────────────────────
  async function rfYukleOzet() {
    try {
      const data = await callApi('/api/rakip/ozet');
      const bar = document.getElementById('rakip-ozet-bar');
      if (bar) bar.innerHTML = `
        <span>İzlenen: <strong>${data.izlenen_sku}/${data.max_izle}</strong></span>
        ${data.okunmamis_alarm ? `<span style="color:#e53e3e">⚠ ${data.okunmamis_alarm} alarm</span>` : '<span style="color:#38a169">✓ Alarm yok</span>'}
      `;
      // Alarm badge (nav)
      const badge = document.getElementById('rakip-alarm-badge');
      const rfBadge = document.getElementById('rf-alarm-count');
      if (badge) {
        badge.textContent = data.okunmamis_alarm || 0;
        badge.style.display = data.okunmamis_alarm ? 'inline' : 'none';
      }
      if (rfBadge) {
        rfBadge.textContent = data.okunmamis_alarm || 0;
        rfBadge.style.display = data.okunmamis_alarm ? 'inline' : 'none';
      }
    } catch(e) { /* sessiz */ }
  }
}
// END vRakipFiyat
