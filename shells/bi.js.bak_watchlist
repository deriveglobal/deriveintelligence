// shells/bi.js — Derive Intelligence VMO (Virtual Management Office)
// Export: initBiSurface(container, me, sub, callbacks)
//
// Departments: Sales (Satış) · Pricing (Fiyatlandırma) · Warehouse (Depo) · IT (Sistem)
// Each dept: KPI tiles + chart placeholder + AI avatar chat

export function initBiSurface(container, me, sub, callbacks) {
  const { apiFetch, streamChat, logout } = callbacks;
  const features    = sub?.features || {};
  const permissions = sub?.permissions || me?.permissions || {};
  const allowedDepts = permissions.departments || ["sales","pricing","warehouse","it"];

  const DEPTS = [
    { id: "sales",     label: "Satış",          avatar: "Satış Müdürü",          icon: "📈", color: "#2563eb" },
    { id: "pricing",   label: "Fiyatlandırma",  avatar: "Fiyat Müdürü",          icon: "💰", color: "#7c3aed" },
    { id: "warehouse", label: "Depo",            avatar: "Depo Müdürü",           icon: "📦", color: "#059669" },
    { id: "it",        label: "Sistem",          avatar: "Sistem Müdürü",         icon: "🖥", color: "#d97706"  }
  ].filter(d => allowedDepts.includes(d.id));

  let activeDept = DEPTS[0]?.id || "sales";
  let chatHistories = {}; // { dept: [{role,content}] }
  let briefingLoaded = false;

  // ─── Render skeleton ────────────────────────────────────────────────────
  container.innerHTML = `
    <div class="bi-shell">
      <header class="bi-header">
        <div class="bi-header-left">
          <div class="bi-logo">
            <svg width="26" height="26" viewBox="0 0 32 32" fill="none">
              <rect width="32" height="32" rx="8" fill="#1a1a2e"/>
              <path d="M8 16h4l3-8 4 16 3-8h4" stroke="#e2b04a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="bi-logo-text">Derive <strong>Intelligence</strong></span>
          </div>
        </div>
        <div class="bi-header-center">
          <nav class="bi-dept-nav">
            ${DEPTS.map(d => `
              <button class="bi-dept-tab ${d.id===activeDept?"active":""}" data-dept="${d.id}" style="--dept-color:${d.color}">
                <span class="bi-tab-icon">${d.icon}</span>
                <span class="bi-tab-label">${d.label}</span>
              </button>`).join("")}
          </nav>
        </div>
        <div class="bi-header-right">
          <span class="bi-tenant-name">${esc(me.tenantName || "")}</span>
          // [patch: bi-admin-nav]
          ${(me.tenantRole === 'tenant_admin' || me.tenantRole === 'platform_owner') ? `
          <button class="bi-icon-btn" id="bi-admin-btn" title="Ekip Yönetimi" style="margin-right:4px">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </button>` : ''}
          <button class="bi-icon-btn" id="bi-logout" title="Çıkış">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          </button>
        </div>
      </header>

      <div class="bi-body">
        <!-- Morning briefing -->
        <div class="bi-briefing-bar" id="bi-briefing-bar">
          <div class="bi-briefing-loading">Sabah brifingı hazırlanıyor…</div>
        </div>

        <!-- Department rooms -->
        <div class="bi-rooms" id="bi-rooms">
          ${DEPTS.map(d => `
            <div class="bi-room ${d.id===activeDept?"":"bi-room-hidden"}" id="bi-room-${d.id}" data-dept="${d.id}">
              <div class="bi-room-main">
                <div class="bi-kpi-row" id="bi-kpis-${d.id}">
                  <div class="bi-kpi-loading">KPI'lar yükleniyor…</div>
                </div>
                <div class="bi-chart-area" id="bi-chart-${d.id}">
                  <div class="bi-chart-placeholder">Grafik yükleniyor…</div>
                </div>
              </div>
              <aside class="bi-chat-panel">
                <div class="bi-avatar-header" style="--dept-color:${d.color}">
                  <div class="bi-avatar-orb">${d.icon}</div>
                  <div>
                    <div class="bi-avatar-name">${d.avatar}</div>
                    <div class="bi-avatar-status">✦ Çevrimiçi</div>
                  </div>
                </div>
                <div class="bi-chat-messages" id="bi-chat-${d.id}">
                  <div class="bi-chat-welcome">
                    <p>Merhaba! Ben <strong>${d.avatar}</strong>. ${d.label} departmanı hakkında ne öğrenmek istersiniz?</p>
                    <div class="bi-quick-prompts">
                      ${quickPrompts(d.id).map(p => `<button class="bi-quick-btn" data-dept="${d.id}" data-prompt="${esc(p)}">${esc(p)}</button>`).join("")}
                    </div>
                  </div>
                </div>
                <form class="bi-chat-form" id="bi-chat-form-${d.id}">
                  <input type="text" class="bi-chat-input" placeholder="Soru sorun…" autocomplete="off">
                  <button type="submit" class="bi-chat-send">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                  </button>
                </form>
              </aside>
            </div>`).join("")}
        </div>
      </div>
    </div>
    <style>${biStyles()}</style>
  `;

  // ─── Event: dept tab switching ──────────────────────────────────────────
  container.querySelectorAll(".bi-dept-tab").forEach(tab => {
    tab.addEventListener("click", () => {
      activeDept = tab.dataset.dept;
      container.querySelectorAll(".bi-dept-tab").forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
      container.querySelectorAll(".bi-room").forEach(r => {
        r.classList.toggle("bi-room-hidden", r.dataset.dept !== activeDept);
      });
      loadDeptData(activeDept);
    });
  });

  // ─── Event: logout ──────────────────────────────────────────────────────
  container.querySelector("#bi-logout").addEventListener("click", logout);

  // Admin nav — open Tenant Admin surface
  container.querySelector("#bi-admin-btn")?.addEventListener("click", () => {
    const admContainer = document.getElementById("tenant-admin-surface");
    const biContainer  = document.getElementById("bi-surface");
    if (!admContainer) { alert("Tenant Admin yüklenemedi — sayfa yenileyin."); return; }
    if (biContainer)  biContainer.style.display  = "none";
    admContainer.style.display = "block";

    if (!admContainer.dataset.initialized) {
      admContainer.dataset.initialized = "1";
      const apiFn = async (path, opts) => {
        const headers = { ...(opts?.headers || {}) };
        // pick up session token from cookie or window helper
        const token = document.cookie.match(/platform_session=([^;]+)/)?.[1];
        if (token) headers['Authorization'] = `Bearer ${decodeURIComponent(token)}`;
        const r = await fetch(path, { ...opts, headers });
        if (!r.ok) { const e = await r.json().catch(()=>({error:r.statusText})); throw Object.assign(new Error(e.error||"Failed"),{status:r.status}); }
        return r.json();
      };
      import("/shells/tenant-admin.js").then(({ initTenantAdminSurface }) => {
        initTenantAdminSurface(admContainer, me, {
          apiFetch: apiFn,
          switchToModule: () => {
            admContainer.style.display = "none";
            if (biContainer) biContainer.style.display = "block";
          }
        });
      }).catch(err => {
        admContainer.innerHTML = `<div style="padding:40px;color:red;font-family:sans-serif">Yüklenemedi: ${err.message}</div>`;
      });
    }
  });

  // ─── Event: chat forms ─────────────────────────────────────────────────
  DEPTS.forEach(d => {
    const form = container.querySelector(`#bi-chat-form-${d.id}`);
    if (!form) return;
    form.addEventListener("submit", e => {
      e.preventDefault();
      const input = form.querySelector(".bi-chat-input");
      const msg = input.value.trim();
      if (!msg) return;
      input.value = "";
      sendChat(d.id, msg);
    });
  });

  // ─── Event: quick prompts ──────────────────────────────────────────────
  container.addEventListener("click", e => {
    const btn = e.target.closest(".bi-quick-btn");
    if (!btn) return;
    sendChat(btn.dataset.dept, btn.dataset.prompt);
  });

  // ─── Morning briefing ──────────────────────────────────────────────────
  loadBriefing();

  // ─── Load initial dept ─────────────────────────────────────────────────
  if (activeDept) loadDeptData(activeDept);

  // ═══════════════════════════════════════════════════════════════════════
  // Data loading
  // ═══════════════════════════════════════════════════════════════════════

  async function loadBriefing() {
    const bar = container.querySelector("#bi-briefing-bar");
    try {
      const data = await apiFetch("/api/bi/morning-briefing");
      const c = data.content_json;
      if (!c || !c.summary) { bar.innerHTML = ""; return; }
      bar.innerHTML = `
        <div class="bi-briefing">
          <div class="bi-briefing-icon">☀️</div>
          <div class="bi-briefing-body">
            <div class="bi-briefing-summary">${esc(c.summary)}</div>
            <div class="bi-briefing-pills">
              ${c.sales_highlight  ? `<span class="bi-pill bi-pill-blue">📈 ${esc(c.sales_highlight)}</span>` : ""}
              ${c.stock_alert      ? `<span class="bi-pill bi-pill-orange">📦 ${esc(c.stock_alert)}</span>` : ""}
              ${c.pricing_note     ? `<span class="bi-pill bi-pill-purple">💰 ${esc(c.pricing_note)}</span>` : ""}
            </div>
          </div>
          <button class="bi-briefing-close" id="bi-close-briefing">✕</button>
        </div>`;
      container.querySelector("#bi-close-briefing").onclick = () => { bar.style.display = "none"; };
    } catch { bar.innerHTML = ""; }
  }

  async function loadDeptData(dept) {
    switch(dept) {
      case "sales":     await loadSalesKpis();     break;
      case "pricing":   await loadPricingKpis();   break;
      case "warehouse": await loadWarehouseKpis(); break;
      case "it":        await loadItKpis();        break;
    }
  }

  async function loadSalesKpis() {
    const el = container.querySelector("#bi-kpis-sales");
    const chartEl = container.querySelector("#bi-chart-sales");
    try {
      const [kpiData, trend] = await Promise.all([
        apiFetch("/api/bi/sales/kpis"),
        apiFetch("/api/bi/sales/trend")
      ]);
      const k = kpiData.kpis || {};
      const prevCiro = parseFloat(k.revenue_prev_30d || 0);
      const curCiro  = parseFloat(k.revenue_30d || 0);
      const delta    = prevCiro > 0 ? ((curCiro - prevCiro) / prevCiro * 100).toFixed(1) : null;

      el.innerHTML = `
        ${kpiTile("Ciro (30g)", formatTRY(k.revenue_30d), delta ? `${delta > 0?"+":""}${delta}% önceki döneme göre` : null, delta > 0 ? "up" : delta < 0 ? "down" : null)}
        ${kpiTile("Fatura Sayısı", fmt(k.invoice_count_30d), null)}
        ${kpiTile("Ort. Satır Değeri", formatTRY(k.avg_line_value_30d), null)}
        ${kpiTile("Top Müşteri", kpiData.top_customers?.[0]?.musteri_adi || "—", kpiData.top_customers?.[0] ? formatTRY(kpiData.top_customers[0].total) : null)}
      `;

      if (trend.length) {
        const monthLabels = trend.map(r => {
          const d = new Date(r.ay); return `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,"0")}`;
        });
        const ciroVals = trend.map(r => parseFloat(r.ciro));
        renderBarChart(chartEl, monthLabels, ciroVals, "Aylık Ciro (TL)", "#2563eb");
      } else {
        chartEl.innerHTML = `<div class="bi-no-data">Satış verisi bulunamadı.</div>`;
      }
    } catch(err) {
      el.innerHTML = kpiError(err.message);
    }
  }

  async function loadPricingKpis() {
    const el = container.querySelector("#bi-kpis-pricing");
    const chartEl = container.querySelector("#bi-chart-pricing");
    try {
      const [kpis, ccc] = await Promise.all([
        apiFetch("/api/bi/pricing/kpis"),
        apiFetch("/api/bi/pricing/ccc")
      ]);
      el.innerHTML = `
        ${kpiTile("Ort. Brüt Marj", formatTRY(kpis.avg_brut_marj), null)}
        ${kpiTile("Ort. Marj %", kpis.avg_marj_pct ? `%${parseFloat(kpis.avg_marj_pct).toFixed(1)}` : "—", null)}
        ${kpiTile("Nakit Döngüsü (CCC)", `${ccc.ccc} gün`, `DIS:${ccc.dis} + DSO:${ccc.dso} - DPO:${ccc.dpo}`, ccc.ccc > 60 ? "down" : "up")}
        ${kpiTile("Finansman Maliyeti/Birim", formatTRY(ccc.financing_cost_per_unit), `@%${(ccc.cost_of_capital*100).toFixed(0)} sermaye maliyeti`)}
      `;

      // CCC waterfall
      const labels = ["DIS (Stok Süresi)", "DSO (Tahsilat)", "DPO (Ödeme)", "CCC"];
      const values = [ccc.dis, ccc.dso, -ccc.dpo, ccc.ccc];
      const colors = ["#7c3aed","#2563eb","#059669","#d97706"];
      renderBarChart(chartEl, labels, values, "Nakit Döngüsü (Gün)", colors, true);

      if (ccc.note) {
        chartEl.insertAdjacentHTML("beforeend",
          `<div class="bi-warning-banner">⚠️ ${esc(ccc.note)}</div>`);
      }
    } catch(err) {
      el.innerHTML = kpiError(err.message);
    }

    // ── Tedarikçi Teşvik Yönetimi paneli ──────────────────────────
    const pricingRoom = container.querySelector("#bi-room-pricing .bi-room-main");
    if (pricingRoom && !pricingRoom.querySelector("#bi-brand-incentives-mount")) {
      const mountDiv = document.createElement("div");
      mountDiv.id = "bi-brand-incentives-mount";
      mountDiv.style.cssText = "margin-top:24px;width:100%;";
      pricingRoom.appendChild(mountDiv);
      try {
        const { initBrandIncentives } = await import("/components/brand-incentives.js");
        initBrandIncentives(mountDiv, me, { apiFetch });
      } catch(e) {
        mountDiv.innerHTML = `<div class="bi-kpi-error">Teşvik paneli yüklenemedi: ${e.message}</div>`;
      }
    }
  }

  async function loadWarehouseKpis() {
    const el = container.querySelector("#bi-kpis-warehouse");
    const chartEl = container.querySelector("#bi-chart-warehouse");
    try {
      const [kpis, movements] = await Promise.all([
        apiFetch("/api/bi/warehouse/kpis"),
        apiFetch("/api/bi/warehouse/movements")
      ]);
      if (kpis.no_data) {
        el.innerHTML = `<div class="bi-no-data">Stok verisi bulunamadı.</div>`;
        return;
      }
      const k = kpis.kpis || {};
      el.innerHTML = `
        ${kpiTile("Toplam SKU", fmt(k.sku_sayisi), null)}
        ${kpiTile("Stok Değeri", formatTRY(k.stok_degeri), `Veri: ${kpis.as_of || "—"}`)}
        ${kpiTile("Kritik Stok", fmt(k.kritik_stok_sayisi) + " kalem", null, parseInt(k.kritik_stok_sayisi) > 0 ? "down" : "up")}
        ${kpiTile("Sıfır Stok", fmt(k.sifir_stok_sayisi) + " kalem", null, parseInt(k.sifir_stok_sayisi) > 0 ? "down" : null)}
      `;

      if (movements.length) {
        const labels = movements.slice(0,8).map(r => r.belge_turu || "?");
        const values = movements.slice(0,8).map(r => parseFloat(r.hareket_sayisi));
        renderBarChart(chartEl, labels, values, "Hareket Türleri (Adet)", "#059669");
      }

      if (kpis.dead_stock?.length) {
        chartEl.insertAdjacentHTML("beforeend", `
          <div class="bi-dead-stock">
            <h4>90 Gün Hareketsiz Stok (TL değeri)</h4>
            <div class="bi-dead-list">
              ${kpis.dead_stock.slice(0,5).map(r =>
                `<div class="bi-dead-item">
                  <span>${esc(r.kalem_tanimi || r.kalem_kodu)}</span>
                  <strong>${formatTRY(r.toplam_deger)}</strong>
                </div>`).join("")}
            </div>
          </div>`);
      }
    } catch(err) {
      el.innerHTML = kpiError(err.message);
    }
  }

  async function loadItKpis() {
    const el = container.querySelector("#bi-kpis-it");
    const chartEl = container.querySelector("#bi-chart-it");
    try {
      const rows = await apiFetch("/api/bi/it/kpis");
      if (!rows.length) {
        el.innerHTML = `<div class="bi-no-data">Henüz veri alınmamış.</div>`;
        return;
      }
      const tiles = rows.map(r => {
        const saatOnce = r.saat_once ? `${parseFloat(r.saat_once).toFixed(1)} saat önce` : "—";
        const durum = r.haftalik_hata > 0 ? "down" : "up";
        return kpiTile(r.query_type, saatOnce, `Son: ${r.son_veri_tarihi||"—"}`, durum);
      });
      el.innerHTML = tiles.join("");

      chartEl.innerHTML = `
        <div class="bi-it-table">
          <table>
            <thead><tr><th>Sorgu</th><th>Son Veri</th><th>Son Güncelleme</th><th>Bugün</th><th>7g Hata</th></tr></thead>
            <tbody>
              ${rows.map(r => `
                <tr>
                  <td><code>${esc(r.query_type)}</code></td>
                  <td>${r.son_veri_tarihi||"—"}</td>
                  <td>${r.son_guncelleme ? new Date(r.son_guncelleme).toLocaleString("tr-TR") : "—"}</td>
                  <td>${fmt(r.bugunki_satirlar||0)} satır</td>
                  <td class="${r.haftalik_hata>0?"bi-red":"bi-green"}">${r.haftalik_hata||0}</td>
                </tr>`).join("")}
            </tbody>
          </table>
        </div>`;
    } catch(err) {
      el.innerHTML = kpiError(err.message);
    }
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Chat
  // ═══════════════════════════════════════════════════════════════════════

  async function sendChat(dept, message) {
    const chatEl = container.querySelector(`#bi-chat-${dept}`);
    if (!chatEl) return;

    // Clear welcome message on first real chat
    const welcome = chatEl.querySelector(".bi-chat-welcome");
    if (welcome) welcome.remove();

    appendChatBubble(chatEl, "user", message);
    const assistantBubble = appendChatBubble(chatEl, "assistant", "");
    const textEl = assistantBubble.querySelector(".bi-bubble-text");

    try {
      await streamChat(dept, message, (chunk) => {
        textEl.textContent += chunk;
        chatEl.scrollTop = chatEl.scrollHeight;
      });
    } catch(err) {
      textEl.textContent = `Hata: ${err.message}`;
      textEl.style.color = "#dc2626";
    }
    chatEl.scrollTop = chatEl.scrollHeight;
  }

  function appendChatBubble(chatEl, role, text) {
    const div = document.createElement("div");
    div.className = `bi-bubble bi-bubble-${role}`;
    div.innerHTML = `<div class="bi-bubble-text">${esc(text)}</div>`;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Chart (vanilla SVG bar chart — no external deps)
  // ═══════════════════════════════════════════════════════════════════════

  function renderBarChart(container, labels, values, title, color, multiColor = false) {
    if (!values.length) { container.innerHTML = `<div class="bi-no-data">Veri yok.</div>`; return; }
    const W = 600, H = 220, PL = 70, PR = 20, PT = 36, PB = 54;
    const cW = W - PL - PR, cH = H - PT - PB;
    const maxV = Math.max(...values.map(Math.abs), 1);
    const barW = Math.min(40, (cW / labels.length) - 8);

    const colors = Array.isArray(color)
      ? color
      : values.map(v => v < 0 ? "#ef4444" : color);

    const bars = labels.map((label, i) => {
      const v = values[i];
      const x = PL + (i + 0.5) * (cW / labels.length) - barW / 2;
      const pct = Math.abs(v) / maxV;
      const barH = pct * cH;
      const y = v >= 0 ? PT + cH - barH : PT + cH;
      const c = colors[i % colors.length];
      const labelShort = label.length > 10 ? label.slice(0,9)+"…" : label;
      return `
        <rect x="${x}" y="${y}" width="${barW}" height="${barH}" fill="${c}" rx="3" opacity="0.9"/>
        <text x="${x + barW/2}" y="${H - PB + 16}" text-anchor="middle" font-size="10" fill="#666">${esc(labelShort)}</text>
        <text x="${x + barW/2}" y="${y - 4}" text-anchor="middle" font-size="9" fill="#444">${fmt(v)}</text>
      `;
    }).join("");

    const yTicks = [0, 0.25, 0.5, 0.75, 1].map(p => {
      const val = maxV * p;
      const y2  = PT + cH - p * cH;
      return `
        <line x1="${PL}" y1="${y2}" x2="${W-PR}" y2="${y2}" stroke="#eee" stroke-width="1"/>
        <text x="${PL-6}" y="${y2+4}" text-anchor="end" font-size="9" fill="#aaa">${fmt(val)}</text>
      `;
    }).join("");

    container.innerHTML = `
      <div class="bi-chart-title">${esc(title)}</div>
      <svg viewBox="0 0 ${W} ${H}" style="width:100%;max-height:220px">
        ${yTicks}
        ${bars}
        <line x1="${PL}" y1="${PT}" x2="${PL}" y2="${PT+cH}" stroke="#ddd" stroke-width="1"/>
        <line x1="${PL}" y1="${PT+cH}" x2="${W-PR}" y2="${PT+cH}" stroke="#ddd" stroke-width="1"/>
      </svg>
    `;
  }

  // ═══════════════════════════════════════════════════════════════════════
  // Utilities
  // ═══════════════════════════════════════════════════════════════════════

  function kpiTile(label, value, sub, trend) {
    const arrow = trend === "up" ? `<span class="bi-trend up">↑</span>` :
                  trend === "down" ? `<span class="bi-trend down">↓</span>` : "";
    return `
      <div class="bi-kpi-tile">
        <div class="bi-kpi-label">${esc(label)}</div>
        <div class="bi-kpi-value">${esc(String(value ?? "—"))} ${arrow}</div>
        ${sub ? `<div class="bi-kpi-sub">${esc(sub)}</div>` : ""}
      </div>`;
  }

  function kpiError(msg) {
    return `<div class="bi-kpi-error">Yüklenemedi: ${esc(msg)}</div>`;
  }

  function formatTRY(v) {
    const n = parseFloat(v);
    if (isNaN(n)) return "—";
    return n.toLocaleString("tr-TR", { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + " ₺";
  }

  function fmt(v) {
    const n = parseFloat(v);
    if (isNaN(n)) return "—";
    return n.toLocaleString("tr-TR");
  }

  function esc(s) {
    return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  function quickPrompts(dept) {
    return {
      sales: [
