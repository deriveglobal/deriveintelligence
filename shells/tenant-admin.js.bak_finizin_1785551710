    .ta-tag{display:inline-block;padding:3px 9px;background:#eef2ff;color:#4338ca;border-radius:6px;font-size:11.5px;font-weight:600;margin:1px 4px 1px 0}
    .ta-muted{color:#a6adba}
    .ta-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;vertical-align:middle}
    .ta-dot-on{background:#12b76a;box-shadow:0 0 0 3px rgba(18,183,106,.14)}.ta-dot-off{background:#cdd3dd}
    .ta-act{white-space:nowrap;display:flex;gap:7px;flex-wrap:wrap;align-items:center}
    .ta-btn{padding:9px 16px;border-radius:10px;border:1px solid #e2e5ec;background:#fff;cursor:pointer;font-size:13.5px;font-weight:600;color:#3d4657;transition:.14s;line-height:1}
    .ta-btn:hover{background:#f7f8fa;border-color:#d7dbe3}
    .ta-btn-xs{padding:6px 12px;font-size:12px;border-radius:8px}
    .ta-btn-primary{background:#12182a;color:#fff;border-color:#12182a}.ta-btn-primary:hover{background:#222a42;border-color:#222a42}
    .ta-btn-secondary{background:#eef2ff;color:#4338ca;border-color:#dde3fe}.ta-btn-secondary:hover{background:#e2e8ff}
    .ta-btn-danger{background:#fef3f2;color:#b42318;border-color:#fcd9d3}.ta-btn-danger:hover{background:#fee4e0}
    .ta-btn-success{background:#e7f8ef;color:#067647;border-color:#b6ecd0}.ta-btn-success:hover{background:#d3f3e1}
    .ta-btn-ghost{background:transparent;border-color:transparent;color:#6b7280}.ta-btn-ghost:hover{background:#f0f1f4}
    .ta-btn-full{width:100%;margin-top:18px;padding:12px}
    .ta-izin-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap}
    .ta-modtabs{display:inline-flex;background:#eceef2;border-radius:11px;padding:4px}
    .ta-modtab{border:0;background:transparent;padding:8px 18px;border-radius:8px;font-size:13px;font-weight:650;color:#5b6472;cursor:pointer;transition:.14s}
    .ta-modtab.active{background:#fff;color:#12182a;box-shadow:0 1px 3px rgba(16,24,40,.12)}
    .ta-izin-hint{font-size:12px;color:#9aa1ae}
    .ta-matrixwrap{max-height:calc(100vh - 258px)}
    .ta-matrix{width:auto;min-width:0}
    .ta-matrix th,.ta-matrix td{border-right:1px solid #f2f4f7}
    .ta-matrix tbody td{background:#fff}
    .ta-matrix tbody tr:hover td{background:#f8fafc}
    .ta-matrix .ta-grp{text-align:center;background:#f6f7f9;color:#7a8290;font-size:10px;letter-spacing:.06em;padding:7px 6px}
    .ta-toolh{font-size:9px;text-align:center;width:74px;min-width:74px;white-space:normal;overflow-wrap:anywhere;line-height:1.15;padding:8px 6px;vertical-align:bottom;color:#8a919f;letter-spacing:0}
    .ta-cell{text-align:center;padding:9px 6px;width:74px;min-width:74px}
    .ta-tool,.ta-active{appearance:none;-webkit-appearance:none;width:18px;height:18px;margin:0;border:1.5px solid #cbd5e1;border-radius:5px;background:#fff;cursor:pointer;position:relative;vertical-align:middle;transition:.12s}
    .ta-tool:hover,.ta-active:hover{border-color:#2563eb}
    .ta-tool:checked,.ta-active:checked{background:#2563eb;border-color:#2563eb}
    .ta-tool:checked::after,.ta-active:checked::after{content:"";position:absolute;left:5px;top:2px;width:4px;height:8px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
    .ta-tool:disabled,.ta-active:disabled{cursor:not-allowed}
    .ta-tool:disabled:not(:checked),.ta-active:disabled:not(:checked){background:#eef0f4;border-color:#dce0e7}
    .ta-tool:disabled:checked,.ta-active:disabled:checked{background:#e0a93f;border-color:#e0a93f}
    .ta-sticky{position:sticky;left:0;z-index:2;background:#fff;box-shadow:6px 0 10px -8px rgba(16,24,40,.22);min-width:230px}
    .ta-matrix tbody tr:hover .ta-sticky{background:#f8fafc}
    .ta-matrix thead .ta-sticky{z-index:3;background:#fafbfc}
    .ta-mini{font-size:12px;padding:6px 8px;border:1px solid #dde1e8;border-radius:8px;background:#fff;color:#3d4657;font-weight:550}
    .ta-mini:disabled{background:#f4f5f7;color:#9aa1ae}
    .ta-role{min-width:98px}.ta-seg{min-width:86px}
    .ta-rowsave{display:flex;align-items:center;gap:8px;margin-top:8px}
    .ta-save{padding:5px 12px;font-size:12px;border-radius:8px}
    .ta-save.on{background:#2563eb;color:#fff;border-color:#2563eb}.ta-save.on:hover{background:#1d4ed8}
    .ta-rowmsg{font-size:11px;color:#9aa1ae}.ta-rowmsg.ok{color:#067647}.ta-rowmsg.err{color:#d92d20}
    .ta-two{display:grid;grid-template-columns:1.1fr 1fr;gap:28px;align-items:start}
    @media(max-width:960px){.ta-two{grid-template-columns:1fr}}
    .ta-form{padding:26px}
    .ta-form-intro{margin:0 0 18px;color:#6b7280;font-size:13px}
    .ta-lbl{display:block;font-weight:650;font-size:12.5px;color:#4b5462;margin:18px 0 7px}
    .ta-input{width:100%;padding:11px 13px;border:1px solid #d7dbe3;border-radius:10px;font-size:14px;outline:none;background:#fff;transition:.14s}
    .ta-input:focus{border-color:#12182a;box-shadow:0 0 0 3px rgba(18,24,42,.08)}
    .ta-subgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 16px;margin-top:9px}
    .ta-chk{display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:#4b5462}
    .ta-chk input{accent-color:#2563eb}
    .ta-ok-box{background:#e7f8ef;border:1px solid #b6ecd0;border-radius:12px;padding:16px;margin-top:18px}
    .ta-invlink{font-family:ui-monospace,'SF Mono',monospace;font-size:12px;background:#fff;border:1px solid #cbd5e1;border-radius:8px;padding:10px 12px;margin:10px 0;word-break:break-all}
    .ta-ok-actions{display:flex;align-items:center;gap:12px}
    .ta-loading{padding:48px;text-align:center;color:#9aa1ae;display:flex;flex-direction:column;align-items:center;gap:13px}
    .ta-spin{width:24px;height:24px;border:2.5px solid #e8eaf0;border-top-color:#e6b95a;border-radius:50%;animation:taspin .7s linear infinite}
    @keyframes taspin{to{transform:rotate(360deg)}}
    .ta-error{padding:16px;background:#fef3f2;color:#b42318;border-radius:12px;border:1px solid #fcd9d3}
    .ta-empty{padding:56px;text-align:center;color:#a6adba;background:#fff;border:1px dashed #dde1e8;border-radius:16px}
    .ta-empty-sm{padding:20px;text-align:center;color:#a6adba;font-size:13px}
    .ta-toast-wrap{position:fixed;bottom:26px;left:50%;transform:translateX(-50%);z-index:100000;display:flex;flex-direction:column;gap:8px;align-items:center}
    .ta-toast{padding:12px 20px;border-radius:12px;font-size:13.5px;font-weight:600;color:#fff;background:#12182a;box-shadow:0 10px 30px rgba(16,24,40,.3);opacity:0;transform:translateY(12px);transition:.24s}
    .ta-toast.show{opacity:1;transform:translateY(0)}
    .ta-toast-ok{background:#067647}.ta-toast-err{background:#b42318}
    .ta-modal-ov{position:fixed;inset:0;background:rgba(16,20,30,.52);backdrop-filter:blur(2px);display:flex;align-items:center;justify-content:center;z-index:100001;padding:20px}
    .ta-modal{background:#fff;border-radius:18px;padding:26px;width:430px;max-width:100%;box-shadow:0 30px 70px rgba(0,0,0,.32)}
    .ta-modal-body{font-size:15px;color:#1a2233;line-height:1.55}
    .ta-modal-foot{display:flex;justify-content:flex-end;gap:10px;margin-top:24px}
  `;
