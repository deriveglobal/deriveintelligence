    total_actual_time_savings: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.actual_time_savings || 0), 0),
    total_estimated_cost_savings: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.estimated_cost_savings || 0), 0),
    total_expected_cost_savings: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.expected_cost_savings || rec.estimated_cost_savings || 0), 0),
    total_actual_cost_savings: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.actual_cost_savings || 0), 0),
    total_estimated_revenue_opportunity: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.estimated_revenue_opportunity || 0), 0),
    total_estimated_risk_reduction: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.estimated_risk_reduction || 0), 0),
    average_roi_confidence_score: approvedRecommendations.length
      ? Math.round((approvedRecommendations.reduce((sum, rec) => sum + Number(rec.roi_confidence_score || 0), 0) / approvedRecommendations.length) * 10) / 10
      : 0,
    average_recommendation_accuracy_score: approvedRecommendations.filter((rec) => rec.recommendation_accuracy_score !== null && rec.recommendation_accuracy_score !== undefined).length
      ? Math.round((approvedRecommendations.reduce((sum, rec) => sum + Number(rec.recommendation_accuracy_score || 0), 0) / approvedRecommendations.filter((rec) => rec.recommendation_accuracy_score !== null && rec.recommendation_accuracy_score !== undefined).length) * 10) / 10
      : null,
    top_opportunities_by_value: [...approvedRecommendations]
      .sort((a, b) => Number(b.estimated_business_value || 0) - Number(a.estimated_business_value || 0))
