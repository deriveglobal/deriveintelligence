      JSON.stringify(normalized.recommendedStakeholderRoles),
      JSON.stringify(normalized.recommendedQuestionRoles),
      JSON.stringify(recommendedKpis),
      submittedAt
    ]
  );
  return mapCompanyProfile(result.rows[0]);
}

async function getCompanyProfile(projectId, origin = "") {
  await ensureAssessmentEngineSchema();
  const context = await getDefaultContext({ projectId, department: "General" });
  const profile = await query("select * from company_profiles where assessment_project_id = $1 limit 1", [context.projectId]);
  if (profile.rowCount) {
    const mapped = mapCompanyProfile(profile.rows[0]);
    const liveKpis = await getLiveRecommendedKpisForProfile(profile.rows[0]);
    return {
      ...mapped,
      recommendedKpis: liveKpis
    };
  }
  const intake = await getLatestProjectContextIntake(context.projectId, origin);
  if (!intake?.contextData || !Object.keys(intake.contextData).length) return null;
  return upsertCompanyProfile({
    organizationId: context.organizationId,
    projectId: context.projectId,
    contextIntakeId: intake.id,
    contextData: intake.contextData,
    submittedAt: intake.submittedAt || null
  });
}

async function getLatestProjectContextIntake(projectId, origin = "") {
  const context = await getDefaultContext({ projectId, department: "General" });
