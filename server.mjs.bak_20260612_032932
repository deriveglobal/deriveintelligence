async function sendParticipantInvitation(participantId, origin, { forceNewToken = false, allowSkip = false } = {}) {
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    const result = await client.query(
      `select p.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name,
              a.title, ap.client_display_name as company_name
       from assessment_participants p
       join assessments a on a.id = p.assessment_id
       join assessment_projects ap on ap.id = p.company_id
       left join stakeholder_groups sg on sg.id = p.stakeholder_group_id
       left join stakeholder_roles sr on sr.id = p.stakeholder_role_id
       where p.participant_id = $1
       limit 1`,
      [participantId]
    );
    if (!result.rowCount) {
      const error = new Error("Participant not found.");
      error.statusCode = 404;
      throw error;
    }
    const participant = result.rows[0];
    const skipOrThrow = (reason, message, statusCode = 400) => {
      if (allowSkip) return { status: "skipped", reason };
      const error = new Error(message);
      error.statusCode = statusCode;
      throw error;
    };
    if (!participant.is_active || participant.status === "deactivated") return skipOrThrow("deactivated", "Cannot send invitation to a deactivated participant.");
    if (participant.status === "completed") return skipOrThrow("already_completed", "Participant has already completed this assessment.");
    if (!participant.email || !isEmail(participant.email)) return skipOrThrow("missing_email", "Participant must have a valid email before sending invitation.");
    if (!participant.session_id) return skipOrThrow("no_session", "Create assessment session before sending invitation.");
    if (forceNewToken) {
      await client.query("update assessment_access_tokens set is_active = false where participant_id = $1 and is_active = true", [participantId]);
    }
    const token = await getOrCreateParticipantInvitationToken(client, participant, origin);
    const email = buildAssessmentInvitationEmail({ participant, assessment: result.rows[0], token, origin });
    const delivery = emailDeliveryStatus();
    let status = "sent";
    let errorMessage = "";
    if (!delivery.configured) {
      status = "disabled";
      errorMessage = "Email sending is not configured. You can still copy the invitation link manually.";
    } else {
      try {
        await sendGraphMail({ to: participant.email, subject: email.subject, body: email.body });
      } catch (error) {
        status = "failed";
        errorMessage = error.message;
      }
    }
    const sentAt = status === "sent" ? new Date() : null;
    const updated = await client.query(
      `update assessment_participants
       set email_status = $2,
           email_error = nullif($3, ''),
           invite_count = invite_count + case when $2 in ('sent', 'disabled') then 1 else 0 end,
           invite_sent_at = case when invite_sent_at is null and $2 in ('sent', 'disabled') then now() else invite_sent_at end,
           last_invite_sent_at = case when $2 in ('sent', 'disabled') then now() else last_invite_sent_at end,
           invitation_token_id = $4,
           status = case when status = 'not_invited' and $2 in ('sent', 'disabled') then 'invited' else status end,
           updated_at = now()
       where participant_id = $1
       returning *`,
      [participantId, status, errorMessage, token.token_id || null]
    );
    await client.query(
      `insert into assessment_invitation_logs (participant_id, assessment_id, email, subject, status, error_message, sent_at)
       values ($1, $2, $3, $4, $5, nullif($6, ''), $7)`,
      [participantId, participant.assessment_id, participant.email, email.subject, status, errorMessage, sentAt]
    );
    return {
      status,
      error: errorMessage || null,
      token_reused: Boolean(token.reused),
      participant: mapAssessmentParticipant(updated.rows[0]),
      email_status_message: status === "disabled" ? errorMessage : ""
    };
  } finally {
    client.release();
  }
}

async function sendAssessmentInvitationsBulk(assessmentId, payload = {}, origin = "") {
  const state = await listAssessmentParticipants(assessmentId);
  const selected = new Set((payload.participantIds || payload.participant_ids || []).map(String));
  const coverage = state.coverage || {};
  const requiredIds = new Set((coverage.required_roles || []).map((role) => role.id));
  const recommendedIds = new Set((coverage.recommended_roles || []).map((role) => role.id));
  const scope = payload.scope || "not_invited";
  const candidates = state.participants.filter((participant) => {
    if (!participant.is_active || participant.status === "deactivated") return false;
    if (participant.status === "completed") return false;
    if (scope === "selected") return selected.has(String(participant.participant_id));
    if (scope === "incomplete") return participant.status !== "completed";
    if (scope === "required") return requiredIds.has(participant.stakeholder_role_id);
    if (scope === "recommended") return recommendedIds.has(participant.stakeholder_role_id);
    return ["not_invited", "invited"].includes(participant.status) && participant.email_status !== "sent";
  });
  const summary = { sent: 0, failed: 0, disabled: 0, skipped: 0, missing_email: 0, no_session: 0, already_completed: 0, deactivated: 0, results: [] };
  for (const participant of candidates) {
    if (!participant.email) {
      summary.skipped += 1;
      summary.missing_email += 1;
      summary.results.push({ participant_id: participant.participant_id, status: "skipped", reason: "missing_email" });
      continue;
    }
    if (!participant.session_id) {
      summary.skipped += 1;
      summary.no_session += 1;
      summary.results.push({ participant_id: participant.participant_id, status: "skipped", reason: "no_session" });
      continue;
    }
    const result = await sendParticipantInvitation(participant.participant_id, origin, { allowSkip: true });
    if (result.status === "sent") summary.sent += 1;
    else if (result.status === "disabled") summary.disabled += 1;
    else if (result.status === "failed") summary.failed += 1;
    else {
      summary.skipped += 1;
      summary[result.reason] = Number(summary[result.reason] || 0) + 1;
    }
    summary.results.push({ participant_id: participant.participant_id, status: result.status, reason: result.reason || result.error || "" });
  }
  summary.participantState = await listAssessmentParticipants(assessmentId);
  return summary;
}

async function getParticipantReminderContext(client, participantId) {
  const result = await client.query(
    `select p.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name,
            a.title, ap.client_display_name as company_name,
            coalesce(rc.response_count, 0)::int as response_count,
            coalesce(bqc.question_count, qc.question_count, 0)::int as question_count
     from assessment_participants p
     join assessments a on a.id = p.assessment_id
     join assessment_projects ap on ap.id = p.company_id
     left join stakeholder_groups sg on sg.id = p.stakeholder_group_id
     left join stakeholder_roles sr on sr.id = p.stakeholder_role_id
     left join (
       select assessment_session_id, count(*)::int as response_count
       from responses
       group by assessment_session_id
     ) rc on rc.assessment_session_id = p.session_id
     left join (
       select stakeholder_role_id, count(*)::int as question_count
       from questions
       group by stakeholder_role_id
     ) qc on qc.stakeholder_role_id = p.stakeholder_role_id
     left join (
       select b.role_key as stakeholder_role_id, count(q.id)::int as question_count
       from framework_question_banks b
       join questions q on q.bank_id = b.id
       where b.status = 'active'
       group by b.role_key
     ) bqc on bqc.stakeholder_role_id = p.stakeholder_role_id
     where p.participant_id = $1
     limit 1`,
    [participantId]
  );
  if (!result.rowCount) {
    const error = new Error("Participant not found.");
    error.statusCode = 404;
    throw error;
  }
  const row = result.rows[0];
  const progressPercent = row.question_count ? Math.round((Number(row.response_count || 0) / Number(row.question_count || 1)) * 100) : 0;
  return { participant: row, assessment: row, progressPercent };
}

function reminderSkipReason(participant = {}) {
  if (!participant.is_active || participant.status === "deactivated") return ["deactivated", "Cannot send reminder to a deactivated participant."];
  if (participant.status === "completed") return ["completed", "Participant has already completed this assessment."];
  if (!participant.email || !isEmail(participant.email)) return ["missing_email", "Participant must have a valid email before sending reminder."];
  if (!participant.session_id) return ["no_session", "Create assessment session before sending reminder."];
  if (!["invited", "started"].includes(participant.status)) return ["not_invited", "Participant must be invited or started before reminders can be sent."];
  return null;
}

