async function getCompanyProfileSignals(client, projectId) {
  const profile = await client.query("select * from company_profiles where assessment_project_id = $1 limit 1", [projectId]);
  let payload = {};
  if (profile.rowCount) {
    payload = {
      businessActivities: profile.rows[0].business_activities || [],
      operationalCharacteristics: profile.rows[0].operational_characteristics || [],
      strategicPriorities: profile.rows[0].strategic_priorities || []
    };
  } else {
    const result = await client.query(
      `select context_data
       from project_context_intakes
       where assessment_project_id = $1
       order by submitted_at desc nulls last, updated_at desc, created_at desc
       limit 1`,
      [projectId]
    );
    if (!result.rowCount) return new Set();
    payload = result.rows[0].context_data || {};
  }
  const text = JSON.stringify(payload).toLowerCase();
  const signals = new Set();
  [
    "roadside_tire_assistance",
    "mobile_tire_services",
    "warehouse_operations",
    "inventory_intensive",
    "fleet_tire_management",
    "tire_retreading",
    "data_reporting_improvement",
    "profitability_improvement"
  ].forEach((signal) => {
    if (text.includes(signal) || text.includes(signal.replace(/_/g, " "))) signals.add(signal);
  });
  return signals;
}

