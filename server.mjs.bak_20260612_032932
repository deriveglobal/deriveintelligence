function coverageGrade(total = 0, thresholds = null) {
  const gradeThresholds = thresholds || { A: 90, B: 75, C: 60, D: 45, F: 0 };
  if (total >= Number(gradeThresholds.A ?? 90)) return "A";
  if (total >= Number(gradeThresholds.B ?? 75)) return "B";
  if (total >= Number(gradeThresholds.C ?? 60)) return "C";
  if (total >= Number(gradeThresholds.D ?? 45)) return "D";
  return "F";
}

async function getScoringConfig(frameworkId, client) {
  const db = client || requireDatabase();
  const result = await db.query(
    `SELECT config_key, config_value
     FROM framework_scoring_config
     WHERE framework_id = $1
       OR framework_id IS NULL
     ORDER BY
       framework_id NULLS LAST`,
    [frameworkId || null]
  );

  const config = {};
  for (const row of result.rows) {
    if (!config[row.config_key]) {
      config[row.config_key] = row.config_value;
    }
  }

  return {
    weights: config.weights || {
      breadth: 40,
      quantity: 20,
      depth: 20,
      response_mix: 10,
      activity_fit: 10
    },
    breadthConfig: config.breadth_config || {
