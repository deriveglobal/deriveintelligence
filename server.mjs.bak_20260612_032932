async function getOrCreateAssessment(client, projectId, title = null) {
  await ensureAssessmentEngineSchema(client);
  await seedOperationsManagerQuestions(client);
  if (title) {
    const existing = await client.query(
      "select * from assessments where company_id = $1 and title = $2 order by created_at desc limit 1",
      [projectId, title]
    );
    if (existing.rowCount) return existing.rows[0];
  } else {
    const latest = await client.query(
      "select * from assessments where company_id = $1 and status <> 'archived' order by created_at desc limit 1",
      [projectId]
    );
    if (latest.rowCount) return latest.rows[0];
  }
  const inserted = await client.query(
    "insert into assessments (company_id, title, status) values ($1, $2, 'active') returning *",
    [projectId, title || "Assessment Engine"]
  );
  return inserted.rows[0];
}

async function calculateAssessmentBlueprint(client, projectId, { persist = true } = {}) {
  await ensureAssessmentEngineSchema(client);
  await seedOperationsManagerQuestions(client);
  const profile = await getCompanyProfile(projectId);
  if (!profile) {
    const error = new Error("Organization Profile is required before generating an assessment blueprint.");
    error.statusCode = 400;
    throw error;
  }

  const assessment = await getOrCreateAssessment(client, projectId);
  const currentBlueprint = await getCurrentAssessmentBlueprint(client, projectId);
  const existingNotApplicable = currentBlueprint?.not_applicable_roles || [];
  const blueprintShape = createAssessmentBlueprintFromProfile(profile, existingNotApplicable);
  const roleObjects = (roleIds) => roleIds.map((roleId) => roleBlueprintObject(roleId));
  const requiredRoles = roleObjects(blueprintShape.requiredRoleIds);
  const recommendedRoles = roleObjects(blueprintShape.recommendedRoleIds);
  const optionalRoles = roleObjects(blueprintShape.optionalRoleIds);
  const requiredQuestionBanks = uniqueStrings(requiredRoles.map((role) => role.question_bank).filter(Boolean));
  const recommendedQuestionBanks = uniqueStrings(recommendedRoles.map((role) => role.question_bank).filter(Boolean));
  const optionalQuestionBanks = uniqueStrings(optionalRoles.map((role) => role.question_bank).filter(Boolean));

  const sessions = await client.query(
    `select s.stakeholder_role_id, s.stakeholder_group_id, s.status, count(*)::int as count
     from assessment_sessions s
     left join assessment_participants p on p.session_id = s.id
     where s.assessment_id = $1
       and coalesce(p.is_active, true) = true
     group by s.stakeholder_role_id, s.stakeholder_group_id, s.status`,
    [assessment.id]
  );
  const completedRoles = new Set(sessions.rows.filter((row) => ["completed", "analyzed"].includes(row.status)).map((row) => row.stakeholder_role_id).filter(Boolean));
  const completedGroups = new Set(sessions.rows.filter((row) => ["completed", "analyzed"].includes(row.status)).map((row) => row.stakeholder_group_id).filter(Boolean));
  const domainCoverageRows = await client.query(
    `select distinct q.business_domain
     from responses r
     join assessment_sessions s on s.id = r.assessment_session_id
     join questions q on q.id = r.question_id
     where s.assessment_id = $1 and s.status in ('completed', 'analyzed')`,
    [assessment.id]
  );
  const coveredDomains = new Set(domainCoverageRows.rows.map((row) => row.business_domain).filter(Boolean));

  const findingStats = await client.query(
    `select
       count(*)::int as finding_count,
       coalesce(avg(confidence), 0)::numeric as average_confidence,
       coalesce(sum(evidence_count), 0)::int as evidence_count,
       count(*) filter (where contradiction_detected = true)::int as contradiction_count,
       count(*) filter (where contradiction_detected = true and status = 'Draft')::int as unresolved_contradictions
     from findings
     where assessment_id = $1 and status <> 'Rejected'`,
    [assessment.id]
  );
  const stats = findingStats.rows[0] || {};

  const measuredKpis = await client.query(
    `select kpi_definition_id
     from project_kpi_measurements
     where assessment_project_id = $1 and measurement_status in ('measured', 'estimatable')`,
    [projectId]
  );
  const measuredKpiIds = new Set(measuredKpis.rows.map((row) => row.kpi_definition_id));
  const coveredKpiSets = blueprintShape.requiredKpiSets.filter((setName) =>
    (blueprintKpiSetMap[setName] || []).some((kpiId) => measuredKpiIds.has(kpiId))
  );

  const roleCompletionRatio = (roles) => roles.length ? roles.filter((role) => completedRoles.has(role.id)).length / roles.length : 1;
  const requiredRoleCompletion = roleCompletionRatio(requiredRoles);
  const recommendedRoleCompletion = roleCompletionRatio(recommendedRoles);
  const optionalRoleCompletion = roleCompletionRatio(optionalRoles);
  const kpiCoverage = blueprintShape.requiredKpiSets.length ? coveredKpiSets.length / blueprintShape.requiredKpiSets.length : 1;
  const domainCoverage = blueprintShape.requiredBusinessDomains.length
    ? blueprintShape.requiredBusinessDomains.filter((domain) => coveredDomains.has(domain)).length / blueprintShape.requiredBusinessDomains.length
    : 1;
  const completenessScore = Math.min(100, Math.round(
    requiredRoleCompletion * 60 +
    recommendedRoleCompletion * 25 +
    kpiCoverage * 10 +
    domainCoverage * 5 +
    optionalRoleCompletion * 5
  ));

  const averageFindingConfidenceScore = Math.min(100, Math.round((Number(stats.average_confidence || 0) / 5) * 100));
  const evidenceDensityScore = Math.min(100, Math.round((Number(stats.evidence_count || 0) / Math.max(1, Number(stats.finding_count || 1) * 2)) * 100));
  const groupDiversityScore = Math.min(100, Math.round((completedGroups.size / 5) * 100));
  const contradictionReviewScore = Number(stats.unresolved_contradictions || 0) ? 40 : 100;
  const confidenceScore = Math.round(
    groupDiversityScore * 0.25 +
    averageFindingConfidenceScore * 0.25 +
    evidenceDensityScore * 0.20 +
    Math.round(kpiCoverage * 100) * 0.15 +
    contradictionReviewScore * 0.15
  );

  const coverageGaps = [];
  for (const role of requiredRoles) {
    if (!completedRoles.has(role.id)) {
      coverageGaps.push({
        type: "missing_required_stakeholder",
        role: role.id,
        role_name: role.name,
        reason: `${role.name} is required by Organization Profile but no completed assessment session exists.`,
        impact: `${role.stakeholder_group_name} visibility is incomplete.`,
        severity: "high"
      });
    }
  }
  for (const role of recommendedRoles) {
    if (!completedRoles.has(role.id)) {
      coverageGaps.push({
        type: "missing_recommended_stakeholder",
        role: role.id,
        role_name: role.name,
        reason: `${role.name} is recommended by Organization Profile but has not completed an assessment.`,
        impact: "Findings may be directionally useful but less complete.",
        severity: "medium"
      });
    }
  }
  for (const setName of blueprintShape.requiredKpiSets) {
    if (!coveredKpiSets.includes(setName)) {
      coverageGaps.push({
        type: "missing_required_kpi_set",
        kpi_set: setName,
        reason: `${setName} is required by Organization Profile but no measured or estimatable KPI record exists yet.`,
        impact: "Assessment confidence is lower because KPI evidence is missing.",
        severity: "high"
      });
    }
  }
  for (const domain of blueprintShape.requiredBusinessDomains) {
    if (!coveredDomains.has(domain)) {
      coverageGaps.push({
        type: "missing_business_domain",
        business_domain: domain,
        reason: `${domain} is required by Organization Profile but has no completed response coverage yet.`,
        impact: "Domain-level analysis is incomplete.",
        severity: "medium"
      });
    }
  }
  if (Number(stats.finding_count || 0) > 0 && Number(stats.evidence_count || 0) / Math.max(1, Number(stats.finding_count || 0)) < 1.5) {
    coverageGaps.push({
      type: "low_evidence_density",
      reason: "Findings have fewer than 1.5 evidence records on average.",
      impact: "Recommendations may need more validation before executive decisions.",
      severity: "medium"
    });
  }
  if (Number(stats.unresolved_contradictions || 0) > 0) {
    coverageGaps.push({
      type: "unresolved_contradiction",
      reason: `${stats.unresolved_contradictions} contradiction finding(s) still require review.`,
      impact: "Executive confidence should be limited until misalignment is reviewed.",
      severity: "high"
    });
  }

  const blueprint = {
    company_id: projectId,
    assessment_id: assessment.id,
    required_stakeholder_roles: requiredRoles,
    recommended_stakeholder_roles: recommendedRoles,
    optional_stakeholder_roles: optionalRoles,
    not_applicable_roles: existingNotApplicable,
    required_question_banks: requiredQuestionBanks,
    recommended_question_banks: recommendedQuestionBanks,
    optional_question_banks: optionalQuestionBanks,
    required_kpi_sets: blueprintShape.requiredKpiSets,
    required_business_domains: blueprintShape.requiredBusinessDomains,
    assessment_completeness_score: completenessScore,
    assessment_confidence_score: confidenceScore,
    coverage_gaps: coverageGaps,
    completed_stakeholder_roles: [...completedRoles].map((roleId) => roleBlueprintObject(roleId)),
    completed_stakeholder_groups: [...completedGroups].map((groupId) => ({ id: groupId, name: stakeholderGroupName(groupId) })),
    covered_kpi_sets: coveredKpiSets,
    covered_business_domains: [...coveredDomains],
    generated_at: new Date().toISOString()
  };

  if (!persist) return blueprint;

  const saved = await client.query(
    `insert into assessment_blueprints
      (assessment_project_id, assessment_id, required_stakeholder_roles, recommended_stakeholder_roles, optional_stakeholder_roles, not_applicable_roles,
       required_question_banks, recommended_question_banks, optional_question_banks, required_kpi_sets, required_business_domains,
       assessment_completeness_score, assessment_confidence_score, coverage_gaps, blueprint, generated_at)
     values ($1, $2, $3::jsonb, $4::jsonb, $5::jsonb, $6::jsonb, $7::jsonb, $8::jsonb, $9::jsonb, $10::jsonb, $11::jsonb, $12, $13, $14::jsonb, $15::jsonb, now())
     on conflict (assessment_project_id) do update set
       assessment_id = excluded.assessment_id,
       required_stakeholder_roles = excluded.required_stakeholder_roles,
       recommended_stakeholder_roles = excluded.recommended_stakeholder_roles,
       optional_stakeholder_roles = excluded.optional_stakeholder_roles,
       required_question_banks = excluded.required_question_banks,
       recommended_question_banks = excluded.recommended_question_banks,
       optional_question_banks = excluded.optional_question_banks,
       required_kpi_sets = excluded.required_kpi_sets,
       required_business_domains = excluded.required_business_domains,
       assessment_completeness_score = excluded.assessment_completeness_score,
       assessment_confidence_score = excluded.assessment_confidence_score,
       coverage_gaps = excluded.coverage_gaps,
       blueprint = excluded.blueprint,
       generated_at = now(),
       updated_at = now()
     returning *`,
    [
      projectId,
      assessment.id,
      JSON.stringify(requiredRoles),
      JSON.stringify(recommendedRoles),
      JSON.stringify(optionalRoles),
      JSON.stringify(existingNotApplicable),
      JSON.stringify(requiredQuestionBanks),
      JSON.stringify(recommendedQuestionBanks),
      JSON.stringify(optionalQuestionBanks),
      JSON.stringify(blueprintShape.requiredKpiSets),
      JSON.stringify(blueprintShape.requiredBusinessDomains),
      completenessScore,
      confidenceScore,
      JSON.stringify(coverageGaps),
      JSON.stringify({ assessment_blueprint: blueprint })
    ]
  );
  return mapAssessmentBlueprintRow(saved.rows[0]);
}

async function generateAssessmentBlueprint(projectId) {
  const client = await requireDatabase().connect();
  try {
    return await calculateAssessmentBlueprint(client, projectId, { persist: true });
  } finally {
    client.release();
  }
}

async function createBlueprintSessions(projectId, level = "required") {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const blueprint = await calculateAssessmentBlueprint(client, projectId, { persist: true });
    const assessment = await getOrCreateAssessment(client, projectId);
    const key = level === "recommended" ? "recommended_stakeholder_roles" : "required_stakeholder_roles";
    const roles = blueprint[key] || [];
    const created = [];
    for (const role of roles) {
      const existing = await client.query(
        `select id from assessment_sessions
         where assessment_id = $1 and stakeholder_role_id = $2 and status in ('started', 'completed', 'analyzed')
         limit 1`,
        [assessment.id, role.id]
      );
      if (existing.rowCount) continue;
      const inserted = await client.query(
        `insert into assessment_sessions
          (assessment_id, stakeholder_role, stakeholder_group_id, stakeholder_role_id, respondent_name, respondent_email, status)
         values ($1, $2, $3, $4, $5, null, 'started')
         returning *`,
        [assessment.id, role.name, role.stakeholder_group_id, role.id, `${role.name} Respondent`]
      );
      created.push(inserted.rows[0]);
    }
    const refreshed = await calculateAssessmentBlueprint(client, projectId, { persist: true });
    await client.query("commit");
    return { createdSessions: created, blueprint: refreshed };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function markBlueprintRoleNotApplicable(projectId, roleId, reason = "") {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    const existing = await getCurrentAssessmentBlueprint(client, projectId);
    const list = existing?.not_applicable_roles || [];
    const next = [
      ...list.filter((item) => String(item.role_id || item.id || item) !== String(roleId)),
      {
        role_id: roleId,
        role_name: stakeholderRoleName(roleId),
        reason: reason || "Marked not applicable by admin.",
        marked_at: new Date().toISOString()
      }
    ];
    await client.query(
      `insert into assessment_blueprints (assessment_project_id, not_applicable_roles)
       values ($1, $2::jsonb)
       on conflict (assessment_project_id) do update set not_applicable_roles = excluded.not_applicable_roles, updated_at = now()`,
      [projectId, JSON.stringify(next)]
    );
    const refreshed = await calculateAssessmentBlueprint(client, projectId, { persist: true });
    await client.query("commit");
    return refreshed;
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

function isValidParticipantEmail(email = "") {
  if (!email) return true;
  const normalized = String(email).trim().toLowerCase();
  if (normalized.endsWith("@deriveglobal.com")) return false;
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalized);
}

