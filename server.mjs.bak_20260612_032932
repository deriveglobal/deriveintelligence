function createParticipantTemplateWorkbook() {
  const workbook = XLSX.utils.book_new();
  const sheet = XLSX.utils.json_to_sheet(participantTemplateRows);
  XLSX.utils.book_append_sheet(workbook, sheet, "Participants");
  return XLSX.write(workbook, { bookType: "xlsx", type: "buffer" });
}

function parseParticipantWorkbook(base64) {
  const buffer = Buffer.from(String(base64 || ""), "base64");
  const workbook = XLSX.read(buffer, { type: "buffer" });
  const sheetName = workbook.SheetNames[0];
  if (!sheetName) return [];
  const rows = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName], { defval: "" });
  return rows.map((row) => ({
    stakeholder: normalizeStakeholderCode(row.stakeholder || row.Stakeholder || row.stakeholder_type || row["Stakeholder Type"]),
    fullName: String(row.full_name || row.name || row["Full Name"] || row.Name || "").trim(),
    email: normalizeEmail(row.email || row.Email || ""),
    company: String(row.company || row.Company || "").trim(),
    department: String(row.department || row.Department || row.context || row.Context || "").trim(),
    title: String(row.title || row.Title || row.role || row.Role || "").trim(),
    language: String(row.language || row.Language || "tr").trim().toLowerCase() === "en" ? "en" : "tr",
    notes: String(row.notes || row.Notes || "").trim()
  })).filter((row) => row.fullName && (!row.email || isEmail(row.email)));
}

async function importProjectParticipants(payload) {
  const context = await getDefaultContext({ projectId: payload.projectId, department: "General" });
  const rows = parseParticipantWorkbook(payload.fileBase64);
  const client = await requireDatabase().connect();
  let imported = 0;
  try {
    await client.query("begin");
    for (const row of rows) {
      await client.query(
        `insert into project_participants
          (organization_id, assessment_project_id, stakeholder_code, full_name, email, company, department, title, language_code, notes, source, status)
         values ($1, $2, $3, $4, nullif($5, ''), $6, $7, $8, $9, $10, 'excel', 'active')
         on conflict (assessment_project_id, email) do update set
           stakeholder_code = excluded.stakeholder_code,
           full_name = excluded.full_name,
           company = excluded.company,
           department = excluded.department,
           title = excluded.title,
           language_code = excluded.language_code,
           notes = excluded.notes,
           status = 'active',
           source = 'excel',
           updated_at = now()`,
        [context.organizationId, context.projectId, row.stakeholder, row.fullName, row.email, row.company, row.department, row.title, row.language, row.notes]
      );
      imported += 1;
    }
    await client.query("commit");
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
  return {
    imported,
    participants: await listProjectParticipants(context.projectId)
  };
}

