  try {
    await client.query("begin");
    const existing = await client.query("select * from users where id = $1 limit 1", [userId]);
    if (!existing.rowCount) throw new Error("User not found.");
    const user = await client.query(
      `update users
       set full_name = coalesce($2, full_name),
           name = coalesce($2, name),
           status = coalesce($3, status),
           role = coalesce($4, role),
           updated_at = now()
       where id = $1
       returning *`,
      [userId, payload.name || null, status, role]
    );
    if (role) {
      await client.query(
        `insert into organization_memberships (organization_id, user_id, role, status)
         values ($1, $2, $3, coalesce($4, 'active'))
         on conflict (organization_id, user_id) do update set role = excluded.role, status = excluded.status`,
        [context.organizationId, userId, legacyRole, status]
      );
      await client.query(
        `insert into project_memberships (organization_id, assessment_project_id, user_id, role, status)
         values ($1, $2, $3, $4, coalesce($5, 'active'))
         on conflict (assessment_project_id, user_id) do update
         set role = excluded.role, status = excluded.status, updated_at = now()`,
        [context.organizationId, context.projectId, userId, legacyRole, status]
      );
      await client.query(
        `insert into company_user_assignments (user_id, company_id, role, is_active)
         values ($1, $2, $3, $4)
         on conflict (user_id, company_id, role) do update set is_active = excluded.is_active, updated_at = now()`,
        [userId, context.projectId, role, status !== "disabled"]
      );
      if (role === "consultant") {
        await client.query(
          `insert into consultant_company_assignments (consultant_user_id, company_id, is_active, revoked_at)
           values ($1, $2, $3, case when $3 then null else now() end)
           on conflict (consultant_user_id, company_id) do update
           set is_active = excluded.is_active, revoked_at = excluded.revoked_at`,
          [userId, context.projectId, status !== "disabled"]
        );
      }
    } else if (status) {
      await client.query(
        "update organization_memberships set status = $2 where user_id = $1 and organization_id = $3",
        [userId, status, context.organizationId]
      );
      await client.query(
        "update project_memberships set status = $2, updated_at = now() where user_id = $1 and assessment_project_id = $3",
        [userId, status, context.projectId]
      );
      await client.query(
        "update company_user_assignments set is_active = $3, updated_at = now() where user_id = $1 and company_id = $2",
        [userId, context.projectId, status !== "disabled"]
      );
      await client.query(
        "update consultant_company_assignments set is_active = $3, revoked_at = case when $3 then null else now() end where consultant_user_id = $1 and company_id = $2",
        [userId, context.projectId, status !== "disabled"]
      );
    }
    if (status === "disabled") {
      await client.query("update user_sessions set revoked_at = now() where user_id = $1 and revoked_at is null", [userId]);
    }
    await client.query("commit");
    return mapUser({
      ...user.rows[0],
      organization_id: context.organizationId,
      company_id: context.projectId,
      assessment_project_id: context.projectId,
      assignment_role: role,
      project_role: legacyRole,
      membership_status: status || "active"
    });
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

