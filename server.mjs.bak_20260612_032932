async function previewAssessmentParticipantUpload(assessmentId, payload = {}, session = {}) {
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    await seedOperationsManagerQuestions(client);
    const assessment = await client.query("select * from assessments where id = $1 limit 1", [assessmentId]);
    if (!assessment.rowCount) {
      const error = new Error("Assessment not found.");
      error.statusCode = 404;
      throw error;
    }
    const rawRows = parseAssessmentParticipantUpload(payload).filter((row) =>
      Object.entries(row).some(([key, value]) => key !== "__rowNumber" && String(value || "").trim())
    );
    const allColumns = new Set();
    rawRows.forEach((row) => Object.keys(row).forEach((key) => {
      if (key !== "__rowNumber") allColumns.add(key);
    }));
    const unknownColumns = [...allColumns].filter((column) => !assessmentParticipantUploadColumns.includes(column));
    const normalizedRows = rawRows.map(normalizeUploadRow);
    const emails = [...new Set(normalizedRows.map((row) => row.email).filter(Boolean))];
    const existingRows = emails.length
      ? await client.query(
          `select participant_id, email, stakeholder_role_id, status, is_active
           from assessment_participants
           where assessment_id = $1 and lower(email) = any($2::text[])`,
          [assessmentId, emails]
        )
      : { rows: [] };
    const existingByEmail = existingRows.rows.reduce((acc, row) => {
      const key = String(row.email || "").toLowerCase();
      acc[key] = acc[key] || [];
      acc[key].push(row);
      return acc;
    }, {});
    const seenSameRole = new Set();
    const seenRolesByEmail = new Map();
    const previewRows = normalizedRows.map((row) => {
      const issues = [];
      const warnings = [];
      const hasName = Boolean(row.full_name || row.first_name || row.last_name);
      if (!hasName) issues.push("Name is required.");
      if (row.email && !isValidParticipantEmail(row.email)) issues.push("Email is invalid.");
      if (!row.stakeholder_role_id) issues.push(`Stakeholder role could not be mapped from "${row.stakeholder_role_input || "blank"}".`);
      if (row.stakeholder_role_id && !blueprintQuestionBankMap[row.stakeholder_role_id]) issues.push("Mapped role does not have an active question bank.");
      const sameRoleKey = `${row.email || `row-${row.row_number}`}:${row.stakeholder_role_id}`;
      const existingForEmail = existingByEmail[row.email] || [];
      const activeSameRole = existingForEmail.find((item) => item.is_active !== false && item.stakeholder_role_id === row.stakeholder_role_id);
      const deactivatedSameRole = existingForEmail.find((item) => item.is_active === false && item.stakeholder_role_id === row.stakeholder_role_id);
      const duplicateInFile = row.email && row.stakeholder_role_id && seenSameRole.has(sameRoleKey);
      const priorUploadRolesForEmail = row.email ? (seenRolesByEmail.get(row.email) || new Set()) : new Set();
      if (duplicateInFile || activeSameRole) {
        warnings.push("This person is already added for the same stakeholder role.");
      }
      if (deactivatedSameRole) warnings.push("Previously deactivated participant exists.");
      if (row.email && row.stakeholder_role_id) seenSameRole.add(sameRoleKey);
      if (row.email && row.stakeholder_role_id) {
        const nextRoles = seenRolesByEmail.get(row.email) || new Set();
        nextRoles.add(row.stakeholder_role_id);
        seenRolesByEmail.set(row.email, nextRoles);
      }
      let status = "Ready";
      if (issues.length) status = "Invalid";
      else if (warnings.length) status = "Warning";
      return { ...row, status, issues, warnings };
    });
    const summary = {
      rows_uploaded: previewRows.length,
      valid_count: previewRows.filter((row) => row.status === "Ready").length,
      warning_count: previewRows.filter((row) => row.status === "Warning").length,
      invalid_count: previewRows.filter((row) => row.status === "Invalid").length,
      duplicate_count: 0,
      unknown_columns: unknownColumns
    };
    const preview = { rows: previewRows, ...summary };
    const batch = await client.query(
      `insert into participant_upload_batches (assessment_id, company_id, uploaded_by, filename, status, preview_json)
       values ($1, $2, $3, $4, 'previewed', $5::jsonb)
       returning upload_batch_id, created_at`,
      [assessmentId, assessment.rows[0].company_id, session.userId || null, payload.fileName || payload.filename || null, JSON.stringify(preview)]
    );
    return {
      upload_batch_id: batch.rows[0].upload_batch_id,
      created_at: batch.rows[0].created_at,
      ...preview
    };
  } finally {
    client.release();
  }
}

async function importAssessmentParticipantBatch(assessmentId, payload = {}) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    const batch = await client.query(
      `select * from participant_upload_batches
       where upload_batch_id = $1 and assessment_id = $2
       limit 1`,
      [payload.uploadBatchId || payload.upload_batch_id, assessmentId]
    );
    if (!batch.rowCount) {
      const error = new Error("Upload batch not found.");
      error.statusCode = 404;
      throw error;
    }
    const preview = batch.rows[0].preview_json || {};
    const rows = Array.isArray(preview.rows) ? preview.rows : [];
    let imported = 0;
    let skipped_duplicates = 0;
    let skipped_invalid = 0;
    let skipped_warnings = 0;
    const imported_participant_ids = [];
    const assessment = await client.query("select company_id from assessments where id = $1 limit 1", [assessmentId]);
    for (const row of rows) {
      if (row.status === "Invalid") {
        skipped_invalid += 1;
        continue;
      }
      if (row.status === "Warning" && !payload.allowWarnings) {
        skipped_warnings += 1;
        continue;
      }
      const duplicate = row.email
        ? await client.query(
            `select participant_id from assessment_participants
             where assessment_id = $1 and lower(email) = lower($2) and stakeholder_role_id = $3 and is_active = true
             limit 1`,
            [assessmentId, row.email, row.stakeholder_role_id]
          )
        : { rowCount: 0 };
      if (duplicate.rowCount && !payload.allowWarnings && !payload.allowDuplicate) {
        skipped_warnings += 1;
        continue;
      }
      const fullName = participantFullName(row);
      const inserted = await client.query(
        `insert into assessment_participants
          (company_id, assessment_id, stakeholder_group_id, stakeholder_role_id, first_name, last_name, full_name, email, department, location, notes, status, is_active)
         values ($1, $2, $3, $4, $5, $6, $7, nullif($8, ''), $9, $10, $11, 'not_invited', true)
         returning participant_id`,
        [
          assessment.rows[0].company_id,
          assessmentId,
          row.stakeholder_group_id,
          row.stakeholder_role_id,
          row.first_name || null,
          row.last_name || null,
          fullName,
          row.email || "",
          row.department || null,
          row.location || null,
          row.notes || null
        ]
      );
      imported += 1;
      imported_participant_ids.push(inserted.rows[0].participant_id);
    }
    await client.query(
      `update participant_upload_batches
       set status = 'imported', imported_at = now()
       where upload_batch_id = $1`,
      [batch.rows[0].upload_batch_id]
    );
    await client.query("commit");
    return {
      rows_uploaded: rows.length,
      valid_rows: rows.filter((row) => row.status === "Ready" || row.status === "Warning").length,
      imported_participants: imported,
      warnings: preview.warning_count || 0,
      invalid_rows: preview.invalid_count || 0,
      duplicates_skipped: skipped_duplicates,
      warnings_skipped: skipped_warnings,
      invalid_skipped: skipped_invalid,
      imported_participant_ids,
      participantState: await listAssessmentParticipants(assessmentId)
    };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function createAssessmentParticipantSessionsBulk(assessmentId) {
  const participantsState = await listAssessmentParticipants(assessmentId);
  const participants = participantsState.participants.filter((participant) =>
    participant.is_active && participant.status !== "deactivated" && !participant.session_id
  );
  let created = 0;
  let skipped = 0;
  const errors = [];
  for (const participant of participants) {
    try {
      await createParticipantAssessmentSession(participant.participant_id);
      created += 1;
    } catch (error) {
      skipped += 1;
      errors.push({ participant_id: participant.participant_id, error: error.message });
    }
  }
  return {
    created_sessions: created,
    skipped,
    errors,
    participantState: await listAssessmentParticipants(assessmentId)
  };
}

async function generateParticipantAccessLink(participantId, origin) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    const participant = await client.query("select * from assessment_participants where participant_id = $1 limit 1", [participantId]);
    if (!participant.rowCount) {
      const error = new Error("Participant not found.");
      error.statusCode = 404;
      throw error;
    }
    const row = participant.rows[0];
    if (!row.is_active || row.status === "deactivated") {
      const error = new Error("Cannot generate a link for a deactivated participant.");
      error.statusCode = 400;
      throw error;
    }
    let sessionId = row.session_id;
    if (!sessionId) {
      const created = await createParticipantAssessmentSession(participantId);
      sessionId = created.session?.id || created.participant?.session_id;
    }
    await client.query(
      "update assessment_access_tokens set is_active = false where participant_id = $1 and is_active = true",
      [participantId]
    );
    const rawToken = randomBytes(32).toString("hex");
    const tokenHash = hashAssessmentAccessToken(rawToken);
    const token = await client.query(
      `insert into assessment_access_tokens (participant_id, session_id, token, raw_token, expires_at)
       values ($1, $2, $3, $4, now() + interval '90 days')
       returning *`,
      [participantId, sessionId, tokenHash, rawToken]
    );
    await client.query(
      `update assessment_participants
       set status = case when status = 'completed' then status else 'invited' end,
           updated_at = now(),
           invitation_token_id = $2
       where participant_id = $1`,
      [participantId, token.rows[0].token_id]
    );
    await client.query("commit");
    return {
      token_id: token.rows[0].token_id,
      participant_id: participantId,
      session_id: sessionId,
      access_link: `${origin.replace(/\/$/, "")}/respond/${rawToken}`,
      expires_at: token.rows[0].expires_at
    };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

