    total_actual_value: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.actual_value || 0), 0),
    total_estimated_time_savings: approvedRecommendations.reduce((sum, rec) => sum + Number(rec.estimated_time_savings || 0), 0),
