async function sendProjectContextIntake(payload, session, origin = "") {
  const intake = await createOrUpdateProjectContextIntake({ ...payload, status: "sent" }, session, origin);
  if (!isEmail(intake.recipientEmail)) {
    throw new Error("A valid recipient email is required.");
  }
  const project = await query("select client_display_name, name from assessment_projects where id = $1 limit 1", [intake.projectId]);
  const projectName = project.rows[0]?.client_display_name || project.rows[0]?.name || "Digital Transformation Assessment";
  const email = buildContextEmail(intake, projectName);
  await sendGraphMail({ to: intake.recipientEmail, subject: email.subject, body: email.body });
  await query("update project_context_intakes set status = 'sent', sent_at = now(), updated_at = now() where token = $1", [intake.token]);
  return { ...intake, status: "sent", sentAt: new Date().toISOString() };
}

