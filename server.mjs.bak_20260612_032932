    const domain = String(payload.domain || "").trim().toLowerCase();
    const classification = payload.classification && ["production", "demo", "qa", "internal"].includes(payload.classification)
      ? payload.classification
      : classifyOperationalDataRecord(organizationName, payload.name, payload.industry, payload.industryContext, domain);
    const existingOrg = await client.query(
      "select id, classification from organizations where lower(name) = lower($1) limit 1",
      [organizationName]
    );
    const organizationId = existingOrg.rowCount
      ? existingOrg.rows[0].id
      : (await client.query(
          "insert into organizations (name, industry, default_language, classification) values ($1, $2, $3, $4) returning id",
          [organizationName, payload.industry || "Digital Transformation", payload.defaultLanguage || "en", classification]
        )).rows[0].id;
    const projectClassification = existingOrg.rowCount ? existingOrg.rows[0].classification || classification : classification;
    const methodologyVersionId = await getOrCreateDefaultMethodologyVersion(client);
    const project = await client.query(
      `insert into assessment_projects
        (organization_id, methodology_version_id, name, client_display_name, industry_context, default_language, status, classification)
       values ($1, $2, $3, $4, $5, $6, 'active', $7)
       returning *`,
