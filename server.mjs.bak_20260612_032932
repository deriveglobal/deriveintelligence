  const approvedRecommendations = (dashboard.recommendations || [])
    .filter((rec) => isRecommendationVisibleStatus(rec.status, includeDrafts))
    .sort((a, b) => Number(b.priority_score || 0) - Number(a.priority_score || 0));
  const approvedRecommendationIds = new Set(approvedRecommendations.map((rec) => String(rec.id)));
