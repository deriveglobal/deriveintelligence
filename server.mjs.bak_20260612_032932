          recommendation.category,
          recommendation.description,
          JSON.stringify(expectedOutcomes),
          JSON.stringify(recommendation.dependencies || []),
          recommendation.effort <= 2 ? "Low" : recommendation.effort === 3 ? "Medium" : "High",
          recommendation.value >= 5 ? "Very High" : "High",
