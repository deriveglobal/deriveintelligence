  }
}

async function createDemoAssessment() {
  await deleteDemoAssessmentData();
  const client = await requireDatabase().connect();
  let projectId = null;
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    await seedOperationsManagerQuestions(client);
    await seedDemoQuestion(client, demoOwnerQuestion);
    const { project, organizationId } = await getOrCreateDemoProject(client);
    projectId = project.id;
    await upsertCompanyProfile({
      organizationId,
      projectId,
      contextData: demoCompanyContextData,
      submittedAt: new Date().toISOString()
    }, client);
    const assessment = await getOrCreateAssessment(client, projectId, demoAssessmentTitle);
    for (const sessionData of demoStakeholderResponses) {
      const role = resolveStakeholderRole(sessionData.roleId);
      const insertedSession = await client.query(
        `insert into assessment_sessions
          (assessment_id, stakeholder_role, stakeholder_group_id, stakeholder_role_id, respondent_name, respondent_email, status, completed_at)
         values ($1, $2, $3, $4, $5, $6, 'completed', now())
         returning id`,
        [assessment.id, role.name, role.stakeholder_group_id, role.id, sessionData.name, sessionData.email]
      );
      for (const [questionId, answerText] of sessionData.answers) {
        const question = await client.query("select * from questions where question_id = $1 limit 1", [questionId]);
        if (!question.rowCount) continue;
        const questionRow = question.rows[0];
        const scoreValue = ["numeric", "percentage", "currency", "time_duration"].includes(questionRow.response_type)
          ? (scoreAnswer(questionRow, answerText) ?? numericFromAnswer(answerText))
          : scoreAnswer(questionRow, answerText);
        await client.query(
          `insert into responses
            (assessment_session_id, question_id, stakeholder_group_id, stakeholder_role_id, answer_value, answer_text, score_value)
           values ($1, $2, $3, $4, $5::jsonb, $6, $7)`,
          [
            insertedSession.rows[0].id,
            questionRow.id,
            role.stakeholder_group_id,
            role.id,
            JSON.stringify({ answer: answerText, demo: true, questionId }),
            answerText,
            scoreValue
          ]
        );
      }
    }
    await client.query("commit");
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }

  await runAssessmentEngineAnalysis(projectId);
  await query(
    `update findings f
     set status = 'Approved', analyst_notes = coalesce(analyst_notes, 'Auto-approved for Tenant Demo: KRB.')
     from assessments a
     where f.assessment_id = a.id and a.company_id = $1`,
    [projectId]
  );
  await query(
    `update recommendations r
     set status = 'Approved', analyst_notes = coalesce(analyst_notes, 'Auto-approved for Tenant Demo: KRB.')
     from assessments a
     where r.assessment_id = a.id and a.company_id = $1`,
    [projectId]
  );
  const dashboard = await getAssessmentEngineDashboard(projectId);
  const project = await query(
    `select ap.*, o.name as organization_name, 0::int as response_count, 0::int as assignment_count
     from assessment_projects ap
     join organizations o on o.id = ap.organization_id
     where ap.id = $1`,
    [projectId]
  );
  return {
    project: mapProject(project.rows[0]),
    assessment: dashboard.assessment,
    dashboard,
    qa: {
      sessions: dashboard.sessions.length,
      findings: dashboard.findings.length,
      evidence: dashboard.evidence.length,
      approvedFindings: dashboard.findings.filter((finding) => finding.status === "Approved").length,
      approvedRecommendations: dashboard.recommendations.filter((recommendation) => isRecommendationVisibleStatus(recommendation.status)).length,
      missingKpis: dashboard.executivePreview.missingKpis.length,
      contradictions: dashboard.findings.filter((finding) => finding.contradiction_detected).length,
      roadmapItems: dashboard.roadmapItems.length
    }
  };
}

async function updateFindingReview(findingId, payload = {}) {
  const statusMap = {
    draft: "Draft",
    approved: "Approved",
    rejected: "Rejected",
    archived: "Archived"
  };
  const status = statusMap[String(payload.status || "").trim().toLowerCase()] || null;
  const result = await query(
    `update findings set
       title = coalesce($2, title),
       description = coalesce($3, description),
       severity = coalesce($4, severity),
       frequency = coalesce($5, frequency),
       confidence = coalesce($6, confidence),
       analyst_notes = coalesce($7, analyst_notes),
       status = coalesce($8, status)
     where id = $1
     returning *`,
    [
      findingId,
      payload.title || null,
      payload.description || null,
      payload.severity ? Number(payload.severity) : null,
      payload.frequency ? Number(payload.frequency) : null,
      payload.confidence ? Number(payload.confidence) : null,
      payload.analystNotes ?? payload.analyst_notes ?? null,
      status
    ]
  );
  if (!result.rowCount) {
    const error = new Error("Finding not found.");
    error.statusCode = 404;
    throw error;
  }
  return result.rows[0];
}

async function deleteFindingForCleanup(findingId) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const finding = await client.query(
      "select id, assessment_id, title from findings where id = $1 limit 1",
      [findingId]
    );
    if (!finding.rowCount) {
      const error = new Error("Finding not found.");
      error.statusCode = 404;
      throw error;
    }

    const recommendationIds = await client.query("select id from recommendations where finding_id = $1", [findingId]);
    const evidence = await client.query("delete from evidence where finding_id = $1", [findingId]);
    const roadmapItems = recommendationIds.rows.length
      ? await client.query("delete from roadmap_items where recommendation_id = any($1::uuid[])", [recommendationIds.rows.map((row) => row.id)])
      : { rowCount: 0 };
    const recommendations = await client.query("delete from recommendations where finding_id = $1", [findingId]);
    const deleted = await client.query("delete from findings where id = $1 returning id, title", [findingId]);

    await client.query("commit");
    return {
      deleted: true,
      finding: deleted.rows[0] || finding.rows[0],
      counts: {
        evidence: evidence.rowCount || 0,
        roadmap_items: roadmapItems.rowCount || 0,
        recommendations: recommendations.rowCount || 0,
        findings: deleted.rowCount || 0
      }
    };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function recordFindingConsultantFeedback(findingId, payload = {}, session = {}) {
  const action = String(payload.action || "").toLowerCase();
  if (!["approved", "rejected", "edited"].includes(action)) {
    const error = new Error("Invalid feedback action.");
    error.statusCode = 400;
    throw error;
  }

  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const result = await client.query(
      `select f.*, a.company_id, cp.industry
       from findings f
       join assessments a on a.id = f.assessment_id
       left join company_profiles cp on cp.assessment_project_id = a.company_id
       where f.id = $1
       limit 1`,
      [findingId]
    );
    if (!result.rowCount) {
      const error = new Error("Finding not found.");
      error.statusCode = 404;
      throw error;
    }

    const finding = result.rows[0];
    const industry = normalizeIndustry(finding.industry || "tire_fleet_service");
    const editedTitle = payload.edited_title || payload.editedTitle || null;
    const editedDescription = payload.edited_description || payload.editedDescription || null;
    const rejectionReason = payload.rejection_reason || payload.rejectionReason || null;

    await client.query(
      `insert into finding_consultant_feedback
        (finding_id, consultant_id, action, original_title, original_description,
         edited_title, edited_description, rejection_reason)
       values ($1, $2, $3, $4, $5, $6, $7, $8)`,
      [
        findingId,
        session.userId || null,
        action,
        finding.title,
        finding.description,
        editedTitle,
        editedDescription,
        rejectionReason
      ]
    );

    await updateAIAnalysisContext(industry, {
      action,
      finding,
      editedTitle,
      editedDescription,
      rejectionReason
    }, client);

    await client.query("commit");
    return { success: true, context_updated: true };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function mergeFindings(payload = {}) {
  const parentId = payload.parentFindingId || payload.parentId;
  const childIds = Array.isArray(payload.childFindingIds || payload.childIds) ? payload.childFindingIds || payload.childIds : [];
  if (!parentId || !childIds.length) {
    const error = new Error("Parent finding and child findings are required.");
    error.statusCode = 400;
    throw error;
  }
  const parent = await query("select id, cluster_key from findings where id = $1 limit 1", [parentId]);
  if (!parent.rowCount) {
    const error = new Error("Parent finding not found.");
    error.statusCode = 404;
    throw error;
  }
  const clusterKey = parent.rows[0].cluster_key || "manual_merge";
  await query(
    `update findings
     set parent_finding_id = $1,
         cluster_key = $2,
         status = 'Archived',
         analyst_notes = concat_ws(E'\n', analyst_notes, 'Merged into parent finding ' || $1::text)
     where id = any($3::uuid[]) and id <> $1`,
    [parentId, clusterKey, childIds]
  );
  return { ok: true };
}

async function updateRecommendationReview(recommendationId, payload = {}) {
  const statusMap = {
    draft: "Draft",
    proposed: "Proposed",
    approved: "Approved",
    accepted: "Accepted",
    rejected: "Rejected",
    in_progress: "In Progress",
    "in progress": "In Progress",
    completed: "Completed"
  };
  const normalizedStatus =
    statusMap[String(payload.status || "").toLowerCase().trim()] || payload.status;
  const allowedStatus = new Set(["Draft", "Proposed", "Approved", "Accepted", "Rejected", "In Progress", "Completed"]);
  const status = allowedStatus.has(normalizedStatus) ? normalizedStatus : null;
  const current = await query("select * from recommendations where id = $1", [recommendationId]);
  if (!current.rowCount) {
    const error = new Error("Recommendation not found.");
    error.statusCode = 404;
    throw error;
  }
  const existing = current.rows[0];
  const outcomeValues = {
    expected_value: payload.expectedValue ?? payload.expected_value ?? existing.expected_value ?? existing.estimated_business_value,
    actual_value: payload.actualValue ?? payload.actual_value ?? existing.actual_value,
    expected_time_savings: payload.expectedTimeSavings ?? payload.expected_time_savings ?? existing.expected_time_savings ?? existing.estimated_time_savings,
    actual_time_savings: payload.actualTimeSavings ?? payload.actual_time_savings ?? existing.actual_time_savings,
    expected_cost_savings: payload.expectedCostSavings ?? payload.expected_cost_savings ?? existing.expected_cost_savings ?? existing.estimated_cost_savings,
    actual_cost_savings: payload.actualCostSavings ?? payload.actual_cost_savings ?? existing.actual_cost_savings
  };
  const accuracyScore = calculateRecommendationAccuracyScore(outcomeValues);
  const result = await query(
    `update recommendations set
       title = coalesce($2, title),
       description = coalesce($3, description),
       expected_benefit = coalesce($4, expected_benefit),
       analyst_notes = coalesce($5, analyst_notes),
       status = coalesce($6, status),
       expected_value = coalesce($7, expected_value),
       actual_value = $8,
       expected_time_savings = coalesce($9, expected_time_savings),
       actual_time_savings = $10,
       expected_cost_savings = coalesce($11, expected_cost_savings),
       actual_cost_savings = $12,
       expected_outcome = coalesce($13, expected_outcome),
       actual_outcome = coalesce($14, actual_outcome),
       recommendation_accuracy_score = $15,
       outcome_notes = coalesce($16, outcome_notes),
       outcome_updated_at = case when $17::boolean then now() else outcome_updated_at end
     where id = $1
     returning *`,
    [
      recommendationId,
      payload.title || null,
      payload.description || null,
      payload.expectedBenefit ?? payload.expected_benefit ?? null,
      payload.analystNotes ?? payload.analyst_notes ?? null,
      status,
      payload.expectedValue ?? payload.expected_value ?? null,
      payload.actualValue ?? payload.actual_value ?? existing.actual_value,
      payload.expectedTimeSavings ?? payload.expected_time_savings ?? null,
      payload.actualTimeSavings ?? payload.actual_time_savings ?? existing.actual_time_savings,
      payload.expectedCostSavings ?? payload.expected_cost_savings ?? null,
      payload.actualCostSavings ?? payload.actual_cost_savings ?? existing.actual_cost_savings,
      payload.expectedOutcome ?? payload.expected_outcome ?? null,
      payload.actualOutcome ?? payload.actual_outcome ?? null,
      accuracyScore,
      payload.outcomeNotes ?? payload.outcome_notes ?? null,
      Boolean(
        status ||
        payload.actualValue !== undefined ||
        payload.actual_value !== undefined ||
        payload.actualTimeSavings !== undefined ||
        payload.actual_time_savings !== undefined ||
        payload.actualCostSavings !== undefined ||
        payload.actual_cost_savings !== undefined ||
        payload.actualOutcome !== undefined ||
        payload.actual_outcome !== undefined ||
        payload.outcomeNotes !== undefined ||
        payload.outcome_notes !== undefined
      )
    ]
  );
  if (!result.rowCount) {
    const error = new Error("Recommendation not found.");
    error.statusCode = 404;
    throw error;
  }
  return result.rows[0];
}

async function requireFindingProjectAccess(session, findingIds = []) {
  const ids = uniqueStrings((Array.isArray(findingIds) ? findingIds : [findingIds]).map((id) => String(id || "").trim()).filter(Boolean));
  if (!ids.length) {
    const error = new Error("Finding id is required.");
    error.statusCode = 400;
    throw error;
  }
  const result = await query(
    `select distinct a.company_id
     from findings f
     join assessments a on a.id = f.assessment_id
     where f.id = any($1::uuid[])`,
    [ids]
  );
  if (!result.rowCount) {
    const error = new Error("Finding not found.");
    error.statusCode = 404;
    throw error;
  }
  if (result.rowCount !== 1) {
    const error = new Error("Findings must belong to a single project.");
    error.statusCode = 400;
    throw error;
  }
  await requireProjectAccess(session, result.rows[0].company_id, ["consultant"]);
  return result.rows[0].company_id;
}

async function requireRecommendationProjectAccess(session, recommendationId) {
  const result = await query(
    `select a.company_id
     from recommendations r
     join assessments a on a.id = r.assessment_id
     where r.id = $1
     limit 1`,
    [recommendationId]
  );
  if (!result.rowCount) {
    const error = new Error("Recommendation not found.");
    error.statusCode = 404;
    throw error;
  }
  await requireProjectAccess(session, result.rows[0].company_id, ["consultant"]);
  return result.rows[0].company_id;
}

