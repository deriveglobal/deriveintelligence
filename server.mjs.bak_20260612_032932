}

function drawExecutiveBriefPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "What matters most");
  const criticalFindings = Number(data.criticalFindings || 0);
  drawMetricBox(doc, 50, y, 230, 82, criticalFindings, "Critical findings", criticalFindings ? PDF_REPORT_COLORS.risk : PDF_REPORT_COLORS.primary);
  drawMetricBox(doc, 315, y, 230, 82, data.recommendations.length, "Recommendations ready", PDF_REPORT_COLORS.opportunity);
  drawMetricBox(doc, 50, y + 98, 230, 82, data.kpiGaps.length, "KPI gaps found", PDF_REPORT_COLORS.gold);
  drawMetricBox(doc, 315, y + 98, 230, 82, data.assessment.date, "Assessment date", PDF_REPORT_COLORS.primary);
  y += 220;
  const summary = `${data.organization.name} completed a structured organizational assessment in ${reportMonthYear(data.assessment.rawDate)}. The analysis surfaced ${data.findings.length} findings, of which ${criticalFindings} require immediate attention. ${data.recommendations.length} recommendations have been prepared with clear owners and timelines.`;
  pdfWrappedText(doc, summary, 50, y, { size: 12, width: 490, lineGap: 5 });
  pdfFooter(doc, data, pageNumber);
}

function drawTopFindingsPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "Priority findings");
  const findings = data.findings.slice(0, 5);
  if (!findings.length) {
    pdfWrappedText(doc, "No approved findings are available for this report.", 50, y);
  }
  findings.forEach((finding, index) => {
    const color = severityColor(finding);
    doc.strokeColor(color).lineWidth(2).moveTo(50, y).lineTo(50, y + 76).stroke();
    doc.font("Helvetica-Bold").fontSize(10).fillColor(PDF_REPORT_COLORS.gold).text(String(index + 1).padStart(2, "0"), 62, y);
    doc.font("Helvetica-Bold").fontSize(13).fillColor(PDF_REPORT_COLORS.primary).text(cleanPdfText(finding.title || "Finding"), 92, y, { width: 430 });
    doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(finding.description, 250), 92, doc.y + 5, { width: 430, lineGap: 2 });
    const domain = formatDomainLabel(finding.business_domain || "Operations");
    const category = formatDomainLabel(finding.assessment_category || severityLabel(finding));
    doc.font("Helvetica").fontSize(9).fillColor(PDF_REPORT_COLORS.muted).text(`Domain: ${domain}${category ? ` | Category: ${category}` : ""}`, 92, doc.y + 6, { width: 430 });
    y += 92;
  });
  pdfFooter(doc, data, pageNumber);
}

function drawRecommendationsPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "Recommended actions");
  const byPhase = Object.fromEntries(PDF_PHASES.map((phase) => [phase, []]));
  for (const rec of data.recommendations) byPhase[normalizeReportPhase(rec.roadmap_phase)].push(rec);
  for (const phase of PDF_PHASES) {
    const items = byPhase[phase];
    if (!items.length) continue;
    doc.font("Helvetica-Bold").fontSize(10).fillColor(PDF_REPORT_COLORS.gold).text(phase.toUpperCase(), 50, y);
    y += 18;
    for (const rec of items.slice(0, 4)) {
      doc.font("Helvetica-Bold").fontSize(12).fillColor(PDF_REPORT_COLORS.primary).text(`- ${cleanPdfText(rec.title || "Recommendation")}`, 66, y, { width: 450 });
      y = doc.y + 3;
      doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text(`${rec.recommended_owner || "Executive sponsor"} - ${rec.estimated_timeline || "Timeline to confirm"}`, 78, y, { width: 430 });
      y = doc.y + 3;
      doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(rec.expected_outcome || rec.expected_operational_benefit || rec.description, 170), 78, y, { width: 430, lineGap: 2 });
      y = doc.y + 10;
      if (y > 710) break;
    }
  }
  pdfFooter(doc, data, pageNumber);
}

function drawRoadmapPage(doc, data, pageNumber) {
  const yStart = pdfSectionHeader(doc, "Implementation sequence");
  const columnWidth = 115;
  data.roadmap.forEach((phase, index) => {
    const x = 50 + index * 124;
    let y = yStart;
    doc.strokeColor(PDF_REPORT_COLORS.gold).lineWidth(1).moveTo(x, y).lineTo(x + columnWidth, y).stroke();
    doc.font("Helvetica-Bold").fontSize(9).fillColor(PDF_REPORT_COLORS.gold).text(phase.phase.toUpperCase(), x, y + 10, { width: columnWidth });
    y += 34;
    for (const item of phase.items.slice(0, 7)) {
      doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.primary).text(`- ${truncateReportText(item.title, 70)}`, x, y, { width: columnWidth, lineGap: 2 });
      y = doc.y + 8;
      if (y > 705) break;
    }
    if (!phase.items.length) {
      doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text("No approved items yet.", x, y, { width: columnWidth });
    }
  });
  pdfFooter(doc, data, pageNumber);
}

function drawNextStepsPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "What leadership should do next");
  const actions = data.recommendations.slice(0, 4);
  if (!actions.length) {
    actions.push({ title: "Complete consultant review", description: "Approve findings and recommendations before distributing this report." });
