  );
  return inserted.rows[0].id;
}

async function getDefaultContext({ projectId, templateId = "general", templateName = "General Survey", language = "en", department = "General" } = {}) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const existingProjectContext = await getProjectContext(client, projectId);
    const organizationId = existingProjectContext?.organizationId || await getOrCreateDefaultOrganization(client);
    const methodologyVersionId = existingProjectContext?.methodologyVersionId || await getOrCreateDefaultMethodologyVersion(client);
    const resolvedProjectId = existingProjectContext?.projectId || await getOrCreateDefaultProject(client, organizationId, methodologyVersionId);
    const departmentId = await getOrCreateDepartment(client, organizationId, resolvedProjectId, department);
    const surveyTemplateId = await getOrCreateSurveyTemplate(client, methodologyVersionId, templateId, templateName, language);
    await client.query("commit");
    return { organizationId, methodologyVersionId, projectId: resolvedProjectId, departmentId, surveyTemplateId };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

function mapProject(row) {
  return {
    id: row.id,
    organizationId: row.organization_id,
    organizationName: row.organization_name,
    classification: row.classification || row.project_classification || row.organization_classification || "production",
    organizationClassification: row.organization_classification || "production",
    projectClassification: row.project_classification || row.classification || "production",
    name: row.name,
    clientDisplayName: row.client_display_name,
    industryContext: row.industry_context,
    defaultLanguage: row.default_language,
    status: row.status,
    createdAt: row.created_at,
    responseCount: Number(row.response_count || 0),
    assignmentCount: Number(row.assignment_count || 0)
  };
}

async function listProjects(session = null) {
  await ensureAccessControlSchema();
  const params = [];
  const membershipJoin = session && normalizeRole(session.role) !== "platform_owner"
    ? `where exists (
         select 1 from project_memberships pm
         where pm.assessment_project_id = ap.id and pm.user_id = $1 and pm.status = 'active'
       )
       or exists (
         select 1 from company_user_assignments cua
         where cua.company_id = ap.id and cua.user_id = $1 and cua.is_active = true
       )
       or exists (
         select 1 from consultant_company_assignments cca
         where cca.company_id = ap.id and cca.consultant_user_id = $1 and cca.is_active = true
       )`
    : "";
  if (membershipJoin) params.push(session.userId);
  const result = await query(
    `select
       ap.*,
       o.name as organization_name,
       coalesce(o.classification, 'production') as organization_classification,
       coalesce(ap.classification, o.classification, 'production') as classification,
       count(distinct srs.id) as response_count,
       count(distinct sa.id) as assignment_count
     from assessment_projects ap
     join organizations o on o.id = ap.organization_id
     left join survey_response_sessions srs on srs.assessment_project_id = ap.id
     left join survey_assignments sa on sa.assessment_project_id = ap.id
     ${membershipJoin}
     group by ap.id, o.name, o.classification
     order by ap.created_at desc`,
    params
  );
  const role = normalizeRole(session?.role);
  let rows = result.rows;
  if (role === "consultant") {
    rows = rows.filter((row) => !["qa", "internal"].includes(row.classification || "production"));
  } else if (role && role !== "platform_owner") {
    rows = rows.filter((row) => (row.classification || "production") === "production");
  }
  if (!result.rowCount && (!session || normalizeRole(session.role) === "platform_owner")) {
    const context = await getDefaultContext({
      templateId: "operations-manager",
      templateName: "Operations Manager",
      language: "tr",
      department: "General"
    });
    const fallback = await query(
      `select
         ap.*,
         o.name as organization_name,
         coalesce(o.classification, 'production') as organization_classification,
         coalesce(ap.classification, o.classification, 'production') as classification,
         0 as response_count,
         0 as assignment_count
       from assessment_projects ap
       join organizations o on o.id = ap.organization_id
       where ap.id = $1`,
      [context.projectId]
    );
    return fallback.rows.map(mapProject);
  }
  return rows.map(mapProject);
}

function consultantLifecycleStatus(row = {}) {
  if (!row.assessment_id || !row.blueprint_id) return "Setup";
  if (Number(row.participants_total || 0) === 0 || Number(row.completed_sessions || 0) === 0) return "Collecting";
  if (Number(row.draft_findings || 0) > 0 || Number(row.draft_recommendations || 0) > 0 || Number(row.proposed_recommendations || 0) > 0) return "Review";
  if (Number(row.approved_findings || 0) > 0 && Number(row.approved_recommendations || 0) > 0) return "Executive Ready";
  return "Review";
}

function consultantAttentionItems(row = {}) {
  const items = [];
  const projectId = row.project_id;
  const assessmentId = row.assessment_id;
  if (!row.blueprint_id) {
    items.push({ type: "setup", label: "Blueprint missing", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.participants_total || 0) === 0) {
    items.push({ type: "missing_participants", label: "Missing participants", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.overdue_participants || 0) > 0) {
    items.push({ type: "overdue_participants", label: `${row.overdue_participants} overdue participant${Number(row.overdue_participants) === 1 ? "" : "s"}`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.completed_sessions || 0) > 0 && Number(row.findings_total || 0) === 0) {
    items.push({ type: "analysis_ready", label: "Analysis ready", severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  if (Number(row.draft_findings || 0) > 0) {
    items.push({ type: "findings_approval", label: `${row.draft_findings} finding${Number(row.draft_findings) === 1 ? "" : "s"} awaiting approval`, severity: "high", project_id: projectId, assessment_id: assessmentId, action_view: "findings" });
  }
  const recommendationReviewCount = Number(row.draft_recommendations || 0) + Number(row.proposed_recommendations || 0);
  if (recommendationReviewCount > 0) {
    items.push({ type: "recommendation_approval", label: `${recommendationReviewCount} recommendation${recommendationReviewCount === 1 ? "" : "s"} awaiting approval`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "opportunities" });
  }
  if (Number(row.report_ready || 0) > 0) {
    items.push({ type: "report_ready", label: "Executive report ready", severity: "low", project_id: projectId, assessment_id: assessmentId, action_view: "executive-report" });
  }
  if (Number(row.open_issues || 0) > 0) {
    items.push({ type: "open_issues", label: `${row.open_issues} open issue${Number(row.open_issues) === 1 ? "" : "s"}`, severity: "medium", project_id: projectId, assessment_id: assessmentId, action_view: "dashboard" });
  }
  return items;
}

async function getConsultantCommandCenter(session) {
  await ensureAccessControlSchema();
  const projects = await listProjects(session);
  if (!projects.length) {
    return {
      generated_at: new Date().toISOString(),
      assigned_organizations: [],
      needs_attention: [],
      my_queue: [],
      lifecycle_pipeline: {
        setup: 0,
        collection: 0,
        review: 0,
        recommendations: 0,
        executive_output: 0
      },
      reports_ready: [],
      open_issues: [],
      next_best_action: null
    };
  }
  const projectIds = projects.map((project) => project.id);
  const result = await query(
    `with latest_assessments as (
       select distinct on (a.company_id) a.*
       from assessments a
       where a.company_id = any($1::uuid[])
       order by a.company_id, a.created_at desc
     ),
     participant_counts as (
       select
         ap.assessment_id,
         count(*) filter (where ap.is_active = true and ap.status <> 'deactivated') as participants_total,
         count(*) filter (where ap.is_active = true and ap.status = 'completed') as completed_participants,
         count(*) filter (
           where ap.is_active = true
             and ap.status not in ('completed', 'deactivated')
             and (
               (ap.status = 'invited' and ap.invite_sent_at is not null and ap.invite_sent_at < now() - interval '3 days')
               or (ap.status = 'started' and ap.started_at is not null and ap.started_at < now() - interval '7 days')
             )
         ) as overdue_participants
       from assessment_participants ap
       group by ap.assessment_id
     ),
     session_counts as (
       select
         s.assessment_id,
         count(*) as sessions_total,
         count(*) filter (where s.status in ('completed', 'analyzed')) as completed_sessions
       from assessment_sessions s
       group by s.assessment_id
     ),
     finding_counts as (
       select
         f.assessment_id,
         count(*) as findings_total,
         count(*) filter (where f.status = 'Draft') as draft_findings,
         count(*) filter (where f.status = 'Approved') as approved_findings,
         count(*) filter (where f.priority_score >= 80 and f.status = 'Approved') as critical_findings
       from findings f
       group by f.assessment_id
     ),
     recommendation_counts as (
       select
         r.assessment_id,
         count(*) as recommendations_total,
         count(*) filter (where r.status = 'Draft') as draft_recommendations,
         count(*) filter (where r.status = 'Proposed') as proposed_recommendations,
         count(*) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')) as approved_recommendations,
         coalesce(sum(r.estimated_business_value) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')), 0) as estimated_value
       from recommendations r
       group by r.assessment_id
     ),
     roadmap_counts as (
       select ri.assessment_id, count(*) as roadmap_items
       from roadmap_items ri
       group by ri.assessment_id
     ),
     issue_counts as (
       select ki.assessment_id, count(*) filter (where ki.status in ('open', 'investigating', 'waiting')) as open_issues
       from krb_issues ki
       where ki.assessment_id is not null
       group by ki.assessment_id
     )
     select
       ap.id as project_id,
       ap.name as project_name,
       ap.client_display_name,
       ap.industry_context,
       ap.status as project_status,
       o.name as organization_name,
       la.id as assessment_id,
       la.title as assessment_name,
       la.status as assessment_status,
       la.created_at as assessment_created_at,
       ab.id as blueprint_id,
       ab.assessment_completeness_score,
       ab.assessment_confidence_score,
       coalesce(pc.participants_total, 0) as participants_total,
       coalesce(pc.completed_participants, 0) as completed_participants,
       coalesce(pc.overdue_participants, 0) as overdue_participants,
       coalesce(sc.sessions_total, 0) as sessions_total,
       coalesce(sc.completed_sessions, 0) as completed_sessions,
       coalesce(fc.findings_total, 0) as findings_total,
       coalesce(fc.draft_findings, 0) as draft_findings,
       coalesce(fc.approved_findings, 0) as approved_findings,
       coalesce(fc.critical_findings, 0) as critical_findings,
       coalesce(rc.recommendations_total, 0) as recommendations_total,
       coalesce(rc.draft_recommendations, 0) as draft_recommendations,
       coalesce(rc.proposed_recommendations, 0) as proposed_recommendations,
       coalesce(rc.approved_recommendations, 0) as approved_recommendations,
       coalesce(rc.estimated_value, 0) as estimated_value,
       coalesce(road.roadmap_items, 0) as roadmap_items,
       coalesce(ic.open_issues, 0) as open_issues
     from assessment_projects ap
     join organizations o on o.id = ap.organization_id
     left join latest_assessments la on la.company_id = ap.id
     left join assessment_blueprints ab on ab.assessment_project_id = ap.id
     left join participant_counts pc on pc.assessment_id = la.id
     left join session_counts sc on sc.assessment_id = la.id
     left join finding_counts fc on fc.assessment_id = la.id
     left join recommendation_counts rc on rc.assessment_id = la.id
     left join roadmap_counts road on road.assessment_id = la.id
     left join issue_counts ic on ic.assessment_id = la.id
     where ap.id = any($1::uuid[])
     order by ap.created_at desc`,
    [projectIds]
  );

  const projectMap = new Map(projects.map((project) => [String(project.id), project]));
  const assignedOrganizations = result.rows.map((row) => {
    const project = projectMap.get(String(row.project_id));
    const lifecycleStatus = consultantLifecycleStatus(row);
    const reportReady = Number(row.approved_findings || 0) > 0
      && Number(row.approved_recommendations || 0) > 0
      && Number(row.roadmap_items || 0) > 0;
    return {
      project_id: row.project_id,
      organization_name: row.client_display_name || row.organization_name || project?.clientDisplayName || "Organization",
      assessment_id: row.assessment_id,
      assessment_name: row.assessment_name || row.project_name || project?.name || "Assessment",
      framework_name: defaultFrameworkDisplayName,
      status: lifecycleStatus,
      project_status: row.project_status,
      completeness_score: Number(row.assessment_completeness_score || 0),
      confidence_score: Number(row.assessment_confidence_score || 0),
      participants_total: Number(row.participants_total || 0),
      completed_participants: Number(row.completed_participants || 0),
      overdue_participants: Number(row.overdue_participants || 0),
      sessions_total: Number(row.sessions_total || 0),
      completed_sessions: Number(row.completed_sessions || 0),
      findings_total: Number(row.findings_total || 0),
      draft_findings: Number(row.draft_findings || 0),
      approved_findings: Number(row.approved_findings || 0),
      critical_findings: Number(row.critical_findings || 0),
      recommendations_total: Number(row.recommendations_total || 0),
      draft_recommendations: Number(row.draft_recommendations || 0),
      proposed_recommendations: Number(row.proposed_recommendations || 0),
      approved_recommendations: Number(row.approved_recommendations || 0),
      estimated_value: Number(row.estimated_value || 0),
      roadmap_items: Number(row.roadmap_items || 0),
      open_issues: Number(row.open_issues || 0),
      report_ready: reportReady ? 1 : 0,
      attention_items: consultantAttentionItems({ ...row, report_ready: reportReady ? 1 : 0 })
    };
  });

  const needsAttention = assignedOrganizations.flatMap((organization) =>
    (organization.attention_items || []).map((item) => ({
      ...item,
      organization_name: organization.organization_name,
      assessment_name: organization.assessment_name
    }))
  );
  const priorityWeight = { high: 3, medium: 2, low: 1 };
  needsAttention.sort((a, b) => (priorityWeight[b.severity] || 0) - (priorityWeight[a.severity] || 0));
  const myQueue = needsAttention
    .filter((item) => ["analysis_ready", "findings_approval", "recommendation_approval", "report_ready", "missing_participants", "overdue_participants"].includes(item.type))
    .slice(0, 10)
    .map((item) => ({
      ...item,
      task: item.type === "analysis_ready" ? "Run analysis"
        : item.type === "findings_approval" ? "Review findings"
        : item.type === "recommendation_approval" ? "Approve recommendations"
        : item.type === "report_ready" ? "Generate or review executive report"
        : item.type === "missing_participants" ? "Follow up with assessment manager"
        : "Send reminder or follow up"
    }));
  const lifecyclePipeline = assignedOrganizations.reduce((totals, organization) => {
    if (organization.status === "Setup") totals.setup += 1;
    else if (organization.status === "Collecting") totals.collection += 1;
    else if (organization.status === "Review") {
      totals.review += organization.draft_findings || organization.findings_total ? 1 : 0;
      totals.recommendations += organization.draft_recommendations || organization.proposed_recommendations || organization.recommendations_total ? 1 : 0;
      if (!organization.draft_findings && !organization.draft_recommendations && !organization.proposed_recommendations) totals.review += 1;
    } else if (organization.status === "Executive Ready") totals.executive_output += 1;
    return totals;
  }, { setup: 0, collection: 0, review: 0, recommendations: 0, executive_output: 0 });

  return {
    generated_at: new Date().toISOString(),
    assigned_organizations: assignedOrganizations,
    needs_attention: needsAttention.slice(0, 12),
    my_queue: myQueue,
    lifecycle_pipeline: lifecyclePipeline,
    reports_ready: assignedOrganizations.filter((organization) => organization.report_ready).slice(0, 8),
    open_issues: needsAttention.filter((item) => item.type === "open_issues").slice(0, 8),
    next_best_action: myQueue[0] || needsAttention[0] || null
  };
}

function platformAttentionLabel(item = {}) {
  const labels = {
    missing_profile: "Organization profile missing",
    missing_blueprint: "Assessment blueprint missing",
    no_participants: "Assessment has no participants",
    overdue_participants: "Participants overdue",
    failed_invitation: "Failed invitation",
    failed_reminder: "Failed reminder",
    session_without_token: "Session without active link",
    analysis_ready: "Analysis ready",
    findings_pending: "Findings pending approval",
    recommendations_pending: "Recommendations pending approval",
    report_ready: "Executive report ready",
    critical_issue: "Critical issue open",
    high_issue: "High-priority issue open"
  };
  return labels[item.type] || "Needs attention";
}

function platformActionForAttention(item = {}) {
  if (item.type === "report_ready") return { label: "Open Report", view: "executive-report" };
  if (["findings_pending", "analysis_ready"].includes(item.type)) return { label: "Open Review", view: "findings" };
  if (item.type === "recommendations_pending") return { label: "Open Recommendations", view: "opportunities" };
  if (["failed_invitation", "failed_reminder", "session_without_token", "critical_issue", "high_issue"].includes(item.type)) return { label: "Open Operations", view: "operations-center" };
  if (["no_participants", "overdue_participants"].includes(item.type)) return { label: "Open Participants", view: "dashboard" };
  if (["missing_profile"].includes(item.type)) return { label: "Open Organization Profile", view: "context" };
  return { label: "Open Assessment", view: "dashboard" };
}

function classifyOperationalDataRecord(...parts) {
  const text = parts
    .filter((part) => part !== undefined && part !== null)
    .map((part) => String(part).toLowerCase())
    .join(" ");
  if (/(demo|sample)/.test(text)) return "demo";
  if (/(qa|test|chaos|validation)/.test(text)) return "qa";
  if (/(internal)/.test(text)) return "internal";
  return "production";
}

function emptyPlatformPipeline() {
  return { setup: 0, collecting: 0, review: 0, recommendations: 0, executive_ready: 0, completed: 0, at_risk: 0 };
}

function buildPlatformPipeline(organizations = [], attention = []) {
  return organizations.reduce((acc, org) => {
    if (org.stage === "Setup") acc.setup += 1;
    else if (org.stage === "Collecting") acc.collecting += 1;
    else if (org.stage === "Review") acc.review += 1;
    else if (org.stage === "Executive Ready") acc.executive_ready += 1;
    if (org.stage === "Executive Ready" && org.report_status === "Ready") acc.recommendations += 1;
    if (org.assessment_status === "completed") acc.completed += 1;
    if (org.completion_percent < 100 && (org.open_issues || attention.some((item) => item.project_id === org.project_id && ["critical", "high"].includes(item.severity)))) acc.at_risk += 1;
    return acc;
  }, emptyPlatformPipeline());
}

function platformClassificationMatch(item = {}, classification = "production") {
  if (classification === "all") return true;
  return (item.classification || "production") === classification;
}

function buildPlatformSnapshot({ classification = "production", organizationCounts = {}, organizations = [], attention = [], reportsReady = [], persistedIssues = [], generatedWarnings = [] } = {}) {
  const scopedOrganizations = organizations.filter((organization) => platformClassificationMatch(organization, classification));
  const scopedAttention = attention.filter((item) => platformClassificationMatch(item, classification));
  const scopedReports = reportsReady.filter((report) => platformClassificationMatch(report, classification));
  const scopedPersistedIssues = persistedIssues.filter((issue) => platformClassificationMatch(issue, classification));
  const scopedWarnings = generatedWarnings.filter((issue) => classification === "all" || !issue.classification || issue.classification === classification);
  const pipeline = buildPlatformPipeline(scopedOrganizations, scopedAttention);
  const counts = organizationCounts[classification] || { total_organizations: 0, active_organizations: 0 };
  return {
    classification,
    total_organizations: Number(counts.total_organizations || 0),
    active_organizations: Number(counts.active_organizations || 0),
    production_organizations: Number(organizationCounts.production?.active_organizations || 0),
    demo_organizations: Number(organizationCounts.demo?.active_organizations || 0),
    qa_organizations: Number(organizationCounts.qa?.active_organizations || 0),
    internal_organizations: Number(organizationCounts.internal?.active_organizations || 0),
    active_workspaces: scopedOrganizations.filter((organization) => organization.project_status === "active").length,
    active_assessments: scopedOrganizations.filter((organization) => ["active", "analysis"].includes(organization.assessment_status)).length,
    collecting_responses: pipeline.collecting,
    analysis_ready: scopedAttention.filter((item) => item.type === "analysis_ready").length,
    reports_ready: scopedReports.length,
    completed_assessments: pipeline.completed,
    overdue_participants: scopedOrganizations.reduce((sum, org) => sum + Number(org.overdue_participants || 0), 0),
    failed_invitations: scopedOrganizations.reduce((sum, org) => sum + Number(org.failed_invitations || 0), 0),
    failed_reminders: scopedOrganizations.reduce((sum, org) => sum + Number(org.failed_reminders || 0), 0),
    participants_without_usable_link: scopedOrganizations.reduce((sum, org) => sum + Number(org.participants_without_usable_link || 0), 0),
    open_issues: scopedPersistedIssues.length,
    generated_warnings: scopedWarnings.length,
    critical_issues: scopedPersistedIssues.filter((issue) => issue.severity === "critical").length,
    estimated_value_identified: scopedOrganizations.reduce((sum, org) => sum + Number(org.estimated_value || 0), 0),
    actual_value_realized: scopedOrganizations.reduce((sum, org) => sum + Number(org.actual_value || 0), 0)
  };
}

async function getPlatformCommandCenter() {
  await ensureAccessControlSchema();
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    const organizationCount = await client.query(`
      select
        classification,
        count(*)::int as total_organizations,
        count(*) filter (where status = 'active')::int as active_organizations
      from organizations
      group by classification
    `);
    const result = await client.query(`
      with latest_assessments as (
        select distinct on (a.company_id) a.*
        from assessments a
        order by a.company_id, a.created_at desc
      ),
      participant_counts as (
        select
          ap.assessment_id,
          count(*) filter (where ap.is_active = true and ap.status <> 'deactivated') as participants_total,
          count(*) filter (where ap.is_active = true and ap.status in ('invited', 'started', 'completed')) as participants_invited,
          count(*) filter (where ap.is_active = true and ap.status = 'started') as participants_started,
          count(*) filter (where ap.is_active = true and ap.status = 'completed') as participants_completed,
          count(*) filter (
            where ap.is_active = true
              and ap.status not in ('completed', 'deactivated')
              and (
                (ap.status = 'invited' and ap.invite_sent_at is not null and ap.invite_sent_at < now() - interval '3 days')
                or (ap.status = 'started' and ap.started_at is not null and ap.started_at < now() - interval '7 days')
              )
          ) as overdue_participants,
          count(*) filter (where ap.is_active = true and ap.email_status = 'failed') as failed_invitations,
          count(*) filter (where ap.is_active = true and ap.reminder_status = 'failed') as failed_reminders,
          max(greatest(coalesce(ap.updated_at, ap.created_at), coalesce(ap.completed_at, ap.created_at), coalesce(ap.last_invite_sent_at, ap.created_at), coalesce(ap.last_reminder_sent_at, ap.created_at))) as participant_last_activity
        from assessment_participants ap
        group by ap.assessment_id
      ),
      session_counts as (
        select
          s.assessment_id,
          count(*) as sessions_total,
          count(*) filter (where s.status in ('completed', 'analyzed')) as completed_sessions
        from assessment_sessions s
        group by s.assessment_id
      ),
      token_counts as (
        select
          p.assessment_id,
          count(*) filter (where t.is_active = true and t.expires_at > now()) as active_tokens,
          count(*) filter (where t.is_active = true and t.expires_at <= now()) as expired_tokens,
          count(*) filter (where p.session_id is not null and p.status not in ('completed', 'deactivated') and tok.participant_id is null) as sessions_without_tokens,
          count(distinct p.participant_id) filter (
            where p.session_id is not null
              and p.status not in ('completed', 'deactivated')
              and tok.participant_id is null
          ) as participants_without_usable_link
        from assessment_participants p
        left join assessment_access_tokens t on t.participant_id = p.participant_id
        left join (
          select distinct participant_id
          from assessment_access_tokens
          where is_active = true and expires_at > now()
        ) tok on tok.participant_id = p.participant_id
        group by p.assessment_id
      ),
      finding_counts as (
        select
          f.assessment_id,
          count(*) as findings_total,
          count(*) filter (where f.status = 'Draft') as draft_findings,
          count(*) filter (where f.status = 'Approved') as approved_findings,
          count(*) filter (where f.status = 'Approved' and f.priority_score >= 80) as critical_findings
        from findings f
        group by f.assessment_id
      ),
      recommendation_counts as (
        select
          r.assessment_id,
          count(*) as recommendations_total,
          count(*) filter (where r.status = 'Draft') as draft_recommendations,
          count(*) filter (where r.status = 'Proposed') as proposed_recommendations,
          count(*) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')) as approved_recommendations,
          coalesce(sum(r.estimated_business_value) filter (where r.status in ('Approved', 'Accepted', 'In Progress', 'Completed')), 0) as estimated_value,
          coalesce(sum(r.actual_value) filter (where r.status = 'Completed'), 0) as actual_value
        from recommendations r
        group by r.assessment_id
      ),
      roadmap_counts as (
        select assessment_id, count(*) as roadmap_items
        from roadmap_items
        group by assessment_id
      ),
      issue_counts as (
        select
          assessment_id,
          count(*) filter (where status in ('open', 'investigating', 'waiting')) as open_issues,
          count(*) filter (where status in ('open', 'investigating', 'waiting') and severity = 'critical') as critical_issues,
          count(*) filter (where status in ('open', 'investigating', 'waiting') and severity = 'high') as high_issues
        from krb_issues
        group by assessment_id
      ),
      consultants as (
        select
          cca.company_id,
          string_agg(distinct coalesce(u.name, u.full_name, u.email), ', ') as assigned_consultants
        from consultant_company_assignments cca
        join users u on u.id = cca.consultant_user_id
        where cca.is_active = true
        group by cca.company_id
      )
      select
        ap.id as project_id,
        ap.organization_id,
        ap.name as project_name,
        ap.client_display_name,
        ap.industry_context,
        ap.status as project_status,
        ap.created_at as project_created_at,
        o.name as organization_name,
        o.status as organization_status,
        coalesce(o.classification, 'production') as organization_classification,
        coalesce(ap.classification, o.classification, 'production') as project_classification,
        la.id as assessment_id,
        la.title as assessment_name,
        la.status as assessment_status,
        la.created_at as assessment_created_at,
        cp.id as company_profile_id,
        ab.id as blueprint_id,
        ab.assessment_completeness_score,
        ab.assessment_confidence_score,
        coalesce(pc.participants_total, 0) as participants_total,
        coalesce(pc.participants_invited, 0) as participants_invited,
        coalesce(pc.participants_started, 0) as participants_started,
        coalesce(pc.participants_completed, 0) as participants_completed,
        coalesce(pc.overdue_participants, 0) as overdue_participants,
        coalesce(pc.failed_invitations, 0) as failed_invitations,
        coalesce(pc.failed_reminders, 0) as failed_reminders,
        coalesce(sc.sessions_total, 0) as sessions_total,
        coalesce(sc.completed_sessions, 0) as completed_sessions,
        coalesce(tc.active_tokens, 0) as active_tokens,
        coalesce(tc.expired_tokens, 0) as expired_tokens,
        coalesce(tc.sessions_without_tokens, 0) as sessions_without_tokens,
        coalesce(tc.participants_without_usable_link, 0) as participants_without_usable_link,
        coalesce(fc.findings_total, 0) as findings_total,
        coalesce(fc.draft_findings, 0) as draft_findings,
        coalesce(fc.approved_findings, 0) as approved_findings,
        coalesce(fc.critical_findings, 0) as critical_findings,
        coalesce(rc.recommendations_total, 0) as recommendations_total,
        coalesce(rc.draft_recommendations, 0) as draft_recommendations,
        coalesce(rc.proposed_recommendations, 0) as proposed_recommendations,
        coalesce(rc.approved_recommendations, 0) as approved_recommendations,
        coalesce(rc.estimated_value, 0) as estimated_value,
        coalesce(rc.actual_value, 0) as actual_value,
        coalesce(road.roadmap_items, 0) as roadmap_items,
        coalesce(ic.open_issues, 0) as open_issues,
        coalesce(ic.critical_issues, 0) as critical_issues,
        coalesce(ic.high_issues, 0) as high_issues,
        consultants.assigned_consultants,
        greatest(
          coalesce(pc.participant_last_activity, ap.created_at),
          coalesce(la.created_at, ap.created_at),
          ap.updated_at
        ) as last_activity
      from assessment_projects ap
      join organizations o on o.id = ap.organization_id
      left join latest_assessments la on la.company_id = ap.id
      left join company_profiles cp on cp.assessment_project_id = ap.id
      left join assessment_blueprints ab on ab.assessment_project_id = ap.id
      left join participant_counts pc on pc.assessment_id = la.id
      left join session_counts sc on sc.assessment_id = la.id
      left join token_counts tc on tc.assessment_id = la.id
      left join finding_counts fc on fc.assessment_id = la.id
      left join recommendation_counts rc on rc.assessment_id = la.id
      left join roadmap_counts road on road.assessment_id = la.id
      left join issue_counts ic on ic.assessment_id = la.id
      left join consultants on consultants.company_id = ap.id
      where coalesce(ap.status, 'active') <> 'archived'
      order by last_activity desc nulls last, ap.created_at desc
    `);
    const rows = result.rows;
    const reportsReady = [];
    const needsAttention = [];
    const organizations = rows.map((row) => {
      const stage = consultantLifecycleStatus(row);
      const reportReady = Number(row.approved_findings || 0) > 0
        && Number(row.approved_recommendations || 0) > 0
        && Number(row.roadmap_items || 0) > 0;
      const completionPercent = Number(row.participants_total || 0)
        ? Math.round((Number(row.participants_completed || 0) / Number(row.participants_total || 0)) * 100)
        : 0;
      const base = {
        project_id: row.project_id,
        organization_id: row.organization_id,
        classification: row.project_classification || row.organization_classification || "production",
        organization_classification: row.organization_classification || "production",
        project_classification: row.project_classification || "production",
        organization_name: row.client_display_name || row.organization_name || "Organization",
        framework_name: defaultFrameworkDisplayName,
        assessment_id: row.assessment_id,
        assessment_name: row.assessment_name || row.project_name || "Assessment",
        project_status: row.project_status,
        assessment_status: row.assessment_status,
        stage,
        completion_percent: completionPercent,
        confidence_score: Number(row.assessment_confidence_score || 0),
        completeness_score: Number(row.assessment_completeness_score || 0),
        open_issues: Number(row.open_issues || 0),
        critical_issues: Number(row.critical_issues || 0),
        high_issues: Number(row.high_issues || 0),
        report_status: reportReady ? "Ready" : Number(row.approved_findings || 0) || Number(row.approved_recommendations || 0) ? "In Progress" : "Not Ready",
        report_ready: reportReady,
        assigned_consultant: row.assigned_consultants || "",
        estimated_value: Number(row.estimated_value || 0),
        actual_value: Number(row.actual_value || 0),
        overdue_participants: Number(row.overdue_participants || 0),
        failed_invitations: Number(row.failed_invitations || 0),
        failed_reminders: Number(row.failed_reminders || 0),
        participants_without_usable_link: Number(row.participants_without_usable_link || 0),
        last_activity: row.last_activity
      };
      const addAttention = (type, severity, explanation, actionOverride = null) => {
        const action = actionOverride || platformActionForAttention({ type });
        needsAttention.push({
          type,
          severity,
          organization_name: base.organization_name,
          assessment_name: base.assessment_name,
          classification: base.classification,
          project_id: base.project_id,
          assessment_id: base.assessment_id,
          label: platformAttentionLabel({ type }),
          explanation,
          action_label: action.label,
          action_view: action.view
        });
      };
      if (!row.company_profile_id) addAttention("missing_profile", "high", "Organization profile is required before the assessment can be trusted.");
      if (row.assessment_id && !row.blueprint_id) addAttention("missing_blueprint", "high", "Assessment exists but blueprint coverage has not been generated.");
      if (row.assessment_id && Number(row.participants_total || 0) === 0) addAttention("no_participants", "high", "Assessment cannot collect responses without assigned participants.");
      if (Number(row.overdue_participants || 0) > 0) addAttention("overdue_participants", "medium", `${row.overdue_participants} participant(s) are overdue.`);
      if (Number(row.failed_invitations || 0) > 0) addAttention("failed_invitation", "high", `${row.failed_invitations} invitation(s) failed.`);
      if (Number(row.failed_reminders || 0) > 0) addAttention("failed_reminder", "medium", `${row.failed_reminders} reminder(s) failed.`);
      if (Number(row.sessions_without_tokens || 0) > 0 || Number(row.expired_tokens || 0) > 0) addAttention("session_without_token", "high", "One or more incomplete sessions lack a usable assessment link.");
      if (Number(row.completed_sessions || 0) > 0 && Number(row.findings_total || 0) === 0) addAttention("analysis_ready", "high", "Completed sessions are available but findings have not been generated.");
      if (Number(row.draft_findings || 0) > 0) addAttention("findings_pending", "high", `${row.draft_findings} finding(s) are waiting for review.`);
      if (Number(row.draft_recommendations || 0) + Number(row.proposed_recommendations || 0) > 0) addAttention("recommendations_pending", "medium", "Recommendations are waiting for approval.");
      if (reportReady) {
        reportsReady.push({ ...base, last_updated: row.last_activity });
        addAttention("report_ready", "low", "Executive report has approved findings, recommendations, and roadmap items.", { label: "Open Report", view: "executive-report" });
      }
      if (Number(row.critical_issues || 0) > 0) addAttention("critical_issue", "critical", `${row.critical_issues} critical issue(s) are open.`);
      else if (Number(row.high_issues || 0) > 0) addAttention("high_issue", "high", `${row.high_issues} high-priority issue(s) are open.`);
      return {
        ...base,
        next_action: needsAttention.find((item) => item.project_id === base.project_id)?.label || (reportReady ? "Open Report" : "Open Workspace")
      };
    });
    const priorityWeight = { critical: 4, high: 3, medium: 2, low: 1 };
    needsAttention.sort((a, b) => (priorityWeight[b.severity] || 0) - (priorityWeight[a.severity] || 0));
    const productionOrganizations = organizations.filter((org) => org.classification === "production");
    const productionAttention = needsAttention.filter((item) => item.classification === "production");
    const pipeline = buildPlatformPipeline(productionOrganizations, productionAttention);
    const consultantsResult = await client.query(`
      select
        u.id,
        coalesce(u.name, u.full_name, u.email) as consultant_name,
        u.email,
        count(distinct cca.company_id) filter (where cca.is_active = true) as assigned_organizations,
        count(distinct a.id) filter (where a.status in ('active', 'analysis')) as active_assessments,
        count(distinct f.id) filter (where f.status = 'Draft') as findings_pending_review,
        count(distinct a.id) filter (
          where exists (select 1 from findings f2 where f2.assessment_id = a.id and f2.status = 'Approved')
            and exists (select 1 from recommendations r2 where r2.assessment_id = a.id and r2.status in ('Approved', 'Accepted', 'In Progress', 'Completed'))
            and exists (select 1 from roadmap_items ri2 where ri2.assessment_id = a.id)
        ) as reports_ready,
        count(distinct p.participant_id) filter (
          where p.is_active = true
            and p.status not in ('completed', 'deactivated')
            and (
              (p.status = 'invited' and p.invite_sent_at is not null and p.invite_sent_at < now() - interval '3 days')
              or (p.status = 'started' and p.started_at is not null and p.started_at < now() - interval '7 days')
            )
        ) as overdue_collection_items,
        count(distinct i.issue_id) filter (where i.status in ('open', 'investigating', 'waiting')) as open_issues
      from users u
      left join consultant_company_assignments cca on cca.consultant_user_id = u.id and cca.is_active = true
      left join assessments a on a.company_id = cca.company_id
      left join findings f on f.assessment_id = a.id
      left join assessment_participants p on p.assessment_id = a.id
      left join krb_issues i on i.assessment_id = a.id
      where u.role in ('consultant', 'auditor') and u.status = 'active'
      group by u.id, u.name, u.full_name, u.email
      order by assigned_organizations desc, consultant_name
    `);
    const issuesResult = await client.query(`
      select
        i.*,
        a.title as assessment_name,
        ap.client_display_name as organization_name,
        coalesce(ap.classification, o.classification, 'production') as classification
      from krb_issues i
      left join assessments a on a.id = i.assessment_id
      left join assessment_projects ap on ap.id = a.company_id
      left join organizations o on o.id = ap.organization_id
      where i.status in ('open', 'investigating', 'waiting')
      order by case i.severity when 'critical' then 1 when 'high' then 2 when 'medium' then 3 else 4 end, i.created_at desc
      limit 20
    `);
    const recentActivityResult = await client.query(`
      select timestamp as happened_at, action, entity_type, assessment_id, participant_id, actor_email
      from krb_audit_logs
      union all
      select created_at as happened_at, 'organization_created' as action, 'organization' as entity_type, null::uuid as assessment_id, null::uuid as participant_id, '' as actor_email
      from assessment_projects
      union all
      select completed_at as happened_at, 'participant_completed' as action, 'participant' as entity_type, assessment_id, participant_id, email as actor_email
      from assessment_participants
      where completed_at is not null
      order by happened_at desc nulls last
      limit 30
    `);
    const opsData = await getKrbOperationsData();
    const organizationCounts = organizationCount.rows.reduce((acc, row) => {
      const classification = row.classification || "production";
      acc[classification] = {
        total_organizations: Number(row.total_organizations || 0),
        active_organizations: Number(row.active_organizations || 0)
      };
      acc.all.total_organizations += Number(row.total_organizations || 0);
      acc.all.active_organizations += Number(row.active_organizations || 0);
      return acc;
    }, {
      all: { total_organizations: 0, active_organizations: 0 },
      production: { total_organizations: 0, active_organizations: 0 },
      demo: { total_organizations: 0, active_organizations: 0 },
      qa: { total_organizations: 0, active_organizations: 0 },
      internal: { total_organizations: 0, active_organizations: 0 }
    });
    const persistedIssues = issuesResult.rows.map((issue) => ({
      ...issue,
      classification: issue.classification || organizations.find((org) => String(org.assessment_id || "") === String(issue.assessment_id || ""))?.classification || "production"
    }));
    const generatedWarnings = (opsData.generated_issues || []).map((issue) => ({
      ...issue,
      classification: organizations.find((org) => String(org.assessment_id || "") === String(issue.assessment_id || ""))?.classification || issue.classification || "production"
    }));
    const classificationSnapshots = ["production", "demo", "qa", "internal", "all"].reduce((acc, classification) => {
      acc[classification] = buildPlatformSnapshot({
        classification,
        organizationCounts,
        organizations,
        attention: needsAttention,
        reportsReady,
        persistedIssues,
        generatedWarnings
      });
      return acc;
    }, {});
    const platformSnapshot = classificationSnapshots.production;
    const productionReportsReady = reportsReady.filter((report) => report.classification === "production");
    const productionGeneratedWarnings = generatedWarnings.filter((issue) => (issue.classification || "production") === "production");
    const productionPersistedIssues = persistedIssues.filter((issue) => (issue.classification || "production") === "production");
    const productionOpenIssues = [
      ...productionPersistedIssues,
      ...productionGeneratedWarnings.map((issue, index) => ({ ...issue, issue_id: `generated-${index}`, status: "open", organization_name: "", assessment_name: "" }))
    ];
    const productionNextBestAction = productionAttention[0] || (productionReportsReady[0] ? {
      type: "report_ready",
      severity: "low",
      classification: "production",
      organization_name: productionReportsReady[0].organization_name,
      assessment_name: productionReportsReady[0].assessment_name,
      project_id: productionReportsReady[0].project_id,
      label: "Executive report ready",
      explanation: "Review the report before delivery.",
      action_label: "Open Report",
      action_view: "executive-report"
    } : null);
    return {
      generated_at: new Date().toISOString(),
      platform_snapshot: platformSnapshot,
      classification_counts: organizationCounts,
      classification_snapshots: classificationSnapshots,
      needs_attention: needsAttention.filter((item) => item.classification === "production").slice(0, 20),
      needs_attention_all: needsAttention.slice(0, 50),
      organization_portfolio_summary: productionOrganizations,
      organization_portfolio_all: organizations,
      assessment_pipeline: pipeline,
      consultant_workload: consultantsResult.rows.map((row) => ({
        consultant_id: row.id,
        consultant_name: row.consultant_name,
        email: row.email,
        assigned_organizations: Number(row.assigned_organizations || 0),
        active_assessments: Number(row.active_assessments || 0),
        findings_pending_review: Number(row.findings_pending_review || 0),
        reports_ready: Number(row.reports_ready || 0),
        overdue_collection_items: Number(row.overdue_collection_items || 0),
        open_issues: Number(row.open_issues || 0)
      })),
      reports_ready: productionReportsReady.slice(0, 10),
      reports_ready_all: reportsReady.slice(0, 30),
