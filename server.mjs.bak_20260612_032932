  "confidence": 1-5,
  "time_impact": 1-5,
  "cost_impact": 1-5,
  "customer_impact": 1-5,
  "revenue_impact": 1-5,
  "risk_impact": 1-5,
  "employee_impact": 1-5,
  "automation_potential": 1-5,
  "supporting_roles": ["role_id_1", "role_id_2"],
  "contradiction_detected": true,
  "analyst_notes": "Internal note explaining the evidence chain that led to this finding"
}

Generate between 5 and 10 findings.
Maximum 10 findings. Be selective — only the most significant misalignments.
Quality over quantity.
Keep each description under 200 characters to ensure the full response fits within token limits.
Only include findings you are confident are real misalignments.`;
}

function clampFindingScore(value, fallback = 3) {
  return Math.min(5, Math.max(1, parseInt(value, 10) || fallback));
}

function normalizeIndustry(industry) {
  if (!industry) return "tire_fleet_service";
  const canonical = {
    tire_industry: "tire_fleet_service",
    tire: "tire_fleet_service",
    fleet: "tire_fleet_service",
    fleet_service: "tire_fleet_service",
    tire_and_fleet: "tire_fleet_service",
    automotive: "tire_fleet_service"
  };
  const normalized = String(industry)
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^a-z0-9_]/g, "");
  return canonical[normalized] || normalized;
}

function evidenceItemsForAIFinding(finding, responses) {
  const roleIds = new Set((Array.isArray(finding.supporting_roles) ? finding.supporting_roles : []).map((role) => String(role)));
  const selected = roleIds.size
    ? responses.filter((row) => roleIds.has(String(row.stakeholder_role_id)))
    : responses.slice(0, 5);
  return selected.slice(0, 12).map((row) => ({
    evidence_type: "Survey Response",
    source_question_id: row.question_uuid,
    source_response_id: row.response_id,
    source_stakeholder_role: row.stakeholder_role || row.stakeholder_role_id || row.stakeholder_group_id || "Unknown",
    stakeholder_role_id: row.stakeholder_role_id || resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group_id).id,
    stakeholder_group_id: row.stakeholder_group_id || stakeholderGroupForRole(row.stakeholder_role_id || resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group_id).id),
    description: `${row.question_id}: ${row.question_text} Answer: ${row.answer_text || ""}`,
    trigger_rule: "ai_generated"
  }));
}

async function buildAIFindings(responses, companyProfile, industry, perceptionGaps, client) {
  if (!responses || responses.length === 0) {
    console.log("[AI FINDINGS] No responses to analyze");
    return [];
  }

  try {
    const resolvedIndustry = normalizeIndustry(industry || companyProfile?.industry);
    const aiContext = await getAIAnalysisContext(resolvedIndustry, client);
    const domains = await getActiveDomainsForContext(client, resolvedIndustry);

    const prompt = buildAIFindingsPrompt(responses, companyProfile || {}, domains, aiContext, perceptionGaps);

    console.log("[AI FINDINGS] Generating findings for", responses.length, "responses using claude-sonnet-4-6");

    const message = await anthropic.messages.create({
      model: "claude-sonnet-4-6",
      max_tokens: 8000,
      messages: [{
        role: "user",
        content: prompt
      }]
    });

    const rawText = message.content[0]?.text || "";
    let findings = [];
    try {
      const cleaned = rawText
        .replace(/```json\n?/g, "")
        .replace(/```\n?/g, "")
        .trim();
      try {
        findings = JSON.parse(cleaned);
      } catch (parseErr) {
        console.warn("[AI FINDINGS] Full parse failed, attempting partial recovery...");
        const lastCompleteObj = cleaned.lastIndexOf("},");
        if (lastCompleteObj > 0) {
          const partial = `${cleaned.slice(0, lastCompleteObj + 1)}]`;
          try {
            findings = JSON.parse(partial);
            console.log("[AI FINDINGS] Partial recovery succeeded:", findings.length, "findings");
          } catch (partialErr) {
            console.error("[AI FINDINGS] Partial recovery also failed");
            console.error("[AI FINDINGS] JSON parse error:", parseErr.message);
            console.error("[AI FINDINGS] Raw response:", rawText.slice(0, 500));
            findings = [];
          }
        } else {
          console.error("[AI FINDINGS] JSON parse error:", parseErr.message);
          console.error("[AI FINDINGS] Raw response:", rawText.slice(0, 500));
          findings = [];
        }
      }
      if (!Array.isArray(findings)) findings = [];
    } catch (parseErr) {
      console.error("[AI FINDINGS] JSON parse error:", parseErr.message);
      console.error("[AI FINDINGS] Raw response:", rawText.slice(0, 500));
      findings = [];
    }

    if (findings.length === 0 && responses.length > 0) {
      console.warn("[AI FINDINGS] AI returned 0 findings, using rule fallback");
      return buildRuleFindingsFallback(responses, new Set());
    }

    console.log("[AI FINDINGS] Generated", findings.length, "findings");

    const validDomainKeys = new Set(domains.map((domain) => domain.key));
    return findings.map((finding) => {
      const evidenceItems = evidenceItemsForAIFinding(finding, responses);
      const sourceQuestionIds = uniqueValues(evidenceItems.map((item) => item.source_question_id).filter(Boolean));
      const sourceResponseIds = uniqueValues(evidenceItems.map((item) => item.source_response_id).filter(Boolean));
      const businessDomain = validDomainKeys.has(finding.business_domain)
        ? finding.business_domain
        : "strategic_alignment";
      return {
        title: String(finding.title || "").slice(0, 200),
        description: String(finding.description || ""),
        business_domain: businessDomain,
        assessment_category: finding.assessment_category || "operations",
        problem_types: Array.isArray(finding.problem_types) ? finding.problem_types : [],
        source_question_ids: sourceQuestionIds,
        source_response_ids: sourceResponseIds,
        evidence_items: evidenceItems,
        severity: clampFindingScore(finding.severity, 3),
        frequency: clampFindingScore(finding.frequency, 3),
        confidence: clampFindingScore(finding.confidence, 3),
        evidence_count: evidenceItems.length,
        time_impact: clampFindingScore(finding.time_impact, 2),
        cost_impact: clampFindingScore(finding.cost_impact, 2),
        customer_impact: clampFindingScore(finding.customer_impact, 2),
        revenue_impact: clampFindingScore(finding.revenue_impact, 2),
        risk_impact: clampFindingScore(finding.risk_impact, 2),
        employee_impact: clampFindingScore(finding.employee_impact, 2),
        automation_potential: clampFindingScore(finding.automation_potential, 2),
        supporting_roles: Array.isArray(finding.supporting_roles) ? finding.supporting_roles : [],
        contradiction_detected: Boolean(finding.contradiction_detected),
        analyst_notes: String(finding.analyst_notes || ""),
        trigger_rule: "ai_generated",
        status: "Draft"
      };
    });
  } catch (err) {
    console.error("[AI FINDINGS] Error:", err.message);
    return buildRuleFindingsFallback(responses, new Set());
  }
}

