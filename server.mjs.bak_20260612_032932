async function getKpisForActivities(activities, industry, client) {
  const db = client || requireDatabase();
  const activityList = uniqueStrings(asArray(activities));
  if (!activityList.length) return [];

  const result = await db.query(
    `SELECT DISTINCT
       key, name, name_tr,
       description, description_tr,
       why_it_matters, why_it_matters_tr,
       unit, target_direction,
       applicable_activities,
       industry, is_default, is_active,
       sort_order
     FROM framework_kpis
     WHERE industry = $1
       AND is_active = true
       AND is_default = true
       AND key IS NOT NULL
       AND (
         applicable_activities = '[]'::jsonb
         OR applicable_activities @>
           ANY(ARRAY(
             SELECT jsonb_build_array(a)
             FROM unnest($2::text[]) a
           ))
       )
     ORDER BY sort_order ASC`,
    [industry || "tire_fleet_service", activityList]
  );

  return result.rows.map(mapFrameworkKpi);
}

