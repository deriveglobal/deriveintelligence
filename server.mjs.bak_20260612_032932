                dt.category as domain_category
         from industry_benchmarks ib
         left join lateral (
           select name, category
           from domain_taxonomy
           where key = ib.domain_key
           order by case when scope = 'industry' then 0 else 1 end, sort_order asc
           limit 1
         ) dt on true
         where ib.industry = $1
           and ib.sample_size > 0
         order by abs(ib.avg_perception_gap) desc`,
        [industry]
      );
      const totalAssessments = benchmarks.rows.reduce((max, row) => Math.max(max, Number(row.sample_size || 0)), 0);
      sendJson(response, 200, {
        industry,
        benchmarks: benchmarks.rows,
        total_assessments: totalAssessments
      });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "POST" && url.pathname === "/api/demo/krb-phase-1") {
    try {
      await requireAuth(request, ["creator"]);
      sendJson(response, 201, await createDemoAssessment());
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "DELETE" && url.pathname === "/api/demo/krb-phase-1") {
    try {
      await requireAuth(request, ["creator"]);
      sendJson(response, 200, await deleteDemoAssessmentData());
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  const findingFeedbackMatch = url.pathname.match(/^\/api\/findings\/([^/]+)\/feedback$/);
  if (request.method === "POST" && findingFeedbackMatch) {
    try {
      const session = await requireAuth(request, ["creator", "consultant"]);
      const findingId = decodeURIComponent(findingFeedbackMatch[1]);
      await requireFindingProjectAccess(session, [findingId]);
      sendJson(response, 200, await recordFindingConsultantFeedback(findingId, await readJson(request), session));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "DELETE" && url.pathname.startsWith("/api/findings/")) {
    try {
      const session = await requireAuth(request, ["platform_owner"]);
      const findingId = decodeURIComponent(url.pathname.replace("/api/findings/", ""));
      await requireFindingProjectAccess(session, [findingId]);
      sendJson(response, 200, await deleteFindingForCleanup(findingId));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "PATCH" && url.pathname.startsWith("/api/findings/")) {
    try {
      const session = await requireAuth(request, ["creator", "consultant"]);
      const findingId = decodeURIComponent(url.pathname.replace("/api/findings/", ""));
      await requireFindingProjectAccess(session, [findingId]);
      const payload = await readJson(request);
      sendJson(response, 200, { finding: await updateFindingReview(findingId, payload) });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "POST" && url.pathname === "/api/findings/merge") {
    try {
      const session = await requireAuth(request, ["creator", "consultant"]);
      const payload = await readJson(request);
      const childIds = Array.isArray(payload.childFindingIds || payload.childIds) ? payload.childFindingIds || payload.childIds : [];
      await requireFindingProjectAccess(session, [payload.parentFindingId || payload.parentId, ...childIds]);
      sendJson(response, 200, await mergeFindings(payload));
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "PATCH" && url.pathname.startsWith("/api/recommendations/")) {
    try {
      const session = await requireAuth(request, ["creator", "consultant", "platform_owner"]);
      const recommendationId = decodeURIComponent(url.pathname.replace("/api/recommendations/", ""));
      await requireRecommendationProjectAccess(session, recommendationId);
      const payload = await readJson(request);
      sendJson(response, 200, { recommendation: await updateRecommendationReview(recommendationId, payload) });
    } catch (error) {
      sendJson(response, error.statusCode || 500, { error: error.message });
    }
    return;
  }

  if (request.method === "POST" && request.url === "/api/send-email") {
    try {
      await requireAuth(request, ["creator", "consultant", "manager"]);
      const payload = await readJson(request);
      const to = String(payload.to || "").trim();
      const subject = String(payload.subject || "").trim();
      const body = String(payload.body || "").trim();
      if (!isEmail(to) || !subject || !body) {
        sendJson(response, 400, { error: "Recipient, subject, and body are required." });
        return;
      }
      await sendGraphMail({ to, subject, body });
      sendJson(response, 200, { ok: true });
    } catch (error) {
      sendJson(response, 500, { error: error.message });
    }
    return;
  }

  sendJson(response, 404, { error: "API endpoint not found." });
}

async function serveStatic(request, response) {
  const url = new URL(request.url, "http://localhost");
  let pathname = decodeURIComponent(url.pathname);
  if (pathname === "/") {
    pathname = "/index.html";
  }

  const filePath = normalize(join(root, pathname));
  if (!filePath.startsWith(root)) {
    response.writeHead(403);
    response.end("Forbidden");
    return;
  }

  try {
    const target = pathname.includes(".") ? filePath : join(root, "index.html");
    await readFile(target);
    const ext = extname(target);
    const headers = {
      "Content-Type": contentTypes[ext] || "application/octet-stream",
      "Cache-Control": ext === ".html" ? "no-store" : "no-cache, max-age=0"
    };
    if (pathname.startsWith("/components/") && ext === ".js") {
      headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
      headers.Pragma = "no-cache";
      headers.Expires = "0";
    }
    response.writeHead(200, headers);
    createReadStream(target).pipe(response);
  } catch {
    response.writeHead(404);
    response.end("Not found");
  }
}

createServer(async (request, response) => {
  if (request.url === "/" ||
      request.url === "") {
    let user = null;
    try {
      user = await getSessionUser(request);
    } catch {
      user = null;
    }
    if (user) {
      response.writeHead(302, {
        Location: "/app"
      });
      response.end();
      return;
    }
    const homepagePath = join(root,
      "homepage.html");
    try {
      await readFile(homepagePath);
      response.writeHead(200, {
        "Content-Type": "text/html",
        "Cache-Control": "no-store"
      });
      createReadStream(homepagePath)
        .pipe(response);
    } catch {
      response.writeHead(302, {
        Location: "/app"
      });
      response.end();
    }
    return;
  }

  if (request.url === "/app" ||
      request.url?.startsWith("/app?")) {
    response.writeHead(200, {
      "Content-Type": "text/html",
      "Cache-Control": "no-store"
    });
    createReadStream(
      join(root, "index.html"))
      .pipe(response);
    return;
  }

  if (request.url?.startsWith("/api/")) {
    handleApi(request, response);
    return;
  }
  serveStatic(request, response);
}).listen(port, async () => {
  console.log(`Assessment Platform running on ${port}`);
  if (pool) {
    await ensureFrameworkEngineSchema();
    await ensureDemoRequestsSchema();
  }
});
