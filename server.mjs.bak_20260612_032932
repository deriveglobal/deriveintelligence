	    await updateIndustryBenchmarks(normalizedIndustry, perceptionGaps, client);
	    console.log("[BENCHMARKS] Updated industry benchmarks for", normalizedIndustry);
	    await client.query("commit");
    return getAssessmentEngineDashboard(projectId);
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
