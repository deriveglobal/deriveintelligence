      })
    ]
  );
}

function respondentValidationError(validation) {
  const error = new Error(validation.message || "Please complete all required questions before submitting.");
  error.statusCode = 400;
  error.payload = { error: "validation_failed", ...validation };
  error.isValidationFailure = true;
  return error;
}

async function saveRespondentResponses(rawToken, answers = [], complete = false) {
  await ensureFrameworkEngineSchema();
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    const tokenHash = hashAssessmentAccessToken(rawToken);
    const token = await client.query(
      `select t.*, p.stakeholder_group_id, p.stakeholder_role_id, p.participant_id, s.assessment_id
       from assessment_access_tokens t
       join assessment_participants p on p.participant_id = t.participant_id
       join assessment_sessions s on s.id = t.session_id
       where t.token = $1 and t.is_active = true
       limit 1`,
      [tokenHash]
    );
    if (!token.rowCount) {
      const error = new Error("Assessment link is invalid or has been regenerated.");
      error.statusCode = 404;
      throw error;
    }
    const access = token.rows[0];
    if (new Date(access.expires_at).getTime() < Date.now()) {
      const error = new Error("Assessment link has expired.");
      error.statusCode = 410;
      throw error;
    }
    const questions = await loadRespondentQuestions(client, access.assessment_id, access.stakeholder_role_id, access.session_id);
    const questionByCode = new Map(questions.rows.map((question) => [question.question_id, question]));
    const submittedAnswers = Array.isArray(answers) ? answers : [];
    const normalizedAnswers = [];
    const invalidAnswers = [];
    for (const answer of Array.isArray(answers) ? answers : []) {
      const questionId = answer.question_id || answer.questionId;
      if (!questionId) continue;
      const question = questionByCode.get(questionId);
      if (!question) {
        invalidAnswers.push({ question_id: questionId, reason: "Question does not belong to this assigned question bank." });
        continue;
      }
      const { value: answerValue, text } = normalizeSubmittedAnswer(answer);
      const reason = validateAnswerForQuestion(question, answerValue, { requirePresent: false });
      if (reason) {
        invalidAnswers.push({ question_id: questionId, reason });
        continue;
      }
      normalizedAnswers.push({ question, answerValue, text });
    }
    if (invalidAnswers.length) {
      const validation = {
        message: "One or more answers are invalid.",
        missing_required_questions: [],
        invalid_answers: invalidAnswers
      };
      await logRespondentValidationFailure(client, access, validation);
      throw respondentValidationError(validation);
    }
    for (const { question, answerValue, text } of normalizedAnswers) {
      if (isEmptySubmittedValue(answerValue)) continue;
      const scoreValue = ["numeric", "percentage", "currency"].includes(question.response_type)
        ? numericFromAnswer(text)
        : scoreAnswer(question, text);
      await client.query(
        `insert into responses
          (assessment_session_id, question_id, stakeholder_group_id, stakeholder_role_id, answer_value, answer_text, score_value)
         values ($1, $2, $3, $4, $5::jsonb, $6, $7)
         on conflict (assessment_session_id, question_id) do update set
           answer_value = excluded.answer_value,
           answer_text = excluded.answer_text,
           score_value = excluded.score_value,
           stakeholder_group_id = excluded.stakeholder_group_id,
           stakeholder_role_id = excluded.stakeholder_role_id`,
        [
          access.session_id,
          question.id,
          access.stakeholder_group_id,
          access.stakeholder_role_id,
          JSON.stringify(answerValue),
          text,
          scoreValue
        ]
      );
      await trackQuestionAsked(client, {
        questionId: question.id,
        assessmentId: access.assessment_id
      });
    }
    if (complete) {
      const existingRows = await client.query(
        `select r.*, q.question_id
         from responses r
         join questions q on q.id = r.question_id
         where r.assessment_session_id = $1`,
        [access.session_id]
      );
      const valuesByQuestionId = new Map(existingRows.rows.map((row) => [row.question_id, row.answer_value]));
      for (const { question, answerValue } of normalizedAnswers) valuesByQuestionId.set(question.question_id, answerValue);
      const missingRequired = [];
      const finalInvalid = [];
      for (const question of questions.rows) {
        const value = valuesByQuestionId.get(question.question_id);
        const reason = validateAnswerForQuestion(question, value, { requirePresent: Boolean(question.required) });
        if (question.required && reason === "Answer is required.") missingRequired.push(question.question_id);
        else if (reason) finalInvalid.push({ question_id: question.question_id, reason });
      }
      if (missingRequired.length || finalInvalid.length) {
        const validation = {
          message: "Please complete all required questions before submitting.",
          missing_required_questions: missingRequired,
          invalid_answers: finalInvalid
        };
        await logRespondentValidationFailure(client, access, validation);
        throw respondentValidationError(validation);
      }
    }
    const responseCount = await client.query("select count(*)::int as count from responses where assessment_session_id = $1", [access.session_id]);
    if (complete) {
      await client.query("update assessment_sessions set status = 'completed', completed_at = now() where id = $1", [access.session_id]);
      await client.query(
        `update assessment_participants
         set status = 'completed', started_at = coalesce(started_at, now()), completed_at = now(), updated_at = now()
         where participant_id = $1`,
        [access.participant_id]
      );
      await client.query("update assessment_access_tokens set completed_at = now(), last_opened_at = now() where token_id = $1", [access.token_id]);
    } else if (Number(responseCount.rows[0]?.count || 0) > 0) {
      await client.query("update assessment_sessions set status = 'started' where id = $1 and status <> 'completed'", [access.session_id]);
      await client.query(
        `update assessment_participants
         set status = 'started', started_at = coalesce(started_at, now()), updated_at = now()
         where participant_id = $1 and status <> 'completed'`,
        [access.participant_id]
      );
      await client.query("update assessment_access_tokens set last_opened_at = now() where token_id = $1", [access.token_id]);
    }
    await client.query("commit");
    return await getRespondentAssessment(rawToken);
  } catch (error) {
    if (error.isValidationFailure) await client.query("commit");
    else await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

