async function auditBankQuestions(bank, questions, industry, client) {
  if (questions.length === 0) {
    return {
      bank_id: bank.id,
      role_key: bank.role_key,
      role_name: bank.role_name,
      total: 0,
      keep: [],
      remove: [],
      replace: [],
      skipped: true,
      reason: "No questions to audit"
    };
  }

  const prompt = await buildBankAuditPrompt(
    bank.role_key,
    bank.role_name,
    questions,
    EXPECTED_FLEET_DOMAINS,
    industry
  );

  const response = await anthropic.messages.create({
    model: "claude-sonnet-4-20250514",
    max_tokens: 4000,
    messages: [{ role: "user", content: prompt }]
  });

  const text = response.content
    .filter((block) => block.type === "text")
    .map((block) => block.text)
    .join("");

  const validIds = new Set(questions.flatMap((question) => [
    String(question.question_id || ""),
    String(question.id || "")
  ]).filter(Boolean));
  const decisions = parseJsonArrayFromAiText(text)
    .filter((decision) => validIds.has(String(decision.question_id || "")))
    .map((decision) => ({
      question_id: String(decision.question_id || ""),
      decision: String(decision.decision || "").toUpperCase(),
      reason: String(decision.reason || "").trim(),
      replacement_text: decision.replacement_text ? String(decision.replacement_text).trim() : null
    }));

  const keep = decisions.filter((decision) => decision.decision === "KEEP");
  const remove = decisions.filter((decision) => decision.decision === "REMOVE");
  const replace = decisions.filter((decision) => decision.decision === "REPLACE");

  return {
    bank_id: bank.id,
    role_key: bank.role_key,
    role_name: bank.role_name,
    role_type: bank.role_type || "manager",
    total: questions.length,
    keep,
    remove,
    replace,
    skipped: false
  };
}

function buildCoverageContextForGeneration(coverageData = {}) {
  const missingDomains = coverageData.breadth?.missing_domains || [];
  const shallowDomains = Object.entries(coverageData.domain_distribution || {})
    .filter(([domain, count]) => Number(count || 0) > 0 && Number(count || 0) < 5 && !missingDomains.includes(domain))
    .map(([domain]) => domain);

  return {
    missingDomains,
    shallowDomains,
    text: `
CURRENT BANK COVERAGE ANALYSIS:
Overall score: ${coverageData.total || 0}/100 (${coverageData.grade || "F"})

CRITICAL -- MISSING DOMAINS (breadth gaps):
These domains have fewer than 3 questions and are dragging the breadth score down.
Generate questions PRIMARILY for these:
${missingDomains.length ? missingDomains.map((domain) => `  - ${domain} (0-2 questions currently)`).join("\n") : "  None -- breadth is good"}

SHALLOW DOMAINS (depth gaps):
These domains exist but need more depth (currently 3-4 questions, need 5+):
${shallowDomains.length ? shallowDomains.map((domain) => {
  const count = Number(coverageData.domain_distribution?.[domain] || 0);
  return `  - ${domain} (${count} questions, needs ${5 - count} more)`;
}).join("\n") : "  None -- depth is good"}

GENERATION PRIORITY:
1. Add questions to MISSING domains first
2. Then deepen SHALLOW domains
3. Do NOT add more to well-covered domains

CURRENT DOMAIN DISTRIBUTION:
${Object.entries(coverageData.domain_distribution || {})
  .sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0))
  .map(([domain, count]) => `  ${domain}: ${count} questions ${Number(count || 0) >= 5 ? "deep" : Number(count || 0) >= 3 ? "shallow" : "missing"}`)
  .join("\n")}
`
  };
}

async function generateQuestionsForBank(framework, bank, options = {}, client = requireDatabase()) {
  const industry = normalizeIndustry(framework.industry || "tire_fleet_service");
  const coverageData = options.coverageData || await calculateBankCoverageScore(bank.id, client);
  const coverage = buildCoverageContextForGeneration(coverageData);
  const selectedDomains = Array.isArray(options.targetDomains) && options.targetDomains.length
    ? options.targetDomains
    : [...coverage.missingDomains, ...coverage.shallowDomains].slice(0, 8);
  const count = Math.min(15, Math.max(10, Number(options.count || Math.min(15, Math.max(10, (coverage.missingDomains.length * 3) + (coverage.shallowDomains.length * 2))))));

  const existingQuestions = await client.query(
    `select question_text, business_domain, response_type, ai_analysis_purpose
     from questions
     where bank_id = $1
     order by question_id asc`,
    [bank.id]
  );
  const domainDistributionRows = await client.query(
    `SELECT d.key as business_domain,
            COUNT(q.id)::int as count
     FROM domain_taxonomy d
     LEFT JOIN questions q
       ON q.business_domain = d.key
      AND q.bank_id = $2
     WHERE d.is_active = true
       AND (d.scope = 'universal' OR d.industry = $1)
     GROUP BY d.id, d.key, d.sort_order
     ORDER BY d.sort_order ASC, d.key ASC`,
    [industry, bank.id]
  );
  const domainDistribution = Object.fromEntries(domainDistributionRows.rows.map((row) => [row.business_domain, Number(row.count || 0)]));
  const responseTypeDistribution = existingQuestions.rows.reduce((acc, question) => {
    const key = question.response_type || "unknown";
    acc[key] = (acc[key] || 0) + 1;
    return acc;
  }, {});
  const crossRoleThemes = await client.query(
    `SELECT q.business_domain,
            q.ai_analysis_purpose,
            rb.role_key as source_role
     FROM questions q
     JOIN framework_question_banks rb
       ON rb.id = q.bank_id
     WHERE rb.framework_id = $1
       AND rb.id <> $2
       AND q.ai_analysis_purpose IS NOT NULL
     ORDER BY q.business_domain ASC, rb.role_key ASC`,
    [framework.id, bank.id]
  );
  const allBankThemes = crossRoleThemes.rows.reduce((groups, row) => {
    const domain = row.business_domain || "unknown";
    groups[domain] = groups[domain] || [];
    groups[domain].push({
      source_role: row.source_role,
      ai_analysis_purpose: row.ai_analysis_purpose
    });
    return groups;
  }, {});

  const prompt = await buildQuestionGenerationPrompt(
    bank.role_key,
    bank.role_name,
    framework.name,
    industry,
    existingQuestions.rows,
    allBankThemes,
    domainDistribution,
    responseTypeDistribution,
    selectedDomains.length ? selectedDomains : domainDistributionRows.rows.filter((domain) => Number(domain.count || 0) < 15).slice(0, 8).map((domain) => domain.business_domain),
    count,
    coverage.text,
    client
  );

  const message = await anthropic.messages.create({
    model: "claude-sonnet-4-6",
    max_tokens: 4000,
    system: "You are an expert organizational assessment designer for Derive. Respond with a raw JSON array only.",
    messages: [{ role: "user", content: `${prompt}\nUse a mix of medium and high finding strength questions.` }]
  });
  const responseText = message.content.filter((block) => block.type === "text").map((block) => block.text).join("");
  const questions = parseJsonArrayFromAiText(responseText);
  return questions.map((question) => ({
    ...question,
    response_type: ["likert", "scale_1_5", "single_choice"].includes(question.response_type) ? question.response_type : "likert",
    options: question.response_type === "single_choice" ? question.options || [] : null,
    score_mapping: question.score_mapping || {
      "Strongly disagree": 1,
      "Disagree": 2,
      "Neutral": 3,
      "Agree": 4,
      "Strongly agree": 5
    },
    section_name: question.section_name || bank.role_name,
    assessment_category: question.assessment_category || "operations",
    problem_types_detectable: Array.isArray(question.problem_types_detectable) ? question.problem_types_detectable : [],
    impact_dimensions: Array.isArray(question.impact_dimensions) ? question.impact_dimensions : [],
    kpi_outputs: Array.isArray(question.kpi_outputs) ? question.kpi_outputs : [],
    recommendation_triggers: Array.isArray(question.recommendation_triggers) ? question.recommendation_triggers : [],
    roadmap_relevance: question.roadmap_relevance || "foundation",
    follow_up_enabled: Boolean(question.follow_up_enabled),
    follow_up_questions: Array.isArray(question.follow_up_questions) ? question.follow_up_questions : null,
    applicable_activities: normalizeApplicableActivities(question.applicable_activities, question.question_text, question.ai_analysis_purpose, question.business_domain),
    required: true,
    stakeholder_group: bank.stakeholder_group,
    stakeholder_group_id: bank.stakeholder_group_id,
    stakeholder_role: bank.role_name,
    stakeholder_role_id: bank.role_key,
    bank_id: bank.id,
    framework_id: framework.id
  }));
}

