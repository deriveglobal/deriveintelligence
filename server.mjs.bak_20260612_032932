function questionOptionsList(question = {}) {
  if (Array.isArray(question.options)) return question.options.map((option) => String(option));
  if (typeof question.options === "string") {
    try {
      const parsed = JSON.parse(question.options);
      if (Array.isArray(parsed)) return parsed.map((option) => String(option));
    } catch {
      return question.options ? [String(question.options)] : [];
    }
  }
  if (question.response_type === "scale_1_5") return ["1", "2", "3", "4", "5"];
  if (question.response_type === "yes_no") return ["Yes", "No"];
  return [];
}

function normalizeSubmittedAnswer(answer = {}) {
  const raw = answer.answer_value ?? answer.answer ?? answer.answer_text ?? "";
  const value = Array.isArray(raw) ? raw.map((item) => String(item).trim()).filter(Boolean) : raw;
  const text = Array.isArray(value)
    ? value.join(", ")
    : String(answer.answer_text ?? answer.answer ?? answer.answer_value ?? "").trim();
  return { value, text };
}

function isEmptySubmittedValue(value) {
  if (value === null || value === undefined) return true;
  if (Array.isArray(value)) return value.length === 0 || value.every((item) => String(item || "").trim() === "");
  return String(value).trim() === "";
}

function strictNumberFromAnswer(value) {
  if (typeof value === "number") return Number.isFinite(value) ? value : null;
  const text = String(value ?? "").trim().replace(/[$,%]/g, "").replace(",", ".");
  if (!/^-?\d+(\.\d+)?$/.test(text)) return null;
  const number = Number(text);
  return Number.isFinite(number) ? number : null;
}

function scaleNumberFromAnswer(value) {
  const strict = strictNumberFromAnswer(value);
  if (strict !== null) return strict;
  const match = String(value ?? "").trim().match(/^([1-5])(\b|\s|=|-)/);
  return match ? Number(match[1]) : null;
}

function validateAnswerForQuestion(question = {}, submittedValue, { requirePresent = false } = {}) {
  const responseType = question.response_type || "open_text";
  const options = questionOptionsList(question);
  const allowed = new Set(options.map((option) => String(option)));
  const value = submittedValue;
  if (requirePresent && isEmptySubmittedValue(value)) {
    return "Answer is required.";
  }
  if (isEmptySubmittedValue(value)) return "";

  if (responseType === "single_choice" || responseType === "yes_no" || (responseType === "time_duration" && options.length)) {
    if (Array.isArray(value)) return "Answer must be a single value.";
    if (allowed.size && !allowed.has(String(value))) return "Value is not an allowed option.";
  }
  if (responseType === "multiple_choice") {
    if (!Array.isArray(value)) return "Answer must be an array.";
    const invalid = value.find((item) => !allowed.has(String(item)));
    if (invalid !== undefined) return "Value is not an allowed option.";
  }
  if (responseType === "ranking") {
    if (!Array.isArray(value)) return "Ranking answer must be an array.";
    const seen = new Set();
    for (const item of value) {
      const text = String(item);
      if (allowed.size && !allowed.has(text)) return "Value is not an allowed option.";
      if (seen.has(text)) return "Ranking cannot contain duplicate options.";
      seen.add(text);
    }
  }
  if (responseType === "scale_1_5") {
    const number = scaleNumberFromAnswer(value);
    if (number === null || !Number.isInteger(number) || number < 1 || number > 5) return "Scale value must be between 1 and 5.";
    if (allowed.size && !allowed.has(String(value)) && !allowed.has(String(number))) return "Value is not an allowed option.";
  }
  if (responseType === "numeric") {
    if (strictNumberFromAnswer(value) === null) return "Value must be a valid number.";
  }
  if (responseType === "percentage") {
    const number = strictNumberFromAnswer(value);
    if (number === null) return "Value must be a valid percentage.";
    if (number < 0 || number > 100) return "Percentage must be between 0 and 100.";
  }
  if (responseType === "currency") {
    const number = strictNumberFromAnswer(value);
    if (number === null) return "Value must be a valid currency amount.";
    if (number < 0) return "Currency amount must be greater than or equal to 0.";
  }
  if (responseType === "time_duration" && !options.length && typeof value !== "number") {
    const text = String(value).trim();
    if (!/^\d+(\.\d+)?\s*(minute|minutes|min|hour|hours|hr|hrs|day|days|week|weeks)?$/i.test(text)) return "Time duration must be a valid duration.";
  }
  return "";
}

async function logRespondentValidationFailure(client, access, validation) {
  await client.query(
    `insert into system_error_logs (severity, area, action, message, assessment_id, participant_id, metadata_json)
     values ('medium', 'responses', 'respondent_validation_failed', $1, $2, $3, $4::jsonb)`,
    [
