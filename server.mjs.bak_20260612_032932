async function getOrCreateDefaultOrganization(client) {
  const existing = await client.query("select id from organizations where name = $1 order by created_at asc limit 1", [defaultOrganizationName]);
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    "insert into organizations (name, industry, default_language) values ($1, $2, $3) returning id",
    [defaultOrganizationName, "Digital Transformation", "tr"]
  );
  return inserted.rows[0].id;
}

async function getOrCreateDefaultMethodologyVersion(client) {
  const existing = await client.query(
    `select mv.id
     from methodology_versions mv
     join methodology_templates mt on mt.id = mv.methodology_template_id
     where mt.name = $1 and mv.status = 'published'
     order by mv.published_at desc nulls last, mv.created_at desc
     limit 1`,
    [defaultMethodologyName]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const template = await client.query(
    "insert into methodology_templates (name, description, is_global, status) values ($1, $2, true, 'active') returning id",
    [defaultMethodologyName, "Reusable methodology for digital transformation discovery."]
  );
  const version = await client.query(
    "insert into methodology_versions (methodology_template_id, version_label, status, published_at) values ($1, 'v1', 'published', now()) returning id",
    [template.rows[0].id]
  );
  return version.rows[0].id;
}

async function getOrCreateDefaultProject(client, organizationId, methodologyVersionId) {
  const existing = await client.query(
    "select id from assessment_projects where organization_id = $1 and name = $2 order by created_at asc limit 1",
    [organizationId, defaultProjectName]
  );
  if (existing.rowCount) return existing.rows[0].id;

  const inserted = await client.query(
    `insert into assessment_projects
      (organization_id, methodology_version_id, name, client_display_name, industry_context, default_language, status)
     values ($1, $2, $3, $4, $5, 'tr', 'active')
     returning id`,
    [organizationId, methodologyVersionId, defaultProjectName, defaultOrganizationName, "Reusable first project configuration."]
  );
  return inserted.rows[0].id;
}

async function getProjectContext(client, projectId) {
  if (!projectId) return null;
  const result = await client.query(
    `select ap.id as project_id, ap.organization_id, ap.methodology_version_id
     from assessment_projects ap
     where ap.id = $1
     limit 1`,
    [projectId]
  );
  if (!result.rowCount) return null;
  return {
    projectId: result.rows[0].project_id,
    organizationId: result.rows[0].organization_id,
    methodologyVersionId: result.rows[0].methodology_version_id
  };
}

