async function handleFrameworkBlueprintRoleApi(request, response, url) {
  const match = url.pathname.match(/^\/api\/assessments\/([^/]+)\/blueprint\/roles$/);
  if (!match || request.method !== "PUT") return false;
  const session = await requirePlatformOwner(request, response);
  if (!session) return true;
  await ensureFrameworkEngineSchema();
  try {
    const payload = await readJson(request);
    const requirements = payload.role_requirements && typeof payload.role_requirements === "object" && !Array.isArray(payload.role_requirements)
      ? payload.role_requirements
      : null;
    if (!requirements) {
      sendJson(response, 400, { error: "role_requirements object is required." });
      return true;
    }
    const allowed = new Set(["required", "recommended", "optional", "excluded"]);
    for (const [role, requirement] of Object.entries(requirements)) {
      if (!role || !allowed.has(String(requirement))) {
        sendJson(response, 400, { error: "Each role requirement must be required, recommended, optional, or excluded." });
        return true;
      }
    }
    const result = await query(
      `update assessment_blueprints
       set role_requirements = $2::jsonb,
           updated_at = now()
       where assessment_id::text = $1
          or assessment_project_id::text = $1
       returning *`,
      [match[1], JSON.stringify(requirements)]
    );
    if (!result.rowCount) {
      sendJson(response, 404, { error: "Blueprint not found." });
      return true;
    }
    sendJson(response, 200, { blueprint: result.rows[0] });
    return true;
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
    return true;
  }
}

async function createResponse(payload) {
  const assignment = payload.sourceToken ? await getSurveyAssignmentByToken(payload.sourceToken) : null;
  const context = await getDefaultContext({
    projectId: assignment?.projectId || payload.projectId,
    templateId: assignment?.templateId || payload.templateId || "general",
    templateName: assignment?.stakeholderName || payload.stakeholder,
    language: payload.language,
    department: payload.department
  });
  if (payload.templateId === "operations-manager" || payload.questionBankVersion === "operations_manager_v1") {
    await ensureAssessmentEngineSchema();
  }

  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const session = await client.query(
      `insert into survey_response_sessions
        (organization_id, assessment_project_id, survey_template_id, department_id, respondent_name, respondent_email, language_code, status, metadata)
       values ($1, $2, $3, $4, $5, $6, $7, 'submitted', $8)
       returning id, submitted_at`,
      [
        context.organizationId,
        context.projectId,
        context.surveyTemplateId,
        context.departmentId,
        payload.recipient || null,
        payload.respondentEmail || null,
        payload.language || "en",
        payload
      ]
    );

    const answers = Array.isArray(payload.answers) ? payload.answers : [];
    for (let index = 0; index < answers.length; index += 1) {
      const answer = answers[index];
      const questionId = await getOrCreateQuestionTemplate(
        client,
        context.methodologyVersionId,
        context.surveyTemplateId,
        `Q-${String(index + 1).padStart(3, "0")}`,
        answer.question,
        index + 1
      );
      await client.query(
        `insert into response_answers
          (organization_id, assessment_project_id, response_session_id, question_template_id, answer_text, normalized_answer)
         values ($1, $2, $3, $4, $5, $6)
         on conflict (response_session_id, question_template_id) do update set
           answer_text = excluded.answer_text,
           normalized_answer = excluded.normalized_answer`,
        [
          context.organizationId,
          context.projectId,
          session.rows[0].id,
          questionId,
          answer.answer || "",
          { question: answer.question, answer: answer.answer }
        ]
      );
    }

    await syncAssessmentEngineResponse(client, context, payload);

    if (payload.sourceToken) {
      await client.query(
        "update survey_assignments set status = 'completed', completed_at = now() where token = $1",
        [payload.sourceToken]
      );
    }

    await client.query("commit");
    return { ok: true, id: session.rows[0].id, submittedAt: session.rows[0].submitted_at };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function deleteDemoProjectCascade(client, projectId, { deleteParticipants = true, deleteProject = false } = {}) {
  const assessmentResult = await client.query(
    `select id from assessments
     where company_id = $1
     order by created_at desc
     limit 1`,
    [projectId]
  );
  const deleted = {
    findings: 0,
    recommendations: 0,
    responses: 0,
    sessions: 0,
    evidence: 0,
    snapshots: 0,
    participants: 0
  };
  if (assessmentResult.rowCount) {
    const assessmentId = assessmentResult.rows[0].id;
    await client.query("delete from progress_insights where assessment_id = $1", [assessmentId]);
    await client.query("delete from finding_history where assessment_id = $1", [assessmentId]);
    const snapshots = await client.query("delete from company_progress_snapshots where company_id = $1 returning id", [projectId]);
    deleted.snapshots = snapshots.rowCount;
    await client.query("delete from response_answer_analysis where assessment_project_id = $1", [projectId]);
    await client.query("delete from response_answers where assessment_project_id = $1", [projectId]);
    const responses = await client.query(
      `delete from responses
       where assessment_session_id in (
         select id from assessment_sessions where assessment_id = $1
       )
       returning id`,
      [assessmentId]
    );
    deleted.responses = responses.rowCount;
    const evidence = await client.query(
      `delete from evidence
       where finding_id in (
         select id from findings where assessment_id = $1
       )
       returning id`,
      [assessmentId]
    );
    deleted.evidence = evidence.rowCount;
    const recommendations = await client.query("delete from recommendations where assessment_id = $1 returning id", [assessmentId]);
    deleted.recommendations = recommendations.rowCount;
    const findings = await client.query("delete from findings where assessment_id = $1 returning id", [assessmentId]);
    deleted.findings = findings.rowCount;
    for (const tableName of ["roadmap_items", "assessment_invitation_logs", "assessment_reminder_logs"]) {
      const exists = await client.query("select to_regclass($1) as table_name", [`public.${tableName}`]);
      if (exists.rows[0]?.table_name) {
        const hasAssessmentId = await client.query(
          `select 1
           from information_schema.columns
           where table_schema = 'public'
             and table_name = $1
             and column_name = 'assessment_id'
           limit 1`,
          [tableName]
        );
        if (hasAssessmentId.rowCount) {
          await client.query(`delete from ${tableName} where assessment_id = $1`, [assessmentId]);
        }
      }
    }
    if (deleteParticipants) {
      const participants = await client.query("delete from assessment_participants where assessment_id = $1 returning participant_id", [assessmentId]);
      deleted.participants = participants.rowCount;
    }
    const sessions = await client.query("delete from assessment_sessions where assessment_id = $1 returning id", [assessmentId]);
    deleted.sessions = sessions.rowCount;
    await client.query("delete from assessments where id = $1", [assessmentId]);
  }
  if (deleteProject) {
    await client.query("delete from project_context_intakes where assessment_project_id = $1", [projectId]);
    await client.query("delete from company_profiles where assessment_project_id = $1", [projectId]);
    await client.query("delete from project_memberships where assessment_project_id = $1", [projectId]);
    await client.query("delete from company_user_assignments where company_id = $1", [projectId]);
    await client.query("delete from consultant_company_assignments where company_id = $1", [projectId]);
    await client.query("delete from assessment_projects where id = $1", [projectId]);
  }
  return deleted;
}

