      );
      if (!result.rowCount) sendJson(response, 404, { error: "Glossary entry not found." });
      else sendJson(response, 200, { entry: result.rows[0] });
      return true;
    }

    sendJson(response, 404, { error: "Glossary endpoint not found." });
    return true;
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
    return true;
  }
