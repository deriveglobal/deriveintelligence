  }
  if (problemTypes.some((type) => ["reporting_gap", "data_management_gap", "missing_data", "data_access_issue"].includes(type))) {
    return "data_visibility_gap";
  }
  if (problemTypes.some((type) => ["manual_process", "lack_of_automation", "paper_based_process"].includes(type))) {
    return "manual_work_and_automation_gap";
  }
  if (problemTypes.some((type) => ["missing_integration", "process_complexity", "duplicate_activity"].includes(type))) {
    return "system_and_process_complexity";
  }
  return "operational_improvement";
}

function responseSentiment(answerText = "") {
  const text = String(answerText || "").toLowerCase();
  const positive = /\b(excellent|strong|reliable|accurate|good|works well|trusted|clear|fast|visible|available|başarılı|iyi|güvenilir|doğru|hızlı|net)\b/.test(text);
  const negative = /\b(unreliable|error|errors|incorrect|inaccurate|missing|slow|delayed|delay|manual|difficult|problem|complaint|not trust|poor|güvenilmez|hatalı|eksik|yavaş|gecik|manuel|zor|şikayet|problem)\b/.test(text);
  if (positive && !negative) return "positive";
  if (negative && !positive) return "negative";
  if (positive && negative) return "mixed";
  return "neutral";
}

function buildContradictionMap(rows = []) {
  const byDomain = new Map();
  for (const row of rows) {
    const sentiment = responseSentiment(row.answer_text);
    if (!["positive", "negative"].includes(sentiment)) continue;
    const key = row.business_domain || "general";
    const bucket = byDomain.get(key) || { positive: [], negative: [] };
    bucket[sentiment].push(row);
    byDomain.set(key, bucket);
  }
  const contradictions = new Map();
  for (const [domain, bucket] of byDomain.entries()) {
    const positiveStakeholders = uniqueValues(bucket.positive.map((row) => row.stakeholder_role_id || row.stakeholder_role));
    const negativeStakeholders = uniqueValues(bucket.negative.map((row) => row.stakeholder_role_id || row.stakeholder_role));
    const positiveGroups = uniqueValues(bucket.positive.map((row) => row.stakeholder_group_id));
    const negativeGroups = uniqueValues(bucket.negative.map((row) => row.stakeholder_group_id));
    const crossStakeholder = positiveStakeholders.some((role) => !negativeStakeholders.includes(role)) || negativeStakeholders.some((role) => !positiveStakeholders.includes(role));
    if (!bucket.positive.length || !bucket.negative.length || !crossStakeholder) continue;
    contradictions.set(domain, {
      contradiction_detected: true,
      business_domain: domain,
      severity: Math.min(5, 2 + positiveStakeholders.length + negativeStakeholders.length),
      stakeholders_involved: uniqueValues([...positiveStakeholders, ...negativeStakeholders]).map((roleId) => stakeholderRoleName(roleId)),
      stakeholder_role_ids: uniqueValues([...positiveStakeholders, ...negativeStakeholders]),
      stakeholder_role_names: uniqueValues([...positiveStakeholders, ...negativeStakeholders]).map((roleId) => stakeholderRoleName(roleId)),
      stakeholder_group_ids: uniqueValues([...positiveGroups, ...negativeGroups]),
      stakeholder_group_names: uniqueValues([...positiveGroups, ...negativeGroups]).map((groupId) => stakeholderGroupName(groupId)),
      conflicting_responses: [
        ...bucket.positive.slice(0, 3).map((row) => ({
          stakeholder_group_id: row.stakeholder_group_id,
          stakeholder_group_name: stakeholderGroupName(row.stakeholder_group_id),
          stakeholder_role_id: row.stakeholder_role_id,
          stakeholder_role_name: stakeholderRoleName(row.stakeholder_role_id),
          stakeholder_role: row.stakeholder_role,
          question_id: row.question_id,
          source_question: row.question_text,
          source_response_id: row.response_id,
          sentiment: "positive",
          response: row.answer_text
        })),
        ...bucket.negative.slice(0, 3).map((row) => ({
          stakeholder_group_id: row.stakeholder_group_id,
          stakeholder_group_name: stakeholderGroupName(row.stakeholder_group_id),
          stakeholder_role_id: row.stakeholder_role_id,
          stakeholder_role_name: stakeholderRoleName(row.stakeholder_role_id),
          stakeholder_role: row.stakeholder_role,
          question_id: row.question_id,
          source_question: row.question_text,
          source_response_id: row.response_id,
          sentiment: "negative",
          response: row.answer_text
        }))
      ]
    });
  }
  return contradictions;
}

function uniqueValues(values = []) {
  return [...new Set(values.filter(Boolean).map((value) => String(value)))];
}

function aggregateAnalysisFindings(findings = []) {
  const grouped = new Map();
  for (const finding of findings) {
    const key = `${finding.title}::${clusterKeyForProblemTypes(finding.problem_types || [])}`;
    const evidenceItems = finding.evidence_items || [
      {
        evidence_type: finding.source_question_ids?.length ? "Survey Response" : "KPI Gap",
        source_question_id: finding.source_question_ids?.[0] || null,
        source_response_id: finding.source_response_ids?.[0] || null,
        source_stakeholder_role: finding.source_stakeholder_role || null,
        stakeholder_role_id: finding.stakeholder_role_id || finding.source_stakeholder_role_id || null,
        stakeholder_group_id: finding.stakeholder_group_id || finding.source_stakeholder_group_id || null,
        description: finding.evidence_description,
        trigger_rule: finding.trigger_rule || "rule_based_analysis"
      }
    ];
    if (!grouped.has(key)) {
      grouped.set(key, {
        ...finding,
        source_question_ids: [...(finding.source_question_ids || [])],
        source_response_ids: [...(finding.source_response_ids || [])],
        evidence_items: [...evidenceItems]
      });
      continue;
    }
    const existing = grouped.get(key);
    existing.description = existing.description || finding.description;
    existing.source_question_ids = uniqueValues([...(existing.source_question_ids || []), ...(finding.source_question_ids || [])]);
    existing.source_response_ids = uniqueValues([...(existing.source_response_ids || []), ...(finding.source_response_ids || [])]);
    existing.problem_types = uniqueValues([...(existing.problem_types || []), ...(finding.problem_types || [])]);
    existing.severity = Math.max(Number(existing.severity || 1), Number(finding.severity || 1));
    existing.frequency = Math.max(Number(existing.frequency || 1), Number(finding.frequency || 1));
    existing.time_impact = Math.max(Number(existing.time_impact || 1), Number(finding.time_impact || 1));
    existing.cost_impact = Math.max(Number(existing.cost_impact || 1), Number(finding.cost_impact || 1));
    existing.customer_impact = Math.max(Number(existing.customer_impact || 1), Number(finding.customer_impact || 1));
    existing.revenue_impact = Math.max(Number(existing.revenue_impact || 1), Number(finding.revenue_impact || 1));
    existing.risk_impact = Math.max(Number(existing.risk_impact || 1), Number(finding.risk_impact || 1));
    existing.employee_impact = Math.max(Number(existing.employee_impact || 1), Number(finding.employee_impact || 1));
    existing.automation_potential = Math.max(Number(existing.automation_potential || 1), Number(finding.automation_potential || 1));
    existing.evidence_items.push(...evidenceItems);
    existing.trigger_rule = existing.trigger_rule || finding.trigger_rule;
  }

  return [...grouped.values()].map((finding) => {
    finding.source_question_ids = uniqueValues(finding.source_question_ids || []);
    finding.source_response_ids = uniqueValues(finding.source_response_ids || []);
    finding.evidence_count = finding.evidence_items?.length || 0;
    const roleIds = uniqueValues((finding.evidence_items || []).map((item) => item.stakeholder_role_id || resolveStakeholderRole(item.source_stakeholder_role || item.stakeholder_role).id));
    const groupIds = uniqueValues((finding.evidence_items || []).map((item) => item.stakeholder_group_id || stakeholderGroupForRole(item.stakeholder_role_id || resolveStakeholderRole(item.source_stakeholder_role || item.stakeholder_role).id)));
    finding.supporting_stakeholder_roles = roleIds;
    finding.supporting_stakeholder_groups = groupIds;
    finding.stakeholder_groups = roleIds.map((roleId) => stakeholderRoleName(roleId));
    finding.stakeholder_role_id = roleIds[0] || finding.stakeholder_role_id || null;
    finding.stakeholder_group_id = groupIds[0] || finding.stakeholder_group_id || null;
    finding.supporting_response_count = finding.source_response_ids.length || finding.evidence_count || 0;
    Object.assign(finding, stakeholderAgreementBreakdown({
      roles: roleIds,
      groups: groupIds,
      supportingResponses: finding.supporting_response_count || 1
    }));
    finding.confidence = confidenceScore({
      supportingResponses: finding.supporting_response_count || 1,
      stakeholderGroups: groupIds.length || 1,
      stakeholderRoles: roleIds.length || 1,
      directKpiEvidence: finding.evidence_items?.some((item) => item.evidence_type === "KPI Gap"),
      contradictionDetected: finding.contradiction_detected
    });
    finding.priority_score = calculatePriorityScore(finding);
    return finding;
  });
}

