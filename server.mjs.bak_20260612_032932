function executiveSafeAssessmentDashboard(dashboard = {}) {
  const approvedFindings = (dashboard.findings || []).filter((finding) => finding.status === "Approved");
  const approvedFindingIds = new Set(approvedFindings.map((finding) => String(finding.id)));
  const approvedRecommendations = (dashboard.recommendations || [])
    .filter((recommendation) => isRecommendationVisibleStatus(recommendation.status))
    .filter((recommendation) => !recommendation.finding_id || approvedFindingIds.has(String(recommendation.finding_id)));
  const approvedRecommendationIds = new Set(approvedRecommendations.map((recommendation) => String(recommendation.id)));
  const approvedEvidence = (dashboard.evidence || []).filter((evidence) =>
    !evidence.finding_id || approvedFindingIds.has(String(evidence.finding_id))
  );
  const approvedRoadmapItems = (dashboard.roadmapItems || []).filter((item) =>
    !item.recommendation_id || approvedRecommendationIds.has(String(item.recommendation_id))
  );
  const approvedKpiGaps = approvedFindings.filter(isKpiGapFinding);
  return {
    ...dashboard,
    assessmentParticipants: [],
    sessions: [],
    questions: [],
    findings: approvedFindings,
    evidence: approvedEvidence,
    recommendations: approvedRecommendations,
    roadmapItems: approvedRoadmapItems,
    kpiGaps: approvedKpiGaps,
    automationOpportunities: [],
    clusters: [],
    topProblemTypes: [],
    executivePreview: {
      ...(dashboard.executivePreview || {}),
      topFindings: approvedFindings.slice(0, 5),
      topRisks: approvedFindings.filter((finding) => Number(finding.priority_score || 0) >= 80).slice(0, 5),
      topOpportunities: approvedRecommendations.slice(0, 5),
      missingKpis: approvedKpiGaps.slice(0, 6),
      topRecommendations: approvedRecommendations.slice(0, 5),
      topAreasOfAgreement: (dashboard.executivePreview?.topAreasOfAgreement || []).filter((item) =>
        !item.id || approvedFindingIds.has(String(item.id))
      ),
      topAreasOfMisalignment: (dashboard.executivePreview?.topAreasOfMisalignment || []).filter((item) =>
        !item.id || approvedFindingIds.has(String(item.id))
      )
    }
  };
}

