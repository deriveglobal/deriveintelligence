      return stakeholderRolesSeed.find((role) => role.id === entry.roleId) || null;
    }
  }
  const direct = stakeholderRolesSeed.find((role) => normalizeStakeholderText(role.name) === text || normalizeStakeholderText(role.id) === text);
  if (!direct) return null;
  return blueprintQuestionBankMap[direct.id] ? direct : null;
}

function parseCsvRows(text = "") {
  const rows = [];
  let row = [];
  let cell = "";
  let quoted = false;
  const source = String(text || "").replace(/^\uFEFF/, "");
  for (let index = 0; index < source.length; index += 1) {
    const char = source[index];
    const next = source[index + 1];
    if (quoted) {
      if (char === '"' && next === '"') {
        cell += '"';
        index += 1;
      } else if (char === '"') {
        quoted = false;
      } else {
        cell += char;
      }
      continue;
    }
    if (char === '"') {
      quoted = true;
    } else if (char === ",") {
      row.push(cell);
      cell = "";
    } else if (char === "\n") {
      row.push(cell);
      rows.push(row);
      row = [];
      cell = "";
    } else if (char !== "\r") {
      cell += char;
    }
  }
  row.push(cell);
  if (row.some((value) => String(value || "").trim())) rows.push(row);
  if (!rows.length) return [];
  const headers = rows[0].map((header) => normalizeUploadColumn(header));
  return rows.slice(1).map((values, index) => {
    const record = { __rowNumber: index + 2 };
    headers.forEach((header, headerIndex) => {
      if (header) record[header] = values[headerIndex] ?? "";
    });
    return record;
  });
}

function normalizeUploadColumn(value = "") {
  return String(value || "").trim().toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "");
}

function parseAssessmentParticipantUpload({ fileBase64 = "", fileName = "" }) {
  const buffer = Buffer.from(String(fileBase64 || ""), "base64");
  if (!buffer.length) {
    const error = new Error("Upload file is empty.");
    error.statusCode = 400;
    throw error;
  }
  if (buffer.length > 5 * 1024 * 1024) {
    const error = new Error("Upload file is too large. Maximum size is 5MB.");
    error.statusCode = 413;
    throw error;
  }
  const ext = String(fileName || "").toLowerCase().split(".").pop();
  if (ext === "csv") return parseCsvRows(buffer.toString("utf8"));
  if (["xlsx", "xls"].includes(ext)) {
    const workbook = XLSX.read(buffer, { type: "buffer" });
    const sheetName = workbook.SheetNames[0];
    if (!sheetName) return [];
    return XLSX.utils.sheet_to_json(workbook.Sheets[sheetName], { defval: "" })
      .map((row, index) => {
        const normalized = { __rowNumber: index + 2 };
        Object.entries(row).forEach(([key, value]) => {
          normalized[normalizeUploadColumn(key)] = value;
        });
        return normalized;
      });
  }
  const error = new Error("Unsupported file type. Upload CSV, XLSX, or XLS.");
  error.statusCode = 400;
  throw error;
}

function splitUploadedFullName(fullName = "") {
  const parts = String(fullName || "").trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return { first_name: "", last_name: "" };
  if (parts.length === 1) return { first_name: parts[0], last_name: "" };
  return { first_name: parts.slice(0, -1).join(" "), last_name: parts.at(-1) };
}

