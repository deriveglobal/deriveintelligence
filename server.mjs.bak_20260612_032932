      return client.query(
        `select *
         from questions
         where question_id = any($1::text[])
         order by array_position($1::text[], question_id)`,
        [selectedQuestionIds]
      );
    }
  }

  const assessment = await client.query(
    "select company_id from assessments where id = $1 limit 1",
    [assessmentId]
  );
  const projectId = assessment.rows[0]?.company_id || null;
  const activities = await getSubmittedProjectActivities(client, projectId);
  if (!activities?.length) {
    return client.query(
      "select * from questions where stakeholder_role_id = $1 and coalesce(is_active, true) = true order by question_id",
      [stakeholderRoleId]
    );
  }
  return client.query(
    `select *
     from questions q
     where q.stakeholder_role_id = $1
       and coalesce(q.is_active, true) = true
       and (
         q.applicable_activities is null
         or q.applicable_activities = 'null'::jsonb
         or exists (
           select 1
           from jsonb_array_elements_text($2::jsonb) as activity(value)
           where q.applicable_activities @> jsonb_build_array(activity.value)
         )
       )
     order by q.question_id`,
    [stakeholderRoleId, JSON.stringify(activities)]
  );
}

