        ]
      );
      const row = inserted.rows[0];
      insertedFindings.push({ ...row, roadmap_relevance: finding.roadmap_relevance, recommendation_override: finding.recommendation_override });
      for (const evidenceItem of finding.evidence_items || []) {
        await client.query(
          `insert into evidence (finding_id, evidence_type, source_question_id, source_response_id, stakeholder_group_id, stakeholder_role_id, description, trigger_rule)
           values ($1, $2, $3, $4, $5, $6, $7, $8)`,
