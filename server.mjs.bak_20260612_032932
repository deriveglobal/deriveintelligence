function normalizeStakeholderText(value = "") {
  return String(value || "").toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9]+/g, " ").trim();
}

function resolveStakeholderRole(value = "", fallbackGroup = "") {
  const text = normalizeStakeholderText(value || fallbackGroup);
  const direct = stakeholderRolesSeed.find((role) => normalizeStakeholderText(role.name) === text || role.id.replace(/_/g, " ") === text);
  if (direct) return direct;
  if (/owner|shareholder/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "owner");
  if (/\bceo\b|managing director/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "ceo");
  if (/operations manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "operations_manager");
  if (/branch manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "branch_manager");
  if (/dispatcher|customer service coordinator|dispatch/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "dispatcher");
  if (/technician|field service technician/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "technician");
  if (/warehouse/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "warehouse_manager");
  if (/inventory/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "inventory_coordinator");
  if (/finance manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "finance_manager");
  if (/accountant/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "accountant");
  if (/it manager|systems administrator/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "it_manager");
  if (/\bhr\b|human resources|workforce manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "hr_manager");
  if (/sales manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "sales_manager");
  if (/sales representative|account manager/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "sales_representative");
  if (/fleet customer/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "fleet_customer");
  if (/dealer customer/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "dealer_customer");
  if (/retail customer/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "retail_customer");
  if (/service partner/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "service_partner");
  if (/dealer partner/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "dealer_partner");
  if (/supplier|vendor/.test(text)) return stakeholderRolesSeed.find((role) => role.id === "supplier");
  const groupText = normalizeStakeholderText(fallbackGroup);
  if (/executive/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "owner");
  if (/management/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "operations_manager");
  if (/commercial/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "sales_representative");
  if (/customer/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "fleet_customer");
  if (/partner/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "service_partner");
  if (/support/.test(groupText) || /finance|it/.test(groupText)) return stakeholderRolesSeed.find((role) => role.id === "finance_manager");
  return stakeholderRolesSeed.find((role) => role.id === "operations_manager");
}

