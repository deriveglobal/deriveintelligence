           context = coalesce($9::text[], context),
           sort_order = coalesce($10, sort_order),
           is_active = coalesce($11, is_active),
           updated_at = now()
         WHERE id = CASE
             WHEN $1 ~* '^[0-9a-f-]{36}$'
             THEN $1::uuid
             ELSE NULL
           END
           OR key = $1
         RETURNING *`,
        [
          keyOrId,
          payload.term || null,
          payload.term_tr || null,
          payload.definition || null,
          payload.calculation || null,
          payload.interpretation || null,
          payload.example || null,
          payload.category || null,
          Array.isArray(payload.context) ? payload.context : null,
          payload.sort_order === undefined ? null : Number(payload.sort_order),
          payload.is_active === undefined ? null : Boolean(payload.is_active)
