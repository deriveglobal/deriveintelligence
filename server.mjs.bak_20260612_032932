async function handleApi(request, response) {
  const url = new URL(request.url, "http://localhost");

  if (request.method === "POST" && url.pathname === "/api/admin/auto-tag-questions") {
    const session = await requirePlatformOwner(request, response);
    if (!session) return;
    await ensureFrameworkEngineSchema();
    try {
      const result = await query(
        `SELECT id, question_text,
                ai_analysis_purpose,
                business_domain
         FROM questions
         WHERE applicable_activities IS NULL
         ORDER BY question_id ASC`
      );
      let tagged = 0;
      let universal = 0;
      for (const question of result.rows) {
        const activities = inferQuestionActivities(
          question.question_text,
          question.ai_analysis_purpose,
          question.business_domain
        );
        if (activities?.length) {
          await query(
            `UPDATE questions
             SET applicable_activities = $2::jsonb
             WHERE id = $1`,
            [question.id, JSON.stringify(activities)]
          );
          tagged += 1;
        } else {
          universal += 1;
        }
      }
      sendJson(response, 200, {
        scanned_count: result.rowCount,
        tagged_count: tagged,
        universal_count: universal
