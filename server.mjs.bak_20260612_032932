function createAssessmentBlueprintFromProfile(profile, notApplicableRoles = []) {
  if (!profile) return null;
  const signals = new Set([
    ...(profile.businessActivities || []),
    ...(profile.operationalCharacteristics || []),
    ...(profile.strategicPriorities || [])
  ]);
  const requiredRoles = new Set(["owner", "operations_manager"]);
  const recommendedRoles = new Set(["finance_manager", "sales_manager"]);
  const optionalRoles = new Set(["fleet_customer"]);
  const requiredKpiSets = new Set();
  const requiredDomains = new Set(["strategy", "governance"]);

  const requireRoles = (roles = []) => roles.forEach((role) => {
    requiredRoles.add(role);
    recommendedRoles.delete(role);
    optionalRoles.delete(role);
  });
  const recommendRoles = (roles = []) => roles.forEach((role) => {
    if (!requiredRoles.has(role)) recommendedRoles.add(role);
    optionalRoles.delete(role);
  });
  const optionalizeRoles = (roles = []) => roles.forEach((role) => {
    if (!requiredRoles.has(role) && !recommendedRoles.has(role)) optionalRoles.add(role);
  });

  if (signals.has("mobile_tire_services")) {
    requireRoles(["dispatcher", "technician"]);
    recommendRoles(["branch_manager", "warehouse_manager", "inventory_coordinator", "finance_manager"]);
    addBlueprintValues(requiredKpiSets, ["Dispatch KPIs", "Technician Productivity KPIs", "Customer Response KPIs"]);
    addBlueprintValues(requiredDomains, ["service_delivery", "field_operations", "customer_experience", "workforce", "automation"]);
  }
  if (signals.has("roadside_tire_assistance")) {
    requireRoles(["dispatcher", "technician"]);
    recommendRoles(["branch_manager", "finance_manager", "fleet_customer"]);
    addBlueprintValues(requiredKpiSets, ["Emergency Response KPIs", "SLA KPIs", "Dispatch KPIs", "Customer Downtime KPIs"]);
    addBlueprintValues(requiredDomains, ["service_delivery", "field_operations", "customer_experience", "risk_management"]);
  }
  if (signals.has("fleet_tire_management")) {
    requireRoles(["operations_manager", "dispatcher", "technician"]);
    recommendRoles(["finance_manager", "sales_manager", "fleet_customer", "service_partner"]);
    addBlueprintValues(requiredKpiSets, ["Fleet Service KPIs", "Tire Lifecycle KPIs", "Customer Retention KPIs", "Service Profitability KPIs"]);
    addBlueprintValues(requiredDomains, ["operational_execution", "customer_perception", "financial_visibility", "profitability_drivers"]);
  }
  if (signals.has("tire_retreading")) {
    requireRoles(["operations_manager"]);
    recommendRoles(["warehouse_manager", "inventory_coordinator", "finance_manager", "sales_manager"]);
    addBlueprintValues(requiredKpiSets, ["Retread Yield KPIs", "Casing Acceptance KPIs", "Retread Profitability KPIs", "Quality KPIs"]);
    addBlueprintValues(requiredDomains, ["operational_execution", "financial_visibility", "profitability_drivers"]);
  }
  if (signals.has("inventory_intensive") || signals.has("warehouse_operations")) {
    requireRoles(["warehouse_manager"]);
    recommendRoles(["inventory_coordinator", "branch_manager", "finance_manager"]);
    addBlueprintValues(requiredKpiSets, ["Inventory Accuracy KPIs", "Stockout KPIs", "Inventory Turnover KPIs", "Working Capital KPIs"]);
    addBlueprintValues(requiredDomains, ["operational_execution", "financial_visibility", "information_flow"]);
  }
  if (signals.has("b2b_business") || signals.has("service_network_management")) {
    recommendRoles(["service_partner", "supplier"]);
  }
  if (signals.has("external_service_partners")) {
    recommendRoles(["service_partner"]);
  }
  if (["supplier_dependency", "inventory_intensive", "manufacturing", "distribution_network", "procurement_complexity"].some((signal) => signals.has(signal))) {
    recommendRoles(["supplier"]);
  }
  if (["automation", "data_reporting_improvement", "system_integration", "ai_adoption", "digital_transformation"].some((signal) => signals.has(signal))) {
    recommendRoles(["it_manager"]);
  }
  if (["workforce_productivity", "growth", "scaling", "change_management", "retention", "training"].some((signal) => signals.has(signal))) {
    recommendRoles(["hr_manager"]);
  }
  if (signals.has("multi_location_operations")) {
    requireRoles(["branch_manager"]);
    recommendRoles(["operations_manager", "finance_manager"]);
    addBlueprintValues(requiredKpiSets, ["Branch Performance KPIs", "Standardization KPIs", "Reporting Reliability KPIs"]);
    addBlueprintValues(requiredDomains, ["process_standardization", "compliance_adherence", "information_flow", "risk_awareness"]);
  }
  if (signals.has("mobile_workforce")) {
    requireRoles(["dispatcher", "technician"]);
    recommendRoles(["operations_manager", "finance_manager"]);
    addBlueprintValues(requiredKpiSets, ["Technician Utilization KPIs", "Travel Time KPIs", "Job Completion KPIs", "Mobile Workforce Productivity KPIs"]);
    addBlueprintValues(requiredDomains, ["operational_execution", "people_capability", "technology_adoption"]);
  }
  if (signals.has("data_reporting_improvement")) {
    requireRoles(["finance_manager"]);
    recommendRoles(["operations_manager", "branch_manager"]);
    addBlueprintValues(requiredKpiSets, ["Reporting Reliability KPIs", "Data Accuracy KPIs", "KPI Coverage KPIs"]);
    addBlueprintValues(requiredDomains, ["information_flow", "data_quality", "financial_visibility", "compliance_adherence"]);
  }
  if (signals.has("revenue_growth")) {
    requireRoles(["sales_manager"]);
    recommendRoles(["finance_manager", "fleet_customer"]);
    addBlueprintValues(requiredKpiSets, ["Pipeline Visibility KPIs", "Forecast Accuracy KPIs", "Customer Retention KPIs", "Profitability Visibility KPIs"]);
    addBlueprintValues(requiredDomains, ["market_intelligence", "customer_perception", "profitability_drivers", "financial_visibility"]);
  }
  if (signals.has("customer_experience_improvement") || signals.has("service_quality_improvement")) {
    requireRoles(["fleet_customer"]);
    recommendRoles(["dispatcher", "branch_manager", "sales_manager"]);
    addBlueprintValues(requiredKpiSets, ["Customer Satisfaction KPIs", "Response Time KPIs", "Service Visibility KPIs", "Issue Resolution KPIs"]);
    addBlueprintValues(requiredDomains, ["customer_perception", "operational_execution", "market_intelligence"]);
  }

  optionalizeRoles(["dealer_customer", "retail_customer", "service_partner", "supplier", "it_manager", "hr_manager"]);

  const na = new Set(notApplicableRoles.map((item) => item.role_id || item.id || item).filter(Boolean));
  for (const roleId of na) {
    requiredRoles.delete(roleId);
    recommendedRoles.delete(roleId);
    optionalRoles.delete(roleId);
  }

  return {
    requiredRoleIds: [...requiredRoles],
    recommendedRoleIds: [...recommendedRoles].filter((role) => !requiredRoles.has(role)),
    optionalRoleIds: [...optionalRoles].filter((role) => !requiredRoles.has(role) && !recommendedRoles.has(role)),
    requiredKpiSets: [...requiredKpiSets],
    requiredBusinessDomains: [...requiredDomains],
    notApplicableRoles: [...na]
  };
}

