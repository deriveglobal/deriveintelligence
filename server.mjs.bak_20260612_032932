function questionHasJsonArray(value) {
  return jsonArray(value).length > 0;
}

function normalizeSamplingConfig(config = {}) {
  return {
    min_questions: Number(config.min_questions || 12),
    max_questions: Number(config.max_questions || 20),
    target_questions: Number(config.target_questions || 15),
    min_domains: Number(config.min_domains || 3),
    max_per_domain: Number(config.max_per_domain || 4),
    require_response_type_mix: config.require_response_type_mix !== false,
    weight_domain_gap: Number(config.weight_domain_gap || 0.4),
    weight_finding_potential: Number(config.weight_finding_potential || 0.3),
    weight_effectiveness: Number(config.weight_effectiveness || 0.2),
    weight_response_diversity: Number(config.weight_response_diversity || 0.1)
  };
}

async function selectQuestionsForSession(bankId, companyActivities, industry, frameworkId, client) {
  const config = await getScoringConfig(frameworkId, client);
  const sampling = normalizeSamplingConfig(config.samplingConfig);
  const activities = Array.isArray(companyActivities) ? companyActivities : [];
  const allQuestions = await client.query(
    `SELECT
       q.id,
       q.question_id,
       q.question_text,
       q.business_domain,
       q.response_type,
       q.ai_analysis_purpose,
       q.applicable_activities,
       q.kpi_outputs,
       q.recommendation_triggers,
       q.finding_strength,
       q.used_count,
       q.score_value_avg
     FROM questions q
     WHERE q.bank_id = $1
       AND coalesce(q.is_active, true) = true
       AND (
         cardinality($2::text[]) = 0
         OR
         q.applicable_activities IS NULL
         OR q.applicable_activities = 'null'::jsonb
         OR q.applicable_activities = '[]'::jsonb
         OR q.applicable_activities @> ANY(ARRAY(
           SELECT jsonb_build_array(a)
           FROM unnest($2::text[]) a
         ))
       )
     ORDER BY q.question_id`,
    [bankId, activities]
  );

  if (allQuestions.rows.length === 0) return [];

  const questions = allQuestions.rows;
  const total = questions.length;
  if (total <= sampling.min_questions || total <= sampling.target_questions) {
    return questions.slice(0, sampling.max_questions);
  }

  const domainCounts = {};
  for (const question of questions) {
    const domain = question.business_domain;
    if (domain) domainCounts[domain] = (domainCounts[domain] || 0) + 1;
  }

  const selectedResponseTypes = new Set();
  const selectedDomains = {};
  const selectedPurposes = [];
  const selected = [];
  const domains = Object.keys(domainCounts);

  for (const domain of domains) {
    if (selected.length >= sampling.target_questions) break;

    const domainQuestions = questions
      .filter((question) => question.business_domain === domain)
      .sort((a, b) => {
        const aScore = (questionHasJsonArray(a.recommendation_triggers) ? 2 : 0) +
          (questionHasJsonArray(a.kpi_outputs) ? 1 : 0);
        const bScore = (questionHasJsonArray(b.recommendation_triggers) ? 2 : 0) +
          (questionHasJsonArray(b.kpi_outputs) ? 1 : 0);
        return bScore - aScore;
      });

    if (domainQuestions.length > 0) {
      const best = domainQuestions[0];
      selected.push(best);
      selectedDomains[domain] = (selectedDomains[domain] || 0) + 1;
      if (best.response_type) selectedResponseTypes.add(best.response_type);
      if (best.ai_analysis_purpose) selectedPurposes.push(best.ai_analysis_purpose.toLowerCase());
    }
  }

  const selectedIds = new Set(selected.map((question) => question.question_id));
  const scored = questions
    .filter((question) => !selectedIds.has(question.question_id))
    .map((question) => {
      let score = 0;
      const domainSelected = selectedDomains[question.business_domain] || 0;
      const domainGapScore = domainSelected < sampling.max_per_domain
        ? (sampling.max_per_domain - domainSelected) / sampling.max_per_domain
        : 0;
      score += domainGapScore * sampling.weight_domain_gap;
      score += (questionHasJsonArray(question.recommendation_triggers) ? 1 : 0) * sampling.weight_finding_potential;
      const effectivenessScore = Number(question.used_count || 0) > 0
        ? Math.min(1, Number(question.used_count || 0) / 20)
        : 0.5;
      score += effectivenessScore * sampling.weight_effectiveness;
      const isNewType = question.response_type && !selectedResponseTypes.has(question.response_type);
      score += (isNewType ? 1 : 0.2) * sampling.weight_response_diversity;

      if (question.ai_analysis_purpose) {
        const purpose = question.ai_analysis_purpose.toLowerCase();
        const words = purpose.split(/\s+/).filter((word) => word.length > 4);
        if (words.length > 0) {
          const isSimilar = selectedPurposes.some((selectedPurpose) => {
            const matches = words.filter((word) => selectedPurpose.includes(word));
            return matches.length / words.length > 0.5;
          });
          if (isSimilar) score *= 0.3;
        }
      }

      if ((selectedDomains[question.business_domain] || 0) >= sampling.max_per_domain) {
        score = 0;
      }

      return { ...question, _score: score };
    })
    .sort((a, b) => b._score - a._score);

  for (const question of scored) {
    if (selected.length >= sampling.target_questions || selected.length >= sampling.max_questions) break;
    if (question._score <= 0) continue;
    selected.push(question);
    selectedDomains[question.business_domain] = (selectedDomains[question.business_domain] || 0) + 1;
    if (question.response_type) selectedResponseTypes.add(question.response_type);
    if (question.ai_analysis_purpose) selectedPurposes.push(question.ai_analysis_purpose.toLowerCase());
  }

  for (let index = selected.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [selected[index], selected[swapIndex]] = [selected[swapIndex], selected[index]];
  }

  console.log(
    `[SAMPLING] Bank ${bankId}: ${total} available -> ${selected.length} selected across ${Object.keys(selectedDomains).length} domains`
  );

  return selected;
}

