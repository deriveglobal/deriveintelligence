async function authenticateUser({ email, password }) {
  await ensureAccessControlSchema();
  await ensureCreatorUser();
  const normalized = normalizeEmail(email);
  const expiresAt = new Date(Date.now() + 1000 * 60 * 60 * 24 * 14);
  const result = await query(
    `select
       u.*,
       u.name,
       u.role,
       om.organization_id,
       om.role as organization_role,
       om.status as membership_status,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from users u
     left join organization_memberships om on om.user_id = u.id
     left join project_memberships pm on pm.user_id = u.id and pm.organization_id = om.organization_id
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     where u.email = $1
     order by pm.created_at desc nulls last
     limit 1`,
    [normalized]
  );
  if (!result.rowCount || result.rows[0].status === "disabled" || !verifyPassword(password, result.rows[0].password_hash)) {
    throw new Error("Invalid email or password.");
  }
  const user = mapUser(result.rows[0]);
  if (!["active", "invited"].includes(result.rows[0].membership_status || result.rows[0].status || "active")) {
    throw new Error("Invalid email or password.");
  }
  const token = await createSession(user.id, { userAgent: "password" }, expiresAt);
  await query("update users set last_login_at = now() where id = $1", [user.id]);
  return { user, sessionToken: token, expiresAt };
}

async function createSession(userId, metadata = {}, expiresAt = new Date(Date.now() + 1000 * 60 * 60 * 24 * 14)) {
  if (!userId) throw new Error("User id is required for session creation.");
  const token = randomBytes(32).toString("base64url");
  await query(
    `insert into user_sessions (user_id, token_hash, expires_at, metadata)
     values ($1, $2, $3, $4)`,
    [userId, hashToken(token), expiresAt, metadata]
  );
  return token;
}

async function getSessionUser(request) {
  await ensureAccessControlSchema();
  const token = getBearerToken(request);
  if (!token) return null;
  const result = await query(
    `select
       us.id as session_id,
       us.user_id,
       us.expires_at,
       u.email,
       u.name,
       u.full_name,
       u.role,
       u.status,
       om.organization_id,
       om.role as organization_role,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from user_sessions us
     join users u on u.id = us.user_id
     left join organization_memberships om on om.user_id = u.id and om.status = 'active'
     left join project_memberships pm on pm.user_id = u.id and pm.status = 'active' and (pm.organization_id = om.organization_id or om.organization_id is null)
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     where us.token_hash = $1
       and us.revoked_at is null
       and us.expires_at > now()
       and u.status = 'active'
     order by pm.created_at desc nulls last
     limit 1`,
    [hashToken(token)]
  );
  if (!result.rowCount) return null;
  const row = result.rows[0];
  return {
    sessionId: row.session_id,
    userId: row.user_id,
    email: row.email,
    name: row.name || row.full_name || "",
    role: normalizeRole(row.assignment_role || row.project_role || row.organization_role || row.role),
    organizationId: row.organization_id,
    projectId: row.company_id || row.assessment_project_id
  };
}

async function requireAuth(request, allowedRoles = []) {
  await ensureCreatorUser();
  const session = await getSessionUser(request);
  if (!session) {
    const error = new Error("Authentication required.");
    error.statusCode = 401;
    throw error;
  }
  if (!roleAllowed(session.role, allowedRoles)) {
    const error = new Error("You do not have permission to perform this action.");
    error.statusCode = 403;
    throw error;
  }
  return session;
}

async function requireProjectAccess(session, projectId, allowedRoles = []) {
  await ensureAccessControlSchema();
  if (!projectId || normalizeRole(session.role) === "platform_owner") return;
  const result = await query(
    `select role from (
       select pm.role
       from project_memberships pm
       where pm.user_id = $1 and pm.assessment_project_id = $2 and pm.status = 'active'
       union all
       select cua.role
       from company_user_assignments cua
       where cua.user_id = $1 and cua.company_id = $2 and cua.is_active = true
       union all
       select 'consultant' as role
       from consultant_company_assignments cca
       where cca.consultant_user_id = $1 and cca.company_id = $2 and cca.is_active = true
     ) access_roles
     limit 1`,
    [session.userId, projectId]
  );
  if (!result.rowCount) {
    const error = new Error("Project access denied.");
    error.statusCode = 403;
    throw error;
  }
  const role = normalizeRole(result.rows[0].role);
  if (!roleAllowed(role, allowedRoles)) {
    const error = new Error("Project role does not allow this action.");
    error.statusCode = 403;
    throw error;
  }
}

