async function listUsers({ organizationId, projectId } = {}) {
  await ensureAccessControlSchema();
  await ensureCreatorUser();
  const params = [];
  const filters = [];
  if (organizationId) {
    params.push(organizationId);
    filters.push(`om.organization_id = $${params.length}`);
  }
  if (projectId) {
    params.push(projectId);
    filters.push(`pm.assessment_project_id = $${params.length}`);
  }
  const where = filters.length ? `where ${filters.join(" and ")}` : "";
  const result = await query(
    `select
       u.id,
       u.email,
       u.name,
       u.full_name,
       u.role,
       u.status,
       u.credentials_sent_at,
       u.created_at,
       om.organization_id,
       om.role as organization_role,
       om.status as membership_status,
       pm.assessment_project_id,
       pm.role as project_role,
       cua.company_id,
       cua.role as assignment_role
     from users u
     left join organization_memberships om on om.user_id = u.id
     left join project_memberships pm on pm.user_id = u.id and (pm.organization_id = om.organization_id or om.organization_id is null)
     left join company_user_assignments cua on cua.user_id = u.id and cua.is_active = true and (cua.company_id = pm.assessment_project_id or pm.assessment_project_id is null)
     ${where}
     order by u.created_at desc`,
    params
  );
  return result.rows.map((row) => mapUser(row));
}

async function upsertUser(payload) {
  await ensureAccessControlSchema();
  const role = normalizeRole(payload.role);
  const legacyRole = legacyRoleForMembership(role);
  const email = normalizeEmail(payload.email);
  if (!isEmail(email)) throw new Error("Valid email is required.");

  const context = payload.projectId
    ? await getDefaultContext({ projectId: payload.projectId, department: "General" })
    : await getDefaultContext({ department: "General" });

  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    const existing = await client.query("select id from users where email = $1 limit 1", [email]);
    const password = payload.password || generateTemporaryPassword();
    const returnedPassword = payload.password || !existing.rowCount ? password : null;
    const user = existing.rowCount
      ? await client.query(
          `update users
           set full_name = coalesce($2, full_name),
               name = coalesce($2, name),
               role = $4,
               password_hash = case when $3::text is null then password_hash else $3 end,
               password_reset_required = case when $3::text is null then password_reset_required else true end,
               status = 'active',
               updated_at = now()
           where id = $1
           returning *`,
          [existing.rows[0].id, payload.name || null, payload.password ? hashPassword(password) : null, role]
        )
      : await client.query(
          `insert into users (email, full_name, name, role, password_hash, password_reset_required, status)
           values ($1, $2, $2, $4, $3, true, 'active')
           returning *`,
          [email, payload.name || "", hashPassword(password), role]
        );
    const userId = user.rows[0].id;
    await client.query(
      `insert into organization_memberships (organization_id, user_id, role, status)
       values ($1, $2, $3, 'active')
       on conflict (organization_id, user_id) do update set role = excluded.role, status = 'active'`,
      [context.organizationId, userId, legacyRole]
    );
    await client.query(
      `insert into project_memberships (organization_id, assessment_project_id, user_id, role, status)
       values ($1, $2, $3, $4, 'active')
       on conflict (assessment_project_id, user_id) do update set role = excluded.role, status = 'active', updated_at = now()`,
      [context.organizationId, context.projectId, userId, legacyRole]
    );
    await client.query(
      `insert into company_user_assignments (user_id, company_id, role, permissions_json, is_active)
       values ($1, $2, $3, $4, true)
       on conflict (user_id, company_id, role) do update set permissions_json = excluded.permissions_json, is_active = true, updated_at = now()`,
      [userId, context.projectId, role, JSON.stringify(payload.permissions || {})]
    );
    if (role === "consultant") {
      await client.query(
        `insert into consultant_company_assignments (consultant_user_id, company_id, assigned_by_user_id, is_active, revoked_at)
         values ($1, $2, $3, true, null)
         on conflict (consultant_user_id, company_id) do update set is_active = true, revoked_at = null`,
        [userId, context.projectId, payload.assignedByUserId || null]
      );
    }
    await client.query("commit");
    return mapUser({
      ...user.rows[0],
      organization_id: context.organizationId,
      company_id: context.projectId,
      assessment_project_id: context.projectId,
      assignment_role: role,
      project_role: legacyRole,
      membership_status: "active"
    }, returnedPassword);
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

async function updateUserLifecycle(userId, payload = {}) {
  await ensureAccessControlSchema();
  const role = payload.role ? normalizeRole(payload.role) : null;
  const legacyRole = role ? legacyRoleForMembership(role) : null;
  const status = payload.status && ["active", "invited", "disabled"].includes(payload.status) ? payload.status : null;
  const context = payload.projectId
    ? await getDefaultContext({ projectId: payload.projectId, department: "General" })
    : await getDefaultContext({ department: "General" });

