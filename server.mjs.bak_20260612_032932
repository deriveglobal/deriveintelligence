async function getAssessmentMetrics(assessmentIds, client) {
  if (!assessmentIds.length) return { rows: [] };
  const sessions = await client.query(
    `select assessment_id,
            count(distinct id) filter (where status in ('completed', 'analyzed'))::int as completed_sessions
     from assessment_sessions
     where assessment_id = any($1::uuid[])
     group by assessment_id`,
    [assessmentIds]
  );
  const responses = await client.query(
    `select s.assessment_id,
            count(distinct r.id)::int as responses_count
     from assessment_sessions s
     join responses r on r.assessment_session_id = s.id
     where s.assessment_id = any($1::uuid[])
     group by s.assessment_id`,
    [assessmentIds]
  );
  const findings = await client.query(
    `select assessment_id,
            count(distinct id)::int as findings_count,
            count(distinct id) filter (
              where (business_domain = 'information_flow' or assessment_category = 'data')
                and (problem_types ? 'reporting_gap' or problem_types ? 'missing_kpi' or problem_types ? 'data_visibility')
            )::int as kpi_gap_findings,
            count(distinct id) filter (where contradiction_detected = true)::int as contradictions_count
     from findings
     where assessment_id = any($1::uuid[])
     group by assessment_id`,
    [assessmentIds]
  );
  const evidence = await client.query(
    `select f.assessment_id,
            count(distinct e.id)::int as evidence_count
     from evidence e
     join findings f on f.id = e.finding_id
     where f.assessment_id = any($1::uuid[])
     group by f.assessment_id`,
    [assessmentIds]
  );
  const recommendations = await client.query(
    `select assessment_id,
            count(distinct id)::int as recommendations_count,
            count(distinct id) filter (where coalesce(why_recommendation_exists, '') <> '' and recommendation_confidence_score is not null)::int as v2_recommendations_count,
            count(distinct id) filter (where coalesce(estimated_business_value, 0) > 0)::int as roi_estimate_count
     from recommendations
     where assessment_id = any($1::uuid[])
     group by assessment_id`,
    [assessmentIds]
  );
  const roadmap = await client.query(
    `select assessment_id,
            count(distinct id)::int as roadmap_items_count
     from roadmap_items
     where assessment_id = any($1::uuid[])
     group by assessment_id`,
    [assessmentIds]
  );
  const rowMaps = [sessions, responses, findings, evidence, recommendations, roadmap]
    .map((result) => new Map(result.rows.map((row) => [String(row.assessment_id), row])));
  return {
    rows: assessmentIds.map((assessmentId) => {
      const key = String(assessmentId);
      return {
        assessment_id: assessmentId,
        completed_sessions: Number(rowMaps[0].get(key)?.completed_sessions || 0),
        responses_count: Number(rowMaps[1].get(key)?.responses_count || 0),
        findings_count: Number(rowMaps[2].get(key)?.findings_count || 0),
        evidence_count: Number(rowMaps[3].get(key)?.evidence_count || 0),
        kpi_gap_findings: Number(rowMaps[2].get(key)?.kpi_gap_findings || 0),
        contradictions_count: Number(rowMaps[2].get(key)?.contradictions_count || 0),
        recommendations_count: Number(rowMaps[4].get(key)?.recommendations_count || 0),
        v2_recommendations_count: Number(rowMaps[4].get(key)?.v2_recommendations_count || 0),
        roi_estimate_count: Number(rowMaps[4].get(key)?.roi_estimate_count || 0),
        roadmap_items_count: Number(rowMaps[5].get(key)?.roadmap_items_count || 0)
      };
    })
  };
}

