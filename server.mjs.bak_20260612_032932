function normalizeAnswerList(value) {
  if (Array.isArray(value)) return value.map((item) => String(item).trim()).filter(Boolean);
  return String(value || "")
    .split(/,|>/)
    .map((item) => item.trim())
    .filter(Boolean);
}

function numericFromAnswer(value) {
  const match = String(value || "").replace(",", ".").match(/-?\d+(\.\d+)?/);
  return match ? Number(match[0]) : null;
}

function scoreAnswer(question, answerText) {
  const mapping = question.score_mapping || {};
  if (!Object.keys(mapping).length) return null;
  const exact = mapping[String(answerText)];
  if (exact !== undefined) return Number(exact);
  const numeric = numericFromAnswer(answerText);
  if (numeric !== null && mapping[String(numeric)] !== undefined) return Number(mapping[String(numeric)]);
  return null;
}

function calculatePriorityScore(finding) {
  const score =
    (finding.severity * 0.3 +
      finding.frequency * 0.2 +
      finding.customer_impact * 0.15 +
      finding.revenue_impact * 0.15 +
      finding.cost_impact * 0.1 +
      finding.risk_impact * 0.1) * 20;
  return Math.round(score * 100) / 100;
}

function isRecommendationVisibleStatus(status, includeDrafts = false) {
  if (includeDrafts) return status !== "Rejected";
  return ["Approved", "Accepted", "In Progress", "Completed"].includes(status);
}

function isKpiGapFinding(finding = {}) {
  const problemTypes = Array.isArray(finding.problem_types) ? finding.problem_types : [];
  const hasKpiSignal = problemTypes.some((type) => ["reporting_gap", "missing_kpi", "data_visibility"].includes(type));
  const domain = String(finding.business_domain || "").toLowerCase();
  const category = String(finding.assessment_category || "").toLowerCase();
  return hasKpiSignal && (domain === "information_flow" || category === "data");
}

function calculateRecommendationAccuracyScore(values = {}) {
  const pairs = [
    [values.actual_value, values.expected_value],
    [values.actual_time_savings, values.expected_time_savings],
    [values.actual_cost_savings, values.expected_cost_savings]
  ]
    .filter(([actual]) => actual !== null && actual !== undefined && actual !== "")
    .map(([actual, expected]) => [Number(actual), Number(expected)])
    .filter(([actual, expected]) => Number.isFinite(actual) && Number.isFinite(expected) && expected > 0);
  if (!pairs.length) return null;
  const averageRatio = pairs
    .map(([actual, expected]) => Math.max(0, Math.min(1.25, actual / expected)))
    .reduce((sum, ratio) => sum + ratio, 0) / pairs.length;
  return Math.round(Math.min(100, averageRatio * 100) * 100) / 100;
}

function confidenceScore({ supportingResponses = 1, stakeholderGroups = 1, stakeholderRoles = 1, directKpiEvidence = false, contradictionDetected = false } = {}) {
  let score = 2;
  if (supportingResponses >= 2) score += 2;
  if (supportingResponses >= 5) score += 1;
  if (stakeholderGroups >= 2) score += 1;
  if (stakeholderRoles >= 3) score += 1;
  if (directKpiEvidence) score += 1;
  if (contradictionDetected) score -= 1;
  return Math.max(1, Math.min(5, score));
}

function stakeholderAgreementScore({ stakeholderGroups = 1, stakeholderRoles = 1, supportingResponses = 1 } = {}) {
  if (stakeholderGroups >= 3 && stakeholderRoles >= 4) return 5;
  if (stakeholderGroups >= 2 && stakeholderRoles >= 3) return 4;
  if (stakeholderGroups >= 2 || stakeholderRoles >= 2) return supportingResponses >= 3 ? 3 : 2;
  return 1;
}

function agreementScoreFromCount(count = 1, supportingResponses = 1) {
  if (count >= 4) return 5;
  if (count === 3) return 4;
  if (count === 2) return supportingResponses >= 3 ? 3 : 2;
  return supportingResponses >= 2 ? 2 : 1;
}

function stakeholderAgreementBreakdown({ roles = [], groups = [], supportingResponses = 1 } = {}) {
  const roleCount = uniqueValues(roles).length || 1;
  const groupCount = uniqueValues(groups).length || 1;
  const roleScore = agreementScoreFromCount(roleCount, supportingResponses);
  const groupScore = agreementScoreFromCount(groupCount, supportingResponses);
  const overall = Math.max(1, Math.min(5, Math.round(((roleScore * 0.6) + (groupScore * 0.4)) * 10) / 10));
  return {
    stakeholder_role_agreement_score: roleScore,
    stakeholder_group_agreement_score: groupScore,
    overall_stakeholder_agreement_score: overall,
    stakeholder_agreement_score: Math.round(overall)
  };
}

function classifyPhase(roadmapRelevance, priorityScore) {
  if (roadmapRelevance === "quick_win") return "Quick Wins";
  if (roadmapRelevance === "optimization") return "Optimization";
  if (roadmapRelevance === "transformation") return "Transformation";
  if (priorityScore >= 90) return "Foundation";
  return "Foundation";
}

function clusterKeyForProblemTypes(problemTypes = []) {
  if (problemTypes.some((type) => ["whatsapp_dependency", "email_dependency", "spreadsheet_dependency", "communication_breakdown", "data_silo"].includes(type))) {
