    }

    if (kpiId && request.method === "DELETE" && parts.length === 3) {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const kpi = await query("SELECT key, name FROM framework_kpis WHERE id = $1", [kpiId]);
      if (!kpi.rowCount) {
        sendJson(response, 404, { error: "KPI not found." });
        return true;
      }
      const linked = await query("SELECT COUNT(*)::int as count FROM questions WHERE kpi_outputs::text LIKE '%' || $1 || '%'", [kpi.rows[0].key]);
      const count = Number(linked.rows[0]?.count || 0);
      if (count > 0) {
        sendJson(response, 409, {
          error: "cannot_delete_in_use",
          message: `Cannot delete — linked to ${count} questions. Deactivate instead.`,
          question_count: count
        });
        return true;
      }
      await query("DELETE FROM framework_kpis WHERE id = $1", [kpiId]);
      sendJson(response, 200, { deleted: true });
      return true;
    }

    sendJson(response, 404, { error: "KPI endpoint not found." });
    return true;
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
    return true;
  }
}

