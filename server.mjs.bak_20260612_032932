function frameworkString(value) {
  return String(value || "").trim();
}

function parseQuestionMetadata(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
}

function mapFrameworkQuestion(row) {
  const metadata = parseQuestionMetadata(row.metadata);
  return {
    ...row,
    section_name: metadata.section_name || row.section,
    sort_order: Number(metadata.sort_order || 0),
    follow_up_logic: metadata.follow_up_logic || [],
    current_state_value: metadata.current_state_value ?? null,
    desired_state_value: metadata.desired_state_value ?? null,
    gap_calculation_enabled: Boolean(metadata.gap_calculation_enabled),
    updated_at: metadata.updated_at || null
  };
}

function mapDomainTaxonomy(row = {}) {
  return {
    ...row,
    question_count: Number(row.question_count || 0),
    is_active: row.is_active !== false
  };
}

async function getActiveDomainsForContext(client, industry = null) {
  const result = await client.query(
    `SELECT key, name, category, scope
     FROM domain_taxonomy
     WHERE is_active = true
     AND (scope = 'universal'
       OR industry = $1)
     ORDER BY sort_order ASC`,
    [industry]
  );
  return result.rows;
}

async function validateQuestionDomain(domain, industry, client) {
  if (!domain) return {
    valid: true, warning: null
  };
  const result = await client.query(
    `SELECT id, scope FROM domain_taxonomy
     WHERE key = $1
     AND is_active = true
     AND (scope = 'universal'
       OR industry = $2)`,
    [domain, industry]
  );
  if (result.rows.length === 0) {
    return {
      valid: false,
      warning: `Domain '${domain}' not found in taxonomy for industry '${industry}'. Question saved but will not be analyzed.`
    };
  }
  return { valid: true, warning: null };
}

