function jsonArray(value) {
  if (Array.isArray(value)) return value;
  if (typeof value !== "string") return [];
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function calculateCoverageScore(questions, config, companyActivities = null) {
  const {
    weights,
    breadthConfig,
    quantityConfig,
    depthConfig,
    qualityTargets,
    gradeThresholds,
    samplingConfig
  } = config;

  const expectedDomains = breadthConfig.expected_domains || EXPECTED_FLEET_DOMAINS;
  const minPerDomain = Number(breadthConfig.min_questions_per_domain || 2);
  const targetPerDomain = Number(quantityConfig.target_per_domain || 5);
  const sampling = normalizeSamplingConfig(samplingConfig);
  const deepThreshold = Number(depthConfig.deep_domain_threshold || 5);
  const total = questions.length;

  const domainCounts = {};
  const responseTypes = new Set();
  let kpiLinked = 0;
  let findingPotential = 0;
  const activityCoverage = new Set();

  for (const q of questions) {
    const domain = q.business_domain ? String(q.business_domain).trim() : "";
    if (domain) {
      domainCounts[domain] = (domainCounts[domain] || 0) + 1;
    }
    if (q.response_type) responseTypes.add(q.response_type);
    if (jsonArray(q.kpi_outputs).length > 0) kpiLinked += 1;
    if (
      jsonArray(q.recommendation_triggers).length > 0 ||
      jsonArray(q.problem_types_detectable).length > 0
    ) {
      findingPotential += 1;
    }
    for (const activity of jsonArray(q.applicable_activities)) {
      activityCoverage.add(activity);
    }
  }

  const coveredDomains = expectedDomains.filter((domain) => (domainCounts[domain] || 0) >= minPerDomain);
  const breadthRaw = expectedDomains.length > 0 ? coveredDomains.length / expectedDomains.length : 0;
  const breadthScore = Math.round(breadthRaw * Number(weights.breadth || 0));

  const uniqueSignals = new Set(questions.map((question) => {
    const domain = question.business_domain || "unknown";
    const purpose = question.ai_analysis_purpose
      ? String(question.ai_analysis_purpose).slice(0, 30)
      : "generic";
    return `${domain}:${purpose}`;
  }));
  const targetSignals = sampling.target_questions * 1.5;
  const quantityRaw = targetSignals > 0 ? Math.min(1, uniqueSignals.size / targetSignals) : 0;
  const quantityScore = Math.round(quantityRaw * Number(weights.quantity || 0));
  const avgPerDomain = coveredDomains.length > 0
    ? coveredDomains.reduce((sum, domain) => sum + (domainCounts[domain] || 0), 0) / coveredDomains.length
    : 0;

  const deepDomains = expectedDomains.filter((domain) => (domainCounts[domain] || 0) >= deepThreshold);
  const depthRaw = expectedDomains.length > 0 ? deepDomains.length / expectedDomains.length : 0;
  const depthScore = Math.round(depthRaw * Number(weights.depth || 0));

  const typesUsed = responseTypes.size;
  const responseMixRaw = typesUsed >= 3 ? 1 : typesUsed === 2 ? 0.6 : typesUsed === 1 ? 0.2 : 0;
  const responseMixScore = Math.round(responseMixRaw * Number(weights.response_mix || 0));

  let activityFitScore = Number(weights.activity_fit || 0);
  if (Array.isArray(companyActivities) && companyActivities.length > 0) {
    const hasUniversalQuestion = questions.some((q) => jsonArray(q.applicable_activities).length === 0);
    const covered = companyActivities.filter((activity) => activityCoverage.has(activity) || hasUniversalQuestion).length;
    activityFitScore = Math.round((covered / companyActivities.length) * Number(weights.activity_fit || 0));
  }

  const totalScore = Math.min(100, breadthScore + quantityScore + depthScore + responseMixScore + activityFitScore);
  const kpiLinkagePct = total > 0 ? Math.round((kpiLinked / total) * 100) : 0;
  const findingPotentialPct = total > 0 ? Math.round((findingPotential / total) * 100) : 0;
  const qualityScore = Math.round((kpiLinkagePct + findingPotentialPct) / 2);
  const grade = coverageGrade(totalScore, gradeThresholds);
  const missingDomains = expectedDomains.filter((domain) => (domainCounts[domain] || 0) < minPerDomain);
  const actualDomains = Object.keys(domainCounts);
  const flags = [];
  if (total < 10) flags.push("Too few questions");
  if (missingDomains.length) flags.push(`${missingDomains.length} expected domains need coverage`);
  if (kpiLinkagePct < Number(qualityTargets.kpi_linkage_pct || 80)) flags.push("KPI linkage below target");
  if (findingPotentialPct < Number(qualityTargets.finding_potential_pct || 80)) flags.push("Finding potential below target");

  const breakdown = {
    total: totalScore,
    grade,
    flags,
    components: {
      breadth: {
        score: breadthScore,
        max: Number(weights.breadth || 0),
        raw: breadthRaw,
        covered_domains: coveredDomains.length,
        expected_domains: expectedDomains.length,
        missing_domains: missingDomains,
        weight_pct: Number(weights.breadth || 0),
        description: `How many of the expected domains are covered with ${minPerDomain}+ questions`
      },
      quantity: {
        score: quantityScore,
        max: Number(weights.quantity || 0),
        raw: quantityRaw,
        avg_per_domain: Math.round(avgPerDomain * 10) / 10,
        target_per_domain: targetPerDomain,
        unique_signals: uniqueSignals.size,
        target_signals: Math.round(targetSignals * 10) / 10,
        weight_pct: Number(weights.quantity || 0),
        description: `Pool richness: unique domain and analysis-purpose signals in the bank. Target: ${Math.round(targetSignals * 10) / 10}+ unique signals for sampling.`
      },
      depth: {
        score: depthScore,
        max: Number(weights.depth || 0),
        raw: depthRaw,
        deep_domains: deepDomains.length,
        deep_threshold: deepThreshold,
        weight_pct: Number(weights.depth || 0),
        description: `Domains with deep coverage (${deepThreshold}+ questions). Depth enables nuanced misalignment detection.`
      },
      response_mix: {
        score: responseMixScore,
        max: Number(weights.response_mix || 0),
        types_used: typesUsed,
        types: [...responseTypes],
        weight_pct: Number(weights.response_mix || 0),
        description: "Variety of question formats. Mixed formats reduce response bias and improve data quality."
      },
      activity_fit: {
        score: activityFitScore,
        max: Number(weights.activity_fit || 0),
        activities_covered: [...activityCoverage],
        company_activities: Array.isArray(companyActivities) ? companyActivities : [],
        weight_pct: Number(weights.activity_fit || 0),
        description: "Questions relevant to company declared activities."
      }
    },
    quality: {
      score: qualityScore,
      kpi_linkage_pct: kpiLinkagePct,
      kpi_linked: kpiLinked,
      finding_potential_pct: findingPotentialPct,
      finding_potential: findingPotential,
      total_questions: total,
      targets: qualityTargets
    },
    domain_distribution: domainCounts,
    domains: {
      covered: coveredDomains,
      actual: actualDomains,
      expected: expectedDomains
    },
    config: {
      weights,
      breadthConfig,
      quantityConfig,
      depthConfig,
      qualityTargets,
      gradeThresholds,
      samplingConfig: sampling
    }
  };

  return {
    ...breakdown,
    breadth: breakdown.components.breadth,
    quantity: breakdown.components.quantity,
    depth: breakdown.components.depth,
    response_mix: breakdown.components.response_mix,
    activity_fit: breakdown.components.activity_fit,
    kpi_linkage: {
      score: Math.round((kpiLinkagePct / 100) * 25),
      max: 25,
      detail: `${kpiLinked}/${total} questions linked to KPIs`,
      pct: kpiLinkagePct
    },
    finding_potential: {
      score: Math.round((findingPotentialPct / 100) * 25),
      max: 25,
      detail: `${findingPotential}/${total} questions have finding potential`,
      pct: findingPotentialPct
    }
  };
}

async function calculateBankCoverageScore(bankId, clientOrPool = null) {
  const db = clientOrPool || requireDatabase();
  const bankResult = await db.query(
    `SELECT id, framework_id
     FROM framework_question_banks
     WHERE id = $1
     LIMIT 1`,
    [bankId]
  );
  const frameworkId = bankResult.rows[0]?.framework_id || null;
  const config = await getScoringConfig(frameworkId, db);
  const questions = await db.query(
    `SELECT
       id,
       business_domain,
       ai_analysis_purpose,
       response_type,
       kpi_outputs,
       recommendation_triggers,
       problem_types_detectable,
       applicable_activities
     FROM questions
     WHERE bank_id = $1`,
    [bankId]
  );
  return calculateCoverageScore(questions.rows, config, null);
}

function validateScoringConfigValue(configKey, configValue) {
  if (!configKey || typeof configKey !== "string") {
    return "config_key is required.";
  }
  if (!configValue || typeof configValue !== "object" || Array.isArray(configValue)) {
    return "config_value must be an object.";
  }
  if (configKey === "weights") {
    const total = ["breadth", "quantity", "depth", "response_mix", "activity_fit"]
      .reduce((sum, key) => sum + Number(configValue[key] || 0), 0);
    if (total !== 100) return "Scoring weights must total 100.";
  }
  return null;
}

async function handleScoringConfigApi(request, response, url) {
  if (!url.pathname.startsWith("/api/scoring-config")) return false;
  await ensureFrameworkEngineSchema();
  try {
    if (request.method === "GET" && url.pathname === "/api/scoring-config") {
      await requireAuth(request, ["platform_owner", "consultant"]);
      const frameworkId = url.searchParams.get("frameworkId") || null;
      sendJson(response, 200, {
        framework_id: frameworkId,
        config: await getScoringConfig(frameworkId, requireDatabase())
      });
      return true;
    }

    if (request.method === "PATCH" && url.pathname === "/api/scoring-config") {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const payload = await readJson(request);
      const frameworkId = payload.framework_id || null;
      const configKey = frameworkString(payload.config_key);
      const configValue = payload.config_value;
      const validationError = validateScoringConfigValue(configKey, configValue);
      if (validationError) {
        sendJson(response, 400, { error: validationError });
        return true;
      }

      const existing = await query(
        `SELECT id
         FROM framework_scoring_config
         WHERE config_key = $1
           AND (
             framework_id = $2::uuid
             OR ($2::uuid IS NULL AND framework_id IS NULL)
           )
         LIMIT 1`,
        [configKey, frameworkId]
      );
      let updated;
      if (existing.rowCount) {
        updated = await query(
          `UPDATE framework_scoring_config
           SET config_value = $2::jsonb,
             updated_by = $3,
             updated_at = now()
           WHERE id = $1
           RETURNING *`,
          [existing.rows[0].id, JSON.stringify(configValue), session.userId]
        );
      } else {
        updated = await query(
          `INSERT INTO framework_scoring_config
             (framework_id, config_key,
              config_value, updated_by)
           VALUES ($1::uuid, $2, $3::jsonb, $4)
           RETURNING *`,
          [frameworkId, configKey, JSON.stringify(configValue), session.userId]
        );
      }
      sendJson(response, 200, {
        row: updated.rows[0],
        config: await getScoringConfig(frameworkId, requireDatabase())
      });
      return true;
    }

    if (request.method === "POST" && url.pathname === "/api/scoring-config/reset") {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const payload = await readJson(request);
      const frameworkId = payload.framework_id || null;
      let deleted = { rowCount: 0 };
      if (frameworkId) {
        deleted = await query(
          "DELETE FROM framework_scoring_config WHERE framework_id = $1::uuid",
          [frameworkId]
        );
      }
      sendJson(response, 200, {
        reset: true,
        deleted_count: deleted.rowCount || 0,
        config: await getScoringConfig(null, requireDatabase())
      });
      return true;
    }

    sendJson(response, 404, { error: "Scoring config endpoint not found." });
    return true;
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
    return true;
  }
}

async function handleGlossaryApi(request, response, url) {
  if (!url.pathname.startsWith("/api/glossary")) return false;
