      }
      const activities = await query(
        `SELECT key, label, group_name
         FROM framework_activities
         WHERE industry = $1
           AND is_active = true
         ORDER BY sort_order ASC`,
        [industry]
      );
      const activityList = activities.rows
        .map((activity) => `- ${activity.key}: ${activity.label} (${activity.group_name})`)
        .join("\n");
      const prompt = `You are building a KPI definition for an organizational intelligence platform used by tire and fleet service companies in Turkey.

The user wants to measure:
${description}

Industry context:
${getIndustryPriorities(industry)}

Available business activities:
${activityList}

Generate a complete KPI definition. Return ONLY valid JSON, no preamble:

{
