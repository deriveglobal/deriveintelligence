        title: rec.title,
        related_finding: approvedFindings.find((finding) => String(finding.id) === String(rec.finding_id))?.title || "",
        estimated_annual_value: Number(rec.estimated_business_value || 0),
        time_savings: Number(rec.estimated_time_savings || 0),
        cost_savings: Number(rec.estimated_cost_savings || 0),
        revenue_opportunity: Number(rec.estimated_revenue_opportunity || 0),
        risk_reduction: Number(rec.estimated_risk_reduction || 0),
        roi_confidence: Number(rec.roi_confidence_score || 0),
        assumptions: rec.value_estimation_details || {}
      }))
  };

  const roadmap = ["Quick Wins", "Foundation", "Optimization", "Transformation"].reduce((acc, phase) => {
    acc[phase] = roadmapItems.filter((item) => item.phase === phase);
    return acc;
  }, {});
  const nextBestActions = approvedRecommendations
    .filter((rec) => Number(rec.business_value_score || 0) >= 4 || Number(rec.priority_score || 0) >= 75)
    .slice(0, 5)
    .map((rec) => {
      const finding = approvedFindings.find((item) => String(item.id) === String(rec.finding_id));
      return {
        title: rec.title,
        why_it_matters: rec.why_recommendation_exists || rec.expected_impact || rec.description,
        expected_benefit: rec.expected_benefit,
        recommended_owner: rec.recommended_owner || "Executive sponsor",
        data_to_capture: (rec.related_kpi_gaps || []).map((kpi) => kpi.name || kpi.id),
        success_30_days: "Confirm owner, scope, required data, and baseline KPI capture.",
        success_60_days: "Pilot the improved workflow and review early KPI movement.",
        success_90_days: "Standardize the operating model and prepare the next roadmap phase.",
        related_finding: finding?.title || "",
        evidence_count: finding?.evidence_count || 0,
        estimated_business_value: Number(rec.estimated_business_value || 0)
      };
    });

  const topFindings = approvedFindings.slice(0, 10).map((finding) => {
    const recommendation = recommendationByFinding.get(String(finding.id));
    return {
      ...finding,
      related_recommendation: recommendation ? {
        id: recommendation.id,
        title: recommendation.title,
        estimated_business_value: Number(recommendation.estimated_business_value || 0)
      } : null,
      evidence_reference: evidenceByFinding.find((item) => String(item.finding_id) === String(finding.id)) || null
    };
  });
  const perceptionGaps = assessmentId
    ? await query(
      `select
         dpg.domain_key,
         dpg.owner_baseline_score,
         dpg.participant_avg_score,
         dpg.perception_gap,
         dpg.gap_severity,
         dt.name as domain_name
       from domain_perception_gaps dpg
       join domain_taxonomy dt
         on dt.key = dpg.domain_key
       where dpg.assessment_id = $1
         and dpg.owner_baseline_score is not null
         and dpg.participant_avg_score is not null
       order by abs(dpg.perception_gap) desc nulls last`,
      [assessmentId]
    )
    : { rows: [] };
  const intake = await query(
    `select
       context_data->>'assessmentSuccess' as success_looks_like,
       context_data->>'mostUrgentPriority' as most_urgent_priority,
       context_data->>'mostImportantRevenue' as most_important_revenue,
       context_data->>'topPriorities' as top_priorities,
       context_data->>'maturity_dataQuality' as maturity_data_quality,
       context_data->>'maturity_technology' as maturity_technology,
       context_data->>'maturity_automation' as maturity_automation,
       context_data->>'maturity_analytics' as maturity_analytics,
       context_data->>'maturity_reporting' as maturity_reporting,
       context_data->>'maturity_processStandardization' as maturity_process_std,
       context_data->>'maturity_customerExperience' as maturity_customer_exp
     from project_context_intakes
     where assessment_project_id = $1
       and status = 'submitted'
     order by submitted_at desc
     limit 1`,
    [projectId]
  );

  return {
    report: {
      assessment_id: assessmentId,
      company_id: projectId,
      company_name: dashboard.companyProfile?.companyName || dashboard.assessment?.title || "Assessment Company",
      assessment_name: dashboard.assessment?.title || "Assessment",
      report_title: "Business Intelligence & Digital Transformation Assessment Report",
      report_subtitle: "Evidence-based findings, KPI gaps, recommendations, and transformation roadmap.",
      generated_at: new Date().toISOString(),
      prepared_by: "Derive Assessment Platform",
      executive_summary: buildExecutiveSummary({
        findings: approvedFindings,
        recommendations: approvedRecommendations,
        kpiGaps,
        blueprint: dashboard.assessmentBlueprint
      }),
      company_dna: dashboard.companyProfile || {},
      assessment_coverage: dashboard.assessmentBlueprint || {},
      stakeholder_sessions: dashboard.sessions || [],
      top_findings: topFindings,
      perceptionGaps: perceptionGaps.rows,
      intakeExpectations: intake.rows[0] || null,
      evidence_summary: evidenceByFinding,
      agreement_summary: {
        areas_of_strong_agreement: approvedFindings
          .filter((finding) => Number(finding.overall_stakeholder_agreement_score || finding.stakeholder_agreement_score || 0) >= 2)
          .slice(0, 8),
        areas_of_misalignment: approvedFindings
          .filter((finding) => finding.contradiction_detected)
          .slice(0, 8)
      },
      kpi_gaps: kpiGaps,
      business_value_summary: businessValueSummary,
      recommendations: approvedRecommendations,
      roadmap,
      alignment_summary: buildReportAlignmentSummary(approvedFindings),
      progress_memory: dashboard.progressMemory || {},
      next_best_actions: nextBestActions,
      appendix: {
        methodology: "Organization Profile informs stakeholder selection, question bank activation, KPI expectations, finding severity, recommendation context, roadmap placement, and executive confidence.",
        stakeholder_roles_included: uniqueStrings((dashboard.sessions || []).map((session) => session.stakeholder_role_name || session.stakeholder_role)),
        question_banks_used: dashboard.assessmentBlueprint?.required_question_banks || [],
        scoring_logic_summary: {
          priority_score: "Weighted severity, frequency, customer impact, revenue impact, cost impact, and risk impact.",
          recommendation_confidence: "Evidence count, stakeholder agreement, KPI support, contradiction level, and finding confidence.",
          assessment_confidence: "Stakeholder diversity, finding confidence, evidence density, KPI coverage, and contradiction review status."
        },
        evidence_reference_count: evidence.length,
        include_drafts: includeDrafts
      }
    }
  };
}

const PDF_REPORT_COLORS = {
  page: "#FFFFFF",
  primary: "#1A1A18",
  secondary: "#4A4A48",
  muted: "#6A6A68",
  gold: "#C8A96E",
  risk: "#C85A3A",
  opportunity: "#3A8A5A",
  border: "#E8E6E0",
  coverBand: "#0A0A08"
};

const PDF_PHASES = ["Quick Wins", "Foundation", "Optimization", "Transformation"];

function safePdfFilename(value) {
  return String(value || "Derive")
    .replace(/[^a-z0-9\-_\s]/gi, "")
    .trim()
    .replace(/\s+/g, "-")
    .slice(0, 80) || "Derive";
}

function formatReportDate(value = new Date()) {
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return new Date().toLocaleDateString("en-GB", { month: "long", day: "numeric", year: "numeric" });
  return date.toLocaleDateString("en-GB", { month: "long", day: "numeric", year: "numeric" });
}

function reportMonthYear(value = new Date()) {
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return formatReportDate();
  return date.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
}

function truncateReportText(value, length = 240) {
  const text = cleanPdfText(value);
  return text.length > length ? `${text.slice(0, length - 3)}...` : text;
}

function cleanPdfText(value) {
  return String(value || "")
    .replace(/_/g, " ")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/\s+/g, " ")
    .trim();
}

function formatDomainLabel(raw) {
  if (!raw) return "";
  return String(raw)
    .replace(/_/g, " ")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .trim();
}

function pluralize(count, word) {
  return Number(count) === 1 ? word : `${word}s`;
}

function normalizeReportPhase(value) {
  const text = String(value || "").toLowerCase().replace(/[_-]/g, " ");
  if (text.includes("quick")) return "Quick Wins";
  if (text.includes("optimization") || text.includes("optimisation")) return "Optimization";
  if (text.includes("transformation") || text.includes("strategic")) return "Transformation";
  return "Foundation";
}

function severityLabel(finding) {
  const severity = Number(finding?.severity || 0);
  if (severity >= 4) return "High";
  if (severity >= 2) return "Medium";
  return "Low";
}

function severityColor(finding) {
  const label = severityLabel(finding);
  if (label === "High") return PDF_REPORT_COLORS.risk;
  if (label === "Medium") return PDF_REPORT_COLORS.gold;
  return PDF_REPORT_COLORS.opportunity;
}

function reportBusinessActivities(profile) {
  const raw = profile?.business_activities || profile?.businessActivities || [];
  if (Array.isArray(raw)) return raw;
  if (typeof raw === "string") {
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return raw ? [raw] : [];
    }
  }
  return [];
}

function groupReportRoadmap(recommendations = [], roadmapItems = []) {
  const grouped = Object.fromEntries(PDF_PHASES.map((phase) => [phase, []]));
  for (const item of roadmapItems || []) {
    const phase = normalizeReportPhase(item.phase || item.roadmap_phase || item.roadmap_relevance);
    grouped[phase].push({
      title: item.title || item.recommendation_title || "Roadmap item",
      description: item.description || item.business_value || item.expected_outcome || "",
      owner: item.owner_role || item.recommended_owner || "Executive sponsor",
      timeline: item.estimated_timeline || item.timeline || ""
    });
  }
  if (!Object.values(grouped).some((items) => items.length)) {
    for (const rec of recommendations || []) {
      const phase = normalizeReportPhase(rec.roadmap_phase || rec.roadmap_relevance);
      grouped[phase].push({
        title: rec.title || "Recommendation",
        description: rec.expected_outcome || rec.expected_operational_benefit || rec.description || "",
        owner: rec.recommended_owner || "Executive sponsor",
        timeline: rec.estimated_timeline || ""
      });
    }
  }
  return PDF_PHASES.map((phase) => ({ phase, items: grouped[phase] }));
}

async function fetchReportData(projectId) {
  if (!projectId) {
    const error = new Error("projectId is required.");
    error.statusCode = 400;
    throw error;
  }
  const projectResult = await query("select * from assessment_projects where id = $1 limit 1", [projectId]);
  if (!projectResult.rowCount) {
    const error = new Error("Assessment project not found.");
    error.statusCode = 404;
    throw error;
  }
  const project = projectResult.rows[0];
  const assessmentResult = await query(
    "select * from assessments where company_id = $1 order by created_at desc limit 1",
    [projectId]
  );
  if (!assessmentResult.rowCount) {
    const error = new Error("Assessment not found for project.");
    error.statusCode = 404;
    throw error;
  }
  const assessment = assessmentResult.rows[0];
  const profileResult = await query("select * from company_profiles where assessment_project_id = $1 limit 1", [projectId]);
  const profile = profileResult.rows[0] || {};
  const dashboard = await getAssessmentEngineDashboard(projectId);
  const findings = (dashboard.findings || [])
    .filter((finding) => String(finding.status || "") === "Approved")
    .sort((a, b) => Number(b.severity || b.priority_score || 0) - Number(a.severity || a.priority_score || 0));
  const recommendations = (dashboard.recommendations || [])
    .filter((rec) => String(rec.status || "") === "Approved")
    .sort((a, b) => Number(b.priority_score || b.business_value_score || 0) - Number(a.priority_score || a.business_value_score || 0));
  const approvedRecommendationIds = new Set(recommendations.map((rec) => String(rec.id)));
  const roadmapItems = (dashboard.roadmapItems || []).filter((item) =>
    approvedRecommendationIds.has(String(item.recommendation_id))
  );
  const kpiGapResult = await query(
    `select pkg.*, kd.name as kpi_name, kd.business_domain as domain, kd.description as kpi_description
     from project_kpi_gaps pkg
     left join kpi_definitions kd on kd.id = pkg.kpi_definition_id
     where pkg.assessment_project_id = $1
     order by pkg.created_at desc`,
    [projectId]
  ).catch(() => ({ rows: [] }));
  const kpiGaps = kpiGapResult.rows.length
    ? kpiGapResult.rows.map((gap) => ({
      ...gap,
      gap_description: gap.why_it_matters || gap.kpi_description || gap.related_recommendation || gap.kpi_name,
      domain: gap.domain || gap.business_domain || "Operations"
    }))
    : findings
      .filter(isKpiGapFinding)
      .map((finding) => ({
        gap_description: finding.description || finding.title,
        domain: finding.business_domain || finding.assessment_category || "Operations"
      }));
  const evidenceByFinding = (dashboard.evidence || []).reduce((acc, evidence) => {
    const key = String(evidence.finding_id || "");
    if (!key) return acc;
    acc[key] ||= [];
    acc[key].push(evidence);
    return acc;
  }, {});
  const criticalFindings = findings.filter((finding) => Number(finding.severity || 0) >= 4).length;
  return {
    organization: {
      name: project.client_display_name || profile.company_name || project.name || "Assessment Company",
      industry: profile.industry || project.industry_context || "Not specified",
      employeeRange: profile.employee_range || "",
      locationCount: profile.location_count || null,
      revenueRange: profile.revenue_range || "",
      businessActivities: reportBusinessActivities(profile)
    },
    assessment: {
      title: assessment.title || project.name || "Organizational Intelligence Assessment",
      date: formatReportDate(assessment.created_at || project.created_at),
      rawDate: assessment.created_at || project.created_at,
      id: assessment.id,
      consultant: "Derive"
    },
    findings,
    criticalFindings,
    recommendations,
    kpiGaps,
    roadmap: groupReportRoadmap(recommendations, roadmapItems),
    evidenceByFinding,
    sessions: dashboard.sessions || []
  };
}

function createPdfDocument(title) {
  return new PDFDocument({
    size: "A4",
    margin: 50,
    compress: false,
    info: {
      Title: title,
      Author: "Derive Organizational Intelligence Platform",
      Creator: "Derive"
    }
  });
}

function finishPdf(doc) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    doc.on("data", (chunk) => chunks.push(chunk));
    doc.on("end", () => resolve(Buffer.concat(chunks)));
    doc.on("error", reject);
    doc.end();
  });
}

function pdfFooter(doc, data, pageNumber) {
  const y = doc.page.height - 64;
  doc.strokeColor(PDF_REPORT_COLORS.border).lineWidth(0.5).moveTo(50, y - 10).lineTo(doc.page.width - 50, y - 10).stroke();
  doc.font("Helvetica").fontSize(9).fillColor(PDF_REPORT_COLORS.muted);
  doc.text("Derive Organizational Intelligence", 50, y, { width: 170, lineBreak: false });
  doc.text(`Confidential - ${data.organization.name}`, 210, y, { width: 180, align: "center", lineBreak: false });
  doc.text(String(pageNumber), doc.page.width - 90, y, { width: 40, align: "right", lineBreak: false });
}

function pdfSectionHeader(doc, title, y = 70) {
  doc.rect(50, y + 1, 3, 14).fill(PDF_REPORT_COLORS.gold);
  doc.font("Helvetica-Bold").fontSize(14).fillColor(PDF_REPORT_COLORS.primary).text(title, 62, y, { width: 460 });
  return y + 34;
}

function pdfWrappedText(doc, text, x, y, options = {}) {
  doc.font(options.bold ? "Helvetica-Bold" : "Helvetica")
    .fontSize(options.size || 11)
    .fillColor(options.color || PDF_REPORT_COLORS.secondary)
    .text(text || "", x, y, {
      width: options.width || 480,
      lineGap: options.lineGap ?? 3,
      continued: false
    });
  return doc.y;
}

function drawMetricBox(doc, x, y, width, height, value, label, color = PDF_REPORT_COLORS.primary) {
  doc.strokeColor(PDF_REPORT_COLORS.border).lineWidth(0.5).rect(x, y, width, height).stroke();
  doc.font("Helvetica-Bold").fontSize(28).fillColor(color).text(String(value), x + 12, y + 14, { width: width - 24 });
  doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text(label, x + 12, y + 48, { width: width - 24 });
}

function drawCoverPage(doc, data) {
  doc.rect(0, 0, doc.page.width, 40).fill(PDF_REPORT_COLORS.coverBand);
  doc.font("Helvetica-Bold").fontSize(11).fillColor(PDF_REPORT_COLORS.gold).text("DERIVE", 50, 15, { width: 180 });
  doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.gold).text("ORGANIZATIONAL INTELLIGENCE", 50, 120, { characterSpacing: 1 });
  doc.font("Helvetica-Bold").fontSize(32).fillColor(PDF_REPORT_COLORS.primary).text(data.organization.name, 50, 148, { width: 490, lineGap: 4 });
  doc.font("Helvetica").fontSize(14).fillColor(PDF_REPORT_COLORS.secondary).text(data.assessment.title, 50, doc.y + 8, { width: 490 });
  doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.muted).text(data.assessment.date, 50, doc.y + 8);
  doc.strokeColor(PDF_REPORT_COLORS.border).lineWidth(0.5).moveTo(50, doc.y + 40).lineTo(545, doc.y + 40).stroke();
  doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text("Executive Summary - Confidential", 50, doc.y + 52, { width: 300 });
