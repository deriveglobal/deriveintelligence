}

async function createParticipantAssessmentSession(participantId) {
  const client = await requireDatabase().connect();
  try {
    await client.query("begin");
    await ensureAssessmentEngineSchema(client);
    await seedOperationsManagerQuestions(client);
    const participant = await client.query("select * from assessment_participants where participant_id = $1 limit 1", [participantId]);
    if (!participant.rowCount) {
      const error = new Error("Participant not found.");
      error.statusCode = 404;
      throw error;
    }
    const row = participant.rows[0];
    if (!row.is_active || row.status === "deactivated") {
      const error = new Error("Cannot create a session for a deactivated participant.");
      error.statusCode = 400;
      throw error;
    }
    if (row.session_id) {
      const existing = await client.query("select * from assessment_sessions where id = $1 limit 1", [row.session_id]);
      await client.query("commit");
      return { participant: mapAssessmentParticipant({ ...row, session_status: existing.rows[0]?.status || null }), session: existing.rows[0] || null };
    }
    if (!blueprintQuestionBankMap[row.stakeholder_role_id]) {
      const error = new Error("Question bank is not loaded for this stakeholder role.");
      error.statusCode = 400;
      throw error;
    }
    const assessment = await client.query(
      "select company_id from assessments where id = $1 limit 1",
      [row.assessment_id]
    );
    const projectId = assessment.rows[0]?.company_id || null;
    const bank = await client.query(
      `select b.id, b.framework_id, f.industry
       from framework_question_banks b
       join frameworks f on f.id = b.framework_id
       where b.role_key = $1
         and b.status = 'active'
       order by
         case when f.status = 'active' then 0 else 1 end,
         b.created_at desc nulls last
       limit 1`,
      [row.stakeholder_role_id]
    );
    const companyActivities = await getSubmittedProjectActivities(client, projectId);
    const selectedQuestions = bank.rowCount
      ? await selectQuestionsForSession(
          bank.rows[0].id,
          companyActivities || [],
          normalizeIndustry(bank.rows[0].industry || "tire_fleet_service"),
          bank.rows[0].framework_id,
          client
        )
      : [];
    const selectedQuestionIds = selectedQuestions.map((question) => question.question_id).filter(Boolean);
    const session = await client.query(
      `insert into assessment_sessions
        (assessment_id, stakeholder_role, stakeholder_group_id, stakeholder_role_id,
         respondent_name, respondent_email, status, participant_id,
         selected_question_ids, question_count)
       values ($1, $2, $3, $4, $5, $6, 'started', $7, $8::jsonb, $9)
       returning *`,
      [
        row.assessment_id,
        stakeholderRoleName(row.stakeholder_role_id),
        row.stakeholder_group_id,
        row.stakeholder_role_id,
        row.full_name,
        row.email,
        row.participant_id,
        JSON.stringify(selectedQuestionIds),
        selectedQuestionIds.length
      ]
    );
    if (selectedQuestionIds.length) {
      await client.query(
        `update questions
         set used_count = coalesce(used_count, 0) + 1
         where question_id = any($1::text[])`,
        [selectedQuestionIds]
      );
    }
    const updated = await client.query(
      `update assessment_participants
       set session_id = $2, status = 'not_invited', updated_at = now()
       where participant_id = $1
       returning *`,
      [row.participant_id, session.rows[0].id]
    );
    await client.query("commit");
    return { participant: mapAssessmentParticipant({ ...updated.rows[0], session_status: session.rows[0].status }), session: session.rows[0] };
  } catch (error) {
    await client.query("rollback");
    throw error;
  } finally {
    client.release();
  }
}

