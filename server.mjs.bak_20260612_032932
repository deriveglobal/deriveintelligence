async function getFrameworkReadiness(frameworkId) {
  const requiredBanks = await query(
    `select b.id, b.role_name, b.status, count(q.id)::int as question_count
     from framework_question_banks b
     left join questions q on q.bank_id = b.id
     where b.framework_id = $1 and b.requirement = 'required'
     group by b.id
     order by b.sort_order asc`,
    [frameworkId]
  );
  const kpis = await query(
    `select count(*)::int as total_kpis,
            count(distinct domain_name)::int as total_domains
     from framework_kpis
     where framework_id = $1`,
    [frameworkId]
  );
  const blockers = [];
  for (const bank of requiredBanks.rows) {
    if (bank.status !== "active") blockers.push(`${bank.role_name} required bank is not active.`);
    if (Number(bank.question_count || 0) < 5) blockers.push(`${bank.role_name} required bank needs at least 5 questions.`);
  }
  const totalKpis = Number(kpis.rows[0]?.total_kpis || 0);
  const totalDomains = Number(kpis.rows[0]?.total_domains || 0);
  if (totalDomains < 1) blockers.push("At least one KPI domain is required.");
  if (totalKpis < 1) blockers.push("At least one KPI is required.");
  return {
    total_required_banks: requiredBanks.rows.length,
    active_required_banks: requiredBanks.rows.filter((bank) => bank.status === "active").length,
    total_domains: totalDomains,
    total_kpis: totalKpis,
    ready_to_activate: blockers.length === 0,
    blockers
  };
}

