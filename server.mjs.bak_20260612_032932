  }
  if (/profitability|margin|cost/.test(title) || problemTypes.some((type) => /profitability|margin|cost/.test(type))) {
    ["customer_profitability", "service_profitability", "gross_margin", "cost_per_service"].forEach((kpi) => mapped.add(kpi));
  }
  if (/not measured/i.test(finding.title || "")) {
    const inferred = String(finding.title || "").replace(/ not measured/i, "").toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");
    if (inferred) mapped.add(inferred);
  }
  const related = [...mapped].filter((kpi) =>
    !deactivatedTireKpiIds.has(kpi) &&
    (!recommendedKpis.length || recommendedKpis.includes(kpi) || /billing|profit|margin|cost|revenue/.test(kpi))
  );
  return related.map((kpiId) => ({ id: kpiId, name: kpiLabel(kpiId) }));
}

function recommendationOwnerForFinding(finding) {
  const domain = String(finding.business_domain || "");
  const category = String(finding.assessment_category || "");
  const problemTypes = finding.problem_types || [];
  if (domain.includes("finance") || category.includes("finance") || problemTypes.some((type) => /billing|revenue|cost|profit|financial/.test(type))) return "Finance Manager";
  if (domain.includes("technology") || category.includes("technology")) return "IT Manager";
  if (domain.includes("data") || category.includes("data")) return "Operations Manager";
  if (domain.includes("operations") || category.includes("operations")) return "Operations Manager";
  if (domain.includes("inventory") || domain.includes("warehouse") || problemTypes.some((type) => /inventory|stockout|warehouse/.test(type))) return "Warehouse Manager / Inventory Coordinator";
  if (domain.includes("field") || problemTypes.some((type) => /dispatch|scheduling|whatsapp|communication/.test(type))) return "Operations Manager";
  if (domain.includes("branch")) return "Branch Manager";
  return "Operations Manager";
}

function roadmapDependenciesForRecommendation(recommendation, finding, relatedKpiGaps = []) {
  const dependencies = new Set();
  const text = `${recommendation.title} ${recommendation.description} ${(finding.problem_types || []).join(" ")}`.toLowerCase();
  if (relatedKpiGaps.length) dependencies.add("Define KPI ownership and data capture rules");
  if (/dashboard|report|visibility/.test(text)) dependencies.add("Create reliable source data and standard KPI definitions");
  if (/integration|workflow|dispatch|billing|inventory/.test(text)) dependencies.add("Map current workflow handoffs and required system fields");
  if (/mobile|technician|field/.test(text)) dependencies.add("Standardize field status and completion data capture");
  if (/profitability|cost|margin/.test(text)) dependencies.add("Agree cost allocation model and financial data owners");
  return [...dependencies];
}

function recommendationConfidenceScore(finding, relatedKpiGaps = []) {
  let score = Math.max(1, Math.min(5, Math.round(Number(finding.confidence || 3))));
  if (Number(finding.evidence_count || 0) >= 3) score += 1;
  if (Number(finding.overall_stakeholder_agreement_score || finding.stakeholder_agreement_score || 0) >= 3) score += 1;
  if (relatedKpiGaps.length) score += 1;
  if (finding.contradiction_detected) score -= 1;
  return Math.max(1, Math.min(5, score));
}

function recommendationSpecificityScore(recommendation, relatedKpiGaps = [], companyProfile = {}) {
  let score = 2;
  const text = `${recommendation.title} ${recommendation.description} ${recommendation.benefit}`.toLowerCase();
  if (text.length > 160) score += 1;
  if (/(dispatch|billing|inventory|profitability|customer|technician|branch|kpi|sla|workflow|portal|dashboard)/.test(text)) score += 1;
  if (relatedKpiGaps.length) score += 1;
  if ((companyProfile.businessActivities || []).length || (companyProfile.operationalCharacteristics || []).length) score += 1;
  return Math.max(1, Math.min(5, score));
}

function expectedImpactLabel(finding) {
  const priority = Number(finding.priority_score || 0);
  if (priority >= 90) return "Critical business impact";
  if (priority >= 75) return "High business impact";
  if (priority >= 50) return "Moderate business impact";
  return "Focused improvement impact";
}

function employeeScaleMultiplier(companyProfile = {}) {
  const employeeRange = String(companyProfile.employeeRange || companyProfile.company_size || "").toLowerCase();
  if (/251|250\+|500|1000/.test(employeeRange)) return 2.5;
  if (/101|250/.test(employeeRange)) return 2;
  if (/51|100/.test(employeeRange)) return 1.5;
  if (/26|50/.test(employeeRange)) return 1.2;
  return 1;
}

function locationScaleMultiplier(companyProfile = {}) {
  const locationCount = Number(companyProfile.locationCount || companyProfile.location_count || 1);
  if (locationCount >= 15) return 2.2;
  if (locationCount >= 8) return 1.8;
  if (locationCount >= 3) return 1.4;
  return 1;
}

function extractWeeklyHoursFromFinding(finding = {}) {
  const text = `${finding.title || ""} ${finding.description || ""}`.toLowerCase();
  const patterns = [
    /(\d+(?:\.\d+)?)\s*(?:hours|hrs|hour)\s*(?:per|\/)\s*week/,
    /(\d+(?:\.\d+)?)\s*(?:weekly)\s*(?:hours|hrs|hour)/,
    /(\d+(?:\.\d+)?)\s*(?:hours|hrs|hour)\s*(?:lost|spent|wasted)/
  ];
  for (const pattern of patterns) {
    const match = text.match(pattern);
    if (match) return Math.max(0, Number(match[1]));
  }
  return null;
}

function calculateRoiConfidenceScore({ finding, relatedKpiGaps = [], estimatedFromEvidence = false }) {
  let score = 1;
  if (Number(finding.confidence || 0) >= 4) score += 1;
  if (Number(finding.evidence_count || 0) >= 3) score += 1;
  if (Number(finding.overall_stakeholder_agreement_score || finding.stakeholder_agreement_score || 0) >= 3) score += 1;
  if (relatedKpiGaps.length || estimatedFromEvidence) score += 1;
  if (finding.contradiction_detected) score -= 1;
  return Math.max(1, Math.min(5, score));
}

function estimateBusinessValueV1(recommendation, finding, { companyProfile = null, relatedKpiGaps = [] } = {}) {
  const problemTypes = finding.problem_types || [];
  const profile = companyProfile || {};
  const scaleMultiplier = employeeScaleMultiplier(profile) * locationScaleMultiplier(profile);
  const priorityMultiplier = Math.max(0.5, Math.min(1.5, Number(finding.priority_score || 50) / 75));
  const laborRate = 45;
  const extractedWeeklyHours = extractWeeklyHoursFromFinding(finding);
  const hasConcreteHours = extractedWeeklyHours !== null;
  let weeklyHoursSaved = 0;
  let estimatedCostSavings = 0;
  let estimatedRevenueOpportunity = 0;
  let estimatedRiskReduction = 0;
  const valueDrivers = [];

  if (problemTypes.some((type) => ["manual_process", "duplicate_activity", "spreadsheet_dependency", "paper_based_process", "lack_of_automation", "rework"].includes(type))) {
    weeklyHoursSaved += hasConcreteHours ? Math.min(80, extractedWeeklyHours * 0.6) : Math.round((3 + Number(finding.evidence_count || 1) * 1.5) * scaleMultiplier);
    valueDrivers.push("manual_work_reduction");
  }

  if (problemTypes.some((type) => /dispatch|slow_response_time|communication_breakdown|whatsapp_dependency|poor_service_visibility/.test(type))) {
    weeklyHoursSaved += Math.round(4 * scaleMultiplier * priorityMultiplier);
    estimatedRevenueOpportunity += Math.round(12000 * scaleMultiplier * priorityMultiplier);
    valueDrivers.push("service_coordination_and_customer_visibility");
  }

  if (problemTypes.some((type) => /inventory|stockout|warehouse|missing_data|poor_data_quality/.test(type)) || String(finding.title || "").toLowerCase().includes("inventory")) {
    estimatedCostSavings += Math.round(18000 * scaleMultiplier * priorityMultiplier);
    estimatedRevenueOpportunity += Math.round(10000 * scaleMultiplier * priorityMultiplier);
    valueDrivers.push("inventory_availability_and_accuracy");
  }

  if (problemTypes.some((type) => /billing|revenue_leakage|cost_overrun|margin|cashflow|financial/.test(type)) || String(finding.business_domain || "").includes("finance")) {
    estimatedCostSavings += Math.round(10000 * scaleMultiplier * priorityMultiplier);
    estimatedRevenueOpportunity += Math.round(16000 * scaleMultiplier * priorityMultiplier);
    valueDrivers.push("financial_leakage_and_visibility");
  }

  if (problemTypes.includes("reporting_gap") || String(finding.title || "").toLowerCase().includes("not measured")) {
    weeklyHoursSaved += Math.round(2 * scaleMultiplier);
    estimatedRiskReduction += Math.round(8000 * scaleMultiplier * priorityMultiplier);
    valueDrivers.push("kpi_gap_and_reporting_visibility");
  }

  if (Number(finding.risk_impact || 0) >= 4 || problemTypes.some((type) => /risk|continuity|compliance/.test(type))) {
    estimatedRiskReduction += Math.round(12000 * scaleMultiplier * priorityMultiplier);
    valueDrivers.push("risk_reduction");
  }

  const annualHoursSaved = Math.round(weeklyHoursSaved * 52);
  estimatedCostSavings += Math.round(annualHoursSaved * laborRate);
  const estimatedBusinessValue = estimatedCostSavings + estimatedRevenueOpportunity + estimatedRiskReduction;
  const roiConfidenceScore = calculateRoiConfidenceScore({
    finding,
    relatedKpiGaps,
    estimatedFromEvidence: hasConcreteHours
  });

  return {
    estimatedTimeSavings: annualHoursSaved,
    estimatedCostSavings,
    estimatedRevenueOpportunity,
    estimatedRiskReduction,
    estimatedBusinessValue,
    roiConfidenceScore,
    valueEstimationDetails: {
      model: "business_value_roi_v1",
      annualized: true,
      currency: "USD",
      labor_rate_assumption: laborRate,
      scale_multiplier: Number(scaleMultiplier.toFixed(2)),
      priority_multiplier: Number(priorityMultiplier.toFixed(2)),
      extracted_weekly_hours: extractedWeeklyHours,
      value_drivers: valueDrivers,
      note: "Directional estimate based on approved findings, impact scores, stakeholder evidence, KPI gaps, and company context. Replace assumptions with measured KPI baselines as data matures."
    }
  };
}

function enrichRecommendationV2(recommendation, finding, { companyProfile = null } = {}) {
  const profileSignals = companyProfileSignalsFromProfile(companyProfile || {});
  const problemTypes = finding.problem_types || [];
  const relatedKpiGaps = kpiGapsForFinding(finding, companyProfile || {});
  const supportingGroups = stakeholderGroupLabels(finding.supporting_stakeholder_groups || []);
  const supportingRoles = stakeholderRoleLabels(finding.supporting_stakeholder_roles || []);
