}

async function createOrUpdateProjectContextIntake(payload, session, origin = "") {
  const context = await getDefaultContext({ projectId: payload.projectId, department: "General" });
  const token = payload.token || randomBytes(24).toString("base64url");
  const contextData = payload.contextData && typeof payload.contextData === "object" ? payload.contextData : {};
  const result = await query(
    `insert into project_context_intakes
      (organization_id, assessment_project_id, token, recipient_name, recipient_email, language_code, status, context_data, created_by)
     values ($1, $2, $3, $4, $5, $6, $7, $8, $9)
     on conflict (token) do update set
       recipient_name = excluded.recipient_name,
       recipient_email = excluded.recipient_email,
       language_code = excluded.language_code,
       status = excluded.status,
       context_data = excluded.context_data,
       updated_at = now()
     returning *`,
    [
      context.organizationId,
      context.projectId,
      token,
      payload.recipientName || null,
      normalizeEmail(payload.recipientEmail || "") || null,
      payload.language || "tr",
      payload.status || "draft",
      contextData,
      session?.userId || null
    ]
  );
  if (Object.keys(contextData).length) {
    await ensureAssessmentEngineSchema();
    await upsertCompanyProfile({
      organizationId: context.organizationId,
      projectId: context.projectId,
      contextIntakeId: result.rows[0].id,
      contextData,
      submittedAt: result.rows[0].submitted_at || null
    });
  }
  return mapProjectContextIntake(result.rows[0], origin);
}

async function getProjectContextIntakeByToken(token, origin = "") {
  const result = await query(
    `select pci.*, ap.client_display_name, ap.name as project_name, o.name as organization_name
     from project_context_intakes pci
     join assessment_projects ap on ap.id = pci.assessment_project_id
     join organizations o on o.id = pci.organization_id
     where pci.token = $1
     limit 1`,
    [token]
  );
  if (!result.rowCount) return null;
  await query(
    "update project_context_intakes set status = case when status = 'draft' then 'opened' else status end, opened_at = coalesce(opened_at, now()), updated_at = now() where token = $1",
    [token]
  );
  return {
    ...mapProjectContextIntake(result.rows[0], origin),
    projectName: result.rows[0].project_name,
    clientDisplayName: result.rows[0].client_display_name,
    organizationName: result.rows[0].organization_name
  };
}

async function submitProjectContextIntakeByToken(token, contextData) {
  const result = await query(
    `update project_context_intakes
     set context_data = $2,
         status = 'submitted',
         submitted_at = now(),
         updated_at = now()
     where token = $1
     returning *`,
    [token, contextData && typeof contextData === "object" ? contextData : {}]
  );
  if (!result.rowCount) {
    const error = new Error("Context intake link not found.");
    error.statusCode = 404;
    throw error;
  }
  await ensureAssessmentEngineSchema();
  await upsertCompanyProfile({
    organizationId: result.rows[0].organization_id,
    projectId: result.rows[0].assessment_project_id,
    contextIntakeId: result.rows[0].id,
    contextData: result.rows[0].context_data || {},
    submittedAt: result.rows[0].submitted_at || new Date()
  });
  return mapProjectContextIntake(result.rows[0]);
}

