async function getFrameworkCoverage(frameworkId) {
  const config = await getScoringConfig(frameworkId, requireDatabase());
  const banks = await query(
    `select b.*, count(q.id)::int as question_count
     from framework_question_banks b
     left join questions q on q.bank_id = b.id
     where b.framework_id = $1
     group by b.id
     order by b.sort_order asc, b.created_at asc`,
    [frameworkId]
  );
  const scoredBanks = [];
  for (const bank of banks.rows) {
    scoredBanks.push({
      bank_id: bank.id,
      role_name: bank.role_name,
      role_key: bank.role_key,
      requirement: bank.requirement,
      question_count: Number(bank.question_count || 0),
      coverage: await calculateBankCoverageScore(bank.id)
    });
  }
  const overallScore = scoredBanks.length
    ? Math.round(scoredBanks.reduce((sum, bank) => sum + Number(bank.coverage.total || 0), 0) / scoredBanks.length)
    : 0;
  const gradeCounts = scoredBanks.reduce((counts, bank) => {
    const grade = bank.coverage.grade;
    if (grade === "A") counts.excellent += 1;
    else if (grade === "B") counts.good += 1;
    else if (grade === "C") counts.adequate += 1;
    else if (grade === "D") counts.needs_improvement += 1;
    else counts.insufficient += 1;
    if (["D", "F"].includes(grade)) counts.flagged_banks.push(bank.role_name);
    return counts;
  }, {
    excellent: 0,
    good: 0,
    adequate: 0,
    needs_improvement: 0,
    insufficient: 0,
    flagged_banks: []
  });
  return {
    framework_id: frameworkId,
    overall_score: overallScore,
    grade: coverageGrade(overallScore, config.gradeThresholds),
    banks: scoredBanks,
    summary: gradeCounts
  };
}

async function getDomainWithQuestionCount(domainId) {
  const result = await query(
    `SELECT d.*,
      COUNT(q.id)::int as question_count
     FROM domain_taxonomy d
     LEFT JOIN questions q
       ON q.business_domain = d.key
     WHERE d.id = $1
     GROUP BY d.id`,
    [domainId]
  );
  return result.rowCount ? mapDomainTaxonomy(result.rows[0]) : null;
}

async function handleDomainTaxonomyApi(request, response, url) {
  if (!url.pathname.startsWith("/api/domains")) return false;
  await ensureFrameworkEngineSchema();
  const parts = url.pathname.split("/").filter(Boolean).map(decodeURIComponent);
  const domainId = parts[2] || null;
  const child = parts[3] || null;

  try {
    if (request.method === "GET" && parts.length === 2) {
      await requireAuth(request);
      const scope = url.searchParams.get("scope") || "all";
      const industry = url.searchParams.get("industry") || null;
      const frameworkId = url.searchParams.get("framework_id") || null;
      const includeInactive = ["true", "1", "yes"].includes(String(url.searchParams.get("include_inactive") || "").toLowerCase());
      if (!["universal", "industry", "all"].includes(scope)) {
        sendJson(response, 400, { error: "Invalid scope." });
        return true;
      }
      const result = await query(
        `SELECT d.*,
          COUNT(q.id)::int as question_count
         FROM domain_taxonomy d
         LEFT JOIN questions q
           ON q.business_domain = d.key
         WHERE (d.is_active = true OR $1 = true)
           AND ($2 = 'all' OR d.scope = $2)
           AND ($3::text IS NULL OR d.industry = $3 OR d.scope = 'universal')
           AND ($4::uuid IS NULL OR d.framework_id = $4 OR d.framework_id IS NULL)
         GROUP BY d.id
         ORDER BY d.sort_order ASC, d.name ASC`,
        [includeInactive, scope, industry, frameworkId]
      );
      const domains = result.rows.map(mapDomainTaxonomy);
      const categories = [...new Set(domains.map((domain) => domain.category).filter(Boolean))];
      sendJson(response, 200, { domains, categories });
      return true;
    }

    if (request.method === "POST" && parts.length === 2) {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const payload = await readJson(request);
      const key = frameworkString(payload.key);
      const name = frameworkString(payload.name);
      const category = frameworkString(payload.category);
      const scope = frameworkString(payload.scope);
      const industry = frameworkString(payload.industry);
      if (!/^[a-z][a-z0-9_]*$/.test(key)) {
        sendJson(response, 400, { error: "key must be lowercase snake_case and start with a letter." });
        return true;
      }
      if (!name) {
        sendJson(response, 400, { error: "name is required." });
        return true;
      }
      if (!["universal", "industry"].includes(scope)) {
        sendJson(response, 400, { error: "scope must be universal or industry." });
        return true;
      }
      if (scope === "industry" && !industry) {
        sendJson(response, 400, { error: "industry is required for industry domains." });
        return true;
      }
      if (!category) {
        sendJson(response, 400, { error: "category is required." });
        return true;
      }
      const duplicate = await query(
        `SELECT id FROM domain_taxonomy
         WHERE key = $1
           AND scope = $2
           AND coalesce(industry, '') = coalesce($3, '')
           AND coalesce(framework_id::text, '') = coalesce($4, '')
         LIMIT 1`,
        [key, scope, scope === "industry" ? industry : null, payload.framework_id || null]
      );
      if (duplicate.rowCount) {
        sendJson(response, 409, { error: "domain_key_exists", message: "Domain key already exists for this scope." });
        return true;
      }
      const result = await query(
        `INSERT INTO domain_taxonomy
          (key, name, description, category, scope, industry, framework_id, sort_order, is_active, created_by)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, true, $9)
         RETURNING *`,
        [
          key,
          name,
          payload.description || null,
          category,
          scope,
          scope === "industry" ? industry : null,
          payload.framework_id || null,
          Number(payload.sort_order || 0),
          session.userId
        ]
      );
      sendJson(response, 201, { domain: mapDomainTaxonomy({ ...result.rows[0], question_count: 0 }) });
      return true;
    }

    if (!domainId) {
      sendJson(response, 404, { error: "Domain endpoint not found." });
      return true;
    }

    if (request.method === "GET" && child === "questions") {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const domain = await getDomainWithQuestionCount(domainId);
      if (!domain) {
        sendJson(response, 404, { error: "Domain not found." });
        return true;
      }
      const result = await query(
        `SELECT id, question_id, question_text, stakeholder_role, bank_id
         FROM questions
         WHERE business_domain = $1
         ORDER BY stakeholder_role ASC, question_id ASC`,
        [domain.key]
      );
      sendJson(response, 200, { questions: result.rows });
      return true;
    }

    if (request.method === "PATCH" && child === "reassign") {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const payload = await readJson(request);
      const newDomainKey = frameworkString(payload.new_domain_key);
      if (!newDomainKey) {
        sendJson(response, 400, { error: "new_domain_key is required." });
        return true;
      }
      const domain = await getDomainWithQuestionCount(domainId);
      if (!domain) {
        sendJson(response, 404, { error: "Domain not found." });
        return true;
      }
      const newDomain = await query("SELECT * FROM domain_taxonomy WHERE key = $1 AND is_active = true LIMIT 1", [newDomainKey]);
      if (!newDomain.rowCount) {
        sendJson(response, 404, { error: "New domain not found or inactive." });
        return true;
      }
      const client = await requireDatabase().connect();
      try {
        await client.query("begin");
        const questions = await client.query("SELECT id, business_domain FROM questions WHERE business_domain = $1", [domain.key]);
        for (const question of questions.rows) {
          await client.query(
            `INSERT INTO question_domain_history
              (question_id, old_domain, new_domain, changed_by)
             VALUES ($1, $2, $3, $4)`,
            [question.id, question.business_domain, newDomainKey, session.userId]
          );
        }
        const updated = await client.query("UPDATE questions SET business_domain = $2 WHERE business_domain = $1", [domain.key, newDomainKey]);
        await client.query("commit");
        sendJson(response, 200, {
          updated_count: updated.rowCount || 0,
          new_domain: mapDomainTaxonomy({ ...newDomain.rows[0], question_count: 0 })
        });
      } catch (error) {
        await client.query("rollback");
        throw error;
      } finally {
        client.release();
      }
      return true;
    }

    if (request.method === "PATCH" && parts.length === 3) {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const payload = await readJson(request);
      const allowed = ["name", "description", "category", "sort_order", "is_active"];
      const updates = [];
      const params = [domainId];
      for (const field of allowed) {
        if (payload[field] === undefined) continue;
        params.push(field === "sort_order" ? Number(payload[field]) : payload[field]);
        updates.push(`${field} = $${params.length}`);
      }
      if (!updates.length) {
        const domain = await getDomainWithQuestionCount(domainId);
        if (!domain) sendJson(response, 404, { error: "Domain not found." });
        else sendJson(response, 200, { domain });
        return true;
      }
      params.push(new Date().toISOString());
      const result = await query(
        `UPDATE domain_taxonomy
         SET ${updates.join(", ")}, updated_at = $${params.length}
         WHERE id = $1
         RETURNING *`,
        params
      );
      if (!result.rowCount) {
        sendJson(response, 404, { error: "Domain not found." });
        return true;
      }
      const domain = await getDomainWithQuestionCount(domainId);
      const warning = payload.is_active === false && Number(domain.question_count || 0) > 0
        ? `${domain.question_count} questions still use this domain.`
        : null;
      sendJson(response, 200, warning ? { domain, warning } : { domain });
      return true;
    }

    if (request.method === "DELETE" && parts.length === 3) {
      const session = await requirePlatformOwner(request, response);
      if (!session) return true;
      const domain = await getDomainWithQuestionCount(domainId);
      if (!domain) {
        sendJson(response, 404, { error: "Domain not found." });
        return true;
      }
      if (Number(domain.question_count || 0) > 0) {
        sendJson(response, 409, {
          error: "cannot_delete_in_use",
          message: `Used by ${domain.question_count} questions. Reassign or deactivate instead.`,
          question_count: Number(domain.question_count || 0)
        });
        return true;
      }
      await query("DELETE FROM domain_taxonomy WHERE id = $1", [domainId]);
      sendJson(response, 200, { deleted: true });
      return true;
    }

    sendJson(response, 404, { error: "Domain endpoint not found." });
    return true;
  } catch (error) {
    sendJson(response, error.statusCode || 500, { error: error.message });
    return true;
  }
}

async function attachCoverageToBanks(banks = []) {
  const rows = [];
  for (const bank of banks) {
    rows.push({
      ...bank,
      coverage: await calculateBankCoverageScore(bank.id)
    });
  }
  return rows;
}

async function trackQuestionAsked(client, { questionId, assessmentId } = {}) {
  if (!questionId) return;
  const framework = await client.query(
    `select b.framework_id
     from questions q
     left join framework_question_banks b on b.id = q.bank_id
     where q.id = $1
     limit 1`,
    [questionId]
  );
  const frameworkId = framework.rows[0]?.framework_id || null;
  await client.query(
    `insert into question_effectiveness (
       question_id, framework_id, assessment_id,
       times_asked, last_asked_at
     )
     values ($1, $2, $3, 1, now())
     on conflict (question_id)
     do update set
       framework_id = coalesce(question_effectiveness.framework_id, excluded.framework_id),
       assessment_id = excluded.assessment_id,
       times_asked = question_effectiveness.times_asked + 1,
       last_asked_at = now(),
       updated_at = now()`,
    [questionId, frameworkId, assessmentId || null]
  );
  await client.query(
    `update questions
     set times_used = coalesce(times_used, 0) + 1
     where id = $1`,
    [questionId]
  );
}

async function trackFindingTriggerQuestions(client, assessmentId) {
  const triggered = await client.query(
    `select distinct e.source_question_id as question_id
     from evidence e
     join findings f on f.id = e.finding_id
     where f.assessment_id = $1
       and e.source_question_id is not null`,
    [assessmentId]
  );
  for (const row of triggered.rows) {
    await client.query(
      `insert into question_effectiveness (
         question_id, assessment_id,
         times_generated_finding,
         last_finding_at
       )
       values ($1, $2, 1, now())
       on conflict (question_id)
       do update set
         assessment_id = excluded.assessment_id,
         times_generated_finding = question_effectiveness.times_generated_finding + 1,
         last_finding_at = now(),
         updated_at = now()`,
      [row.question_id, assessmentId]
    );
    await client.query(
      `update question_effectiveness
       set finding_trigger_rate = (
             times_generated_finding::numeric
             / nullif(times_asked, 0)
           ),
           effectiveness_score = (
             coalesce((times_generated_finding::numeric / nullif(times_asked, 0)), 0) * 70
             + (case when times_asked >= 5 then 30 else (times_asked / 5.0) * 30 end)
           ),
           updated_at = now()
       where question_id = $1`,
      [row.question_id]
    );
    await client.query(
      `update questions
       set times_triggered_finding = coalesce(times_triggered_finding, 0) + 1,
           effectiveness_score = (
             (coalesce(times_triggered_finding, 0) + 1)::numeric
             / nullif(coalesce(times_used, 0), 0)
           ) * 100
       where id = $1`,
      [row.question_id]
    );
  }
}

async function getBankEffectiveness(bankId) {
  const result = await query(
    `select
       q.id,
       q.question_text,
       q.business_domain,
       q.section,
       coalesce(qe.times_asked, 0)::int as times_asked,
       coalesce(qe.times_generated_finding, 0)::int as times_triggered_finding,
       coalesce(qe.finding_trigger_rate, 0)::numeric as trigger_rate,
       qe.effectiveness_score,
       qe.last_asked_at,
       qe.last_finding_at
     from questions q
     left join question_effectiveness qe
       on qe.question_id = q.id
     where q.bank_id = $1
     order by
       coalesce(qe.effectiveness_score, -1) desc`,
    [bankId]
  );
  const questions = result.rows.map((row) => ({
    ...row,
    times_asked: Number(row.times_asked || 0),
    times_triggered_finding: Number(row.times_triggered_finding || 0),
    trigger_rate: Number(row.trigger_rate || 0),
    effectiveness_score: row.effectiveness_score === null ? null : Number(row.effectiveness_score)
  }));
  const used = questions.filter((question) => question.times_asked > 0);
  const avgTriggerRate = used.length
    ? used.reduce((sum, question) => sum + Number(question.trigger_rate || 0), 0) / used.length
    : 0;
  return {
    questions,
    summary: {
      total_questions: questions.length,
      questions_used: used.length,
      questions_never_used: questions.filter((question) => question.times_asked === 0).length,
      avg_trigger_rate: avgTriggerRate,
      top_performing: questions
        .filter((question) => question.effectiveness_score !== null)
        .slice(0, 3),
      underperforming: questions.filter((question) => question.times_asked >= 3 && Number(question.trigger_rate || 0) === 0)
    }
  };
}

async function getFrameworkDetails(frameworkId) {
  const framework = await getFrameworkRow(frameworkId);
  if (!framework) return null;
  const banks = await query(
    `select b.*, count(q.id)::int as question_count
     from framework_question_banks b
     left join questions q on q.bank_id = b.id
     where b.framework_id = $1
     group by b.id
     order by b.sort_order asc, b.created_at asc`,
    [frameworkId]
  );
  const kpis = await query(
    `select * from framework_kpis
     where framework_id = $1
     order by domain_name asc, sort_order asc, created_at asc`,
    [frameworkId]
  );
  const domains = [];
  for (const kpi of kpis.rows) {
    let domain = domains.find((item) => item.domain_name === kpi.domain_name);
    if (!domain) {
      domain = { domain_name: kpi.domain_name, kpis: [] };
      domains.push(domain);
    }
    domain.kpis.push(kpi);
  }
  return {
    framework,
    banks: await attachCoverageToBanks(banks.rows),
    kpis: domains,
    readiness: await getFrameworkReadiness(frameworkId),
    coverage: await getFrameworkCoverage(frameworkId)
  };
}

async function handleFrameworkEngineApi(request, response, url) {
  if (!url.pathname.startsWith("/api/frameworks")) return false;
  await ensureFrameworkEngineSchema();

  const parts = url.pathname.split("/").filter(Boolean).map(decodeURIComponent);
  const frameworkId = parts[2] || null;
  const resource = parts[3] || null;
  const resourceId = parts[4] || null;
  const child = parts[5] || null;
  const childId = parts[6] || null;

  try {
    if (request.method === "GET" && parts.length === 4 && resource === "activities") {
      await requireAuth(request);
      const result = await query(
        `SELECT fa.*
         FROM framework_activities fa
         JOIN frameworks f
           ON f.industry = fa.industry
           OR fa.industry = 'tire_fleet_service'
         WHERE f.id = $1
           AND fa.is_active = true
         ORDER BY fa.sort_order ASC`,
        [frameworkId]
      );
      const grouped = result.rows.reduce((groups, activity) => {
        const groupName = activity.group_name || "Other";
        groups[groupName] = groups[groupName] || [];
        groups[groupName].push(activity);
        return groups;
      }, {});
      sendJson(response, 200, { activities: result.rows, grouped });
      return true;
    }

    if (request.method === "POST" && parts.length === 4 && resource === "audit-all") {
      const manager = await requireFrameworkManager(request, response);
      if (!manager) return true;
      if (request.socket) request.socket.setTimeout(180000);
      if (!process.env.ANTHROPIC_API_KEY) {
        sendJson(response, 503, { error: "AI audit not configured." });
        return true;
      }
      const framework = await getFrameworkRow(frameworkId);
      if (!framework) {
        sendJson(response, 404, { error: "Framework not found." });
        return true;
      }
      const client = requireDatabase();
      const banks = await client.query(
        `select *
         from framework_question_banks
         where framework_id = $1
         order by sort_order asc, created_at asc`,
        [frameworkId]
      );
      const industry = normalizeIndustry(framework.industry || "tire_fleet_service");
      const results = [];
      for (const bank of banks.rows) {
        const questions = await client.query(
          `select id, question_id, question_text, business_domain, response_type,
                  ai_analysis_purpose, finding_strength
           from questions
           where bank_id = $1
           order by question_id asc`,
          [bank.id]
        );
        console.log("[AUDIT]", frameworkId, bank.role_name, questions.rows.length, "questions");
        results.push(await auditBankQuestions(bank, questions.rows, industry, client));
      }
      const totals = results.reduce((acc, bank) => {
        acc.total_questions += Number(bank.total || 0);
        acc.total_keep += bank.keep.length;
        acc.total_remove += bank.remove.length;
        acc.total_replace += bank.replace.length;
        return acc;
      }, {
        total_questions: 0,
        total_keep: 0,
        total_remove: 0,
        total_replace: 0
      });
      sendJson(response, 200, {
        framework_id: frameworkId,
        results,
        banks: results,
        ...totals
      });
      return true;
    }

    if (request.method === "POST" && parts.length === 5 && resource === "audit-all" && resourceId === "apply") {
      const manager = await requireFrameworkManager(request, response);
      if (!manager) return true;
      const framework = await getFrameworkRow(frameworkId);
      if (!framework) {
        sendJson(response, 404, { error: "Framework not found." });
        return true;
      }
      const payload = await readJson(request);
      const banks = Array.isArray(payload.banks) ? payload.banks : [];
      const client = await requireDatabase().connect();
      const results = [];
      try {
        for (const bankPayload of banks) {
          const bankId = frameworkString(bankPayload.bank_id);
          if (!bankId) continue;
          await client.query("begin");
          const bank = await client.query(
            `select *
             from framework_question_banks
             where framework_id = $1 and id = $2
             limit 1`,
            [frameworkId, bankId]
          );
          if (!bank.rowCount) {
            await client.query("rollback");
            continue;
          }
          const removeIds = Array.isArray(bankPayload.remove) ? bankPayload.remove.map((id) => String(id)).filter(Boolean) : [];
          let removed = 0;
          if (removeIds.length) {
            const deleted = await client.query(
              `delete from questions
               where bank_id = $1
                 and (question_id = any($2::text[]) or id::text = any($2::text[]))`,
              [bankId, removeIds]
            );
            removed = deleted.rowCount || 0;
          }
          let replaced = 0;
          for (const replacement of Array.isArray(bankPayload.replace) ? bankPayload.replace : []) {
            const questionId = frameworkString(replacement.question_id);
            const newText = frameworkString(replacement.new_text || replacement.replacement_text);
            if (!questionId || !newText) continue;
            const updated = await client.query(
              `update questions
               set question_text = $1,
                   metadata = coalesce(metadata, '{}'::jsonb) || $4::jsonb
               where bank_id = $2
                 and (question_id = $3 or id::text = $3)`,
              [newText, bankId, questionId, JSON.stringify({ audit_replaced_at: new Date().toISOString() })]
            );
            replaced += updated.rowCount || 0;
          }
          const remaining = await client.query("select count(*)::int as count from questions where bank_id = $1", [bankId]);
          await client.query("commit");
          results.push({
            bank_id: bankId,
            role_name: bank.rows[0].role_name,
            removed,
            replaced,
            remaining: Number(remaining.rows[0]?.count || 0)
          });
        }
      } catch (error) {
        try {
          await client.query("rollback");
        } catch {}
        throw error;
      } finally {
        client.release();
      }
      sendJson(response, 200, {
        results,
        total_removed: results.reduce((sum, row) => sum + row.removed, 0),
        total_replaced: results.reduce((sum, row) => sum + row.replaced, 0)
      });
      return true;
    }

    if (request.method === "POST" && parts.length === 4 && resource === "complete-all-banks") {
      const manager = await requireFrameworkManager(request, response);
      if (!manager) return true;
      if (request.socket) request.socket.setTimeout(300000);
      if (!process.env.ANTHROPIC_API_KEY) {
        sendJson(response, 503, { error: "AI generation not configured." });
        return true;
      }
      const framework = await getFrameworkRow(frameworkId);
      if (!framework) {
        sendJson(response, 404, { error: "Framework not found." });
        return true;
      }
      const banks = await query(
        `select *
         from framework_question_banks
         where framework_id = $1
         order by sort_order asc, created_at asc`,
        [frameworkId]
      );
      const db = requireDatabase();
      const results = [];
      for (const bank of banks.rows) {
        const before = await calculateBankCoverageScore(bank.id, db);
        const coverage = buildCoverageContextForGeneration(before);
        if (!coverage.missingDomains.length && !coverage.shallowDomains.length) {
          results.push({
            bank_id: bank.id,
            role_name: bank.role_name,
            questions_generated: 0,
            domains_covered_before: before.breadth?.covered_domains || 0,
            domains_covered_after: before.breadth?.covered_domains || 0,
            domains: []
          });
          continue;
        }
        console.log("[COMPLETE BANK]", frameworkId, bank.role_name, "missing", coverage.missingDomains.join(","), "shallow", coverage.shallowDomains.join(","));
        const generated = await generateQuestionsForBank(framework, bank, {
          coverageData: before,
          targetDomains: [...coverage.missingDomains, ...coverage.shallowDomains],
          count: Math.min(15, Math.max(10, (coverage.missingDomains.length * 3) + (coverage.shallowDomains.length * 2)))
        }, db);
        const client = await db.connect();
        try {
          await client.query("begin");
          for (const question of generated) {
            await insertGeneratedQuestionForBank(client, frameworkId, bank, question);
