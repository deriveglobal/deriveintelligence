async function getOrCreateParticipantInvitationToken(client, participant, origin) {
  if (!participant.session_id) {
    const error = new Error("Create assessment session before sending invitation.");
    error.statusCode = 400;
    throw error;
  }
  const active = await client.query(
    `select *
     from assessment_access_tokens
     where participant_id = $1
       and session_id = $2
       and is_active = true
       and expires_at > now()
       and raw_token is not null
     order by created_at desc
     limit 1`,
    [participant.participant_id, participant.session_id]
  );
  if (active.rowCount) {
    return {
      token_id: active.rows[0].token_id,
      raw_token: active.rows[0].raw_token,
      expires_at: active.rows[0].expires_at,
      access_link: `${origin.replace(/\/$/, "")}/respond/${active.rows[0].raw_token}`,
      reused: true
    };
  }
  return await generateParticipantAccessLink(participant.participant_id, origin);
}

