function publicOriginFromRequest(request) {
  const forwardedProto = request.headers["x-forwarded-proto"];
  const proto = Array.isArray(forwardedProto) ? forwardedProto[0] : forwardedProto || "https";
  const host = request.headers.host || `localhost:${port}`;
  return `${proto}://${host}`;
}

async function syncAssessmentParticipantStatuses(client, assessmentId) {
  await client.query(`
    update assessment_participants p
    set status = case
          when p.is_active = false then 'deactivated'
          when s.status in ('completed', 'analyzed') then 'completed'
          when coalesce(rc.response_count, 0) > 0 then 'started'
          when tok.participant_id is not null then 'invited'
          when s.id is null then 'not_invited'
          else 'not_invited'
        end,
        started_at = case
          when p.is_active = false then p.started_at
          when coalesce(rc.response_count, 0) > 0 then coalesce(p.started_at, s.started_at)
          else p.started_at
        end,
        completed_at = case
          when s.status in ('completed', 'analyzed') then coalesce(p.completed_at, s.completed_at, now())
          when p.is_active = false then p.completed_at
          else null
        end,
        updated_at = now()
    from assessment_participants base
    left join assessment_sessions s on s.id = base.session_id
    left join (
      select assessment_session_id, count(*)::int as response_count
      from responses
      group by assessment_session_id
    ) rc on rc.assessment_session_id = s.id
    left join (
      select distinct participant_id
      from assessment_access_tokens
      where is_active = true and expires_at > now()
    ) tok on tok.participant_id = base.participant_id
    where p.participant_id = base.participant_id
      and p.assessment_id = $1
  `, [assessmentId]);
}

async function participantCoverageForBlueprint(client, assessmentId, blueprint = null) {
  await syncAssessmentParticipantStatuses(client, assessmentId);
  const rows = await client.query(
    `select p.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name, s.status as session_status,
            coalesce(rc.response_count, 0)::int as response_count,
            tok.active_token_expires_at,
            tok.active_token_id,
            case when p.invite_sent_at is not null then floor(extract(epoch from (now() - p.invite_sent_at)) / 86400)::int else null end as days_since_invite,
            case when p.started_at is not null then floor(extract(epoch from (now() - p.started_at)) / 86400)::int else null end as days_since_started,
            case
              when p.is_active = false or p.status in ('completed', 'deactivated') then false
              when p.started_at is not null and p.started_at < now() - interval '7 days' then true
              when p.invite_sent_at is not null and p.started_at is null and p.invite_sent_at < now() - interval '3 days' then true
              else false
            end as overdue,
            coalesce(bqc.question_count, qc.question_count, 0)::int as question_count,
            case
              when coalesce(bqc.question_count, qc.question_count, 0) > 0
                then round((coalesce(rc.response_count, 0)::numeric / coalesce(bqc.question_count, qc.question_count)) * 100)::int
              else 0
            end as completion_percent
     from assessment_participants p
     left join stakeholder_groups sg on sg.id = p.stakeholder_group_id
     left join stakeholder_roles sr on sr.id = p.stakeholder_role_id
     left join assessment_sessions s on s.id = p.session_id
     left join (
       select assessment_session_id, count(*)::int as response_count
       from responses
       group by assessment_session_id
     ) rc on rc.assessment_session_id = s.id
     left join (
       select stakeholder_role_id, count(*)::int as question_count
       from questions
       group by stakeholder_role_id
     ) qc on qc.stakeholder_role_id = p.stakeholder_role_id
     left join (
       select b.role_key as stakeholder_role_id, count(q.id)::int as question_count
       from framework_question_banks b
       join questions q on q.bank_id = b.id
       where b.status = 'active'
       group by b.role_key
     ) bqc on bqc.stakeholder_role_id = p.stakeholder_role_id
     left join (
       select distinct on (participant_id) participant_id, token_id as active_token_id, expires_at as active_token_expires_at
       from assessment_access_tokens
       where is_active = true
       order by participant_id, created_at desc
     ) tok on tok.participant_id = p.participant_id
     where p.assessment_id = $1
     order by p.created_at desc`,
    [assessmentId]
  );
  const participants = rows.rows.map(mapAssessmentParticipant);
  const activeParticipants = participants.filter((participant) => participant.is_active && participant.status !== "deactivated");
  const roleStats = new Map();
  for (const participant of activeParticipants) {
    const entry = roleStats.get(participant.stakeholder_role_id) || {
      assigned_count: 0,
      completed_count: 0,
      started_count: 0,
      participants: []
    };
    entry.assigned_count += 1;
    if (participant.status === "completed") entry.completed_count += 1;
    if (participant.status === "started") entry.started_count += 1;
    entry.participants.push(participant);
    roleStats.set(participant.stakeholder_role_id, entry);
  }
  const summarizeRoles = (roles = [], level = "optional") => roles.map((role) => {
    const stats = roleStats.get(role.id) || { assigned_count: 0, completed_count: 0, started_count: 0, participants: [] };
    let status = "Missing";
    if (stats.completed_count > 0) status = "Completed";
    else if (stats.started_count > 0) status = "In Progress";
    else if (stats.assigned_count > 0) status = "Assigned";
    const na = (blueprint?.not_applicable_roles || []).some((item) => String(item.role_id || item.id || item) === String(role.id));
    if (na) status = "Not Applicable";
    return {
      ...role,
      level,
      assigned_participants_count: stats.assigned_count,
      completed_participants_count: stats.completed_count,
      started_participants_count: stats.started_count,
      status,
      participants: stats.participants
    };
  });
  const requiredRoles = summarizeRoles(blueprint?.required_stakeholder_roles || [], "required");
  const recommendedRoles = summarizeRoles(blueprint?.recommended_stakeholder_roles || [], "recommended");
  const optionalRoles = summarizeRoles(blueprint?.optional_stakeholder_roles || [], "optional");
  const requiredAssigned = requiredRoles.filter((role) => role.assigned_participants_count > 0).length;
  const requiredCompleted = requiredRoles.filter((role) => role.completed_participants_count > 0).length;
  const recommendedAssigned = recommendedRoles.filter((role) => role.assigned_participants_count > 0).length;
  const completionPercent = activeParticipants.length
    ? Math.round((activeParticipants.filter((participant) => participant.status === "completed").length / activeParticipants.length) * 100)
    : 0;
  return {
    participants,
    coverage: {
      required_roles: requiredRoles,
      recommended_roles: recommendedRoles,
      optional_roles: optionalRoles,
      summary: {
        total_participants: activeParticipants.length,
        required_roles_assigned: requiredAssigned,
        required_roles_total: requiredRoles.length,
        required_roles_completed: requiredCompleted,
        recommended_roles_assigned: recommendedAssigned,
        recommended_roles_total: recommendedRoles.length,
        participant_completion_percent: completionPercent
      }
    }
  };
}

