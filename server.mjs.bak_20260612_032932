async function listFrameworkKpis({ industry = "tire_fleet_service", activities = [] } = {}) {
  const params = [industry || "tire_fleet_service"];
  let activityClause = "";
  if (activities.length) {
    params.push(activities);
    activityClause = `
      AND (
        applicable_activities = '[]'::jsonb
        OR applicable_activities @>
          ANY(ARRAY(
            SELECT jsonb_build_array(a)
            FROM unnest($2::text[]) a
          ))
      )`;
  }
  const result = await query(
    `SELECT k.*,
       COUNT(q.id)::int as question_count
     FROM framework_kpis k
     LEFT JOIN questions q
       ON q.kpi_outputs::text LIKE '%' || k.key || '%'
     WHERE k.industry = $1
       AND k.key IS NOT NULL
       AND k.is_active = true
       ${activityClause}
     GROUP BY k.id
     ORDER BY k.sort_order ASC, k.name ASC`,
    params
  );
  return result.rows.map(mapFrameworkKpi);
}

async function handleKpiCatalogApi(request, response, url) {
  if (!url.pathname.startsWith("/api/kpis")) return false;
