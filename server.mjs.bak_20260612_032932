    y = doc.y + 6;
    doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(rec.expected_outcome || rec.expected_operational_benefit || rec.description || rec.why_recommendation_exists, 280), 68, y, { width: 455, lineGap: 3 });
    y = doc.y + 18;
  });
  doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text("Generated by Derive Organizational Intelligence Platform. Confidential and intended for authorized stakeholders only.", 50, 690, { width: 490 });
  pdfFooter(doc, data, pageNumber);
}

async function generateExecutiveSummaryPDF(assessmentData) {
  const doc = createPdfDocument(`${assessmentData.organization.name} Executive Summary`);
  drawCoverPage(doc, assessmentData);
  doc.addPage();
  drawExecutiveBriefPage(doc, assessmentData, 2);
  doc.addPage();
  drawTopFindingsPage(doc, assessmentData, 3);
  doc.addPage();
  drawRecommendationsPage(doc, assessmentData, 4);
  doc.addPage();
  drawRoadmapPage(doc, assessmentData, 5);
  doc.addPage();
  drawNextStepsPage(doc, assessmentData, 6);
  return finishPdf(doc);
}

function drawAllFindingsPage(doc, data, findings, pageNumber, pageIndex) {
  let y = pdfSectionHeader(doc, pageIndex === 0 ? "All approved findings" : "All approved findings continued");
  findings.forEach((finding) => {
    doc.strokeColor(severityColor(finding)).lineWidth(2).moveTo(50, y).lineTo(50, y + 118).stroke();
    doc.font("Helvetica-Bold").fontSize(13).fillColor(PDF_REPORT_COLORS.primary).text(cleanPdfText(finding.title || "Finding"), 64, y, { width: 460 });
    y = doc.y + 5;
    doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(finding.description, 390), 64, y, { width: 460, lineGap: 3 });
    y = doc.y + 6;
    const domain = formatDomainLabel(finding.business_domain || "Operations");
    const category = formatDomainLabel(finding.assessment_category || "");
    doc.font("Helvetica").fontSize(9).fillColor(PDF_REPORT_COLORS.muted).text(`Domain: ${domain}${category ? ` | Category: ${category}` : ""} | Confidence: ${finding.confidence || "--"}/5 | Agreement: ${finding.stakeholder_agreement_score || finding.overall_stakeholder_agreement_score || "--"}/5`, 64, y, { width: 460 });
    y = doc.y + 3;
    doc.font("Helvetica").fontSize(9).fillColor(PDF_REPORT_COLORS.muted).text("Evidence: Stakeholder survey responses", 64, y, { width: 460 });
    y = doc.y + 18;
  });
  pdfFooter(doc, data, pageNumber);
}

function drawAllRecommendationsPage(doc, data, recommendations, pageNumber, pageIndex) {
  let y = pdfSectionHeader(doc, pageIndex === 0 ? "All approved recommendations" : "All approved recommendations continued");
  recommendations.forEach((rec) => {
    doc.font("Helvetica-Bold").fontSize(13).fillColor(PDF_REPORT_COLORS.primary).text(cleanPdfText(rec.title || "Recommendation"), 50, y, { width: 490 });
    y = doc.y + 5;
    doc.font("Helvetica").fontSize(11).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(rec.description || rec.why_recommendation_exists || rec.expected_outcome, 360), 50, y, { width: 490, lineGap: 3 });
    y = doc.y + 6;
    doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text(`Owner: ${rec.recommended_owner || "Executive sponsor"} | Timeline: ${rec.estimated_timeline || "To confirm"} | Phase: ${normalizeReportPhase(rec.roadmap_phase)}`, 50, y, { width: 490 });
    y = doc.y + 4;
    doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.muted).text(`Expected outcome: ${truncateReportText(rec.expected_outcome || rec.expected_operational_benefit || rec.expected_impact, 210)}`, 50, y, { width: 490 });
    y = doc.y + 18;
  });
  pdfFooter(doc, data, pageNumber);
}

function drawKpiGapsPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "KPI gaps analysis");
  const gaps = data.kpiGaps.length ? data.kpiGaps : [{ gap_description: "No approved KPI gaps were identified.", domain: "Operations" }];
  gaps.slice(0, 12).forEach((gap) => {
    doc.font("Helvetica-Bold").fontSize(11).fillColor(PDF_REPORT_COLORS.primary).text(cleanPdfText(gap.kpi_name || formatDomainLabel(gap.domain) || "KPI gap"), 50, y, { width: 490 });
    y = doc.y + 4;
    doc.font("Helvetica").fontSize(10).fillColor(PDF_REPORT_COLORS.secondary).text(truncateReportText(gap.gap_description || gap.why_it_matters || gap.related_recommendation, 220), 50, y, { width: 490, lineGap: 2 });
    y = doc.y + 12;
  });
  pdfFooter(doc, data, pageNumber);
}

function drawMethodologyPage(doc, data, pageNumber) {
  let y = pdfSectionHeader(doc, "Methodology note");
  const sessionCount = data.sessions.length;
  const roleCount = uniqueStrings(data.sessions.map((session) => session.stakeholder_role_name || session.stakeholder_role).filter(Boolean)).length;
  const methodology = `This report was generated using Derive's structured organizational assessment methodology. ${sessionCount} stakeholder ${pluralize(sessionCount, "response")} ${sessionCount === 1 ? "was" : "were"} analyzed across ${roleCount} ${pluralize(roleCount, "role")}. All findings were reviewed and approved by a qualified consultant before delivery.`;
  y = pdfWrappedText(doc, methodology, 50, y, { size: 12, width: 490, lineGap: 5 }) + 24;
  pdfWrappedText(doc, "The analysis combines stakeholder response patterns, evidence records, KPI visibility, contradiction detection, and consultant review. Recommendations are included only after approval and are organized into an implementation sequence.", 50, y, { size: 11, width: 490, lineGap: 4 });
  pdfFooter(doc, data, pageNumber);
}

async function generateFullReportPDF(assessmentData) {
  const doc = createPdfDocument(`${assessmentData.organization.name} Intelligence Report`);
  let pageNumber = 1;
  drawCoverPage(doc, assessmentData);
  doc.addPage();
  pageNumber += 1;
  drawExecutiveBriefPage(doc, assessmentData, pageNumber);
  doc.addPage();
  pageNumber += 1;
  drawTopFindingsPage(doc, assessmentData, pageNumber);
  doc.addPage();
  pageNumber += 1;
  drawRecommendationsPage(doc, assessmentData, pageNumber);
  doc.addPage();
  pageNumber += 1;
  drawRoadmapPage(doc, assessmentData, pageNumber);
  doc.addPage();
  pageNumber += 1;
  drawNextStepsPage(doc, assessmentData, pageNumber);
  for (let index = 0; index < assessmentData.findings.length; index += 2) {
    doc.addPage();
    pageNumber += 1;
    drawAllFindingsPage(doc, assessmentData, assessmentData.findings.slice(index, index + 2), pageNumber, index);
  }
  for (let index = 0; index < assessmentData.recommendations.length; index += 2) {
    doc.addPage();
    pageNumber += 1;
    drawAllRecommendationsPage(doc, assessmentData, assessmentData.recommendations.slice(index, index + 2), pageNumber, index);
  }
  doc.addPage();
  pageNumber += 1;
  drawKpiGapsPage(doc, assessmentData, pageNumber);
  doc.addPage();
  pageNumber += 1;
  drawMethodologyPage(doc, assessmentData, pageNumber);
  return finishPdf(doc);
}

