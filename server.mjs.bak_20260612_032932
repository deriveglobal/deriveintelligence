        organizationName,
        payload.industryContext || (domain ? `Initial discovery can start from ${domain}.` : "Initial reusable assessment project."),
        payload.defaultLanguage || "en",
        projectClassification
      ]
    );
    await client.query("commit");
    return mapProject({
      ...project.rows[0],
      organization_name: organizationName,
      organization_classification: projectClassification,
      classification: projectClassification,
      response_count: 0,
      assignment_count: 0
    });
