  const title = String(finding.title || "").toLowerCase();

  if (
    (title.includes("dispatch") || problemTypes.some((type) => ["dispatch_bottleneck", "scheduling_delay", "whatsapp_dependency", "communication_breakdown"].includes(type))) &&
    (profileSignals.has("mobile_workforce") || profileSignals.has("roadside_tire_assistance") || profileSignals.has("mobile_tire_services"))
  ) {
    recommendation.title = "Implement Centralized Dispatch Workflow and KPI Tracking";
    recommendation.category = "Automation";
    recommendation.type = "Digital Initiative";
    recommendation.description = "Implement a centralized dispatch workflow with standardized request intake, technician status visibility, branch handoff rules, and dispatch KPI tracking.";
    recommendation.benefit = "Faster assignment, fewer missed handoffs, better service visibility, and stronger SLA performance.";
    recommendation.effort = Math.max(recommendation.effort, 3);
    recommendation.value = 5;
    recommendation.risk = Math.max(recommendation.risk, 2);
    recommendation.estimated_timeline = "3-6 Months";
  } else if (title.includes("inventory") || problemTypes.some((type) => /inventory|stockout|warehouse/.test(type))) {
    recommendation.title = "Build Inventory Visibility and Control Foundation";
    recommendation.category = "Inventory Optimization";
    recommendation.type = "Digital Initiative";
    recommendation.description = "Create multi-location inventory visibility, stockout tracking, inventory accuracy controls, and inventory KPI ownership across warehouse, branch, dispatch, and field teams.";
    recommendation.benefit = "Improve stock availability, reduce emergency transfers, increase inventory trust, and protect service revenue.";
    recommendation.effort = Math.max(recommendation.effort, 3);
    recommendation.value = 5;
    recommendation.estimated_timeline = "3-9 Months";
  } else if (title.includes("billing") || title.includes("invoice") || problemTypes.includes("billing_delay")) {
    recommendation.title = "Standardize Service-to-Invoice Workflow";
    recommendation.category = "Process Improvement";
    recommendation.type = "Improvement Project";
    recommendation.description = "Standardize the service completion to invoice creation workflow with required completion fields, billing handoff ownership, invoice exception tracking, and billing cycle KPI measurement.";
    recommendation.benefit = "Reduce billing delays, improve cash flow visibility, reduce invoice corrections, and protect revenue capture.";
    recommendation.effort = 3;
    recommendation.value = 5;
    recommendation.estimated_timeline = "3-6 Months";
  } else if (title.includes("profitability") || title.includes("margin") || problemTypes.some((type) => /profitability|margin|cost_visibility/.test(type))) {
    recommendation.title = "Create Service and Customer Profitability Analytics";
    recommendation.category = "Reporting & Analytics";
    recommendation.type = "Digital Initiative";
    recommendation.description = "Build a profitability analysis layer that connects service revenue, labor, travel, inventory, partner costs, branch overhead, and customer contract data.";
    recommendation.benefit = "Expose unprofitable services or contracts, improve pricing decisions, and focus improvement work on the highest-value opportunities.";
    recommendation.effort = 4;
    recommendation.value = 5;
    recommendation.estimated_timeline = "6-12 Months";
  } else if (problemTypes.includes("reporting_gap") || title.includes("not measured")) {
    recommendation.title = "Define KPI Ownership and Data Capture Model";
    recommendation.category = "Reporting & Analytics";
    recommendation.type = "Improvement Project";
    recommendation.description = "Define KPI ownership, source data, capture rules, and reporting cadence for the missing measurements connected to this finding.";
    recommendation.benefit = "Turn blind spots into measurable operating controls and improve executive decision quality.";
    recommendation.effort = 2;
    recommendation.value = 5;
    recommendation.risk = 1;
    recommendation.estimated_timeline = "0-3 Months";
  }

  const whyParts = [];
  if (contextLabels.length) whyParts.push(`Organization Profile indicates ${contextLabels.join(", ")}.`);
  if (supportingGroups.length || supportingRoles.length) {
    whyParts.push(`Supported by ${supportingGroups.length ? supportingGroups.join(", ") : supportingRoles.join(", ")} input.`);
  }
  if (relatedKpiGaps.length) whyParts.push(`Related KPI gaps: ${relatedKpiGaps.map((kpi) => kpi.name).join(", ")}.`);
  if (finding.contradiction_detected) whyParts.push("A stakeholder misalignment was detected, so the recommendation should also clarify ownership and data truth.");
  whyParts.push(`Finding priority is ${Math.round(Number(finding.priority_score || 0))}/100 with confidence ${finding.confidence || 3}/5.`);

  recommendation.why = whyParts.join(" ");
  recommendation.supportingEvidence = [
    {
      finding_id: finding.id,
      finding_title: finding.title,
      evidence_count: Number(finding.evidence_count || 0),
      source_question_ids: finding.source_question_ids || [],
      trigger_rule: finding.trigger_rule || "rule_based_analysis"
    }
  ];
  recommendation.supportingStakeholderGroups = supportingGroups;
  recommendation.relatedKpiGaps = relatedKpiGaps;
  recommendation.expectedOperationalBenefit = recommendation.benefit;
  recommendation.expectedFinancialBenefit = problemTypes.some((type) => /revenue|billing|cost|profit|margin|inventory/.test(type)) || relatedKpiGaps.some((kpi) => /cost|revenue|profit|billing|inventory/.test(kpi.id))
    ? "Improve financial visibility, reduce leakage or avoidable cost, and support better investment prioritization."
    : "Financial impact should be estimated after baseline KPI capture.";
  recommendation.recommended_owner = recommendationOwnerForFinding(finding);
  recommendation.dependencies = roadmapDependenciesForRecommendation(recommendation, finding, relatedKpiGaps);
  recommendation.confidenceScore = recommendationConfidenceScore(finding, relatedKpiGaps);
  recommendation.specificityScore = recommendationSpecificityScore(recommendation, relatedKpiGaps, companyProfile || {});
  recommendation.expectedImpact = expectedImpactLabel(finding);
  Object.assign(recommendation, estimateBusinessValueV1(recommendation, finding, { companyProfile, relatedKpiGaps }));
  return recommendation;
}

function isComplexCompanyProfile(profileSignals = new Set()) {
  return ["multi_location_operations", "mobile_workforce", "fleet_customer_focus", "inventory_intensive", "service_network_management", "distribution_network"]
    .some((signal) => profileSignals.has(signal));
}

function applyCompanyProfileContextToFinding(finding, profileSignals = new Set()) {
  const problemTypes = finding.problem_types || [];
  const complexCompany = isComplexCompanyProfile(profileSignals);
  if (complexCompany && problemTypes.includes("whatsapp_dependency")) {
    finding.description = `${finding.description} Organization Profile indicates a complex operating model, so informal communication creates higher traceability and coordination risk.`;
    finding.severity = Math.max(Number(finding.severity || 1), 5);
    finding.frequency = Math.max(Number(finding.frequency || 1), 4);
    finding.customer_impact = Math.max(Number(finding.customer_impact || 1), 4);
    finding.risk_impact = Math.max(Number(finding.risk_impact || 1), 4);
  }
  if (profileSignals.has("inventory_intensive") && problemTypes.some((type) => ["missing_data", "reporting_gap", "spreadsheet_dependency"].includes(type))) {
    finding.cost_impact = Math.max(Number(finding.cost_impact || 1), 4);
    finding.risk_impact = Math.max(Number(finding.risk_impact || 1), 3);
  }
  if (profileSignals.has("fleet_tire_management") && problemTypes.some((type) => ["poor_service_visibility", "reporting_gap", "missing_data"].includes(type))) {
    finding.customer_impact = Math.max(Number(finding.customer_impact || 1), 4);
    finding.revenue_impact = Math.max(Number(finding.revenue_impact || 1), 4);
  }
  finding.priority_score = calculatePriorityScore(finding);
  return finding;
}

function buildRuleFindingsFallback(rows, profileSignals = new Set()) {
  const findings = [];
  const pushFinding = (row, config) => {
    const finding = {
      title: config.title,
      description: config.description,
      business_domain: config.businessDomain || row.business_domain,
      assessment_category: config.assessmentCategory || row.assessment_category,
      problem_types: config.problemTypes,
      source_question_ids: [row.question_uuid],
      source_response_ids: [row.response_id],
      source_stakeholder_role: row.stakeholder_role || row.stakeholder_group || "Unknown",
      source_stakeholder_role_id: row.stakeholder_role_id || resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id,
      source_stakeholder_group_id: row.stakeholder_group_id || stakeholderGroupForRole(resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id),
      stakeholder_role_id: row.stakeholder_role_id || resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id,
      stakeholder_group_id: row.stakeholder_group_id || stakeholderGroupForRole(resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id),
      severity: config.severity || 4,
      frequency: config.frequency || 4,
      confidence: row.finding_strength === "high" ? 4 : row.finding_strength === "medium" ? 3 : 2,
      evidence_count: 1,
      time_impact: config.timeImpact || 3,
      cost_impact: config.costImpact || 2,
      customer_impact: config.customerImpact || 2,
      revenue_impact: config.revenueImpact || 2,
      risk_impact: config.riskImpact || 2,
      employee_impact: config.employeeImpact || 3,
      automation_potential: config.automationPotential || 3,
      roadmap_relevance: row.roadmap_relevance,
      trigger_rule: config.triggerRule || `${row.question_id}:${config.title.toLowerCase().replace(/[^a-z0-9]+/g, "_")}`,
      evidence_description: `${row.question_id}: ${row.question_text} Answer: ${row.answer_text || ""}`,
      evidence_items: [
        {
          evidence_type: "Survey Response",
          source_question_id: row.question_uuid,
          source_response_id: row.response_id,
          source_stakeholder_role: row.stakeholder_role || row.stakeholder_group || "Unknown",
          stakeholder_role_id: row.stakeholder_role_id || resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id,
          stakeholder_group_id: row.stakeholder_group_id || stakeholderGroupForRole(resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group).id),
          description: `${row.question_id}: ${row.question_text} Answer: ${row.answer_text || ""}`,
          trigger_rule: config.triggerRule || `${row.question_id}:${config.title.toLowerCase().replace(/[^a-z0-9]+/g, "_")}`
        }
      ]
    };
    findings.push(applyCompanyProfileContextToFinding(finding, profileSignals));
  };

  for (const row of rows) {
    const answers = normalizeAnswerList(row.answer_text);
    if (row.question_id === "OPS-015") {
      const rules = [
        ["WhatsApp", "WhatsApp Dependency", ["whatsapp_dependency", "communication_breakdown", "data_silo"]],
        ["Excel/Spreadsheets", "Spreadsheet Dependency", ["spreadsheet_dependency", "duplicate_activity", "reporting_gap"]],
        ["Paper forms", "Paper-Based Process", ["paper_based_process", "manual_process", "missing_data"]]
      ];
      for (const [option, title, problemTypes] of rules) {
        if (answers.includes(option)) {
          pushFinding(row, {
            title,
            description: `${option} is used to manage operational work, creating traceability and data quality risk.`,
            problemTypes,
            triggerRule: `OPS-015:selected:${option}`,
            severity: 4,
            frequency: 4,
            timeImpact: 4,
            riskImpact: 3,
            employeeImpact: 4,
            automationPotential: 5
          });
        }
      }
    }

    if (row.question_id === "OPS-014" && ["4-5 systems", "6+ systems"].includes(row.answer_text)) {
      pushFinding(row, {
        title: "High System Complexity",
        description: "A typical service request requires too many systems or tools from intake to completion.",
        problemTypes: ["missing_integration", "process_complexity", "duplicate_activity"],
        triggerRule: `OPS-014:systems:${row.answer_text}`,
        severity: row.answer_text === "6+ systems" ? 5 : 4,
        frequency: 4,
        timeImpact: 4,
        costImpact: 3,
        customerImpact: 3,
        employeeImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "OPS-017" && Number(row.score_value ?? numericFromAnswer(row.answer_text)) > 50) {
      pushFinding(row, {
        title: "High Manual Workload",
        description: "More than half of operational work is manual and repeatable.",
        problemTypes: ["manual_process", "lack_of_automation"],
        triggerRule: "OPS-017:manual_work_percentage_above_50",
        severity: 5,
        frequency: 5,
        timeImpact: 5,
        costImpact: 4,
        employeeImpact: 5,
        automationPotential: 5
      });
    }

    if (row.question_id === "OPS-019" && Number(row.score_value ?? numericFromAnswer(row.answer_text)) > 5) {
      pushFinding(row, {
        title: "Information Accessibility Gap",
        description: "Employees lose more than five hours per week searching for missing operational information.",
        problemTypes: ["missing_data", "data_access_issue", "communication_breakdown"],
        triggerRule: "OPS-019:hours_lost_searching_above_5",
        severity: 4,
        frequency: 4,
        timeImpact: 5,
        costImpact: 3,
        employeeImpact: 4,
        automationPotential: 4
      });
    }

    if (row.question_id === "OPS-013" && answers.length) {
      pushFinding(row, {
        title: "Missing Operational KPI",
        description: `Important operational KPIs are unavailable: ${answers.join(", ")}.`,
        problemTypes: ["reporting_gap", "data_management_gap"],
        triggerRule: "OPS-013:unavailable_kpis_selected",
        severity: 4,
        frequency: 4,
        timeImpact: 3,
        costImpact: 3,
        customerImpact: answers.some((item) => /response|customer|sla/i.test(item)) ? 4 : 2,
        riskImpact: 3,
        automationPotential: 4
      });
    }

    if (["DSP-003", "DSP-012"].includes(row.question_id)) {
      const rules = [
        ["WhatsApp", "WhatsApp Dependency", ["whatsapp_dependency", "communication_breakdown", "data_silo"]],
        ["Phone", "Phone Dependency", ["phone_dependency", "manual_process", "missing_data"]],
        ["Email", "Email Dependency", ["email_dependency", "communication_breakdown", "data_silo"]],
        ["Spreadsheet", "Spreadsheet Dependency", ["spreadsheet_dependency", "duplicate_activity", "reporting_gap"]],
        ["Paper note", "Paper-Based Process", ["paper_based_process", "manual_process", "missing_data"]]
      ];
      for (const [option, title, problemTypes] of rules) {
        if (answers.includes(option) || answers.some((answer) => String(answer).includes(option))) {
          pushFinding(row, {
            title,
            description: `${option} is used during dispatch or customer service coordination, creating traceability and visibility risk.`,
            problemTypes,
            triggerRule: `${row.question_id}:selected:${option}`,
            severity: 4,
            frequency: 4,
            timeImpact: 4,
            customerImpact: 3,
            riskImpact: 3,
            employeeImpact: 4,
            automationPotential: 5
          });
        }
      }
    }

    if (row.question_id === "DSP-006" && Number(row.score_value ?? 0) >= 4) {
      pushFinding(row, {
        title: "Missing Information at Request Intake",
        description: "Important request information is frequently missing when service requests first arrive.",
        problemTypes: ["missing_data", "communication_breakdown", "manual_process"],
