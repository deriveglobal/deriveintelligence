async function getAIAnalysisContext(industry, client) {
  const normalizedIndustry = normalizeIndustry(industry);
  await client.query(
    `insert into ai_analysis_context
      (industry, approved_examples, rejected_patterns, domain_weights, total_assessments)
     values ($1, '[]'::jsonb, '[]'::jsonb, '{}'::jsonb, 0)
     on conflict (industry) do nothing`,
    [normalizedIndustry]
  );
  const result = await client.query(
    `select *
     from ai_analysis_context
     where industry = $1
     limit 1`,
    [normalizedIndustry]
  );
  if (!result.rowCount) {
    return {
      industry: normalizedIndustry,
      approved_examples: [],
      rejected_patterns: [],
      domain_weights: {},
      total_assessments: 0
    };
  }
  const row = result.rows[0];
  return {
    industry: row.industry,
    approved_examples: row.approved_examples || [],
    rejected_patterns: row.rejected_patterns || [],
    domain_weights: row.domain_weights || {},
    total_assessments: row.total_assessments || 0
  };
}

async function updateAIAnalysisContext(industry, findingFeedback, client) {
  const normalizedIndustry = normalizeIndustry(industry);
  await client.query(
    `insert into ai_analysis_context
      (industry, approved_examples, rejected_patterns, domain_weights, total_assessments)
     values ($1, '[]'::jsonb, '[]'::jsonb, '{}'::jsonb, 0)
     on conflict (industry) do nothing`,
    [normalizedIndustry]
  );
  const ctx = await getAIAnalysisContext(normalizedIndustry, client);
  const {
    action,
    finding,
    editedTitle,
    editedDescription,
    rejectionReason
  } = findingFeedback;

  const example = {
    title: finding.title,
    description: finding.description,
    business_domain: finding.business_domain,
    severity: finding.severity,
    problem_types: finding.problem_types || [],
    timestamp: new Date().toISOString()
  };

  if (action === "approved") {
    const approved = [...ctx.approved_examples, example].slice(-50);
    await client.query(
      `update ai_analysis_context
       set approved_examples = $1,
           total_assessments = total_assessments + 0,
           last_updated = now()
       where industry = $2`,
      [JSON.stringify(approved), normalizedIndustry]
    );
  }

  if (action === "rejected") {
    const rejected = [...ctx.rejected_patterns, { ...example, reason: rejectionReason }].slice(-30);
    await client.query(
      `update ai_analysis_context
       set rejected_patterns = $1,
           last_updated = now()
       where industry = $2`,
      [JSON.stringify(rejected), normalizedIndustry]
    );
  }

  if (action === "edited") {
    const approved = [
      ...ctx.approved_examples,
      {
        ...example,
        title: editedTitle,
        description: editedDescription,
        edited_from: finding.title
      }
    ].slice(-50);
    await client.query(
      `update ai_analysis_context
       set approved_examples = $1,
           last_updated = now()
       where industry = $2`,
      [JSON.stringify(approved), normalizedIndustry]
    );
  }

  await client.query(
    `insert into ai_finding_examples
       (industry, example_type, finding_title, finding_description,
        business_domain, severity, problem_types, rejection_reason, edited_from)
     values ($1, $2, $3, $4, $5, $6, $7, $8, $9)`,
    [
      normalizedIndustry,
      action,
      action === "edited" ? editedTitle : finding.title,
      action === "edited" ? editedDescription : finding.description,
      finding.business_domain,
      finding.severity,
      JSON.stringify(finding.problem_types || []),
      rejectionReason || null,
      action === "edited" ? finding.title : null
    ]
  );
}

async function calculateOwnerBaseline(companyProfile, industry, client) {
  if (!companyProfile) return {};
  const normalizedIndustry = normalizeIndustry(industry);
  let mappings = await client.query(
    `select intake_field, domain_key, weight, mapping_type
     from intake_domain_mapping
     where industry = $1
       and mapping_type = 'maturity'`,
    [normalizedIndustry]
  );
  if (!mappings.rowCount && normalizedIndustry !== "tire_fleet_service") {
    mappings = await client.query(
      `select intake_field, domain_key, weight, mapping_type
       from intake_domain_mapping
       where industry = 'tire_fleet_service'
         and mapping_type = 'maturity'`
    );
  }
  const contextData = companyProfile.raw_context_data || companyProfile.rawContextData || {};
  const domainScores = {};
  const domainWeights = {};
  for (const mapping of mappings.rows) {
    const rawValue = contextData[mapping.intake_field];
    if (rawValue === undefined || rawValue === null) continue;
    const score = parseFloat(rawValue);
    if (Number.isNaN(score)) continue;
    const normalizedScore = score / 5;
    const key = mapping.domain_key;
    if (!domainScores[key]) {
      domainScores[key] = 0;
      domainWeights[key] = 0;
    }
    domainScores[key] += normalizedScore * Number(mapping.weight || 1);
    domainWeights[key] += Number(mapping.weight || 1);
  }
  const baseline = {};
  for (const domain of Object.keys(domainScores)) {
    if (domainWeights[domain] > 0) {
      baseline[domain] = Math.round((domainScores[domain] / domainWeights[domain]) * 5 * 10) / 10;
    }
  }
  return baseline;
}

async function calculateParticipantScores(assessmentId, client) {
  const result = await client.query(
    `select q.business_domain,
            avg(r.score_value) as avg_score,
            count(r.id) as response_count
     from responses r
     join assessment_sessions s
       on s.id = r.assessment_session_id
     join questions q
       on q.id = r.question_id
     where s.assessment_id = $1
       and r.score_value is not null
       and r.score_value between 1 and 5
       and q.business_domain is not null
     group by q.business_domain
     having count(r.id) >= 2`,
    [assessmentId]
  );
  const scores = {};
  for (const row of result.rows) {
    scores[row.business_domain] = {
      avg_score: Math.round(parseFloat(row.avg_score) * 10) / 10,
      sample_size: parseInt(row.response_count, 10)
    };
  }
  return scores;
}

function calculateGapSeverity(gap) {
  const absGap = Math.abs(gap);
  if (absGap < 0.3) return "none";
  if (absGap < 0.8) return "mild";
  if (absGap < 1.5) return "moderate";
  if (absGap < 2.5) return "significant";
  return "critical";
}

async function calculatePerceptionGaps(assessmentId, companyId, companyProfile, industry, client) {
  const ownerBaseline = await calculateOwnerBaseline(companyProfile, industry, client);
  const participantScores = await calculateParticipantScores(assessmentId, client);
  const allDomains = new Set([
    ...Object.keys(ownerBaseline),
    ...Object.keys(participantScores)
  ]);
  const gaps = [];
  for (const domain of allDomains) {
    const ownerScore = ownerBaseline[domain] ?? null;
    const participantData = participantScores[domain];
    const participantScore = participantData?.avg_score ?? null;
    let gap = null;
    let severity = "none";
    if (ownerScore !== null && participantScore !== null) {
      gap = Math.round((ownerScore - participantScore) * 10) / 10;
      severity = calculateGapSeverity(gap);
    }
    gaps.push({
      assessment_id: assessmentId,
      company_id: companyId,
      domain_key: domain,
      owner_baseline_score: ownerScore,
      owner_structured_score: null,
      participant_avg_score: participantScore,
      perception_gap: gap,
      gap_severity: severity,
      sample_size: participantData?.sample_size || 0
    });
  }
  await client.query("delete from domain_perception_gaps where assessment_id = $1", [assessmentId]);
  for (const gap of gaps) {
    await client.query(
      `insert into domain_perception_gaps
        (assessment_id, company_id, domain_key, owner_baseline_score, owner_structured_score,
         participant_avg_score, perception_gap, gap_severity, sample_size)
       values ($1, $2, $3, $4, $5, $6, $7, $8, $9)
       on conflict (assessment_id, domain_key)
       do update set
         owner_baseline_score = $4,
         owner_structured_score = $5,
         participant_avg_score = $6,
         perception_gap = $7,
         gap_severity = $8,
         sample_size = $9,
         calculated_at = now()`,
      [
        gap.assessment_id,
        gap.company_id,
        gap.domain_key,
        gap.owner_baseline_score,
        gap.owner_structured_score,
        gap.participant_avg_score,
        gap.perception_gap,
        gap.gap_severity,
        gap.sample_size
      ]
    );
  }
  return gaps;
}

async function updateIndustryBenchmarks(industry, gaps, client) {
  const normalizedIndustry = normalizeIndustry(industry);
  for (const gap of gaps) {
    if (gap.perception_gap === null) continue;
    await client.query(
      `insert into industry_benchmarks
        (industry, domain_key, avg_owner_baseline, avg_participant_score, avg_perception_gap,
         pct_overestimating, pct_underestimating, pct_accurate, sample_size, last_updated)
       values ($1, $2, $3, $4, $5,
         case when $5 > 0.3 then 100 else 0 end,
         case when $5 < -0.3 then 100 else 0 end,
         case when abs($5) <= 0.3 then 100 else 0 end,
         1, now())
       on conflict (industry, domain_key)
       do update set
         avg_owner_baseline = (industry_benchmarks.avg_owner_baseline * industry_benchmarks.sample_size + $3) / (industry_benchmarks.sample_size + 1),
         avg_participant_score = (industry_benchmarks.avg_participant_score * industry_benchmarks.sample_size + $4) / (industry_benchmarks.sample_size + 1),
         avg_perception_gap = (industry_benchmarks.avg_perception_gap * industry_benchmarks.sample_size + $5) / (industry_benchmarks.sample_size + 1),
         pct_overestimating = ((industry_benchmarks.pct_overestimating * industry_benchmarks.sample_size) + case when $5 > 0.3 then 100 else 0 end) / (industry_benchmarks.sample_size + 1),
         pct_underestimating = ((industry_benchmarks.pct_underestimating * industry_benchmarks.sample_size) + case when $5 < -0.3 then 100 else 0 end) / (industry_benchmarks.sample_size + 1),
         pct_accurate = ((industry_benchmarks.pct_accurate * industry_benchmarks.sample_size) + case when abs($5) <= 0.3 then 100 else 0 end) / (industry_benchmarks.sample_size + 1),
         sample_size = industry_benchmarks.sample_size + 1,
         last_updated = now()`,
      [
        normalizedIndustry,
        gap.domain_key,
        gap.owner_baseline_score,
        gap.participant_avg_score,
        gap.perception_gap
      ]
    );
  }
}

