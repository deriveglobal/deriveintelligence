function assessmentManagerNextAction({ participants = [], coverage = {}, activeAssessment = null } = {}) {
  if (!activeAssessment) {
    return { type: "setup", label: "Assessment has not been created yet.", action: "Create Assessment", target: "manager-overview" };
  }
  const requiredRoles = coverage.required_roles || [];
  const missingRequired = requiredRoles.find((role) => role.status === "Missing");
  if (missingRequired) {
    return {
      type: "missing_role",
      label: `Add missing ${missingRequired.name || missingRequired.id} participant.`,
      action: "Add Participant",
      target: "manager-participants",
      role_id: missingRequired.id
    };
  }
  const withoutSessions = participants.filter((participant) => participant.is_active && participant.status !== "deactivated" && !participant.session_id);
  if (withoutSessions.length) {
    return {
      type: "create_sessions",
      label: `Create sessions for ${withoutSessions.length} participant${withoutSessions.length === 1 ? "" : "s"}.`,
      action: "Create Sessions",
      target: "manager-participants"
    };
  }
  const notInvited = participants.filter((participant) => participant.is_active && participant.status === "not_invited");
  if (notInvited.length) {
    return {
      type: "send_invitations",
      label: `Send invitations to ${notInvited.length} participant${notInvited.length === 1 ? "" : "s"}.`,
      action: "Send Invitations",
      target: "manager-communications"
    };
  }
  const overdue = participants.filter((participant) => participant.overdue);
  if (overdue.length) {
    return {
      type: "send_reminders",
      label: `Send reminders to ${overdue.length} overdue participant${overdue.length === 1 ? "" : "s"}.`,
      action: "Send Reminders",
      target: "manager-communications"
    };
  }
  const incomplete = participants.filter((participant) => participant.is_active && !["completed", "deactivated"].includes(participant.status));
  if (incomplete.length) {
    return {
      type: "follow_up",
      label: `Follow up with ${incomplete.length} incomplete participant${incomplete.length === 1 ? "" : "s"}.`,
      action: "View Progress",
      target: "manager-progress"
    };
  }
  return {
    type: "handoff",
    label: "Collection is complete. Consultant review can begin.",
    action: "Handoff Ready",
    target: "manager-overview"
  };
}

async function getAssessmentManagerCommandCenter(session) {
  await ensureAccessControlSchema();
  const projects = await listProjects(session);
  const project = session.projectId
    ? projects.find((item) => String(item.id) === String(session.projectId)) || projects[0]
    : projects[0];
  if (!project) {
    return {
      generated_at: new Date().toISOString(),
      assigned_organization: null,
      active_assessment: null,
      collection_status: { percent_complete: 0, label: "No assigned assessment" },
      participant_summary: {},
      role_coverage: {},
      invitation_summary: {},
      reminder_summary: {},
      overdue_participants: [],
      missing_roles: [],
      stuck_participants: [],
      next_best_action: { type: "no_assignment", label: "No assigned assessment is available.", action: "Contact platform owner", target: "manager-overview" },
      recent_activity: []
    };
  }
  await requireProjectAccess(session, project.id, ["manager"]);
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    const assessmentResult = await client.query(
      `select * from assessments where company_id = $1 order by created_at desc limit 1`,
      [project.id]
    );
    const assessment = assessmentResult.rows[0] || null;
    let participantState = { participants: [], coverage: { required_roles: [], recommended_roles: [], optional_roles: [], summary: {} } };
    if (assessment) {
      const blueprintRow = await client.query("select * from assessment_blueprints where assessment_project_id = $1 limit 1", [project.id]);
      const blueprint = blueprintRow.rowCount ? mapAssessmentBlueprintRow(blueprintRow.rows[0]) : null;
      participantState = await participantCoverageForBlueprint(client, assessment.id, blueprint);
    }
    const participants = participantState.participants || [];
    const activeParticipants = participants.filter((participant) => participant.is_active && participant.status !== "deactivated");
    const grouped = {
      not_invited: activeParticipants.filter((participant) => participant.status === "not_invited"),
      invited: activeParticipants.filter((participant) => participant.status === "invited"),
      started: activeParticipants.filter((participant) => participant.status === "started"),
      completed: activeParticipants.filter((participant) => participant.status === "completed"),
      overdue: activeParticipants.filter((participant) => participant.overdue)
    };
    const requiredRoles = participantState.coverage.required_roles || [];
    const recommendedRoles = participantState.coverage.recommended_roles || [];
    const missingRoles = [...requiredRoles, ...recommendedRoles].filter((role) => role.status === "Missing");
    const stuckParticipants = activeParticipants.filter((participant) => participant.overdue || (participant.session_id && !participant.active_token_expires_at && participant.status !== "completed"));
    const invitationLogs = assessment
      ? await client.query("select status, sent_at, created_at from assessment_invitation_logs where assessment_id = $1 order by created_at desc limit 50", [assessment.id])
      : { rows: [] };
    const reminderLogs = assessment
      ? await client.query("select status, sent_at, created_at from assessment_reminder_logs where assessment_id = $1 order by created_at desc limit 50", [assessment.id])
      : { rows: [] };
    const invitationSummary = {
      sent: activeParticipants.filter((participant) => participant.invite_sent_at || participant.email_status === "sent").length,
      failed: activeParticipants.filter((participant) => participant.email_status === "failed").length,
      not_sent: activeParticipants.filter((participant) => !participant.invite_sent_at && participant.email_status !== "sent").length,
      last_sent_at: activeParticipants.map((participant) => participant.last_invite_sent_at || participant.invite_sent_at).filter(Boolean).sort().at(-1) || null,
      logs: invitationLogs.rows
    };
    const reminderSummary = {
      sent: activeParticipants.reduce((sum, participant) => sum + Number(participant.reminder_count || 0), 0),
      failed: activeParticipants.filter((participant) => participant.reminder_status === "failed").length,
      last_sent_at: activeParticipants.map((participant) => participant.last_reminder_sent_at).filter(Boolean).sort().at(-1) || null,
      logs: reminderLogs.rows
    };
    const percentComplete = activeParticipants.length
      ? Math.round((grouped.completed.length / activeParticipants.length) * 100)
      : 0;
    const collectionComplete = Boolean(activeParticipants.length) && activeParticipants.every((participant) => participant.status === "completed");
    const recentActivity = [
      ...activeParticipants
        .filter((participant) => participant.completed_at || participant.started_at || participant.invite_sent_at)
        .map((participant) => ({
          type: participant.completed_at ? "completed" : participant.started_at ? "started" : "invited",
          title: `${participant.full_name} ${participant.completed_at ? "completed" : participant.started_at ? "started" : "was invited"}`,
          timestamp: participant.completed_at || participant.started_at || participant.invite_sent_at
        })),
      ...reminderLogs.rows
        .filter((row) => row.sent_at)
        .map((row) => ({ type: "reminder", title: `Reminder ${row.status}`, timestamp: row.sent_at }))
    ]
      .filter((item) => item.timestamp)
      .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
      .slice(0, 10);

    return {
      generated_at: new Date().toISOString(),
      assigned_organization: {
        project_id: project.id,
        organization_name: project.clientDisplayName || project.organizationName || project.name,
        industry_context: project.industryContext,
        status: project.status
      },
      active_assessment: assessment ? {
        assessment_id: assessment.id,
        name: assessment.title,
        status: assessment.status,
        created_at: assessment.created_at,
        framework_name: defaultFrameworkDisplayName
      } : null,
      collection_status: {
        percent_complete: percentComplete,
        label: collectionComplete ? "Collection complete" : `Assessment collection is ${percentComplete}% complete.`,
        complete: collectionComplete
      },
      participant_summary: {
        total: activeParticipants.length,
        invited: grouped.invited.length + grouped.started.length + grouped.completed.length,
        started: grouped.started.length,
        completed: grouped.completed.length,
        overdue: grouped.overdue.length,
        not_invited: grouped.not_invited.length,
        missing_required_roles: requiredRoles.filter((role) => role.status === "Missing").length
      },
      role_coverage: participantState.coverage,
      invitation_summary: invitationSummary,
      reminder_summary: reminderSummary,
      overdue_participants: grouped.overdue,
      missing_roles: missingRoles,
      stuck_participants: stuckParticipants,
      participant_groups: grouped,
      participants,
      next_best_action: assessmentManagerNextAction({ participants: activeParticipants, coverage: participantState.coverage, activeAssessment: assessment }),
      recent_activity: recentActivity
    };
  } finally {
    client.release();
  }
}

async function createProject(payload) {
