async function backfillStakeholderIds(clientOrPool) {
  const questionRows = await clientOrPool.query("select id, stakeholder_group, stakeholder_role from questions where stakeholder_role_id is null or stakeholder_group_id is null");
  for (const row of questionRows.rows) {
    const role = resolveStakeholderRole(row.stakeholder_role, row.stakeholder_group);
    await clientOrPool.query(
      "update questions set stakeholder_group_id = $1, stakeholder_role_id = $2 where id = $3",
      [role.stakeholder_group_id, role.id, row.id]
    );
  }

  const sessionRows = await clientOrPool.query("select id, stakeholder_role from assessment_sessions where stakeholder_role_id is null or stakeholder_group_id is null");
  for (const row of sessionRows.rows) {
    const role = resolveStakeholderRole(row.stakeholder_role);
    await clientOrPool.query(
      "update assessment_sessions set stakeholder_group_id = $1, stakeholder_role_id = $2 where id = $3",
      [role.stakeholder_group_id, role.id, row.id]
    );
  }

  await clientOrPool.query(`
    update responses r
    set stakeholder_group_id = s.stakeholder_group_id,
        stakeholder_role_id = s.stakeholder_role_id
    from assessment_sessions s
    where r.assessment_session_id = s.id
      and (r.stakeholder_group_id is null or r.stakeholder_role_id is null)
  `);

  const findingRows = await clientOrPool.query("select id, stakeholder_groups from findings where stakeholder_role_id is null or stakeholder_group_id is null");
  for (const row of findingRows.rows) {
    const role = resolveStakeholderRole(Array.isArray(row.stakeholder_groups) ? row.stakeholder_groups[0] : "");
    await clientOrPool.query(
      `update findings
       set stakeholder_group_id = coalesce(stakeholder_group_id, $1),
           stakeholder_role_id = coalesce(stakeholder_role_id, $2),
           supporting_stakeholder_roles = case when supporting_stakeholder_roles = '[]'::jsonb then $3::jsonb else supporting_stakeholder_roles end,
           supporting_stakeholder_groups = case when supporting_stakeholder_groups = '[]'::jsonb then $4::jsonb else supporting_stakeholder_groups end
       where id = $5`,
      [role.stakeholder_group_id, role.id, JSON.stringify([role.id]), JSON.stringify([role.stakeholder_group_id]), row.id]
    );
  }

  await clientOrPool.query(`
    update evidence e
    set stakeholder_group_id = r.stakeholder_group_id,
        stakeholder_role_id = r.stakeholder_role_id
    from responses r
    where e.source_response_id = r.id
      and (e.stakeholder_group_id is null or e.stakeholder_role_id is null)
  `);

  await clientOrPool.query(`
    update recommendations rec
    set stakeholder_group_id = f.stakeholder_group_id,
        stakeholder_role_id = f.stakeholder_role_id
    from findings f
    where rec.finding_id = f.id
      and (rec.stakeholder_group_id is null or rec.stakeholder_role_id is null)
  `);

  await clientOrPool.query(`
    update roadmap_items ri
    set stakeholder_group_id = rec.stakeholder_group_id,
        stakeholder_role_id = rec.stakeholder_role_id
    from recommendations rec
    where ri.recommendation_id = rec.id
      and (ri.stakeholder_group_id is null or ri.stakeholder_role_id is null)
  `);
}

