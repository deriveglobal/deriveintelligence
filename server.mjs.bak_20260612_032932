  }
}

async function getAssessmentEngineDashboard(projectId) {
  const client = await requireDatabase().connect();
  try {
    await ensureAssessmentEngineSchema(client);
    await seedOperationsManagerQuestions(client);
    const assessment = await getOrCreateAssessment(client, projectId);
    const sessions = await client.query(
      `select s.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name
       from assessment_sessions s
       left join stakeholder_groups sg on sg.id = s.stakeholder_group_id
       left join stakeholder_roles sr on sr.id = s.stakeholder_role_id
       where assessment_id = $1
       order by started_at desc`,
      [assessment.id]
    );
    const questions = await client.query(
      `select q.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name
       from questions q
       left join stakeholder_groups sg on sg.id = q.stakeholder_group_id
       left join stakeholder_roles sr on sr.id = q.stakeholder_role_id
       where q.stakeholder_role_id in ('operations_manager', 'branch_manager', 'dispatcher', 'technician', 'warehouse_manager', 'inventory_coordinator', 'finance_manager', 'sales_manager', 'fleet_customer', 'dealer_customer', 'retail_customer', 'service_partner', 'supplier', 'it_manager', 'hr_manager')
       order by q.stakeholder_role, q.question_id`
    );
    const findings = await client.query(
      `select f.*, sg.name as stakeholder_group_name, sr.name as stakeholder_role_name
       from findings f
       left join stakeholder_groups sg on sg.id = f.stakeholder_group_id
       left join stakeholder_roles sr on sr.id = f.stakeholder_role_id
       where f.assessment_id = $1
       order by f.priority_score desc, f.created_at desc`,
      [assessment.id]
    );
    const evidenceRows = await client.query(
      `select
         e.*,
         q.question_id,
         q.question_text as source_question,
         r.answer_text as source_response,
         s.stakeholder_role,
         e.stakeholder_group_id,
         e.stakeholder_role_id,
         eg.name as stakeholder_group_name,
         er.name as stakeholder_role_name
       from evidence e
       join findings f on f.id = e.finding_id
       left join questions q on q.id = e.source_question_id
       left join responses r on r.id = e.source_response_id
       left join assessment_sessions s on s.id = r.assessment_session_id
       left join stakeholder_groups eg on eg.id = e.stakeholder_group_id
       left join stakeholder_roles er on er.id = e.stakeholder_role_id
       where f.assessment_id = $1
       order by e.created_at desc`,
      [assessment.id]
    );
    const recommendationsRows = await client.query("select * from recommendations where assessment_id = $1 order by priority_score desc, created_at desc", [assessment.id]);
    const roadmapRows = await client.query("select * from roadmap_items where assessment_id = $1 order by priority_score desc nulls last, created_at desc", [assessment.id]);
    const companyProfile = await getCompanyProfile(projectId);
    let assessmentBlueprint = null;
    if (companyProfile) {
      assessmentBlueprint = await calculateAssessmentBlueprint(client, projectId, { persist: true });
    }
    const participantState = await participantCoverageForBlueprint(client, assessment.id, assessmentBlueprint);
    const recommendations = recommendationsRows.rows.map((row) => {
      const finding = findings.rows.find((item) => String(item.id) === String(row.finding_id));
      if (!finding) return row;
      const baseRecommendation = {
        title: row.title,
        category: row.recommendation_category,
        type: row.recommendation_type,
        description: row.description || row.recommended_action,
        benefit: row.expected_benefit,
        effort: Number(row.effort_score || 3),
        value: Number(row.business_value_score || 3),
        risk: Number(row.implementation_risk_score || 2),
        estimated_timeline: row.estimated_timeline || "3-6 Months"
      };
      const enriched = enrichRecommendationV2(baseRecommendation, finding, { companyProfile });
      return {
        ...row,
        title: row.title || enriched.title,
        description: row.description || enriched.description,
        expected_benefit: row.expected_benefit || enriched.benefit,
        why_recommendation_exists: row.why_recommendation_exists || enriched.why,
        supporting_evidence: row.supporting_evidence?.length ? row.supporting_evidence : enriched.supportingEvidence,
        supporting_stakeholder_groups: row.supporting_stakeholder_groups?.length ? row.supporting_stakeholder_groups : enriched.supportingStakeholderGroups,
        related_kpi_gaps: row.related_kpi_gaps?.length ? row.related_kpi_gaps : enriched.relatedKpiGaps,
        expected_operational_benefit: row.expected_operational_benefit || enriched.expectedOperationalBenefit,
        expected_financial_benefit: row.expected_financial_benefit || enriched.expectedFinancialBenefit,
        recommended_owner: row.recommended_owner || enriched.recommended_owner,
        dependencies: row.dependencies?.length ? row.dependencies : enriched.dependencies,
        recommendation_confidence_score: row.recommendation_confidence_score || enriched.confidenceScore,
        recommendation_specificity_score: row.recommendation_specificity_score || enriched.specificityScore,
        expected_impact: row.expected_impact || enriched.expectedImpact,
        estimated_time_savings: Number(row.estimated_time_savings || enriched.estimatedTimeSavings || 0),
        estimated_cost_savings: Number(row.estimated_cost_savings || enriched.estimatedCostSavings || 0),
        estimated_revenue_opportunity: Number(row.estimated_revenue_opportunity || enriched.estimatedRevenueOpportunity || 0),
        estimated_risk_reduction: Number(row.estimated_risk_reduction || enriched.estimatedRiskReduction || 0),
        estimated_business_value: Number(row.estimated_business_value || enriched.estimatedBusinessValue || 0),
        value_estimation_details: Object.keys(row.value_estimation_details || {}).length ? row.value_estimation_details : enriched.valueEstimationDetails,
        roi_confidence_score: row.roi_confidence_score || enriched.roiConfidenceScore,
        expected_value: Number(row.expected_value || row.estimated_business_value || enriched.estimatedBusinessValue || 0),
        actual_value: row.actual_value === null ? null : Number(row.actual_value),
        expected_time_savings: Number(row.expected_time_savings || row.estimated_time_savings || enriched.estimatedTimeSavings || 0),
        actual_time_savings: row.actual_time_savings === null ? null : Number(row.actual_time_savings),
        expected_cost_savings: Number(row.expected_cost_savings || row.estimated_cost_savings || enriched.estimatedCostSavings || 0),
        actual_cost_savings: row.actual_cost_savings === null ? null : Number(row.actual_cost_savings),
        expected_outcome: row.expected_outcome || enriched.expectedOperationalBenefit || enriched.benefit,
        actual_outcome: row.actual_outcome,
        recommendation_accuracy_score: row.recommendation_accuracy_score === null
          ? calculateRecommendationAccuracyScore(row)
          : Number(row.recommendation_accuracy_score),
        outcome_notes: row.outcome_notes,
        outcome_updated_at: row.outcome_updated_at
      };
    });

    const problemTypeCounts = findings.rows.reduce((acc, finding) => {
      for (const problemType of finding.problem_types || []) acc[problemType] = (acc[problemType] || 0) + 1;
      return acc;
    }, {});
    const kpiGaps = findings.rows.filter(isKpiGapFinding);
    const automationOpportunities = findings.rows.filter((finding) => Number(finding.automation_potential) >= 4);
    const clusters = Object.entries(
      findings.rows.reduce((acc, finding) => {
        const key = finding.cluster_key || clusterKeyForProblemTypes(finding.problem_types || []);
        acc[key] ||= [];
        acc[key].push(finding);
        return acc;
      }, {})
    )
      .map(([clusterKey, childFindings]) => ({
        clusterKey,
        title: formatClusterTitle(clusterKey),
        childFindings,
        evidenceCount: childFindings.reduce((sum, finding) => sum + Number(finding.evidence_count || 0), 0),
        confidence: Math.round((childFindings.reduce((sum, finding) => sum + Number(finding.confidence || 0), 0) / childFindings.length) * 10) / 10
      }))
      .filter((cluster) => cluster.childFindings.length > 1);
    const approvedFindings = findings.rows.filter((finding) => finding.status === "Approved");
    const approvedRecommendations = recommendations.filter((recommendation) => isRecommendationVisibleStatus(recommendation.status));
    const progressMemory = await getCompanyProgressMemory(client, projectId);

    return {
      assessment,
      companyProfile,
      assessmentBlueprint,
      assessmentParticipants: participantState.participants,
      participantCoverage: participantState.coverage,
      progressMemory,
      sessions: sessions.rows,
      questions: questions.rows,
      findings: findings.rows,
      evidence: evidenceRows.rows,
      recommendations,
      roadmapItems: roadmapRows.rows,
      topProblemTypes: Object.entries(problemTypeCounts)
        .map(([problemType, count]) => ({ problemType, count }))
        .sort((a, b) => b.count - a.count),
      kpiGaps,
      automationOpportunities,
      clusters,
      executivePreview: {
        topFindings: approvedFindings.slice(0, 5),
        topRisks: approvedFindings.filter((finding) => Number(finding.risk_impact) >= 4 || Number(finding.severity) >= 5).slice(0, 5),
        topOpportunities: approvedFindings.filter((finding) => Number(finding.automation_potential) >= 4).slice(0, 5),
        missingKpis: approvedFindings.filter(isKpiGapFinding).slice(0, 5),
        topRecommendations: approvedRecommendations.slice(0, 5),
        topAreasOfAgreement: approvedFindings
          .filter((finding) => Number(finding.stakeholder_agreement_score || 0) >= 2)
          .sort((a, b) => Number(b.stakeholder_agreement_score || 0) - Number(a.stakeholder_agreement_score || 0))
          .slice(0, 5),
        topAreasOfMisalignment: approvedFindings
          .filter((finding) => finding.contradiction_detected)
          .sort((a, b) => Number(b.severity || 0) - Number(a.severity || 0))
          .slice(0, 5),
        roadmapSummary: ["Quick Wins", "Foundation", "Optimization", "Transformation"].map((phase) => ({
          phase,
          count: roadmapRows.rows.filter((item) => item.phase === phase && approvedRecommendations.some((rec) => String(rec.id) === String(item.recommendation_id))).length
        }))
      }
    };
  } finally {
    client.release();
  }
}

