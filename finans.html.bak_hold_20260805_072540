// ---- impact simulator (live · FIN-güdümlü) ----
let _simUpd=null;
function initSim(){
 const D_SMM=FIN.smm*1e6/365,D_SALES=FIN.net_satis_lastik*1e6/365,RATE=FIN.finansman_orani_pct/100,
       B={dio:FIN.dio,dso:FIN.dso,dpo:FIN.dpo};
 const twcOf=d=>d.dso*D_SALES+d.dio*D_SMM-d.dpo*D_SMM,baseTwc=twcOf(B),baseCcc=B.dio+B.dso-B.dpo;
 const $=id=>document.getElementById(id),sDio=$('sDio'),sDso=$('sDso'),sDpo=$('sDpo');
 if(!sDio||!sDso||!sDpo)return;
 const MM=x=>Math.round(x/1e6).toLocaleString('tr-TR');
 sDio.value=B.dio;sDso.value=B.dso;sDpo.value=B.dpo;
 function dlt(el,d,u,low){if(!el)return;if(Math.abs(d)<0.5){el.textContent='';el.className='dlt';return;}
   const good=low?d<0:d>0;el.textContent=(d>0?'▲ +':'▼ ')+Math.abs(Math.round(d))+u;el.className='dlt '+(good?'good':'bad');}
 function upd(){const dio=+sDio.value,dso=+sDso.value,dpo=+sDpo.value;
   $('vDio').textContent=dio;$('vDso').textContent=dso;$('vDpo').textContent=dpo;
   const ccc=dio+dso-dpo,twc=twcOf({dio,dso,dpo}),freed=baseTwc-twc,saving=freed*RATE;
   $('cccOut').textContent=ccc;$('twcOut').textContent=MM(twc);
   $('finOut').textContent=(saving>=0?'+':'−')+MM(Math.abs(saving));
   $('freedV').textContent=(freed>=0?'+':'−')+MM(Math.abs(freed));
   dlt($('cccD'),ccc-baseCcc,'g',true);dlt($('twcD'),(twc-baseTwc)/1e6,'M',true);
   const t=$('tang');
   if(freed>30e6)t.innerHTML=`≈ <b style="color:var(--accent)">${MM(freed)}M ₺</b> — tek başına 30M'lik krediye gerek bırakmaz`;
   else if(freed>1e6)t.innerHTML=`≈ ${MM(freed)}M ₺ serbest · yıllık ~${MM(saving)}M finansman tasarrufu`;
   else if(freed<-1e6)t.innerHTML=`⚠ ${MM(-freed)}M ₺ daha fazla sermaye bağlanır`;
   else t.textContent='bugünkü durum';
   const mx=baseTwc*1.35;$('vfill').style.width=Math.min(100,twc/mx*100)+'%';
   $('vfree').style.width=(freed>0?freed/mx*100:0)+'%';}
 _simUpd=upd;
 if(!initSim._bound){
   [sDio,sDso,sDpo].forEach(s=>s.addEventListener('input',()=>_simUpd&&_simUpd()));
   const rst=$('simReset');if(rst)rst.addEventListener('click',()=>{sDio.value=FIN.dio;sDso.value=FIN.dso;sDpo.value=FIN.dpo;_simUpd&&_simUpd();});
   initSim._bound=true;
 }
 upd();
}
initSim();

