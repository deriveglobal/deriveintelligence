function drawTrend(){const svg=document.getElementById('trendsvg');const W=560,H=172,pl=8,pr=8,pt=14,pb=24,mn=30,mx=62;
  const iw=W-pl-pr,ih=H-pt-pb,X=i=>pl+i*(iw/(T.length-1)),Y=v=>pt+ih-((v-mn)/(mx-mn))*ih;
  let g='';T.forEach((v,i)=>g+=`<text x="${X(i)}" y="${H-6}" fill="var(--ink2)" font-size="10" text-anchor="middle">${MO[i]}</text>`);
  const path=T.map((v,i)=>`${i?'L':'M'}${X(i)},${Y(v)}`).join(' ');
  const area=`M${X(0)},${H-pb} `+T.map((v,i)=>`L${X(i)},${Y(v)}`).join(' ')+` L${X(T.length-1)},${H-pb}Z`;
  const dots=T.map((v,i)=>`<circle cx="${X(i)}" cy="${Y(v)}" r="3" fill="var(--page)" stroke="var(--accent)" stroke-width="2"/>`).join('');
  svg.innerHTML=`<defs><linearGradient id="ag" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".22"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
    <line class="cross" id="cx" x1="0" y1="${pt}" x2="0" y2="${H-pb}"></line><path d="${area}" fill="url(#ag)"/><path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2"/>${dots}${g}<rect x="0" y="0" width="${W}" height="${H}" fill="transparent" id="hit"/>`;
  const hit=svg.querySelector('#hit'),cx=svg.querySelector('#cx'),tip=document.getElementById('trendtip');
  hit.onmousemove=e=>{const r=svg.getBoundingClientRect();let i=Math.round(((e.clientX-r.left)/r.width*W-pl)/(iw/(T.length-1)));
    i=Math.max(0,Math.min(T.length-1,i));cx.setAttribute('x1',X(i));cx.setAttribute('x2',X(i));cx.style.opacity=1;
    tip.style.opacity=1;tip.style.left=(X(i)/W*r.width)+'px';tip.style.top=(Y(T[i])/H*r.height)+'px';tip.innerHTML=`${MO[i]} · <b>${T[i]} gün</b>`;};
  hit.onmouseleave=()=>{cx.style.opacity=0;tip.style.opacity=0;};}
drawTrend();

