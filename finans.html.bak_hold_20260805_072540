<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Derive · Finans Odası</title>
<style>
:root{
  --page:#09090b; --s1:#111116; --s2:#16161c; --s3:#1d1d25; --s4:#24242e;
  --ink0:#f5f5f1; --ink1:#adaca6; --ink2:#75746f; --ink3:#4c4c4a;
  --line:rgba(255,255,255,.07); --line2:rgba(255,255,255,.13);
  --accent:#34d3bf; --accent2:#2b93c9; --accent-dim:#1f7d73; --glow:rgba(52,211,191,.14);
  --good:#0ca30c; --warn:#fab219; --serious:#ec835a; --crit:#d03b3b;
  --up:#2fd06f; --down:#e5595a;
  --stok:#fab219; --alacak:#3987e5; --borc:#199e70;
  color-scheme:dark; --r:16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--page);color:var(--ink0);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
body{padding:22px}
.num{font-variant-numeric:tabular-nums}

/* prototype bar */
.stage{max-width:1300px;margin:0 auto}
.protobar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:8px 4px 18px;
  color:var(--ink2);font-size:12px;letter-spacing:.04em}
.seg{display:flex;background:var(--s2);border:1px solid var(--line);border-radius:999px;padding:3px}
.seg button{background:none;border:none;color:var(--ink1);font:inherit;font-size:12px;
  padding:6px 15px;border-radius:999px;cursor:pointer}
.seg button.on{background:var(--accent);color:#052825;font-weight:640}
.ribbon{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--warn);
  font-size:11px;letter-spacing:.05em;text-transform:uppercase}
.ribbon .dot{width:6px;height:6px;border-radius:50%;background:var(--warn);box-shadow:0 0 0 4px rgba(250,178,25,.15)}

.frame{margin:0 auto;transition:max-width .35s}
.frame.desktop{max-width:1300px}
.frame.mobile{max-width:398px}

.app{background:var(--s1);border:1px solid var(--line);border-radius:24px;overflow:hidden;
  box-shadow:0 40px 120px -40px rgba(0,0,0,.9)}
.topbar{display:flex;align-items:center;gap:15px;padding:17px 24px;border-bottom:1px solid var(--line);
  background:linear-gradient(180deg,#131319,#0f0f13)}
.brand{display:flex;align-items:center;gap:11px;font-weight:600}
.brand .mk{width:26px;height:26px;border-radius:8px;
  background:conic-gradient(from 210deg,var(--accent),#2b7d9c,var(--accent));box-shadow:0 0 20px var(--glow)}
.brand b{font-weight:680}.brand .sub{color:var(--ink2)}.brand .fin{color:var(--accent);font-weight:680}
.live{display:flex;align-items:center;gap:7px;color:var(--ink1);font-size:12px}
.live .p{width:7px;height:7px;border-radius:50%;background:var(--up);animation:pulse 2.4s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(47,208,111,.5)}50%{box-shadow:0 0 0 6px rgba(47,208,111,0)}}
.fresh{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink1);
  background:var(--s2);border:1px solid var(--line);padding:7px 13px;border-radius:999px}
.fresh .s{color:var(--up)}
.rooms{display:flex;gap:4px;padding:11px 18px;border-bottom:1px solid var(--line);overflow-x:auto}
.rooms button{white-space:nowrap;background:none;border:1px solid transparent;color:var(--ink1);
  font:inherit;font-size:13.5px;padding:9px 15px;border-radius:11px;cursor:pointer;display:flex;gap:8px;align-items:center}
.rooms button:hover{color:var(--ink0);background:var(--s2)}
.rooms button.on{background:var(--s3);color:var(--ink0);border-color:var(--line2)}
.rooms button .n{color:var(--ink3);font-size:11px}
.rooms button.on .n{color:var(--accent)}
.body{padding:24px}

/* ===== ECONOMIST big picture ===== */
.econ{display:flex;gap:16px;padding:20px;border:1px solid var(--line);border-radius:var(--r);margin-bottom:22px;
  background:radial-gradient(130% 150% at 0% 0%,rgba(52,211,191,.09),transparent 55%),var(--s2)}
.econ .av{width:44px;height:44px;border-radius:13px;flex-shrink:0;
  background:linear-gradient(150deg,var(--accent),var(--accent2));color:#052825;
  display:grid;place-items:center;font-size:20px;box-shadow:0 0 26px var(--glow);animation:breathe 3.8s ease-in-out infinite}
@keyframes breathe{0%,100%{box-shadow:0 0 22px var(--glow)}50%{box-shadow:0 0 42px var(--glow);transform:scale(1.04)}}

/* heartbeat monitor — the room is alive */
.heartbeat{display:flex;align-items:center;gap:13px;margin-bottom:18px;padding:8px 14px;
  background:var(--s2);border:1px solid var(--line);border-radius:11px;font-size:12px;color:var(--ink1)}
.hbmon{width:130px;height:20px;flex-shrink:0}
.hbmon .base{stroke:var(--line2)}
.hbmon .pulse{stroke:var(--accent);stroke-dasharray:22 260;stroke-dashoffset:282;animation:ecg 2.1s linear infinite;filter:drop-shadow(0 0 4px var(--accent))}
@keyframes ecg{to{stroke-dashoffset:0}}
.hbdot{width:7px;height:7px;border-radius:50%;background:var(--up);flex-shrink:0;animation:pulse 2.1s infinite}
.hbtext{transition:opacity .5s;color:var(--ink1)}

/* time selector (cockpit-parity; prod → parametreli uç) */
.timesel{display:flex;align-items:center;gap:14px;padding:11px 24px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:var(--s1)}
.timesel .tl{font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--ink2)}
.tchips{display:flex;gap:3px;background:var(--s2);border:1px solid var(--line);border-radius:999px;padding:3px}
.tchips button{background:none;border:none;color:var(--ink1);font:inherit;font-size:12.5px;padding:6px 13px;border-radius:999px;cursor:pointer}
.tchips button.on{background:var(--accent);color:#052825;font-weight:640}
.tsum{font-size:12.5px;color:var(--ink1)}
.tsum b{color:var(--ink0);font-weight:660}
.tsum .tnote{color:var(--ink3);font-size:11.5px}
.frame.mobile .timesel{padding:10px 15px}.frame.mobile .tsum{width:100%}
.econ .c{flex:1}
.econ .lab{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);
  display:flex;align-items:center;gap:9px;margin-bottom:8px}
.econ .lab .wave{display:flex;gap:2.5px;align-items:center;height:12px}
.econ .lab .wave i{width:2.5px;background:var(--accent);border-radius:2px;animation:eq 1.1s ease-in-out infinite}
.econ .lab .wave i:nth-child(1){height:5px}.econ .lab .wave i:nth-child(2){height:11px;animation-delay:.15s}
.econ .lab .wave i:nth-child(3){height:7px;animation-delay:.3s}.econ .lab .wave i:nth-child(4){height:12px;animation-delay:.45s}
@keyframes eq{0%,100%{transform:scaleY(.4)}50%{transform:scaleY(1)}}
.econ p{font-size:15.5px;line-height:1.6;color:var(--ink0);font-weight:420;letter-spacing:-.005em}
.econ p+p{margin-top:10px}
.econ b{color:#fff;font-weight:640}
.econ .why{color:var(--accent);border-bottom:1px dashed var(--accent-dim);cursor:pointer}
.econ .recs{margin-top:14px;display:flex;flex-direction:column;gap:8px}
.econ .rec{display:flex;gap:10px;align-items:flex-start;background:var(--s3);border:1px solid var(--line);
  border-radius:11px;padding:11px 13px;font-size:13.5px;line-height:1.45}
.econ .rec .tg{font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:#052825;background:var(--accent);
  padding:2px 8px;border-radius:6px;font-weight:640;flex-shrink:0;margin-top:1px}
.econ .foot{margin-top:13px;display:flex;gap:14px;align-items:center;color:var(--ink2);font-size:12px;flex-wrap:wrap}
.econ .foot .listen{color:var(--ink1);cursor:pointer;display:flex;gap:6px;align-items:center}
.econ .foot .listen:hover{color:var(--accent)}
.fb{display:flex;gap:6px}.fb button{background:var(--s3);border:1px solid var(--line);color:var(--ink1);
  border-radius:8px;padding:3px 10px;cursor:pointer;font:inherit;font-size:12px}
.fb button:hover{border-color:var(--accent-dim);color:var(--ink0)}

/* ===== MONEY JOURNEY ===== */
.journey{background:var(--s2);border:1px solid var(--line);border-radius:var(--r);padding:22px 22px 24px;margin-bottom:16px}
.journey .top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;flex-wrap:wrap;gap:10px}
.journey h3{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink1);font-weight:600}
.journey .head{font-size:19px;font-weight:600;letter-spacing:-.02em;margin-top:7px;color:var(--ink0)}
.journey .head b{color:var(--accent)}
.journey .verdict{text-align:right}
.journey .verdict .big{font-size:46px;font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--accent)}
.journey .verdict .big small{font-size:18px;color:var(--ink1);font-weight:500}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 11px;border-radius:999px;font-size:11.5px;font-weight:600;margin-top:8px}
.pill.risk{background:rgba(208,59,59,.14);color:#ff8b8b}
.pill.ok{background:rgba(12,163,12,.16);color:#4fd44f}

/* stations row */
.stations{display:flex;align-items:stretch;gap:0;margin:6px 0 8px;position:relative}
.st{flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;z-index:2}
.st .icon{width:52px;height:52px;border-radius:15px;background:var(--s3);border:1px solid var(--line2);
  display:grid;place-items:center;font-size:23px;position:relative}
.st.cash .icon{background:linear-gradient(150deg,rgba(52,211,191,.2),rgba(52,211,191,.05));border-color:var(--accent-dim)}
.st .nm{font-size:12.5px;color:var(--ink0);margin-top:9px;font-weight:560}
.st .dsc{font-size:11px;color:var(--ink2);margin-top:2px;max-width:120px;line-height:1.3}
.leg{flex:0 0 auto;width:14%;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  padding-top:14px;position:relative;z-index:1}
.leg .line{width:100%;height:2px;background:linear-gradient(90deg,var(--line2),var(--ink3));position:relative}
.leg .line::after{content:"▸";position:absolute;right:-4px;top:-9px;color:var(--ink3);font-size:13px}
.leg .days{font-size:13px;font-weight:680;margin-top:9px;font-variant-numeric:tabular-nums}
.leg .lbl{font-size:10.5px;color:var(--ink2);margin-top:2px;text-align:center;line-height:1.25}
.leg.stok .days{color:var(--stok)} .leg.alacak .days{color:var(--alacak)}
/* traveling dot */
.track{position:absolute;top:26px;left:6%;right:6%;height:2px;z-index:0}
.money-dot{position:absolute;top:19px;left:0;width:12px;height:12px;border-radius:50%;background:var(--accent);
  box-shadow:0 0 12px var(--accent);z-index:3;animation:travel 7s linear infinite}
@keyframes travel{0%{left:6%;opacity:0}5%{opacity:1}95%{opacity:1}100%{left:92%;opacity:0}}

/* the math bar (formula as picture) */
.mathbar{margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}
.mathbar .cap{font-size:11px;color:var(--ink2);margin-bottom:11px;letter-spacing:.02em}
.mbar{display:flex;height:38px;border-radius:9px;overflow:hidden;background:var(--s3)}
.mbar .seg{display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:640;color:#0a0a0a;
  position:relative;border-right:2px solid var(--s2)}
.mbar .seg.stok{background:var(--stok)}.mbar .seg.alacak{background:var(--alacak);color:#fff}
.mbar .seg.dpo{background:repeating-linear-gradient(45deg,var(--borc),var(--borc) 6px,#12805c 6px,#12805c 12px);color:#fff}
.mbar .seg small{position:absolute;bottom:-19px;left:0;color:var(--ink2);font-size:10.5px;font-weight:400;white-space:nowrap}
.mathbar .eq{margin-top:30px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  font-size:13.5px;color:var(--ink1);font-variant-numeric:tabular-nums}
.mathbar .eq b{color:var(--ink0)} .mathbar .eq .res{color:var(--accent);font-weight:680;font-size:15px}
.mathbar .eq .op{color:var(--ink3)}

/* ===== metric grid (self-explaining) ===== */
h2.sec{font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink1);
  margin:26px 0 14px;font-weight:600;display:flex;align-items:center}
h2.sec .sn{color:var(--ink3);font-size:11px;margin-right:10px}
h2.sec::after{content:"";flex:1;height:1px;background:var(--line);margin-left:14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.m{background:var(--s2);border:1px solid var(--line);border-radius:14px;padding:17px 18px;position:relative}
.m .row1{display:flex;align-items:center;gap:9px}
.m .k{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink1);font-weight:560}
.m .badge{font-size:9px;letter-spacing:.07em;text-transform:uppercase;padding:2px 7px;border-radius:5px;font-weight:640}
.m .badge.live{background:rgba(47,208,111,.15);color:var(--up)}
.m .badge.prov{background:rgba(250,178,25,.13);color:var(--warn)}
.m .v{font-size:30px;font-weight:680;letter-spacing:-.025em;margin:11px 0 3px;font-variant-numeric:tabular-nums}
.m .v small{font-size:15px;color:var(--ink1);font-weight:500}
.m .plain{font-size:13px;color:var(--ink0);line-height:1.45;font-weight:420}
.m .meta{margin-top:12px;padding-top:11px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:6px}
.m .meta .r{display:flex;gap:8px;font-size:11.5px;line-height:1.4}
.m .meta .r .t{color:var(--ink3);flex:0 0 46px;text-transform:uppercase;letter-spacing:.04em;font-size:10px;padding-top:1px}
.m .meta .r .x{color:var(--ink1);flex:1}
.m .meta .r.why .x{color:var(--ink0)}
.m .stat{position:absolute;top:16px;right:16px;width:8px;height:8px;border-radius:50%}
.m .stat.ok{background:var(--good)}.m .stat.mid{background:var(--warn)}.m .stat.risk{background:var(--crit)}

/* trend + laws */
.learn{display:grid;grid-template-columns:1.5fr 1fr;gap:16px;margin-top:8px}
.card{background:var(--s2);border:1px solid var(--line);border-radius:var(--r);padding:20px}
.card .ch{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.card .ch h3{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink1);font-weight:600}
.card .ch .sub{font-size:12px;color:var(--ink2)}
.trend svg{width:100%;height:172px;display:block;overflow:visible;margin-top:8px}
.cross{stroke:var(--line2);stroke-width:1;stroke-dasharray:3 3;opacity:0}
.tip{position:absolute;pointer-events:none;background:#000;border:1px solid var(--line2);border-radius:9px;
  padding:7px 10px;font-size:12px;opacity:0;transform:translate(-50%,-125%);transition:opacity .1s;white-space:nowrap;z-index:5}
.tip b{color:var(--accent)}
.laws .list{display:flex;flex-direction:column;gap:9px;margin-top:10px}
.law{display:flex;gap:11px;background:var(--s3);border:1px solid var(--line);border-radius:12px;padding:12px 13px}
.law .ic{width:26px;height:26px;border-radius:8px;background:var(--glow);color:var(--accent);
  display:grid;place-items:center;font-size:13px;flex-shrink:0}
.law .t{font-size:13px;color:var(--ink0);line-height:1.4}
.law .mm{font-size:11px;color:var(--ink2);margin-top:4px;display:flex;gap:8px;align-items:center}
.law .st{padding:1px 7px;border-radius:6px;font-size:10px}
.law .st.on{background:rgba(12,163,12,.15);color:#4fd44f}.law .st.ta{background:rgba(250,178,25,.13);color:var(--warn)}

.ask{margin-top:16px;display:flex;gap:12px;align-items:center;background:var(--s2);border:1px solid var(--line);
  border-radius:var(--r);padding:13px 15px}
.ask .mic{width:38px;height:38px;border-radius:11px;background:var(--accent);color:#052825;
  display:grid;place-items:center;font-size:17px;flex-shrink:0;box-shadow:0 0 24px var(--glow)}
.ask input{flex:1;background:none;border:none;color:var(--ink0);font:inherit;font-size:15px;outline:none}
.ask input::placeholder{color:var(--ink2)}
.ask .send{background:var(--s3);border:1px solid var(--line2);color:var(--ink1);border-radius:10px;padding:9px 15px;cursor:pointer;font:inherit;font-size:13px}
.ask .send:hover{color:var(--ink0);border-color:var(--accent-dim)}

/* signals feeding the economist */
.signals{margin-top:15px;padding-top:14px;border-top:1px solid var(--line)}
.sighdr{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink2);margin-bottom:10px}
.sigrow{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.sig{background:var(--s3);border:1px solid var(--line);border-radius:11px;padding:11px 12px}
.sig .src{font-size:10px;font-weight:640;letter-spacing:.03em;padding:2px 8px;border-radius:6px;display:inline-block}
.sig .src.v{background:rgba(57,135,229,.16);color:#7db4f5}
.sig .src.p{background:rgba(250,178,25,.14);color:var(--warn)}
.sig .src.a{background:rgba(52,211,191,.14);color:var(--accent)}
.sig .src.n{background:rgba(214,81,129,.16);color:#e58bad}
.sig p{font-size:12px;line-height:1.45;color:var(--ink0);margin:8px 0 7px;font-weight:420}
.sig p b{color:#fff;font-weight:640}
.sig .who{font-size:10.5px;color:var(--ink3)}

/* scenario */
.scen{background:var(--s2);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.chips button{background:var(--s3);border:1px solid var(--line);color:var(--ink1);font:inherit;font-size:12.5px;
  padding:8px 13px;border-radius:999px;cursor:pointer;transition:.15s}
.chips button:hover{color:var(--ink0);border-color:var(--line2)}
.chips button.on{background:var(--accent);color:#052825;font-weight:620;border-color:transparent}
.scen-ans{background:linear-gradient(180deg,rgba(52,211,191,.06),transparent),var(--s3);
  border:1px solid var(--line);border-radius:13px;padding:16px 17px}
.scen-ans .q{font-size:12px;color:var(--ink2);margin-bottom:11px;display:flex;gap:8px;align-items:center}
.scen-ans .q b{color:var(--ink0);font-weight:560}
.scen-ans .verdict-tag{margin-left:auto;font-size:10px;text-transform:uppercase;letter-spacing:.05em;
  padding:3px 9px;border-radius:6px;font-weight:640}
.scen-ans .verdict-tag.no{background:rgba(208,59,59,.14);color:#ff8b8b}
.scen-ans .verdict-tag.yes{background:rgba(12,163,12,.16);color:#4fd44f}
.scen-ans .verdict-tag.care{background:rgba(250,178,25,.13);color:var(--warn)}
.scen-ans .nums{display:flex;gap:22px;flex-wrap:wrap;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.scen-ans .nn{display:flex;flex-direction:column}
.scen-ans .nn .l{font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink2)}
.scen-ans .nn .b{font-size:20px;font-weight:680;font-variant-numeric:tabular-nums;margin-top:3px}
.scen-ans .body-t{font-size:13.5px;line-height:1.55;color:var(--ink0)}
.scen-ans .body-t b{color:#fff;font-weight:620}
.scen-ans .body-t .accent{color:var(--accent)}
.scen-ans .lst{color:var(--ink1);cursor:pointer;font-size:12px;margin-top:10px;display:inline-flex;gap:6px}
.scen-ans .lst:hover{color:var(--accent)}
.frame.mobile .sigrow{grid-template-columns:1fr 1fr}
.frame.mobile .scen-ans .nums{gap:16px}
@media(max-width:920px){.sigrow{grid-template-columns:1fr 1fr}}

/* discover — overdue pattern small multiples */
.sm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:8px}
.sm{background:var(--s3);border:1px solid var(--line);border-radius:12px;padding:14px}
.smh{display:flex;justify-content:space-between;align-items:center;font-size:11.5px;color:var(--ink1)}
.smh .d{font-size:10.5px;font-weight:640;padding:1px 7px;border-radius:6px}
.smh .d.bad{background:rgba(208,59,59,.14);color:#ff8b8b}
.smh .d.flat{background:var(--s4);color:var(--ink2)}
.sm svg{width:100%;height:44px;display:block;margin:11px 0 7px}
.sm .smv{font-size:22px;font-weight:680;font-variant-numeric:tabular-nums}
.sm .smv small{font-size:12px;color:var(--ink2);font-weight:500}
.pattern{display:flex;gap:12px;margin-top:15px;padding-top:15px;border-top:1px solid var(--line)}
.pattern .pic{width:30px;height:30px;border-radius:9px;background:var(--glow);color:var(--accent);
